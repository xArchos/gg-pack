  "create_dragons_plus.ponder.air_current_interact_with_block.header": "Prądy powietrza hurtowej obróbki na symulowanych maszynach",
  "create_dragons_plus.ponder.air_current_interact_with_block.text_1": "Prąd powietrza hurtowej obróbki z symulowanej maszyny może oddziaływać na bloki",
  "create_dragons_plus.ponder.air_current_interact_with_block.text_2": "Opcja „Prąd powietrza hurtowego topienia rozprzestrzenia ogień” jest domyślnie wyłączona w konfiguracji, aby nowi gracze przypadkiem nie spalili swoich budowli",
  "create_dragons_plus.ponder.bulk_coloring.header": "Hurtowe barwienie",
  "create_dragons_plus.ponder.bulk_coloring.text_1": "Powietrze przepływające przez płynny barwnik będzie barwiło przedmioty",
  "create_dragons_plus.ponder.bulk_coloring.text_2": "Podobnie jak hurtowe topienie i hurtowe wędzenie, hurtowe barwienie automatycznie obsługuje niektóre receptury wytwarzania z barwnikami",
  "create_dragons_plus.ponder.bulk_coloring.text_3": "Barwiący przepływ powietrza działa też na byty i zmienia ich kolor.",
  "create_dragons_plus.ponder.bulk_coloring.text_4": "Założona zbroja również zostanie zabarwiona.",
  "create_dragons_plus.ponder.bulk_enchanting.header": "Hurtowe zaklinanie",
  "create_dragons_plus.ponder.bulk_enchanting.text_1": "Powietrze przepływające przez złotą aerochmurę będzie hurtowo zaklinało przedmioty",
  "create_dragons_plus.ponder.bulk_enchanting.text_2": "Hurtowe zaklinanie wykonuje receptury ołtarza z Aetheru za pomocą obróbki wiatrakiem",
  "create_dragons_plus.ponder.bulk_enchanting.text_3": "Niektóre receptury naprawiają wyposażenie, więc na wejściu i wyjściu może być ten sam przedmiot",
  "create_dragons_plus.ponder.bulk_enchanting.text_4": "Ten sam przepływ powietrza może też wysiadywać jaja moa",
  "create_dragons_plus.ponder.bulk_ending.header": "Hurtowe endowanie",
  "create_dragons_plus.ponder.bulk_ending.text_1": "Powietrze przepływające przez głowę smoka lub oddech smoka będzie endowało przedmioty",
  "create_dragons_plus.ponder.bulk_freezing.header": "Hurtowe zamrażanie",
  "create_dragons_plus.ponder.bulk_freezing.text_1": "Powietrze przepływające przez sypki śnieg będzie zamrażało przedmioty",
  "create_dragons_plus.ponder.bulk_sanding.header": "Hurtowe piaskowanie",
  "create_dragons_plus.ponder.bulk_sanding.text_1": "Powietrze przepływające przez katalizatory hurtowego piaskowania (np. ruchome piaski) będzie piaskowało przedmioty",
  "create_dragons_plus.ponder.bulk_sanding.text_2": "Podobnie jak hurtowe topienie i hurtowe wędzenie, hurtowe piaskowanie automatycznie obsługuje receptury polerowania papierem ściernym",
  "create_dragons_plus.ponder.dragon_breath_fluid.header": "Płynny oddech smoka",
  "create_dragons_plus.ponder.dragon_breath_fluid.text_1": "Oddech smoka można przechowywać w kotle",
  "create_dragons_plus.ponder.dragon_breath_fluid.text_2": "Gdy płynący oddech smoka zetknie się z lawą, powstaje kamień Endu",
  "create_dragons_plus.ponder.dye_fluids.header": "Płynny barwnik",
  "create_dragons_plus.ponder.dye_fluids.text_1": "Zmieszanie barwnika z wodą daje płynny barwnik",
  "create_dragons_plus.ponder.dye_fluids.text_2": "Mieszanie z podgrzewaniem pozwala odzyskać barwnik z płynu",
  "create_dragons_plus.ponder.dye_fluids.text_3": "Przedmioty i istoty, które dotkną płynnego barwnika, zostają zabarwione",
  "create_dragons_plus.ponder.dye_fluids.text_4": "Gdy płynny barwnik zetknie się z lawą, powstaje beton w tym samym kolorze",
  "create_dragons_plus.ponder.fragile_fluid_tank.header": "Kruchy zbiornik",
