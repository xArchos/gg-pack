	task.00668757A680CF0B.title: "Klasztor"
	task.00C30BD4B6E12080.title: "Olimpijska cytadela"
	task.00C8F764407061DB.title: "Korsarz illagerów"
	task.01AC7108314F8E33.title: "Latarnia morska"
	task.028F3C9E6FB034FB.title: "Ptaszarnia"
	task.02967D83DD57220C.title: "Wulkaniczne delty"
	task.046C0E72419BEADC.title: "Loch zombie"
	task.047CD1316EC1392A.title: "Schron piratów"
