	quest.00011121B86E78A2.quest_desc: ["Mrugnięcie, piorun, przywołanie nieumarłych, orbita i inne glify trzeciego poziomu zapiszesz tylko w księdze arcymaga. Zrób dowolny z nich."]
	quest.00011121B86E78A2.title: "Glif trzeciego poziomu"
	quest.000301E694BCB523.quest_desc: ["Bloki ozdobne: jeden wyświetla magiczny krąg, drugi mgłę o wybranym kolorze i gęstości."]
	quest.000301E694BCB523.title: "Projektory"
	quest.001078D0815AC33C.quest_desc: ["Naboje przeciwlotnicze rozrywają się w powietrzu i zasypują cel odłamkami – przydadzą się na wrogie statki powietrzne. Nakładka smugowa pokaże tor serii."]
	quest.001078D0815AC33C.title: "Ogień przeciwlotniczy"
	quest.0013E40F43A6973D.quest_desc: [
		"Wiertło próbne (Sample Drill) sprawdzi żyłę, zanim postawisz wiertnicę: postaw je, załóż na nie miedziany zbiornik ze sprężonym powietrzem i uruchom. Atlas żył (Ore Vein Atlas) zapisze potem jej położenie i zawartość."
		""
		"&7Wykrywacz żył i wiertnicę znajdziesz w drzewie ery pary i stali.&r"
	]
	quest.0013E40F43A6973D.title: "Próbka z żyły"
	quest.00255CAC3A53A55A.quest_desc: [
		"&7Ekwipunek: najlepsza zbroja, elytry albo perły Endu.&r"
		"Pilnuje zrujnowanej cytadeli na wyspach Endu. Drogę wskaże &c{item.cataclysm.void_eye}&r."
	]
	quest.00255CAC3A53A55A.quest_subtitle: "Boss"
	quest.00255CAC3A53A55A.title: "&c{entity.cataclysm.ender_guardian}"
	quest.002672FCF24869B1.quest_desc: ["Trzymany w ręce od czasu do czasu doładuje urządzenie trzymane w drugiej ręce."]
	quest.002F3E5F190A3061.quest_desc: ["Kładki i chaty wysoko w koronach dżungli. Uważaj na upadek."]
	quest.002F3E5F190A3061.title: "Domek na drzewie"
	quest.00404F7D865B29DD.quest_desc: ["Tarcza z łzy Scylli i złota, pamiątka po władczyni burz."]
	quest.0041CE6328881222.quest_desc: ["Podziemna budowla pełna grobowców, pułapek i nieumarłych. W jej sercu śpi Umarły Król."]
	quest.0041CE6328881222.title: "Katakumby"
	quest.00446FADDFB6CC06.quest_desc: ["Tabliczka Spiritus na ołtarzu czwartego poziomu za 30 000 esencji. Staje się niemal przezroczysta."]
	quest.0047DA873A39FB9F.quest_desc: ["Ołtarz nasyca przedmioty duchami: główny składnik kładziesz na ołtarzu, dodatkowe na podstawkach obok, a duchy wkładasz do ołtarza. Na nim powstanie też pieczęć następnej ery."]
	quest.0047DA873A39FB9F.quest_subtitle: "Kamień milowy"
	quest.0047DA873A39FB9F.title: "&d{block.malum.spirit_altar}"
	quest.005DB109763721B4.quest_desc: ["Rzucone jak oko Endera prowadzi do Płonącej Areny w Netherze, siedziby Ignisa."]
	quest.0071A72D1437A804.quest_desc: ["Narysuj pentakl djinna białą, jasnoszarą i limonkową kredą, a w misach połóż pyły metali. Djinni kruszy rudy szybciej i wydajniej niż foliot."]
	quest.0071A72D1437A804.quest_subtitle: "Kamień milowy"
	quest.0071A72D1437A804.title: "&dDjinni kruszący"
	quest.00796ED2C1ADD673.quest_desc: [
		"Prostsza pompa z Diesel Generators: łożysko, ramię z głowicą, korba i otwór na pionowej rurze aż do skały macierzystej. Sklej ją superklejem i odbieraj ropę pompą."
		""
		"&7Kolejność budowy pokazuje Ponder (W) na łożysku.&r"
	]
	quest.00796ED2C1ADD673.title: "Żuraw pompowy"
	quest.007C773A6F5EB8A6.quest_desc: [
		"Na runicznym warsztacie wyryjesz w skażonej albo skręconej skale ducha, a powstanie runa. Runy nosisz w gniazdach na runy, a każda daje stałą premię, np. do zdrowia albo zręczności."
		""
		"&7Kolejny tier Malum pojawi się tutaj, gdy twoja drużyna wejdzie w erę pary i stali.&r"
	]
	quest.007C773A6F5EB8A6.title: "Pierwsza runa"
	quest.008F894F4B06067D.quest_desc: ["Rozłup krzemień w siatce rzemiosła w ekwipunku: z jednego dostaniesz dwa ostre odłupki."]
	quest.008F894F4B06067D.title: "Odłupki krzemienia"
	quest.0091A7FB3AD51AB4.quest_desc: ["Największa magiczna torba. Przepis wymaga gwiazdy Netheru z Withera."]
	quest.0092EB6702CCBCF8.quest_desc: ["W menu trybów ustawisz zamianę ({effortlessbuilding.action.replace_mode}): kształt wypełni tylko powietrze, tylko istniejące bloki, jedno i drugie albo tylko bloki takie jak ten w drugiej ręce."]
	quest.0092EB6702CCBCF8.title: "Tryb zamiany"
	quest.00A15B1D6BBDC43C.quest_desc: ["Dusza zamknięta w krysztale, łup nocnego licza. Z cierniem próżni zrobisz z niej naładowaną perłę, a później stół wzniesienia i kostur tłumienia."]
	quest.00BF566FCA7096FF.quest_desc: ["Łącznik zamienia mikstury z pobliskich słojów w źródło. Mocniejsze mikstury dają go więcej."]
	quest.00C0A5479AEB1949.quest_desc: ["Piąty poziom stabilizatora wymaga Endu: pyłu dragonystu z oddechu smoka i kryształu Endu, bloku netherytu i ofiary z endermana."]
	quest.00D95988AEFE1CE4.quest_desc: [
		"Prasa ustawiona nad tyglem zgniata jego zawartość w mniej przedmiotów: krzemień ze żwirem da andezyt, a śnieg lód. Andezyt z prasy zasili twój mikser stopu."
		""
		"&7Zadanie zalicza osiągnięcie Create za zgniatanie w tyglu.&r"
	]
	quest.00D95988AEFE1CE4.title: "Prasa nad tyglem"
	quest.00E1FDB8BE757FE2.quest_desc: ["Zwój osnowy zapamiętuje miejsce, w którym go użyjesz (PPM w kucaniu), a później przenosi cię tam. Zwykły zwój zużywa się po jednym skoku."]
	quest.00EA4A45FDD7B10B.quest_desc: ["Zrobisz je z duszy nieumarłego, łzy ghasta, kości, zgniłego mięsa i błony fantoma. Dusze gubią konie szkielety."]
	quest.00F12BA90B13DE6F.quest_desc: ["Opuszczona kuźnia w Netherze, w której stróżuje Netherytowa Potworność. Uważaj na lawę wokół kowadła."]
	quest.00F12BA90B13DE6F.title: "Kuźnia dusz"
	quest.0102DB2C8864510D.quest_desc: ["Motyka zaorze ziemię pod pierwsze uprawy."]
	quest.01170E5700828F01.quest_desc: [
		"Ciężką płytę wykujesz ze stali w montażu sekwencyjnym, a w recepturach liczy się jako płytka stali. Bez niej nie ma ciężkich obudów ani stalowych mechanizmów."
		""
		"&7Kroki montażu sprawdzisz w JEI (R na przedmiocie).&r"
	]
	quest.01393990D47C31C0.quest_desc: ["Skorupę zapisał &c{entity.cataclysm.ender_guardian}&r. Użyj jej, a poznasz zaklęcia pustki do Iron's Spellbooks."]
	quest.01423728EDF5A59C.quest_desc: ["Etylen z substratem dają w komorze reakcji ciśnieniowych kulki HDPE, a komora wzbogacania prasuje je w arkusz. Plastik trafi do SPS i MekaPancerza."]
	quest.0165DB31B45B1E71.quest_desc: ["Tu instalujesz moduły w MekaPancerzu i Meka-Narzędziu."]
	quest.018BB091987EA13D.quest_desc: [
		"Wither zostawia gwiazdę. Wiele mocnych przepisów w paczce jej wymaga, od latarni po szablony różdżek."
		""
		"&7Kolejny tier bossów świata pojawi się tutaj, gdy twoja drużyna wejdzie w erę elektryczności.&r"
	]
	quest.018BB091987EA13D.quest_subtitle: "Kamień milowy"
	quest.018BB091987EA13D.title: "&c{item.minecraft.nether_star}"
	quest.01963B8104853A0C.quest_desc: ["Najmniejszy dysk QIO. Zrobisz go z ostatecznego układu sterowania, perły Endera i ołowiu."]
	quest.019C1CDD2E5991C4.quest_desc: ["Różdżka z baterią zużywa energię FE zamiast trwałości. Naładujesz ją w ładowarce, np. Mekanismu albo AE2. Szablon zakładasz z blokiem miedzi."]
	quest.01A9AE1109CC41BA.quest_desc: ["Ustawisz na nim, co komórka przyjmuje, i włożysz do niej karty ulepszeń, np. rozmytą albo niszczącą nadmiar."]
	quest.01E135F90DA67028.quest_desc: ["Starożytny metal i kości koboletonów z przeklętej piramidy dają szaty faraona albo bursztynowy kostur. Bursztyn przetopisz z naszyjnika pustyni."]
	quest.01E135F90DA67028.title: "Skarby faraona"
	quest.01EEA33AC67E1C6C.quest_desc: ["Cynowa i złota inkrustacja to części wielu przepisów stołu roboczego. Złotą zrobisz z tajemnego złota."]
	quest.01EEA33AC67E1C6C.title: "Inkrustacje"
	quest.01FE52E353BF9ED7.quest_desc: ["Każda kulka antymaterii to długie godziny pracy SPS. Cztery wystarczą na moduł grawitacyjny, moduł teleportacji i transmutację w nukleosyntezatorze."]
	quest.01FE52E353BF9ED7.title: "Zapas antymaterii"
	quest.0202106104A1819A.quest_desc: ["Każda część to netherytowa zbroja z polonem, HDPE, ostatecznym układem i ogniwem indukcyjnym. Pancerz zasila się prądem, a wszystko inne dają mu moduły."]
	quest.0202106104A1819A.quest_subtitle: "Kamień milowy"
	quest.0202106104A1819A.title: "&6MekaPancerz"
	quest.020C11EF4965F285.quest_desc: ["Zbuduj pociąg z co najmniej sześciu wagonów. Każdy wagon potrzebuje własnego wózka, a długi skład przewiezie całą produkcję z odległej kopalni."]
	quest.020C11EF4965F285.quest_subtitle: "Kamień milowy"
	quest.020C11EF4965F285.title: "&6Skład towarowy"
	quest.022200CA61ECF8A2.quest_desc: [
		"Rozbuduj kocioł do najwyższego poziomu. Potrzebuje do tego dość wody, ciepła i miejsca w zbiorniku naraz – najsłabsza z tych trzech rzeczy wyznacza poziom."
		""
		"&7Płomienne ciasto przegrzewa palnik, a przegrzany palnik daje kotłowi więcej ciepła.&r"
	]
	quest.022200CA61ECF8A2.quest_subtitle: "Kamień milowy"
	quest.022200CA61ECF8A2.title: "&6Kocioł na pełnej mocy"
	quest.02311BEAB8C12444.quest_desc: ["Stół nawigacyjny z mapą albo kompasem daje sygnały redstone, które wskazują kierunek do celu. Z czujnikami poprowadzi statek bez sternika."]
	quest.0234FF67A49B1FBC.quest_desc: ["Katalizator z oddechem smoka zamyka tę przemianę w jednym bloku przed wiatrakiem. Nic się nie rozlewa, a linia działa bez końca."]
	quest.023D61F619DF3618.quest_desc: ["Torba z uwięzionym foliotem stawia za ciebie pentakl blok po bloku: klikasz podgląd ze słownika, a ona kładzie kredę i misy."]
	quest.02418C71BA9EEFA3.quest_desc: [
		"Gdy zdobędziesz kamienie milowe tej ery, oddaj &6Pieczęć Ery Pary i Stali&r. Cała twoja drużyna wejdzie w erę pary i stali, a pieczęć przepadnie."
		""
		"Pieczęć powstaje przez nasycanie duchem na ołtarzu (&d{block.malum.spirit_altar}&r): na ołtarz idą 4 sztabki stali nasyconej duszą, na podstawki obok klejnoty dostrojone, tajemne złoto, precyzyjne mechanizmy, silnik parowy i dwa trofea bossów, a do ołtarza 16 duchów piekielnych, 16 tajemnych i 8 niegodziwych."
		""
		"&7Dokładny przepis zobaczysz w JEI: najedź na pieczęć i wciśnij R.&r"
	]
	quest.02418C71BA9EEFA3.quest_subtitle: "Oddaj pieczęć"
	quest.02418C71BA9EEFA3.title: "Brama: Era Pary i Stali"
	quest.026C7E0C1FE4AE08.quest_desc: ["Odlana część działa wychodzi z formy pełna. Wiertło do dział rozwierca ją przy napędzie Create i dopiero wtedy da się z niej strzelać."]
	quest.0271DE904705BB3F.quest_desc: ["Ograniczone beczki mają od jednej do czterech przegródek, każdą na jeden rodzaj przedmiotu. Na froncie widać, co leży w środku."]
	quest.02868A4D0CA93AF6.quest_desc: ["Wylewka napełnia butelki i wiadra pod sobą, na składnicy albo na taśmie. Pobiera płyn ze zbiornika lub rury nad sobą."]
	quest.02891F86D18A850E.quest_desc: ["Postaw diamentową skrzynię albo podnieś poziom złotej i przyjrzyj się jej przez chwilę. To prawie dwie podwójne skrzynie w jednym bloku."]
	quest.02891F86D18A850E.title: "Diamentowa skrzynia"
	quest.028A1EC6E69AA3FD.quest_desc: ["Czujnik wysokości daje sygnał zależny od wysokości, a czujnik przechyłu zależny od nachylenia. Podłącz je do palników i śmigieł, a statek sam utrzyma pułap i poziom."]
	quest.028A1EC6E69AA3FD.title: "Przyrządy pokładowe"
	quest.02A29FD113D8D2B7.quest_desc: ["Zdalny sterownik to pilot do nadajników sygnału: każdy przycisk nadaje na innej częstotliwości. Steruj nim bramami, windami i maszynami z daleka."]
	quest.02A29FD113D8D2B7.title: "Zdalne sterowanie"
	quest.02E867FFAF07C0C2.quest_desc: ["Wykop sadzawkę wody, np. 2×2, otocz ją kwiatami i wrzuć do niej diament. Gdy uderzy piorun, sadzawka stanie się portalem do Lasu Zmierzchu."]
	quest.02E867FFAF07C0C2.quest_subtitle: "Kamień milowy"
	quest.02E867FFAF07C0C2.title: "&aLas Zmierzchu"
	quest.0306894F1AD242F7.quest_desc: ["Kornelia zostawia klucz do zamarzniętych skrzyń, które stoją w Lodowym Labiryncie."]
	quest.0326906705A76C0D.quest_desc: [
		"Rytuał ulepszenia: deski drewna szlachetnego (edelwood) na kuźni, 4 tajemne kryształy i 4 kawałki złomu przyzywacza na piedestałach, do tego 500 aurealu, 6000 krwi i 10 dusz. Popatrz na ulepszoną kuźnię."
		""
		"&7Rytuał uruchamiasz młotem kowalskim; JEI (U na kuźni) pokaże wszystkie rytuały.&r"
	]
	quest.0326906705A76C0D.title: "Kuźnia: poziom II"
	quest.034402F79BBE91EE.quest_desc: ["Mieści dużo więcej i ma miejsce na kilka ulepszeń naraz."]
	quest.0350729D2614C31B.quest_desc: ["Samotny monolit z Moog's End Structures sterczy nad pustką."]
	quest.0350729D2614C31B.title: "Monolit"
	quest.035995539D6360EB.quest_desc: ["Rtęciowe przewody miedziane łączą węzły z wyciągaczami i wstawiaczami. Tak zbudujesz sieć, która sama karmi aparaturę."]
	quest.035995539D6360EB.title: "Przewody i węzły"
	quest.035BC5C429692AA8.quest_desc: ["Bez kontrolera pociąg nie ruszy: siada przy nim maszynista albo pociąg prowadzi &6{item.create.schedule}&r."]
	quest.036CACEE765E308F.quest_desc: ["Loch ukryty we wnętrzu wyspy, pilnowany przez kamiennych strażników. W jego sercu czeka &c{entity.aether.slider}&r."]
	quest.036CACEE765E308F.title: "Brązowy loch"
	quest.037B27FC641245C2.quest_desc: ["Koniuszy w stajni hoduje konie i przygotowuje je dla kawalerii kolonii."]
	quest.0382C88FA6EA89A4.quest_desc: ["Cloggrum, froststeel i utherium wydobędziesz tylko w Undergarden. Zrobisz z nich broń i zbroje na tutejsze stwory."]
	quest.0382C88FA6EA89A4.title: "Kruszce głębin"
	quest.0389E6ED26C49BE6.quest_desc: ["Ranisz nim wrogiego stwora, a gdy padnie, zostawi Spiritus, surowy materiał duszy. Zrobisz go w Tabula Vitae z żelaza i nici."]
	quest.039117A30BF5DFF7.quest_desc: ["Wioski Oh The Biomes We've Gone stoją w biomach tego moda i są zbudowane z jego drewna."]
	quest.039117A30BF5DFF7.title: "Wioska BWG"
	quest.03A1986679AAB85A.quest_desc: ["Sproszkowany szmaragd i esencja Fae. Obwód trzyma manę dla właściciela, który stoi w pobliżu."]
	quest.03A1986679AAB85A.quest_subtitle: "Składnik pieczęci"
	quest.03A90135230FAC67.quest_desc: ["Przypisz farmerowi tyle pól, ile zmieści jego chata. Wyższy poziom farmy obsłuży więcej pól."]
	quest.03A90135230FAC67.title: "Zielone kciuki"
	quest.03B546ADD50FAE98.quest_desc: ["Pozwala trzymać plecaki w plecaku, a ich ulepszenia działają razem. Przepis wymaga gwiazdy Netheru."]
	quest.03D49F116F334AA8.quest_desc: [
		"Plus na klawiaturze numerycznej („{key.effortlessbuilding.open_modifiers_screen}”) otwiera ustawienia modyfikatorów. Lustro odbija każdy postawiony blok względem osi, a szyk powtarza go co kilka bloków."
		""
		"&7Modyfikatory działają też przy zwykłym stawianiu i razem z trybami kształtów.&r"
	]
	quest.03D49F116F334AA8.title: "Lustro i szyk"
	quest.03E0508560A59D5E.quest_desc: ["Plac otoczony kamiennym murem to arena Nagi. To pierwszy boss Lasu Zmierzchu: dopóki go nie pokonasz, dalsze budowle są zamknięte."]
	quest.03E0508560A59D5E.title: "Dziedziniec Nagi"
	quest.03EC0C922F07CE48.quest_desc: ["Głęboko pod ziemią stoją miedziane komnaty pełne pułapek i przyzywaczy. Klucze zdobyte w komnatach otwierają skarbce z cennym łupem."]
	quest.03EC0C922F07CE48.title: "Komnaty prób"
	quest.03FF31B1E703C976.quest_desc: [
		"Dodatki Iron's Spells dokładają szkoły powietrza, nekromancji, otchłani i technomancji. Ich runy zrobisz jak zwykłe: pusty kamień runiczny i fokus szkoły, np. pręt breeze'a dla powietrza albo kulę ektoplazmy dla nekromancji."
		""
		"&7Pierwszą runę nowej szkoły znajdziesz też w rozdziale ery arkanów.&r"
	]
	quest.03FF31B1E703C976.title: "Nowe szkoły magii"
	quest.040975B397B3A13B.quest_desc: ["Znajdź klasztor z Mowzie's Mobs. Mieszka w nim {entity.mowziesmobs.sculptor}, a strzegą go blefy, z których wypada {item.mowziesmobs.bluff_rod}."]
	quest.040975B397B3A13B.title: "Klasztor"
	quest.040C8BC00793DFFF.quest_desc: ["Zbiera dojrzałe plony wokół kotła i odkłada je do skrzyni obok niego. Każdy zbiór kosztuje trochę źródła."]
	quest.040E6644D17A97BE.quest_desc: ["Tajemną esencję znajdziesz w skrzyniach lochów i magicznych budowli. Dwie trafią na piedestały przy Pieczęci Ery Mosiądzu."]
	quest.040E6644D17A97BE.quest_subtitle: "Składnik pieczęci"
	quest.04145E4A116003C8.quest_desc: [
		"Pokrywa odlewnicza na tyglu nad płomiennym palnikiem topi żeliwo, brąz albo stal. Płynny metal wlewasz do formy armaty wyciętej piłą z pni; do odlewu potrzebny jest też piasek odlewniczy."
		""
		"&7Cały odlew pokazuje Ponder (W) na pokrywie.&r"
	]
	quest.04145E4A116003C8.title: "Odlewnia dział"
	quest.042B57FBDF439B9F.quest_desc: ["Rudę złota wykopiesz dopiero żelaznym kilofem. Dwie sztabki trafią do Pieczęci Ery Run."]
	quest.042B57FBDF439B9F.quest_subtitle: "Składnik pieczęci"
	quest.042B57FBDF439B9F.title: "Złoto"
	quest.04610C7144030208.quest_desc: ["Żyły diamentów i szmaragdów dają surowe klejnoty zamiast gotowych. JEI pokaże, jak je przerobić (U na przedmiocie)."]
	quest.04610C7144030208.title: "Klejnoty z głębin"
	quest.047BE867076E0079.quest_desc: ["Dowód automatyzacji: 256 mąki. Niech taśma lub lejek podaje pszenicę do młynka, a gotowa mąka sama trafia do pojemnika."]
	quest.047BE867076E0079.title: "Młyn na pełnych obrotach"
	quest.047E1B3DE2EEDC63.quest_desc: ["Starożytny kodeks z netherytu, fiolki krwi, pioruna w butelce, tajemnej tkaniny i zniszczonej księgi z półek cytadeli. Krew ugotujesz ze stwora w kotle nad ogniskiem."]
	quest.0499EEF40E246643.quest_desc: ["Napęd mieści dziesięć komórek pamięci i udostępnia ich zawartość całej sieci. Zrobisz go z procesora inżynieryjnego i kabla fluix."]
	quest.04A36EF3F26D6261.quest_desc: ["Dachy w wielu kształtach, z drewna, kamienia i strzechy, razem z rynnami. Kamienne zrobisz w przecinarce."]
	quest.04A36EF3F26D6261.title: "Dachy"
	quest.04BAB86ABD1C5247.quest_desc: ["Przywołuje foliota, który nosi przedmioty z jednego pojemnika do drugiego. Wskaż mu księgą skrzynię źródłową i docelową."]
	quest.04C1A2A7B07CEF10.quest_desc: [
		"&7Era mosiądzu · zalecane: diamentowa zbroja&r"
		"Nocny licz czeka na szczycie swojej wieży w zimnych biomach. Walczy z dystansu, więc nie stój w miejscu."
	]
	quest.04C1A2A7B07CEF10.quest_subtitle: "Boss"
	quest.04C1A2A7B07CEF10.title: "&c{entity.bosses_of_mass_destruction.lich}"
	quest.04D7BE861AE65A1C.quest_desc: ["Do &6łożyska wiatraka&r przyklej ramy lub żagle i złóż wiatrak prawym przyciskiem na łożysku. Im więcej żagli, tym mocniejszy napęd."]
	quest.04D7BE861AE65A1C.title: "Wiatrak"
	quest.04D971B1C660D665.quest_desc: ["Księga zaklęć z GTBC's Spellbooks: netheryt, runy świętości i natury, tajemna tkanina i zaklęta książka. Ten dodatek wnosi też Rozwścieczonego Umarłego Króla z rozdziału ery transcendencji."]
	quest.04F8C98FB6AADB8D.quest_desc: ["Oddech smoka nasycony w stole do zaklinania. Bez niego nie zbudujesz endowej półki."]
	quest.04FF02A313E6B726.quest_desc: ["Dostawca wzorów z dwa razy większą liczbą gniazd. Jedna maszyna obsłuży więcej przepisów."]
	quest.0500128DE044D272.quest_desc: ["Mieniący się kolorami budulec z Pałacu Zorzy. Świetnie wygląda w lodowych salach."]
	quest.05011C227070A982.quest_desc: ["Póki mają prąd, chronią przed obrażeniami od upadku i pozwalają wejść na blok jak po schodach."]
	quest.0514AD14D33CB401.quest_desc: ["Z łusek Nagi zrobisz napierśnik i nogawice, mocniejsze niż żelazne."]
	quest.0541B5D150A9FCFE.quest_desc: ["Niebieska chmura wybija w górę każdego, kto na nią wskoczy. Spróbuj."]
	quest.0541B5D150A9FCFE.title: "Odbicie od chmury"
	quest.0545D5FDDC0DD286.quest_desc: [
		"&7Era atomu · zalecana dobra zbroja, tarcza i mikstury leczenia&r"
		""
		"Strażnik ruin portalu sprawdza, czy jesteś godny Eternal Starlight. Za portalem czekają golem w Kuźni Golemów i potworność w labiryncie Przeklętego Ogrodu."
	]
	quest.0545D5FDDC0DD286.title: "Strażnicy gwiazd"
	quest.0555D4F212A06AA4.quest_desc: ["Karta pojemności dokłada miejsc w filtrze szyny, a karta przyspieszenia przyspiesza szyny i maszyny AE2."]
	quest.0555D4F212A06AA4.title: "Karty ulepszeń"
	quest.05BEFB774970E12D.quest_desc: ["Rzuć kulką pyłku w pszczołę. Zapylona poleci do ula zrobić miód."]
	quest.05BEFB774970E12D.title: "Zapylanie"
	quest.05E6B437902A2E17.quest_desc: ["Celuj nim w kamień główny i przytrzymaj użycie: postawi i zaznaczy cały wzór za ciebie. Shift i użycie przełącza rytuał."]
	quest.05EA90F4F047DA04.quest_desc: [
		"Na stole kowalskim, z odłamkiem duszy wypaczenia i złamanym kosturem legendy, przekujesz go w jeszcze mocniejszy kostur."
		""
		"&7Kolejny tier bossów magii pojawi się tutaj, gdy twoja drużyna wejdzie w erę elektryczności.&r"
	]
	quest.05F564DFBF04D8E2.quest_desc: ["Miej naraz 512 odłamków rtęci. Kilka destylatorów zasilanych brukiem z generatora zrobi to bez ciebie."]
	quest.05F564DFBF04D8E2.quest_subtitle: "Dowód automatyzacji"
	quest.05F564DFBF04D8E2.title: "Rtęć hurtem"
	quest.05FC20A15925003A.quest_desc: ["Stawia losowe bloki z twojego paska szybkiego wyboru albo z zapisanej palety, więc ściany i drogi nie wyglądają jak z jednego bloku. Zrobisz ją z bloku i sztabki żelaza."]
	quest.05FC20A15925003A.quest_subtitle: "Kamień milowy"
	quest.05FC20A15925003A.title: "&e{item.mechtrowel.mech_trowel}"
	quest.06014B067F499DAF.quest_desc: ["Magazyn energii: przyjmuje ją od dołu i powoli oddaje górą. Do budowy potrzebny jest kwas siarkowy albo lit."]
	quest.0617F97E8241671D.quest_desc: [
		"Szata pyromanty ulepszona na stole kowalskim ignitium i jego szablonem. Oba łupy zostawia Ignis z rozdziału ery arkanów."
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę transcendencji.&r"
	]
	quest.062C848C3DEA7A46.quest_desc: ["Klatkowa lampa z mosiądzu. Create Deco ma takie lampy z każdego metalu i z kilkoma barwami światła, a każda reaguje na sygnał redstone."]
	quest.062EC956A271670A.quest_desc: [
		"Ta strona prowadzi przez krainy, plony i kruszce Undergarden. Brama i bossowie są w drzewie ery elektryczności."
		""
		"&7Bez światła nie zobaczysz tu nic. Zabierz dużo pochodni.&r"
	]
	quest.062EC956A271670A.title: "Pod światem"
	quest.062F4E5C811A3750.quest_desc: ["Duża kolonia przyciąga duże najazdy. Trzydziestu strażników to już prawdziwa armia."]
	quest.062F4E5C811A3750.title: "30 strażników"
	quest.06401B803DFA50EE.quest_desc: ["Kliknij chatę budowniczego prawym przyciskiem i przeczytaj przewodnik. Wyjaśnia, jak działają prośby, budowy i mieszkańcy."]
	quest.06401B803DFA50EE.title: "Przewodnik kolonii"
	quest.065DB739B1ACFB21.quest_desc: [
		"Rytuał szuka najbliższej budowli, którą wskażesz dodatkiem na kotle: klejnot źródła to legowisko wildenów, piaskowiec świątynia pustynna, a szmaragd posterunek. Wynik trafia do kompasu drogi."
		""
		"&7Pozostałe dodatki pokaże JEI w zakładce rytuału.&r"
	]
	quest.0678B9632C6A750F.quest_desc: ["Totem zbiera dusze stworzeń, które zabijasz. Z tej energii korzystają mroczna różdżka, fokusy i rytuały Goety."]
	quest.0683988BF5F919D4.quest_desc: ["Oswój jedną z kryształowych ciem tego wymiaru."]
	quest.0683988BF5F919D4.title: "Oswojona ćma"
	quest.06901FF8E2DADA42.quest_desc: ["Oswój beehemotha, olbrzymią pszczołę z ula. Będziesz mógł na nim latać."]
	quest.06901FF8E2DADA42.title: "Oswojony beehemoth"
	quest.0692E81AC7B21B70.quest_desc: ["Przelewa stopiony metal w dół, do 5 bloków, np. z misy hutniczej na stół odlewniczy. Sygnałem redstone otworzysz go we właściwej chwili."]
	quest.06969DC0098E3AE4.quest_desc: [
		"Składacz armat nakłada na siebie stalowe warstwy różnych rozmiarów i tworzy działo warstwowe, mocniejsze od zwykłego odlewu. Spawarka łączy gotowe części działa w jedną całość."
		""
		"&7Ponder (przytrzymaj W nad przedmiotem) pokaże cały proces.&r"
	]
	quest.06969DC0098E3AE4.title: "Działo warstwowe"
	quest.06970327D8662686.quest_desc: ["Tańsza odmiana obwodu many: zamiast esencji Fae wystarczy żelazo. Cztery trafią do Pieczęci Finału."]
	quest.06970327D8662686.quest_subtitle: "Składnik pieczęci"
	quest.06A3B68A4AA1800B.quest_desc: ["Wibrator wysyła drgania w głąb ziemi, a czytnik pokazuje, jakie bloki leżą pod nim aż do skały macierzystej."]
	quest.06A3B68A4AA1800B.title: "Sejsmograf"
	quest.06B7CA3EC95E9756.quest_desc: [
		"Gdy zdobędziesz kamienie milowe tej ery, oddaj &6Pieczęć Finału&r. Cała twoja drużyna wejdzie w finał, a pieczęć przepadnie."
		""
		"Pieczęć Finału złożysz na mechanicznym stole rzemieślniczym Create w siatce 5×5 z siedmiu odznak drzewek, 2 obwodów many, 4 obwodów magitech, 4 dostrojonych diamentów i trofeów dwóch bossów tej ery. &cOdznak księga jeszcze nie przyznaje: dadzą je ostatnie zadania drzewek Technika, Magia, Magazyny, Budowanie, Świat, Bossowie i Kolonia.&r"
		""
		"&7Dokładny przepis zobaczysz w JEI: najedź na pieczęć i wciśnij R.&r"
	]
	quest.06B7CA3EC95E9756.quest_subtitle: "Oddaj pieczęć"
	quest.06B7CA3EC95E9756.title: "Brama: Finał"
	quest.06D13C0B3D3DDA13.quest_desc: ["Amulet skupienia, ciężki łańcuch albo talizman przywoływacza z mitrylu. Każdy wzmacnia inny styl walki zaklęciami."]
	quest.06D13C0B3D3DDA13.title: "Naszyjnik maga"
	quest.06D2626F6306AB16.quest_desc: ["Rytuały chowańców wzywają ducha w ciele zwierzęcia, który chodzi z tobą i daje premię: bóbr ścina drzewa, chciwiec zbiera przedmioty, a ptak z innego świata pozwala szybować. Odpraw dowolny z nich."]
	quest.06D2626F6306AB16.title: "Chowaniec okultysty"
	quest.06F79FAB0A10065F.quest_desc: ["Szmaragd przebudzony w przeklętym nasycaczu albo w siatce z totemem. Na nim opiera się większość przyrządów i fokusów Goety."]
	quest.070516E1F061620E.quest_desc: ["Stop andezytu z wolframem. Mieszasz go nad płomiennym palnikiem rozgrzanym plackiem płomienia do białości."]
	quest.070717EEFDCBB40F.quest_desc: ["Utrzymuje załadowane chunki wokół siebie, więc maszyny pracują, gdy jesteś daleko. Obszar ustawisz w jego oknie."]
	quest.0707AF284AEA0305.quest_desc: ["Pierwszy porządny kilof Aetheru. Przy kopaniu czasem wydobywa dodatkowe odłamki ambrozjum."]
	quest.070D073F455FB1EA.quest_desc: ["Stelaż chwyta bloki wokół siebie bez kleju: liniowy w rzędzie, promienisty dookoła. Przyklejacz łapie albo puszcza blok przed sobą na sygnał redstone."]
	quest.070D073F455FB1EA.title: "Stelaże i przyklejacz"
	quest.0711C3097BC281FA.quest_desc: ["Głębiny, las echa, zachmurzone kolumny i kwitnące jaskinie. Odwiedź wszystkie cztery."]
	quest.0711C3097BC281FA.title: "Krainy Otherside"
	quest.07285A05F8E762F4.quest_desc: ["Księga zaklęć Umarłego Króla, mocniejsza od miedzianej. Załóż ją w slot księgi."]
	quest.07508BE812932CED.quest_desc: ["Kolejny poziom pojemnika mieści kilka razy więcej. Zrobisz go z poprzedniego, infuzowanego stopu i zaawansowanego układu."]
	quest.07555AA117CB05DF.quest_desc: ["Filtr na adres paczki. W lejku albo na taśmie skieruje paczkę we właściwe miejsce."]
	quest.0762E1C6C8BFC49D.quest_desc: [
		"Technika i magia przestają być osobnymi drogami. Mahou Tsukai uczy magii krwi i kręgów, a twoje maszyny dadzą jej siłę."
		"Na końcu czekają najgroźniejsi bossowie Cataclysmu. Nie ma tu już nic nowego do wydobycia: liczy się to, co umiesz."
		""
		"Era kończy się bramą. Wymaga ona kamieni milowych z gałęzi tego rozdziału i Pieczęci Finału."
	]
	quest.0762E1C6C8BFC49D.quest_subtitle: "Początek ery"
	quest.0762E1C6C8BFC49D.title: "Era Transcendencji"
	quest.0762E20DA0734934.quest_desc: ["Grabieżcy napadają na wioski z drewnianych wież. Na szczycie wieży stoi skrzynia z łupem."]
	quest.0762E20DA0734934.title: "Posterunek grabieżców"
	quest.076AA77AF713C8AB.quest_desc: [
		"&7Era arkanów · zalecana najlepsza zbroja maga i mikstury leczenia&r"
		""
		"Apotyczni kultyści czczą istotę, która przekroczyła granice śmiertelności. W głębi ich kwatery czeka na wyzwanie {entity.discerning_the_eldritch.ascended_one}."
	]
	quest.076AA77AF713C8AB.title: "Kwatera kultystów"
	quest.077B5B677987E668.quest_desc: ["Mieści duży zapas jednego rodzaju bloków, a różdżka bierze z niej budulec. Ekwipunek nie zapcha się kamieniem."]
	quest.07913849E4B00331.quest_desc: ["Miej naraz 256 wypolerowanego różowego kwarcu. Ręką zużyjesz na to stos papieru ściernego, więc niech aplikatory z papierem polerują kwarc na taśmie."]
	quest.07913849E4B00331.quest_subtitle: "Dowód automatyzacji"
	quest.07913849E4B00331.title: "Polerownia"
	quest.07C42C52F7B47591.quest_desc: ["Infuzer chemiczny łączy deuter z trytem w paliwo D-T. Nim napełnisz pojemnik termonuklearny do zapłonu i zasilisz reaktor w trakcie pracy."]
	quest.07C5E55BA72E853C.quest_desc: ["W erze elektryczności zwykłe budynki kolonii rosną do 5., ostatniego poziomu. Zacznij od ratusza."]
	quest.07C5E55BA72E853C.title: "Ratusz na 5. poziomie"
	quest.07C7216FD4FB73BE.quest_desc: [
		"Create: Central Kitchen łączy Create z Farmer's Delight. Płomienny palnik grzeje garnek i patelnię, mechaniczne ramię wkłada składniki i wyjmuje gotowe dania, a aplikator z nożem albo piła kroją na desce do krojenia."
		""
		"&7Ponder (W) przy tych blokach pokaże szczegóły.&r"
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę pary i stali.&r"
	]
	quest.07C7216FD4FB73BE.title: "Kuchnia na taśmie"
	quest.07C866FBAFDBC314.quest_desc: ["Dżin obsługuje maszynę za ciebie: zamawia z magazynu wymiarowego składniki i odnosi gotowe przedmioty."]
	quest.07DCFF3ED36E75AF.quest_desc: ["Miej naraz 256 soli alchemicznych dowolnego rodzaju. Piec kalcynacyjny niech dostaje przedmioty z leja albo przez logistykę Theurgy, nie z twojej ręki."]
	quest.07DCFF3ED36E75AF.quest_subtitle: "Dowód automatyzacji"
	quest.07DCFF3ED36E75AF.title: "Warzelnia soli"
	quest.0820DDC5B7E8B24E.quest_desc: ["Dzikie pomidory, kapusta i cebula rosną w różnych biomach. Zbierz każde i posadź u siebie."]
	quest.0820DDC5B7E8B24E.quest_subtitle: "Kamień milowy"
	quest.0820DDC5B7E8B24E.title: "&aTrzy uprawy"
	quest.0821899B97FB57F0.quest_desc: ["Kompas ze złota i ametystu, który wskaże drogę do budowli znalezionej rytuałem. Bez rytuału jest zwykłą błyskotką."]
	quest.0822763050A1A8FF.quest_desc: ["Duch Słońca zostawia ołtarz. Postaw go w Aetherze, a ustawisz na nim porę dnia."]
	quest.0822763050A1A8FF.quest_subtitle: "Kamień milowy"
	quest.0822763050A1A8FF.title: "&c{block.aether.sun_altar}"
	quest.0825D1D8E1416DF6.quest_desc: ["Kliknij nim postawioną skrzynię albo beczkę, a podniesiesz jej poziom bez wyjmowania zawartości."]
	quest.083B9FA2E9C70D1B.quest_desc: ["Żelazo, miedź albo złoto zespolone z tajemną esencją. Idzie na kule ulepszeń, pierścienie i broń maga."]
	quest.083E4A9EC23B31B7.quest_desc: ["&6{block.create.mechanical_press}&r nad składnicą albo taśmociągiem zgniata sztabki w arkusze. Arkusze żelaza pójdą na mieszadło, śmigło i wiele innych części."]
	quest.083E4A9EC23B31B7.quest_subtitle: "Kamień milowy"
	quest.083E4A9EC23B31B7.title: "&6Prasa i arkusze żelaza"
	quest.08428227089A4522.quest_desc: ["Znajdź wioskę. Mieszkańcy handlują, a w ich skrzyniach bywa przydatny łup."]
	quest.08428227089A4522.quest_subtitle: "Kamień milowy"
	quest.08428227089A4522.title: "&aWioska"
	quest.0863DB1B7A0CDFE2.quest_desc: [
		"&7Era mosiądzu · zalecane: diamentowa zbroja&r"
		"Kwiat próżni zapuścił korzenie w ukrytej podziemnej grocie. Znajdziesz go, zwiedzając jaskinie."
	]
	quest.0863DB1B7A0CDFE2.quest_subtitle: "Boss"
	quest.0863DB1B7A0CDFE2.title: "&c{entity.bosses_of_mass_destruction.void_blossom}"
	quest.086782BDD34E90EF.quest_desc: ["Rzucone jak oko Endera prowadzi do przeklętej piramidy na pustyni."]
	quest.086925E4AF1564FB.quest_desc: [
		"&7Era arkanów. Zalecany ekwipunek: najlepsza zbroja maga i mikstury leczenia.&r"
		"Walka toczy się w głębi kwatery kultystów. Trofeum tego bossa może zastąpić w pieczęci trofeum Starożytnej Pozostałości."
	]
	quest.086925E4AF1564FB.quest_subtitle: "Boss"
	quest.086925E4AF1564FB.title: "&c{entity.discerning_the_eldritch.ascended_one}"
	quest.0872CA492305EA2F.quest_desc: ["Aplikator używa przedmiotu jak gracz: nakłada, klika i składa. Mechaniczne stoły rzemieślnicze ustawione w siatkę zrobią przepisy za duże na zwykły stół, a aplikatory obsłużą montaż sekwencyjny."]
	quest.0872CA492305EA2F.quest_subtitle: "Kamień milowy"
	quest.0872CA492305EA2F.title: "&6Aplikator i mechaniczny stół"
	quest.0876B2C3A61440D3.quest_desc: ["Z animą i płonącym okiem. Postawiony daje lot jak w trybie kreatywnym w kolumnie 7×7 nad sobą, wygodny przy budowie."]
	quest.08942447C07DF8F5.quest_desc: [
		"Topór i hełm strażnika nigdy się nie psują. Topór prawym przyciskiem tnie szerokim łukiem, a ze skradaniem uderza w ziemię falą."
		""
		"&7Kolejny tier Mowzie's Mobs pojawi się tutaj, gdy twoja drużyna wejdzie w erę pary i stali.&r"
	]
	quest.08942447C07DF8F5.title: "Żelazny oręż"
	quest.08968C53FDC164EE.quest_desc: [
		"Fiolka ognistej krwi hydry z żelazną sztabką daje ognisty metal. Zrobisz z niego miecz, który podpala wrogów, i zbroję."
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę okultyzmu.&r"
	]
	quest.089B1C8D56671E39.quest_desc: ["Pierścień zadaje dodatkowe obrażenia zależne od maksymalnej many celu. Groźny dla magów."]
	quest.08AC5F8F4454BC61.quest_desc: ["Chatę zaklinacza zrobisz ze stołu do zaklinania. Zaklinacz zamienia doświadczenie mieszkańców w zaklęte księgi."]
	quest.08AC5F8F4454BC61.title: "Zaklinacz"
	quest.08C5F9DB85521AA8.quest_desc: ["Szklarz robi szyby i szkło barwione, o które proszą budowniczy."]
	quest.08F341A86235FD17.quest_desc: ["Przesiewa żwir, piasek i ziemię przez siatki i wyciąga z nich rudy, nasiona i klejnoty. Lepsza siatka daje lepszy urobek."]
	quest.08F341A86235FD17.title: "Przesiewacz"
	quest.0902162146E3CFED.quest_desc: ["Przesyła energię, płyny, gazy, przedmioty i ciepło bez kabli, także między wymiarami. Wszystkie na tej samej częstotliwości działają jak jeden blok."]
	quest.090454E4FB72E932.quest_desc: ["Zbiornik przechowuje płyny, a pompa przepycha je rurami. Pompa działa tylko z napędem, a jej strzałka pokazuje kierunek przepływu."]
	quest.090454E4FB72E932.title: "Zbiornik i pompa"
	quest.090580AC7CCC7809.quest_desc: ["Rozbiera stare narzędzia i zbroje z powrotem na materiały. Część materiału przepada, ale reszta wraca do pracy."]
	quest.090B7F688EB9B972.quest_desc: ["Cały strój uszyjesz z tajemnej tkaniny. Sam dodaje many, a każda jego część jest bazą szat szkoły."]
	quest.090B7F688EB9B972.title: "Szaty maga"
	quest.091A7A23E2E0339A.quest_desc: ["Tu uczysz się nowych glifów. Użyj księgi zaklęć na stole, wybierz glif i wrzuć na stół pokazane przedmioty; zapłacisz też doświadczeniem."]
	quest.0920496C458A2339.quest_desc: ["Żelazna różdżka budowlana stawia naraz więcej bloków niż kamienna i miedziana z ery run. Bloki bierze z ekwipunku."]
	quest.09291BAAED942687.quest_desc: ["Podwodna świątynia strażników. Prastrażnicy rzucają na intruzów zmęczenie, więc zabierz mleko i mikstury oddychania pod wodą."]
	quest.09291BAAED942687.quest_subtitle: "Kamień milowy"
	quest.09291BAAED942687.title: "&aMonument oceaniczny"
	quest.093F11210845D7F7.quest_desc: [
		"Każdy Bookwyrm przypisany do pulpitu pozwala podłączyć więcej skrzyń. Użyj uroku na pulpicie."
		""
		"&7Urok da ci rytuał budzenia (Awakening) z książką i piórami.&r"
	]
	quest.094F84586A4F7278.quest_desc: [
		"Wycina całą budowlę razem z zawartością i wkleja ją w nowym miejscu. Przeprowadzka bazy zajmie kilka minut."
		""
		"&7Kolejny tier gadżetów pojawi się tutaj, gdy twoja drużyna wejdzie w erę atomu.&r"
	]
	quest.097A6887EC9FF0F6.quest_desc: ["Łukodrzewy poznasz po kolorowych liściach: niebieskich, zielonych, fioletowych albo czerwonych. Z ich drewna zrobisz stół skryby, słoiki i komorę nasycania."]
	quest.097A6887EC9FF0F6.title: "Łukodrzew"
	quest.097BC53951A8ECCA.quest_desc: ["Złoże osmu leży pod ziemią, podobnie jak żelazo. Osm to podstawa Mekanismu: obudowy, układy sterowania i maszyny."]
	quest.098F802EF71CF3A4.quest_desc: ["Książka, dwa diamenty i cztery obsydiany dają stół do zaklinania. Regały ustawione wokół wzmacniają zaklęcia."]
	quest.098F802EF71CF3A4.quest_subtitle: "Kamień milowy"
	quest.098F802EF71CF3A4.title: "&a{block.minecraft.enchanting_table}"
	quest.099868764AE0F13A.quest_desc: ["Zaawansowane wersje mają więcej miejsc na filtr, większy zasięg magnesu i szybszy lej. Przepisy wymagają diamentów i złota."]
	quest.099868764AE0F13A.title: "Zaawansowane ulepszenia"
	quest.099D20D0F4E0427F.quest_desc: ["Włóż do niej totem z energią dusz. Mroczny ołtarz stoi na klatce i z niej czerpie energię na rytuały."]
	quest.09A95C24675BD99B.quest_desc: ["Stal z wielkiego pieca TFMG stopiona pod pokrywą odlewniczą, odlana i rozwiercona daje lufę i komorę, które wytrzymają więcej ładunków naraz. Więcej prochu to dalszy strzał."]
	quest.09A95C24675BD99B.quest_subtitle: "Kamień milowy"
	quest.09A95C24675BD99B.title: "&6Stalowe działo"
	quest.09B4DAB90AEF07D8.quest_desc: ["Róg, kolec i skrzydło zdobędziesz z trzech odmian wildenów: łowcy, obrońcy i prześladowcy. Spotkasz je w lasach i w ich legowiskach."]
	quest.09B4DAB90AEF07D8.title: "Łupy z wildenów"
	quest.09D2BCF27839DC98.quest_desc: ["Kopanie całych żył, Fortuna i jedwabny dotyk. Fortunę i jedwabny dotyk przełączasz w ustawieniach narzędzia."]
	quest.09D2BCF27839DC98.title: "Moduły Meka-Narzędzia"
	quest.09D746883C62750A.quest_desc: [
		"Postęp w księdze i era należą do drużyny, a nie do pojedynczego gracza. Załóż drużynę, zanim zaczniesz grać: użyj przycisku drużyn w ekwipunku albo wpisz &6/ftbteams party create <nazwa>&r."
		""
		"Kto dołączy do drużyny później, przejmuje jej postęp i erę. Kto z niej odejdzie, wybiera, czy zachowa postęp drużyny, czy wróci do swojego dawnego: &6/ery wybor druzyna&r albo &6/ery wybor wlasny&r."
		""
		"Na serwerze może grać kilka rywalizujących drużyn. Każda idzie przez ery we własnym tempie, a nagrody z zadań odbiera każdy gracz osobno."
	]
	quest.09D746883C62750A.quest_subtitle: "Zanim zaczniesz"
	quest.09D746883C62750A.title: "Drużyna"
	quest.09DA3E6A9908DC86.quest_desc: ["Miej naraz 256 bloków lewititu. Tyle wystarczy, by unieść w powietrze całą bazę – jeśli linia z kamienia Endu pracuje sama."]
	quest.09DA3E6A9908DC86.quest_subtitle: "Dowód automatyzacji"
	quest.09DA3E6A9908DC86.title: "Latająca wyspa"
	quest.09DE2B407A78854B.quest_desc: ["Rzemieślnik robi łuki i strzały dla łuczników kolonii oraz wełniane przedmioty."]
	quest.09E2812C6BD3D8BC.quest_desc: ["Z bloku witherytu zrobisz broń palną Cataclysmu: działko laserowe i wyrzutnię na ramię."]
	quest.09EAC3BC57B56720.quest_desc: ["Broń, którą duch kapitan nosił za życia. Czasem zostaje po walce."]
	quest.0A03B6EAD09C9721.quest_desc: [
		"Czwarty poziom stosów. Przepis wymaga bloku netherytu."
		""
		"&7Kolejny tier plecaków pojawi się tutaj, gdy twoja drużyna wejdzie w erę atomu.&r"
	]
	quest.0A0690740B9A0C18.quest_desc: ["Pospolity atrament z miedzią da niepospolity, ten z żelazem rzadki, a rzadki ze złotem epicki. Lepszy atrament pozwala kuźni zwojów wykuć zaklęcie wyższego poziomu."]
	quest.0A0690740B9A0C18.title: "Atramenty"
	quest.0A0B3A4DDDD67A6D.quest_desc: ["Głodny mieszkaniec pracuje wolniej. Na początku włóż mu jedzenie do ekwipunku, a im bardziej urozmaicone, tym lepiej."]
	quest.0A0B3A4DDDD67A6D.title: "Pierwszy posiłek"
	quest.0A11B89B0FFAC847.quest_desc: [
		"Misa hutnicza zacznie topić dopiero pod zamkniętą pokrywą. Pokrywa przeszklona pozwoli postawić nad misą mikser hutniczy."
		""
		"&7Całą odlewnię pokazuje Ponder (W) na misie.&r"
	]
	quest.0A3060C061F1FD03.quest_desc: [
		"Część szat maga, tajemna esencja i runa dają szatę jednej szkoły: kriomanty, elektromanty, kapłana, wędrowca cieni, arcyprzywoływacza albo zarazy. Wzmacnia ona zaklęcia tej szkoły."
		""
		"&7Wystarczy dowolna szata na tors.&r"
		""
		"&7Kolejny tier Iron's Spells pojawi się tutaj, gdy twoja drużyna wejdzie w erę mosiądzu.&r"
	]
	quest.0A3060C061F1FD03.quest_subtitle: "Kamień milowy"
	quest.0A3060C061F1FD03.title: "&dSzaty szkoły"
	quest.0A4B2270F286100B.quest_desc: ["Płomień z płonącego kwarcu z Netheru i jasnopyłu. Świeci w pochodniach i latarniach Malum kolorem, który mu nadasz."]
	quest.0A5CE764D2131A76.quest_desc: ["Przyzywa kostur wybuchów: długie ładowanie i potężna eksplozja. Shift i prawy przycisk przełącza na serię mniejszych wybuchów albo promień, który niszczy bloki."]
	quest.0A6560E2EF3CCF5F.quest_desc: ["Podstawka na jedną komórkę, przyczepiana do kabla jak szyna. Mieści się tam, gdzie napęd by nie wszedł."]
	quest.0A671D973519F9EF.quest_desc: ["Użyj go na ziemi, a narysujesz krąg alchemiczny, który przyjmuje dwie ofiary: podstawę i katalizator. Jedne pary tworzą przedmioty, inne działają od razu na świat."]
	quest.0A6E40C03CEE6C35.quest_desc: ["Spala frakcje, których nie potrzebujesz. Wieża destylacyjna nie stanie wtedy z pełnymi zbiornikami."]
	quest.0AB8199BD822F5E9.quest_desc: ["Ramię przenosi przedmioty między wieloma punktami: zabiera z taśm i składnic, a oddaje do maszyn i skrzyń. Cele wybierasz, klikając je ramieniem przed postawieniem."]
	quest.0AD1F1DE9C3F9590.quest_desc: ["Wejdź do Królestwa demonów. Mieszkające tu demony (Daemonium) zostawiają skażone mięso i trofea, których nie zdobędziesz nigdzie indziej."]
	quest.0AD1F1DE9C3F9590.title: "Królestwo demonów"
	quest.0ADD9870AE35AD42.quest_desc: ["Obeliski wzmacniają stół do zaklinania jak regały z książkami, a lśniący obelisk z błyskotliwości mocniej niż runiczny."]
	quest.0ADD9870AE35AD42.title: "Obelisk"
	quest.0ADF7585D757FA69.quest_desc: ["Rośnie na zewnętrznych wyspach. Zjedzony przenosi cię w losowe miejsce w pobliżu, a prażony daje purpur."]
	quest.0AE845ECD2F24083.quest_desc: ["Mikser hutniczy połączy stopione żelazo z koksem w stal, sztabka za sztabkę. Odlej ją na sztabki, pręty zbrojeniowe albo od razu ciężkie płyty."]
	quest.0AEAED1C255BB1BC.quest_desc: ["Spala paliwo stałe, a do tego bierze ciepło z lawy, która go otacza. Pierwsze własne źródło prądu Mekanismu."]
	quest.0AF67746EC42729B.quest_desc: [
		"&7Era elektryczności · zalecana netherytowa zbroja, mikstury leczenia i droga ucieczki&r"
		""
		"Warden jest ślepy, ale słyszy każdy krok i czuje zapach. Jego fala dźwięku przechodzi przez ściany i zbroję."
		"Prześladowca z Otherside poluje tak samo: po cichu i z ciemności."
	]
	quest.0AF67746EC42729B.title: "Mroczne głębiny"
	quest.0AFF48208CAFC601.quest_desc: ["Pierwszy kilof z kruszców Undergarden. Wykopiesz nim mroźną stal i utherium."]
	quest.0B22DCC034515189.quest_desc: ["Wymiarowa kopalnia wysyła ducha-górnika do innego wymiaru, skąd przynosi rudy. Włóż do niej ducha (&d{item.occultism.miner_foliot_unspecialized}&r)."]
	quest.0B3B93CE69511A97.quest_desc: ["Zdobądź dowolną część sprzętu walkirii ze skrzyń srebrnego lochu: zbroję, rękawice albo narzędzia."]
	quest.0B3B93CE69511A97.title: "Sprzęt walkirii"
	quest.0B49163061294D22.quest_desc: ["Pierwsze ulepszenie samo napełnia szufladę na płyny wodą. Drugie, złożone z niego i ulepszenia kapiącego, wytwarza obsydian."]
	quest.0B49163061294D22.title: "Generatory w szufladzie"
	quest.0B85FA71AE3AB7ED.quest_desc: ["Betoniarz robi cement i beton dla kolonii, więc budowniczowie nie czekają na twoje dostawy."]
	quest.0B87E412DBC8AF79.quest_desc: [
		"Era drużyny właściciela decyduje, co kolonia zbuduje. Zwykłe budynki rosną w erach techniki: do poziomu 2 w erze andezytu, 3 w erze mosiądzu, 4 w erze pary i stali, 5 w erze elektryczności."
		"Budynki magiczne rosną w erach magii: poziom 2 w erze run, 4 w erze okultyzmu, 5 w erze arkanów. Gdy czegoś brakuje, narzędzie budowy pokaże, której ery potrzebujesz."
	]
	quest.0B87E412DBC8AF79.title: "Kolonia i ery"
	quest.0B8C71D798A203BA.quest_desc: ["Rosną na pnączach w jaskiniach pod Lasem Zmierzchu i świecą w ciemności. Wypadają też z druidów-szkieletów."]
	quest.0B906638E5B9FCA1.quest_desc: [
		"Ars Elemental i Ars Technica rozwijają magię Ars Nouveau w erze arkanów. Kluczem do obu jest znak mistrzostwa z rozdziału tej ery, a do technomancji także skalibrowany mechanizm."
		""
		"&7Fokusy żywiołów i rytuały Ars Elemental znajdziesz w rozdziale ery.&r"
	]
	quest.0B906638E5B9FCA1.title: "Żywioły i technomancja"
	quest.0BF1CC17B83FCBA0.quest_desc: ["Opuszczona kopalnia z szybami i chodnikami głęboko w skale."]
	quest.0BF1CC17B83FCBA0.title: "Kompleks górniczy"
	quest.0C16CA01D15F7D39.quest_desc: [
		"&7Era okultyzmu · zalecana netherytowa zbroja, mikstury i mleko&r"
		""
		"Po przywołaniu Wither ładuje się i wybucha, a potem strzela czaszkami. Gdy straci połowę zdrowia, pancerz chroni go przed strzałami: dalej walcz wręcz."
		"&7Walcz pod ziemią albo daleko od bazy. Mleko zdejmuje obumieranie.&r"
	]
	quest.0C16CA01D15F7D39.title: "Jak pokonać Withera"
	quest.0C2EBF819E476084.quest_desc: ["Terralith zmienia sam krajobraz: suche zarośla, barwne źródła Yellowstone i rozległe wyżyny. Odwiedź wszystkie trzy."]
	quest.0C2EBF819E476084.title: "Terralith"
	quest.0C34682C23DDE3DE.quest_desc: ["Stawia całe ściany, podłogi i słupy z wybranego bloku, w wielu kształtach naraz. Działa na prąd: naładujesz go jak każde urządzenie FE."]
	quest.0C34682C23DDE3DE.quest_subtitle: "Kamień milowy"
	quest.0C34682C23DDE3DE.title: "&e{item.buildinggadgets2.gadget_building}"
	quest.0C41880C1863CD23.quest_desc: [
		"&7Ekwipunek: dobra zbroja i mikstury odporności na ogień.&r"
		"Obsydianowy monolit z Bosses of Mass Destruction. Czeka na swojej arenie na wyspach Endu."
	]
	quest.0C41880C1863CD23.quest_subtitle: "Boss"
	quest.0C41880C1863CD23.title: "&c{entity.bosses_of_mass_destruction.obsidilith}"
	quest.0C753F186A0B384A.quest_desc: ["Dodaje księdze zaklęć jedno miejsce, do limitu jej rodzaju. Zrobisz je ze skóry hoglina i tajemnej tkaniny."]
	quest.0C7F2633426D6354.quest_desc: [
		"Pusta kula z mitrylu, tajemnej sztabki i esencji żaru połączona z runą daje kulę ulepszeń. Na kowadle czarów nałożysz ją na część zbroi: doda moc szkoły, manę, krótsze odnawianie albo ochronę."
		""
		"&7Runę many zrobisz z pustego kamienia i tajemnej esencji.&r"
	]
	quest.0C7F2633426D6354.quest_subtitle: "Kamień milowy"
	quest.0C7F2633426D6354.title: "&dKula ulepszeń"
	quest.0C9F488BDD7472A7.quest_desc: ["Wypada z hoglinów w karmazynowych lasach Netheru. Z tej skóry oprawisz lepsze księgi zaklęć."]
	quest.0CA81074E41ACF8A.quest_desc: [
		"Rytuał ograniczenia zamyka pobliskie stworzenie w postawionym obok słoju. Słój z mobem przeniesiesz, a Drygmy zbierze z niego łupy."
		""
		"&7Kolejny tier Ars Nouveau pojawi się tutaj, gdy twoja drużyna wejdzie w erę mosiądzu.&r"
	]
	quest.0CA81074E41ACF8A.title: "Stworzenie w słoju"
	quest.0CB4CCCC9723F3A5.quest_desc: ["Płaszczyzna anihilacji zbiera do sieci bloki i przedmioty sprzed siebie, a formująca je stawia albo wyrzuca."]
	quest.0CB4CCCC9723F3A5.title: "Płaszczyzny"
	quest.0CC6A8F2D2EEF5CA.quest_desc: ["W lampie siedzi duch piekielnego rumaka. Kliknij nią blok, a rumak się pojawi."]
	quest.0CCA2E9F8F18DC90.quest_desc: ["Rozłącza napęd po ustawionej chwili, gdy sieć jest przeciążona. W przeciwieństwie do kołka ścinanego nie trzeba go potem wymieniać."]
	quest.0CCD2963566C0E61.quest_desc: ["Wypycha wybrane przedmioty z sieci do pojemnika albo maszyny przed sobą."]
	quest.0CCDF877683BE679.quest_desc: ["Leży w ukrytym skarbcu labiryntu. Kruszy kamień labiryntu, którego zwykły kilof prawie nie rusza."]
	quest.0CD23AB5628B3F37.quest_desc: ["Redstone i Tabula Rasa w kręgu. Sigil pokazuje esencję w twojej animie, a wycelowany w ołtarz także w nim."]
	quest.0CDD997DDBA209EE.quest_desc: ["Stróżówka mieści dwóch strażników i pozwala połączyć twoją kolonię z innymi koloniami."]
	quest.0CEC8654540CE3AB.quest_desc: [
		"&7Ekwipunek: zbroja z netherytu, mikstury leczenia i droga ucieczki.&r"
		"Ślepy strażnik starożytnych miast poluje na dźwięk. Przychodzi, gdy wyjce sculku usłyszą cię kilka razy."
	]
	quest.0CEC8654540CE3AB.quest_subtitle: "Boss"
	quest.0CEC8654540CE3AB.title: "&c{entity.minecraft.warden}"
	quest.0CFB231E4EDE8435.quest_desc: ["Rytuał przywołania foliota z zadaniem daje księgę wezwania: sprzątacz zbiera upuszczone przedmioty do skrzyni, przewoźnik przenosi je między pojemnikami, a drwal i rolnik ścinają drzewa i zbierają plony. Księgą wskazujesz mu miejsce pracy."]
	quest.0CFB231E4EDE8435.title: "Foliot do pracy"
	quest.0D02A80409E99AA6.quest_desc: ["Zaklej nią skrzynię, a po rozbiciu zachowa całą zawartość. Tak przeniesiesz pełny magazyn w inne miejsce."]
	quest.0D16835F39CF3524.quest_desc: [
		"Płomienny palnik przyjmie też paliwo podane rurą. Prasa wyciska olej z nasion, a mikser robi bioetanol z cukru, rozżarzonej mąki i biomasy; spalą się też olej napędowy i benzyna."
		""
		"&7Spalanie płynnego paliwa pokazuje Ponder (W) na palniku.&r"
	]
	quest.0D16835F39CF3524.title: "Płynne paliwo"
	quest.0D1BD2927DCF013C.quest_desc: [
		"Stawia więcej bloków naraz i dłużej wytrzymuje. Zrobisz ją z patyka i sztabki miedzi."
		""
		"&7Kolejny tier różdżek pojawi się tutaj, gdy twoja drużyna wejdzie w erę andezytu.&r"
	]
	quest.0D30671E03A6EAC6.quest_desc: ["Lawendowe pola, klonowe lasy i olbrzymie sekwoje. Odwiedź wszystkie trzy."]
	quest.0D30671E03A6EAC6.title: "Biomes O' Plenty"
	quest.0D3104FB78E7C018.quest_desc: ["Stapia klejnoty tak, jak kuźnia stopów metale, np. diament ze szmaragdem. Klejnot mieszany łączy cechy obu."]
	quest.0D7583BE0EA11CB2.quest_desc: ["Na koniec badanie zamykasz tajemną pieczęcią. Zrobisz ją z wosku maga, który uwarzysz w tyglu z łoju, kalksu Endu, redstone i czerwonego barwnika."]
	quest.0D90343C52E65B5F.quest_desc: ["Starbuncle żyją w lasach i lubią złote bryłki: podejdź z bryłką w ręce, a zostawi ci żeton. Z żetonu i złota aparat zrobi amulet, który przywoła pomocnika do noszenia przedmiotów."]
	quest.0D99AD3F3341985E.quest_desc: ["W erze mosiądzu kolonia dostaje koszary, szkołę łuczniczą i szkołę walki. Zbierz ośmiu strażników, zanim najazdy urosną."]
	quest.0D99AD3F3341985E.title: "Ośmiu strażników"
	quest.0DA410A9FE4FF0E1.quest_desc: [
		"Huta na poziomie 3 przetapia bloki rud tak, jakby wykopano je z Fortuną II. To najwyższy poziom w tej erze."
		""
		"&7Kolejny tier budynków pojawi się tutaj, gdy twoja drużyna wejdzie w erę okultyzmu.&r"
	]
	quest.0DA410A9FE4FF0E1.quest_subtitle: "Kamień milowy"
	quest.0DA410A9FE4FF0E1.title: "&3Huta na poziomie 3"
	quest.0DB15DB0FB1E6197.quest_desc: ["Łańcuch rozpięty między kołami zębatymi wiezie paczki nad całą bazą. Łańcuchy połączysz, klikając jednym kołem drugie."]
	quest.0DBCD009F6C11515.quest_desc: ["Wystarczy jeden z dwóch magicznych bossów. Jego trofeum to drugi boss potrzebny do pieczęci."]
	quest.0DBCD009F6C11515.quest_subtitle: "Kamień milowy"
	quest.0DBCD009F6C11515.title: "&cChimera lub Umarły Król"
	quest.0DC3DC6E4DE0278D.quest_desc: ["Zdejmuje efekty z celu i odsyła przywołane stwory. Rzucony na wiedźmę bliską śmierci da żeton Wixie."]
	quest.0E13C0020046B09C.quest_desc: ["Na piedestałach wokół aparatu zaklinającego kładziesz składniki przepisu. Zrób ich kilka, bo większe przepisy zajmują ich nawet osiem."]
	quest.0E15935A7DF78162.quest_desc: [
		"Ruiny wielkiej areny. Wejdź, gdy masz dobrą zbroję."
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę okultyzmu.&r"
	]
	quest.0E15935A7DF78162.title: "Koloseum"
	quest.0E27D5D4B543A78F.quest_desc: [
		"Rama, porty i szkło reaktorowe otaczają kontroler. Przez matrycę skupienia w ścianie wejdzie wiązka lasera, która zapali reakcję."
		""
		"&7Kształt reaktora pokaże JEI i podgląd struktury Mekanismu.&r"
	]
	quest.0E27D5D4B543A78F.title: "Rama reaktora syntezy"
	quest.0E2A921B22008D0B.quest_desc: ["Poradnik opisuje części, materiały i ich cechy. Zajrzyj do niego, zanim zdecydujesz, z czego zrobić narzędzie."]
	quest.0E3948737B64A96F.quest_desc: ["Pradawna klątwa: im więcej many w nią włożysz, tym mocniej rani. Przy okazji zdejmuje z ciebie złe efekty."]
	quest.0E404089795B48E8.quest_desc: ["Daje sygnał o dowolnej sile od 0 do 15. Przy regulowanym przekładniku łańcuchowym działa jak pedał gazu."]
	quest.0E4AA36A37CE3C35.quest_desc: ["Uwięziona w nim dusza wskazuje drogę do najbliższych katakumb. Zrobisz go z tajemnej esencji, sztabki żelaza i latarni dusz."]
	quest.0E5E68B17057E04A.quest_desc: ["Amulet zwiększa zapas many albo przyspiesza jej odnawianie. Bazą jest matowa błyskotka z żelaza i klejnotu źródła."]
	quest.0E5E68B17057E04A.title: "Amulet many"
	quest.0E60FAA1F3557AF5.quest_desc: [
		"Postaw go na przyzywaczu potworów: wtedy ściąga z niego magię i nasyca przedmioty położone na wierzchu. Szmaragd stanie się w nim przebudzonym szmaragdem, kamień cienistym kamieniem, a żelazo przeklętym metalem."
		""
		"&7Przepisy nasycania pokaże JEI (U na nasycaczu).&r"
	]
	quest.0E7971A293912780.quest_desc: ["Kwiaciarz hoduje kwiaty na kompoście dla dekoracji i przepisów kolonii."]
	quest.0E7971A293912780.title: "Kwiaciarnia"
	quest.0E8427AD41F130CD.quest_desc: ["Podpina do kontrolera skrzynie, które go nie dotykają. Połączysz je narzędziem magazynowym."]
	quest.0E9E80A3F1EBFC45.quest_desc: ["Piramida na pustyni, a pod nią grobowiec Starożytnej Pozostałości. Pilnują jej kościane koboldy."]
	quest.0E9E80A3F1EBFC45.title: "Przeklęta piramida"
	quest.0EB1780FEE5B7D51.quest_desc: [
		"Szuflada trzyma wiele stosów jednego przedmiotu i pokazuje go na froncie. Prawym kliknięciem wkładasz, lewym wyjmujesz, bez otwierania okna."
		""
		"&7Podwójne prawe kliknięcie włoży do szuflady wszystkie pasujące przedmioty z ekwipunku.&r"
	]
	quest.0EB1780FEE5B7D51.title: "Szuflada"
	quest.0EBBD86E5F5201B1.quest_desc: ["Stół przemian czerpie esencję z twojej animy przez kulę w prawym gnieździe. Robi odczynniki, narzędzia do kręgów, oleje i noże do rzucania; wymagany poziom kuli pokaże JEI."]
	quest.0EC3DB7D48237142.quest_desc: ["Era run otwiera magiczne budynki kolonii, na razie do poziomu 2. W bibliotece mieszkańcy studiują i podnoszą swoje umiejętności."]
	quest.0EC3DB7D48237142.title: "Biblioteka"
	quest.0EFA83C85873D316.quest_desc: ["Pierwsze sztabki obu metali. Z nich powstaną lepsze narzędzia, pierwsze maszyny i pieczęć."]
	quest.0EFA83C85873D316.quest_subtitle: "Kamień milowy"
	quest.0EFA83C85873D316.title: "&6Miedź i żelazo"
	quest.0EFFCA13B9A4552B.quest_desc: ["Grom z fokusu porażenia, bloku redstone i diamentu. Szkoła burzy prowadzi aż do przyzywania błyskawic i burz."]
	quest.0F147D3C670434BE.quest_desc: ["Babeczka z esencją Fae. Fae brzydzą się tym, kto ją zjadł, i omijają go nawet przy magii na punkcie mocy."]
	quest.0F3008D30DAE11A8.quest_desc: ["Z cierniem próżni. Przenosi cię na krótki dystans przez lite bloki."]
	quest.0F346A4EECEE8263.quest_desc: [
		"Jednorazowy zwój: otwiera listę znanych ci kamieni i przenosi cię do wybranego bez kosztu doświadczenia."
		""
		"&7Zrobisz go z papieru, atramentu, złotego samorodka i perły z endermana.&r"
	]
	quest.0F6354C74514EA4F.quest_desc: ["Skok od razu z podstawowej skrzyni do diamentowej. Wygodne, gdy rozbudowujesz cały magazyn naraz."]
	quest.0F70AC236CC3ECBB.quest_desc: ["Netherytowy kapelusz maga ulepszony rogiem Netherytowego monstrum. Mocny hełm dla maga walczącego wręcz."]
	quest.0F8B896403C3E624.quest_desc: ["Piracki statek, na którym załoga nie żyje od dawna. Ładownia wciąż pełna łupów."]
	quest.0F8B896403C3E624.title: "Statek nieumarłych piratów"
	quest.0FACB23C0ACAE7EA.quest_desc: ["Gazociąg przesyła gazy i inne chemikalia między maszynami, a rura mechaniczna – płyny. Od nich zależy każda linia przerobu ×3 i wyższego."]
	quest.0FACB23C0ACAE7EA.title: "Gazociągi i rury"
	quest.0FADD40FA93C74DC.quest_desc: ["Każde gniazdo mieści więcej niż zwykły stos. Pierwszy poziom zrobisz z modułu i kłód."]
	quest.0FAE2EAECC2ABDE3.quest_desc: ["Kliknij wciągarkę i łącznik linowy sprzęgłem linowym, a połączysz je liną. Napędzana wciągarka zwija i rozwija linę – tak podniesiesz ładunek pod statkiem albo przyholujesz drugą maszynę."]
	quest.0FAE2EAECC2ABDE3.title: "Liny i wciągarki"
	quest.0FBFA1911DFABEE5.quest_desc: [
		"Cewka generatora tylko wytwarza prąd. Szczotki węglowe przy cewkach go zbierają i oddają do przewodów, z najwyżej ośmiu cewek naraz."
		""
		"&7Układ cewek, magnesów i szczotek pokazuje Ponder (W).&r"
	]
	quest.0FCFB4BFCDC40A72.quest_desc: ["Maluje kable, obramowania i złącza na wygląd wybranego bloku, żeby magazyn wtopił się w ściany."]
	quest.0FDD5DB849F58A40.quest_desc: ["Rozkwit sieje kwiaty, zalesienie sadzi drzewa, a przerost nawozi wszystko wokół. Przydadzą się do farm i budowy."]
	quest.0FDD5DB849F58A40.title: "Rytuał natury"
	quest.0FF473892D3EC29F.quest_desc: ["Kliknij nim blok, a przeszuka mały obszar za nim w poszukiwaniu rud. Działa też jak kilof i jak młotek w recepturach."]
	quest.0FF5C90662F26F97.quest_desc: ["Pełny komplet chroni przed ogniem i podpala tych, którzy cię uderzą. Każda część to ogniste sztabki."]
	quest.0FF5C90662F26F97.title: "Ognista zbroja"
	quest.0FFE585782E962BE.quest_desc: ["Różdżka wróżbiarska wskazuje najbliższy blok, do którego ją dostroisz, np. rudę z innego świata. Zrobisz ją ze złota, szkła i dostrojonego klejnotu."]
	quest.1034402517DAC224.quest_desc: ["Miernik pilnuje zapasu jednego przedmiotu: gdy go brakuje, sam zamawia składniki z sieci logistycznej. Połączone mierniki prowadzą całą fabrykę."]
	quest.103A2997B453759E.quest_desc: [
		"Trzeci poziom stosów. Przepis wymaga bloku złota i ulepszenia drugiego poziomu."
		""
		"&7Kolejny tier skrzyń pojawi się tutaj, gdy twoja drużyna wejdzie w erę pary i stali.&r"
	]
	quest.105089649D8E3755.quest_desc: ["Kamienny grobowiec Explorify. Zajrzyj do środka, jeśli się odważysz."]
	quest.105089649D8E3755.title: "Mauzoleum"
	quest.106859CA3013FCFA.quest_desc: ["Duże dania, np. pieczonego kurczaka, stawiasz jak blok. Porcje nakładasz miską, więc jedno danie wykarmi całą drużynę."]
	quest.106859CA3013FCFA.title: "Uczta"
	quest.1069724C40E8D4C4.quest_desc: ["Smocza księga ze skóry smoka Endu, zniszczonej księgi i obsydianu. Jedna z najpojemniejszych ksiąg Iron's Spells."]
	quest.10824C64396CD357.quest_desc: ["Leży w skarbcu jednej z jaskiń trolli. Wypala ciernie, które zagradzają drogę dalej."]
	quest.10941E05500FD05D.quest_desc: [
		"Rycerze trenują tu bez ryzyka śmierci, zanim staną do prawdziwej walki."
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę atomu.&r"
	]
	quest.10941E05500FD05D.title: "Szkoła walki"
	quest.10E5B8A66A4EC7FF.quest_desc: ["Obsydian z tabliczką Robur. Każdy rytuał ma dokładnie jeden kamień główny w środku i wzór zwykłych kamieni wokół."]
	quest.10E5B8A66A4EC7FF.title: "Kamienie rytualne"
	quest.10EC3239A04E4C3F.quest_desc: ["Postaw narzędziem budowy chatę budowniczego, zatrudnij budowniczego i zleć mu budowę jego własnej chaty."]
	quest.10EC3239A04E4C3F.title: "Pierwsze zlecenie"
	quest.111C5BCA62F9C8DE.quest_desc: ["Owoc Tau rośnie w Królestwie demonów. Wyhodowany do pełna to surowiec na słabe odłamki krwi."]
	quest.1126469E0A49ADCD.quest_desc: ["Krąg Konsolidacji Mocy tworzy jezioro. Wrzuć do pełnego jeziora zaklęty miecz, a wróci jako święty miecz: im lepsze zaklęcia, tym mocniejszy, a nieumarli uciekają przed nim."]
	quest.1126469E0A49ADCD.quest_subtitle: "Kamień milowy"
	quest.1126469E0A49ADCD.title: "&d{item.mahoutsukai.caliburn}"
	quest.11281FFDBA69F1AE.quest_desc: ["Ponury szpital w ruinie, z którego nikt nie wyszedł zdrowy. Weź mleko i jedzenie na zapas."]
	quest.11281FFDBA69F1AE.title: "Zakład zadżumionych"
	quest.1131C5BC3F7AFFC2.quest_desc: ["Najmocniejszy plecak w paczce: najwięcej miejsca i gniazd na ulepszenia. Nie spłonie w lawie."]
	quest.1131C5BC3F7AFFC2.quest_subtitle: "Kamień milowy"
	quest.1131C5BC3F7AFFC2.title: "&b{item.sophisticatedbackpacks.netherite_backpack}"
	quest.113A4F48621EAD7A.quest_desc: ["Kliknij tor przy stacji kolejową obudową, a powstanie wózek. Zbuduj na nim pociąg z kontrolerem i złóż go w menu stacji."]
	quest.113A4F48621EAD7A.title: "Pierwszy pociąg"
	quest.113F367C40825ACE.quest_desc: ["Skrzynie i beczki to na razie cały twój magazyn. Lepsze przyjdą w erze andezytu."]
	quest.1143AC2BB6DB4C59.quest_desc: ["Zwykły las, gęstwina, las świetlików i las grzybów są otwarte od początku. Odwiedź wszystkie cztery."]
	quest.1143AC2BB6DB4C59.title: "Krainy lasu"
	quest.1143EE893CA328E4.quest_desc: ["Zaklina bez wymagań poziomu i dokłada zaklęcia także do zaczarowanych już przedmiotów. Za każdym razem dodaje tylko jeden poziom, więc mocne zaklęcie wymaga wielu podejść."]
	quest.114616CC6A0B470F.quest_desc: [
		"Ur-Ghast unosi się wysoko nad areną mrocznej wieży. Pokonaj ghastlingi wokół pułapki i włącz ją, a ściągnie go na dół."
		"&7Pułapki stoją w komnacie bossa na szczycie wieży.&r"
	]
	quest.114616CC6A0B470F.title: "Pułapka na ghasta"
	quest.1158FDB4929D5DCD.quest_desc: ["Najmocniejsza z różdżek budowlanych. Ulepsz diamentową na stole kowalskim szablonem ulepszenia netherytowego i sztabką netherytu."]
	quest.1158FDB4929D5DCD.quest_subtitle: "Kamień milowy"
	quest.1158FDB4929D5DCD.title: "&e{item.wands.netherite_wand}"
	quest.11631356DA4AF263.quest_desc: ["Kamień nasycony w przeklętym nasycaczu. Z niego zrobisz piedestały: rytuał bierze składniki z piedestałów w promieniu 8 bloków od mrocznego ołtarza."]
	quest.11631356DA4AF263.title: "Cienisty kamień i piedestały"
	quest.116414E1FDCFB1BB.quest_desc: ["Mąka z wodą daje &6{item.create.dough}&r. Przepuść ciasto przez strumień wiatraka dmuchającego przez ogień, a upiecze się w chleb. Zadanie zalicza osiągnięcie Create za przetwarzanie wiatrakiem."]
	quest.116414E1FDCFB1BB.title: "Piekarnia na wietrze"
	quest.11844103153559F1.quest_desc: ["Rytuał na czwartym poziomie kuźni z boskim paktem jako ulepszaczem: trzy rodzaje dusz, ametyst i odłamki perły Endu na kwarcu. Modyfikator duszy sprawia, że przedmiot zostaje z tobą po śmierci."]
	quest.1189812BC365E23E.quest_desc: [
		"Drugi poziom stosów. Przepis wymaga bloku żelaza i ulepszenia poprzedniego poziomu."
		""
		"&7Kolejny tier skrzyń pojawi się tutaj, gdy twoja drużyna wejdzie w erę mosiądzu.&r"
	]
	quest.118C67708613B190.quest_desc: ["Zdobądź dowolną część zbroi feniksa. Chroni przed ogniem i lawą, a w wodzie stygnie w obsydianową."]
	quest.118C67708613B190.title: "Zbroja feniksa"
	quest.118D9575214E769E.quest_desc: ["Właz w ścianie wielkiego pieca wpuszcza gorące powietrze z nagrzewnicy. Drugi właz na szczycie zbiera gaz piecowy, a wysłane do niego przedmioty spadają do pieca."]
	quest.11E06B20EEA05823.quest_desc: ["Obozowisko tajemniczych mieszkańców Undergarden. W ich skrzyniach leżą maski."]
	quest.11E06B20EEA05823.title: "Obóz mieszkańców głębi"
	quest.11F5FF463FFB7DA8.quest_desc: ["Różowe gaje sakury, jesienna dolina pełna dyń i mroczny las czarownic. Odwiedź wszystkie trzy."]
	quest.11F5FF463FFB7DA8.title: "Oh The Biomes We've Gone"
	quest.11FC9196F27DE3E1.quest_desc: ["Gogle pokazują prędkość i obciążenie maszyn, na które patrzysz. Od razu widać, czy napęd wystarcza dla całej linii."]
	quest.11FCE4A0C294CB8D.quest_desc: [
		"Dwa koła ustawione obok siebie i kręcące się do środka miażdżą wszystko, co wpadnie między nie. Zrobisz je na mechanicznych stołach rzemieślniczych."
		""
		"&7Ponder (przytrzymaj W nad przedmiotem) pokaże, jak to ustawić.&r"
	]
	quest.11FCE4A0C294CB8D.quest_subtitle: "Kamień milowy"
	quest.11FCE4A0C294CB8D.title: "&6Koła kruszące"
	quest.12036D0DFF9246D3.quest_desc: ["Leśne dwory stoją w gęstych, ciemnych lasach. W tej paczce mieszka w nich &a{entity.illagerinvasion.invoker}&r, boss illagerów."]
	quest.12036D0DFF9246D3.title: "Leśny dwór"
	quest.120F885EFF140229.quest_desc: ["Prasa nad tyglem wyciska z nasion olej roślinny. Zmieszaj go z etanolem, a dostaniesz biodiesel: paliwo do silników bez kropli ropy."]
	quest.120F885EFF140229.title: "Biodiesel"
	quest.122241210B4A87F5.quest_desc: ["Ulepsz diamentowy kilof sztabką netherytu i szablonem z bastionu na stole kowalskim. Dopiero kilof tego poziomu wykopie rudę mithrilu z Iron's Spellbooks."]
	quest.12272A2C2D55DB5C.quest_desc: ["Podmienia bloki w zaznaczonym obszarze na inne, bez kopania. Gotowy dom przerobisz z kamienia na cegłę w kilka kliknięć."]
	quest.122DBFDFFA3403D2.quest_desc: ["Wielka budowla Dungeons Arise wysoko nad wyspami Endu. Jeden z trudniejszych lochów."]
	quest.122DBFDFFA3403D2.title: "Ptaszarnia"
	quest.1240660E819543A1.quest_desc: ["Zaczaruj przedmiot na poziomie 100. Taki stół daje zaklęcia, o jakich zwykły zaklinacz może tylko marzyć."]
	quest.1240660E819543A1.quest_subtitle: "Kamień milowy"
	quest.1240660E819543A1.title: "&dZaklinanie na poziomie 100"
	quest.124468F09928C2D4.quest_desc: ["Śruby wytniesz ze sztabki stali na przecinarce. Śrubokręt jest narzędziem w montażu generatora i silnika elektrycznego, a w świecie blokuje rury w miejscu."]
	quest.124468F09928C2D4.title: "Śruby i śrubokręt"
	quest.12582E66D27D5321.quest_desc: ["Koncentrat uranu utlenij, połącz z kwasem fluorowodorowym w infuzerze chemicznym, a wirówka zrobi z tego paliwo rozszczepialne."]
	quest.126F5D77D0B9C052.quest_desc: ["Zostawia je &c{entity.goety.ender_keeper}&r. Rytuały Goety robią z niego najsilniejsze fokusy Endu."]
	quest.12823F43BC8A1A70.quest_desc: ["Płomyki upuszczają różdżki. Jedna pójdzie do pieczęci, kolejne do statywu alchemicznego, księgi ucznia Ars i runy ognia."]
	quest.12823F43BC8A1A70.quest_subtitle: "Składnik pieczęci"
	quest.12839D5DA4C084BB.quest_desc: ["Trzy piedestały: na źródłowym kładziesz siarkę do przerobienia, na docelowym wzorzec, a na wynikowym pojawi się nowa siarka."]
	quest.12839D5DA4C084BB.title: "Szyk reformacji"
	quest.12880F0726E1EBA0.quest_desc: [
		"Zaawansowane wersje mają więcej miejsc na filtr i większy zasięg magnesu. Do przepisu potrzebujesz diamentów i złota."
		""
		"&7Kolejny tier plecaków pojawi się tutaj, gdy twoja drużyna wejdzie w erę pary i stali.&r"
	]
	quest.12880F0726E1EBA0.title: "Zaawansowane podnoszenie"
	quest.128DAD53D949C476.quest_desc: ["Pióro schematów zapisuje zaznaczoną budowlę do pliku, a stół do planowania przenosi plik na pusty schemat. Postawi go schematoarmata, gdy ją zdobędziesz."]
	quest.128DAD53D949C476.title: "Schematy"
	quest.12AD8DE5221F315E.quest_desc: ["Rudę cynku wykopiesz żelaznym kilofem. Bryłki cynku zastąpią żelazo w stopie andezytu, a w erze mosiądzu cynk połączysz z miedzią."]
	quest.12C9DE9623188A7F.quest_desc: ["Komórka na płyny. Sieć ME przechowa w niej wodę, lawę i paliwa obok przedmiotów."]
	quest.12FC7512556643A9.quest_desc: ["Tygiel skupia duchy na przedmiocie zwanym impetem, który zużywa się z każdym użyciem i daje nowe rzeczy, np. węzły rud albo płonący kwarc."]
	quest.12FC7512556643A9.quest_subtitle: "Kamień milowy"
	quest.12FC7512556643A9.title: "&d{block.malum.spirit_crucible}"
	quest.1308134184C91F76.quest_desc: ["Slider zostawia klucz do skrzyni skarbów swojego lochu. W środku czeka młot Kingbdogza, lanca walkirii albo buty strażnika."]
	quest.130E6F658F659203.quest_desc: [
		"Ta strona prowadzi przez krainy Lasu Zmierzchu, jego surowce i mapy. Bossowie są w drzewach er, a każdy pokonany otwiera kolejne krainy."
		""
		"&7Zamknięte krainy szkodzą każdemu, kto do nich wejdzie: głodem, mrozem, ogniem albo ślepotą.&r"
	]
	quest.130E6F658F659203.title: "W Lesie Zmierzchu"
	quest.1314CF959B0CFD5B.quest_desc: [
		"&7Era mosiądzu · zalecana diamentowa zbroja i mikstury ognioodporności&r"
		""
		"Pod bagnem leży labirynt, a w jego sercu Minoszrum. Gulasz, który po nim zostanie, przyzwyczai cię do żaru ognistego bagna, gdzie w swoim leżu czeka Hydra."
		"Hydra ma kilka głów i pluje ogniem z daleka. Bij głowy, gdy opadną na ziemię."
	]
	quest.1314CF959B0CFD5B.title: "Labirynt i ogniste bagno"
	quest.135966E6DE04F1B3.quest_desc: ["Kadź z mieszalnikiem zrobi płynny beton z piasku, żwiru, piasku wapiennego i wody. Wlej go w bloki zbrojeniowe z prętów, a zastygnie w żelbet."]
	quest.135966E6DE04F1B3.title: "Żelbet"
	quest.1359AE6CB7834A64.quest_desc: ["Szuflada wysyła sygnał redstone zależny od zapełnienia. Wyłączysz nim maszynę, gdy zapas jest pełny."]
	quest.1360D983BCA997AD.quest_desc: ["Golem gwiazd zawsze zostawia miecz energii, a do tego utleniony piec stopowy."]
	quest.136177C72A318563.quest_desc: ["Ten foliot wymienia zwykły kamień na kamień z innego świata. Tani materiał na budowle okultysty."]
	quest.136177C72A318563.title: "Kupiec kamienia"
	quest.13701853E6C4AC8D.quest_desc: ["Kilof, siekiera, łopata i broń w jednym, zasilane prądem. Moduły dodają mu szybkości i zasięgu."]
	quest.1392C9FC6F4EE4C4.quest_desc: ["Resztki portalu po tej stronie. W skrzyni obok bywa złoto."]
	quest.1392C9FC6F4EE4C4.title: "Zrujnowany portal w Netherze"
	quest.13A3B1CE60BFFB7F.quest_desc: ["Afrit przetapia wrzucone mu przedmioty jak piec, tylko szybciej i bez paliwa."]
	quest.13A3B1CE60BFFB7F.title: "Afrit wytapiający"
	quest.13CAE7E894DBEA2C.quest_desc: [
		"Kliknij nim terminal z wciśniętym Shift, a otworzysz go z daleka własnym klawiszem. Pobliska magiczna latarnia zwiększy jego zasięg, aż do innych wymiarów."
		""
		"&7Ulepszysz zwykły bezprzewodowy terminal na stole kowalskim sztabką netherytu.&r"
	]
	quest.13D01E9076667682.quest_desc: ["Na piedestałach z ciemnego kamienia wokół kuźni kładziesz składniki rytuału. Miejsca na nie pokazuje Ponder (W)."]
	quest.13D46E7A09D48D09.quest_desc: ["Skórzana zbroja z tajemną esencją. Lekki i tani strój na pierwsze wyprawy z księgą."]
	quest.13D46E7A09D48D09.title: "Strój wędrownego maga"
	quest.13DA3E0A1B71DE03.quest_desc: ["Shulkery czają się w miastach Endu. Z dwóch skorup i skrzyni zrobisz przenośną skrzynię."]
	quest.13E1023B98EED92C.quest_desc: ["Ramowy blok przyjmie wygląd każdego bloku, którym go klikniesz: schody z kwarcu albo płyta z liści. Młotkiem ramowym zdejmiesz okładzinę z powrotem."]
	quest.13E1023B98EED92C.title: "Bloki ramowe"
	quest.13E60D549E3A08F9.quest_desc: ["Pył Mundabitur łączy tajemny pył z redstone, prochem, płomiennym proszkiem, mączką kostną i błoną fantoma. Posypany na odpowiednią konstrukcję przemienia ją: tak powstają kuźnia Hefajstosa i obelisk."]
	quest.13EDB8A28E326BE1.quest_desc: ["Gogle z soczewek nasyconych w rytuale pokazują bloki z innego świata bez jedzenia owocu (&d{item.occultism.datura}&r)."]
	quest.140A2E973FDDCE24.quest_desc: [
		"Czwarty poziom stosów. Przepis wymaga bloku diamentu."
		""
		"&7Kolejny tier skrzyń pojawi się tutaj, gdy twoja drużyna wejdzie w erę arkanów.&r"
	]
	quest.140C6E789E790C5E.quest_desc: [
		"Peleryna sprawia, że strzały twoich szkieletów omijają sojuszników, a twoje zombie przeciągają dzikie zombie na twoją stronę. Korona chroni sługi przed rozpadem i skraca rzucanie o połowę."
		""
		"&cKorona noszona w dzień osłabia.&r"
	]
	quest.140C6E789E790C5E.title: "Strój nekromanty"
	quest.14221090700CFA35.quest_desc: ["Dodatkowy punkt dostępu do magazynu w innym miejscu bazy. Kliknij nim aktywator przed postawieniem, a otworzysz przez niego ten sam magazyn."]
	quest.142A7534DE345F3C.quest_desc: ["Zbierz go pustą butelką z kłębów, które zostawia smok. Z nim uwarzysz mikstury zalegające na ziemi."]
	quest.1435697270482493.quest_desc: ["Zanim postawisz mechaniczne ramię, zaznacz nim co najmniej dziesięć miejsc odbioru. Jedno ramię obsłuży wtedy cały rząd maszyn."]
	quest.1435697270482493.title: "Ramię na dziesięć rąk"
	quest.143F5440F86462B6.quest_desc: ["Fokus przywołań wzmacnia przywołane stwory, a fokus kształtowania pozwala przesuwać bloki zaklęciami. Nosisz go w gnieździe fokusu."]
	quest.143F5440F86462B6.title: "Fokus zaklinacza"
	quest.14408C81D0D92F13.quest_desc: [
		"Jaja moa znajdziesz w srebrnych lochach. Wyklujesz je w inkubatorze opalanym pochodnią z ambrozjum."
		""
		"&7Dorosły moa to wierzchowiec, który skacze kilka razy w powietrzu i powoli opada.&r"
	]
	quest.14408C81D0D92F13.quest_subtitle: "Kamień milowy"
	quest.14408C81D0D92F13.title: "&aWłasny moa"
	quest.14485AF7CFFDC3D2.quest_desc: ["Hełm i napierśnik zostają po fantomowych rycerzach, ale nie po każdej walce. Mają zaklęcia, których nie da się nałożyć zwykłą drogą."]
	quest.14485AF7CFFDC3D2.title: "Zbroja fantomów"
	quest.145C259EF1E9E9DA.quest_desc: ["Przenosi cię do własnego świata, a jeśli patrzysz na wroga, zabiera go ze sobą."]
	quest.146F3AF7E206039C.quest_desc: [
		"Po walce na arenie pojawia się skrzynia, a w niej oko rękawicy. To materiał na stół wzniesienia i wzmacniacz wybuchów."
		""
		"&7Kolejny tier bossów zagłady pojawi się tutaj, gdy twoja drużyna wejdzie w erę atomu.&r"
	]
	quest.147282D671C2D01F.quest_desc: ["Resztki laboratorium w uschniętym lesie. Ktoś tu kiedyś warzył coś bardzo groźnego."]
	quest.147282D671C2D01F.title: "Zrujnowane laboratorium"
	quest.147C96D50B472C44.quest_desc: ["Zamek z purpuru postawiony przez Dungeons and Taverns. Szykuj się na shulkery."]
	quest.147C96D50B472C44.title: "Zamek Endu"
	quest.14B1D245A31476FC.quest_desc: ["Stacjonarna armata na ziemniaki strzela tą samą amunicją co ręczna. Na pokładzie odstraszy fantomy."]
	quest.14DC02AE20A7EAA2.quest_desc: ["Magazyn energii, który rośnie jak zbiornik płynów: stawiaj bloki obok siebie, a połączą się w jeden. Wyrówna różnicę między dniem i nocą, gdy generatory stają."]
	quest.14F513B8AA7F697B.quest_desc: ["Rozbudowana świątynia faraonów: długie korytarze, pułapki i komnata skarbów. W środku działa zmęczenie, więc kopanie idzie wolno."]
	quest.14F513B8AA7F697B.quest_subtitle: "Kamień milowy"
	quest.14F513B8AA7F697B.title: "Świątynia pustynna"
	quest.14F6F6F85A662A17.quest_desc: ["Odłamek duszy, redstone, lazuryt i kwarc uwarzone w tyglu. Mniejszy klejnot duszy zasila różdżki i talizmany."]
	quest.14FDE6CE1CB0DA47.quest_desc: ["Sfermentuj na przykład siarkę żelaza. Saletra pospolitych metali to punkt wyjścia do uszlachetniania."]
	quest.14FDE6CE1CB0DA47.title: "Saletra pospolitych metali"
	quest.1507AA210FFA27CD.quest_desc: ["Trzy grafitowe elektrody nad kadzią z dziewięciu ognioodpornych segmentów (3×3) tworzą piec łukowy. Topi kruszoną rudę żelaza z topnikiem i pyłem koksowym w stal, bez wielkiego pieca."]
	quest.1507AA210FFA27CD.title: "Piec łukowy"
	quest.150D09B312AC34D8.quest_desc: ["Żniwiarka na ruchomej maszynie zbiera dojrzałe plony i zostawia sadzonki w ziemi. Z pługiem i łożyskiem zrobisz samobieżną farmę."]
	quest.153601AC543F67BC.quest_desc: ["Złoto z proszkiem płomienia, połączone w siatce. Trafi do sortownika materiałów i ładowarki gwiezdnej."]
	quest.1578CCAF82A446EC.quest_desc: ["Ulepszacz ze skrzyń świątyń w dżungli i na pustyni oraz z ruin pod wodą. Położony na kuźni pozwala na rytuały żywiołów: tylko z nim powstają pryzmaty."]
	quest.158F6B7EC8782A2C.quest_desc: ["Ciemny kamień wykopiesz pod ziemią i wypolerujesz w siatce rzemiosła. Podstawa kuźni Hefajstosa to 45 bloków polerowanego ciemnego kamienia, do tego bloki rzeźbione i złocone."]
	quest.158F6B7EC8782A2C.title: "Ciemny kamień"
	quest.158F9510B87B17F8.quest_desc: ["Żelazna zbroja nasycona płytami stali dusz i skręconą skałą. Daje osłonę duszy, która przyjmuje część obrażeń i sama się odnawia."]
	quest.158F9510B87B17F8.title: "Zbroja ze stali dusz"
	quest.15A7A9BF29AE4352.quest_desc: ["Poprowadź tor przez portal Netheru i przejedź nim pociągiem. Jeden blok w Netherze to osiem bloków w świecie zwykłym, więc to najkrótsza droga na drugi koniec mapy."]
	quest.15A7A9BF29AE4352.title: "Pociąg do Netheru"
	quest.15AF1C92938E0B2F.quest_desc: ["Ruiny domów zapomnianych budowniczych. W ich garnkach trafiają się nasiona, fasolki i kryształy."]
	quest.15AF1C92938E0B2F.title: "Zapomniane ruiny"
	quest.15AF54CC1E262A56.quest_desc: ["Daj się wyrzucić wyrzutni odważnikowej na ponad 30 bloków. Lądowanie zaplanuj zawczasu."]
	quest.15AF54CC1E262A56.title: "Lot z wyrzutni"
	quest.15D604CF280ECB60.quest_desc: ["Kosa albo topór ze stali dusz nasycone złośliwym stopem. Ostrze wybawienia i ciężar światów to najsilniejsza broń wręcz Malum."]
	quest.15D604CF280ECB60.title: "Broń z pustki"
	quest.15DD7DCACBA98806.quest_desc: [
		"Żelazny impet w tyglu zamienia duchy w węzły żelaza, które przetopisz na metal. Takie impety są też dla innych rud, np. złota i miedzi."
		""
		"&7Pęknięty impet naprawisz w tyglu albo na pylonie naprawczym.&r"
	]
	quest.15DD7DCACBA98806.title: "Impet i węzły"
	quest.15DD92C6867EC08F.quest_desc: [
		"Przekuwa afiksy przedmiotu na nowe za pył klejnotów i materiały rzadkości. Prosty stół obsługuje tylko niższe rzadkości."
		""
		"&7Kolejny tier zaklinania pojawi się tutaj, gdy twoja drużyna wejdzie w erę mosiądzu.&r"
	]
	quest.15EA3B3D3939ACBE.quest_desc: ["Deorum to złoto przemienione tajemnym pyłem, pyłem Mundabitur i węglem drzewnym. Dwie sztabki trafią do pieczęci."]
	quest.15EA3B3D3939ACBE.quest_subtitle: "Składnik pieczęci"
	quest.15FB67AC04E6B942.quest_desc: [
		"Miej naraz 1024 klejnoty źródła. Kilka komór nasycania karmionych lejkami Create i przekaźniki zbierające źródło z całej bazy zrobią to bez ciebie."
		""
		"&7Kolejny tier Ars Nouveau pojawi się tutaj, gdy twoja drużyna wejdzie w erę okultyzmu.&r"
	]
	quest.15FB67AC04E6B942.quest_subtitle: "Dowód automatyzacji"
	quest.15FB67AC04E6B942.title: "Źródło hurtem"
	quest.1604019C96870DA7.quest_desc: [
		"Zaklinacz zamienia te księgi i doświadczenie mieszkańców w zaklęte księgi. Budynki magiczne rosną w erach magii: tu do poziomu 2."
		""
		"&7Kolejny tier budynków pojawi się tutaj, gdy twoja drużyna wejdzie w erę mosiądzu.&r"
	]
	quest.16066D372D3609DB.quest_desc: ["Leżą głęboko w Netherze, blisko dna. Są odporne na wybuchy, a wykopiesz je diamentowym kilofem."]
	quest.160A4589914D44F9.quest_desc: ["Wieża w sercu ciemnego lasu otwiera się po pokonaniu fantomowych rycerzy. Na jej szczycie czeka &c{entity.twilightforest.ur_ghast}&r."]
	quest.160A4589914D44F9.title: "Mroczna wieża"
	quest.163B279F2C34878A.quest_desc: [
		"&7Ekwipunek: łuk lub kusza, bloki do budowania, mikstury powolnego opadania.&r"
		"Smok krąży nad główną wyspą Endu. Najpierw zniszcz kryształy na obsydianowych wieżach."
	]
	quest.163B279F2C34878A.quest_subtitle: "Boss"
	quest.163B279F2C34878A.title: "&c{entity.minecraft.ender_dragon}"
	quest.163F269AA565798C.quest_desc: ["Oddychanie pod wodą, karmienie pastą odżywczą z menażki i ochrona przed złymi efektami. Z nimi pancerz zadba o ciebie sam."]
	quest.163F269AA565798C.title: "Przetrwanie"
	quest.164E77F58A57B54F.quest_desc: ["Labirynt leży pod ziemią w biomie &c{biome.twilightforest.swamp}&r Lasu Zmierzchu. Otwiera się dopiero po pokonaniu licza; jeśli w erze run wybrałeś nagę, licz wciąż czeka w swojej wieży. W sercu labiryntu siedzi minoszrum."]
	quest.164E77F58A57B54F.title: "Labirynt"
	quest.16592ADF7EA541D2.quest_desc: ["Usuwa całe bryły bloków naraz. Przyda się, gdy kopiesz piwnicę albo przebudowujesz bazę od zera."]
	quest.165C4F4398AB9EE6.quest_desc: [
		"W Overworldzie zmieniają się pory roku. Każda trwa 24 dni gry: po wiośnie przychodzi lato, jesień i zima."
		"Zimą w chłodnych krainach pada śnieg, a woda zamarza."
		""
		"&7Uprawy rosną szybko tylko w swoim sezonie, a poza nim bardzo powoli. Podpowiedź nasion pokazuje, kiedy rosną.&r"
	]
	quest.165C4F4398AB9EE6.title: "Cztery pory roku"
	quest.165EF28F79677DF6.quest_desc: ["Górnik kopie szyb i chodniki, dostarcza kamień i rudy. Im wyższy poziom kopalni, tym głębiej zejdzie."]
	quest.165EF28F79677DF6.title: "Kopalnia"
	quest.166D0D68A4B44E8D.quest_desc: ["Największy dysk QIO. Potrzebuje antymaterii, więc to nagroda za cały przemysł jądrowy."]
	quest.167D828D9FAD0EB8.quest_desc: ["Trzyma dowolnie dużo jednego przedmiotu. W sam raz na bruk, ziemię i inne surowce w hurcie."]
	quest.16AC09D118F25541.quest_desc: ["Nić mocy wzmacnia zaklęcia, a nić pojemności powiększa zapas many. Obie nasycisz w aparacie z pustej nici."]
	quest.16AC09D118F25541.title: "Pierwsza nić"
	quest.16AFBF8CDD6DE71E.quest_desc: [
		"Spis potraw, które już zjadłeś. Co pięć nowych, różnych potraw dostajesz dwa serca więcej, aż do 25 potraw."
		""
		"&7Liczy się różnorodność: ta sama potrawa zjedzona drugi raz nic nie doda. Zrobisz ją z książki i marchewki.&r"
	]
	quest.16AFBF8CDD6DE71E.quest_subtitle: "Kamień milowy"
	quest.16AFBF8CDD6DE71E.title: "&a{item.solcarrot.food_book}"
	quest.16B0277A516BDD2D.quest_desc: ["Różdżka zawsze rzuca szybki pocisk, a ty dopisujesz do niego jedno zaklęcie z samych efektów i wzmocnień. Zapiszesz je na stole skryby."]
	quest.16DD2E71C524EAC7.quest_desc: ["Przeniesie cię do dowolnego teleportera z twojej częstotliwości, skądkolwiek. Naładuj go przed drogą."]
	quest.16E1F5DBF3F8ECD8.quest_desc: ["Nocą ładuje materiały światłem gwiazd. Naładowany materiał daje częściom znacznie lepsze statystyki."]
	quest.16E45F1D64C85295.quest_desc: ["Kamienne kowadło z bruku i ziemi. Na nim obrabiasz przedmioty narzędziem: nożem rozetniesz pień na deski szablonowe, a młotkiem rozbijesz bruk na kamyki."]
	quest.16E6B02C48B651C2.quest_desc: ["Przewód z dużego złącza sięga do 32 bloków i przenosi do 5000 FE na tick, pięć razy więcej niż małe złącze. Na nim oprzesz główną linię bazy."]
	quest.16E6DC80E201D8A0.quest_desc: ["Leży w skrzyniach leśnych dworów. Czasem zostawia je też przywoływacz."]
	quest.16E761F3252A1103.quest_desc: [
		"Postaw miernik obciążenia w sieci i spójrz na niego w goglach inżyniera. Zobaczysz, ile JO zużywają maszyny i ile zostało w zapasie."
		""
		"&7Miernik obciążenia zrobisz z prędkościomierza w siatce rzemiosła.&r"
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę mosiądzu.&r"
	]
	quest.16E761F3252A1103.title: "Dokładny odczyt"
	quest.16E91CEBEC2E6AB6.quest_desc: ["Na stole kowalskim szablon ulepszenia i wzmocniony odłamek echa zamienią netherytową zbroję w zbroję nadzorcy."]
	quest.16E91CEBEC2E6AB6.title: "Zbroja nadzorcy"
	quest.1700AA822C878E2C.quest_desc: ["Pełny komplet z futra Alfa yeti. Spowalnia i zamraża tych, którzy cię uderzą."]
	quest.1700AA822C878E2C.title: "Zbroja yeti"
	quest.170DA1526864E8AA.quest_desc: ["Płomienny palnik ze stołem do zaklinania, połączone szablonem ulepszenia płomienia na stole kowalskim. Zaklina przedmioty za płynne doświadczenie, bez twoich poziomów."]
	quest.170DA1526864E8AA.quest_subtitle: "Kamień milowy"
	quest.170DA1526864E8AA.title: "&d{block.create_enchantment_industry.blaze_enchanter}"
	quest.17134029AAA21DF8.quest_desc: ["Dołącza szuflady do kontrolera: kliknij kontroler, a potem szuflady albo zaznacz cały obszar."]
	quest.171820C2A55FBF5D.quest_desc: ["Afrit górnik schodzi w wymiarowej kopalni głębiej i przynosi rudy z głębin, także łupkowe. Powstaje z djinna górnika."]
	quest.171C2103DDB0034D.quest_desc: [
		"Narzędzie losujące stawia przypadkowy blok spośród tych, które w nie włożysz, w ustawionych proporcjach. Działa też z trybami kształtów, więc ściana z kilku kamieni wyjdzie naturalnie."
		""
		"&7Przepis znajdziesz w JEI.&r"
	]
	quest.171C2103DDB0034D.title: "Narzędzie losujące"
	quest.171D851019B79447.quest_desc: ["Odłamek netherytu i misterne części ze stali piekielnej z Królestwa demonów podwajają moc runy."]
	quest.171D851019B79447.title: "Runa wzmocniona"
	quest.172014DD1BAA5299.quest_desc: [
		"Daje sygnał redstone zależny od pory roku. Przyda się do farm, które same zmieniają uprawy z sezonem."
		""
		"&7Przepis wymaga kwarcu z Netheru.&r"
	]
	quest.1751A8D7234136F6.quest_desc: ["Pełny komplet z cursium na netherytowej zbroi. Hełm podświetla stwory za ścianą, a napierśnik po śmierci przywraca cię do życia z 5 punktami zdrowia."]
	quest.1751A8D7234136F6.title: "Zbroja z cursium"
	quest.176B57B72D915C96.quest_desc: ["Zamienia prąd w obroty, do 128 obr./min. Kluczem ustawisz prędkość, a moc w SU zostaje ta sama; sygnał redstone go wyłącza."]
	quest.177BBFAE4F3977FF.quest_desc: ["Zbiera w jednym miejscu otwarte prośby wszystkich mieszkańców, więc nie musisz obchodzić każdej chaty."]
	quest.17A40BEFB145F6E0.quest_desc: ["Czerwona kreda to esencja afrita, czerwony kwiat pochodni i redstone. Księga wiązania afrita z żółtym barwnikiem pozwoli przywołać go już na służbę."]
	quest.17A40BEFB145F6E0.title: "Imię afrita"
	quest.17A4692B5A2D25B5.quest_desc: ["Cztery precyzyjne mechanizmy z ery mosiądzu trafią do pieczęci. Jeśli linia montażu sekwencyjnego jeszcze stoi, wystarczy ją uruchomić."]
	quest.17A4692B5A2D25B5.quest_subtitle: "Składnik pieczęci"
	quest.17C8007220406A94.quest_desc: ["Mosiężny lejek filtruje i odlicza przedmioty, a mosiężny tunel rozdziela je równo między taśmy. To podstawa porządnych linii produkcyjnych."]
	quest.17C8007220406A94.title: "Mosiężne lejki i tunele"
	quest.17CAFF9D89754B99.quest_desc: ["Najlepsza różdżka, patyk konstrukcyjny, mechaniczna kielnia i dwa gadżety. Z tym zestawem zbudujesz wszystko, co wymyślisz."]
	quest.17CAFF9D89754B99.quest_subtitle: "Kamień milowy"
	quest.17CAFF9D89754B99.title: "&eKomplet budowniczego"
	quest.17CC641258FFA3F2.quest_desc: ["Mocniejsza wersja pierścienia zniżki. Do przepisu potrzebujesz płomiennej różdżki i pierścienia mniejszej zniżki."]
	quest.17D2173AC4D2401F.quest_desc: ["Przewodzi energię, ale nie kanały. Zasilisz nim osobną sieć bez łączenia jej z główną."]
	quest.17DE1C7674CF6CC4.quest_desc: ["Komórki MEGA zjadają procesory akumulacji na każdym poziomie. Niech inskrybentery pracują same, karmione przez sieć ME."]
	quest.17DE1C7674CF6CC4.quest_subtitle: "Dowód automatyzacji"
	quest.17F6CE36D1B3D206.quest_desc: ["Diament wrzucony w ogień duchów staje się dostrojonym klejnotem. Dwa pójdą do pieczęci, kolejne do magazynu wymiarowego i rytuałów."]
	quest.17F6CE36D1B3D206.quest_subtitle: "Składnik pieczęci"
	quest.180497A1907FEEFC.quest_desc: ["Żyła starożytnych szczątków przyjmie tylko netherytową głowicę wiertła i potrzebuje lawy jako płynu wiertniczego. Inne żyły zadowolą się każdą głowicą."]
	quest.180497A1907FEEFC.title: "Lepsze głowice"
	quest.1804A9B22E120315.quest_desc: ["Biblioteczka z cegłami z kamienia Endu, nasyconym oddechem smoka i perłą Endu. To najmocniejsza rodzina półek."]
	quest.180B3F3616B373C6.quest_desc: ["Kowadło w plecaku: naprawisz i przemianujesz przedmioty bez stawiania bloku."]
	quest.180E2CAB7669186E.quest_desc: [
		"Zwierzęta zabite tym nożem zostawiają łój, z którego zrobisz świece do rytuałów. Wystarczy żelazo i patyk."
		""
		"&7Te zadania rozwijają gałąź Occultism z rozdziału ery okultyzmu. Magazyn wymiarowy ma własną stronę w zakładce Magazyny.&r"
	]
	quest.18119FE31A405578.quest_desc: [
		"Każdy boss Lasu Zmierzchu zostawia własne trofeum. Zbierz wszystkie osiem i ustaw je w swojej bazie."
		"&7To dekoracja: do pieczęci ery liczy się trofeum paczki, które dostajesz za walkę.&r"
	]
	quest.18119FE31A405578.title: "Sala trofeów"
	quest.182AF4F0978F07E2.quest_desc: ["Lodowiec z Pałacem Zorzy. Otworzy się po pokonaniu alfa yeti."]
	quest.182AF4F0978F07E2.title: "{biome.twilightforest.glacier}"
	quest.1833A7F9829D7495.quest_desc: ["Łączy dwa takie same klejnoty z pyłem klejnotów i materiałem rzadkości w klejnot wyższej czystości. Pył klejnotów zdobędziesz, rozbierając klejnoty na stole odzysku."]
	quest.1837BA9CA203D7BF.quest_desc: [
		"Gdy zdobędziesz kamienie milowe tej ery, oddaj &6Pieczęć Ery Andezytu&r. Cała twoja drużyna wejdzie w erę andezytu, a pieczęć przepadnie."
		""
		"Pieczęć zrobisz na stole rzemieślniczym ze składników oznaczonych w tym rozdziale: stopu andezytu, bloku lazurytu, plecaka, gulaszu wołowego, lunety i miedzianej piły."
		""
		"&7Dokładny przepis zobaczysz w JEI: najedź na pieczęć i wciśnij R.&r"
	]
	quest.1837BA9CA203D7BF.quest_subtitle: "Oddaj pieczęć"
	quest.1837BA9CA203D7BF.title: "Brama: Era Andezytu"
	quest.1852CD03BCD1F119.quest_desc: [
		"&7Era pary i stali · zalecana pełna netherytowa zbroja i łuk&r"
		""
		"W śnieżnym lesie Lasu Zmierzchu, w jaskini yeti, mieszka Alfa yeti. Rzuca lodowymi bombami i ogłusza szarżą."
		"Jego futro chroni przed mrozem lodowca, na którym w pałacu zorzy rządzi Królowa Śniegu."
	]
	quest.1852CD03BCD1F119.title: "Mroźna północ"
	quest.187FE4540ADA5811.quest_desc: [
		"&7Era arkanów. Zalecany ekwipunek: pełna zbroja netherytowa i mikstury odporności na ogień.&r"
		"Ogromny golem z netherytu strzeże kuźni dusz. Walcz z dala od lawy."
	]
	quest.187FE4540ADA5811.quest_subtitle: "Boss"
	quest.187FE4540ADA5811.title: "&c{entity.cataclysm.netherite_monstrosity}"
	quest.18D49B2910A260D1.quest_desc: ["Zawory przyjmują parę i oddają prąd, wyciągi wypuszczają zużytą parę, a nasycacz skraplacza odzyska z niej wodę dla reaktora albo kotła."]
	quest.18D49B2910A260D1.title: "Pełna turbina"
	quest.18D8087B7EC7DF7F.quest_desc: ["Okręt wojenny z Dungeons Arise: Seven Seas. Załoga nie odda go bez walki."]
	quest.18D8087B7EC7DF7F.title: "Fregata"
	quest.18DB4AF8EC81B3C1.quest_desc: ["Pełna zbroja z netherytu: najmocniejsza zwykła zbroja i nie płonie w lawie. Ulepszysz ją na stole kowalskim z diamentowej."]
	quest.18DB4AF8EC81B3C1.title: "Zbroja z netherytu"
	quest.18EAEF743BF99699.quest_desc: ["Dom w olbrzymim grzybie, dziś pełen nieproszonych gości. Przeszukaj go ostrożnie."]
	quest.18EAEF743BF99699.title: "Grzybowy dom"
	quest.18F53CEADE99C786.quest_desc: [
		"&7Era run · zalecana żelazna zbroja, łuk i mikstury leczenia.&r"
		""
		"Licz osłania się wirującymi tarczami, rzuca pociski i tworzy swoje cienie, a potem przyzywa sługi."
		"Czeka na szczycie Wieży Licza."
	]
	quest.18F53CEADE99C786.quest_subtitle: "Boss"
	quest.18F53CEADE99C786.title: "&c{entity.twilightforest.lich}"
	quest.1906EB1A7A494052.quest_desc: ["Sam zgniata sztabki, samorodki i inne przedmioty w bloki. Mniej miejsca na rudy po kopaniu."]
	quest.192206C36D8188F3.quest_desc: ["Sztylet tnie białą wełnę na płótno zaklęć. Zwój powstaje, gdy narysujesz krąg na rozłożonym płótnie."]
	quest.192AB4BC3CDED21B.quest_desc: ["Stwór zabity kosą rozpada się na duchy, które zbierasz jak przedmioty. Rodzaj ducha zależy od ofiary: stwory Netheru dają duchy piekielne."]
	quest.1938A2DEA92094BB.quest_desc: [
		"Klawisz „{key.wands.wand_menu}” otwiera menu różdżki, a „{key.wands.wand_mode}” przełącza tryb: linia, rząd i kolumna, obszar, siatka, okrąg, wypełnienie, kopiowanie…"
		"Akcja („{key.wands.wand_action}”) wybiera stawianie, zamianę albo niszczenie. Pomyłkę cofniesz klawiszem „{key.wands.wand_undo}”."
		""
		"&7Do niszczenia różdżka potrzebuje narzędzia: włóż kilof, siekierę albo łopatę w jej okno.&r"
	]
	quest.1938A2DEA92094BB.title: "Tryby i menu różdżki"
	quest.193EC08916094BD3.quest_desc: [
		"Skrzynia, którą nosisz ze sobą. Załóż go na plecy albo postaw na ziemi i otwórz jak skrzynię."
		""
		"&7Klawisz &bB&7 otwiera plecak założony na plecy.&r"
	]
	quest.193EC08916094BD3.quest_subtitle: "Kamień milowy"
	quest.193EC08916094BD3.title: "&b{item.sophisticatedbackpacks.backpack}"
	quest.19634E871E4254E7.quest_desc: ["Ładuje przedmioty na składnicy lub taśmociągu pod sobą. Naładuje też kryształy kwarcu certus dla sieci ME."]
	quest.197AE2220D5D840F.quest_desc: ["Incendium dodało do Netheru nowe biomy i budowle. Znajdź zakazany zamek i przeszukaj jego skrzynie."]
	quest.197AE2220D5D840F.title: "Zakazany zamek"
	quest.198CE7DA2F3B8425.quest_desc: ["Meka-Narzędzie przeniesie cię tam, gdzie patrzysz. Wymaga antymaterii."]
	quest.1992F1A6A3FB6AF0.quest_desc: ["Wybuch niszczy bloki i rani wrogów; z tłumieniem nie uszkodzi terenu. Przepis wymaga ognistego ładunku z Netheru."]
	quest.19AB14EE702096F9.quest_desc: ["Dowód automatyzacji: 512 bloków piasku dusz. Puść piasek przez strumień powietrza z &6obudowanego wiatraka&r, który dmucha przez ogień dusz."]
	quest.19AB14EE702096F9.title: "Nawiedzanie hurtowe"
	quest.19C1B88E3715CDEA.quest_desc: [
		"&7Ekwipunek: najlepsza zbroja i ochrona przed wybuchami.&r"
		"Machina zagłady z witherytu. Strzela laserami i pociskami."
	]
	quest.19C1B88E3715CDEA.quest_subtitle: "Boss"
	quest.19C1B88E3715CDEA.title: "&c{entity.cataclysm.the_harbinger}"
	quest.19C7EC0F0264B357.quest_desc: ["Na ruchomej maszynie włącza i wyłącza jej narzędzia: wiertła, piły czy żniwiarki. Filtrem wybierzesz, które z nich ma sterować."]
	quest.19D30CB192B1F221.quest_desc: ["Gdzieś w Netherze stoi arena, na której czeka &a{entity.bosses_of_mass_destruction.gauntlet}&r."]
	quest.19D30CB192B1F221.title: "Arena rękawicy"
	quest.1A0007DC4CDD40D5.quest_desc: ["Przeciwpancerny przebija bloki i wybucha w środku umocnień, odłamkowy zasypuje cel kulami, a dymny zasłania pole walki."]
	quest.1A0007DC4CDD40D5.title: "Arsenał pocisków"
	quest.1A103C43DA85A5C2.quest_desc: [
		"Krążek windowy wozi kabinę między piętrami. Kontakt windowy na każdym piętrze wzywa kabinę i zatrzymuje ją na właściwej wysokości."
		""
		"&7Ponder (przytrzymaj W nad przedmiotem) pokaże, jak to złożyć.&r"
	]
	quest.1A103C43DA85A5C2.title: "Winda"
	quest.1A192796BDC6AB3B.quest_desc: [
		"W erze pary i stali zwykłe budynki rosną do poziomu 4. Rozbuduj najpierw chatę budowniczego, bo buduje tylko do własnego poziomu, a potem domy i magazyn."
		""
		"&7Kolejny tier budynków pojawi się tutaj, gdy twoja drużyna wejdzie w erę elektryczności.&r"
	]
	quest.1A192796BDC6AB3B.title: "Większe budynki"
	quest.1A1F417FD00AD85D.quest_desc: ["Na stole zmian wszywasz w szaty nici, które dodają im właściwości. Pusta nić to włókno ze złotą bryłką."]
	quest.1A1F417FD00AD85D.title: "Stół zmian i nici"
	quest.1A20DC34157B1976.quest_desc: ["Strzela blokami z pojemnika obok i stawia budowlę z zapisanego schematu, blok po bloku. Pióro schematów zapisze dowolną budowlę z twojego świata."]
	quest.1A3B43D388109BB2.quest_desc: ["Słoik trzyma duchy jednego rodzaju poza ekwipunkiem. Potrzebną do niego sztabkę (&d{item.malum.hallowed_gold_ingot}&r) zrobisz na ołtarzu ze złota i kwarcu."]
	quest.1A48598314F49C49.quest_desc: [
		"&7Era mosiądzu · zalecane: diamentowa zbroja&r"
		"Grzybowy minotaur strzeże serca labiryntu. Po walce zostawia &c{item.twilightforest.meef_stroganoff}&r."
	]
	quest.1A48598314F49C49.quest_subtitle: "Boss"
	quest.1A48598314F49C49.title: "&c{entity.twilightforest.minoshroom}"
	quest.1A59304CB028CB07.quest_desc: ["Ciemny kamień i szablon ulepszenia netherytowego. Na stole kowalskim nakłada modyfikator na broń, narzędzie albo zbroję; modyfikatorem jest pryzmat, stella albo kryształ z rytuału."]
	quest.1A60BE46026AEE7A.quest_desc: ["Dwa przełączniki kontaktowe zwrócone do siebie dają sygnał. Ten na ruchomej maszynie mówi jej, że dojechała na miejsce."]
	quest.1A6156F2D0127642.quest_desc: ["Podstawa każdego ulepszenia plecaka. Ulepszenie wkładasz w gniazdo z boku okna plecaka."]
	quest.1A66C559E26F968D.quest_desc: ["Loch z Deep Aether wysoko w chmurach. Jego strażnik walczy dopiero, gdy go trafisz, więc zabierz łuk."]
	quest.1A66C559E26F968D.title: "Mosiężny loch"
	quest.1A865097F19FA04C.quest_desc: ["Klasyczna broń z części. Jelec przyjmuje wygląd drugiego materiału użytego w ostrzu."]
	quest.1A8D52E79F397607.quest_desc: [
		"&7Era pary i stali · zalecana lekka zbroja i zapas jedzenia&r"
		""
		"Blefy pilnujące klasztoru gubią te pręty. Oddaj jeden Rzeźbiarzowi, a zacznie się jego próba: wspinaczka po rosnącej skalnej kolumnie, zanim skończy się czas."
	]
	quest.1A97E4BC1233B569.quest_desc: [
		"Daj Starbuncle'owi zwój, a będzie nosił tylko wypisane na nim przedmioty albo wszystko poza nimi."
		""
		"&7Kolejny tier magazynu Ars pojawi się tutaj, gdy twoja drużyna wejdzie w erę arkanów.&r"
	]
	quest.1A97E4BC1233B569.title: "Zwoje przedmiotów"
	quest.1A9C0A1247E8549E.quest_desc: ["Niszczy wybrane przedmioty albo nadmiar ponad pełne gniazda. Dobry kosz na bruk i ziemię z wiertła."]
	quest.1AAF0591F053FE48.quest_desc: [
		"&7Era arkanów · zalecana pełna netherytowa zbroja i mikstury ognioodporności&r"
		""
		"Wielcy bossowie Cataclysmu śpią w swoich budowlach: Ignis w Płonącej Arenie, Netherytowa Potworność w kuźni dusz w Netherze, a Starożytna Pozostałość w przeklętej piramidzie na pustyni."
		"Każdego trzeba obudzić: popiołami na ołtarzu, wejściem na arenę albo naszyjnikiem przy nagrobku."
	]
	quest.1AAF0591F053FE48.title: "Bestiariusz Cataclysmu"
	quest.1AE7663A683F1C7D.quest_desc: ["Dodatek TheSettler_x_Create. Pakowacz kolonii łączy magazyn kolonii z paczkami logistyki Create, tak jak zwykły pakowacz łączy skrzynię."]
	quest.1B01C36C0DE071C6.quest_desc: ["Alchemik warzy mikstury dla strażników i mieszkańców. Jego chata wymaga statywu alchemicznego. W tej erze budynki magiczne rosną do poziomu 4."]
	quest.1B077A339179DBA3.quest_desc: ["Ściana ({effortlessbuilding.mode.wall}) i podłoga ({effortlessbuilding.mode.floor}) wypełniają płaszczyznę między dwoma narożnikami. Ukośna ściana ({effortlessbuilding.mode.diagonal_wall}) i pochyła podłoga ({effortlessbuilding.mode.slope_floor}) przydadzą się na dachy i rampy."]
	quest.1B077A339179DBA3.title: "Ściana i podłoga"
	quest.1B24A66E1B08939B.quest_desc: ["Postaw je za silnikiem, gdy brakuje mu siły. Podnosi udźwig silnika, a zużycie prądu rośnie razem z nim."]
	quest.1B363F4C9D528E5E.quest_desc: [
		"Zbiera odpady jądrowe, których nie przerobi aktywator. Odpady w beczce powoli się rozpadają."
		""
		"&cNigdy nie wylewaj odpadów: skażą okolicę na długo.&r"
	]
	quest.1B3F82D1C7ED9A73.quest_desc: ["Włóż do niego odłamki rtęci, a powoli zamieni je w strumień rtęci: czystą energię, którą zasilisz emitery."]
	quest.1B9566B8971E3AF2.quest_desc: ["Włóż fokus do mrocznej różdżki (klawisz Z) i rzuć zaklęcie. Sługa zombie atakuje każdego, kto cię zrani, i chodzi za tobą jak oswojony wilk."]
	quest.1B9566B8971E3AF2.title: "Pierwszy sługa"
	quest.1BBA88CDB891766C.quest_desc: ["Łożysko zegarowe obraca przyklejone do niego wskazówki zgodnie z porą dnia w grze. Zbuduj na nim tarczę zegara i złóż ją."]
	quest.1BBA88CDB891766C.title: "Zegar na wieży"
	quest.1BC5B8A6DFDD9BFF.quest_desc: ["Złoto, redstone i odłamek duszy uwarzone w tyglu dają tajemne złoto. Cztery sztabki pójdą do pieczęci."]
	quest.1BC5B8A6DFDD9BFF.quest_subtitle: "Kamień milowy i składnik pieczęci"
	quest.1BC5B8A6DFDD9BFF.title: "&d{item.eidolon_repraised.arcane_gold_ingot}"
	quest.1BFC2919E5E3CC0E.quest_desc: ["Pusta runa z płomienną różdżką daje runę ognia. Z niej zrobisz &dkulę ulepszeń ognia&r do ekwipunku maga."]
	quest.1C0B751453CFEBA3.quest_desc: ["Szkło, osm i stal: rdzeń prawie każdej maszyny Mekanism. Na takiej obudowie powstanie też Pieczęć Ery Atomu."]
	quest.1C0B751453CFEBA3.quest_subtitle: "Składnik pieczęci"
	quest.1C100C85DEF8FA1B.quest_desc: [
		"&7Era pary i stali. Zalecany ekwipunek: pełna zbroja netherytowa.&r"
		"Alfa yeti mieszka w jaskini yeti w śnieżnym lesie Lasu Zmierzchu. Z jego futra uszyjesz zbroję yeti."
	]
	quest.1C100C85DEF8FA1B.quest_subtitle: "Boss"
	quest.1C100C85DEF8FA1B.title: "&c{entity.twilightforest.alpha_yeti}"
	quest.1C1423FF6D3A1BB4.quest_desc: ["Daje sygnał redstone, gdy zapas w sieci przekroczy ustaloną liczbę. Wyłączy nim farmę, gdy magazyn jest pełny."]
	quest.1C25636B4A8B1989.quest_desc: ["Skórzany strój nasycony jedwabiem duszy, który nasycisz z nici i wełny. Lekki strój dla walczących kosą i magią."]
	quest.1C25636B4A8B1989.title: "Strój łowcy dusz"
	quest.1C281558CAB30D66.quest_desc: ["Katalizator postawiony przy tyglu spala paliwo, np. tajemny węgiel, i przyspiesza jego pracę."]
	quest.1C2C510DD21A7846.quest_desc: ["Wystaw towar na obrusie przy magazynierze i ustal cenę. Inni gracze wezmą listę zakupów, zapłacą u magazyniera i dostaną paczkę."]
	quest.1C2C510DD21A7846.title: "Sklep na obrusie"
	quest.1C3C95F6A58407A8.quest_desc: ["Wysoka wieża widoczna z daleka. Magia Lasu Zmierzchu wpuści cię do środka dopiero po pokonaniu Nagi."]
	quest.1C3C95F6A58407A8.title: "Wieża Licza"
	quest.1C41719CE434251E.quest_desc: ["Miedziany drut nawinięty na pustą szpulę. Szpulą łączysz izolatory w linię, a w montażu trafia do generatora i silnika elektrycznego."]
	quest.1C54BF93B3DE5D8A.quest_desc: ["Najwyższy poziom stosów. Powstaje z ulepszenia czwartego poziomu."]
	quest.1C64A411B4412763.quest_desc: ["Przypisz do niego wieże, a użyty zwoła ich strażników do ciebie. Przydaje się, gdy najazd uderza z jednej strony."]
	quest.1C781BD56E583C57.quest_desc: ["Duże ruiny miasta na dnie oceanu, od Hopo's Better Underwater Ruins. Weź mikstury oddychania pod wodą."]
	quest.1C781BD56E583C57.title: "Podwodne miasto"
	quest.1C7C92E32AC85633.quest_desc: ["Odłamek ametystu w miedzianej oprawie. Przez lunetę wypatrzysz cele z daleka."]
	quest.1C7C92E32AC85633.quest_subtitle: "Składnik pieczęci"
	quest.1C8331FCF96218E5.quest_desc: ["Fae krążą przy liniach mocy i zostawiają po śmierci esencję. Przyciąga je magia rzucana na punktach mocy."]
	quest.1C87DB01BA73E951.quest_desc: ["Daje tym więcej prądu, im wyżej stoi. Postaw ją na wzgórzu albo na wieży."]
	quest.1CB7DE2ECB89213F.quest_desc: [
		"Piąty poziom stosów. Przepis wymaga bloku netherytu."
		""
		"&7Kolejny tier skrzyń pojawi się tutaj, gdy twoja drużyna wejdzie w erę atomu.&r"
	]
	quest.1CBB953C35E264BD.quest_desc: ["Pokonaj własnoręcznie każdego wielkiego bossa Cataclysmu, także tych z poprzednich er."]
	quest.1CBB953C35E264BD.title: "Pogromca Cataclysmu"
	quest.1CC15FAF8EE76424.quest_desc: ["Gwiblingi to ryby z podziemnych wód Undergarden. Złap jedną do wiadra."]
	quest.1CC15FAF8EE76424.title: "Gwibling w wiadrze"
	quest.1CD64F1F2177B833.quest_desc: ["Czarny barwnik, magiczna tkanina i totem nieśmiertelności. Zwój użyty w leśnej rezydencji przyzywa bossa: &c{entity.goety.vizier}&r."]
	quest.1CE48EAEF5896F4A.quest_desc: [
		"Silnik TFMG składasz z bloków w jednym rzędzie, najwyżej pięciu. Potem wkładasz cylindry i wał, a uruchamiasz go sygnałem redstone."
		""
		"&7Podpowiedź silnika pokaże, czego brakuje. Budowę pokazuje Ponder (W).&r"
	]
	quest.1D12C092653159E4.quest_desc: [
		"Dostrój ją do rudy (Shift i prawy przycisk na bloku), a potem użyj: wskaże drogę do najbliższej takiej rudy. Szklana sięga najbliżej."
		""
		"&7Szczegóły opisuje The Hermetica, przewodnik Theurgy.&r"
	]
	quest.1D160A16409DE198.quest_desc: [
		"Talizmany działają same, gdy są potrzebne: dają widzenie w ciemności, spowalniają upadek, pozwalają oddychać pod wodą albo chodzić po sypkim śniegu. Każde użycie zużywa ładunek, a doładujesz je źródłem w komorze nasycania."
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę mosiądzu.&r"
	]
	quest.1D160A16409DE198.title: "Pierwszy talizman"
	quest.1D1DF7702E33212A.quest_desc: ["Szkoła oka Endera działa wzrokiem: wiąże w miejscu, wzniecza czarne płomienie, pokazuje przyszłą drogę stworów albo ich ekwipunek."]
	quest.1D1DF7702E33212A.title: "Oczy mistyczne"
	quest.1D28580F167502CD.quest_desc: ["Kocioł wiedźmy warzy własne wywary za energię dusz. Pracuje tylko wtedy, gdy w pobliżu płoną świeczniki dusz na pełnych klatkach."]
	quest.1D2ACC757F4E5AD1.quest_desc: [
		"Komórka zbiorcza trzyma jeden rodzaj przedmiotu w praktycznie nieograniczonej ilości. Idealna na bruk, piasek i inne masowe surowce."
		""
		"&7Karta kompresji w komórce zbiorczej sama zamienia samorodki, sztabki i bloki.&r"
	]
	quest.1D2C2401DCA3B407.quest_desc: [
		"Samotna wieża Incendium na kwarcowych równinach. Wejdź na szczyt."
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę okultyzmu.&r"
	]
	quest.1D2C2401DCA3B407.title: "Opuszczona wieża"
	quest.1D38FE59DBD690E2.quest_desc: [
		"Ta strona prowadzi przez wyspy Endu i ich budowle. Smok i inni bossowie Endu są w drzewie ery atomu."
		""
		"&7Pod wyspami jest pustka. Weź bloki, perły z endermanów i coś na spadanie.&r"
	]
	quest.1D38FE59DBD690E2.title: "Wyspy Endu"
	quest.1D4CD8F88B9414AF.quest_desc: ["Runiczne drzewa rosną na równinach i wzgórzach, rzadziej w lasach. Z ich desek zbudujesz ołtarz duchów i totemy."]
	quest.1D505B4780D2BDD8.quest_desc: ["Lista przedmiotów, które przepuści lejek albo wyjmie ramię. Włóż ją w gniazdo filtra na bloku: kliknij je z filtrem w ręce."]
	quest.1D69DB228D162A45.quest_desc: [
		"Chimera zostawia hołd. Pójdzie do fokusu przywołania, a w późniejszych erach do księgi arcymaga i znaku mistrzostwa."
		""
		"&7Kolejny tier bossów magii pojawi się tutaj, gdy twoja drużyna wejdzie w erę okultyzmu.&r"
	]
	quest.1D6DB12B3502E9ED.quest_desc: ["Koła kruszące zmieniają rudę w rudę kruszoną i bryłki doświadczenia, a całe złoża dają jej jeszcze więcej. Przepłucz ją wiatrakiem albo przetop: płukanie daje bryłki metalu i czasem coś ekstra, np. redstone z żelaza."]
	quest.1D6DB12B3502E9ED.title: "Kruszona ruda"
	quest.1D6F35160BB3C0C7.quest_desc: ["Rosną na krzakach w Undergarden. Upieczone w piecu albo wędzarni dają porządny posiłek."]
	quest.1D72C292B37A5B00.quest_desc: ["Ciepła zbroja z futra. Możesz ją farbować jak skórzaną."]
	quest.1D72C292B37A5B00.title: "Arktyczna zbroja"
	quest.1D80099ABD8EE379.quest_desc: [
		"W tej paczce oka Endu nie rzucisz i nie włożysz w ramę portalu. Ramę starożytnego portalu w twierdzy wypełnisz oczami End Remastered."
		"Każde oko pochodzi z innej przygody: ze skrzyń w budowlach, od potężnych stworów albo z przepisu."
		""
		"&7Zbieraj oczy całą drużyną, zanim wejdziesz w erę atomu.&r"
	]
	quest.1D80099ABD8EE379.title: "Portal bez oka Endu"
	quest.1D93B9C7003F1F15.quest_desc: ["Nadruk inżynieryjny odciskasz na diamencie. Ten procesor trafi do kontrolera, napędu ME i pieczęci."]
	quest.1D93B9C7003F1F15.quest_subtitle: "Składnik pieczęci"
	quest.1D95F5B90CF3879F.quest_desc: ["Zamontuj gwizdek parowy na pociągu i zagwiżdż nim w czasie jazdy. Wszyscy na peronie będą wiedzieć, że nadjeżdżasz."]
	quest.1D95F5B90CF3879F.title: "Gwizdek lokomotywy"
	quest.1DB1DC5013D1F6FB.quest_desc: [
		"Create: Connected dodaje przekładnie, których brakuje w Create. Równoległa obraca wały za rogiem w tę samą stronę, a sześciokierunkowa ma wały na wszystkich ścianach – górny i dolny kręcą się o połowę wolniej."
		""
		"&7Ta strona zbiera mniejsze dodatki Create. Każdy mod ma tu własny pas.&r"
	]
	quest.1DB1DC5013D1F6FB.title: "Nowe przekładnie"
	quest.1DB5E1B3659E0D2B.quest_desc: ["Tu mieszkają stranghoule. Z niektórymi da się dobić targu, a pokonane zostawiają malaryt."]
	quest.1DB5E1B3659E0D2B.title: "Legowisko stranghouli"
	quest.1DCB210D0E297B67.quest_desc: ["Więcej miejsca i jedno gniazdo ulepszeń więcej. Skrzynię w ekwipunku przerobisz w siatce z miedzią."]
	quest.1DF1B89DF4B3D796.quest_desc: ["Kapelusz i szata wiedźmy. W szacie jest statyw alchemiczny, który otworzysz klawiszem ze sterowania."]
	quest.1DF1B89DF4B3D796.title: "Strój wiedźmy"
	quest.1E0D88CBD29B6927.quest_desc: [
		"Gdy zdobędziesz kamienie milowe tej ery, oddaj &6Pieczęć Ery Okultyzmu&r. Cała twoja drużyna wejdzie w erę okultyzmu, a pieczęć przepadnie."
		""
		"Pieczęć powstaje w montażu sekwencyjnym Create na &6mosiężnej obudowie&r: aplikatory dokładają precyzyjny mechanizm, płomienną różdżkę, lampę elektronową i dwa trofea bossów, wylewka dolewa 500 mB lawy, a prasa ją dociska."
		""
		"&7Dokładny przepis zobaczysz w JEI: najedź na pieczęć i wciśnij R.&r"
	]
	quest.1E0D88CBD29B6927.quest_subtitle: "Oddaj pieczęć"
	quest.1E0D88CBD29B6927.title: "Brama: Era Okultyzmu"
	quest.1E277C8511418E3E.quest_desc: ["{block.ars_nouveau.ritual_brazier} dostaje z Ars Elemental nowe tablice: przyciąganie, odpychanie, wykrywanie, zapylanie, wiewiórki, cewkę Tesli i las łukodrzewów. Zrób dowolną z nich."]
	quest.1E277C8511418E3E.title: "Rytuał żywiołów"
	quest.1E34913CB52B2916.quest_desc: [
		"Aluminium wytopisz w elektrolizerze: podgrzanej kadzi z dwoma uchwytami i miedzianymi elektrodami, zasilanymi z sieci. Rozkłada proszek boksytu na metal."
		""
		"&7Proszek boksytu dają koła kruszące, a boksyt leży w warstwach skał pod ziemią.&r"
	]
	quest.1E54FAB5C7AAB310.quest_desc: ["Zgromadź 64 pręty paliwa. Linia montażu sekwencyjnego zasilana torem z miksera nie da reaktorowi zgasnąć."]
	quest.1E54FAB5C7AAB310.title: "Zapas paliwa"
	quest.1E699B28DAB70780.quest_desc: ["Sekwencyjny generator impulsów wykonuje listę poleceń z opóźnieniami, gdy dostanie sygnał z tyłu. Sterujący procesor do niego powstaje w montażu sekwencyjnym."]
	quest.1E699B28DAB70780.title: "Programowany redstone"
	quest.1E71E31719F33621.quest_desc: ["Zaawansowany silnik kręci do 256 obr./min, a wzmocniony ma największy zapas energii. Oba wymagają przeładowanych materiałów z nasycacza."]
	quest.1E71E31719F33621.title: "Mocniejsze silniki"
	quest.1E78A0D397FB5C53.quest_desc: ["Bliźniak ołtarza: zamiast esencji zużywa Spiritus z klejnotu włożonego do środka. Powstają w niej klejnoty Spiritus, narzędzia świadome i ładunki wybuchowe."]
	quest.1E78A0D397FB5C53.quest_subtitle: "Kamień milowy"
	quest.1E78A0D397FB5C53.title: "&d{block.neovitae.hellfire_forge}"
	quest.1E82BE476F8BB384.quest_desc: ["Create Propulsion buduje silniki z platyny. Rudę platyny wykopiesz głęboko pod ziemią, a kruszoną przetopisz na sztabki; prasa zrobi z nich arkusze na kable, obudowy i dysze."]
	quest.1E980C3800C4710D.quest_desc: ["Leży w ukrytej komnacie świątyni. Z pancerzem nadzorcy ulepszysz nim sprzęt z netherytu."]
	quest.1E980C3800C4710D.title: "Szablon nadzorcy"
	quest.1EA8DBA0ED4E4364.quest_desc: ["Bez ochrony przed zimnem nie przejdziesz przez lodowiec. Z futra Alfa yeti uszyjesz ciepłą zbroję."]
	quest.1EA8DBA0ED4E4364.quest_subtitle: "Kamień milowy"
	quest.1EA8DBA0ED4E4364.title: "&c{item.twilightforest.alpha_yeti_fur}"
	quest.1EC310751E5F982D.quest_desc: ["Magazyn amunicji podaje naboje do zamka działka. Naboje przeciwpiechotne są tanie i skuteczne przeciw stworzeniom."]
	quest.1EC310751E5F982D.title: "Magazyn amunicji"
	quest.1EC7E29A1A665D4C.quest_desc: ["Kilof, siekiera i łopata w jednym. Jest trochę trwalszy, ale kopie odrobinę wolniej."]
	quest.1EF868965F3BF0A9.quest_desc: ["Najniższe krainy Undergarden, pełne zgniłych stworów. Uważaj na utheryczną infekcję."]
	quest.1EF868965F3BF0A9.title: "Głębiny"
	quest.1EF97CA9C4F8F80B.quest_desc: ["Mocowanie koła trzyma oponę i pozwala symulowanej maszynie jechać po ziemi. Opony są w czterech rozmiarach, od małej po monstrualną."]
	quest.1EF97CA9C4F8F80B.title: "Na kołach"
	quest.1F32E166ECCE4EC2.quest_desc: ["Przekładnia oddaje obrót na wszystkie cztery boki, także za róg. Wał na wprost wejścia kręci się w przeciwną stronę niż na wejściu."]
	quest.1F32E166ECCE4EC2.title: "Przekładnie"
	quest.1F363D298EFDAC86.quest_desc: [
		"Bateria kinetyczna ładuje się, pobierając obciążenie od przodu, a zasilona redstone oddaje je jako źródło napędu o stałej prędkości. Naładuj ją do pełna – fabryka pojedzie dalej, gdy główne źródło stanie."
		""
		"&7Ponder (przytrzymaj W nad przedmiotem) pokaże, jak to działa.&r"
	]
	quest.1F363D298EFDAC86.quest_subtitle: "Kamień milowy"
	quest.1F363D298EFDAC86.title: "&6Bateria kinetyczna"
	quest.1F5DA7C454A4C364.quest_desc: ["Znajdź kwaterę apotycznych kultystów z Discerning the Eldritch. W jej głębi czeka {entity.discerning_the_eldritch.ascended_one}."]
	quest.1F5DA7C454A4C364.title: "Kwatera kultystów"
	quest.1F663FD265E72969.quest_desc: ["Dowód automatyzacji: 256 klejnotów źródła. Postaw kilka komór nasycania przy słoikach, a lazuryt podawaj i odbieraj lejami albo lejkami Create."]
	quest.1F663FD265E72969.title: "Klejnoty na skalę"
	quest.1F87CDB590D69039.quest_desc: ["Rozkłada wodę na wodór i tlen. Tlen zasila komorę oczyszczającą, a wodór spalisz w generatorze gazowym albo w plecaku odrzutowym."]
	quest.1F9C2D37BBCEE795.quest_desc: [
		"&7Era mosiądzu · zalecane: diamentowa zbroja, tarcza&r"
		"Żelazny strażnik czeka w podziemnej komnacie. Od przodu chroni go zbroja, więc szukaj okazji do ciosu w plecy."
	]
	quest.1F9C2D37BBCEE795.quest_subtitle: "Boss"
	quest.1F9C2D37BBCEE795.title: "&c{entity.mowziesmobs.ferrous_wroughtnaut}"
	quest.1FB9179434C717E2.quest_desc: ["Księga wiązania djinna z fioletowym barwnikiem, połączona ze słownikiem, zna jego imię. Djinni jest silniejszy od foliota i odprawia trudniejsze rytuały."]
	quest.1FD8A8C1E74823F4.quest_desc: ["Łopata kopie szybciej ziemię, piasek i żwir. Potrzebna też do &agarnka&r."]
	quest.1FE740B5B6940DEE.quest_desc: ["Blok złota na ołtarzu drugiego poziomu. Od tej kuli zaczynają się rytuały i zbroja świadoma."]
	quest.1FE740B5B6940DEE.quest_subtitle: "Kamień milowy"
	quest.1FE740B5B6940DEE.title: "&d{item.neovitae.blood_orb_magician}"
	quest.2001C65186B84C6B.quest_desc: [
		"&7Era pary i stali · zalecany kilof z zanitu albo lepszy i pełna zbroja&r"
		""
		"Loch z rzeźbionego kamienia ukryty we wnętrzu wyspy. Strzeże go Slider, kamienny blok, który rani tylko kilof. Unikaj go, gdy sunie w twoją stronę."
	]
	quest.2001C65186B84C6B.title: "Brązowy loch"
	quest.20033862BE22BAD3.quest_desc: ["Wyleć na orbitę Ziemi. Stąd rakieta poleci dalej, na Księżyc i inne planety."]
	quest.20033862BE22BAD3.quest_subtitle: "Kosmos, nieobowiązkowy"
	quest.20033862BE22BAD3.title: "Orbita"
	quest.2022A89AAD55C22E.quest_desc: ["Płyty zbroi robisz z planu i materiału, tak jak głowice. Każdy materiał daje inne cechy, więc mieszaj je, aż trafisz na swój zestaw."]
	quest.2022A89AAD55C22E.title: "Zbroja z części"
	quest.202C3A576FEA7DBF.quest_desc: ["Rytuały kuźni zużywają cztery esencje: aureal, krew, dusze i doświadczenie. Butelkę aurealu zrobisz z tajemnego pyłu i mikstury, a probówka to naczynie na krew."]
	quest.202C3A576FEA7DBF.title: "Esencje kuźni"
	quest.2033FBA126229000.quest_desc: ["Szkoła szmaragdu to handel: otrzymane obrażenia zamieniasz w manę albo bierzesz odporność na powtarzane ciosy za podwójne od nowych."]
	quest.2033FBA126229000.title: "Zwój wymiany"
	quest.2034878D79D4F673.quest_desc: ["Wystrzeliwuje falę dźwięku jak {entity.minecraft.warden}. Do rytuału potrzebujesz rubinu dusz, odłamka echa i katalizatora sculku."]
	quest.20349EC44D285471.quest_desc: ["Słoiki, półki na przedmiot, tablice informacyjne, klepsydry i dziesiątki innych drobiazgów. W słoiku przechowasz płyn albo przedmioty i postawisz go na stole."]
	quest.20349EC44D285471.title: "Drobiazgi Supplementaries"
	quest.20438A7266ADE336.quest_desc: ["Łup z władcy głębin: hak na linie i macka, która rani wrogów."]
	quest.2044F5DE06AC8B25.quest_desc: ["Dodatkowy punkt dostępu do kontrolera. Postaw go tam, gdzie wygodniej wkładać i wyjmować."]
	quest.2056E8FDE0091650.quest_desc: ["Meduzy dryfują w morzach i parzą przy dotyku. Złap jedną do wiadra i wypuść tam, gdzie chcesz."]
	quest.206C25125206B59F.quest_desc: ["Wyrzuca włożone przedmioty przed siebie. Postaw ją nad lejem albo taśmą, a magazyn zasili maszynę."]
	quest.2070D74B64500FA7.quest_desc: ["Farbiarz robi barwniki i barwi wełnę, beton i inne bloki dla budów."]
	quest.207303221A0D0E34.quest_desc: ["Kula ognia z pręta płomienia i fokusu podpalenia. Fokusy ognia to najprostsza szkoła ataku: rośnie od podpalenia po deszcz meteorów."]
	quest.2077B7B0F2C1E13A.quest_desc: ["Pieczęć następnej ery zużyje dwa precyzyjne mechanizmy. Linia montażowa z ery mosiądzu zrobi je bez trudu."]
	quest.2077B7B0F2C1E13A.quest_subtitle: "Składnik pieczęci"
	quest.207B8C89C503B967.quest_desc: ["Arkusz mosiądzu na stopie andezytu. Dłoń jest sercem aplikatora."]
	quest.20A43CD1F5CF7C0F.quest_desc: ["Świątynia zarośnięta pajęczynami i pełna robactwa. Weź pochodnie i nożyce."]
	quest.20A43CD1F5CF7C0F.title: "Zarażona świątynia"
	quest.20BF312F78CBF5EE.quest_desc: ["Barwnik zmieszany w mikserze z wodą daje płynny barwnik. Wiatrak dmuchający przez niego farbuje przedmioty hurtem, a płynny barwnik zetknięty z lawą zastyga w beton w swoim kolorze."]
	quest.20BF312F78CBF5EE.title: "Płynny barwnik"
	quest.20D3BB5546F198EA.quest_desc: ["Mały wyświetlacz na cztery linie. Tekst z nadajnika wyświetlacza trafia też na ekran gracza, który siedzi przed panelem – w kabinie pociągu albo statku."]
	quest.20E01B8154E80B61.quest_desc: ["Kostur geomanty przywołuje trzy kamienie, które po chwili lecą tam, gdzie patrzysz. Pręty blefa naprawiają go i resztę stroju."]
	quest.20E0ABBC1B47B114.quest_desc: ["Wielki galeon z Dungeons Arise: Seven Seas. Przeszukaj każdy pokład."]
	quest.20E0ABBC1B47B114.title: "Galeon"
	quest.20F497E931F9EA35.quest_desc: ["Włókno z magicznego kwiatu to materiał na szaty maga, nici i pergamin."]
	quest.20FED8168C36C2C4.quest_desc: ["Teleskop i stół astronomiczny zaczynają program kosmiczny Northstar. Kosmos to dodatek: brama ery go nie wymaga."]
	quest.20FED8168C36C2C4.quest_subtitle: "Kosmos, nieobowiązkowy"
	quest.210A8375EF210CE7.quest_desc: ["Obsydian i surowe żelazo wypalone w Clibano z reliktem rzemieślnika. Ze stali obsydianowej powstają mroczna gwiazda Netheru, czaszki i zbroje smocze."]
	quest.210B0032A4FAF64B.quest_desc: ["Palnik gorącego powietrza pod zamkniętą powłoką balonową unosi statek. Powłokę zrobisz z wełny i patyków, a budowę balonu pokazuje Ponder (W)."]
	quest.210B0032A4FAF64B.title: "Balon"
	quest.210C88907C0457FE.quest_desc: ["Przekaźniki łańcuchowe ustawione obok siebie przenoszą obrót wzdłuż całego rzędu, w tę samą stronę. Regulowany przekładnik zmienia prędkość zależnie od siły sygnału redstone."]
	quest.210C88907C0457FE.title: "Napęd łańcuchowy"
	quest.2112AA2F8AF7BFFE.quest_desc: ["Rytuał nie pozwala potworom pojawiać się w promieniu 32 bloków, póki ma źródło. Bezpieczna baza bez pochodni na każdym kroku."]
	quest.2117DD9A2804106D.quest_desc: ["Oba znasz z ery kamienia: lazuryt leży głęboko, a ametyst w geodach. Po cztery sztuki trafią do pieczęci."]
	quest.2117DD9A2804106D.quest_subtitle: "Składnik pieczęci"
	quest.2117DD9A2804106D.title: "Lazuryt i ametyst"
	quest.2158674B4C7C444D.quest_desc: [
		"&7Era pary i stali. Zalecany ekwipunek: najlepsza zbroja i odporność na ogień.&r"
		"Duch słońca pilnuje złotego lochu we wnętrzu wielkiej wyspy. Strzela kulami ognia, więc walcz z dala od łatwopalnych bloków."
	]
	quest.2158674B4C7C444D.quest_subtitle: "Boss"
	quest.2158674B4C7C444D.title: "&c{entity.aether.sun_spirit}"
	quest.215A96B07E9B2DCE.quest_desc: ["Białą kredą kreślisz pentakle. Najpierw zrobisz kredę nieczystą, a ogień duchów ją oczyści."]
	quest.2160E78D87327A77.quest_desc: ["Ramę z obsydianu podpal krzesiwem, a otworzy się portal. Nether jest otwarty od tej ery: czekają tam płomyki, kwarc i złoto."]
	quest.2160E78D87327A77.quest_subtitle: "Kamień milowy"
	quest.2160E78D87327A77.title: "&aWejście do Netheru"
	quest.216543B04D6E3261.quest_desc: ["Tyle sztabek da tylko linia, która sama przerabia rudę: komora wzbogacania, piec i transportery logistyczne."]
	quest.216543B04D6E3261.quest_subtitle: "Dowód automatyzacji"
	quest.2168EF0291E7FADD.quest_desc: ["Transporter objazdowy przepuszcza przedmioty zależnie od sygnału redstone. Transporter z ogranicznikiem jest dla nich ostatnim wyborem trasy."]
	quest.2168EF0291E7FADD.title: "Rozjazdy"
	quest.2177ADD7300AA308.quest_desc: ["Zaklęta wieżyczka nasycona fokusem żywiołu przejmuje część jego mocy: jej zaklęcia wywołują efekty tego fokusu. Powstaje w komorze nasycania."]
	quest.2177ADD7300AA308.title: "Wieżyczka żywiołu"
	quest.217C9A5896C2FE1D.quest_desc: ["Czwarty pierścień run (razem 100) z blokami stali piekielnej w rogach. Blok stali piekielnej na takim ołtarzu da kulę Dominusa."]
	quest.217C9A5896C2FE1D.quest_subtitle: "Kamień milowy"
	quest.217C9A5896C2FE1D.title: "&d{item.neovitae.blood_orb_archmage}"
	quest.218D28B612B42DB0.quest_desc: ["Djinni górnik pracuje w wymiarowej kopalni szybciej niż foliot i przynosi więcej rud. Powstaje w rytuale z foliota górnika i kilofa z iesnium."]
	quest.21910EC2977D2053.quest_desc: ["Zamienia siarkę alchemiczną w saletrę (niter), którą da się przenosić między rodzajami materii, np. z metali w klejnoty. Kadź zamykasz i otwierasz Shiftem i pustą ręką."]
	quest.219687B3511CC879.quest_desc: ["Odłamek filakterii trafia się w katakumbach, a z latarnią dusz da całą filakterię. Użyta na duszy Umarłego Króla wskrzesi go do kolejnej walki."]
	quest.219E7F099DD7D563.quest_desc: ["Endowa półka ulepszona głową smoka. Do pełnej mocy stołu potrzebujesz ich kilku."]
	quest.21A8F17D18AFF16D.quest_desc: [
		"Gobliny-rycerze i kraby w hełmach z twierdzy rycerzy gubią odłamki zbroi. Z kilku zrobisz bryłę, którą przetopisz na rycerski metal."
		"&7Era okultyzmu · przed twierdzą przyda się netherytowa zbroja.&r"
	]
	quest.21DA0E50BE31704E.quest_desc: ["Tkanina nasycona ektoplazmą. Ektoplazmę zostawiają upiory ({entity.goety.wraith}) i nekromanci, znajdziesz ją też w lochach."]
	quest.21DFA1F1BDCD2BAD.quest_desc: ["Ośnieżony las z jaskiniami yeti. Krążą tu też zimowe wilki."]
	quest.21DFA1F1BDCD2BAD.title: "{biome.twilightforest.snowy_forest}"
	quest.21EE8EDBCFE599FA.quest_desc: ["Ruiny cytadeli na wyspach Endu. Pilnują ich golemy Endu, a w głębi czeka Strażnik Endu."]
	quest.21EE8EDBCFE599FA.title: "Zrujnowana cytadela"
	quest.220BF34E81594BBB.quest_desc: ["Ulepszenia silnika diesla. Turbosprężarka go przyspiesza, a tłumik wycisza. Kliknij nimi postawiony silnik."]
	quest.220BF34E81594BBB.title: "Turbo i tłumik"
	quest.220D99ADA2A46ECE.quest_desc: ["Glif znaczenia zapisuje cel w relikwiarzu, a glif przywołania rzuca na niego zaklęcie, choćby był daleko. Tak zaczarujesz zwierzę albo przyjaciela bez celowania."]
	quest.220D99ADA2A46ECE.title: "Relikwiarz i znaczniki"
	quest.223D3450225DF280.quest_desc: ["Szmaragdy dają wieśniacy za towar, a w górach wykopiesz je żelaznym kilofem. Jeden trafi do pieczęci."]
	quest.223D3450225DF280.quest_subtitle: "Składnik pieczęci"
	quest.22437698C9D290F1.quest_desc: ["Aktywator słoneczny zamienia lit z parownika termicznego w tryt. Pracuje tylko w słońcu."]
	quest.226066D076DB72F9.quest_desc: ["Duży silnik pali mniej rafinowane paliwa, np. ciężki olej. Tańsza wersja z żeliwa i precyzyjnego mechanizmu pracuje słabiej."]
	quest.226B5E9871BD4B07.quest_desc: ["Okna, które łączą się w większe tafle, okiennice i zasłony, a do tego drzwi od stodoły, japońskie i wiele innych."]
	quest.226B5E9871BD4B07.title: "Okna i drzwi"
	quest.226B92AA16E960DD.quest_desc: [
		"Rytuał na trzecim poziomie kuźni: diament, trzy xpetryfikowane kule i kawałek gwiezdnolitu. Nałożona szablonem stella daje modyfikator wieczny: przedmiot przestaje się zużywać."
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę atomu.&r"
	]
	quest.226B92AA16E960DD.quest_subtitle: "Kamień milowy"
	quest.226B92AA16E960DD.title: "&d{item.forbidden_arcanus.eternal_stella}"
	quest.226D53B73B909667.quest_desc: ["Monitor pokazuje kontakty z radaru, a kontroler sieci łączy radary, monitory i działa. Łącza danych spinają je ze sobą."]
	quest.226D53B73B909667.title: "Stanowisko dowodzenia"
	quest.2291593A958925D8.quest_desc: ["Rękawica skarbca ciska w cel bronią i narzędziami z twojego ekwipunku. To jedno z najsilniejszych zaklęć Mahou Tsukai."]
	quest.22A14F87C3A390C4.quest_desc: ["Pokazuje, ile ropy kryje chunk, w którym stoisz. Bogactwo złóż zależy od biomu."]
	quest.22A3C26E3E0D39FE.quest_desc: ["Wykopiesz ją z rudy w kamieniu i lodzie. Ze sznurkiem da pudełko zapałek."]
	quest.22AD74328667EB0E.quest_desc: [
		"&7Era pary i stali. Zalecany ekwipunek: lekka zbroja i zapas jedzenia.&r"
		"Rzeźbiarz nie walczy wprost, tylko stawia próbę na czas. Oddaj mu pręt blefa, a próba się zacznie."
	]
	quest.22AD74328667EB0E.quest_subtitle: "Boss"
	quest.22AD74328667EB0E.title: "&c{entity.mowziesmobs.sculptor}"
	quest.22BF57F69C5046CC.quest_desc: ["Kim jest finałowy boss i gdzie go znaleźć, zdradzi kolejna wersja paczki."]
	quest.22BF57F69C5046CC.quest_subtitle: "Wkrótce"
	quest.22BF57F69C5046CC.title: "Finałowy boss"
	quest.22EEE101E48BF0D3.quest_desc: ["Wielka huta pełna pieców i strażników. To jeden z najtrudniejszych lochów Dungeons Arise."]
	quest.22EEE101E48BF0D3.quest_subtitle: "Kamień milowy"
	quest.22EEE101E48BF0D3.title: "&aOdlewnia"
	quest.23266B3F8753E129.quest_desc: [
		"Klawisz „{key.buildinggadgets2.settings_menu}” otwiera menu gadżetu: kształt, zasięg i opcje. Blok budulca wybierasz, klikając go gadżetem z wciśniętym Shiftem."
		"„{key.buildinggadgets2.undo}” cofa ostatnią operację i oddaje bloki, a „{key.buildinggadgets2.anchor}” przypina podgląd w miejscu."
	]
	quest.23266B3F8753E129.title: "Sterowanie gadżetami"
	quest.232A7048AAB962B3.quest_desc: ["Las tak gęsty, że w dzień panuje w nim noc. Pod ziemią stoi twierdza goblinów-rycerzy."]
	quest.232A7048AAB962B3.title: "{biome.twilightforest.dark_forest}"
	quest.233928C48BE0A92F.quest_desc: [
		"Złośliwy ołów ze studni, pusta płyta, żelazo i odłamek netherytu nasycone na ołtarzu. Ten stop to materiał najmocniejszej broni i zbroi Malum."
		""
		"&7Złośliwy ołów da ci studnia z ktonicznego złota.&r"
	]
	quest.233928C48BE0A92F.quest_subtitle: "Kamień milowy"
	quest.233928C48BE0A92F.title: "&d{item.malum.malignant_pewter_ingot}"
	quest.233AD6DD519D24F7.quest_desc: ["Złocony pierścień nasycony na ołtarzu z kalksem alchemicznym dostaje własną moc. Co daje każdy pierścień, opisuje encyklopedia."]
	quest.233AD6DD519D24F7.title: "Nasycony pierścień"
	quest.233B8B05A1B1325C.quest_desc: [
		"Z atramentem legendarnym {block.irons_spellbooks.scroll_forge} wykuwa zaklęcie na najwyższym poziomie. Uwarzysz go w kotle alchemika z atramentu epickiego i ametystu."
		"Do tego runa jednej z nowych szkół tej ery: Wypaczenia, powietrza, nekromancji, otchłani albo technomancji. Z runy zrobisz kulę ulepszenia i szaty tej szkoły."
	]
	quest.233B8B05A1B1325C.quest_subtitle: "Kamień milowy"
	quest.233B8B05A1B1325C.title: "&dWyższa magia Iron's"
	quest.233EA7A2BDBBC6FE.quest_desc: ["Wypal kulki szamotu w piecu i złóż cegły w bloki. Z nich zbudujesz wielki piec i nagrzewnicę."]
	quest.2346A65B464D6FC8.quest_desc: ["Wypada z golemów Endu w cytadeli. Użyty przywołuje runy pustki, a w erze transcendencji połączysz go z bronią na kowadle fuzji."]
	quest.235048A9649248B7.quest_desc: ["Ładuje kryształy kwarcu certus prądem. To samo zrobi transformator Tesli."]
	quest.235E8E9DF9330392.quest_desc: [
		"Gdy zdobędziesz kamienie milowe tej ery, oddaj &6Pieczęć Ery Arkanów&r. Cała twoja drużyna wejdzie w erę arkanów, a pieczęć przepadnie."
		""
		"Pieczęć zrobisz na mechanicznych stołach rzemieślniczych Create ułożonych w siatkę 5×5: 8 sztabek stali, 4 stalowe obudowy, 4 precyzyjne mechanizmy, 2 ciężkie obudowy maszynowe, silnik diesla oraz trofea bossa Aetheru i drugiego bossa tej ery."
		""
		"&7Dokładny przepis zobaczysz w JEI: najedź na pieczęć i wciśnij R.&r"
	]
	quest.235E8E9DF9330392.quest_subtitle: "Oddaj pieczęć"
	quest.235E8E9DF9330392.title: "Brama: Era Arkanów"
	quest.236EA965089911A1.quest_desc: [
		"Prosty stół przekuwania ulepszony netherytem, cegłami Netheru i tajemnymi piaskami. Przekuje także przedmioty wyższych rzadkości."
		""
		"&7Kolejny tier zaklinania pojawi się tutaj, gdy twoja drużyna wejdzie w erę pary i stali.&r"
	]
	quest.23750D7C810A77A0.quest_desc: ["Przejdź do Otherside, mrocznego odbicia głębin. Każdy dźwięk może cię tu zdradzić."]
	quest.23750D7C810A77A0.quest_subtitle: "Kamień milowy"
	quest.23750D7C810A77A0.title: "&aOtherside"
	quest.23836E97A240F2B6.quest_desc: ["Wylot pary napełnia balon parą z kotła zamiast gorącym powietrzem. Na sygnał redstone balon nad nim powoli się wypełnia, a im wyżej, tym słabiej unosi."]
	quest.2387B9D72ABC5D39.quest_desc: ["Deep Aether dodaje do Aetheru nowe biomy i surowce, a wśród nich ten klejnot. Zrobisz z niego narzędzia i {block.deep_aether.combiner}."]
	quest.23A48EAF4BEDC309.quest_desc: ["Łączy dwa gazy w trzeci: wodór z chlorem w chlorowodór dla komory wtrysku, a tlenki siarki z parą wodną w kwas siarkowy."]
	quest.23A5D59414CC6E6C.quest_desc: ["Tabliczka Robur na ołtarzu drugiego poziomu za 5000 esencji. Potrzebna do atanora, kluczy i mocniejszych sigili."]
	quest.23B5A7698BD6D44E.quest_desc: [
		"Ustaw dwa aplikatory naprzeciw siebie i uruchom je razem. Nawet maszyny potrafią się przywitać."
		""
		"&7To ukryte osiągnięcie Create.&r"
	]
	quest.23B5A7698BD6D44E.title: "Żółwik"
	quest.23E0C8406D19EB10.quest_desc: ["Krzesła, stoły, szafki, ławy i kanapy z każdego drewna. Na krzesłach i kanapach usiądziesz."]
	quest.23E0C8406D19EB10.title: "Meble Handcrafted"
	quest.23E3AC5DF323924B.quest_desc: ["Podłącz go do pakowacza, a pojemnik za nim stanie się częścią sieci magazynowej. Łączniki na tej samej częstotliwości tworzą jeden magazyn."]
	quest.23FB35A36A8E92AB.quest_desc: ["Topór bojowy z cloggrum ulepszony sztabką zapomnianego metalu i szablonem kowalskim. Zadaje więcej obrażeń stworom Undergarden."]
	quest.240DC665B9267FC1.quest_desc: ["Zostawiają je yeti i zimowe wilki."]
	quest.24332F4F1D307691.quest_desc: ["Kostur prawdziwego wzroku pozwala widzieć i używać bloków z innego świata bez Trzeciego Oka. Łączy netheryt, kilof z iesnium, gogle i różdżkę wróżbiarską."]
	quest.243E658F0728D5F0.quest_desc: ["Poza Ziemią nie ma powietrza. Tlenem napełni go &a{block.northstar.oxygen_filler}&r."]
	quest.243E658F0728D5F0.quest_subtitle: "Kosmos, nieobowiązkowy"
	quest.243E658F0728D5F0.title: "Skafander"
	quest.244A168AD0A54CC0.quest_desc: ["Kocioł alchemika postaw nad ogniem i nalej wody. Warzysz w nim atramenty i eliksiry, a wrzucone zwoje rozpuszczasz w atrament ich rzadkości. Przepis wymaga esencji żaru z cytadeli."]
	quest.244A168AD0A54CC0.quest_subtitle: "Kamień milowy"
	quest.244A168AD0A54CC0.title: "&d{block.irons_spellbooks.alchemist_cauldron}"
	quest.2456FAEA2D8430DE.quest_desc: ["Sztabka stratusu łączy gravityt, zanit, ambrozję, skyjade i chromatyczną chmurę. Szablonem kowalskim ulepszysz nią narzędzia z gravitytu."]
	quest.246B854E14E11E69.quest_desc: ["Serce magazynu: łączy w jeden wszystkie stykające się skrzynie, beczki i szuflady. Przepis wymaga diamentu i perły Endera."]
	quest.2496D0A0AD764DEF.quest_desc: ["Podnosi żelazną skrzynię albo beczkę do złotej bez wyjmowania zawartości."]
	quest.24BF3CEF77D3E18F.quest_desc: ["Przetopiony demonit. Blok stali piekielnej stanie w rogach czwartego poziomu ołtarza."]
	quest.24E8693D28F639B3.quest_desc: ["Mały silnik odrzutowy, który pali przedmioty podane od tyłu. Redstone tylko go włącza i wyłącza, a kluczem otworzysz klapę, by brał paliwo z pojemnika za sobą."]
	quest.2531F54FBEAF72E7.quest_desc: ["Netherrack w klatce z arkusza żelaza. Pusty palnik czeka na lokatora: płomyka z fortecy Netheru."]
	quest.2536E4E3E70DC00D.quest_desc: ["Diamentowy kilof to kilof tej ery. Wykopie obsydian, a w Netherze &a{block.minecraft.ancient_debris}&r, choć netheryt przyda się dopiero w erze okultyzmu."]
	quest.2537778683EE14B8.quest_desc: ["Stacja rakietowa składa rakietę z bloków wokół siebie. Silniki muszą unieść jej wagę, a paliwo wystarczyć na start i lądowanie."]
	quest.2537778683EE14B8.quest_subtitle: "Kosmos, nieobowiązkowy"
	quest.2537778683EE14B8.title: "Rakieta"
	quest.253C930EB219FE08.quest_desc: ["Łąki, gaje i lasy niebokorzenia pokrywają większość wysp. Odwiedź wszystkie cztery."]
	quest.253C930EB219FE08.title: "Niebiańskie krainy"
	quest.2550DEF59C35F62D.quest_desc: ["Przelicza prąd TFMG na FE, a kluczem odwrócisz kierunek. Przyda się w erze elektryczności, gdy maszyny innych modów zaczną chcieć FE."]
	quest.255A7CF38560FEC5.quest_desc: [
		"Królowa przyjmuje dary i odwdzięcza się swoimi skarbami. Podaj jej przedmiot, którego pragnie, i dobij pierwszego targu."
		""
		"&7Jej życzenia prowadzą przez całą ścieżkę zadań. Kolejne pokaże ci sama gra.&r"
	]
	quest.255A7CF38560FEC5.title: "Handel z królową"
	quest.255E891A81367224.quest_desc: ["Zaawansowany układ nasycony diamentem albo złożony ze wzmocnionym stopem. Potrzebują go elitarne maszyny i pieczęć."]
	quest.255E891A81367224.quest_subtitle: "Kamień milowy · składnik pieczęci"
	quest.255E891A81367224.title: "&6{item.mekanism.elite_control_circuit}"
	quest.256AD9DDA355EE72.quest_desc: ["Deep Aether dodaje świecące lasy, mokradła pełne korzeni i złote gaje. Odwiedź wszystkie trzy."]
	quest.256AD9DDA355EE72.title: "Krainy Deep Aether"
	quest.25766DCD8399424B.quest_desc: ["Czerwone i niebieskie kryształy rosną w skupiskach. Gubią je też kryształowe ćmy."]
	quest.25766DCD8399424B.title: "Kryształy gwiezdnego światła"
	quest.25867B0BB2EE1A4A.quest_desc: ["Gwiazda Netheru oprawiona w stal obsydianową. Dwie pójdą do rytuału ostatniego poziomu kuźni."]
	quest.25AE29D7257C1471.quest_desc: ["Talizman żaru pozwala przejść przez ogień i pływać w lawie, a złoty talizman uspokaja pigliny, nawet brutale z bastionów. Do przepisów potrzebujesz materiałów z Netheru."]
	quest.25AE29D7257C1471.title: "Talizman Netheru"
	quest.25B68A79B76C1A6E.quest_desc: ["Pierścień i wisior zakładasz w sloty ozdób Aetheru. Przyspieszają kopanie, ale z czasem się zużywają."]
	quest.25B68A79B76C1A6E.title: "Zanitowe ozdoby"
	quest.25C9537871EC57AD.quest_desc: ["Opuszczona biblioteka magów, pełna półek i skrzyń. Rytuał lokalizacji wskaże ją, gdy jako dodatek położysz księgę maga."]
	quest.25C9537871EC57AD.title: "Tajemna biblioteka"
	quest.25DCE51A4AB9A318.quest_desc: ["Pompa żerdziowa postawiona nad złożem wypompowuje ropę naftową, dopóki napędzasz jej korbę. Układ części pokazuje Ponder (W)."]
	quest.25DCE51A4AB9A318.title: "Pompa żerdziowa"
	quest.25F4A771BFBB0972.quest_desc: ["Ołtarz zbudujesz w dowolnym kształcie, a na wierzchu stawiasz ikonę. Świece, czaszki nieumarłych i zioła w doniczkach zwiększają jego moc i pojemność."]
	quest.25F4A771BFBB0972.quest_subtitle: "Kamień milowy"
	quest.25F4A771BFBB0972.title: "&d{block.eidolon_repraised.wooden_altar}"
	quest.2609C52866399126.quest_desc: ["Szafa na przedmioty, które się nie układają w stosy: zbroje, narzędzia i księgi. Pomieści ich setki w jednym bloku."]
	quest.260B570DCA9E5020.quest_desc: [
		"Para do pracy przy skrzyniach. Pierwsze ulepszenie wykłada zawartość plecaka do skrzyni, a drugie uzupełnia plecak ze skrzyni."
		""
		"&7Kliknij skrzynię z plecakiem w ręce, gdy siedzi w nim jedno z tych ulepszeń.&r"
		""
		"&7Kolejny tier plecaków pojawi się tutaj, gdy twoja drużyna wejdzie w erę mosiądzu.&r"
	]
	quest.260B570DCA9E5020.title: "Rozładunek i dokładanie"
	quest.260EF6790AB0DD46.quest_desc: ["Kapłan na poziomie mistrza sprzedaje je za szmaragdy. Stół do zaklinania potrafi też nasycić butelkę miodu (Apothic Enchanting, wymagania pokaże JEI)."]
	quest.260EF6790AB0DD46.quest_subtitle: "Składnik pieczęci"
	quest.261335FB971DA14D.quest_desc: ["Ctrl+Z („{key.effortlessbuilding.undo.desc}”) cofa ostatnią operację i oddaje bloki, a Ctrl+Y („{key.effortlessbuilding.redo.desc}”) ją przywraca."]
	quest.261335FB971DA14D.title: "Cofnij i ponów"
	quest.261539431DEB222E.quest_desc: ["Przekaźnik nasycony esencją żywiołu mieści więcej źródła i przesyła je szybciej. Powietrzny przekaźnik osnowy nie traci źródła na dużych odległościach."]
	quest.261539431DEB222E.title: "Przekaźnik żywiołu"
	quest.2623D024969E7385.quest_desc: ["Portal do Aetheru to rama z jasnogłazu, zbudowana jak portal Netheru. Zamiast ją zapalać, wlej do środka wiadro wody."]
	quest.2623D024969E7385.title: "Rama portalu"
	quest.262E98621F8A1CE1.quest_desc: ["Lodowy Labirynt pokrywa głęboki zamarznięty ocean. Róg znajdziesz na zamarzniętych statkach pirackich, a zadęty przy wodzie w Labiryncie przywoła ducha kapitan Kornelii."]
	quest.262FFF670ED3B561.quest_desc: ["Kop żwir: co jakiś czas zamiast żwiru wypadnie krzemień. Żwir znajdziesz na plażach, w rzekach i w jaskiniach."]
	quest.262FFF670ED3B561.title: "Krzemień"
	quest.26412E182F0C2985.quest_desc: ["Kocioł na piecyku rozpuszcza przedmioty w sal amoniaku i wydobywa z nich siarkę alchemiczną. Każdy przedmiot daje własny rodzaj siarki."]
	quest.26463696FC5F0A44.quest_desc: ["Łożysko świdra z kołami do cięcia skał kruszy bloki wokół siebie, a urobek trafia do pojemnika na maszynie. Im więcej bloków tnie naraz, tym wolniej pracuje – pomoże kilka łożysk."]
	quest.26463696FC5F0A44.title: "Maszyna drążąca"
	quest.264D9A9FF745734F.quest_desc: [
		"Ufortyfikowana twierdza Dungeons and Taverns. Szykuj zbroję z netherytu."
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę arkanów.&r"
	]
	quest.264D9A9FF745734F.title: "Twierdza w Netherze"
	quest.2659E6310DEA48BF.quest_desc: ["Od razu przetapia wykopane rudy na sztabki. Zrobisz go z ognistych sztabek i płomiennych różdżek."]
	quest.2685C26F4B824914.quest_desc: [
		"Dzielikamienie tego samego koloru łączą się w osobną sieć. Każdy, kto stoi przy jednym z nich, przeniesie się do pozostałych."
		""
		"&7Kolor wybierasz barwnikiem w przepisie. Przykład w tym zadaniu jest czerwony.&r"
	]
	quest.2685C26F4B824914.title: "Dzielikamień"
	quest.269935BB659540D5.quest_desc: ["Daje sygnał redstone, gdy przejeżdża nad nim pociąg. Przyda się do otwierania bram, zapalania świateł i liczenia składów."]
	quest.269B4A0F6D104CD5.quest_desc: [
		"Mieści osiem rodzajów przedmiotów po kilka stosów. Gdy stoi w pobliżu, wyjmiesz z niej narzędzie klawiszem skrzynki, bez podchodzenia."
		""
		"&7Klawisz znajdziesz w ustawieniach sterowania, w kategorii Create.&r"
	]
	quest.269B4A0F6D104CD5.title: "Skrzynka na narzędzia"
	quest.26A12B7B06B01A8B.quest_desc: ["Łączy bloki zgodne z FE przewodami ze szpuli. Kliknij szpulą jedno złącze, potem drugie, a między nimi zawiśnie przewód do 16 bloków."]
	quest.26BBD5B2344AE9DD.quest_desc: [
		"Działko strzela seriami małych nabojów. Lufę, zamek i sprężynę odrzutu składasz na lawecie jak duże działo, a im dłuższa lufa, tym dalej sięga."
		""
		"&7Ponder (przytrzymaj W nad przedmiotem) pokaże cały proces.&r"
	]
	quest.26BBD5B2344AE9DD.quest_subtitle: "Kamień milowy"
	quest.26BBD5B2344AE9DD.title: "&6Działko automatyczne"
	quest.26FCFAC9F50EB8B8.quest_desc: ["Miej naraz 256 arkuszy plastiku. Benzyna ciężka z wieży musi sama trafiać do kadzi, a stopiony plastik do mis odlewniczych."]
	quest.26FCFAC9F50EB8B8.quest_subtitle: "Dowód automatyzacji"
	quest.26FCFAC9F50EB8B8.title: "Tłocznia plastiku"
	quest.2727899B40E6FCB5.quest_desc: [
		"Kowadło z witherytu, bloku redstone i kowadła. Łączy broń Cataclysmu z łupami bossów w mocniejsze wersje."
		"&7Przepisy fuzji pokaże JEI.&r"
	]
	quest.2727899B40E6FCB5.quest_subtitle: "Kamień milowy"
	quest.2727899B40E6FCB5.title: "&c{block.cataclysm.mechanical_fusion_anvil}"
	quest.27825E14F5EFD331.quest_desc: ["Kable z platyny i przekaźniki rozprowadzą FE od generatora do silników na całym statku."]
	quest.27825E14F5EFD331.title: "Kable pokładowe"
	quest.278324518B998706.quest_desc: ["Dno z cukrowej wody, wyjące konstrukcje i pszczele blokowiska. Odwiedź wszystkie trzy."]
	quest.278324518B998706.title: "Dalsze krainy ula"
	quest.2793B906977DEB56.quest_desc: ["Destylator na piecyku rozkłada przedmioty na odłamki rtęci: kamień, drewno, jedzenie, rudy. Rudy i klejnoty dają ich najwięcej."]
	quest.27A1799DC6990398.quest_desc: ["Szkoła perły Endu to teleportacja: odbijanie pocisków, wyjście z ciała na zwiad, zagubienie wroga w przestrzeni."]
	quest.27A1799DC6990398.title: "Zwój przemieszczenia"
	quest.27E16132574AA37D.quest_desc: [
		"&7Era atomu · zalecany łuk albo kusza, bloki i mikstury powolnego opadania&r"
		""
		"Portal do Endu leży w twierdzy pod ziemią. Zwykłe oko Endu go nie otworzy: ramę wypełniają oczy z End Remastered, rozrzucone po całym świecie."
	]
	quest.27E16132574AA37D.title: "Twierdza"
	quest.27E650F71B02D6DE.quest_desc: ["Zostawia je każdy pokonany &c{entity.minecraft.warden}&r. Użyj go na ramie w centrum starożytnego miasta, a otworzysz przejście do Otherside."]
	quest.27F81222D3A6025A.quest_desc: [
		"Wykonuje zaprogramowaną listę ruchów: obrót o zadany kąt, przerwę albo zmianę kierunku. Sygnał redstone uruchamia sekwencję, więc tak sterujesz bramą albo windą, która ma stanąć w konkretnym miejscu."
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę okultyzmu.&r"
	]
	quest.280585C62F8445F8.quest_desc: [
		"Andezyt nauczył cię kręcić wałami, a mosiądz nauczy maszyny myśleć. Aplikatory, ramiona i precyzyjne mechanizmy zrobią za ciebie to, co dotąd robiłeś rękami. Żar potrzebny do mosiądzu znajdziesz dopiero w Netherze: w płomiennym palniku zamkniesz żywego płomyka."
		""
		"Era kończy się bramą. Wymaga ona kamieni milowych z gałęzi tego rozdziału, dwóch różnych bossów tej ery i Pieczęci Ery Okultyzmu."
	]
	quest.280585C62F8445F8.quest_subtitle: "Precyzja i ogień Netheru"
	quest.280585C62F8445F8.title: "Era Mosiądzu"
	quest.281BEC79A64C38D4.quest_desc: ["Tawerna daje dach nad głową pierwszym mieszkańcom i przyciąga do kolonii wędrowców."]
	quest.281BEC79A64C38D4.title: "Tawerna"
	quest.28252955AB6B8194.quest_desc: ["Zaklęta wieżyczka rzuca zaklęcia za połowę źródła, które zużywa podstawowa. Ulepszysz ją w aparacie z podstawowej wieżyczki i płomiennej różdżki."]
	quest.2852B3A9FFBC1CBC.quest_desc: ["Pustynny pałac z kopułami i dziedzińcami. Skarbiec leży głęboko w środku."]
	quest.2852B3A9FFBC1CBC.title: "Pałac Shiraz"
	quest.2855F0FE224BA179.quest_desc: ["Rozdzielacz dzieli źródło na kilka celów, kolektor sam pobiera je z pobliskich słoików, a depozytor sam oddaje. Z nimi źródło z całej bazy trafi tam, gdzie go brakuje."]
	quest.2855F0FE224BA179.title: "Sieć przekaźników"
	quest.2868536622BA4FFD.quest_desc: ["Różdżka stawia cały rząd bloków naraz i przedłuża ścianę, na którą patrzysz. Bloki bierze z ekwipunku."]
	quest.287BFFDA5AC66887.quest_desc: [
		"Drewniane wieże połączone kładkami. Bandyci strzelają z góry, więc wchodź osłonięty."
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę mosiądzu.&r"
	]
	quest.287BFFDA5AC66887.title: "Wieże bandytów"
	quest.28B27DF06E429109.quest_desc: [
		"Zrobisz ją z pióra kruka, jagód pochodni i jasnopyłu. Gubią ją też tomy śmierci w Wieży Licza."
		""
		"&7Jasnopył zostawiają czarownice, zanim Nether stanie otworem.&r"
	]
	quest.28E3C603D54E2B74.quest_desc: ["Wykopiesz go z rudy w błocie i kamieniu. Zostawiają go też stranghoule."]
	quest.28E41894AEB979A9.quest_desc: ["Na desce nożem pokroisz składniki i dostaniesz z nich więcej."]
	quest.28E71E107FD72750.quest_desc: [
		"Duch Occultism zamknięty w słoju przechowawczym Ars dalej pracuje i nie słabnie z czasem. Foliot kruszący w słoju sam zbiera rudy z okolicy 7×7, a sprzątacz wkłada podniesione przedmioty do pojemnika obok."
		""
		"&7Ars Ocultas dodaje też przemianę srebra w złoto w komorze nasycania i drugi przepis na klejnot dostrojony.&r"
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę arkanów.&r"
	]
	quest.28E71E107FD72750.title: "Duch w słoju"
	quest.28F01DF08603843D.quest_desc: [
		"Koło zębate oddaje obrót kołom, które go dotykają, a każde kolejne kręci się w przeciwną stronę. Połącz duże koło z małym pod kątem prostym: małe kręci się dwa razy szybciej od dużego."
		""
		"&7Zadanie zalicza osiągnięcie Create za zmianę przełożenia.&r"
	]
	quest.28F01DF08603843D.title: "Zmiana biegów"
	quest.290774B0AEFAB021.quest_desc: ["Szkoła uczy dzieci kolonii, zanim dorosną i pójdą do pracy."]
	quest.290DB10E94EF7B78.quest_desc: [
		"Tryb zamiany podmienia bloki na ten, który trzymasz w drugiej ręce. Przyda się, gdy zmieniasz materiał gotowej ściany."
		""
		"&7Przepis wymaga sculku, a zakładasz go z perłą Endera.&r"
	]
	quest.29155B47A363AFE4.quest_desc: [
		"Kolonia zaczyna się od obozu albo statku zaopatrzeniowego. Zrób jeden z nich i postaw prawym przyciskiem: obóz na lądzie, statek na wodzie. W skrzyni czekają zapasy na start."
		"&7Kolonię założysz od ery andezytu. Jedna drużyna ma jedną kolonię.&r"
	]
	quest.29155B47A363AFE4.title: "Obóz zaopatrzeniowy"
	quest.291AED15AEC1A1DF.quest_desc: ["Runy ofiary, samoofiary, szybkości, pojemności i inne zastępują puste runy. Każda wzmacnia ołtarz w inny sposób."]
	quest.291AED15AEC1A1DF.title: "Runa ulepszeń"
	quest.2921C903D0EDCF42.quest_desc: [
		"&7Era arkanów. Zalecany ekwipunek: pełna zbroja netherytowa i dużo miejsca do uników.&r"
		"Starożytny władca śpi w grobowcu piramidy. Obudzisz go naszyjnikiem pustyni użytym na przeklętym nagrobku."
	]
	quest.2921C903D0EDCF42.quest_subtitle: "Boss"
	quest.2921C903D0EDCF42.title: "&c{entity.cataclysm.ancient_remnant}"
	quest.2947E65344724C83.quest_desc: [
		"Gdy stracisz całe zdrowie, nie giniesz od razu: przez minutę leżysz i się wykrwawiasz. Potwory wtedy cię nie atakują."
		"Inny gracz może cię podnieść: niech podejdzie, kliknie cię prawym przyciskiem i zostanie przy tobie kilka sekund. Gdy nikt nie zdąży, giniesz."
	]
	quest.2947E65344724C83.title: "Wykrwawienie"
	quest.295CE1D4F14CC6C6.quest_desc: ["Lekki kostur ze złota, ametystu i karmazynowego drewna. Wzmacnia zaklęcia mocniej niż kostur siwobrodego."]
	quest.2964AB534BFA8134.quest_desc: ["Najazdy rosną razem z kolonią. Koszary z wieżami trzymają stały garnizon strażników."]
	quest.2964AB534BFA8134.title: "Koszary"
	quest.296BB3AFEB41DF5B.quest_desc: ["Daje sygnał redstone, gdy w QIO jest więcej wybranego przedmiotu niż ustalona liczba."]
	quest.296CDA49675D2D41.quest_desc: ["Podepnij gadżet do punktu dostępu w menu gadżetu („{buildinggadgets2.radialmenu.bind}”). Gadżet weźmie bloki z sieci ME zamiast z ekwipunku."]
	quest.296CDA49675D2D41.title: "Gadżety w sieci ME"
	quest.296D75B8F62CEBBF.quest_desc: ["Palnik grzeje tygiel jak płomienny palnik, ale pali płynne paliwo. Zaworem ustawisz, jak szybko je spala."]
	quest.296DD18BE37142AB.quest_desc: [
		"Kamieniarz robi przedmioty z kamienia, o które proszą budowniczy i inni pracownicy."
		""
		"&7Kolejny tier budynków pojawi się tutaj, gdy twoja drużyna wejdzie w erę run.&r"
	]
	quest.296DD18BE37142AB.title: "Kamieniarz"
	quest.29731F660D3DA782.quest_desc: ["Klucz z Lodowego Labiryntu. Otwiera zamarznięte skrzynie."]
	quest.297949C483DAFAE8.quest_desc: ["&a{item.twilightforest.liveroot}&r wykopiesz z korzeni pod ziemią Lasu Zmierzchu. Z rudą żelaza i złotą bryłką da &a{item.twilightforest.raw_ironwood}&r, który przetopisz w piecu."]
	quest.299C53C73D07D349.quest_desc: ["Ulepszone piekielne i morskie półki pozwalają zaklinać na poziomie 60. Zaczaruj coś na tym poziomie."]
	quest.299C53C73D07D349.title: "Zaklinanie na poziomie 60"
	quest.299D1E3EB5420A9A.quest_desc: [
		"&7Era okultyzmu · zalecane: netherytowa zbroja&r"
		"Ogromna rękawica strzeże swojej areny w Netherze."
	]
	quest.299D1E3EB5420A9A.quest_subtitle: "Boss"
	quest.299D1E3EB5420A9A.title: "&c{entity.bosses_of_mass_destruction.gauntlet}"
	quest.29A1B4F506EED9AC.quest_desc: ["Rozbij go, a wypadnie to, co w nim zastygło: pył dusz albo kości sculku."]
	quest.29A5035F491CB927.quest_desc: ["Zbuduj formę z kamiennych cegieł i stosu czaszek według Czarnej Księgi Goety, a potem kliknij środkowy stos czaszek rdzeniem animacji. Golem tłucze ziemię i strzela nawiedzonymi czaszkami."]
	quest.29A5035F491CB927.title: "Golem grobowy"
	quest.29A8547E8CD8E816.quest_desc: ["W erze arkanów budynki magiczne kolonii rosną do poziomu 5. Rozbuduj mistyczne miejsce na najwyższy poziom."]
	quest.29A8547E8CD8E816.title: "Mistyczne miejsce na poziomie 5"
	quest.29DF56775F64B9B7.quest_desc: ["Wkłada przedmioty do bloku, na którym wisi, albo z niego wyjmuje. Działa z taśmami, składnicami i każdym pojemnikiem."]
	quest.29E3E195EC322300.quest_desc: [
		"Po śmierci twój ekwipunek zostaje w zwłokach tam, gdzie zginąłeś. Kliknij je, żeby go odebrać. Zwłoki nie znikają i nie spłoną w lawie."
		""
		"&7Gdy zginiesz w pustce, zwłoki trafią na ostatni pewny grunt, a czat poda ci, gdzie leżą.&r"
	]
	quest.29E3E195EC322300.title: "Zwłoki"
	quest.29FA9B52AECFE9B0.quest_desc: ["Maska mieszkańców głębi. Gubią ją też sami mieszkańcy."]
	quest.2A1448693DAA1057.quest_desc: [
		"Płyta słoneczna grzeje za dnia, rury cieplne rozprowadzają ciepło, a silnik Stirlinga zamienia je w powolne obroty."
		""
		"&cPrzegrzany blok zamienia się w lawę.&r"
	]
	quest.2A1448693DAA1057.title: "Ciepło"
	quest.2A31EA82944F11B9.quest_desc: ["Okno całego magazynu QIO z siatką rzemiosła. Postaw go gdziekolwiek w bazie, na tej samej częstotliwości."]
	quest.2A4BADAE1174CE6C.quest_desc: ["Wixie w kociołku sam wytwarza wybrany przedmiot ze składników z pobliskich skrzyń, płacąc za to źródłem. Odłamki zdobędziesz, rzucając rozproszenie na osłabioną wiedźmę."]
	quest.2AA19AFB961ECB40.quest_desc: ["Oczyszczony kamień dusz wrzucony do studni staje się pustą płytą, popiół klątwy solami pustki, a błyskotliwość fragmentem pamięci. Z nich powstaje cała magia pustki."]
	quest.2AA19AFB961ECB40.title: "Dary pustki"
	quest.2AAE7CE5C05336FE.quest_desc: ["Rozciera katalizatory na proszek, dwa razy wydajniej niż młotek."]
	quest.2AB33C998F600675.quest_desc: ["Połóż notatki na stole i wykonaj każdy krok, o który prosi badanie. Ukończone badanie odsłania nową wiedzę w kodeksie."]
	quest.2AC141506FCAD20B.quest_desc: ["Ułóż ramę z kamiennych cegieł jak portal do Netheru i użyj na niej katalizatora. Brama otworzy się do Undergarden."]
	quest.2ACD88810219671D.quest_desc: ["Steam 'n' Rails dodaje tory wąskie, szerokie i jednoszynowe, a do nich własne wózki. Powstają w montażu sekwencyjnym, tak jak zwykłe tory."]
	quest.2ACD88810219671D.title: "Inne rozstawy"
	quest.2AD8211BB7320D0C.quest_desc: ["Przenośny silnik spala paliwo i daje obrót prosto na pokładzie, w obie strony do wyboru. Śmigła i wciągarki nie potrzebują już wału z ziemi."]
	quest.2AEDE412A25C4EB7.quest_desc: ["Lazuryt wykopiesz miedzianym kilofem. Dziewięć sztuk daje blok."]
	quest.2AEDE412A25C4EB7.quest_subtitle: "Składnik pieczęci"
	quest.2B02ECB0F12D0560.quest_desc: ["Trzyma jeden stos pod prasą, wylewką albo ramieniem. Przedmioty z taśmy zatrzymają się na nim do obróbki."]
	quest.2B08D966141A354F.quest_desc: ["Prześpisz w nim noc z dala od domu, a punkt odrodzenia zostanie tam, gdzie był. Zrobisz go ze skóry i białej wełny."]
	quest.2B1F5F8C52550DC4.quest_desc: ["Daje sygnał redstone, gdy w pojemniku albo na taśmie przed nim pojawi się wybrany przedmiot."]
	quest.2B368425699A9796.quest_desc: ["Walkirie w srebrnym lochu zostawiają medale zwycięstwa. {entity.aether.valkyrie_queen} stanie do walki dopiero, gdy pokażesz jej dziesięć."]
	quest.2BAE9BE5A39B15E4.quest_desc: ["Kliknij płomyka pustym palnikiem, a zamkniesz go w środku. Palnik grzeje tygiel od dołu: bez niego mikser nie zrobi mosiądzu. Spala wszystko, co pali się w piecu."]
	quest.2BAE9BE5A39B15E4.quest_subtitle: "Kamień milowy"
	quest.2BAE9BE5A39B15E4.title: "&6{block.create.blaze_burner}"
	quest.2BC065FB42C81822.quest_desc: ["Zraszacz ze Slice and Dice postawiony pod rurą rozpryskuje płyn na pole. Woda nawilża ziemię, a płynny nawóz z miksera przyspiesza wzrost upraw."]
	quest.2BC065FB42C81822.title: "Zraszacz"
	quest.2BC8BAE4708F569F.quest_desc: [
		"Łączy w jedną sieć skrzynie, które go dotykają, a także skrzynie stykające się z nimi. Terminal postawiony obok pokaże ich całą zawartość."
		""
		"&7Kable, którymi sięgniesz do dalszych skrzyń, przyjdą w erze mosiądzu.&r"
	]
	quest.2BD62E4216762D28.quest_desc: ["Zaklęty gravityt to materiał na najlepsze narzędzia i zbroję, jakie wykujesz w Aetherze."]
	quest.2BD989936ADA12DA.quest_desc: ["Siedemdziesięciu pięciu mieszkańców to już miasto. Kolonia sama się wyżywi, obroni i rozbuduje."]
	quest.2BD989936ADA12DA.quest_subtitle: "Kamień milowy"
	quest.2BD989936ADA12DA.title: "&375 mieszkańców"
	quest.2BE836079DA8F338.quest_desc: ["Dźwignia przepustnicy ustawia siłę sygnału przeciągnięciem. Dalekopis przypisuje częstotliwości nadajników do klawiszy, więc statkiem sterujesz z klawiatury."]
	quest.2BE836079DA8F338.title: "Mostek kapitański"
	quest.2BF04F18AE1496EB.quest_desc: ["Szmaragd dostrojony jak diament: przechowuje manę, a zaklęcia same po nią sięgają. Prawy przycisk z klejnotem w ręce oddaje mu manę."]
	quest.2BF8F92CB6FDBD34.quest_desc: ["Forma z diamentowych bloków formy i kamiennych cegieł; środkowy blok redstone klikasz rdzeniem animacji. Golem jest silniejszy od żelaznego, a naprawisz go pyłem redstone."]
	quest.2BF8F92CB6FDBD34.title: "Golem z czerwienitu"
	quest.2BFB307063CD3DFE.quest_desc: ["Ta sama pojemność co skrzynia, ale w pełnym bloku. Beczki postawisz jedna na drugiej i otworzysz każdą z osobna."]
	quest.2C00291F2DF8854E.quest_desc: ["Okręt illagerów na pełnym morzu. Podpłyń łodzią i wejdź na pokład."]
	quest.2C00291F2DF8854E.title: "Korsarz illagerów"
	quest.2C0927F294DFDB57.quest_desc: [
		"Gdy kolonia rośnie, nocą zaczynają ją nachodzić najeźdźcy: barbarzyńcy, piraci, mumie, nordowie albo amazonki, zależnie od okolicy. Im więcej mieszkańców, tym większy najazd, najwyżej 40 napastników."
		"&7Strażnicy bronią kolonii sami, ale potrzebują wież, broni i zbroi.&r"
	]
	quest.2C0927F294DFDB57.title: "Najazdy"
	quest.2C15790615B51709.quest_desc: ["Komórka MEGA na płyny, w obudowie z brązu nieba. Zmieści paliwo i chłodziwo całego reaktora."]
	quest.2C1CBA8FBE594500.quest_desc: ["Pełna szuflada niszczy nadmiar zamiast go odrzucać. Linia produkcyjna nie zatka się przez jeden przepełniony przedmiot."]
	quest.2C24ECBBD2B0EA93.quest_desc: ["Dziwna budowla Incendium w deltach i na toksycznej hałdzie. Uważaj, co uruchamiasz."]
	quest.2C24ECBBD2B0EA93.title: "Reaktor Netheru"
	quest.2C259674F3EC76FD.quest_desc: ["Pierwszy kostur maga. Trzymany w ręce dodaje mocy zaklęciom i many, a rzucasz z niego zaklęcia z księgi."]
	quest.2C3B730B14D0B5F4.quest_desc: ["Zasilony sygnałem redstone tworzy ogromne obciążenie i zatrzymuje całą sieć. To awaryjny wyłącznik dla linii bez sprzęgła."]
	quest.2C5D76D2F03E010A.quest_desc: ["Szarą kredę barwi szara pasta z rytuału djinna, a pomarańczową przeklęty miód z opętanej pszczoły, świecące jagody i pył płomienny. Z limonkową i białą narysujesz krąg dzikiego afrita."]
	quest.2C5D76D2F03E010A.title: "Kredy dzikiego afrita"
	quest.2C68A602930B48B0.quest_desc: ["Robaki kodoku pochłaniają esencję stworów, które dużo zabijały. Spalone blisko linii mocy ładują obwody many, a pod kręgiem wróżenia napędzają magię sympatyczną."]
	quest.2C73C77BEC4833AF.quest_desc: ["Zostawia je &a{entity.deeperdarker.sludge}&r z Otherside. Płytką z resonarium ulepszysz diamentowy sprzęt na stole kowalskim."]
	quest.2C7D10F28D9801A9.quest_desc: ["Kruki przesiadują na ziemi w lesie i odlatują, gdy podejdziesz. Zostawiają pióra."]
	quest.2C8D0FB62F8121E4.quest_desc: ["Surowy amaramber znajdziesz przy ogniskach w lasach torreyi. Z łupkiem da sztabki."]
	quest.2C8D0FB62F8121E4.title: "Amaramber"
	quest.2C9AC13E2C8830DD.quest_desc: [
		"&7Era pary i stali. Zalecany ekwipunek: pełna zbroja netherytowa i łuk.&r"
		"Królowa Śniegu rządzi pałacem zorzy na lodowcu Lasu Zmierzchu. Drogę na lodowiec otwiera pokonanie Alfa yeti."
	]
	quest.2C9AC13E2C8830DD.quest_subtitle: "Boss"
	quest.2C9AC13E2C8830DD.title: "&c{entity.twilightforest.snow_queen}"
	quest.2CBA2AB760AB478A.quest_desc: ["Tak samo jak andezytową, tylko sztabką miedzi na ociosanym drewnie. To obudowa maszyn do płynów."]
	quest.2CBA9CA8E088530B.quest_desc: ["Znak technomancji z aparatu zaklinającego ulepsza szaty maga Ars do szat technomanty, z dodatkiem netherytu i mosiądzu."]
	quest.2CD4C3892F51E589.quest_desc: [
		"Podnosi ocenę materiałów, a lepiej oceniony materiał daje mocniejsze części. Katalizatorem jest świetlisty pył; mocniejsze katalizatory podnoszą ocenę wyżej."
		""
		"&7Kolejny tier narzędzi pojawi się tutaj, gdy twoja drużyna wejdzie w erę atomu.&r"
	]
	quest.2CD4C3892F51E589.title: "Sortownik materiałów"
	quest.2CDB41D811879C85.quest_desc: ["Zamienia blok złoża w dwa pyły, więc złoże daje dwa razy więcej metalu niż w piecu. To pierwszy stopień przerobu rud w Mekanismie."]
	quest.2CDB41D811879C85.quest_subtitle: "Kamień milowy"
	quest.2CDB41D811879C85.title: "&6{block.mekanism.enrichment_chamber}"
	quest.2CE6E79CED2CF719.quest_desc: ["Rytuał rani stworzenia wokół i oddaje ich krew pobliskiemu ołtarzowi. Farma potworów pod studnią napełni ołtarz bez twoich żył."]
	quest.2CE6E79CED2CF719.title: "Studnia cierpienia"
	quest.2CE70B2D032B5BC9.quest_desc: ["Kuźnia w Eternal Starlight, której pilnuje golem gwiazd. Strzela laserem i szarżuje."]
	quest.2CE70B2D032B5BC9.title: "Kuźnia Golemów"
	quest.2CEC560B19A80EEB.quest_desc: ["Blok tworzy w wodzie albo w lawie prąd, który unosi stworzenia do góry; kucnięcie pozwala zejść. Kilka bloków jeden na drugim to winda."]
	quest.2CEC560B19A80EEB.title: "Prąd wznoszący"
	quest.2CFF63705ACC187A.quest_desc: ["Port dostępu przedłuża pojemnik: lejek przy porcie sięga do skrzyni, jakby stał tuż przy niej. Mostek łączy dwa pojemniki w jeden dla maszyn podpiętych do mostka, a filtry decydują, co trafia na którą stronę."]
	quest.2CFF63705ACC187A.title: "Porty i mostki ekwipunku"
	quest.2D0756D3B8F8F255.quest_desc: [
		"Najprostsze źródło obrotu: kręcisz sam, a kręcenie zużywa głód. Wał przeniesie obrót w linii prostej, a koło zębate odda go kołom obok."
		""
		"&7Wskazówka: przytrzymaj W nad maszyną, a Ponder pokaże, jak działa.&r"
	]
	quest.2D093665DFE1A607.quest_desc: [
		"Szlifuje to, co na niej leży: poleruje jak papier ścierny i zdziera śniedź z miedzianych bloków. Taśmę ścierną zrobisz z papieru ściernego."
		""
		"&cRani też każdego, kto na niej stanie.&r"
	]
	quest.2D16A038D380644A.quest_desc: ["Napełnij słoik do pełna, czyli 10 000 źródła, i popatrz na niego przez chwilę. Pieczęć Ery Mosiądzu zużyje połowę tego."]
	quest.2D16A038D380644A.quest_subtitle: "Kamień milowy"
	quest.2D16A038D380644A.title: "&dPełny słoik źródła"
	quest.2D39FB7DFBE2104D.quest_desc: ["Rytuał opętania na pentaklu z żółtej kredy zwabia endermita, w którego wstępuje duch. Taki endermit zostawia kamień Endu, potrzebny do fioletowej kredy, bez wyprawy do Endu."]
	quest.2D39FB7DFBE2104D.title: "Opętany endermit"
	quest.2D3D52F2B87F2530.quest_desc: ["Postaw netherytową skrzynię albo podnieś poziom diamentowej i przyjrzyj się jej przez chwilę. Najwięcej miejsca i gniazd ze wszystkich skrzyń."]
	quest.2D3D52F2B87F2530.quest_subtitle: "Kamień milowy"
	quest.2D3D52F2B87F2530.title: "&bNetherytowa skrzynia"
	quest.2D43CAFA371E62C2.quest_desc: ["Leży w skrzyniach posterunków złosadników. Na kuźni o połowę zmniejsza liczbę dusz potrzebnych do rytuału."]
	quest.2D5DB1A8CB01B63C.quest_desc: [
		"Łączy szuflady w jeden magazyn: kliknięcie kontrolera wkłada przedmiot do szuflady, w której już taki leży. Rury i lejki podpięte do kontrolera widzą wszystkie szuflady."
		""
		"&7Przepis wymaga bloku kwarcu z Netheru.&r"
	]
	quest.2D5DB1A8CB01B63C.quest_subtitle: "Kamień milowy"
	quest.2D5DB1A8CB01B63C.title: "&bKontroler szuflad"
	quest.2D740FB6E14D841B.quest_desc: ["Inkantacja przemienia inkrustację w symbol: złotą w święty, cynową w bezbożny. Symbol to znak twojej ścieżki i część broni rytualnych."]
	quest.2D740FB6E14D841B.title: "Symbol patrona"
	quest.2D78605463F7CB95.quest_desc: [
		"Crafts \\& Additions i New Age zamieniają obroty Create w energię FE i z powrotem. Oba mówią tym samym językiem, więc alternator zasili silnik New Age, a cewka – akumulator Crafts \\& Additions."
		""
		"&7Pierwszy prąd i główną linię znajdziesz w rozdziale Ery Elektryczności. Ta strona ją rozszerza.&r"
	]
	quest.2D78605463F7CB95.title: "Dwa mody, jeden prąd"
	quest.2D80529BDE326269.quest_desc: ["Do wrzącego kotła wrzucasz składniki efektów i dodatków, a potem napełniasz butelkę. Z każdym warzeniem rośnie twoja wprawa i z jednej porcji napełnisz więcej butelek."]
	quest.2D8918AB6C3B8F6E.quest_desc: ["Rakieta potrzebuje tytanu. Przepis na Ziemi pokaże JEI, a na Księżycu i Marsie leżą jego złoża."]
	quest.2D8918AB6C3B8F6E.quest_subtitle: "Kosmos, nieobowiązkowy"
	quest.2D913E0C9EA47821.quest_desc: ["Wirówka izotopowa robi z odpadów pluton, a komora reakcji ciśnieniowych zamyka go w kulce. Pluton trafi do obudowy SPS."]
	quest.2DB6774A487237CC.quest_desc: ["Nadajnik wyświetlacza czyta dane z bloku, np. zawartość skrzyni albo prędkość wału, i pokazuje je na lampach Nixie, tablicy albo tabliczce. Najpierw kliknij nim źródło, potem postaw go przy wyświetlaczu."]
	quest.2DB6774A487237CC.quest_subtitle: "Kamień milowy"
	quest.2DB6774A487237CC.title: "&6Wyświetlacze"
	quest.2DBDE26CE7155469.quest_desc: ["Leży w podejrzanym piasku piramidy: odkop go pędzlem. Użyj naszyjnika na przeklętym nagrobku w grobowcu, a obudzisz Pozostałość."]
	quest.2DC73F37C0DDE250.quest_desc: ["Podstawa z drewna dusz odprawia spaczone wersje obrzędów, które działają inaczej niż zwykłe."]
	quest.2DCBC72C3F944226.quest_desc: ["Tnij wysoką trawę krzemiennym nożem, a dostaniesz włókno."]
	quest.2DCBC72C3F944226.title: "Włókno roślinne"
	quest.2DE9D74BD0C6DF02.quest_desc: ["Z animą licza. Postawiony nie pozwala potworom pojawiać się w promieniu 64 bloków."]
	quest.2DEC390F8A2D2C67.quest_desc: ["W terminalu kodowania zapiszesz przepis na pustym wzorze: rzemieślniczy dla asemblera albo przetwórczy dla dowolnej maszyny."]
	quest.2DEC390F8A2D2C67.title: "Wzory"
	quest.2E0363E27CEE1AD6.quest_desc: ["Wyprodukuj ponad 1000 torów kolejowych na tej samej mechanicznej prasie. Taka linia montażowa wystarczy na sieć łączącą bazy całej drużyny."]
	quest.2E0363E27CEE1AD6.quest_subtitle: "Dowód automatyzacji"
	quest.2E0363E27CEE1AD6.title: "Fabryka torów"
	quest.2E080B8EFB7EC2D8.quest_desc: ["Leży w skarbcu pozostałości bastionu w Netherze."]
	quest.2E1E016F9CBF0947.quest_desc: ["Płomienny palnik z kowadłem. Łączy dwa takie same przedmioty, nakłada szablony zaklęć i zdejmuje zaklęcia z przedmiotów."]
	quest.2E1E702E3BD75038.quest_desc: ["Silnik elektryczny w łożysku: obraca przyczepione bloki o zadany kąt i staje. Przyda się przy bramach i ruchomych mostach."]
	quest.2E263735BD640A91.quest_desc: ["Płonący berserkerzy gubią dogasający żar, a z żaru zrobisz popioły. Połóż je na ołtarzu ognia, żeby obudzić Ignisa."]
	quest.2E3B395333FA06C5.quest_desc: ["Użyj ich na czymś ciekawym, a rozpoczniesz badanie i dostaniesz notatki. Pergamin i magiczny atrament do nich uwarzysz w tyglu."]
	quest.2E3DD95B3CF7A241.quest_desc: ["Włóż do zestawu materiał, a potem połącz go z uszkodzonym narzędziem w siatce. Narzędzie Silent Gear się nie niszczy: zepsute czeka na naprawę."]
	quest.2E42D46E6C4A2EB5.quest_desc: ["Piła zwrócona ostrzem w górę tnie przedmioty z taśmy albo składnicy: pnie na deski, a kamień na schody i płyty, jak przecinarka. Wzór wybierzesz filtrem na pile."]
	quest.2E42D46E6C4A2EB5.title: "Tartak"
	quest.2E4D9B3AC027BCB9.quest_desc: ["Najwyższy poziom pojemności. Diamentowe ulepszenie podniesiesz na stole kowalskim szablonem ulepszenia netherytowego i sztabką netherytu."]
	quest.2E59B8AC37A168E2.quest_desc: [
		"&7Era okultyzmu · zalecane: netherytowa zbroja, ognioodporność&r"
		"Echo pierwszego władcy ognia wciąż krąży po cytadeli. Przywoła je &c{item.irons_spellbooks.cinderous_soulcaller}&r użyty w cytadeli."
	]
	quest.2E59B8AC37A168E2.quest_subtitle: "Boss"
	quest.2E59B8AC37A168E2.title: "&c{entity.irons_spellbooks.fire_boss}"
	quest.2E74B463A57CBAE6.quest_desc: ["Rytuał z magnetytem, woskiem, gliną, szlamem i żelazem. Modyfikator magnetyczny przyciąga do ciebie wykopane przedmioty."]
	quest.2E982F6A17705DB1.quest_desc: ["Łączy trzy składniki w jeden przedmiot. Tak zrobisz karmę dla moa, która daje mu nowe zdolności, i antidotum."]
	quest.2EC87D5062CBEECD.quest_desc: ["Woda płucze brudną zawiesinę na czystą. Doprowadź ją rurą mechaniczną albo pompą elektryczną."]
	quest.2ED9B7D942B426FB.quest_desc: ["Nowi mieszkańcy przychodzą, gdy mają gdzie mieszkać. Pięciu to pierwsza prawdziwa załoga."]
	quest.2ED9B7D942B426FB.title: "Pięciu mieszkańców"
	quest.2EE263B74754DEEF.quest_desc: ["Pas unosi cię nad ziemię: kucnij w powietrzu po skoku albo w czasie spadania. Zmniejsza też trochę obrażenia od upadku."]
	quest.2EE9355E7B276F19.quest_desc: ["Zbierzesz ją ze stosów pyłku. Rzucona zapyla to, w co trafi."]
	quest.2F10A5DFDAA42B80.quest_desc: ["Złocone błyskotki z uświęconego złota i zdobione ze stali dusz to bazy mocniejszych pierścieni i naszyjników. Zrobisz je w siatce rzemiosła ze skórą albo nicią."]
	quest.2F10A5DFDAA42B80.title: "Pierwsza błyskotka"
	quest.2F1140F53A5D0918.quest_desc: ["Druga księga Ars Nouveau mieści więcej zaklęć i glify drugiego poziomu. Przepis wymaga Netheru: płomiennej różdżki i bloku kwarcu."]
	quest.2F1B32CB8BC23435.quest_desc: ["Kliknij nim postawioną złotą skrzynię, beczkę albo skrzynię shulkera, a stanie się diamentowa razem z całą zawartością."]
	quest.2F55A92371BC96A8.quest_desc: [
		"Narzędzia jubilerskie zrobią obrączkę i oprawę na klejnot. Pierścień nosisz w slocie biżuterii, a jego cechy zależą od materiałów."
		""
		"&7Kolejny tier narzędzi pojawi się tutaj, gdy twoja drużyna wejdzie w erę mosiądzu.&r"
	]
	quest.2F55A92371BC96A8.title: "Biżuteria"
	quest.2F5E2B7C6B0B7CF7.quest_desc: [
		"Pusty kamień runiczny i fokus szkoły dają runę. Mróz to zamarznięta kość ze stray'a, grom to piorun w butelce, świętość to niebiańska perła, End to perła Endu, ewokacja to szmaragd, a natura to trujący ziemniak."
		""
		"&7Puste kamienie runiczne trafiają się w skrzyniach budowli. Piorun złapiesz pustą butelką z naładowanego creepera.&r"
	]
	quest.2F5E2B7C6B0B7CF7.title: "Runa szkoły"
	quest.2F68DCBD341A3C9C.quest_desc: ["Taśmociąg zrobisz z suszonych wodorostów. Kliknij nim jeden wał, potem drugi: taśma połączy je i zacznie wozić przedmioty między maszynami."]
	quest.2F68DCBD341A3C9C.quest_subtitle: "Kamień milowy"
	quest.2F68DCBD341A3C9C.title: "&6Taśmociąg"
	quest.2F8AD5BA90EE9B0E.quest_desc: ["Zapisuje skopiowane budowle na szablonach. Możesz je przechować albo przekazać drużynie."]
	quest.2F8B0B83AB769D57.quest_desc: ["Wypada z pni złotego dębu, gdy je zetniesz albo ociosasz. Pójdzie na złote strzałki i karmę dla moa."]
	quest.2FD92BE711652DD7.quest_desc: ["Piec kalcynacyjny na piecyku wypala przedmioty na sole alchemiczne. Sól to drugi filar alchemii."]
	quest.30120A4BCEB66FA2.quest_desc: [
		"Połóż diament na pustym ołtarzu: pobierze krew od stojących obok i za 2000 esencji zrobi kulę. Kula łączy cię z animą, niewidzialnym zbiornikiem esencji."
		""
		"&7Prawy przycisk z kulą w ręce oddaje jedno serce za 200 esencji.&r"
	]
	quest.304588F29DCA0962.quest_desc: ["Pokazuje w jednym oknie zawartość podłączonych skrzyń: wyjmiesz z nich wszystko i wytworzysz z siatki rzemiosła. Skrzynię podłączysz różdżką dominium: kliknij nią skrzynię, a potem pulpit."]
	quest.304588F29DCA0962.quest_subtitle: "Kamień milowy"
	quest.304588F29DCA0962.title: "&b{block.ars_nouveau.storage_lectern}"
	quest.30460420DB4243CE.quest_desc: ["Bank many na całą bazę. &d{item.mahoutsukai.hammer}&r zostaje w siatce po rozbiciu klejnotu, więc wzór AE2 rozetrze szmaragdy za ciebie."]
	quest.30460420DB4243CE.quest_subtitle: "Dowód automatyzacji"
	quest.3046CAD370B59977.quest_desc: [
		"Kadź to maszyna z nasadkami. Mieszalnik przemysłowy z łopatką zamienia ją w mieszalnik, a elektrody w elektrolizer albo piec łukowy. Część receptur wymaga grzania od dołu."
		""
		"&7Budowę kadzi pokazuje Ponder (W).&r"
	]
	quest.3046CAD370B59977.quest_subtitle: "Kamień milowy"
	quest.3046CAD370B59977.title: "&6Kadź chemiczna"
	quest.305D66011DB67B70.quest_desc: ["Starożytne miasta leżą w mrocznych głębinach, pod łupkiem. Skradaj się: gdy wyjce sculku usłyszą cię zbyt często, z ziemi wyłoni się &c{entity.minecraft.warden}&r."]
	quest.305D66011DB67B70.title: "Starożytne miasto"
	quest.3078D963AD1D07CD.quest_desc: ["Podstawa prawie każdego ulepszenia skrzyni. Zrobisz ją z desek i sztabki żelaza."]
	quest.30A0FA9A0678057E.quest_desc: ["Księga Eidolonu opisuje rytuały, inkantacje i alchemię tygla. Zrobisz ją z książki i zgniłego mięsa."]
	quest.30D627B6B005B82A.quest_desc: ["Słaby odłamek krwi na ołtarzu trzeciego poziomu. Kula Magusa otwiera najsilniejsze odczynniki i olejki."]
	quest.30D627B6B005B82A.quest_subtitle: "Kamień milowy"
	quest.30D627B6B005B82A.title: "&d{item.neovitae.blood_orb_master}"
	quest.30E37DD3E140A94C.quest_desc: ["Wykopiesz je ze świętokamienia. Zjedzone leczą, a w ołtarzu służą za paliwo."]
	quest.30F4963AED57C58E.quest_desc: [
		"Wskazuje najbliższy biom, który wybierzesz z listy. Zrobisz go z kompasu, sadzonki i pnia."
		""
		"&7Kliknij nim prawym przyciskiem, wybierz biom i idź za igłą.&r"
	]
	quest.30F4963AED57C58E.quest_subtitle: "Kamień milowy"
	quest.30F4963AED57C58E.title: "&a{item.naturescompass.naturescompass}"
	quest.30F889B304D23008.quest_desc: ["Mieszkańcy potrzebują dachu nad głową. Każdy poziom domu mieści jednego mieszkańca więcej, a dzieci rodzą się tylko wtedy, gdy jest wolne łóżko."]
	quest.30F889B304D23008.title: "Pierwszy dom"
	quest.3111889E8390FD7D.quest_desc: [
		"Wzmocnienie, obszar i wydłużenie czasu zmieniają działanie glifu, który stoi przed nimi. Obszar i wydłużenie to glify drugiego poziomu, więc potrzebujesz księgi maga."
		""
		"&7Wzmocnienie wymaga diamentowego kilofa.&r"
	]
	quest.3111889E8390FD7D.title: "Wzmocnienia zaklęć"
	quest.3113D482E74AC6EC.quest_desc: ["Młot ze skarbca brązowego lochu. Prawym przyciskiem ciska pocisk, który odrzuca wrogów."]
	quest.3136AD1EC33B9618.quest_desc: [
		"Montaż sekwencyjny: wał, kondensator, płytka stali, szpula, magnes, stalowy mechanizm i śrubokręt. Obracany przez Create daje napięcie i moc sieci TFMG."
		""
		"&7Jak liczy się napięcie i prąd, pokazuje Ponder (W).&r"
	]
	quest.3136AD1EC33B9618.quest_subtitle: "Kamień milowy"
	quest.3136AD1EC33B9618.title: "&6{block.tfmg.generator}"
	quest.3156C0BC641154A4.quest_desc: ["Formę kładziesz na stole odlewniczym: od niej zależy, czy z metalu wyjdzie sztabka, blacha, czy pręt. Blachy z odlewu zastąpią prasę."]
	quest.3156C0BC641154A4.title: "Formy grafitowe"
	quest.315AD5E939A06474.quest_desc: ["Jeszcze większe stosy w każdym gnieździe. Przepis wymaga bloku żelaza."]
	quest.3173281FC6A4AD7F.quest_desc: [
		"Wielka misa hutnicza i magazyn kilku stopionych metali naraz. Najwyższą temperaturę daje podstawa 5×5 z palnikiem pod każdym blokiem."
		""
		"&7Budowę tygla pokazuje Ponder (W).&r"
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę pary i stali.&r"
	]
	quest.3173281FC6A4AD7F.quest_subtitle: "Kamień milowy"
	quest.3173281FC6A4AD7F.title: "&6{block.createmetallurgy.industrial_crucible}"
	quest.31747A769E116492.quest_desc: ["Kwas siarkowy rozpuszcza rudę w brudną zawiesinę. Ostateczny układ do budowy zrobisz z rafinowanego obsydianu."]
	quest.319B11EE740F7AD2.quest_desc: ["Zapuszczony dwór Structory. Przeszukaj jego pokoje."]
	quest.319B11EE740F7AD2.title: "Stary dwór"
	quest.31B2CAF0EAD49E39.quest_desc: ["Przejdź przez portal. Aether to latające wyspy nad chmurami, z własnymi surowcami, potworami i lochami czterech strażników."]
	quest.31B2CAF0EAD49E39.quest_subtitle: "Kamień milowy"
	quest.31B2CAF0EAD49E39.title: "&aWejście do Aetheru"
	quest.31BDCD49649F2389.quest_desc: ["Postawiony na torach i zasilony redstone zamienia konstrukcję nad sobą w maszynę jadącą na wagoniku. Wiertła z przodu zrobią z niej kolejkę górniczą."]
	quest.31C108BF7BA13140.quest_desc: ["W erze elektryczności wszystkie budynki dochodzą do poziomu 5. W erze atomu uniwersytet na poziomie 5 otworzy jeszcze zwieńczenia gałęzi badań."]
	quest.31C108BF7BA13140.title: "Poziom 5"
	quest.31E3AD5655575851.quest_desc: [
		"Kolorowe kredy zrobisz z nieczystej białej kredy i pyłów, a ogień duchów je oczyści. Żółta to pył złota i jasnopyłu, jasnoszara srebro, żelazo i kalcyt, a limonkowa pył szmaragdu, pył badań i szlam."
		""
		"&7Pył badań i pyły rud dadzą ci rytuały foliota i kruszarka.&r"
	]
	quest.31E3AD5655575851.title: "Kredy djinna"
	quest.31E77171081491E5.quest_desc: ["Boskie złoto z kuźni Hefajstosa, znane z ery arkanów. Cztery sztabki trafią do pieczęci."]
	quest.31E77171081491E5.quest_subtitle: "Składnik pieczęci"
	quest.31F15E096337E0DC.quest_desc: ["Łącznik źródła, który zbiera źródło z rosnących wokół roślin. Postaw go przy polu, a słoik obok sam się napełni."]
	quest.31FB1A7057262F64.quest_desc: ["Maska ptaka słońca nigdy się nie psuje. Załóż ją i kliknij prawym przyciskiem z inną maską Umvuthana w ręce, a przywołasz sługę."]
	quest.31FC89970B1DD5FD.quest_desc: ["Pieczęć potrzebuje 500 mB miodu w tyglu. Wylej butelki miodu do odpływu albo wypompuj miód rurą prosto z ula, a potem napełnij wiadro."]
	quest.31FC89970B1DD5FD.quest_subtitle: "Składnik pieczęci"
	quest.32069A099BF772B3.quest_desc: ["Grabarz z cmentarza potrafi wskrzesić poległego mieszkańca. Totem nieśmiertelności mu w tym pomoże."]
	quest.32069A099BF772B3.title: "Zmartwychwstanie"
	quest.323837979728408A.quest_desc: ["Każdemu z czterech boków ustawisz kluczem montażowym kierunek obrotu osobno."]
	quest.324C68335146A18D.quest_desc: ["Nici z lazurytu połączone ze złotem, sfermentowanym okiem pająka albo ametystem. Z tkanin szyjesz różdżki, szaty i torby."]
	quest.324C68335146A18D.title: "Magiczne tkaniny"
	quest.3258FD13D5F35E82.quest_desc: [
		"Kocioł rytualny odprawia rytuały z tabliczek. {item.ars_nouveau.ritual_wilden_summon} bez dodatków wzywa zwykłe wildeny, a z kolcem, rogiem i skrzydłem wildena – Chimerę."
		"&cPrzy Chimerze rytuał niszczy bloki wokół kotła.&r"
	]
	quest.3258FD13D5F35E82.title: "Rytuał przywołania"
	quest.326A1530E5FB63B5.quest_desc: ["Dostrojona z góry do pączkującego ametystu. Prowadzi prosto do geod."]
	quest.328C755D0FA95CA1.quest_desc: ["Konduktora zbudujesz z andezytowej obudowy i czapki konduktora; Ponder (W) pokaże jak. Usiądzie przy kontrolerze jak maszynista, a gwizdek konduktora przywoła jego pociąg."]
	quest.328C755D0FA95CA1.title: "Konduktor"
	quest.329BC48DABA6EB3C.quest_desc: ["Połączony nadajnik przyczepisz do przycisku albo dźwigni, a ta zacznie nadawać bez kabli. Uniwersalny emiter w gnieździe częstotliwości pasuje do każdego przedmiotu."]
	quest.329BC48DABA6EB3C.title: "Nadajniki na przyciskach"
	quest.32B181A53695DD84.quest_desc: ["Blokuje szufladę na jeden przedmiot, nawet pustą, i przełącza to, co widać na froncie."]
	quest.32CEF1D222B81BC6.quest_desc: ["Największa komórka AE2. Kilka takich w napędzie pomieści wszystko, co wydobędziesz do końca ery."]
	quest.32CEF1D222B81BC6.quest_subtitle: "Kamień milowy"
	quest.32CEF1D222B81BC6.title: "&b{item.ae2.item_storage_cell_256k}"
	quest.32D259A034E9AF5A.quest_desc: ["Ruda szkarłatnego żelaza leży w Netherze, także w czernicie. To pierwszy metal Silent Gear spoza Overworldu i baza szkarłatnej stali."]
	quest.32DA6AE7A0588DA9.quest_desc: ["Kamień nasycony duchami staje się skałą skręconą albo skażoną. Z nich zbudujesz tygiel, katalizator, pylony i runy."]
	quest.32DA6AE7A0588DA9.title: "Skały duchów"
	quest.32E7139ACB7C6856.quest_desc: ["Uruchom dowolny rytuał. Każdy rytuał wyłączysz sygnałem redstone na kamieniu głównym, zanim wyssie twoją animę do dna."]
	quest.32E7139ACB7C6856.title: "Pierwszy rytuał"
	quest.32E7321D0E4FCFAE.quest_desc: ["Rytuał Ewolucji Świadomej podnosi limit punktów ulepszeń twojej zbroi ze 100 do 300."]
	quest.32E7321D0E4FCFAE.title: "Ewolucja zbroi"
	quest.32EB4381EE5DADC2.quest_desc: ["Mgliste bagno otwiera się po pokonaniu licza. Pod nim leży Labirynt minoszruma."]
	quest.32EB4381EE5DADC2.title: "{biome.twilightforest.swamp}"
	quest.330947959EE74AA2.quest_desc: ["Trzyma jeden stos przedmiotów pod prasą, wylewką albo wiatrakiem. Lejek obok składnicy sam ją napełni i opróżni."]
	quest.33153CDCEDA8E71A.quest_desc: [
		"&7Era mosiądzu · zalecana diamentowa zbroja i łuk&r"
		""
		"Wieża stoi w zimnych biomach. Nocny licz czeka na jej szczycie i walczy z dystansu, ciskając pociskami i kometami, więc nie stój w miejscu."
	]
	quest.33153CDCEDA8E71A.title: "Wieża nocnego licza"
	quest.3315DA0BECE7D6BF.quest_desc: ["Pozwala ręcznie wskazać cel działom podłączonym do twojego kontrolera sieci."]
	quest.3316BFDBD54152BA.quest_desc: ["Schemat maszyny pokaże masę i szczegóły symulowanej maszyny, a tabliczka z nazwą ogłosi, jak się nazywa twój statek."]
	quest.3316BFDBD54152BA.title: "Papiery statku"
	quest.33185A0BE53A3282.quest_desc: ["Kamień młyński mieli kruszoną rudę na brudny pył, a wiatrak z wodą go płucze. Czysty pył topi się bez szlaki, a brudny i ruda zostawiają jej trochę w misie."]
	quest.33185A0BE53A3282.title: "Pył zamiast rudy"
	quest.332569B85AF86340.quest_desc: ["Kliknij nimi blok docelowy, a potem podłącz przewodem. Wyciągacz zabiera przedmioty z pojemnika, a wstawiacz wkłada je np. do destylatora."]
	quest.332569B85AF86340.title: "Wyciągacz i wstawiacz"
	quest.333DFBCB08CA734E.quest_desc: ["Ars Technica łączy Create z Ars Nouveau. Skalibrowany mechanizm powstaje w aparacie zaklinającym z precyzyjnego mechanizmu, klejnotu źródła i ametystu."]
	quest.334453E019970875.quest_desc: ["Na pniach runicznego drzewa nad podstawą totemu wyryj duchy, a laską totemiczną rozpocznij obrzęd. Zależnie od duchów obrzęd leczy, przyspiesza albo nawozi okolicę."]
	quest.334453E019970875.title: "Obrzęd totemu"
	quest.3355EAD0EB36560D.quest_desc: ["Nóż i młotek z bruku i prymitywnych części z bruku, ziemi i patyków. To pierwsze narzędzia do pracy na kowadle."]
	quest.3355EAD0EB36560D.title: "Prymitywne narzędzia"
	quest.3363F06A6DFBCF5E.quest_desc: [
		"Stawia więcej bloków naraz niż kamienna i dłużej wytrzymuje."
		""
		"&7Kolejny tier różdżek pojawi się tutaj, gdy twoja drużyna wejdzie w erę mosiądzu.&r"
	]
	quest.336D851AB837B72B.quest_desc: ["Liście, woda i mleko zmieszane w podgrzewanym tyglu i nalane wylewką do butelki. Herbatka dodaje sił do długiej pracy przy budowie."]
	quest.337FE639F840EA54.quest_desc: [
		"Rytuał Przełamania Krawędzi Królestwa Demonów rozdziera zasłonę i daje ograniczone przejście na drugą stronę."
		""
		"&cIdź w pełnej zbroi: Królestwo nie wybacza nieprzygotowanym.&r"
	]
	quest.337FE639F840EA54.title: "Przełamanie krawędzi"
	quest.338ADE6AAA626A01.quest_desc: ["Rzucona zamraża wodę i lawę w pobliżu oraz rani stwory mrozem."]
	quest.33A0091499FC8F36.quest_desc: ["Ogniste ptaki gnieżdżą się w ptaszarniach. Włóż nasiona do gniazda i zobacz, co się stanie."]
	quest.33A0091499FC8F36.title: "Gniazdo ognistego ptaka"
	quest.33A07B00927692C1.quest_desc: ["Antymateria przemienia tu jeden pierwiastek w drugi. To najdroższa maszyna Mekanismu."]
	quest.33A627D675FE6251.quest_desc: ["Gubią je gobliny-rycerze w twierdzy pod mrocznym lasem."]
	quest.33B90DF516E5C18A.quest_desc: ["Ramowa szuflada przyjmie wygląd wybranych bloków, więc magazyn zgra się ze ścianami bazy."]
	quest.33C970C359D7003C.quest_desc: ["Mosiężna obudowa na wale albo kole zębatym działa jak andezytowa. Pasuje do maszyn z tej ery."]
	quest.33C970C359D7003C.title: "Mosiężne obudowy"
	quest.33E23E32CF675B67.quest_desc: ["Tym narzędziem stawiasz chaty i budynki: wybierasz styl i budynek, przesuwasz i obracasz podgląd, a potem zatwierdzasz miejsce."]
	quest.33E5CF4E857A563A.quest_desc: ["Zbierz w kolonii 50 mieszkańców. W tej erze zwykłe budynki rosną do poziomu 4, więc domy pomieszczą więcej ludzi."]
	quest.33E5CF4E857A563A.title: "Pięćdziesięciu mieszkańców"
	quest.33F85A892ECD3628.quest_desc: ["Osm nasycony redstone'em daje podstawowy układ. Kolejne nasycenie redstone'em podnosi go o poziom."]
	quest.33F85A892ECD3628.title: "Układy sterowania"
	quest.33FEC4DE0C0A63E9.quest_desc: ["Warsztat kamieniarza z Chipped w skrzyni: zmienisz wzór całego stosu kamienia, nie wyjmując go."]
	quest.3403B299F3A18DDE.quest_desc: ["Łapie paczki z łańcuchowego przenośnika i odkłada je do bloku pod sobą. Paczka z adresem trafi do żabołapu o tym samym adresie."]
	quest.340FA0F3FA52DF21.quest_desc: [
		"&7Era transcendencji · zalecana najlepsza zbroja, oddychanie pod wodą i leczenie&r"
		""
		"Każde oko leci jak oko Endera do innej siedziby: otchłani do zatopionego miasta Lewiatana, burzy do akropolu Scylli, mechaniczne do fabryki Zwiastuna, a przeklęte do mroźnego więzienia Maledictusa."
	]
	quest.340FA0F3FA52DF21.title: "Cztery oczy"
	quest.3410C89A9D4ECE16.quest_desc: ["Wypada z przyzywacza potworów rozbitego bez jedwabnego dotyku. Potrzebujesz go do drugiego poziomu kuźni i do chwytacza kwantowego."]
	quest.343AE35599EB3B9F.quest_desc: ["Przyzywacz potworów wykopiesz jedwabnym dotykiem. Kliknięty modyfikatorem zmienia działanie: szybciej przyzywa, więcej stworów albo działa bez gracza w pobliżu; listę modyfikatorów pokaże JEI."]
	quest.343AE35599EB3B9F.title: "Przyzywacz na zamówienie"
	quest.343DECE264FF7969.quest_desc: ["Na polanie w zaczarowanym lesie stoi baran, który zbiera wełnę w każdym kolorze. Przynieś mu wszystkie, a sowicie ci zapłaci."]
	quest.343DECE264FF7969.title: "Zadanie barana"
	quest.344182A6E8AC0FC2.quest_desc: ["Miernik kolonii działa jak miernik fabryczny Create, ale pilnuje zapasów w magazynie kolonii."]
	quest.3444696FE5AB66F7.quest_desc: ["Działko laserowe przeładujesz redstone'em z ekwipunku, a wyrzutnia na ramię strzela pociskami Withera."]
	quest.3444696FE5AB66F7.title: "Broń z witherytu"
	quest.3466C6850CF3CB85.quest_desc: ["Wytop rudę miedzi na sztabki i zrób z nich kilof. Ten wykopie już żelazo i lazuryt."]
	quest.34720DBA5808E08F.quest_desc: ["Geody to kule ametystu ukryte głęboko pod ziemią. Rozbij kilka kryształów."]
	quest.3473E1E598D45E1B.quest_desc: [
		"Prasa nad rozgrzanym tyglem zrobi żeliwo z żelaza i węgla, a mikser brąz z miedzi i cyny. Z żeliwa odlejesz pierwsze działa, a brąz wytrzyma więcej ładunków prochowych."
		""
		"&7Ta strona idzie dalej niż drzewo ery pary i stali: materiały, ładowanie, pociski, działka automatyczne i radary.&r"
	]
	quest.3473E1E598D45E1B.title: "Żeliwo i brąz"
	quest.347DEDC7446DE92B.quest_desc: [
		"&7Ekwipunek: dobra zbroja i mikstury leczenia.&r"
		"Kryje się w labiryncie Przeklętego Ogrodu w Eternal Starlight. Gryzie i zionie oddechem."
	]
	quest.347DEDC7446DE92B.quest_subtitle: "Boss"
	quest.347DEDC7446DE92B.title: "&c{entity.eternal_starlight.lunar_monstrosity}"
	quest.348394C3775B7011.quest_desc: ["Resonarium zostawiają szlamy Otherside. Z łuską da płytkę, którą ulepszysz diamentowy sprzęt."]
	quest.34E295E7E33234F0.quest_desc: ["&6{block.create.mechanical_mixer}&r nad &6tyglem&r łączy składniki w jeden produkt. W tej erze działa bez podgrzewania – i właśnie tak zmieszasz Pieczęć Ery Run."]
	quest.34E295E7E33234F0.quest_subtitle: "Kamień milowy"
	quest.34E295E7E33234F0.title: "&6Mikser i tygiel"
	quest.34FCF10413455693.quest_desc: [
		"Gdy zdobędziesz kamienie milowe tej ery, oddaj &6Pieczęć Ery Mosiądzu&r. Cała twoja drużyna wejdzie w erę mosiądzu, a pieczęć przepadnie."
		""
		"Pieczęć powstanie w &dczarującym urządzeniu&r za 5000 źródła. Na środek idzie andezytowa obudowa, a na piedestały: trofeum Nagi lub Licza, trofeum Chimery lub Umarłego Króla, 2 tajemne esencje, blok klejnotów źródła, prasa, koło wodne i diament."
		""
		"&7Dokładny przepis zobaczysz w JEI: najedź na pieczęć i wciśnij R.&r"
	]
	quest.34FCF10413455693.quest_subtitle: "Oddaj pieczęć"
	quest.34FCF10413455693.title: "Brama: Era Mosiądzu"
	quest.35309C9C31AF6733.quest_desc: ["Elitarny układ nasycony rafinowanym obsydianem albo złożony ze stopem atomowym. Cztery trafią do pieczęci, kolejne do reaktorów i QIO."]
	quest.35309C9C31AF6733.quest_subtitle: "Składnik pieczęci"
	quest.353C2D82DCE53DB0.quest_desc: ["Torba z uwięzionym duchem mieści znacznie więcej niż zwykły plecak. Zrobisz ją rytuałem z księgą foliota."]
	quest.353F03168ACA145D.quest_desc: ["Statek uwięziony w lodzie Labiryntu. Na takich statkach leżą muszlowe rogi."]
	quest.353F03168ACA145D.title: "Zamarznięty statek piracki"
	quest.3556EF8DB6928840.quest_desc: ["Szaty maga ulepszone na stole kowalskim sztabką netherytu i szablonem. Chronią jak netheryt i dalej dodają many."]
	quest.3556EF8DB6928840.title: "Netherytowe szaty maga bitewnego"
	quest.35637111DF6F0546.quest_desc: ["Pokonaj jednego z trzech bossów Eternal Starlight. Trofeum dopełni pieczęć."]
	quest.35637111DF6F0546.quest_subtitle: "Kamień milowy"
	quest.35637111DF6F0546.title: "&cBoss Eternal Starlight"
	quest.358740A581AB8CF6.quest_desc: ["Klejnoty źródła złożone w blok. Blok trafi na piedestał przy Pieczęci Ery Mosiądzu, a przyda się też w kotle rytualnym."]
	quest.358740A581AB8CF6.quest_subtitle: "Składnik pieczęci"
	quest.3591035E480F9F81.quest_desc: ["Wyżyny otwierają się po pokonaniu hydry, Ur-Ghasta i Królowej Śniegu. W ich jaskiniach mieszkają trolle."]
	quest.3591035E480F9F81.title: "{biome.twilightforest.highlands}"
	quest.35CD7E283B845D4D.quest_desc: ["Komponent 256M w obudowie MEGA. Jedna taka komórka pomieści więcej niż cała twoja dawna sieć."]
	quest.35CD7E283B845D4D.quest_subtitle: "Kamień milowy"
	quest.35CD7E283B845D4D.title: "&b{item.megacells.item_storage_cell_256m}"
	quest.35D86A31BD39AA70.quest_desc: ["Wioska Terralith otoczona kamiennym murem. W środku mieszkają i handlują zwykli mieszkańcy."]
	quest.35D86A31BD39AA70.title: "Ufortyfikowana wioska"
	quest.35E3E299110837C8.quest_desc: ["Szkielety Netheru rozbijają obozy w każdej krainie. Przyjdź z tarczą: strzelają celnie."]
	quest.35E3E299110837C8.title: "Obóz szkieletów"
	quest.35E5DC242535A7DC.quest_desc: ["Postawiony zbiornik napełnia się sprężonym powietrzem z napędu. Założony razem z hełmem pozwala oddychać pod wodą."]
	quest.35E5DC242535A7DC.title: "Strój nurka"
	quest.35EDFF3F0B54D7A7.quest_desc: ["Kamienny ołtarz ze stołu roboczego. Wymaga cynowej inkrustacji i odłamka duszy."]
	quest.360452A7B13077A2.quest_desc: ["Z płonącym okiem rękawicy. Wzmacnia o 30% wybuchy w promieniu 64 bloków, także te z twoich maszyn."]
	quest.36115C5C4E728E80.quest_desc: ["Miedziany drut nawinięty na pustą szpulę. Szpulą łączysz złącza w sieć przewodów, a jedna trafi też do alternatora."]
	quest.361D545118FBE10F.quest_desc: ["Zakwas z sadzonek, kwiatów, kłód albo desek z cukrem. Z nim fermentacja zużywa mniej plonów."]
	quest.3627C3E79D31B0F5.quest_desc: ["Ołtarz Incendium na piekielnych wydmach. Podchodź ostrożnie."]
	quest.3627C3E79D31B0F5.title: "Piekielny ołtarz"
	quest.364475FBFDF50FEF.quest_desc: [
		"Strażnik zostawia echo pustki. Trafi do ostrza Endu i kilku fokusów Goety."
		""
		"&7Kolejny tier bossów magii pojawi się tutaj, gdy twoja drużyna wejdzie w erę transcendencji.&r"
	]
	quest.368D674C17AF7000.quest_desc: ["Pokonaj jednego z czterech strażników Aetheru. Jego trofeum trafi do pieczęci."]
	quest.368D674C17AF7000.quest_subtitle: "Kamień milowy"
	quest.368D674C17AF7000.title: "&cBoss Aetheru"
	quest.36A84F0047BD1221.quest_desc: [
		"Klawisz „{key.mechtrowel.open_palette}” otwiera menedżer palet: wybierz bloki i ich proporcje, a potem zapisz paletę pod nazwą. „{key.mechtrowel.cycle_palette}” przełącza zapisane palety."
		""
		"&7Schody i płyty kielnia obraca sama; ustawienia obrotu otworzysz klawiszem „{key.mechtrowel.open_rotation}”.&r"
	]
	quest.36A84F0047BD1221.title: "Palety"
	quest.36C2E688D613E70B.quest_desc: [
		"Szaty Ars Nouveau zwiększają manę i jej odnawianie. Powstają w aparacie z włókna i zwykłego napierśnika: złoty daje lekki strój, żelazny średni, a diamentowy ciężki."
		""
		"&7Wystarczy jedna część dowolnego zestawu.&r"
	]
	quest.36C2E688D613E70B.quest_subtitle: "Kamień milowy"
	quest.36C2E688D613E70B.title: "&dSzaty maga"
	quest.36D904598742BDBA.quest_desc: [
		"Najpierw zrób zbroję z czarnego żelaza: żelazną zbroję z przeklętym metalem. Każdą część ulepszysz potem w rytuale mrocznym stopem i duchową tkaniną."
		""
		"&7Kolejny tier Goety pojawi się tutaj, gdy twoja drużyna wejdzie w erę elektryczności.&r"
	]
	quest.36D904598742BDBA.quest_subtitle: "Kamień milowy"
	quest.36D904598742BDBA.title: "&dMroczna zbroja"
	quest.36E6453ABC7C316F.quest_desc: ["Ta strona prowadzi przez krainy i surowce Eternal Starlight. Portal i bossów masz w drzewie ery atomu."]
	quest.36E6453ABC7C316F.title: "Pod wiecznymi gwiazdami"
	quest.370545ACED798316.quest_desc: ["Więcej miejsca i więcej gniazd na ulepszenia. Ulepszasz plecak w siatce rzemiosła i nie tracisz przy tym zawartości."]
	quest.3718EA2B8781F518.quest_desc: ["Umarły Król zostawia ten kostur albo swoją księgę. Kostur wzmacnia zaklęcia szkoły krwi."]
	quest.3743B83291F95F8B.quest_desc: ["Pocisk burzący wybucha dopiero z zapalnikiem. Uderzeniowy odpala przy trafieniu, choć nie zawsze – sprawdź w Ponderze (W), jak założyć go na pocisk."]
	quest.3743B83291F95F8B.title: "Pocisk burzący"
	quest.3760C9F3F8F4AF5B.quest_desc: ["Sakwa na magiczne błyskotki: pierścienie, amulety i talizmany nie zapchają ekwipunku. Zrobisz ją z włókna i skrzyni."]
	quest.37691B9E4F8EC2E3.quest_desc: [
		"Zbuduj wielki piec z ognioodpornych cegieł wokół wylotu pieca hutniczego; układ pokazuje Ponder (W). Wsypuj rudę żelaza, surową albo kruszoną, z piaskiem wapiennym jako topnikiem, a jako paliwo pył koksowy."
		"Z pieca wypływają płynna stal, szlaka i gaz piecowy. Zbierz 64 sztabki stali."
		""
		"&7Piasek wapienny dostaniesz, krusząc wapień w kołach kruszących.&r"
	]
	quest.37691B9E4F8EC2E3.quest_subtitle: "Kamień milowy"
	quest.37691B9E4F8EC2E3.title: "&6Wielki piec i 64 stali"
	quest.376CA5305332149B.quest_desc: [
		"Strój Wezyra uszyjesz w rytuałach z rubinem dusz. Gdy w turbanie oberwiesz, czasem pojawi się wierny chochlik, a szata zmniejsza o połowę obrażenia, dopóki rzucasz zaklęcia."
		""
		"&7Kolejny tier Goety pojawi się tutaj, gdy twoja drużyna wejdzie w erę atomu.&r"
	]
	quest.376CA5305332149B.title: "Wielki strój"
	quest.3777F8DAD393B87E.quest_desc: [
		"Kompresor osmowy z pomocą osmu zgniata pył w sztabki rafinowanego obsydianu albo jasnogłazu. Rafinowany obsydian wejdzie w ostateczne układy i maszyny przerobu ×5."
		""
		"&7Pył obsydianu nasycony diamentem w infuzerze da pył rafinowanego obsydianu.&r"
	]
	quest.3777F8DAD393B87E.title: "Rafinowany obsydian"
	quest.37846D9D616D6CE4.quest_desc: ["Montaż sekwencyjny z radioaktywnego toru i blachy żelaza. Wkłada się je do reaktora przez podajnik paliwa."]
	quest.378CA5E0E68216AF.quest_desc: ["Skleja rozbite zamówienie z kilku paczek w jedną całość, zanim trafi do odbiorcy."]
	quest.37909A3A3E2BC83D.quest_desc: ["Inwokator zostawia pierwotną esencję. To główny składnik stołu nasycania."]
	quest.379963716C197A80.quest_desc: [
		"Stawia naraz jeszcze więcej bloków. Netherytową zrobisz z niej w erze arkanów."
		""
		"&7Kolejny tier różdżek pojawi się tutaj, gdy twoja drużyna wejdzie w erę arkanów.&r"
	]
	quest.37E3EC3906AFB685.quest_desc: ["Sama zamienia samorodki, sztabki i bloki jednego metalu. Włóż sztabki, a wyjmiesz bloki albo samorodki."]
	quest.380AC8234042D349.quest_desc: ["Sam podmienia narzędzie w ręce na właściwe do bloku, który kopiesz. Przepis wymaga krzemiennych narzędzi."]
	quest.3849C43A8E8023EB.quest_desc: ["Pusty pergamin zrobisz z papieru i włókna. Na stole skryby zapiszesz na nim zaklęcie z księgi, a pergamin przeniesie je do wieżyczek i zaklętej broni."]
	quest.38735B84596714C7.quest_desc: ["Postaw ją przy stacji kolejowej, a pociągi z harmonogramem zabiorą i dowiozą paczki na inne stacje."]
	quest.38735B84596714C7.title: "Skrzynka pocztowa"
	quest.3874EF9893EB534D.quest_desc: ["Duże działo strzela pociskiem wypychanym przez ładunki prochowe. Ładunek złożysz z ubitego prochu (prasa nad tyglem) i pustego ładunku, a pełny pocisk z żelaza i drewnianych płyt."]
	quest.3874EF9893EB534D.title: "Proch i pocisk"
	quest.387CCCD933B895A7.quest_desc: ["Create Ore Excavation ukrywa pod chunkami żyły rud. Wykrywacz pokaże, jaka żyła leży pod tobą."]
	quest.38847639E343984A.quest_desc: ["Gromadzi energię z laserów i wystrzeliwuje ją naraz w matrycę skupienia. Dopiero tak silny impuls zapali reaktor syntezy."]
	quest.388985B149DFB381.quest_desc: [
		"Stawia naraz więcej bloków niż miedziana. Zrobisz ją z patyka i sztabki żelaza."
		""
		"&7Kolejny tier różdżek pojawi się tutaj, gdy twoja drużyna wejdzie w erę okultyzmu.&r"
	]
	quest.388BBC84224C1CDD.quest_desc: ["Ufortyfikowana baza illagerów z murami i wieżami. Szykuj tarczę."]
	quest.388BBC84224C1CDD.title: "Fort illagerów"
	quest.388E573F8FCCD375.quest_desc: ["Rurociąg Incendium ciągnie się przez wydmy i delty. Pilnują go strażnicy, a u jego końca leży skarb."]
	quest.388E573F8FCCD375.title: "Rurociąg"
	quest.389613A30B1FEAEF.quest_desc: ["Tryb linii ({effortlessbuilding.mode.line}): kliknij początek, przesuń wzrok i kliknij koniec, a powstanie prosta linia bloków. Linia ukośna ({effortlessbuilding.mode.diagonal_line}) pójdzie pod dowolnym kątem."]
	quest.389613A30B1FEAEF.title: "Linia"
	quest.389DDDCC2EE1706F.quest_desc: ["Gdy w sieci zabraknie bloków do wklejenia, autocrafting może je dorobić. Listę potrzebnych bloków pokaże „{buildinggadgets2.radialmenu.materiallist}” w menu gadżetu."]
	quest.389DDDCC2EE1706F.title: "Brakujące bloki"
	quest.38AC145887B1D1CE.quest_desc: ["Zasilany polaryzator zamienia sztabkę stopu magnetycznego w magnes. Zanim będziesz mieć prąd, pomoże tylko piorun, który trafi w sztabkę."]
	quest.38C76F24F12C66FA.quest_desc: ["Mieści na blok dwa razy więcej niż miedziany zbiornik, więc zapas paliwa zajmie na pokładzie mniej miejsca."]
	quest.38C7D9C19571B0D3.quest_desc: [
		"Otwiera magazyn z daleka. Najpierw kliknij nim aktywator, żeby go połączyć."
		""
		"&7Obojętny akcesor ożywisz rytuałem dżina z perłą Endera i kwarcem.&r"
	]
	quest.38C84D7F662C57E1.quest_desc: ["Grzeje aparaturę na odległość. Wskaż maszynę Shiftem i prawym przyciskiem, a emiter postaw na katalizatorze; piecyk pod maszyną nie będzie już potrzebny."]
	quest.38D51382CFDC27AE.quest_desc: ["Krzesła jadalniane, stoły, ławki parkowe, okiennice, kotary i lampy stojące. Na krzesłach i ławkach usiądziesz."]
	quest.38D51382CFDC27AE.title: "Another Furniture"
	quest.38EA9BA21F0E366C.quest_desc: [
		"Maszyny kręcą się już same, ale świat ma drugą warstwę. W lasach rosną drzewa nasycone źródłem, pod ziemią śpią dawni magowie, a za sadzawką otoczoną kwiatami czeka Las Zmierzchu."
		""
		"Era kończy się bramą. Wymaga ona kamieni milowych z gałęzi tego rozdziału i Pieczęci Ery Mosiądzu, a do niej trofeów dwóch bossów tej ery."
	]
	quest.38EA9BA21F0E366C.quest_subtitle: "Źródło i runy"
	quest.38EA9BA21F0E366C.title: "Era Run"
	quest.38EC208F50A0BAD9.quest_desc: [
		"Mikser hutniczy nad misą z przeszkloną pokrywą łączy stopione metale w stopy. Pod misą musi płonąć rozpalony płomienny palnik, a mikser obciąża sieć mocniej niż zwykły."
		""
		"&7Trzepaczkę zrobisz ze stopu andezytu i płytki obsydianu.&r"
	]
	quest.38EC208F50A0BAD9.quest_subtitle: "Kamień milowy"
	quest.38EC208F50A0BAD9.title: "&6Mikser hutniczy"
	quest.38FB930EB156032B.quest_desc: ["Ruda kamienia dusz leży pod ziemią w całym Overworldzie. Przetopiona daje &d{item.malum.refined_soulstone}&r, podstawę wszystkiego w Malum."]
	quest.38FD1B3434F75CD4.quest_desc: ["Drut wolframowy na szpuli to żarnik żarówki. Żarówka świeci tym jaśniej, im silniejszy sygnał redstone dostaje, i ma wersje we wszystkich kolorach."]
	quest.38FD1B3434F75CD4.title: "Żarówki"
	quest.38FF3A4D9052C426.quest_desc: ["Kuchnia Incendium na kwarcowych równinach. Gdzieś w środku kucharze ukryli swój skarb."]
	quest.38FF3A4D9052C426.title: "Kwarcowa kuchnia"
	quest.391678E4D6AFD55A.quest_desc: [
		"Echo zawsze zostawia ten odłamek. Ulepszysz nim szaty Iron's Spells, np. szatę kapłana w zbroję paladyna."
		""
		"&7Kolejny tier bossów magii pojawi się tutaj, gdy twoja drużyna wejdzie w erę arkanów.&r"
	]
	quest.391A056FD94B64A8.quest_desc: ["Klucz Ducha Słońca otwiera skarbiec złotego lochu z częściami zbroi feniksa i odłamkiem życia."]
	quest.39238FC1BE69AD2D.quest_desc: [
		"Wulkaniczny łącznik spala wrzucone paliwo i oddaje źródło do słoików obok; pnie łukodrzewu dają go więcej."
		"&cCiepło łącznika zamienia kamień obok w magmę, a potem w lawę.&r"
	]
	quest.39259A7487173A83.quest_desc: ["Wkłada przedmioty do magazynu albo z niego wyjmuje. Kliknij go przedmiotem, a ustawisz filtr."]
	quest.39285D0B4C57342B.quest_desc: ["Przywołuje dwie burze piaskowe, które krążą wokół ciebie. W erze transcendencji połączysz ją z bronią na kowadle fuzji."]
	quest.392A5988468C14B9.quest_desc: ["W tej fabryce machin wojennych śpi &c{entity.cataclysm.the_harbinger}&r. Drogę wskaże &a{item.cataclysm.mech_eye}&r."]
	quest.392A5988468C14B9.title: "Starożytna fabryka"
	quest.392D41496E27C540.quest_desc: ["Kliknij wał albo koło zębate andezytową obudową, a schowasz je w bloku. Obudowa nie przeszkadza w przenoszeniu obrotu, a maszyna wygląda porządniej."]
	quest.392D41496E27C540.title: "Obudowane wały"
	quest.393B78840727C9FA.quest_desc: [
		"Podniesione przedmioty trafiają prosto do plecaka. Filtr ustawisz w oknie ulepszenia."
		""
		"&7Kolejny tier plecaków pojawi się tutaj, gdy twoja drużyna wejdzie w erę andezytu.&r"
	]
	quest.39402E57007B2EF1.quest_desc: ["Grzeje maszyny Theurgy, które na nim stoją. Pali zwykłe paliwo, jak węgiel."]
	quest.39405BD6F08DB507.quest_desc: ["Różdżka rzuca zaklęcia z fokusów za energię dusz z totemu. &d{item.goety.empty_focus}&r zrobisz z ametystu i totemu."]
	quest.394E885DF08E66D6.quest_desc: ["Wskaż nim po kolei trzy piedestały i postaw go na katalizatorze. Szyk zmienia siarkę w inną siarkę tego samego rodzaju i tak powiela rzadkie materiały."]
	quest.394E885DF08E66D6.quest_subtitle: "Kamień milowy"
	quest.394E885DF08E66D6.title: "&d{block.theurgy.sulfuric_flux_emitter}"
	quest.39701793C6136A1E.quest_desc: [
		"Łzy Ur-Ghasta działają jak ognista krew Hydry: z żelazem dają ognisty metal."
		""
		"&7Kolejny tier Lasu Zmierzchu pojawi się tutaj, gdy twoja drużyna wejdzie w erę pary i stali.&r"
	]
	quest.39734C68F06A6EAF.quest_desc: ["Rzuć &d{item.occultism.datura}&r na ziemię i podpal krzesiwem. Ogień duchów nie parzy, tylko przemienia: książkę w księgę tabu, czarny barwnik w oczyszczony atrament, a pióro w przebudzone pióro."]
	quest.39734C68F06A6EAF.title: "Ogień duchów"
	quest.3979A9602B7C68CD.quest_desc: ["Postaw garnek nad ogniskiem. Gotuje dania, które sycą dużo dłużej niż surowe jedzenie."]
	quest.3979A9602B7C68CD.quest_subtitle: "Kamień milowy"
	quest.3979A9602B7C68CD.title: "&a{block.farmersdelight.cooking_pot}"
	quest.397F3CF7D688F608.quest_desc: ["Okno na całą sieć: wyszukasz, wyjmiesz i włożysz wszystko, co leży w komórkach. Wyszukiwarka rozumie też nazwy modów po znaku @."]
	quest.397F3CF7D688F608.quest_subtitle: "Kamień milowy"
	quest.397F3CF7D688F608.title: "&b{item.ae2.terminal}"
	quest.39816569D0AA0B76.quest_desc: [
		"Licz zostawia jedno z czterech bereł: zmierzchu (pociski), wysysania życia, umarłych (przywołuje zombie) i fortyfikacji (tarcze). Zdobądź wszystkie cztery."
		"&7Berło naładujesz z powrotem w siatce rzemiosła odpowiednim składnikiem, JEI pokaże jakim.&r"
	]
	quest.39816569D0AA0B76.title: "Cztery berła"
	quest.39886858DDF3F013.quest_desc: ["Łączy dwie mikstury ze słojów w jedną, z efektami obu. Wynik trafia do trzeciego słoja."]
	quest.39A0F4A2446C34AB.quest_desc: ["Esencja żaru, odłamek echa i odłamek netherytu. Wywołasz nim w cytadeli echo jej dawnego władcy."]
	quest.39D873825657C283.quest_desc: ["Brąz z miedzi i cyny, konstantan z miedzi i niklu, elektrum ze złota i srebra. Odlej każdy na stole w formie sztabki."]
	quest.39D873825657C283.title: "Stopy z odlewni"
	quest.39DAC81CDF25F2E4.quest_desc: ["Kopiuje fragment budowli i wkleja go w innym miejscu. Bloki bierze z ekwipunku albo z podpiętego magazynu."]
	quest.39FC2939A12B04D0.quest_desc: ["Postaw &6{block.create.water_wheel}&r w płynącej wodzie, np. pod małą kaskadą, i podłącz do niego wał. Zadanie zalicza osiągnięcie Create za napęd z koła wodnego."]
	quest.39FC2939A12B04D0.title: "Koło w nurcie"
	quest.3A31BE7E9767010E.quest_desc: ["Pusta kula ulepszeń z runą nowej szkoły. Nałożona na kowadle czarów wzmacnia zaklęcia tej szkoły."]
	quest.3A31BE7E9767010E.title: "Kula nowej szkoły"
	quest.3A3B94F8253BF669.quest_desc: ["Stop andezytu zrobisz z andezytu i bryłek żelaza. Kliknij nim w ociosany pień lub ociosane drewno, a dostaniesz obudowę: korpus większości maszyn tej ery i składnik pieczęci."]
	quest.3A3B94F8253BF669.quest_subtitle: "Składnik pieczęci"
	quest.3A45BE25E27884E8.quest_desc: ["Las wiecznej zmarzliny i kryształowa pustynia leżą dalej od portalu. Ubierz się ciepło."]
	quest.3A45BE25E27884E8.title: "Mróz i kryształy"
	quest.3A4709D64DBBCA86.quest_desc: ["Kości dawnego smoka leżą na wyspach Nullscape. Ktoś już kiedyś tu walczył."]
	quest.3A4709D64DBBCA86.title: "Szkielet smoka"
	quest.3A679909B4245D84.quest_desc: ["Brama wymaga jednego z bossów Lasu Zmierzchu tej ery. Wystarczy jeden, a jego trofeum trafi do pieczęci."]
	quest.3A679909B4245D84.quest_subtitle: "Kamień milowy"
	quest.3A679909B4245D84.title: "&c{entity.twilightforest.minoshroom} lub {entity.twilightforest.hydra}"
	quest.3A6D23379D9C3EE1.quest_desc: ["Drewniana wieża obserwacyjna Dungeons and Taverns. Z jej szczytu zobaczysz całą okolicę."]
	quest.3A6D23379D9C3EE1.title: "Wieża strażnicza"
	quest.3A82F37C4AAF3AED.quest_desc: ["Pokazuje przez ściany wskazany blok, np. rudę, przez pewien czas. Blok dodajesz do kotła przed rozpoczęciem."]
	quest.3A9C1595C2AC719A.quest_desc: ["Podaje różdżce bloki z własnych gniazd, po kolei albo losowo. Ściany i drogi wyjdą mniej jednolite. Tryb palety zmienisz klawiszem „{key.wands.wand_palette_mode}”."]
	quest.3AA45D765F279AB9.quest_desc: ["Tabliczka Animata na ołtarzu trzeciego poziomu za 15 000 esencji. Ciemne żyłki przecinają ją jak zamarznięta błyskawica."]
	quest.3AB8C371B574C5A3.quest_desc: [
		"Ciasto z rozżarzonej mąki, jajka i cukru, nadziane lawą przez wylewkę. Płomienny palnik nakarmiony nim na chwilę się przegrzewa, a niektóre przepisy w JEI wymagają właśnie przegrzania."
		""
		"&7Rozżarzoną mąkę dadzą koła kruszące z netherracku.&r"
	]
	quest.3AC1EE154F27EB59.quest_desc: ["Formę modułu zrobisz z HDPE, cyny i brązu. Jednostka energii powiększa baterię, osłona chroni przed promieniowaniem, a eskalacja przyspiesza kopanie."]
	quest.3AC1EE154F27EB59.title: "Pierwsze moduły"
	quest.3AD37031A147C8D0.quest_desc: ["{block.create.spout} nalewa kreozot na deski i tak powstają utwardzone deski. Przyłóż do nich sztabkę stali, a dostaniesz stalową obudowę. Cztery trafią do pieczęci."]
	quest.3AD37031A147C8D0.quest_subtitle: "Składnik pieczęci"
	quest.3ADA57DAA3F7BDBC.quest_desc: ["Mikser nad przegrzanym palnikiem połączy złom netherytu z czterema sztabkami stali w osiem sztabek netherstali. To materiał na najmocniejsze lufy."]
	quest.3ADA57DAA3F7BDBC.title: "Netherstal"
	quest.3ADA5B79D2C7D9FA.quest_desc: ["Naszyjnik nosisz obok pierścieni. Wzory amuletów dają premie, których pierścień nie ma, np. ochronę."]
	quest.3AE2BD660E927C20.quest_desc: ["Pokonaj Rzeźbiarza, Alfa yeti albo Królową Śniegu. Pieczęć wymaga trofeum jednego z nich obok trofeum z Aetheru."]
	quest.3AE2BD660E927C20.quest_subtitle: "Kamień milowy"
	quest.3AE2BD660E927C20.title: "&cDrugi boss ery"
	quest.3AEE36E47EFE6486.quest_desc: ["Dmuchawa do szkła ma wzory szkła, warsztat botanika roślin i liści, a stół majsterkowicza lamp i bloków redstone."]
	quest.3AEE36E47EFE6486.title: "Pozostałe warsztaty Chipped"
	quest.3AEF793B8A37733E.quest_desc: ["Udostępnia lejkom i rurom pojemnik, który stoi za nim, jakby był tuż obok. Z Create: Connected."]
	quest.3B08AA83EFC7BBF8.quest_desc: ["Wioski wyglądają inaczej w każdym klimacie. Odwiedź pustynną, śnieżną i tajgową."]
	quest.3B08AA83EFC7BBF8.title: "Wioski świata"
	quest.3B1E0112EC768F9D.quest_desc: ["Interfejs z dwa razy większą liczbą gniazd: utrzyma zapas większej liczby przedmiotów dla szybkich maszyn ery atomu."]
	quest.3B2D06241FA8FEF1.quest_desc: ["Ładujesz nimi działo ręcznie, bez ładownicy, ale każdy blok wepchnięty do lufy kosztuje cię głód."]
	quest.3B2D06241FA8FEF1.title: "Stempel i wycior"
	quest.3B579F9CC4F9F2C1.quest_desc: ["Ukryty schron piratów w Lodowym Labiryncie. Sprawdź, co w nim zostawili."]
	quest.3B579F9CC4F9F2C1.title: "Schron piratów"
	quest.3B78789C071DDD6B.quest_desc: ["Usuwa całe bryły bloków naraz. Przydaje się, gdy przebudowujesz bazę od zera."]
	quest.3B8C2C4B236D38E1.quest_desc: ["Rytuał na pierwszym poziomie kuźni: rdzeń kwantowy i 4 kawałki złomu przyzywacza. Chwytacz zamyka stworzenie w środku i wypuszcza je tam, gdzie chcesz."]
	quest.3B8E9C25136466D3.quest_desc: ["Wzmocniony blok redstone z rytuału na mrocznym ołtarzu. To serce formy, z której powstaje monstrum z czerwienitu."]
	quest.3B9748A00E787A69.quest_desc: ["Kable wyższego poziomu przenoszą dużo więcej FE na tick. Wymienisz je bez rozbierania sieci."]
	quest.3B9748A00E787A69.title: "Grubsze kable"
	quest.3BB1C234B16D2345.quest_desc: [
		"Ruiny zasypane ziemią i żwirem. Podejrzany żwir oczyść pędzelkiem, a znajdziesz skorupy i inne znaleziska."
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę andezytu.&r"
	]
	quest.3BB1C234B16D2345.title: "Ruiny szlaku"
	quest.3BD7E7B21E74BFB5.quest_desc: ["Wystarczy jeden z nich: &c{entity.cataclysm.the_harbinger}&r, &c{entity.cataclysm.maledictus}&r albo &c{entity.gametechbcs_spellbooks.hard_dead_king}&r. Trofeum dopełni pieczęć."]
	quest.3BD7E7B21E74BFB5.quest_subtitle: "Kamień milowy"
	quest.3BD7E7B21E74BFB5.title: "&cDrugi boss ery"
	quest.3BF1845223597B1C.quest_desc: ["Transformator Tesli nad złotą sztabką przemieni ją w elektrum. Z elektrum zrobisz drut, szpulę i akumulator."]
	quest.3C0347221EB791E2.quest_desc: ["Dodaje przedmiotowi gniazdo na klejnot. Robisz go z łupka zespolonego z klejnotami, pyłu klejnotów, ametystu i prochu."]
	quest.3C0A920447D551DA.quest_desc: ["Ogranicza, które przedmioty przechodzą przez wyciągacz albo wstawiacz."]
	quest.3C26A3DB6E5D2937.quest_desc: ["Surowe Spiritus z potworów trafionych nożem. Esencja to waluta krwi, a Spiritus waluta duszy."]
	quest.3C3EFEFFE1B0C98D.quest_desc: ["Użyty na stałe dodaje ci serce zdrowia. Trafia się w skarbcu złotego lochu."]
	quest.3C5A977308DB2BE9.quest_desc: ["Stopienie zderza przedmioty i bierze płyny z pobliskich zbiorników, jak mechaniczny mikser. Z przegrzaniem zrobi przepisy, które w Create wymagają płomiennego palnika z ciastem."]
	quest.3C5A977308DB2BE9.title: "Mieszanie zaklęciem"
	quest.3C6369A72CFC8FCE.quest_desc: ["Rozbity statek Explorify na wyspie Endu. Przeszukaj ładownię."]
	quest.3C6369A72CFC8FCE.title: "Wrak w Endzie"
	quest.3C7222C219600DE7.quest_desc: ["Silnik odrzutowy z Create Propulsion daje ciąg w jednym kierunku, gdy dostaje sygnał redstone. Pali terpentynę podaną rurą."]
	quest.3C772A82C1A69EA2.quest_desc: ["Najwyższe poziomy pojemnika, ze wzmocnionego i atomowego stopu. Ostateczny pomieści zapas całej kopalni."]
	quest.3C772A82C1A69EA2.title: "Elitarny i ostateczny pojemnik"
	quest.3C7CC5DA03AF6EE4.quest_desc: ["Klejnot duszy zamyka w sobie żywe stworzenie i wypuszcza je, gdzie zechcesz, ile razy chcesz. Kruchy klejnot z rytuału foliota pęka po jednym użyciu."]
	quest.3C87EEACE70CE966.quest_desc: [
		"Wielki piec nie ruszy bez wzmocnień, a każde kolejne wokół pieca przyspiesza wytop."
		""
		"&7Układ wzmocnień pokazuje Ponder (W) na wylocie pieca.&r"
	]
	quest.3C9C9347CB08A8A3.quest_desc: ["Leczy cel albo ciebie, gdy połączysz go z formą siebie. Glif drugiego poziomu ze złotego jabłka i błyszczącego arbuza."]
	quest.3CBC4F85CFB29456.quest_desc: [
		"Na stole kowalskim, z perłą Endera, dodaje kielni tryb różdżki: stawia całe rzędy i płaszczyzny losowych bloków naraz. Tryb przełączysz klawiszem „{key.mechtrowel.toggle_build_mode}”."
		""
		"&7Kolejny tier kielni pojawi się tutaj, gdy twoja drużyna wejdzie w erę arkanów.&r"
	]
	quest.3CC3998DD1166A4D.quest_desc: ["&d{item.minecraft.nether_wart}&r to baza większości mikstur, a &d{item.minecraft.magma_cream}&r daje ognioodporność, która przyda się w Netherze."]
	quest.3CD23F9C3416BC34.quest_desc: ["Złącza dokujące łączą się w pary w sztywne połączenie. Jedno na statku, drugie na wieży cumowniczej – i statek stoi pewnie w porcie."]
	quest.3CE3CCC7E269A86B.quest_desc: ["Plecak odrzutowy wbudowany w napierśnik, wysokie skoki w butach i szybszy bieg w nogawicach. Każdy z tych modułów wymaga polonu."]
	quest.3CE3CCC7E269A86B.title: "Ruch"
	quest.3D05593C7CC33A02.quest_desc: ["Kompostownik zamienia sadzonki, liście i resztki w kompost, który nawozi pola farmera i kwiaciarni."]
	quest.3D05593C7CC33A02.title: "Kompostownia"
	quest.3D066A987EFE623D.quest_desc: ["Świecznik oświetla ołtarz i wzmacnia jego moc. Stworzenie zabite nad kielichem napełnia go krwią do obrzędów, a sam kielich zwiększa pojemność ołtarza o 2."]
	quest.3D066A987EFE623D.title: "Wyposażenie ołtarza"
	quest.3D077F9A0E102180.quest_desc: ["Każdy katalizator to inna szkoła: żelazo – granice, złoto – mistyka, diament – projekcja, szmaragd – wymiana. Trzy proszki w kręgu tworzą zaklęcie."]
	quest.3D077F9A0E102180.title: "Sproszkowane katalizatory"
	quest.3D09B9FC100C2825.quest_desc: [
		"Perła Endu to szkoła przemieszczenia, oko Endera oczu mistycznych, a kwarc intelektu. Rozetrzesz je młotkiem albo moździerzem jak pozostałe."
		""
		"&7Trzy proszki w kręgu krwi na płótnie dają zwój; przepisy pokaże JEI.&r"
	]
	quest.3D09B9FC100C2825.title: "Pozostałe katalizatory"
	quest.3D0B9BE5D4B15F6E.quest_desc: [
		"Kostka, ścieżki i bruk z każdego kamienia, a do tego płoty, sztachety i ozdobne mury. Ścieżki zrobisz w przecinarce."
		""
		"&7Kolejny tier dekoracji pojawi się tutaj, gdy twoja drużyna wejdzie w erę andezytu.&r"
	]
	quest.3D0B9BE5D4B15F6E.title: "Ścieżki i ogrodzenia"
	quest.3D2110748D7E9189.quest_desc: ["Liście i krzaki czasem gubią patyki. Zbierz kilka na trzonki narzędzi."]
	quest.3D2110748D7E9189.title: "Patyki"
	quest.3D28557669BC7FE0.quest_desc: ["Magazyn Mekanismu bez kabli: każdy blok QIO na tej samej częstotliwości widzi te same dyski."]
	quest.3D28557669BC7FE0.title: "Sieć QIO"
	quest.3D3A14CCB9432BE5.quest_desc: [
		"Pierwsze ulepszenie wciąga przedmioty z sąsiedniego pojemnika, a drugie wypycha zawartość szuflady na zewnątrz. Stronę ustawisz w oknie szuflady."
		""
		"&7Kolejny tier szuflad pojawi się tutaj, gdy twoja drużyna wejdzie w erę mosiądzu.&r"
	]
	quest.3D3A14CCB9432BE5.title: "Wciąganie i wypychanie"
	quest.3D595F13538C18AA.quest_desc: ["Sam zgniata sztabki, samorodki i podobne przedmioty w bloki. Magazyn rud zajmie mniej miejsca."]
	quest.3D8072BD295FA626.quest_desc: [
		"Szaty maga ulepszysz w aparacie zaklinającym: połóż je na środku, a na piedestałach płomienne różdżki. Szaty drugiego stopnia mają większe gniazda na nici."
		""
		"&7Trzeci stopień wymaga materiałów z Endu.&r"
	]
	quest.3D8072BD295FA626.title: "Mocniejsze szaty"
	quest.3D82324A7CE81778.quest_desc: ["Pokazuje w jednym oknie, z wyszukiwarką, zawartość wszystkich skrzyń podłączonych do złącza. Postaw go na złączu ekwipunku albo na skrzyni obok."]
	quest.3D82324A7CE81778.quest_subtitle: "Kamień milowy"
	quest.3D82324A7CE81778.title: "&b{block.toms_storage.storage_terminal}"
	quest.3D8AD0AC7FA6631E.quest_desc: ["Sprzęga i rozprzęga wagony w biegu, bez rozbierania pociągu na stacji. Kluczem montażowym wybierzesz tryb i odstęp między płytami."]
	quest.3D954E7B62F20C8C.quest_desc: ["Mechanik robi dla kolonii przedmioty z redstone, szyny i inne mechanizmy. W tej erze budynki kolonii rosną do poziomu 3."]
	quest.3DA31FDEE4F7074E.quest_desc: [
		"&7Era mosiądzu · zalecana diamentowa zbroja i tarcza&r"
		""
		"Frostmaw śpi w śnieżnych biomach i budzi się, gdy podejdziesz. Umvuthi rządzi plemieniem Umvuthana z gaju na sawannie. Żelazny strażnik czeka w podziemnej komnacie."
		"&7Strażnika chroni zbroja z przodu: uniknij ciosu i uderz go w plecy.&r"
	]
	quest.3DA31FDEE4F7074E.title: "Trzy legendy"
	quest.3DA37BF540645C19.quest_desc: ["Tnie pień na sześć desek, a przy okazji sypie trociny."]
	quest.3DA85C536586522F.quest_desc: ["Pylon naprawia przedmioty z pobliskich podstawek za duchy i materiał, z którego je zrobiono."]
	quest.3DAFED48E313520A.quest_desc: ["Leśna gospoda Dungeons Arise, dziś pełna niechcianych gości."]
	quest.3DAFED48E313520A.title: "Gospoda w zielonym lesie"
	quest.3DB1F2573EB7B506.quest_desc: ["Kurier rozwozi zapasy z magazynu kolonii i spełnia prośby pracowników bez twojej pomocy. Przy większej kolonii przyda się kilku."]
	quest.3DB1F2573EB7B506.title: "Kurier"
	quest.3DE8D8C5006D1A67.quest_desc: ["Katalizator przed wiatrakiem zastępuje wodę albo lawę: wiatrak płucze albo topi przedmioty, a w bazie nie leje się nic ani nic nie płonie. Pusty katalizator napełnisz wiadrem."]
	quest.3DE8D8C5006D1A67.title: "Katalizatory wiatraka"
	quest.3DF428EBF85FFFFA.quest_desc: ["Stawia najwięcej bloków naraz ze wszystkich różdżek konstrukcyjnych i wytrzymuje najdłużej. Zrobisz ją ze sztabki netherytu i patyka."]
	quest.3DF428EBF85FFFFA.quest_subtitle: "Kamień milowy"
	quest.3DF428EBF85FFFFA.title: "&e{item.constructionstick.netherite_stick}"
	quest.3DFBCE899F41064E.quest_desc: ["Drzwi i klapy kolejowe otwierają się same, gdy pociąg staje na stacji, i zamykają przed odjazdem."]
	quest.3DFBCE899F41064E.title: "Drzwi pociągu"
	quest.3DFEE7818FF6CCA9.quest_desc: ["Zaginiona cytadela kryje się w Netherze za magiczną barierą. Strzegą jej starożytni rycerze, z których wypada &a{item.irons_spellbooks.cinder_essence}&r."]
	quest.3DFEE7818FF6CCA9.title: "Cytadela"
	quest.3E18E22D4538637F.quest_desc: ["Era atomu to ostatni poziom świata, Zenit. Najrzadszy łup i najtwardsze potwory zostają z tobą do końca gry."]
	quest.3E18E22D4538637F.title: "Poziom świata: Zenit"
	quest.3E1E581B815C8B3E.quest_desc: [
		"Wrzucasz do niej zaczarowane księgi, a ona zbiera ich zaklęcia i wydaje je na nowe księgi o wybranym poziomie, do swojego limitu. Robisz ją ze skrzyni Endu, nasyconych półek i stołu do zaklinania."
		""
		"&7Kolejny tier zaklinania pojawi się tutaj, gdy twoja drużyna wejdzie w erę okultyzmu.&r"
	]
	quest.3E5FD840601E8701.quest_desc: ["Postaw tygiel nad ogniem, nalej wody i poczekaj, aż zawrze. Składniki dodajesz krokami, a kolejność i mieszanie podaje księga."]
	quest.3E63AC5C1099D9D5.quest_desc: ["Elytry wiszą na statkach przy miastach Endu. Z fajerwerkami polecisz nad całym światem."]
	quest.3E6647243FAAC6EE.quest_desc: ["Kowal robi narzędzia i zbroje dla mieszkańców, a hutnik przetapia rudy z magazynu kolonii. Górnicy i strażnicy nie czekają już na ciebie."]
	quest.3E6647243FAAC6EE.title: "Kowal i huta"
	quest.3E7C3FCAAA5EA089.quest_desc: ["Żądła zostawiają pszczoły z Bumblezone. Trafiają się też w skrzyniach ula."]
	quest.3E7F308039DE6345.quest_desc: ["Stół jubilerski z miedzi i desek. Według wzoru składasz na nim pierścienie i naszyjniki z metalu i kamieni szlachetnych."]
	quest.3E899BBEACE9736D.quest_desc: [
		"&7Era okultyzmu · zalecane: netherytowa zbroja, łuk&r"
		"Wielki ghast płacze ognistymi łzami i strzela ogniem ze szczytu wieży."
	]
	quest.3E899BBEACE9736D.quest_subtitle: "Boss"
	quest.3E899BBEACE9736D.title: "&c{entity.twilightforest.ur_ghast}"
	quest.3EAB7CF20CCA6468.quest_desc: ["Trzyma dużo jednego przedmiotu, jak szuflada. Prawym kliknięciem wkładasz, lewym wyjmujesz stos, a lej i transporter zabiorą zawartość od spodu."]
	quest.3EC453AB636328FF.quest_desc: ["Pustą płytkę ubijesz w tyglu z kamienia, redstone'u, żelaza i kwarcu, a aplikator położy na niej miedziany drut z New Age. Obwód trafi do pieczęci."]
	quest.3EC453AB636328FF.quest_subtitle: "Składnik pieczęci"
	quest.3ECB2A06092357F7.quest_desc: [
		"Żyroskopowe łożysko śmigła samo przechyla śmigło ku górze i stabilizuje maszynę, więc śmigłowiec nie przewróci się w locie. Mechanizm żyroskopowy powstaje w montażu sekwencyjnym."
		""
		"&7Ponder (przytrzymaj W nad przedmiotem) pokaże, jak to złożyć.&r"
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę elektryczności.&r"
	]
	quest.3ECB2A06092357F7.quest_subtitle: "Kamień milowy"
	quest.3ECB2A06092357F7.title: "&6Śmigłowiec"
	quest.3ED83B409D9C3F8A.quest_desc: ["Akumulator postawiony na zbiorniku zamienia wodę w płynny sal amoniak. Z kryształem sal amoniaku w środku daje go dziesięć razy więcej."]
	quest.3ED83B409D9C3F8A.title: "Sal amoniak"
	quest.3EE79D8D927E2C20.quest_desc: ["Terminal z siatką rzemiosła. Składniki bierze prosto z magazynu, a JEI wypełni siatkę jednym kliknięciem."]
	quest.3F1104AB789A0848.quest_desc: ["Osiem pustych run w pierścieniu wokół ołtarza podnosi go na pierwszy poziom. Runy na bokach możesz potem zamienić na runy ulepszeń."]
	quest.3F1104AB789A0848.title: "Pierwszy poziom ołtarza"
	quest.3F231F29B59523E6.quest_desc: ["Przyzywa sługi zombie. Powstaje w rytuale nekroturgii, który odprawisz nocą: wokół ołtarza 16 kamiennych płyt, 16 bloków sculku albo ziemi grobowej i 8 doniczek z roślinami."]
	quest.3F7281A440F05E75.quest_desc: [
		"Kontenery postawione obok siebie łączą się w jeden duży magazyn, do 3 bloków szerokości i dowolnej długości. Lejki i taśmy wkładają i wyjmują przez każdą ścianę."
		""
		"&7Najedź na kontener i wciśnij &bW&7, a Ponder pokaże, jak go rozbudować.&r"
	]
	quest.3F7281A440F05E75.quest_subtitle: "Kamień milowy"
	quest.3F7281A440F05E75.title: "&b{block.create.item_vault}"
	quest.3F7BB169259FAD98.quest_desc: ["Z desek zbudujesz stół, a z nim siatkę 3×3 na lepsze narzędzia."]
	quest.3F8C6BD063CBDF84.quest_desc: ["Leży w zakopanych skarbach, rzadziej w skarbach wraków."]
	quest.3F8D3EB406CC3903.quest_desc: ["W lodowym więzieniu tkwi &c{entity.cataclysm.maledictus}&r. Drogę wskaże &a{item.cataclysm.cursed_eye}&r."]
	quest.3F8D3EB406CC3903.title: "Mroźne więzienie"
	quest.3FCC56C1A42554E7.quest_desc: [
		"Magazynuje FE i oddaje je ściankami, które ustawisz konfiguratorem. W swoich gniazdach doładuje też urządzenia."
		""
		"&7Maszyny i przerób rud Mekanismu są na sąsiedniej stronie.&r"
	]
	quest.3FD6C1E37EADC441.quest_desc: ["Ogromna budowla Dungeons Arise na najśmielszych odkrywców. Idź z drużyną."]
	quest.3FD6C1E37EADC441.title: "Tyfon"
	quest.3FE8CE8AD6A9F43F.quest_desc: ["Komponent w obudowie to komórka. Większe komponenty powstają z mniejszych, a pustą komórkę rozłożysz z powrotem, używając jej z wciśniętym Shiftem."]
	quest.3FE8CE8AD6A9F43F.title: "Większe komórki"
	quest.3FF538620BFCFA50.quest_desc: ["Piekarz piecze chleb i ciasta ze zboża od farmera. Mieszkańcy potrzebują zboża w diecie."]
	quest.3FF538620BFCFA50.title: "Piekarnia"
	quest.3FFA0CC0B07167EE.quest_desc: ["Pokazuje biomy i budowle Lasu Zmierzchu, także dziedziniec Nagi i wieżę Licza. Przepis na fokus mapy pokaże JEI; z papierem da pustą mapę, którą wypełnisz w Lesie."]
	quest.401584863A47007E.quest_desc: [
		"&7Ekwipunek: dobra zbroja i sposób na szybki unik.&r"
		"Strzeże Kuźni Golemów w Eternal Starlight. Strzela laserem i szarżuje."
	]
	quest.401584863A47007E.quest_subtitle: "Boss"
	quest.401584863A47007E.title: "&c{entity.eternal_starlight.starlight_golem}"
	quest.403CEF635859CB24.quest_desc: ["Rudę głębosrebra wykopiesz w kamieniach tego wymiaru i przetopisz w piecu. To podstawowy metal Eternal Starlight."]
	quest.403CEF635859CB24.quest_subtitle: "Kamień milowy"
	quest.403CEF635859CB24.title: "&a{item.eternal_starlight.deepsilver_ingot}"
	quest.4040269B927DA1D4.quest_desc: ["Rzuca zapisane na pergaminie zaklęcie, gdy dostanie sygnał redstone, jak dozownik. Źródło bierze z pobliskich słoików, więc nadaje się do kopania i farm."]
	quest.4048FC365A78209B.quest_desc: ["Miecz Ignisa z netherytowego miecza, ignitium i płomiennej różdżki."]
	quest.405807BF5A8FA85C.quest_desc: ["Rzadka kraina o tęczowych liściach. Zabierz stamtąd sadzonkę tęczowego dębu."]
	quest.405807BF5A8FA85C.title: "{biome.twilightforest.enchanted_forest}"
	quest.407F52EA79FA5CB4.quest_desc: ["Rytuał Goety z echem pustki zmienia fokus bombardowania w fokus gwiezdny."]
	quest.408B2E5B80998568.quest_desc: ["Krąg rysujesz krwią: gdy oberwiesz, szybko wciśnij klawisz rysowania kręgu. Sztyletem zranisz się w dowolnej chwili."]
	quest.408F2BDCC4644279.quest_desc: ["Obudowę MEGA zrobisz ze stali nieba. Z komponentem 1M mieści tyle co 4 komórki 256k z AE2, a pasuje do zwykłego napędu."]
	quest.408F2BDCC4644279.title: "Komórka 1M"
	quest.4093464697116D46.quest_desc: ["Miedziana różdżka stawia więcej bloków naraz i dłużej wytrzymuje."]
	quest.409D70C16EB92062.quest_desc: ["Zostawiają ją roztrzaskani, stwory z kości i sculku. Leży też w świątyni."]
	quest.40AD22F31ABBD481.quest_desc: ["Zbierzesz go, rozbijając świecące bloki pod sufitem Netheru. Cztery porcje składają się z powrotem w blok."]
	quest.40BF1A6B2C32A39E.quest_desc: ["Zostawia je prastrażnik z monumentu oceanicznego."]
	quest.40C6BDAEC3DDCF37.quest_desc: [
		"&7Era run · zalecana żelazna zbroja i mikstury leczenia.&r"
		""
		"Nieumarły władca walczy wręcz i rzuca zaklęcia, a do pomocy przyzywa nieumarłych."
		"Śpi w sercu Katakumb."
	]
	quest.40C6BDAEC3DDCF37.quest_subtitle: "Boss"
	quest.40C6BDAEC3DDCF37.title: "&c{entity.irons_spellbooks.dead_king}"
	quest.40E4C3CA84687C95.quest_desc: ["Paliwo silników odrzutowych. Koła kruszące wycisną żywicę z pni świerku, a mikser zrobi z niej terpentynę."]
	quest.40F37D6A49FCCB26.quest_desc: [
		"Ładownica to tłok, który głowicą stempla wpycha pocisk i ładunki do lufy, a głowicą wyciora wyciąga je z powrotem. Połącz ją z lejkami i działo naładuje się samo."
		""
		"&7Ponder (przytrzymaj W nad przedmiotem) pokaże cały proces.&r"
	]
	quest.40F37D6A49FCCB26.title: "Ładownica"
	quest.40FE70033980B7D2.quest_desc: ["Ruchoma maszyna zabiera ze sobą bloki sklejone superklejem. Zaznacz klejem obszar od rogu do rogu, a wszystko w środku ruszy razem z tłokiem, łożyskiem albo suwnicą."]
	quest.40FE70033980B7D2.title: "Sklejanie"
	quest.410407F8C89BB288.quest_desc: ["Przenośny interfejs magazynu na ruchomej maszynie wymienia przedmioty z drugim interfejsem, gdy maszyna przy nim stanie. Tak rozładujesz wózek górniczy albo pociąg bez rozbierania go."]
	quest.410407F8C89BB288.title: "Przeładunek w biegu"
	quest.4104ADCA0F8CA4D3.quest_desc: ["Wielkie gniazdo na wyspie, dodane przez Explore Ruins Aether. Zajrzyj, co w nim zostało."]
	quest.4104ADCA0F8CA4D3.title: "Gniazdo moa"
	quest.41056068F0BF7358.quest_desc: ["Prześladowca może zostawić kryształ dusz. Trafi do kostura dźwięku i elytr dusz."]
	quest.4112A643EB83D893.quest_desc: ["Flaszka z ołtarza. W Tabula Vitae dodasz do niej efekty mikstur i przedłużysz ich działanie."]
	quest.411E0DEDA4971DCA.quest_desc: ["Create Deco dodaje do stopu andezytu okna, kładki, kraty, drzwi i podpory. Większość zrobisz w przecinarce prosto ze stopu."]
	quest.411E0DEDA4971DCA.title: "Andezytowy wystrój"
	quest.41235A8483B6D528.quest_desc: ["Zbierz 32 odłamki rtęci. Rtęć to jeden z trzech filarów alchemii Theurgy, obok soli i siarki; dwa odłamki trafią do pieczęci."]
	quest.41235A8483B6D528.quest_subtitle: "Kamień milowy"
	quest.41235A8483B6D528.title: "&dAlchemia rtęci"
	quest.412CF0E07D1C721F.quest_desc: ["Łączy pył albo klejnoty z kamieniem w bloki rud. Przyda się, gdy chcesz wykopać rudę jeszcze raz z Fortuną."]
	quest.413F385ECBC36322.quest_desc: ["Incendium dodaje własne krainy: kwarcowe równiny, uschnięty las i piekielne wydmy. W każdej stoją inne budowle."]
	quest.413F385ECBC36322.title: "Krainy Incendium"
	quest.4156E4ACAA1C7F57.quest_desc: ["Smoczą łuskę połącz z żelazem i tajemnym pyłem, a dostaniesz srebrną; z pryzmarynem i tajemnym pyłem dostaniesz wodną. Łuski wypadają ze smoka i leżą w skarbcach miast Endu."]
	quest.4156E4ACAA1C7F57.title: "Smocze łuski"
	quest.4171FEAB75ADBDFA.quest_desc: [
		"Na piedestałach i stojakach z runicznego drewna wokół ołtarza duchów leżą dodatkowe składniki nasycania. Większe przepisy potrzebują ich kilku."
		""
		"&7Te zadania rozwijają gałąź Malum z rozdziału ery okultyzmu.&r"
	]
	quest.4171FEAB75ADBDFA.title: "Podstawki ołtarza"
	quest.41A9C912CD4AF3D1.quest_desc: [
		"Działa jak totem nieśmiertelności, ale nie znika: po śmiertelnym ciosie wystarczy go doładować. Doładowanie kosztuje sporo źródła."
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę okultyzmu.&r"
	]
	quest.41AB6CCEE0C1499C.quest_desc: ["Rdzeń wiatru z rytuału nieba. Na nim opierają się fokusy wiatru: podmuchy, wzloty i cyklony."]
	quest.41B1CE2F5BC0B782.quest_desc: ["Pokazuje opór, napięcie, natężenie i moc urządzenia oraz bilans całej sieci. Bez niego szukanie usterek to zgadywanie."]
	quest.41B3352DC4D66AB9.quest_desc: [
		"Gdy zdobędziesz kamienie milowe tej ery, oddaj &6Pieczęć Ery Elektryczności&r. Cała twoja drużyna wejdzie w erę elektryczności, a pieczęć przepadnie."
		""
		"Pieczęć zrobisz w aparacie zaklinającym Ars Nouveau za 10 000 źródła: tajemny kryształ jako odczynnik, a na piedestałach 2 sztabki deorum, 2 odłamki rtęci, znak mistrzostwa, stalowa obudowa oraz trofea Ignisa albo Netherytowej Potworności i drugiego bossa tej ery."
		""
		"&7Dokładny przepis zobaczysz w JEI: najedź na pieczęć i wciśnij R.&r"
	]
	quest.41B3352DC4D66AB9.quest_subtitle: "Oddaj pieczęć"
	quest.41B3352DC4D66AB9.title: "Brama: Era Elektryczności"
	quest.41BCFE74B5FC717C.quest_desc: ["Zrób alternator albo cewkę generatora: każde z nich zamieni obroty Create w prąd. Od tej chwili twoja baza ma elektryczność."]
	quest.41BCFE74B5FC717C.quest_subtitle: "Kamień milowy"
	quest.41BCFE74B5FC717C.title: "&6Pierwszy prąd"
	quest.41CAF448D8DCF4A4.quest_desc: [
		"Ustaw na jednym zbiorniku dwanaście gwizdków, każdy o innym tonie. Kocioł zagra jak organy w katedrze."
		""
		"&7To ukryte osiągnięcie Create.&r"
	]
	quest.41CAF448D8DCF4A4.title: "Organy parowe"
	quest.41D42D1E815ED5DF.quest_desc: ["Wielka kolumna w sercu wymiaru, w której mieszka królowa pszczół. Miodowy kompas wskaże do niej drogę."]
	quest.41D42D1E815ED5DF.quest_subtitle: "Kamień milowy"
	quest.41D42D1E815ED5DF.title: "&aTron królowej"
	quest.41DA6E3A4F2F2021.quest_desc: ["Miej naraz 256 sztabek elektrum. Złoto niech samo jedzie taśmociągiem pod transformatory Tesli, a gotowe sztabki trafiają do magazynu."]
	quest.41DA6E3A4F2F2021.quest_subtitle: "Dowód automatyzacji"
	quest.41DA6E3A4F2F2021.title: "Huta elektrum"
	quest.41F4B86B2EF0FA10.quest_desc: ["Mieszanka ołowiu i żelaza przetopiona w piecu. Ten magicznie obojętny stop to podstawa stołu roboczego, tygla i koksownika Eidolonu."]
	quest.41FDCDC8504478CE.quest_desc: ["Inkubator łączy rtęć, sól i siarkę z trzech naczyń w nowy przedmiot. Siarka złota, odłamek rtęci i sól mineralna dają sztabkę złota: tak rozmnożysz metale i klejnoty."]
	quest.41FDCDC8504478CE.title: "Inkubator"
	quest.41FE901FE9A53C5A.quest_desc: [
		"Zbuduj podstawę z polerowanego ciemnego kamienia, postaw na środku stół kowalski i posyp go pyłem Mundabitur, a zamieni się w kuźnię. Popatrz na gotową kuźnię."
		""
		"&7Układ bloków pokazuje Ponder (W) na kuźni Hefajstosa.&r"
	]
	quest.41FE901FE9A53C5A.quest_subtitle: "Kamień milowy"
	quest.41FE901FE9A53C5A.title: "&dKuźnia Hefajstosa i deorum"
	quest.4206200054461625.quest_desc: ["Przetop tajemny kryształ w piecu, a dostaniesz pył. To podstawa pyłu Mundabitur, deorum i butelek aurealu."]
	quest.4237ECDAFAA60356.quest_desc: [
		"&7Ekwipunek: najlepsza zbroja i mikstury leczenia.&r"
		"Władczyni burz na szczycie akropolu. Ciska włócznią i sprowadza burzę."
	]
	quest.4237ECDAFAA60356.quest_subtitle: "Boss"
	quest.4237ECDAFAA60356.title: "&c{entity.cataclysm.scylla}"
	quest.42406B5E2D1EEA61.quest_desc: [
		"Tryb anioła stawia blok po drugiej stronie tego, na co patrzysz. Z blokiem w drugiej ręce kliknij w powietrze, a postawisz go w pustce."
		""
		"&7Szablon zakładasz na stole kowalskim: różdżka, szablon i pióro.&r"
		""
		"&7Kolejny tier różdżek pojawi się tutaj, gdy twoja drużyna wejdzie w erę mosiądzu.&r"
	]
	quest.4244585361BB6131.quest_desc: ["Do areny w głębi Netheru prowadzi oko płomieni. Czeka tam &c{entity.cataclysm.ignis}&r."]
	quest.4244585361BB6131.title: "Płonąca arena"
	quest.424508F6826A8BFF.quest_desc: ["Zamienia energię FE z generatorów na energię AE. Postaw go przy kablu sieci i doprowadź do niego prąd."]
	quest.424FB675EA5DBCDF.quest_desc: ["Polon, pył fluorytu i woda w komorze reakcji ciśnieniowych dają kulkę polonu. Cztery trafią do pieczęci."]
	quest.424FB675EA5DBCDF.quest_subtitle: "Kamień milowy · składnik pieczęci"
	quest.424FB675EA5DBCDF.title: "&6{item.mekanism.pellet_polonium}"
	quest.425E6A82339427D2.quest_desc: ["Wschód słońca ustawia dzień, zapadnięcie księżyca noc, a kształtowanie chmur zmienia pogodę. Tabliczkę kładziesz na kotle rytualnym i klikasz go pustą ręką."]
	quest.425E6A82339427D2.title: "Rytuał nieba"
	quest.42628AB33DAC6311.quest_desc: ["Blok gwiezdnolitu na kuźni, a na piedestałach 4 katalizatory sculku, 2 mroczne gwiazdy Netheru i 2 smocze łuski. Rytuał pochłonie 5000 aurealu, 20 000 krwi i 500 dusz."]
	quest.42628AB33DAC6311.quest_subtitle: "Kamień milowy"
	quest.42628AB33DAC6311.title: "&dKuźnia: poziom V"
	quest.426755395D657D20.quest_desc: ["Nieumarły zabity tą kosą rozpada się w odłamki duszy, więc nie musisz już czekać na rytuał krystalizacji. Podarte płótno do niej wypada z upiorów ({entity.eidolon_repraised.wraith})."]
	quest.426C357A7A6AF606.quest_desc: ["Pokazuje kanały i zużycie energii sieci, a w środku trzyma karty ulepszeń pod ręką."]
	quest.4272245B725F5412.quest_desc: ["Z tlenem robi z bloku złoża trzy grudki. Tlen da separator elektrolityczny z wody."]
	quest.42727D580844C4DB.quest_desc: ["Kaplica Structory porzucona dawno temu. Zajrzyj do środka."]
	quest.42727D580844C4DB.title: "Opuszczona kaplica"
	quest.4285DDCBAFB1B4AD.quest_desc: ["Kopiuje fragment budowli i wkleja go w innym miejscu. Bloki bierze z ekwipunku albo z podpiętego pojemnika."]
	quest.42B61F704E7B5787.quest_desc: ["Wełna z tajemną esencją. Z tej tkaniny uszyjesz szaty maga i oprawisz lepsze księgi."]
	quest.42D486F4378BAE36.quest_desc: ["Paciorki, pas, szata i sandały ze skrzyń klasztoru i od Rzeźbiarza. Każda część daje inną premię, np. paciorki wzmacniają ciosy pięścią i rękawicą rozdzierania ziemi."]
	quest.42D486F4378BAE36.title: "Strój geomanty"
	quest.42D4D5EB7D55CCAB.quest_desc: ["Na stole kowalskim połącz go z kielnią i odbiornikiem bezprzewodowym. Kielnia będzie brać bloki prosto z sieci ME, w zasięgu punktu dostępowego."]
	quest.42D6417EB7297FCF.quest_desc: [
		"Zwiększa liczbę bloków, które tryb różdżki postawi jednym kliknięciem. Zakładasz go na kielnię z trybem różdżki."
		""
		"&7Kolejny tier kielni pojawi się tutaj, gdy twoja drużyna wejdzie w erę elektryczności.&r"
	]
	quest.42E8FDA937B7D4F6.quest_desc: ["Pilnuje zapasu jednego przedmiotu i sam zamawia składniki z sieci. Połączone mierniki prowadzą całą fabrykę."]
	quest.42FBFD3FBFFA1090.quest_desc: ["Księga ucznia: złoto, tajemna esencja i skóra hoglina. Więcej miejsca na zaklęcia i premia do many."]
	quest.4305ADA504007534.quest_desc: ["Warownia piglinów pełna złota. Załóż coś złotego, zanim wejdziesz."]
	quest.4305ADA504007534.title: "Donżon piglinów"
	quest.430851F998CBAD5F.quest_desc: ["Piła ścina drzewa i tnie pnie na deski. Zwrócona w górę przetwarza przedmioty z taśmy jak przecinarka."]
	quest.430F68B6F75A455E.quest_desc: ["Szkarłatne żelazo z różdżką płomienia i magmowym kremem. Z tej stali zbudujesz kuźnię stopów."]
	quest.43274603A9F19AD3.quest_desc: ["Zbiera doświadczenie z okolicy i przechowuje je w skrzyni. Przepis wymaga oka Endera i butelki z doświadczeniem."]
	quest.4342B25F5E9890EA.quest_desc: [
		"&7Era run · zalecana żelazna zbroja, łuk i dużo wolnego miejsca.&r"
		""
		"Najgroźniejszy z wildenów. W walce wpada w szał i niszczy otoczenie."
		"Przywołasz go rytuałem w kotle rytualnym, z kolcem, rogiem i skrzydłem wildena."
	]
	quest.4342B25F5E9890EA.quest_subtitle: "Boss"
	quest.4342B25F5E9890EA.title: "&c{entity.ars_nouveau.wilden_boss}"
	quest.4349B5F91B73092B.quest_desc: [
		"Otworzy je tylko właściciel albo jego drużyna, jak ustawisz w zabezpieczeniach. Skrzynię otworzysz też prosto z ekwipunku."
		""
		"&7Kolejny tier magazynu Mekanism pojawi się tutaj, gdy twoja drużyna wejdzie w erę atomu.&r"
	]
	quest.4349B5F91B73092B.title: "Schowki osobiste"
	quest.43639424B8FFBD44.quest_desc: ["Budowniczy buduje i ulepsza tylko do poziomu własnej chaty. Rozbuduj ją, zanim podniesiesz inne budynki na poziom 2."]
	quest.43639424B8FFBD44.quest_subtitle: "Kamień milowy"
	quest.43639424B8FFBD44.title: "&3Budowniczy na poziomie 2"
	quest.4369A96D0CC1C2C6.quest_desc: ["Każdy kolejny nasycacz powstaje z poprzedniego. Nasyca przedmioty na składnicy albo taśmociągu pod sobą, gdy ma prąd i obroty."]
	quest.4369A96D0CC1C2C6.title: "Lepsze nasycacze"
	quest.43715FC0EC59A07B.quest_desc: ["Róg Netherytowej Potworności. Na stole kowalskim zamieni netherytowy hełm w potworny hełm."]
	quest.437274230ED5B359.quest_desc: ["Pokonaj jednego z czterech bossów Endu. Jego trofeum to pierwsza część pieczęci z bossów."]
	quest.437274230ED5B359.quest_subtitle: "Kamień milowy"
	quest.437274230ED5B359.title: "&cBoss Endu"
	quest.438252F33363AE09.quest_desc: ["Znak technomancji albo mistrzostwa, netheryt i mosiądz zamieniają szaty Ars w strój technomanty: lekki artyficera, średni technomanty albo ciężki machinogwardzisty. Ciężki hełm wymaga gogli inżyniera."]
	quest.438252F33363AE09.title: "Strój technomanty"
	quest.43CBC1B274368298.quest_desc: [
		"Kontroler łączy stykające się skrzynie i beczki w jeden magazyn z jednym oknem. Wkładane przedmioty same trafiają tam, gdzie już takie leżą."
		""
		"&7Magazyn rośnie, dopóki kolejne skrzynie dotykają kontrolera albo siebie nawzajem.&r"
	]
	quest.43CBC1B274368298.quest_subtitle: "Kamień milowy"
	quest.43CBC1B274368298.title: "&bJeden magazyn"
	quest.43E27B5107E91049.quest_desc: ["Setki mebli z każdego drewna: krzesła, stoły, biurka, szafki i całe kuchnie. Pasuje dowolny mebel tego moda."]
	quest.43E27B5107E91049.title: "Meble Macaw's"
	quest.43E29DE0758CF5F9.quest_desc: [
		"&7Era okultyzmu · zalecana netherytowa zbroja i ognioodporność&r"
		""
		"Apostoł Goety przychodzi na wezwanie rytuału na mrocznym ołtarzu i walczy ogniem oraz przyzwanymi sługami."
		"Echo Tyrosa, pierwszego władcy ognia, odpowie na przyzywacz dusz użyty w zaginionej cytadeli w Netherze."
	]
	quest.43E29DE0758CF5F9.title: "Ogień i mrok"
	quest.43EBD79D73F990D2.quest_desc: ["Akropol wyrasta z morza. Na szczycie czeka &c{entity.cataclysm.scylla}&r, a drogę wskaże &a{item.cataclysm.storm_eye}&r."]
	quest.43EBD79D73F990D2.title: "Akropol"
	quest.43EBF74E9E35C90B.quest_desc: ["Kursium od Potępionego wojownika (Maledictus) i jego szablon ulepszą szatę kriomanty, lodową księgę albo mroźny kostur. Zrób dowolną z tych rzeczy."]
	quest.43EBF74E9E35C90B.title: "Przeklęty mag"
	quest.440B0B30344FC12F.quest_desc: ["Na stole dekoracyjnym zmienisz drewno i kolory skrzyń i beczek, a pędzlem przemalujesz te już postawione."]
	quest.440B0B30344FC12F.title: "Wygląd skrzyń"
	quest.441826DDC76B1386.quest_desc: ["Biblioteka walkirii z Explore Ruins Aether. Walkirie nie lubią, gdy ktoś grzebie w ich księgach."]
	quest.441826DDC76B1386.title: "Biblioteka walkirii"
	quest.441A36E1B4E491FF.quest_desc: ["Niebieska kreda z esencji marida, lazurytu i koralowców rurkowych zamyka jego pentakl. Marid kruszy rudy najszybciej i najwydajniej ze wszystkich duchów."]
	quest.441A36E1B4E491FF.quest_subtitle: "Kamień milowy"
	quest.441A36E1B4E491FF.title: "&dMarid kruszący"
	quest.441C0667FA9A60B9.quest_desc: ["Labirynt w Eternal Starlight. W jego sercu kryje się księżycowa potworność, która gryzie i zieje oddechem."]
	quest.441C0667FA9A60B9.title: "Przeklęty Ogród"
	quest.4429C383792243AC.quest_desc: ["Echo zostawia tę kosę albo sygnet zdrajcy. Zardzewiałą kosę odnowisz później na stole kowalskim."]
	quest.4436ECBC0A7AF774.quest_desc: ["Na stole kowalskim nakłada na gotowe narzędzie albo zbroję powłokę z innego materiału, np. netherytu. Szablon powielisz diamentem i netherrackiem."]
	quest.44374E3108D9D22F.quest_desc: [
		"&d{block.ars_nouveau.enchanting_apparatus}&r działa tylko z &dtajemnym rdzeniem&r przy podstawie. Piedestały z przedmiotami stawiasz do 3 bloków od niego, a główny przedmiot używasz na aparacie."
		"Tu powstanie Pieczęć Ery Mosiądzu."
	]
	quest.44374E3108D9D22F.quest_subtitle: "Kamień milowy"
	quest.44374E3108D9D22F.title: "&dAparat z rdzeniem"
	quest.444D14F45501B109.quest_desc: ["Na stole inskrypcji wpisujesz zwoje do księgi zaklęć Iron's Spells. Pierwsze zwoje najłatwiej znaleźć w skrzyniach lochów, piramid, kopalń i posterunków."]
	quest.444D14F45501B109.quest_subtitle: "Kamień milowy"
	quest.444D14F45501B109.title: "&dStół inskrypcji i pierwszy zwój"
	quest.444EE09EBF742773.quest_desc: ["Generator z Create: New Age. Cewka obracana przez Create daje prąd, gdy otaczają ją magnesy, np. &6{block.create_new_age.redstone_magnet}&r."]
	quest.445B60FF112A6CC3.quest_desc: ["Para interfejsów przeładowuje towar między jadącą maszyną, np. pociągiem, a magazynem na stacji, gdy staną naprzeciw siebie."]
	quest.4461F5E545991680.quest_desc: ["Na piramidzie z bloków metalu albo klejnotów daje drużynie stałe efekty, np. szybkość i siłę."]
	quest.4477AAE405E4923C.quest_desc: [
		"Pcha i ciągnie przyklejoną do siebie konstrukcję, dopóki kręci go napęd. Zasięg wydłużysz przedłużeniami tłoka dołożonymi z tyłu."
		""
		"&7Ponder (przytrzymaj W nad przedmiotem) pokaże, jak to złożyć.&r"
	]
	quest.447B55DBED65E5BE.quest_desc: ["Rycerski metal na miecz, kilof, tarczę i zbroję, która mocniej chroni przed ciosami w zwarciu. Przyda się przed walką z fantomami."]
	quest.447C3401F98593FC.quest_desc: ["Rubin dusz zostawia Wezyr ({entity.goety.vizier}), boss tej ery. Trafia do najmocniejszych fokusów i strojów Goety."]
	quest.448E851CC7A01D07.quest_desc: ["Blok doświadczenia sprasowany na szablon. Płomień zaklinający dopisuje do niego wybrane zaklęcia, a płomień kowalski nakłada je na przedmiot."]
	quest.44928AA0937E885E.quest_desc: ["Glify Ars Technica wykonują przepisy Create na leżących przedmiotach: prasowanie, polerowanie i wirowanie. Wir z wodą, płomieniem albo przetopieniem zastąpi wiatrak z obróbką."]
	quest.44928AA0937E885E.title: "Glify maszyn"
	quest.4499662AA767FC48.quest_desc: ["Przyciąga przedmioty z okolicy i od razu chowa je do plecaka. Powstaje z ulepszenia podnoszenia."]
	quest.449CBC79E6ACFC9A.quest_desc: ["Sawanna z baobabami, pustynia z jukami i bambusowy las. Odwiedź wszystkie trzy."]
	quest.449CBC79E6ACFC9A.title: "Regions Unexplored"
	quest.449DA98CFF972901.quest_desc: ["Po smoku otwierają się bramy na zewnętrzne wyspy. Tam stoją miasta Endu z shulkerami i statkami."]
	quest.449DA98CFF972901.title: "Miasto Endu"
	quest.44B13C087B9CA492.quest_desc: ["Kolejny poziom: jeszcze więcej miejsca i gniazd. Żelazną zrobisz z miedzianej albo prosto ze zwykłej."]
	quest.44BD8C99C83F4C48.quest_desc: ["Bossowie Goety zostawiają sakwę z losowymi skarbami. Otwórz ją prawym przyciskiem."]
	quest.44FF6A6CC350D197.quest_desc: [
		"&7Era run · zalecana żelazna zbroja, łuk i mikstury leczenia&r"
		""
		"Chimerę wildenów przywołasz rytuałem w kotle rytualnym. Umarły Król śpi w sercu podziemnych katakumb."
		"Walki zalicza zadanie bossa w rozdziale ery. Tutaj znajdziesz przygotowania i łupy."
	]
	quest.44FF6A6CC350D197.title: "Bestiariusz magów"
	quest.4506CCF19C17C0ED.quest_desc: ["Rama z teleporterem wokół wolnego miejsca 1×2 przenosi cię do innego teleportera na tej samej częstotliwości, także w innym wymiarze. Każdy skok kosztuje prąd."]
	quest.4506CCF19C17C0ED.title: "Teleporter"
	quest.4521E581E8AA67A6.quest_desc: ["Wypala kamień, cegły i szkło dla innych rzemieślników kolonii."]
	quest.4521E581E8AA67A6.title: "Cegielnia"
	quest.453424F4984DF7EB.quest_desc: ["Ognista świątynia w głębi wielkiej wyspy. Mieszka w niej &c{entity.aether.sun_spirit}&r."]
	quest.453424F4984DF7EB.title: "Złoty loch"
	quest.45460B4B39B0BE16.quest_desc: ["Pokonaj Ignisa albo Netherytową Potworność. Pieczęć następnej ery wymaga trofeum jednego z nich."]
	quest.45460B4B39B0BE16.quest_subtitle: "Kamień milowy"
	quest.45460B4B39B0BE16.title: "&c{entity.cataclysm.ignis} lub {entity.cataclysm.netherite_monstrosity}"
	quest.455B02D3CF032484.quest_desc: ["Daje ciąg z energii FE zamiast z paliwa, gdy dostaje sygnał redstone. Prąd z generatorów tej ery zasili statek, który nie musi tankować."]
	quest.455B02D3CF032484.quest_subtitle: "Kamień milowy"
	quest.455B02D3CF032484.title: "&6{block.createpropulsion.ion_thruster}"
	quest.457BCBC5CAE00563.quest_desc: ["Klucz z piekielnej kuźni: tabliczka Animata, odłamek echa, diament i prosty klucz z lochów. Otwiera przejście do kopalni Bezkresnego Królestwa."]
	quest.45833DDD46DF9B12.quest_desc: ["Drwal ścina drzewa w wyznaczonym obszarze i sadzi nowe. Bez drewna budowniczy szybko stanie."]
	quest.45833DDD46DF9B12.title: "Drwal"
	quest.45925D443A5BCC6F.quest_desc: [
		"Rytuał z przewodnikiem (Conduit), pryzmarynem i łzą ghasta wzywa niezwiązanego marida. Pokonany zostawia esencję."
		"&cMarid jest groźniejszy niż afrit: przyjdź w najlepszej zbroi.&r"
	]
	quest.45ABA8C627F4D586.quest_desc: ["Topór Maledictusa stopiony z ignitium na kowadle fuzji. Do mocy klątwy dochodzi ogień Ignisa."]
	quest.45BC0F6B69535059.quest_desc: [
		"Dziewięć odłamków zbroi złóż w skupisko i przetop je w piecu. Z rycerskiego metalu zrobisz ciężką zbroję i broń."
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę pary i stali.&r"
	]
	quest.45BC0F6B69535059.quest_subtitle: "Kamień milowy"
	quest.45BC0F6B69535059.title: "&a{item.twilightforest.knightmetal_ingot}"
	quest.45C00041CEFA627B.quest_desc: ["Odprowadź rurą płynną stal z wielkiego pieca do misy odlewniczej, a zastygnie w sztabki."]
	quest.45C8C2E1843B20EE.quest_desc: ["Huta na 5. poziomie przetapia bloki złóż tak, jakby kopano je z Fortuną IV."]
	quest.45C8C2E1843B20EE.title: "Huta na 5. poziomie"
	quest.45D3D9F02632AC6E.quest_desc: ["Wioska plemienia na sawannie. Wojownicy w maskach bronią jej, zanim Umvuthi zstąpi do walki."]
	quest.45D3D9F02632AC6E.title: "Gaj Umvuthana"
	quest.45F78B2342A4D844.quest_desc: ["Orichalcum przetopisz z rudy, śmiertelne srebro namoczysz w kotle alchemika ze srebra, a różowe i białe złoto zrobisz w siatce rzemiosła. Idą na broń i wzmocnione szaty."]
	quest.45F78B2342A4D844.title: "Metal Monsters and Spellbooks"
	quest.46186F3DCA5BCF1E.quest_desc: ["Krew Apostoła. Goety potrzebuje jej do najmocniejszych rytuałów, m.in. kamienia filozoficznego i kosy śmierci."]
	quest.4625B78165C91AAF.quest_desc: ["Wypełnij ramę portalu oczami z End Remastered i skocz. Wyspy Endu po zmianach Nullscape są wyższe i dziwniejsze niż zwykle."]
	quest.4625B78165C91AAF.quest_subtitle: "Kamień milowy"
	quest.4625B78165C91AAF.title: "&aEnd"
	quest.4634716F0CB03CED.quest_desc: ["Szybszy zsyp, który przenosi naraz do 64 przedmiotów. Przyda się przy kruszarkach i dużych magazynach."]
	quest.46811C915B911C1B.quest_desc: ["Podziemna twierdza leży w biomie &c{biome.twilightforest.dark_forest}&r Lasu Zmierzchu. Otworzysz ją, kładąc trofeum bossa na piedestale (&c{block.twilightforest.trophy_pedestal}&r)."]
	quest.46811C915B911C1B.title: "Twierdza rycerzy"
	quest.468EABC5C4D55100.quest_desc: ["Przetapia wszystko, co wpada do skrzyni, bez otwierania okna. Rudy z wiertła trafią do niej jako sztabki."]
	quest.469A32D61ED9194B.quest_desc: [
		"Maszyny Mekanismu biorą prąd FE. Uniwersalny kabel doprowadzi go od alternatora albo prądnicy New Age, a kolejne poziomy kabla przeniosą więcej."
		""
		"&7Główną linię Mekanismu znajdziesz w rozdziale Ery Elektryczności. Ta strona ją rozszerza.&r"
	]
	quest.46B8196FC2AACC1D.quest_desc: ["Ciska przedmioty – i graczy – w wybrane miejsce, nawet przez rzekę. Cel wybierasz, klikając go wyrzutnią przed jej postawieniem."]
	quest.46DB9505C212992A.quest_desc: ["Zakazane kawałki zostawiają nekromanci, a leżą też w kryptach. Złóż z nich fragment, potem zwój, i przeczytaj go: odsłoni tajniki tworzenia nekromantów i przemiany w licza."]
	quest.46DB9505C212992A.title: "Zakazana wiedza"
	quest.46DF25873D74E915.quest_desc: ["Podłącz rurę z pompą do ula albo gniazda pszczół, a wyciągniesz z niego miód bez butelek i bez dymu."]
	quest.46DF25873D74E915.title: "Miód z rury"
	quest.46F970F018AE978F.quest_desc: ["&d{item.mahoutsukai.attuner}&r ze złota i lazurytu dostraja diament. Taki klejnot magazynuje manę, a zaklęcia same po nią sięgają."]
	quest.46F970F018AE978F.quest_subtitle: "Składnik pieczęci"
	quest.4714D5F083E309BE.quest_desc: ["Podpalenie, zamrożenie i usidlenie dodają do zaklęć obrażenia i kontrolę nad wrogiem. Wszystkie trzy to glify pierwszego poziomu."]
	quest.4714D5F083E309BE.title: "Glify do walki"
	quest.471B4E4C82E7B021.quest_desc: ["Wielki piec stopi też kwarc. Wylej płynny krzem do misy odlewniczej i odbierz sztabki: krzem trafi do stopu magnetycznego i półprzewodników."]
	quest.471E49F802C04360.quest_desc: ["Komora nasyca lazuryt albo ametyst w klejnoty źródła. Źródło zbiera powoli sama albo pobiera ze słoików do 2 bloków dalej."]
	quest.472ABD9014318EDC.quest_desc: ["Postaw go na napełnionej klatce. Przekazuje energię dusz przyrządom w promieniu około 8 bloków; im więcej świeczników i pełnych klatek, tym szybciej pracują."]
	quest.47311843F2781185.quest_desc: ["Kula proroctwa otwiera portal do Eternal Starlight. Zdobędziesz ją, przechodząc próbę strażnika ruin."]
	quest.474DB46D480C706A.quest_desc: ["Po walce zostaje skrzynia z sercem monolitu. Z łupami innych bossów zrobisz z niego trzy najmocniejsze przedmioty moda."]
	quest.474DB46D480C706A.quest_subtitle: "Kamień milowy"
	quest.474DB46D480C706A.title: "&c{item.bosses_of_mass_destruction.obsidian_heart}"
	quest.475362B010B0186F.quest_desc: ["Era okultyzmu podniosła świat na poziom Wspinaczka. Częściej trafisz epickie przedmioty, ale i potwory biją mocniej."]
	quest.475362B010B0186F.title: "Poziom świata: Wspinaczka"
	quest.4761BC76B44A7603.quest_desc: ["Kryształ z piersi Frostmawa. Przytrzymaj prawy przycisk, a wypuścisz lodowy wir; kryształ ładuje się sam w ekwipunku."]
	quest.4762391CC1A8D060.quest_desc: ["Torba połączona z wybranym pojemnikiem. Kliknij nią przedmiot albo przedmiotem torbę, a trafi on do tego pojemnika."]
	quest.4764DDC7E9F4E32C.quest_desc: ["Z erą run świat twojej drużyny wszedł na poziom Rubież: potwory są silniejsze, a łup rzadszy i lepszy. Poziom świata rośnie razem z erą i nie zmienisz go ręcznie."]
	quest.4764DDC7E9F4E32C.title: "Poziom świata: Rubież"
	quest.477B8E03060F5522.quest_desc: ["Kruchy zbiornik pęka przy uderzeniu i rozlewa zawartość wokół, a płyn działa na wszystko w zasięgu."]
	quest.477FF4557FF38C2C.quest_desc: ["Piec na prąd: przetapia szybciej od zwykłego i nie potrzebuje paliwa. To ostatni krok każdej linii przerobu rud."]
	quest.4790F1D3E0523768.quest_desc: ["Wciąga przedmioty z pojemnika albo maszyny, na którą patrzy, do sieci."]
	quest.47987C4573FAE888.quest_desc: ["Podmienia bloki w zaznaczonym obszarze na inne, bez kopania."]
	quest.479969A980C83F6F.quest_desc: ["Pierwszy klejnot Spiritus zbiera luźne Spiritus z ekwipunku i zasila kuźnię. W kuźni ulepszysz go do coraz większych."]
	quest.479F2F884B9F5589.quest_desc: ["Głęboka jaskinia pod wyżynami, pełna trolli. W jej skarbcu leży lampa, a trolle gubią magiczną fasolę."]
	quest.479F2F884B9F5589.title: "Jaskinia trolli"
	quest.47AA1E5F0349A889.quest_desc: [
		"Andezytowy lejek wyciąga przedmioty z pojemnika i odkłada je na taśmę albo wrzuca do pojemnika z taśmy. Andezytowy tunel łączy taśmociąg z taśmami obok i dzieli między nie przedmioty."
		""
		"&7Ta strona idzie dalej niż drzewo ery: transport, ruchome maszyny i redstone Create. Pakowanie i sieć magazynowa są na stronie magazynów Create.&r"
	]
	quest.47AA1E5F0349A889.title: "Lejki i tunele"
	quest.47C175CF5CE4EAB9.quest_desc: ["Najmocniejszy stabilizator tej ery: rytuał marida z magiczną latarnią i blokiem iesnium. Gwiazdę do latarni da ci Wither."]
	quest.47C175CF5CE4EAB9.quest_subtitle: "Kamień milowy"
	quest.47C175CF5CE4EAB9.title: "&bCzwarty krąg"
	quest.47C4B6051DAD3963.quest_desc: ["Księga zaklęć bossa kultystów. Załóż ją w slot księgi Iron's Spells."]
	quest.47D49A7F40125D41.quest_desc: ["Rozpal ognisko pod ulem albo gniazdem pszczół, a dym je uspokoi. Gdy ul się zapełni, użyj na nim pustej butelki. Zbierz cztery butelki miodu."]
	quest.47D49A7F40125D41.quest_subtitle: "Kamień milowy"
	quest.47D49A7F40125D41.title: "&aMiód z ula"
	quest.47DA4B1A501E44AE.quest_desc: ["Osiem repozytoriów to już prawdziwa biblioteka. Każde z nazwą dostanie własną zakładkę w pulpicie."]
	quest.47DA4B1A501E44AE.title: "Biblioteka"
	quest.47DC0AC141CBD1D0.quest_desc: ["Miedź i cynk w tyglu nad rozpalonym palnikiem: &6{block.create.mechanical_mixer}&r zmiesza z nich po dwie sztabki mosiądzu. Zrób zapas 64 sztuk, bo mosiądz idzie do prawie wszystkiego w tej erze."]
	quest.47DC0AC141CBD1D0.quest_subtitle: "Kamień milowy"
	quest.47DC0AC141CBD1D0.title: "&6{item.create.brass_ingot}"
	quest.47FE4871B261C131.quest_desc: ["Zapisz przepis na formule i włóż ją do automatu. Będzie robił ten przedmiot, dopóki ma składniki i prąd."]
	quest.47FE4871B261C131.title: "Automatyczne rzemiosło"
	quest.480493B3C65ABE63.quest_desc: ["Stań na nim, a doładuje urządzenia w twoim ekwipunku i zbroję."]
	quest.48052DCC9310D768.quest_desc: ["Zamienia gaz w płyn i z powrotem, np. wodę w parę wodną do kwasu siarkowego. Kierunek przełączysz w jego oknie."]
	quest.4809D25D42EE7E86.quest_desc: ["Ołtarz zasilany odłamkami ambrozji zaklina przedmioty Aetheru. Z rudy gravitytu zrobi zaklęty gravityt."]
	quest.4817397C64364879.quest_desc: ["Wyjmuje części z gotowego narzędzia. Tak wymienisz zużytą głowicę bez robienia narzędzia od nowa."]
	quest.481C508DD5F0E61C.quest_desc: ["Para takich interfejsów, jeden w ruchomej maszynie, a drugi w świecie, przekazuje prąd, gdy się miną. Tak naładujesz pociąg na stacji."]
	quest.482018338FB73459.quest_desc: ["Pokonaj jednego z nich. Jego trofeum to pierwsza część pieczęci z bossów."]
	quest.482018338FB73459.quest_subtitle: "Kamień milowy"
	quest.482018338FB73459.title: "&c{entity.undergarden.forgotten_guardian} lub {entity.minecraft.warden}"
	quest.48285B5CC9CA3230.quest_desc: ["Przelewa zawartość komórki do sieci albo z sieci do komórki. Przyda się przy przeprowadzce na większe komórki."]
	quest.482E495996D1D398.quest_desc: ["Wykopiesz go z rudy w netherracku. Przyda się do mechanizmów redstone i do jasnych, gładkich budowli."]
	quest.483F0CC95D6BF23B.quest_desc: ["Sklep Create łączy kolonię z siecią logistyczną: budowniczowie biorą materiały prosto z twojego magazynu Create."]
	quest.48429439A976071E.quest_desc: ["Labirynt plastrów pełen pszczelich skarbów i pułapek. Zabierz pochodnie, żeby znaleźć drogę z powrotem."]
	quest.48429439A976071E.title: "Labirynt komórek"
	quest.484D8D933357FC2C.quest_desc: ["Sześć sanktuariów w sześciu kolorach kryje próby i pszczeli pancerz. Każde jest inne."]
	quest.484D8D933357FC2C.title: "Wieczne sanktuarium"
	quest.4880FE68B2CCC6E5.quest_desc: ["Wojownicy Umvuthana i skrzynie w ich gaju dają maski. Ta noszona daje siłę, a każda z sześciu masek inną premię."]
	quest.488F66BE93D02E80.quest_desc: ["Pszczelarz hoduje pszczoły w ulach przy pasiece i zbiera miód oraz plastry."]
	quest.4890F88AA38D7683.quest_desc: ["Młot kopie kamień i rudy w polu 3×3, a ekskawator tak samo ziemię i piasek. Rudy młot rusza tylko wtedy, gdy celujesz w rudę."]
	quest.4890F88AA38D7683.title: "Kopanie obszarem"
	quest.48AD12DB989B5C16.quest_desc: [
		"Droga prowadzi przez dziesięć er i finał:"
		"&60&r Era Kamienia – przetrwanie i pierwsze narzędzia"
		"&61&r Era Andezytu – Create i pierwsze maszyny"
		"&62&r Era Run – pierwsza magia i Twilight Forest"
		"&63&r Era Mosiądzu – automatyzacja, pociągi i Nether"
		"&64&r Era Okultyzmu – demony, dusze i rytuały"
		"&65&r Era Pary i Stali – stal, ropa, sterowce i Aether"
		"&66&r Era Arkanów – wysoka magia i bossowie Cataclysm"
		"&67&r Era Elektryczności – prąd, Mekanism i AE2"
		"&68&r Era Atomu – reaktory, End i gwiazdy"
		"&69&r Era Transcendencji – połączenie techniki z magią"
		"&6F&r Finał – finałowy boss"
		""
		"Każda era kończy się &6bramą&r. Brama wymaga kamieni milowych z gałęzi rozdziału (romby) i pieczęci następnej ery. Po jej oddaniu cała drużyna przechodzi dalej. Pieczęć ery magicznej wymaga techniki i odwrotnie, a od ery mosiądzu także trofeów dwóch różnych bossów."
		""
		"Przedmiotów z przyszłych er nie użyjesz ani nie postawisz. Podpowiedź na przedmiocie pokazuje, do której ery należy."
	]
	quest.48AD12DB989B5C16.quest_subtitle: "Mapa drogi"
	quest.48AD12DB989B5C16.title: "Ery"
	quest.48B8AB59B58DE069.quest_desc: ["Połącz oko Endu ze źrenicą czarownicy. Źrenice gubią czarownice."]
	quest.48EC084FA6167EF1.quest_desc: ["Badacze odkrywają tu ulepszenia kolonii. Poziom badania nie przekroczy poziomu uniwersytetu, więc badania też idą razem z erami."]
	quest.48EF32E9240E06EA.quest_desc: ["Robot-towarzysz: chodzi za tobą, zbiera upuszczone przedmioty i ma w sobie skrzynię, stół i piec. Doładuje się sam na swojej stacji."]
	quest.48F871BBFDFF6C7A.quest_desc: ["Strzela trzema strzałami naraz, a płaci za jedną. Królowa Śniegu zostawia ten łuk albo łuk tropiciela."]
	quest.490421CD4368201E.quest_desc: ["Sycące dania z garnka dają efekt odżywienia: przez dłuższy czas pasek głodu nie spada. Zjedz takie danie."]
	quest.490421CD4368201E.title: "Pożywny posiłek"
	quest.491077D1F54DE545.quest_desc: [
		"Kliknij naśladowczy blok dowolnym blokiem, a przyjmie jego wygląd. Copycats+ dokłada do paneli i stopni z Create pełne bloki, schody, płotki i inne kształty z cynku."
		""
		"&7Kolejny tier dekoracji pojawi się tutaj, gdy twoja drużyna wejdzie w erę mosiądzu.&r"
	]
	quest.491077D1F54DE545.title: "Naśladowcze bloki"
	quest.4912FEAAB6B229F8.quest_desc: [
		"&7Era pary i stali. Zalecany ekwipunek: zbroja z gravitytu i broń z zanitu.&r"
		"Królowa walkirii czeka w srebrnym lochu na chmurach. Walkę zaczniesz rozmową, gdy masz przy sobie dziesięć medali."
	]
	quest.4912FEAAB6B229F8.quest_subtitle: "Boss"
	quest.4912FEAAB6B229F8.title: "&c{entity.aether.valkyrie_queen}"
	quest.491623F08799E87C.quest_desc: ["Każdy zamach wystrzeliwuje jasny pocisk energii. Rozładowaną różdżkę naładujesz rytuałem przy koksowniku."]
	quest.49186F5EB0E72BA7.quest_desc: ["Arkusz miedzi i arkusz cynku z pochodnią redstone. Kondensator wchodzi w lepsze maszyny elektryczne i w pieczęć."]
	quest.49186F5EB0E72BA7.quest_subtitle: "Składnik pieczęci"
	quest.491E574EABA5BBA0.quest_desc: ["Zamienia obroty z Create w energię FE. Złożysz go na mechanicznym stole rzemieślniczym."]
	quest.4923E04330605183.quest_desc: ["Koło wodne z zamkniętym w nim Starbuncle'em kręci się bez wody i wiatru. Zrobisz je z amuletu Starbuncle i koła wodnego."]
	quest.4931415A1D336B9F.quest_desc: ["Chatę rybaka postaw blisko wody. Ryby to tanie i pewne jedzenie dla kolonii."]
	quest.4931415A1D336B9F.title: "Rybak"
	quest.49472A325F39AA35.quest_desc: [
		"Szkarłatna stal, lazurowe elektrum, kruszona skorupa shulkera i okruch netherytu, połączone w kuźni stopów. Najmocniejszy metal Silent Gear."
		""
		"&7Skorupę shulkera skruszysz młotkiem na kamiennym kowadle.&r"
	]
	quest.49472A325F39AA35.quest_subtitle: "Kamień milowy"
	quest.49472A325F39AA35.title: "&6{item.silentgear.tyrian_steel_ingot}"
	quest.4966648FF35CF1BC.quest_desc: ["Samotna wieża Structory: Towers na zewnętrznych wyspach."]
	quest.4966648FF35CF1BC.title: "Wieża Endu"
	quest.497276E913CE7B0E.quest_desc: ["Wiatrak zajęty przez illagerów. To mały loch Dungeons Arise, w sam raz na początek."]
	quest.497276E913CE7B0E.title: "Wiatrak illagerów"
	quest.497813C8FE2FC820.quest_desc: ["Mieszkańcy ćwiczą tu strzelanie i wychodzą jako lepsi łucznicy."]
	quest.497813C8FE2FC820.title: "Szkoła łucznicza"
	quest.49A3DD1E6A520D4A.quest_desc: ["Filtr identyfikacji wyklucza z namierzania wybranych graczy i statki, a transponder oznacza twój statek jako swój. Działa nie strzelą do sojuszników."]
	quest.49A3DD1E6A520D4A.title: "Swój czy obcy"
	quest.49AB70FE5018B65E.quest_desc: ["Silnik źródła zamienia źródło z pobliskiego słoika w obrót dla maszyn Create. Prędkość i stosunek JO do obr./min ustawisz na nim samym; większa moc kosztuje więcej źródła."]
	quest.49B037170BF0C4EC.quest_desc: ["Lodowy kolec z fokusu mroźnego oddechu i niebieskiego lodu. Zaklęcia mrozu spowalniają i zamrażają cele."]
	quest.49C18231A95AFC82.quest_desc: ["Ulepszone elytry z kryształem dusz, kością sculku i pyłem dusz."]
	quest.49D45418C8713BE5.quest_desc: ["Mosty linowe i kamienne, schody na strych i balkony, lampy uliczne i żyrandole oraz klapy w wielu stylach."]
	quest.49D45418C8713BE5.title: "Mosty, schody i lampy"
	quest.49DA6C971F3AAA52.quest_desc: [
		"Oko Endu nie wskaże tu drogi. Twierdzę z portalem do Endu znajdziesz kompasem odkrywcy."
		""
		"&7Rama portalu przyjmuje tylko oczy z End Remastered, każde z innego źródła. Ich listę znajdziesz na stronie &aEnd&7 w zakładce Świat.&r"
	]
	quest.49DA6C971F3AAA52.title: "Twierdza"
	quest.49E08EB34B573131.quest_desc: ["Cztery odłamki netherytu i cztery sztabki złota dają sztabkę. W tej erze netheryt w końcu się przydaje."]
	quest.49EC6CAA2E462A88.quest_desc: ["Kryształ postawiony gdziekolwiek pokazuje widok ze swojego miejsca, a okular pozwala przełączać się między kryształami. Pilnujesz farm bez chodzenia do nich."]
	quest.49EC6CAA2E462A88.title: "Oko wróżbity"
	quest.4A0A7C6B9E905708.quest_desc: ["Szamot leży w warstwach skał pod ziemią, razem z boksytem i galeną. Każdy blok szamotu daje kulkę, a z kulek wypalisz ognioodporne cegły."]
	quest.4A11C5CB82918175.quest_desc: [
		"Oddech smoka w wiadrze z Create: Dragons Plus. Wiatrak dmuchający przez niego albo przez smoczą głowę przemienia przedmioty jak End: bruk w kamień Endu, a skórę w błonę fantoma."
		""
		"&7Kamień Endu z wiatraka przyda się do lewititu na stronie statków powietrznych.&r"
	]
	quest.4A1AC1CB88A29AD1.quest_desc: ["Netherytowa różdżka stawia najwięcej bloków naraz ze wszystkich Construction Sticks i wytrzymuje najdłużej. Zrobisz ją ze sztabki netherytu i patyków."]
	quest.4A2489DE4332C5A2.quest_desc: ["Skrzydło to lekki żagiel dla maszyn: z niego zbudujesz duże śmigło, które mało waży. Wypal skrzydło w piecu, a dostaniesz skrzydło hartowane."]
	quest.4A2489DE4332C5A2.title: "Hartowane skrzydła"
	quest.4A294ABBB64858EE.quest_desc: ["Odlewa całe bloki metalu. Stopiony mosiądz wylany na okorowany pień da od razu mosiężną obudowę, a miedź – miedzianą."]
	quest.4A4346823B3DBF20.quest_desc: ["Mistrz górnik marid przynosi z wymiarowej kopalni najrzadsze rudy. Powstaje z afrita górnika i netherytowego kilofa."]
	quest.4A45B4B47D6D04FD.quest_desc: ["Nosi płyny i nie gubi ich po podniesieniu. Przyda się do tankowania silników w terenie."]
	quest.4A46CB961A0D8CC5.quest_desc: ["Zostawiają go kostki magmy. Mikstura z nim chroni przed ogniem i lawą."]
	quest.4A5690414BCAAD82.quest_desc: ["Podstawy amuletów, pierścieni i pasów. Na stole roboczym zmienisz je w talizmany z efektami, które nosisz w slotach akcesoriów."]
	quest.4A5690414BCAAD82.title: "Proste talizmany"
	quest.4A5E316C6DB55078.quest_desc: ["Metal z serca Ignisa. Ulepszysz nim netherytowy sprzęt i zrobisz broń, która podpala."]
	quest.4A5E316C6DB55078.quest_subtitle: "Kamień milowy"
	quest.4A5E316C6DB55078.title: "&c{item.cataclysm.ignitium_ingot}"
	quest.4A7C47B6ED7DC4D7.quest_desc: ["Z bruku zbudujesz piec. Wytopisz w nim rudy i wypalisz glinę na cegły."]
	quest.4AB3C16CDB159F19.quest_desc: ["Stalowy mechanizm składa się w montażu sekwencyjnym z płytek stali, niklu i ołowiu, stalowych kół zębatych i śrub. Wymagają go maszyny naftowe TFMG."]
	quest.4ACA18D1D53973BF.quest_desc: ["Na linii montażowej pieczęci &6{block.create.spout}&r doleje do niej 500 mB lawy. Doprowadź lawę do wylewki rurą z pompą."]
	quest.4ACA18D1D53973BF.quest_subtitle: "Składnik pieczęci"
	quest.4AD2D93CABC3E791.quest_desc: ["Narysuj kredą pentakl z przepisu, rozłóż składniki w misach i kliknij złotą misę związaną księgą. Pojawi się foliot kruszący, który przerabia rudy na pyły."]
	quest.4AD2D93CABC3E791.quest_subtitle: "Kamień milowy"
	quest.4AD2D93CABC3E791.title: "&dPierwsze przywołanie"
	quest.4ADCB450861E59F8.quest_desc: [
		"Wysoka latarnia na wybrzeżu. Z jej szczytu zobaczysz morze aż po horyzont."
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę mosiądzu.&r"
	]
	quest.4ADCB450861E59F8.title: "Latarnia morska"
	quest.4AE292726D3A215E.quest_desc: ["Drużyna, która nie walczyła z pierwszym smokiem, musi go przywołać jeszcze raz: cztery kryształy Endu na brzegach portalu."]
	quest.4AE42FD665D3B94C.quest_desc: ["Na kowadle rozbiera zaczarowany przedmiot i oddaje część jego zaklęć w księdze. Sam przedmiot przepada."]
	quest.4AF27956B3713CDE.quest_desc: ["Zamiast cylindrów wkładasz do niego łopaty turbiny. Obudowa wymaga aluminiowych rur."]
	quest.4AF27956B3713CDE.title: "Silnik turbinowy"
	quest.4B207ED26FA0DD3B.quest_desc: ["Kawałki gwiezdnolitu wykopiesz z rudy Stella Arcanum, a runy wytopisz z runicznego kamienia. Obie skały leżą głęboko pod ziemią w całym Overworldzie."]
	quest.4B207ED26FA0DD3B.title: "Gwiezdnolit i runy"
	quest.4B252403C7BA10B4.quest_desc: ["Pompa elektryczna z ulepszeniem filtra pompuje ciężką wodę zamiast zwykłej. Separator rozłoży ją na deuter."]
	quest.4B3505E8A8A16522.quest_desc: [
		"Runa ulepszenia i rzadki metal zamieniają szatę szkoły w zbroję bohatera: kriomanta zostaje rycerzem śmierci, pyromanta mistrzem kuźni, a kultysta bohaterem z sanguinitu."
		""
		"&7Runy ulepszenia trafiają się w skrzyniach; kolejne powielisz z mitrylu i tajemnej sztabki.&r"
	]
	quest.4B3505E8A8A16522.quest_subtitle: "Kamień milowy"
	quest.4B3505E8A8A16522.title: "&dWzmocnione szaty"
	quest.4B4EA220D33EE56F.quest_desc: ["Zostawia ją &c{entity.minecraft.ender_dragon}&r. Z deorum zrobisz z niej złotą smoczą łuskę."]
	quest.4B5732B859E520E9.quest_desc: [
		"Mieści dyski QIO i udostępnia je na wybranej częstotliwości. Każdy blok QIO na tej samej częstotliwości widzi te same dyski, bez żadnych kabli."
		""
		"&7Częstotliwość ustawisz w oknie macierzy; może być prywatna albo wspólna dla drużyny.&r"
	]
	quest.4B5732B859E520E9.quest_subtitle: "Kamień milowy"
	quest.4B5732B859E520E9.title: "&b{block.mekanism.qio_drive_array}"
	quest.4B8D07BE131E3100.quest_desc: ["Łuk na prąd: nie traci trwałości, a w trybie ognia podpala strzały."]
	quest.4B9591E814238633.quest_desc: ["Rura prowadzi płyn tam, dokąd pcha go pompa. Zawór na rurze otwiera się i zamyka, gdy obracasz go napędem, więc sprzęgło steruje przepływem."]
	quest.4B9591E814238633.title: "Rury i zawór"
	quest.4BC3B87B91BE3A3E.quest_desc: [
		"Gdy zdobędziesz kamienie milowe tej ery, oddaj &6Pieczęć Ery Transcendencji&r. Cała twoja drużyna wejdzie w erę transcendencji, a pieczęć przepadnie."
		""
		"Pieczęć złożysz na mechanicznym stole rzemieślniczym Create w siatce 5×5: 8 sztabek aethersentu, 4 kulki polonu, 4 ostateczne układy sterowania, 4 sztabki deorum, 2 komponenty 256M, kulka antymaterii i trofea dwóch bossów: jednego z Endu i jednego z Eternal Starlight."
		""
		"&7Dokładny przepis zobaczysz w JEI: najedź na pieczęć i wciśnij R.&r"
	]
	quest.4BC3B87B91BE3A3E.quest_subtitle: "Oddaj pieczęć"
	quest.4BC3B87B91BE3A3E.title: "Brama: Era Transcendencji"
	quest.4BC6C8F645B17314.quest_desc: ["Daje sygnał redstone, gdy podłączone działo jest wycelowane. Podłącz go do zapłonu, a działo samo strzeli w namierzony cel."]
	quest.4BCC3E9D04407149.quest_desc: ["Czerwony piasek z badlandów płukany wiatrakiem daje bryłki złota, a czasem uschnięty krzak. Zbierz 36 bryłek, czyli cztery sztabki."]
	quest.4BCC3E9D04407149.title: "Płukanie złota"
	quest.4BE3D6ECBC1B2E9B.quest_desc: ["Mosiężna obudowa obłożona &6twardym arkuszem&r. Z niej zrobisz stacje, sygnały i kontrolery pociągów."]
	quest.4BEA6E358D12C2B8.quest_desc: ["Kości olbrzymów wystają z piasku w dolinie dusz. Rozbij je na mączkę kostną."]
	quest.4BEA6E358D12C2B8.title: "Skamieliny"
	quest.4BFEF6F2B21E2C32.quest_desc: ["Rytuał Goety z netherytowego miecza, echa pustki, smoczego oddechu i rdzenia wiatru. Składniki pokaże JEI."]
	quest.4BFFF141BD9308FE.quest_desc: [
		"W erze okultyzmu budynki magiczne rosną do poziomu 4, a zwykłe zostają na 3. Przybywają alchemik, cmentarz i robotnik Netheru."
		""
		"&7Kolejny tier budynków pojawi się tutaj, gdy twoja drużyna wejdzie w erę pary i stali.&r"
	]
	quest.4BFFF141BD9308FE.title: "Okultyzm w kolonii"
	quest.4C164F51C9723F62.quest_desc: ["Torba z uwięzionym duchem mieści więcej, niż wskazuje jej rozmiar. Nosisz ją jak plecak."]
	quest.4C2461DA7B140AC8.quest_desc: ["Łączą wszystkie urządzenia sieci. Szklany kabel zrobisz z włókna kwarcowego i fluix, a osłonięty z niego i wełny. Kable da się barwić, a różne kolory się nie łączą."]
	quest.4C2461DA7B140AC8.title: "Kable fluix"
	quest.4C39831400CCE792.quest_desc: ["Pył siarki i ciężki olej w podgrzanej kadzi dają arkusz gumy. Prasa zrobi z niego sztuczną skórę, a guma trafi też do sterownika silnika i kabli."]
	quest.4C39831400CCE792.title: "Guma"
	quest.4C49643C2BFD5B95.quest_desc: ["Wiertnica z głowicą wiertła wydobywa rudę z żyły pod sobą, dopóki ją napędzasz. Stawiasz ją raz i zbierasz urobek taśmą."]
	quest.4C49643C2BFD5B95.title: "Wiertnica"
	quest.4C4EB8EFBC2E7784.quest_desc: ["Filtr listowy przepuszcza tylko wpisane przedmioty, a filtr atrybutów przedmioty o wybranej cesze, np. jadalne albo zaklęte. Wkładasz je w gniazda mosiężnych lejków, zsypów, ramion i aplikatorów."]
	quest.4C4EB8EFBC2E7784.title: "Filtry"
	quest.4C5A653D62847D42.quest_desc: ["Złóż ją na ołtarzu otchłani w zatopionym mieście (&c{block.cataclysm.altar_of_abyss}&r), a obudzisz władcę głębin."]
	quest.4C6F056625C328BE.quest_desc: [
		"Stół do zaklinania z perłą wykutą przez bogów i gwiazdą Netheru. Zmienia i ulepsza pojedyncze afiksy, zamiast przekuwać wszystkie naraz."
		""
		"&7Kolejny tier zaklinania pojawi się tutaj, gdy twoja drużyna wejdzie w erę elektryczności.&r"
	]
	quest.4C72DFEFF29BF8F2.quest_desc: ["Diamentowa różdżka konstrukcyjna przedłuża ściany o więcej bloków naraz niż żelazna i dłużej wytrzymuje. Szablony na stole kowalskim dodadzą jej nowe tryby."]
	quest.4C8243848545732B.quest_desc: ["Kelner gotuje mięso i ryby, a potem rozdaje jedzenie mieszkańcom. Od tej chwili nie musisz ich karmić sam."]
	quest.4C8243848545732B.title: "Jadłodajnia"
	quest.4C8681CA861CB331.quest_desc: ["Każda wieża mieści jednego strażnika: rycerza, łucznika albo druida. Ustaw je przy wejściach i polach."]
	quest.4C8681CA861CB331.title: "Wieża strażnicza"
	quest.4C997D332FE09E9F.quest_desc: ["Wypada z ghastów, często prosto do lawy, więc walcz z nimi nad ziemią. Mikstura z nią przywraca zdrowie."]
	quest.4CA02FD6430D677E.quest_desc: ["Deorum i smocza łuska. Ze złotej łuski i smoczego jaja zrobisz tajemne smocze jajo."]
	quest.4CBC95DBD2FF46F8.quest_desc: ["Z łzą i esencją burzy wykujesz Astrape albo Ceraunus, broń samej Scylli."]
	quest.4CDBB8A0075E9ED2.quest_desc: ["Siarka alchemiczna w przepisie dostraja różdżkę od razu do całej grupy rud: obfitych, pospolitych, cennych albo rzadkich."]
	quest.4CDBB8A0075E9ED2.title: "Różdżka dostrojona siarką"
	quest.4CE206D5F54AC011.quest_desc: ["Twierdza Ignisa w Netherze. Pilnują jej płonący berserkerzy, a w sercu na ołtarzu ognia czeka sam Ignis."]
	quest.4CE206D5F54AC011.title: "Płonąca Arena"
	quest.4CED3967C4092533.quest_desc: ["Księgę wiązania foliota zrobisz z księgi tabu, oczyszczonego atramentu, przebudzonego pióra i niebieskiego barwnika. Połącz ją ze słownikiem w siatce rzemiosła, a wpiszesz w nią imię ducha."]
	quest.4D3E410F452CF5F1.quest_desc: ["W trybie aktywacji włącza i gasi reaktor sygnałem redstone, a w innych trybach sam daje sygnał, gdy rośnie temperatura, przybywa odpadów albo obudowa się uszkadza. Dwa adaptery połączone redstone'em zgaszą reaktor, zanim wybuchnie."]
	quest.4D4D1166E9351E04.quest_desc: ["Paleta podaje różdżce bloki z własnych slotów, po kolei albo losowo. Ściany wyjdą mniej jednolite."]
	quest.4D57767128C41D59.quest_desc: ["&6{block.createmetallurgy.foundry_basin}&r ogrzana płomiennym palnikiem topi metale. Na &6stole odlewniczym&r odlejesz z nich sztabki, arkusze i inne kształty w formach z grafitu."]
	quest.4D57767128C41D59.title: "Odlewnia"
	quest.4D61EB706C24398C.quest_desc: ["Z odłamka netherytu, smoczego oddechu i łzy ghasta. Użyty odnawia pobliskie siedziby bossów, więc możesz stoczyć walkę jeszcze raz."]
	quest.4D788DFE12C766B3.quest_desc: ["Nasyca przedmioty prądem. Ze sztabki żelaza robi &6{item.create_new_age.overcharged_iron}&r, materiał na lepsze magnesy."]
	quest.4D7FD02F4BAFBF87.quest_desc: ["Wypadają z kryształów miodu w ścianach ula. Są jadalne, a w przepisach wzmacniają miodowe narzędzia."]
	quest.4D8F3F8B706F92A5.quest_desc: ["Cztery mniejsze przegródki w jednym bloku. Dobra na drobiazgi, których masz po trochu."]
	quest.4D959560C1084634.quest_desc: ["Broń z utherium zadaje dodatkowe obrażenia zgniłym stworom. Przyda się w głębinach i w katakumbach."]
	quest.4D959560C1084634.quest_subtitle: "Kamień milowy"
	quest.4D959560C1084634.title: "&a{item.undergarden.utherium_sword}"
	quest.4DC788C79A2E098A.quest_desc: ["Czarną kredę barwi pył witherytu z rytuału afrita: pył netherytu, czaszka witherowego szkieletu, pył czarnego kamienia i witherowa róża."]
	quest.4DCCC363F74FD2CF.quest_desc: ["Żelazo nasycone na ołtarzu oczyszczonym kamieniem dusz i duchami. Cztery sztabki pójdą do pieczęci, kolejne na kosę i zbroję."]
	quest.4DCCC363F74FD2CF.quest_subtitle: "Kamień milowy i składnik pieczęci"
	quest.4DCCC363F74FD2CF.title: "&d{item.malum.soul_stained_steel_ingot}"
	quest.4DE645DF911A19C7.quest_desc: ["Budynek ozdobny z diamentem w przepisie. Jego poziom podnosi zadowolenie mieszkańców."]
	quest.4DE645DF911A19C7.title: "Miejsce mistyczne"
	quest.4E099DD64BBB3C5D.quest_desc: ["Bardzo gęsta komórka energii. Wyrówna skoki poboru, gdy procesory zamówień pracują pełną parą."]
	quest.4E0C12E59C027BAA.quest_desc: ["Wielki zbiornik z obudów, szkła strukturalnego i zaworów. Pomieści ogromną ilość jednego płynu albo gazu."]
	quest.4E0C12E59C027BAA.title: "Zbiornik dynamiczny"
	quest.4E0C7A9BD0A8E44B.quest_desc: ["Wymień coś z wieśniakiem. Za szmaragdy kupisz u nich rzeczy, których jeszcze sam nie zrobisz."]
	quest.4E0C7A9BD0A8E44B.quest_subtitle: "Kamień milowy"
	quest.4E0C7A9BD0A8E44B.title: "&aPierwszy handel"
	quest.4E2CA6181D1E5D00.quest_desc: ["Podłączone do magazynu z kontrolerem udają jedną wielką skrzynię. Lejki, rury i taśmy wkładają i wyjmują przez nie z całego magazynu."]
	quest.4E2CA6181D1E5D00.title: "Wejścia i wyjścia magazynu"
	quest.4E307DC1657ACB96.quest_desc: ["Draugry z mroźnego więzienia i jego skrzynie dają czarną stal. Z cursium zrobisz z niej broń Maledictusa."]
	quest.4E39A543ADC10385.quest_desc: ["W Overworldzie stoją ruiny starego portalu. Pilnuje ich &c{entity.eternal_starlight.the_gatekeeper}&r."]
	quest.4E39A543ADC10385.title: "Ruiny portalu"
	quest.4E615301D937B518.quest_desc: ["Blok redstone na ołtarzu pierwszego poziomu. Większa kula mieści więcej esencji i otwiera nowe sigile."]
	quest.4E6950B66E93C8DE.quest_desc: ["Piasek i glina zmieszane w mikserze albo kulki zaprawy złożone w siatce. Z zaprawy ogniotrwałej powstaje misa hutnicza i przemysłowy tygiel."]
	quest.4E72AB01B83217F5.quest_desc: [
		"Ta strona prowadzi przez krainy i surowce Otherside oraz jego starożytną świątynię. Portal i bossów masz w drzewie ery elektryczności."
		""
		"&7Skradaj się: sculk wyczuwa każdy głośny krok.&r"
	]
	quest.4E72AB01B83217F5.title: "W Otherside"
	quest.4E8186C07F8624B5.quest_desc: ["Palenisko grzeje maszynę nad sobą jak płomienny palnik, gdy wpompujesz do niego paliwo, np. LPG albo olej napędowy. Podgrzewa kadź chemiczną."]
	quest.4E8AA1EDFE6CB7C9.quest_desc: ["Naładowany certus, redstone i kwarc netherowy wrzucone do wody łączą się w fluix. Mechaniczny mikser zrobi to szybciej."]
	quest.4E8E8D7B7C8512D8.quest_desc: [
		"Pierwszy komponent MEGA. Powstaje z komponentu 256k z AE2, procesorów akumulacji, pyłu nieba i wibrującego szkła kwarcowego."
		""
		"&7Prasę akumulacji odciśniesz w inskrybencie z prasy obliczeniowej, inżynieryjnej i osobliwości.&r"
	]
	quest.4E8E8D7B7C8512D8.quest_subtitle: "Kamień milowy"
	quest.4E8E8D7B7C8512D8.title: "&b{item.megacells.cell_component_1m}"
	quest.4E8E9A5A48D1B3F7.quest_desc: ["Dłuto Rechiseled: włóż stos bloków w jego okno i wybierz wzór. Wiele wzorów łączy się z sąsiednimi blokami w większe płyty i ramy."]
	quest.4E90EA74BC90D0EC.quest_desc: [
		"Najpierw robisz głowicę z szablonu albo planu i materiału, potem łączysz ją z rączką w siatce. W erze kamienia na głowicę nadaje się krzemień albo kość."
		""
		"&7Szablon pokaże, ile materiału potrzebuje część. Najedź na niego w JEI.&r"
		""
		"&7Kolejny tier narzędzi pojawi się tutaj, gdy twoja drużyna wejdzie w erę andezytu.&r"
	]
	quest.4E98BA31FBC78B91.quest_desc: ["Grabarz chowa poległych mieszkańców na cmentarzu. Z odpowiednimi badaniami kolonia może ich nawet wskrzesić."]
	quest.4E98DBA87F17CDD7.quest_desc: ["Mapa labiryntu rysuje korytarze wokół ciebie. Jej fokus wypada z minotaurów w labiryncie i trafia się w tamtejszych skrzyniach."]
	quest.4EA467760A2B41E6.quest_desc: [
		"Pozłocona płytka z plastiku, wytrawiona kwasem w kadzi, a potem montaż sekwencyjny z kondensatorem, opornikiem i tranzystorem. Tranzystory wymagają półprzewodników z krzemu."
		""
		"&7Każdy krok sprawdzisz w JEI (R na przedmiocie).&r"
	]
	quest.4EA467760A2B41E6.quest_subtitle: "Kamień milowy"
	quest.4EA467760A2B41E6.title: "&6{item.tfmg.circuit_board}"
	quest.4EAD98D884F75372.quest_desc: ["Oba sterujesz sygnałem redstone: sprzęgło rozłącza napęd, a przekładnik odwraca kierunek obrotu. Dźwignia przy sprzęgle to najprostszy wyłącznik linii produkcyjnej."]
	quest.4EAD98D884F75372.title: "Sprzęgło i przekładnik"
	quest.4EB95D5F7313E3C9.quest_desc: ["Choroby są w paczce włączone: chory mieszkaniec przestaje pracować. Lekarz w szpitalu leczy go potrzebnymi przedmiotami."]
	quest.4F0C04500AC4AB41.quest_desc: ["Pamiątka z walki. Zachowaj ją: trofeum położone na piedestale w ciemnym lesie otworzy w erze okultyzmu twierdzę rycerzy."]
	quest.4F0CE6D6B4EBAA64.quest_desc: ["Przenośnik suwnicowy jeździ po obracającej się suwnicy i wiezie przyklejoną maszynę. Suwnica zamontowana na przenośniku drugiej suwnicy sięga w dwóch osiach."]
	quest.4F0CE6D6B4EBAA64.title: "Suwnica"
	quest.4F1E16630FE094DD.quest_desc: ["Pełny fokus powstaje w aparacie zaklinającym z mniejszego fokusu i znaku mistrzostwa. Załóż go w slot fokusu, a zaklęcia twojego żywiołu staną się jeszcze silniejsze."]
	quest.4F1E16630FE094DD.title: "Fokus żywiołu"
	quest.4F2963CEBC70FC54.quest_desc: ["Mocniejszy stabilizator z rytuału dżina: blok srebra i łza ghasta na stabilizatorze poprzedniego poziomu."]
	quest.4F2D7F2DEBE79B75.quest_desc: ["Wystarczy jeden z nich: &c{entity.deeperdarker.stalker}&r, &c{entity.goety.vizier}&r albo &c{entity.goety.hostile_redstone_monstrosity}&r. Trofeum dopełni pieczęć."]
	quest.4F2D7F2DEBE79B75.quest_subtitle: "Kamień milowy"
	quest.4F2D7F2DEBE79B75.title: "&cDrugi boss ery"
	quest.4F3358E0232752E9.quest_desc: [
		"Księgę nowicjusza zrobisz z książki i żelaznych narzędzi. Podstawowe glify znasz od razu. Należą do nich {ars_nouveau.glyph_name.glyph_projectile}, {ars_nouveau.glyph_name.glyph_touch} i {ars_nouveau.glyph_name.glyph_harm}."
		"Pierwszy nowy glif, {ars_nouveau.glyph_name.glyph_light}, zrobisz na stole skryby z latarni i pochodni. Podnieś go, a potem użyj (PPM), żeby go poznać."
	]
	quest.4F3358E0232752E9.quest_subtitle: "Kamień milowy"
	quest.4F3358E0232752E9.title: "&dKsięga zaklęć i pierwszy glif"
	quest.4F48B1C0D086D183.quest_desc: ["Kryształ lawy przemieniony na ołtarzu. Zwiąż go ze sobą (użycie w ręce) i kliknij nim kamień główny, a gotowy krąg się obudzi."]
	quest.4F731EC8BC0F93D3.quest_desc: ["Wnętrze wzgórza kryje rudy i skrzynie, a pilnują ich gobliny w czerwonych czapkach. W skrzyniach trafia się stalowy liść i magnes na rudy."]
	quest.4F731EC8BC0F93D3.title: "Puste wzgórze"
	quest.4F9C7BC8ED02F39A.quest_desc: ["Jedyne jajo na serwerze zostaje na portalu po pierwszej walce. Kto je zabierze, ma trofeum nie do podrobienia."]
	quest.4FB3328007FC9406.quest_desc: ["Podziemna komnata, w której strażnik stoi nieruchomo, dopóki nie wejdziesz do środka."]
	quest.4FB3328007FC9406.title: "Żelazna komnata"
	quest.4FB612026B40E5E6.quest_desc: ["Importer wciąga przedmioty z pojemnika albo maszyny do QIO, a eksporter wypycha z QIO wybrane przedmioty. Filtry ustawisz w ich oknach."]
	quest.4FB612026B40E5E6.title: "Importer i eksporter"
	quest.4FC2E16D06DF68AC.quest_desc: ["Mapa skarbu prowadzi do skrzyni zakopanej na plaży. Kop tam, gdzie wskazuje czerwony krzyżyk."]
	quest.4FC2E16D06DF68AC.title: "Zakopany skarb"
	quest.4FC90757CEF764F8.quest_desc: ["Postawiony przy zbiorniku pozwala napełniać i opróżniać go wiadrem albo butelką jednym kliknięciem. To pierwszy z bloków Create: Dragons Plus, który dodaje też nowe rodzaje przetwarzania wiatrakiem."]
	quest.4FCF92A7D1FDE972.quest_desc: [
		"Sproszkowany kamień Endu z kół kruszących, bryłki cynku i woda zmieszane w mikserze dają mieszankę lewititu, która w cieple krystalizuje się w lewitit. Dość lewititu na maszynie utrzyma ją w powietrzu bez balonu i śmigieł."
		""
		"&7Ponder (przytrzymaj W nad przedmiotem) pokaże, jak to złożyć.&r"
	]
	quest.4FCF92A7D1FDE972.quest_subtitle: "Kamień milowy"
	quest.4FCF92A7D1FDE972.title: "&6Lewitit"
	quest.4FD99E2AF448654D.quest_desc: ["Kopalnie pod olbrzymimi grzybami: wózki, szyby i skrzynie górników."]
	quest.4FD99E2AF448654D.title: "Grzybowe kopalnie"
	quest.5003C3B4B511E07B.quest_desc: ["Stapia dowolne materiały w superstop. Do budowy potrzebujesz bloku stali tyryjskiej i latarni."]
	quest.5006AF1457F1861C.quest_desc: ["Koksownik rozpoczyna rytuały: kładziesz na nim przedmiot i podpalasz krzesiwem, a składniki leżą na podstawkach wokół."]
	quest.5012967720B78C97.quest_desc: ["Lasy japońskich cedrów sugi, pola goździków i łąki z cyprysami. Odwiedź wszystkie trzy."]
	quest.5012967720B78C97.title: "Nature's Spirit"
	quest.5012B9756887FF5E.quest_desc: ["Przyzywa sługi szkielety: szybsze i sprytniejsze od zombie, strzelają z łuku. Również powstaje w rytuale nekroturgii."]
	quest.5023D3D6CD8C30CE.quest_desc: ["Najwyższy poziom stosów: gniazdo mieści prawie nieograniczoną liczbę przedmiotów. Powstaje z ulepszenia piątego poziomu."]
	quest.504233A9D5A41735.quest_desc: ["Rytuał afrita z totemem nieśmiertelności i blokiem złota. Esencję afrita zdobędziesz z przyzwanego, niezwiązanego afrita."]
	quest.504746BF3ED61422.quest_desc: ["Lata na wodorze z separatora elektrolitycznego. Tryb zmienisz klawiszem; w trybie zawisu utrzymasz się w powietrzu."]
	quest.505B234254A9140A.quest_desc: ["Łuk, który dokłada zaklęcie z księgi do każdej strzały. Działa z formą pocisku."]
	quest.506CE8DB5AEDA87C.quest_desc: ["Reaktor chłodzony sodem oddaje przegrzany sód do kotła, a kocioł robi z wody parę dla turbiny. Elementy przegrzewające zagrzeją go też prądem."]
	quest.506CE8DB5AEDA87C.title: "Kocioł termoelektryczny"
	quest.507507B59617EF3A.quest_desc: ["Podłącz &6{block.create.millstone}&r do napędu i wrzuć do niego pszenicę. Mąka z wodą da ciasto chlebowe."]
	quest.507507B59617EF3A.quest_subtitle: "Kamień milowy"
	quest.507507B59617EF3A.title: "&6Młynek i mąka"
	quest.5078BA0E7807155B.quest_desc: ["Era arkanów wprowadziła świat na poziom Szczyt. Pojawiają się przedmioty mityczne, a najeźdźcy Apotheosis są groźniejsi niż kiedykolwiek."]
	quest.5078BA0E7807155B.title: "Poziom świata: Szczyt"
	quest.507BD077A63219A4.quest_desc: ["Miej naraz 256 mosiężnych obudów. Pnie i stopiony mosiądz niech same trafiają do mis odlewniczych, a gotowe obudowy do magazynu."]
	quest.507BD077A63219A4.quest_subtitle: "Dowód automatyzacji"
	quest.507BD077A63219A4.title: "Odlewnia obudów"
	quest.50890A13904C4FD2.quest_desc: ["Saletra rzadkich metali z kadzi trawiennej. Szyk reformacji zrobi z niej siarkę wybranego rzadkiego metalu, a inkubator sztabki."]
	quest.50890A13904C4FD2.quest_subtitle: "Kamień milowy"
	quest.50890A13904C4FD2.title: "&dUszlachetnianie"
	quest.50A0B849F5BE4EF6.quest_desc: ["Nasiona z książką dają słownik okultysty: opisuje rytuały, pentakle i duchy. Zajrzyj do niego przed każdym nowym rytuałem."]
	quest.50A395C90433A6C1.quest_desc: [
		"Skrzynie w strukturach mają osobną zawartość dla każdego gracza, więc nikt nie zabierze ci łupu."
		""
		"Swój teren zajmujesz na mapie FTB Chunks. Zajęte chunki są chronione przed graczami spoza twojej drużyny."
		""
		"PvP włącza i wyłącza administrator."
		""
		"Po śmierci twój ekwipunek zostaje w zwłokach w miejscu śmierci."
	]
	quest.50A395C90433A6C1.title: "Zasady serwera"
	quest.50AD8FFC78D7010E.quest_desc: ["Niszczy wybrane przedmioty, zanim zapełnią plecak, np. bruk i ziemię przy kopaniu."]
	quest.50AE221D4F023BB7.quest_desc: ["Miej naraz 512 kruszonej rudy, dowolnego metalu. Tyle zbierzesz tylko wtedy, gdy ruda sama trafia między koła, a urobek do magazynu."]
	quest.50AE221D4F023BB7.quest_subtitle: "Dowód automatyzacji"
	quest.50AE221D4F023BB7.title: "Kruszarnia"
	quest.50BC623AA6269B8B.quest_desc: ["Biblioteka zaklęć nasycona w stole. Mieści więcej i wydaje księgi o wyższych poziomach niż zwykła."]
	quest.50C487255D37AE5B.quest_desc: ["Żelazo nasycone w przeklętym nasycaczu. Przeklęty metal idzie na klatki, świeczniki dusz, kocioł wiedźmy i kostury."]
	quest.50CDEEAE12DF8214.quest_desc: [
		"Zamyka zawartość sąsiedniego pojemnika w paczki i rozpakowuje paczki, które do niego trafią. Zrobisz go z bloku kartonu, sztabki żelaza i redstone."
		""
		"&7Napisz adres na tabliczce przy pakowaczu, a paczki dostaną go na drogę.&r"
	]
	quest.50CDEEAE12DF8214.quest_subtitle: "Kamień milowy"
	quest.50CDEEAE12DF8214.title: "&b{block.create.packager}"
	quest.50CE5F33B31D01C4.quest_desc: ["Stabilny zwój osnowy nie zużywa się i działa także między wymiarami. Użyty na bloku otwiera chwilowy portal w zapamiętane miejsce. Przepis wymaga płomiennego proszku."]
	quest.50D505A3C7A29009.quest_desc: ["Zamek zamyka tył lufy i otwiera się do ładowania, więc działa nie trzeba rozbierać. Przesuwny odlejesz z żeliwa, brązu albo stali, a śrubowy ze stali albo netherstali; jak nimi sterować, pokaże Ponder (W)."]
	quest.50D505A3C7A29009.title: "Zamki"
	quest.50DBAC95CF4E9B94.quest_desc: ["Laska totemiczna z fragmentem pamięci i stalą dusz rzuca pociski klątw. Z solami pustki i złośliwym stopem zrobisz z niej berło erozji."]
	quest.50E20D7DA134239B.quest_desc: ["Zasila sieć i rozdaje kanały: każda ściana kontrolera daje ich 32. Kilka kontrolerów obok siebie łączy się w jeden większy blok."]
	quest.50EB3015AB3CBC40.quest_desc: [
		"&7Era mosiądzu · zalecane: diamentowa zbroja&r"
		"Dyniowy władca z Born in Chaos. Powstaje, gdy użyjesz &c{item.born_in_chaos_v1.transmuting_elixir}&r na &cpiekielną złowrogą dynię&r."
	]
	quest.50EB3015AB3CBC40.quest_subtitle: "Boss"
	quest.50EB3015AB3CBC40.title: "&cLord Dyniogłowy"
	quest.50F40BC98964D915.quest_desc: ["Opuszcza i podnosi konstrukcję na linie. Z niego zrobisz prostą windę albo dźwig nad szybem kopalni."]
	quest.51009F35FA1A7EA6.quest_desc: ["Krew Apostoła, oddech smoka, płaczący obsydian i oko Endera z pustym fokusem. Kamień połączony z surowym złotem w siatce podwaja złoto; traci przy tym trwałość, ale sam się naprawia energią dusz."]
	quest.512520FF526566D3.quest_desc: ["Laweta na kołach, którą przetoczysz w inne miejsce. W przeciwieństwie do stałej lawety nie da się jej zautomatyzować."]
	quest.5136857AB9394112.quest_desc: ["Wyciąga przedmioty z pojemnika i wysyła je transporterem logistycznym według filtrów. Każdy filtr może nadać przedmiotom kolor trasy."]
	quest.513CD380495A2428.quest_desc: ["Prasuje metale w blachę – osobny materiał Silent Gear o własnych cechach."]
	quest.513D91C74C54CD80.quest_desc: ["Sygnały dzielą sieć na odcinki i nie wpuszczają pociągu na odcinek, na którym stoi inny. Na mijankach i skrzyżowaniach zapobiegną zderzeniom."]
	quest.5145B3F784329175.quest_desc: ["Klasztor Dungeons Arise: kilka pięter i dziedziniec. Przeszukaj każdą celę."]
	quest.5145B3F784329175.title: "Klasztor"
	quest.5148704D08860304.quest_desc: [
		"Jonowy silnik wektorowy obraca dyszę jak wersja na paliwo płynne, ale zasila go prąd. Z czujnikiem przechyłu sam utrzyma statek w równowadze."
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę atomu.&r"
	]
	quest.514CBCE88CFFA3A2.quest_desc: [
		"&7Era run · zalecana żelazna zbroja i tarcza.&r"
		""
		"Olbrzymi wąż pilnuje dziedzińca w Lesie Zmierzchu. Szarżuje przez całą arenę, więc schodź jej z drogi i atakuj z boku."
		"Znajdziesz ją na Dziedzińcu Nagi."
	]
	quest.514CBCE88CFFA3A2.quest_subtitle: "Boss"
	quest.514CBCE88CFFA3A2.title: "&c{entity.twilightforest.naga}"
	quest.51720D57B1E30245.quest_desc: ["Wraki leżą na dnie i na plażach. W skrzyni kapitana bywa mapa skarbu."]
	quest.51720D57B1E30245.title: "Wrak"
	quest.5189E09E4D1AFF55.quest_desc: [
		"Złóż działo z komory, lufy i zamka, a potem zamontuj je na lawecie. Komorę odlejesz z żeliwa, brązu albo stali."
		""
		"&7Montaż, ładowanie i strzał pokazuje Ponder (W) na lawecie.&r"
	]
	quest.5189E09E4D1AFF55.quest_subtitle: "Kamień milowy"
	quest.5189E09E4D1AFF55.title: "&6Działo"
	quest.5196434BFBBB736E.quest_desc: ["Księżycowa potworność zawsze zostawia łuk, włócznię półksiężyca i różdżkę teleportacji."]
	quest.5196434BFBBB736E.title: "Łupy potworności"
	quest.51B66B2FC54FA7E6.quest_desc: ["Reaktor chłodzony wodą robi parę, a para kręci turbinę. To główne źródło prądu w erze atomu."]
	quest.51B66B2FC54FA7E6.title: "Turbina przemysłowa"
	quest.51BB1CC6031829D4.quest_desc: ["Tajemny kryształ z Forbidden \\& Arcanus wykopiesz żelaznym kilofem pod ziemią. Jeden trafi do pieczęci jako odczynnik, resztę przetopisz na pył."]
	quest.51BB1CC6031829D4.quest_subtitle: "Składnik pieczęci"
	quest.51BE14859D8ECCCC.quest_desc: ["Z dostawcą wzorów, asemblerem molekularnym i procesorem wytwarzania sieć sama zrobi to, o co poprosisz w terminalu."]
	quest.51BE14859D8ECCCC.title: "Wytwarzanie na żądanie"
	quest.51BF256E2BE70BE5.quest_desc: ["Zostawia je Wither po walce."]
	quest.51E31692C16DB5D7.quest_desc: ["Dowód automatyzacji: 512 stopu andezytu. Mikser zrobi go z andezytu i bryłek żelaza albo cynku, jeśli dostarczysz je taśmą lub lejkiem."]
	quest.51E31692C16DB5D7.title: "Stop na skalę"
	quest.5205A6722A1B0524.quest_desc: ["Kadzidła warzysz w tyglu albo składasz w siatce z ziół i żywicy. Podpalone działają na wszystko w pobliżu: jedne leczą żywych, inne nieumarłych albo odpędzają zombie i szkielety."]
	quest.5205A6722A1B0524.title: "Pierwsze kadzidło"
	quest.520964CC45735879.quest_desc: ["Pośredni poziom stosów z bloku miedzi. Możesz go pominąć i od razu zrobić drugi poziom."]
	quest.521F248FA24C4736.quest_desc: ["Komora wzbogacania robi go ze sztabek uranu. To pierwszy krok do paliwa jądrowego."]
	quest.52374DCF1C7DC049.quest_desc: ["Krajalnica z nożem w środku kroi składniki z deski do krojenia sama: kładziesz je na składnicy albo taśmie pod nią."]
	quest.5241A8A7FEE99752.quest_desc: [
		"Trzeci poziom pojemności, z bloku diamentu i złotego ulepszenia. Jedna szuflada pomieści zapas całej linii produkcyjnej."
		""
		"&7Kolejny tier szuflad pojawi się tutaj, gdy twoja drużyna wejdzie w erę arkanów.&r"
	]
	quest.52555AE7A28D0B48.quest_desc: ["Mistyczne oczy pokazują linie mocy i Fae, których gołym okiem nie widać."]
	quest.525D6ECD35551B84.quest_desc: ["Wielka struktura z obudów SPS zamienia polon w antymaterię. Pożera przy tym ogromne ilości prądu."]
	quest.525D6ECD35551B84.title: "Komora SPS"
	quest.526418D7DEB3AC24.quest_desc: [
		"Rudę iesnium zobaczysz w Netherze tylko z Trzecim Okiem albo w goglach z innego świata. Przetopiona daje sztabki na kilof, kowadło i maszyny Occultism."
		""
		"&7Kolejny tier Occultism pojawi się tutaj, gdy twoja drużyna wejdzie w erę pary i stali.&r"
	]
	quest.526418D7DEB3AC24.quest_subtitle: "Kamień milowy"
	quest.526418D7DEB3AC24.title: "&d{item.occultism.iesnium_ingot}"
	quest.5267AE4FBA1B66E7.quest_desc: ["Plecak z tym ulepszeniem nie zniknie: nie zniszczy go lawa, wybuch ani pustka. Przepis wymaga kryształu Endu."]
	quest.5267D0A3D3F9363E.quest_desc: [
		"Każde urządzenie sieci zajmuje jeden kanał. Zwykły kabel niesie 8 kanałów, gęsty 32. Bez kontrolera sieć obsłuży najwyżej 8 urządzeń."
		""
		"&7Gdy kanałów zabraknie, urządzenia na końcu kabla przestaną działać. Prowadź gęste kable od kontrolera, a zwykłe dopiero do grup urządzeń.&r"
	]
	quest.5267D0A3D3F9363E.title: "Kanały"
	quest.5294DE711B59AFEB.quest_desc: ["Kocioł z lokometalu, komin i kozioł oporowy nie zmieniają jazdy, ale z nimi pociąg wygląda jak prawdziwa parowozownia. Kominy dymią, gdy pociąg jedzie."]
	quest.5294DE711B59AFEB.title: "Wygląd lokomotywy"
	quest.52BC8CE33F05D4E4.quest_desc: [
		"Apothic Enchanting zmienia stół do zaklinania: biblioteczki wokół dają mu trzy statystyki. Eterna podnosi maksymalny poziom zaklinania, Quanta zwiększa rozrzut siły zaklęć, a Arcana szansę na więcej i rzadszych zaklęć."
		""
		"&7Statystyki stołu zobaczysz w jego oknie; półki z kolejnych er podnoszą je coraz wyżej.&r"
	]
	quest.52BC8CE33F05D4E4.title: "Eterna, Quanta, Arcana"
	quest.52C1030ED76BE8F9.quest_desc: ["Lśni jak diament, a mimo to pochłania światło. Uwarzysz go z węgla, łzy ghasta, esencji śmierci, odłamka duszy i diamentu; na nim opiera się najsilniejszy sprzęt Eidolonu."]
	quest.52C1030ED76BE8F9.quest_subtitle: "Kamień milowy"
	quest.52C1030ED76BE8F9.title: "&d{item.eidolon_repraised.shadow_gem}"
	quest.52C43052B583CAE2.quest_desc: ["Łączy jeden blok z wieloma celami naraz i pamięta kolejność łączenia. Sieć przekaźników zbudujesz bez setek kliknięć."]
	quest.52CADEADF5F81F94.quest_desc: ["Zamienia ten sam metal z różnych modów na jedną wersję, np. sztabki ołowiu, żeby nie zapychały magazynu."]
	quest.52D69A3C6B95485C.quest_desc: ["Stawia rząd, kolumnę albo całą płaszczyznę bloków jednym kliknięciem. Bloki bierze z ekwipunku."]
	quest.52E2147A3049BCC7.quest_desc: [
		"Wskazuje najbliższą wybraną budowlę. Zrobisz go z kompasu, pajęczyny i pękniętych kamiennych cegieł."
		""
		"&7Szuka stopniowo, więc daleka budowla może znaleźć się dopiero po chwili. Zacznij od tych, które są blisko.&r"
	]
	quest.52EC26F6E5126BC5.quest_desc: ["Wbudowany w procesor zamówień pokazuje, co właśnie powstaje."]
	quest.52EE08756643708D.quest_desc: ["Leży w zakopanych skarbach. Z muszlami łodzików zrobisz z niego przewodnik, który daje oddech pod wodą."]
	quest.52FE099BC94CFBB9.quest_desc: ["Pokonaj jeszcze jednego bossa tej ery, innego niż minoszrum i hydra. Pasuje każdy z pozostałych ośmiu, a jego trofeum też trafi do pieczęci."]
	quest.52FE099BC94CFBB9.quest_subtitle: "Kamień milowy"
	quest.52FE099BC94CFBB9.title: "&cDrugi boss ery"
	quest.53053FC2149ED08B.quest_desc: ["Transportery logistyczne wożą przedmioty między maszynami i pojemnikami. Kolorem trasy wskażesz, dokąd mają trafić."]
	quest.5320796741B160F7.quest_desc: ["Lodowa klątwa jak szpony upiora: trafiony cel przestaje odzyskiwać zdrowie. Serce upiora do niej wypada z upiorów."]
	quest.5329A128BFA66887.quest_desc: ["Odpływ opróżnia wrzucone pojemniki z płynu: butelki miodu oddadzą miód, a wiadra swoją zawartość."]
	quest.532D893E23412D94.quest_desc: ["Przyczep go do kontenera albo skrzyni i kliknij: przeniesie do środka zawartość twojego ekwipunku poza paskiem szybkiego wyboru."]
	quest.534CA2E2649BB2FF.quest_desc: [
		"&7Era run · zalecana żelazna zbroja i tarcza&r"
		""
		"Bossowie Lasu Zmierzchu pilnują jego dalszych zakątków. Magiczna bariera wpuści cię do kolejnej budowli dopiero wtedy, gdy pokonasz poprzedniego strażnika: najpierw Nagę, potem Licza."
		"Walki zalicza zadanie bossa w rozdziale ery. Tutaj znajdziesz przygotowania i łupy."
	]
	quest.534CA2E2649BB2FF.title: "Bestiariusz Lasu Zmierzchu"
	quest.53585A49C7906B53.quest_desc: [
		"Ognisty metal sam naprawia się w słońcu i podpala wrogów. Z niego zrobisz zbroję i narzędzia."
		""
		"&7Kolejny tier Lasu Zmierzchu pojawi się tutaj, gdy twoja drużyna wejdzie w erę okultyzmu.&r"
	]
	quest.53585A49C7906B53.quest_subtitle: "Kamień milowy"
	quest.53585A49C7906B53.title: "&c{item.twilightforest.fiery_ingot}"
	quest.5368F7476CC4F6FD.quest_desc: ["Napełnij wiadro ropą z pompy. Sama ropa niewiele daje, dopiero destylacja rozdzieli ją na paliwa."]
	quest.5368F7476CC4F6FD.title: "Ropa naftowa"
	quest.5371385A1787DDD8.quest_desc: ["Sprzęgło odśrodkowe łączy napęd dopiero wtedy, gdy obroty przekroczą ustawiony próg. Sprzęgło wolnobiegowe łączy go tylko przy obrocie we właściwą stronę."]
	quest.5371385A1787DDD8.title: "Sprytne sprzęgła"
	quest.53716E06C4EAD701.quest_desc: ["Klucz strażnika mosiężnego lochu. W jego skarbcu leży naszyjnik z chmur, peleryna chmur albo rękawice zasięgu."]
	quest.53A32F809B45CAFE.quest_desc: [
		"Prąd płynie, a ty sięgasz po samo jądro materii. Rozszczepiony uran da polon i pluton, a z nich powstanie antymateria."
		"Otwiera się End i świat Eternal Starlight. Kto chce, może też polecieć rakietą na Księżyc."
		""
		"Era kończy się bramą. Wymaga ona kamieni milowych z gałęzi tego rozdziału i Pieczęci Ery Transcendencji."
	]
	quest.53A32F809B45CAFE.quest_subtitle: "Początek ery"
	quest.53A32F809B45CAFE.title: "Era Atomu"
	quest.53A450898DC781C4.quest_desc: ["Świątynia w głębi Otherside. Jej skrzynie kryją szablony kowalskie, kości sculku i pył dusz, a jedna komnata jest ukryta."]
	quest.53A450898DC781C4.quest_subtitle: "Kamień milowy"
	quest.53A450898DC781C4.title: "&aStarożytna świątynia"
	quest.53C358870CB0DDE2.quest_desc: ["Napełnij słoik źródła do pełna, czyli 10 000 źródła, i popatrz na niego. Tyle pochłonie aparat zaklinający przy pieczęci następnej ery, więc warto mieć kilka pełnych słoików."]
	quest.53C358870CB0DDE2.quest_subtitle: "Kamień milowy"
	quest.53C358870CB0DDE2.title: "&d10 000 źródła"
	quest.53C4716BE3EA5FC2.quest_desc: [
		"Przywołuje Starbuncle'a, który nosi przedmioty między skrzyniami i zbiera te leżące w okolicy."
		""
		"&7Podejdź do dzikiego Starbuncle'a w lesie z samorodkiem złota w ręce. Weźmie go i zniknie, a zostawi odłamki do uroku.&r"
	]
	quest.53D6730BD8E97A6C.quest_desc: ["Sculk, tabliczka Aetherea, słaby odłamek krwi i gwiazda Netheru w piekielnej kuźni. Cztery skupiska zwieńczą słupy piątego poziomu ołtarza."]
	quest.53D6730BD8E97A6C.title: "Kryształowe skupiska"
	quest.53DF6FCDEC7DAA7C.quest_desc: [
		"Każde źródło napędu ma wydolność w &6jednostkach obciążenia&r (JO), a każda maszyna je zużywa – tym więcej, im szybciej się kręci. Prędkość mierzy się w obrotach na minutę (obr./min)."
		"Gdy maszyny potrzebują więcej JO, niż dają źródła, cała sieć staje. Dołóż wtedy źródło napędu albo zwolnij maszyny."
		""
		"&7Ta strona idzie dalej niż drzewo ery: przekładnie, pomiary, sterowanie obrotem i para. Gogle inżyniera pokażą obie wartości, gdy spojrzysz na blok Create.&r"
	]
	quest.53DF6FCDEC7DAA7C.title: "Obciążenie i prędkość"
	quest.53E6DDB7F5E10E60.quest_desc: ["Gdy spadniesz poniżej połowy zdrowia, hełm odrzuca wrogów wokół i podnosi twoją obronę, odporność na odrzut i regenerację."]
	quest.53F04FE3A9B7373A.quest_desc: ["Mroczna różdżka ulepszona przeklętym metalem, ektoplazmą i duchową tkaniną. Wzmacnia zaklęcia nekroturgii: jednym rzutem przyzywasz kilka sług."]
	quest.53F04FE3A9B7373A.quest_subtitle: "Kamień milowy"
	quest.53F04FE3A9B7373A.title: "&d{item.goety.necro_staff}"
	quest.53F44E98C4BA341D.quest_desc: ["Wzór rzemieślniczy uczy stół nowego kształtu biżuterii. Wzory znajdziesz w skrzyniach, a niektóre kupisz u wieśniaka jubilera."]
	quest.5402D8D9BA230AA9.quest_desc: ["Generatory słoneczne dają prąd za dnia, bez paliwa i obsługi. Zaawansowany jest duży i dużo wydajniejszy."]
	quest.5402D8D9BA230AA9.title: "Słońce"
	quest.54356F890014B79D.quest_desc: ["Szyjesz go z niegodziwej tkaniny: wełny z klejnotem cienia i symbolem bezbożnym. Kapelusz zwiększa obrażenia magiczne o połowę, płaszcz o połowę zmniejsza otrzymywane, a buty chronią przed spowolnieniem."]
	quest.54356F890014B79D.title: "Strój czarnoksiężnika"
	quest.54369DCCBC9BEEAA.quest_desc: ["Kolejny krok: jeszcze więcej miejsca i gniazd na ulepszenia."]
	quest.54369DCCBC9BEEAA.quest_subtitle: "Kamień milowy"
	quest.54369DCCBC9BEEAA.title: "&b{item.sophisticatedbackpacks.iron_backpack}"
	quest.5436C5ED05292EC8.quest_desc: [
		"Weź berło w oknie wieży strażniczej i zaznacz nim punkty patrolu albo miejsce, którego strażnik ma pilnować."
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę mosiądzu.&r"
	]
	quest.543B64F6A5C22D46.quest_desc: ["Syrenie dasz morski ogórek, a Flashjackowi owoc błyskającego łukodrzewu (Flashpine); oba zostawią żetony na amulet. Działo płomieni (Flarecannon) zrobisz w aparacie z esencji ognia i odłamka netherytu."]
	quest.543B64F6A5C22D46.title: "Pomocnik żywiołu"
	quest.54838E9A3EBAEB40.quest_desc: ["Księga opisuje zaklęcia, katalizatory i kręgi magii. Przepisy na zwoje pokaże też JEI."]
	quest.548B8A2E2BB1A0E5.quest_desc: ["Stół rzemieślniczy w oknie skrzyni. Składniki bierze prosto z jej zawartości."]
	quest.54905A4E4F0B095C.quest_desc: ["Części broni z mitrylu i tajemnej sztabki to podstawa mieczy magów: łamacza zaklęć, ametystowego rapiera, borealnej klingi i powiewu zmierzchu. Każdy ma własne zaklęcie."]
	quest.54905A4E4F0B095C.title: "Broń czarodzieja"
	quest.54A27D72882687A4.quest_desc: ["Kadź trawienna przenosi saletrę między poziomami materii, np. z pospolitych metali na rzadkie, jak z żelaza na złoto."]
	quest.54A46C967804D8FC.quest_desc: ["Tabliczka rytuału, który budzi do życia to, co go otacza. Z książką i piórami w rytualnym tyglu obudzi Bookwyrma."]
	quest.54B1EA40C7E0A425.quest_desc: ["&6{block.mekanism.chemical_crystallizer}&r zamknie antymaterię z SPS w kulce. Jedna wystarczy do pieczęci."]
	quest.54B1EA40C7E0A425.quest_subtitle: "Kamień milowy · składnik pieczęci"
	quest.54B1EA40C7E0A425.title: "&6{item.mekanism.pellet_antimatter}"
	quest.54B4156207419686.quest_desc: ["Miedzianą księgę zrobisz z miedzi, nici i papieru. Załóż ją w slot księgi: zaklęcia wpisane ze zwojów rzucisz z niej bez zużywania zwojów."]
	quest.54B4156207419686.title: "Własna księga zaklęć"
	quest.54B9C357C38E5CD5.quest_desc: ["Załóż gogle inżyniera i weź do ręki klucz montażowy z paczki startowej ery. Klucz obraca bloki Create, a kliknięcie z kucnięciem chowa je do ekwipunku."]
	quest.54B9C357C38E5CD5.title: "Strój inżyniera"
	quest.54BBFB206E231A81.quest_desc: ["Stół rzemieślniczy w plecaku. Bierze składniki prosto z jego zawartości."]
	quest.54C0B70CE68A00D0.quest_desc: [
		"Zbuduj formę z Czarnej Księgi Goety i kliknij środkowy wzmocniony blok rdzeniem animacji. To najsilniejszy z twoich sług; naprawisz go blokami redstone."
		""
		"&7Gdy padnie, zostawi głowę, z której taniej go odtworzysz.&r"
	]
	quest.54C0B70CE68A00D0.quest_subtitle: "Kamień milowy"
	quest.54C0B70CE68A00D0.title: "&dOstateczna machina wojenna"
	quest.54D7930D16D15C75.quest_desc: ["Każdy sigil to inny odczynnik w kręgu, a mocniejsze wymagają lepszej tabliczki. Wiele z nich włączasz na stałe Shiftem i prawym przyciskiem."]
	quest.54D7930D16D15C75.title: "Sigil użytkowy"
	quest.54ECD456BF8A2629.quest_desc: [
		"Wielki magazyn energii z obudów, szkła strukturalnego i portów. Ogniwa w środku decydują o pojemności, a dostawcy o tym, ile FE przepłynie na tick."
		""
		"&7Port przełączysz konfiguratorem między wejściem a wyjściem.&r"
	]
	quest.54ECD456BF8A2629.quest_subtitle: "Kamień milowy"
	quest.54ECD456BF8A2629.title: "&6Matryca indukcyjna"
	quest.55023C299CB945E0.quest_desc: ["Zsyp z filtrem: przepuszcza tylko wybrane przedmioty i może je odliczać."]
	quest.5504FC56D0824B9B.quest_desc: ["Najwyższa księga Ars Nouveau mieści najwięcej zaklęć i glify trzeciego poziomu. Do przepisu potrzebujesz gwiazdy Netheru, totemu nieśmiertelności i hołdu wildena od Chimery."]
	quest.5504FC56D0824B9B.quest_subtitle: "Kamień milowy"
	quest.5504FC56D0824B9B.title: "&d{item.ars_nouveau.archmage_spell_book}"
	quest.55514DCA32B43CDF.quest_desc: ["Kamień z gorących źródeł przetopiony w piecu. Z tych sztabek zrobisz narzędzia i zbroję."]
	quest.555CCD4FDF89891B.quest_desc: [
		"Rękawica Strażnika. Trzymana w ręce przyciąga stwory, gdy jej użyjesz."
		""
		"&7Kolejny tier Cataclysmu pojawi się tutaj, gdy twoja drużyna wejdzie w erę transcendencji.&r"
	]
	quest.5569EC8FA544F7F6.quest_desc: ["Podgrzana kadź rozkłada benzynę ciężką na etylen i propylen, a z nich robi stopiony plastik. Odlej go w misie odlewniczej na arkusze."]
	quest.556E877D9ABA7554.quest_desc: ["Obudowa z ołowiu i stali, w środku zespoły paliwa, a nad nimi pręty kontrolne. Pilnuj chłodzenia: przegrzany reaktor może wybuchnąć."]
	quest.556E877D9ABA7554.quest_subtitle: "Kamień milowy"
	quest.556E877D9ABA7554.title: "&6Reaktor rozszczepienia"
	quest.558A6E927FC04705.quest_desc: ["Nałóż sztabkę mosiądzu na ociosany pień albo drewno. To podstawa pieczęci i połowy maszyn tej ery."]
	quest.558A6E927FC04705.quest_subtitle: "Składnik pieczęci"
	quest.5591FD6E615737D8.quest_desc: ["Ogień duchów daje &d{block.occultism.otherstone}&r. Jego cegły i kolumny pasują do wieży okultysty."]
	quest.5591FD6E615737D8.title: "Kamień z innego świata"
	quest.5593A86BF8D66E60.quest_desc: ["Frostmaw śpi w śnieżnym biomie na otwartym terenie. Podejdź ostrożnie: obudzony zieje lodem."]
	quest.5593A86BF8D66E60.title: "Legowisko Frostmawa"
	quest.55AEB1E9462B828E.quest_desc: ["Kręcisz je ręką jak korbę, a z kucnięciem w drugą stronę. Zazębiają się z kołami zębatymi obok, więc nie potrzebują osobnego wału."]
	quest.55AEB1E9462B828E.title: "Koła korbowe"
	quest.55B51E8ECCA9C9AD.quest_desc: ["Tajemna zębatka z metalu, tajemnej esencji i redstone. Fokus technomancji i część wielu przepisów Cataclysm: Spellbooks."]
	quest.55C41E33E355B051.quest_desc: ["Krótszy krewny zwykłego silnika: blok gwiazdowy z cylindrami wokół wału."]
	quest.55F4BBFDB3CEBA21.quest_desc: ["Bloki naśladowcze ze sztabki cynku przybierają wygląd bloku, którym je klikniesz. Copycats+ dodaje skosy, warstwy, drzwi i dziesiątki innych kształtów."]
	quest.55F4BBFDB3CEBA21.title: "Bloki naśladowcze"
	quest.55F620412DD9285B.quest_desc: ["Większa magiczna torba. Przepis wymaga oka Endera."]
	quest.5635F21BAE39B284.quest_desc: [
		"&7Era arkanów. Zalecany ekwipunek: pełna zbroja netherytowa i mikstury odporności na ogień.&r"
		"Płonący rycerz strzeże areny. Połóż płonące popioły na ołtarzu ognia, a się obudzi."
	]
	quest.5635F21BAE39B284.quest_subtitle: "Boss"
	quest.5635F21BAE39B284.title: "&c{entity.cataclysm.ignis}"
	quest.5652ECC6C043512A.quest_desc: ["Słoik przechowuje źródło z pobliskich łączników i oddaje je urządzeniom obok. Źródło zostaje w słoiku, gdy go rozbijesz i przeniesiesz."]
	quest.567A945675A4668C.quest_desc: ["Dwie sztabki niklu, krzem i dwie sztabki stali zmieszane w podgrzewanym tyglu. Z tego stopu powstają magnesy i rdzenie transformatorów."]
	quest.567F9E3A92CFDD01.quest_desc: ["Różdżka Building Wands stawia rząd albo całą płaszczyznę bloków jednym kliknięciem i ma kilka trybów. Kamienna jest najprostsza."]
	quest.56AF5294911FC1A2.quest_desc: ["Przekaźnik pulsowy zamienia sygnał w krótki impuls po ustawionym opóźnieniu, przedłużacz wydłuża impuls, a czasomierz sam wysyła impulsy co zadany czas."]
	quest.56AF5294911FC1A2.title: "Impulsy"
	quest.56C8A918170C2319.quest_desc: ["Kable ME zjadają fluix szybko. Zautomatyzuj ładowanie certusu i mieszanie fluixu, zanim sieć urośnie."]
	quest.56C8A918170C2319.quest_subtitle: "Dowód automatyzacji"
	quest.56D0A53AFC644F79.quest_desc: ["Fotele, kanapy i krzesła zrobione z siedzisk Create. Usiądziesz na nich także w jadącej maszynie albo pociągu."]
	quest.56D0A53AFC644F79.title: "Create: Interiors"
	quest.56E30E2228D03001.quest_desc: ["Ustawia, którą ścianką maszyna przyjmuje i oddaje przedmioty, płyny, gazy i energię. Tryb zmienisz Shiftem z prawym przyciskiem."]
	quest.56E5620FC5621E83.quest_desc: ["Gubią ją minotaury w Labiryncie, trafia się też w jego skrzyniach."]
	quest.56FCFB3D4482DC11.quest_desc: ["Wołowina, ziemniak i marchewka ugotowane w garnku. Gulasz trafi też do pieczęci."]
	quest.56FCFB3D4482DC11.quest_subtitle: "Składnik pieczęci"
	quest.56FDC002E0BF6894.quest_desc: ["Na mrocznym ołtarzu odprawisz rytuały Goety: przedmiot aktywujący kładziesz na ołtarzu, składniki na postumentach wokół, a rytuał zużywa dusze z totemu."]
	quest.5701D26C1D823E9E.quest_desc: ["Obsydian powstaje, gdy woda zalewa źródło lawy. Żelaznego kilofa nie posłucha, ale &6{block.create.mechanical_drill}&r go wykopie."]
	quest.5701D26C1D823E9E.title: "Obsydian z wiertła"
	quest.572CA3255019880B.quest_desc: [
		"&7Ekwipunek: odporność na magię i dużo leczenia.&r"
		"Rozwścieczony Umarły Król rzuca więcej i silniejszych zaklęć niż zwykły. Za zwycięstwo czeka lepszy łup."
	]
	quest.572CA3255019880B.quest_subtitle: "Boss"
	quest.572CA3255019880B.title: "&c{entity.gametechbcs_spellbooks.hard_dead_king}"
	quest.57762B864DAACBEF.quest_desc: ["Zwiększa zasięg stawiania bloków. Przepis zużywa szablon ulepszenia netherytowego z bastionu."]
	quest.579AFDF7D65CDAAF.quest_desc: [
		"Wiertła, piły, żniwiarki i pługi pracują, gdy maszyna jedzie. Tłok z rzędem wierteł wydrąży tunel, a łożysko z piłami zetnie całe drzewo."
		""
		"&7Zadanie zalicza osiągnięcie Create za maszynę z narzędziami.&r"
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę mosiądzu.&r"
	]
	quest.579AFDF7D65CDAAF.title: "Maszyna przy pracy"
	quest.57A13FC9DC28BBCD.quest_desc: ["Leżący zbiornik na płyny: zmieści się tam, gdzie pionowy nie wejdzie. Jako kocioł parowy jest mniej wydajny od zwykłego zbiornika."]
	quest.57A1EFB450BD18EB.quest_desc: ["Serce pieca Clibano z ciemnego kamienia i pieca hutniczego. Clibano wypala rudy i kryształy wydajniej niż zwykły piec, a z reliktem rzemieślnika także stopy."]
	quest.57B6AA92B34C083E.quest_desc: [
		"Żelazny napierśnik i odczynnik wiązania w kręgu. Zbroja świadoma uczy się z tego, co przeżywasz, i zbiera ulepszenia za trening."
		""
		"&7Kolejny tier Neo Vitae pojawi się tutaj, gdy twoja drużyna wejdzie w erę pary i stali.&r"
	]
	quest.57E34B4F51618983.quest_desc: ["Każdą część netherytowej zbroi przekujesz w rytuale na drugim poziomie kuźni ze smoczymi łuskami i stalą obsydianową."]
	quest.57E34B4F51618983.quest_subtitle: "Kamień milowy"
	quest.57E34B4F51618983.title: "&dZbroja Tajemnego Smoka"
	quest.57E42A8BD4EE01DC.quest_desc: ["Powstaje ze zwykłego silnika diesla. Modułowe silniki ustawiasz jeden za drugim na wspólnym wale, a ich siła rośnie z każdym kolejnym."]
	quest.57F78BDAB42DC922.quest_desc: ["Łożysko obrotowe obraca przyklejoną konstrukcję, a obrót z wału przechodzi przez nie dalej. Sygnał redstone je odblokowuje i wtedy kręci się swobodnie."]
	quest.5813C75ACD86D402.quest_desc: [
		"Rytuał wiązania przy Starbunclu, Drygmy albo innym stworzeniu zamienia je w zwój. Ze zwoju nauczysz się chowańca, który chodzi z tobą i wzmacnia twoje zaklęcia."
		""
		"&7Chowańca przywołasz z menu chowańców Ars Nouveau; klawisz sprawdzisz w ustawieniach sterowania.&r"
	]
	quest.5813C75ACD86D402.quest_subtitle: "Kamień milowy"
	quest.5813C75ACD86D402.title: "&dPierwszy chowaniec"
	quest.58237CA7E7D596F1.quest_desc: ["Ulepszenie prędkości przyspiesza maszynę, a ulepszenie energii zmniejsza jej zużycie prądu. Wkładasz je w panel ulepszeń z boku okna maszyny."]
	quest.58237CA7E7D596F1.title: "Ulepszenia maszyn"
	quest.5827F3131DDD5272.quest_desc: ["Mocny Tau przerobiony w atanorze; narzędzie, którego potrzebuje, pokaże JEI. Odłamek to klucz do trzeciego poziomu ołtarza."]
	quest.5846243BDD48D309.quest_desc: ["Szuflada kompaktująca sama zamienia bryłki w sztabki, a sztabki w bloki. Jedna szuflada mieści cały zapas metalu."]
	quest.58524679C8F4EE70.quest_desc: [
		"Wróżbita Tenebrae zna zaawansowane rytuały: samodzielne zbieranie esencji, lot w twoim sanktuarium i meteor pełen skarbów."
		""
		"&7Kolejny tier Neo Vitae pojawi się tutaj, gdy twoja drużyna wejdzie w erę arkanów.&r"
	]
	quest.5857AAD82B30CC8F.quest_desc: [
		"&7Era okultyzmu · zalecane: netherytowa zbroja&r"
		"Fantomowi rycerze strzegą serca twierdzy i walczą razem. Gdy padną wszyscy, otworzy się droga do mrocznej wieży."
	]
	quest.5857AAD82B30CC8F.quest_subtitle: "Boss"
	quest.5857AAD82B30CC8F.title: "&c{entity.twilightforest.knight_phantom}"
	quest.58654D9FC8257D1D.quest_desc: ["Pieczęć Ery Mosiądzu łączy magię z techniką: andezytowa obudowa idzie na środek aparatu, a prasa i koło wodne na piedestały."]
	quest.58654D9FC8257D1D.quest_subtitle: "Składnik pieczęci"
	quest.58654D9FC8257D1D.title: "Części Create do pieczęci"
	quest.586CEB4A4C9DC7F4.quest_desc: ["Zbiornik chemiczny trzyma gazy, a zbiornik płynów – płyny. Podniesione nie tracą zawartości."]
	quest.586CEB4A4C9DC7F4.title: "Zbiorniki"
	quest.58A474BF45942BE4.quest_desc: ["Cały magazyn QIO w kieszeni, na tej samej częstotliwości. Przepis wymaga polonu z reaktora."]
	quest.58BA3EA7072BA248.quest_desc: ["Łączy przekaźniki ze słoikami i ze sobą: kliknij nią najpierw źródło, a potem cel. Przyda się też do wskazywania domu pomocnikom."]
	quest.58BF072F912D136C.quest_desc: ["Postaw łóżko i popatrz na nie przez chwilę. Przesypiasz w nim noc i odradzasz się przy nim po śmierci."]
	quest.58BF072F912D136C.quest_subtitle: "Kamień milowy"
	quest.58BF072F912D136C.title: "&aWłasne łóżko"
	quest.58C750F8A589135A.quest_desc: ["Create Deco ma do mosiądzu kładki, okna, kraty i lampy. Zrobisz je na stole albo w przecinarce ze sztabek i arkuszy mosiądzu."]
	quest.58C750F8A589135A.title: "Mosiężny wystrój"
	quest.58CBE64255700D53.quest_desc: ["Prasę zrobisz z dwóch pras AE2 i osobliwości z kondensatora materii, a sam procesor z nadruku na stali nieba, pyłu fluix i krzemu."]
	quest.58D17712DACB5B30.quest_desc: ["Pokrywa na tyglu albo duży fermenter zamienia cukier z mączką kostną w etanol. Duży fermenter daje go dwa razy więcej."]
	quest.58D17712DACB5B30.title: "Fermentacja"
	quest.58D1CC10E40C8004.quest_desc: [
		"Przewodnik po Ars Nouveau: glify, rytuały, chowańce i urządzenia. Zrobisz go z książki i lazurytu."
		""
		"&7Te zadania rozwijają gałąź magii z rozdziału ery run.&r"
	]
	quest.58EA7307AD2C3346.quest_desc: ["Wysoka wieża magów osnowy z Ars Additions. Przeszukaj jej piętra i skrzynie."]
	quest.58EA7307AD2C3346.title: "Wieża osnowy"
	quest.58FFC06DD90D9804.quest_desc: [
		"Pierwszy pierścień złożony na stole jubilerskim. Metal decyduje o jego sile, a kamień o premii."
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę arkanów.&r"
	]
	quest.59078FB8638076D6.quest_desc: ["Szuflady Endu o tej samej częstotliwości dzielą zawartość, nawet w innym wymiarze. Przepis wymaga skrzyni Endu."]
	quest.590F3990007A92D8.quest_desc: [
		"Prasa nad tyglem ubija sztabkę żelaza z węglem w żeliwo. Z żeliwa zrobisz rury, zbiorniki i zawory, a także właz wielkiego pieca."
		""
		"&7Główną linię stali znajdziesz w rozdziale Ery Pary i Stali. Ta strona ją rozszerza.&r"
	]
	quest.591789DB17E2977D.quest_desc: ["Silnik na paliwo płynne, który obraca dyszę w pionie i w poziomie. Kieruje statkiem samym ciągiem, bez sterów i śmigieł."]
	quest.593C8AAB8243A271.quest_desc: ["Butla z tlenem i maska pozwalają oddychać pod wodą. Butlę napełnisz tlenem z separatora."]
	quest.593C8AAB8243A271.title: "Sprzęt nurka"
	quest.594B63B2E2FD2FD0.quest_desc: ["Świecące paski na kablu pokazują, ile kanałów nim płynie. Z nim najłatwiej znaleźć wąskie gardło."]
	quest.595A475F2748C272.quest_desc: ["Bloki magnetytu leżą w Overworldzie jak każda ruda. Magnetyt to rdzeń podstawowego silnika i najsilniejszych magnesów."]
	quest.5965A70AABD940AE.quest_desc: [
		"Bumblezone to wymiar wnętrza olbrzymiego ula. To wyprawa poboczna: nie wpływa na bramy er."
		""
		"&cNie krzywdź pszczół i nie zabieraj miodu na oczach roju, bo cały ul rzuci się na ciebie.&r"
	]
	quest.5965A70AABD940AE.title: "W ulu"
	quest.597017FC777F73A0.quest_desc: ["Fokus wzmacnia zaklęcia przywołania. Powstaje w aparacie zaklinającym z hołdu, rogu, kolca i skrzydła wildena."]
	quest.5975AA6F64285BD0.quest_desc: [
		"Kontrolery odchylenia i podniesienia przy lawecie same wycelują działo w kontakt z radaru, gdy filtr celów w kontrolerze sieci włączy namierzanie."
		""
		"&7Ponder (przytrzymaj W nad przedmiotem) pokaże cały proces.&r"
	]
	quest.5975AA6F64285BD0.quest_subtitle: "Kamień milowy"
	quest.5975AA6F64285BD0.title: "&6Automatyczne celowanie"
	quest.599A5336E22779AA.quest_desc: [
		"Ołtarz Życia z pieca, złota i kamienia. Zamienia krew w esencję życia (Essentia Vitae) i za nią przemienia położone w nim przedmioty."
		""
		"&7Przewodnik moda to Scriptura Vitae (książka i czerwony pył).&r"
	]
	quest.59B7032A9B64E5CE.quest_desc: ["Krzesła z Create: Interiors przypinają gracza do ruchomej maszyny tak jak siedzenia Create, ale wyglądają jak meble. Postaw je w wagonie pasażerskim."]
	quest.59B7032A9B64E5CE.title: "Fotel pasażera"
	quest.59CCD46F81334CAE.quest_desc: ["Rozpędź parę kół kruszących do największej prędkości, 256 obr./min. Im szybciej się kręcą, tym szybciej mielą."]
	quest.59CCD46F81334CAE.title: "Kruszarka na pełnych obrotach"
	quest.59FE85A5E327CDB2.quest_desc: ["Rzadka ruda w kamieniach i lodzie tego wymiaru. Z diamentu i patyków zrobisz kilof."]
	quest.59FE85A5E327CDB2.title: "Gwiezdny diament"
	quest.5A0A86DAFB4D5400.quest_desc: ["Pryzmaty powstają w rytuałach z elementarium na kuźni. Pryzmat hutnika nadaje modyfikator ognisty (wykopane rudy od razu się przetapiają), ziemny burzący, a morski wodny."]
	quest.5A0A86DAFB4D5400.title: "Pryzmat żywiołu"
	quest.5A1911850C984603.quest_desc: [
		"Przenosi obrót jak wał, ale pęka, gdy sieć zostanie przeciążona. Kawałek wału przecięty piłą chroni resztę maszyn przed zatrzymaniem."
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę mosiądzu.&r"
	]
	quest.5A1A0A99C8D00D22.quest_desc: ["Pokazuje, jak szybko kręci się wał, który przez niego przechodzi. Sygnał z komparatora rośnie razem z prędkością."]
	quest.5A3EEEF104791B0F.quest_desc: ["Słój mieści do 100 porcji jednej mikstury, a flaszka zabiera z niego osiem łyków naraz. Przepis na flaszkę wymaga bloku złota."]
	quest.5A3EEEF104791B0F.title: "Słój i flaszka mikstur"
	quest.5A416D9BE26B1DF0.quest_desc: ["Diamentowa przedłuża ściany o jeszcze więcej bloków naraz i rzadko się psuje."]
	quest.5A494CCAE6913D20.quest_desc: ["Zbiera przedmioty leżące przed szufladą. Postaw ją pod farmą, a plony same trafią do środka."]
	quest.5A71C5EA9533AA40.quest_desc: [
		"&7Ekwipunek: najlepsza zbroja i dużo jedzenia.&r"
		"Machina wojenna illagerów z Goety, silniejsza od każdego golema. Pojawia się na końcu najazdu illagerów, gdy pokonasz resztę napastników."
	]
	quest.5A71C5EA9533AA40.quest_subtitle: "Boss"
	quest.5A71C5EA9533AA40.title: "&c{entity.goety.hostile_redstone_monstrosity}"
	quest.5A725536D35042F2.quest_desc: ["Papier z niebieskim barwnikiem. Plan z takiego papieru jest trwały: zostaje w siatce po każdej części, którą z nim zrobisz."]
	quest.5A92BED52C415431.quest_desc: ["Zbiera i wylewa płyny prosto z plecaka. Działa z wiadrami i z blokami płynów w świecie."]
	quest.5A9B278AE2E15BB8.quest_desc: [
		"Kamienie teleportacyjne stoją w wioskach i na dzikich terenach. Kliknij jeden, żeby go aktywować: z każdego aktywnego kamienia przeniesiesz się do innego, który już znasz."
		""
		"&7Podróż kosztuje poziomy doświadczenia: im dalej, tym więcej, najwyżej 27. Tyle samo kosztuje skok do innego wymiaru.&r"
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę andezytu.&r"
	]
	quest.5A9B278AE2E15BB8.quest_subtitle: "Kamień milowy"
	quest.5A9B278AE2E15BB8.title: "&aKamień teleportacyjny"
	quest.5AAA7DA6CEEDCB73.quest_desc: ["Wskazuje Starbuncle'owi drogę: kliknij nią Starbuncle'a, a potem skrzynię, do której ma odkładać. W odwrotnej kolejności wyznaczysz skrzynię, z której ma brać."]
	quest.5AAF1AE8953BA6F9.quest_desc: ["Laser trafia w &6{item.mekanismgenerators.hohlraum}&r z deuterem i trytem, a reakcja podtrzymuje się sama. Daje ogromne ilości prądu."]
	quest.5AAF1AE8953BA6F9.title: "Reaktor syntezy"
	quest.5ABAFD835E5F9B4B.quest_desc: ["Wieże stawiasz wewnątrz koszar. Mają ten sam poziom co koszary i z każdym poziomem mieszczą więcej strażników."]
	quest.5ABAFD835E5F9B4B.title: "Wieża koszar"
	quest.5ADC09F6FFCFB7EA.quest_desc: ["Opornik nawijasz w maszynie do nawijania szpulą drutu z konstantanu, czyli stopu miedzi i niklu. Wchodzi w płytki drukowane i polaryzator."]
	quest.5ADFE8A241A4DE13.quest_desc: ["Kolonia rośnie: dziesięciu mieszkańców to już mała osada."]
	quest.5ADFE8A241A4DE13.title: "Dziesięciu mieszkańców"
	quest.5B05263D23BC656C.quest_desc: ["Leży w skrzyniach posterunków grabieżców."]
	quest.5B1F1DC0044D9AD3.quest_desc: ["Wszystkie drzewka księgi prowadzą tutaj. Na własnej arenie czeka finałowy boss, a jego pokonanie kończy paczkę."]
	quest.5B1F1DC0044D9AD3.quest_subtitle: "Ostatnia próba"
	quest.5B1F1DC0044D9AD3.title: "Finał"
	quest.5B3DCC5D47CB5A13.quest_desc: ["Peron z gładkiego kamienia i blachy metra wystarczą na podziemną stację. Dołóż tablicę odjazdów i gotowe."]
	quest.5B3DCC5D47CB5A13.title: "Stacja metra"
	quest.5B52EC7338B66FC8.quest_desc: ["Zostawiają go pijawki i kłapacze sculku. Trafia się też w skrzyniach świątyni."]
	quest.5B5EE04A4468E020.quest_desc: ["Nullscape zmienia zewnętrzne wyspy: kryształowe szczyty, krainy cienia i jałowe pustkowia. Odwiedź wszystkie trzy."]
	quest.5B5EE04A4468E020.title: "Krainy Nullscape"
	quest.5B6A03BBC90BB2C8.quest_desc: ["Na kowadle czarów zdejmuje z przedmiotu nałożone zaklęcie albo ulepszenie, a w siatce rzemiosła czyści runę z powrotem do pustego kamienia."]
	quest.5B71FE2C6A8F492B.quest_desc: ["Księga wiązania marida z zielonym barwnikiem, połączona ze słownikiem. Marid to najpotężniejszy z duchów, które możesz związać."]
	quest.5B9DFFC1AFEC0403.quest_desc: ["Rytuał krystalizacji przy koksowniku niszczy pobliskie nieumarłe i zostawia po nich odłamki dusz. Przepis znajdziesz w księdze."]
	quest.5BAAF6D7A7F0DB08.quest_desc: ["Przenosi przedmioty w dół między poziomami. Z wentylatorem pod spodem albo nad nim popchnie je także w górę."]
	quest.5BC232B70C3C6E44.quest_desc: ["Szef kuchni gotuje złożone potrawy, w paczce także dania z Farmer's Delight. Urozmaicona dieta podnosi zadowolenie."]
	quest.5BD1B40623293600.quest_desc: [
		"&7Era mosiądzu · zalecane: diamentowa zbroja, tarcza&r"
		"Ten illager przyzywa kły i dręczycieli, a w walce się teleportuje. Czeka w leśnym dworze."
	]
	quest.5BD1B40623293600.quest_subtitle: "Boss"
	quest.5BD1B40623293600.title: "&c{entity.illagerinvasion.invoker}"
	quest.5BD6936A8792636B.quest_desc: ["Odwrotność alternatora: bierze FE i kręci wałem do 256 obr./min. Prędkość ustawisz na nim samym, a przy mniejszej zużywa mniej prądu."]
	quest.5BEA2E6701541E25.quest_desc: ["Płaskowyż na szczycie kończy drogę przez Las Zmierzchu. Stoi tu zamek, ale jego władca jeszcze się nie zjawił."]
	quest.5BEA2E6701541E25.quest_subtitle: "Kamień milowy"
	quest.5BEA2E6701541E25.title: "&a{biome.twilightforest.final_plateau}"
	quest.5BF342198B2E3854.quest_desc: [
		"Pozostałość zostawia blok starożytnego metalu, a z bloku wyjmiesz dziewięć sztabek. Zrobisz z nich starożytną włócznię, która ciska burzą piaskową."
		""
		"&7Kolejny tier Cataclysmu pojawi się tutaj, gdy twoja drużyna wejdzie w erę atomu.&r"
	]
	quest.5BFA132FF84F20DC.quest_desc: ["Pełna zbroja na pierwsze wyprawy w głąb lasu. Sztabki zrobisz z żywokorzenia, surowego żelaza i samorodka złota."]
	quest.5BFA132FF84F20DC.title: "Zbroja z żelaznego drewna"
	quest.5C0A8F22D7CE6368.quest_desc: ["Inteligentny detektor daje sygnał, gdy w pojemniku albo na taśmie pojawi się wybrany przedmiot. Przełącznik progowy reaguje, gdy pojemnik zapełni się powyżej albo opróżni poniżej progu."]
	quest.5C0A8F22D7CE6368.title: "Czujniki zawartości"
	quest.5C2E2D24EC32DB10.quest_desc: ["Kwitnące lasy i sosnowe pustkowia z moda Environmental."]
	quest.5C2E2D24EC32DB10.title: "Environmental"
	quest.5C3B0BD665832263.quest_desc: ["Witalny łącznik czerpie źródło z rodzących się i ginących w pobliżu zwierząt, a grzybniowy z jedzenia, które do niego wrzucisz. Wystarczy jeden z nich."]
	quest.5C3B0BD665832263.title: "Inne łączniki źródła"
	quest.5C42ABC32D1D9FB6.quest_desc: ["Kręta wieża z czarnego kamienia, dzieło Explorify."]
	quest.5C42ABC32D1D9FB6.title: "Czarna spirala"
	quest.5C54CDF789A5A4E8.quest_desc: ["Magia ery arkanów wciąż potrzebuje stali: stalowa obudowa z ery pary i stali trafi na piedestał pieczęci."]
	quest.5C54CDF789A5A4E8.quest_subtitle: "Składnik pieczęci"
	quest.5C57E2D5F683D4F9.quest_desc: ["Filtr po cechach zamiast po nazwie: np. „da się przetopić” albo „jest rudą”."]
	quest.5C580E692F630F64.quest_desc: ["Wielka budowla Incendium na kwarcowych równinach. Jej skarbiec kryje się głęboko w środku."]
	quest.5C580E692F630F64.quest_subtitle: "Kamień milowy"
	quest.5C580E692F630F64.title: "&aSanktuarium"
	quest.5C627B1FE2DB7973.quest_desc: ["Dowód automatyzacji: 256 procesorów logicznych. Zapisz przepisy przetwórcze dla inskrybentów, a sieć sama zamówi nadruki i złoży procesory."]
	quest.5C627B1FE2DB7973.title: "Linia procesorów"
	quest.5C71D86C98FA0D26.quest_desc: ["Robi stopy Silent Gear hurtem: z bloku szkarłatnego żelaza wychodzą trzy sztabki szkarłatnej stali, a z żelaza i węgla – stal wysokowęglowa."]
	quest.5C71D86C98FA0D26.quest_subtitle: "Kamień milowy"
	quest.5C71D86C98FA0D26.title: "&6{block.silentgear.alloy_forge}"
	quest.5C82D5FBE1E61D6C.quest_desc: ["Loch Deep Aether z kamienia chmur. Na jego końcu szaleje burza."]
	quest.5C82D5FBE1E61D6C.title: "Mosiężny loch"
	quest.5CA544501A83065F.quest_desc: ["Najprostszy cylinder zrobisz z blachy żelaza i krzesiwa. Cylinder diesla wymaga aluminium, a ze świecą zapłonową staje się cylindrem benzynowym."]
	quest.5CA544501A83065F.title: "Cylindry"
	quest.5CC2444299911699.quest_desc: ["Magazyn zbiera zapasy kolonii, a kurierzy rozwożą je pracownikom. Budowniczy nie musi już czekać na ciebie."]
	quest.5CC2444299911699.title: "Magazyn kolonii"
	quest.5CC59E24E374B2DC.quest_desc: [
		"Z Nagi wypadają łuski. Mając łuskę, przejdziesz przez barierę wokół wieży Licza, a z kilku zrobisz zbroję z łusek."
		""
		"&7Kolejny tier Lasu Zmierzchu pojawi się tutaj, gdy twoja drużyna wejdzie w erę mosiądzu.&r"
	]
	quest.5CC59E24E374B2DC.quest_subtitle: "Kamień milowy"
	quest.5CC59E24E374B2DC.title: "&c{item.twilightforest.naga_scale}"
	quest.5CDCF57E0219A241.quest_desc: ["Trzeci pierścień run (razem 52) i czterobloczne słupy zwieńczone cegłami z krwawnika. Cegłę zrobisz z odłamka krwi i kamienia."]
	quest.5CDCF57E0219A241.title: "Trzeci poziom ołtarza"
	quest.5CF4CB83D0301EDB.quest_desc: ["Mnoży pojemność szuflady. Włóż je w gniazdo ulepszeń w oknie szuflady; kolejne poziomy pojawią się w następnych erach."]
	quest.5CF702CF9744BF2F.quest_desc: ["Tablica z klapkami pokaże tekst z nadajnika wyświetlacza na dużej powierzchni. Pasuje na dworzec albo na tablicę stanu magazynu."]
	quest.5D0F39D8E7E5AAD3.quest_desc: ["Grabarz chowa poległego mieszkańca na cmentarzu, zanim jego grób zniknie."]
	quest.5D0F39D8E7E5AAD3.title: "Pochówek"
	quest.5D1324ACED9A8423.quest_desc: ["Kielnia stawia losowe bloki z palety, którą sam ułożysz, więc ściany i drogi nie wyglądają jak z jednego bloku. Szablon różdżki na stole kowalskim doda jej tryb różdżki."]
	quest.5D1B7F9FE4054D42.quest_desc: [
		"Kable ekwipunku łączą skrzynie z różnych pomieszczeń, a złącze kabla podpina do nich każdy pojemnik. W sieci musi być jedno złącze ekwipunku."
		""
		"&7Przepis na złącze kabla wymaga kwarcu z Netheru.&r"
	]
	quest.5D1B7F9FE4054D42.quest_subtitle: "Kamień milowy"
	quest.5D1B7F9FE4054D42.title: "&bSieć kablowa"
	quest.5D21E1D7BE156889.quest_desc: ["Podłącz ssący koniec rury z pompą do wody. Z dużej wody pompa ciągnie bez końca, a tyle potrzebują wylewki, wiatraki płuczące i później kotły parowe."]
	quest.5D21E1D7BE156889.title: "Własne ujęcie wody"
	quest.5D25B687E0D447EB.quest_desc: [
		"Im silniejsze magnesy wokół cewki, tym większa część obrotów zamienia się w prąd. Cewka zużywa wtedy jednak więcej SU."
		""
		"&7Przeładowane złoto i diament zrobi nasycacz.&r"
	]
	quest.5D25B687E0D447EB.title: "Silniejsze magnesy"
	quest.5D3EAF0D8F911EF4.quest_desc: ["Miej naraz 256 ubitego prochu. Proch z farmy albo z miksera TFMG niech trafia pod prasę bez twojego udziału."]
	quest.5D3EAF0D8F911EF4.quest_subtitle: "Dowód automatyzacji"
	quest.5D3EAF0D8F911EF4.title: "Prochownia"
	quest.5D46B11490562A75.quest_desc: ["Przepuszcza prąd ze złącza wejścia do złącza wyjścia tylko przy sygnale redstone. Tak odetniesz całą gałąź sieci jedną dźwignią."]
	quest.5D4815B56228BA21.quest_desc: ["Farmer uprawia pola wyznaczone przy swojej chacie i karmi kolonię."]
	quest.5D4815B56228BA21.title: "Farmer"
	quest.5D62B4CE8C8C46BE.quest_desc: ["Mieści kilka fokusów, więc zmieniasz zaklęcia w różdżce bez szukania w ekwipunku."]
	quest.5D71B2B7D3F25109.quest_desc: ["Poradnik jubilera: opisuje wzory, metale i kamienie oraz to, co daje każde połączenie."]
	quest.5D7589E3D990F630.quest_desc: ["Miej naraz 256 krzemieni. Młynek mieli bruk na żwir, a żwir na krzemień: postaw wiertło przy generatorze bruku i połącz wszystko taśmociągiem."]
	quest.5D7589E3D990F630.quest_subtitle: "Dowód automatyzacji"
	quest.5D7589E3D990F630.title: "Krzemień hurtem"
	quest.5D7A3A9975D51154.quest_desc: [
		"Kapelusz lorda wzmacnia dyniową broń, chroni przed ogniem i podpala tych, którzy cię atakują."
		""
		"&7Kolejny tier bossów świata pojawi się tutaj, gdy twoja drużyna wejdzie w erę okultyzmu.&r"
	]
	quest.5D9D6B88DE62D6D0.quest_desc: ["Dowód automatyzacji: 512 sztabek mosiądzu. Ręcznie tego nie zrobisz – niech miedź i cynk same trafiają do tygla, a gotowe sztabki do magazynu."]
	quest.5D9D6B88DE62D6D0.title: "Mosiężna huta"
	quest.5DAEA20EFA6C8D5F.quest_desc: [
		"Trzy porcje pyłu siarki, saletra i woda w kadzi z mieszalnikiem. Kwas trafi do akumulatorów i wytrawi płytki drukowane."
		""
		"&7Saletrę dostaniesz, krusząc ziemię w kołach kruszących.&r"
	]
	quest.5DB93BA6770DC163.quest_desc: ["Skrzynka pocztowa pozwala zamówić towar z magazynu, a do skrytki odkładasz rzeczy, które kurier zabierze."]
	quest.5DB93BA6770DC163.title: "Skrzynka i skrytka"
	quest.5DC9FEF87A8C87FB.quest_desc: ["Trzyma zapas wybranych przedmiotów dla maszyn i przyjmuje do sieci wszystko, co do niego włożą."]
	quest.5DE5FDF54351C05C.quest_desc: ["Przyciąga przedmioty leżące w okolicy i chowa je do skrzyni. Przyda się przy farmach mobów i roślin."]
	quest.5DF46CB065481F2A.quest_desc: ["Wystarczy jedno z dwóch: koło wodne albo wiatrak, który napędza maszynę."]
	quest.5DF46CB065481F2A.quest_subtitle: "Kamień milowy"
	quest.5DF46CB065481F2A.title: "&6Pierwszy napęd"
	quest.5E06FAA2FCFC47C6.quest_desc: ["Złoto i kwarc nasycone duchami na ołtarzu duchów Malum. To jedyny magiczny składnik Pieczęci Ery Atomu."]
	quest.5E06FAA2FCFC47C6.quest_subtitle: "Składnik pieczęci"
	quest.5E123B2FAE9A349E.quest_desc: ["Każda część wymaga polonu, HDPE i ostatecznego układu sterowania. Z modułami będzie to twoja zbroja do końca gry."]
	quest.5E123B2FAE9A349E.quest_subtitle: "Kamień milowy"
	quest.5E123B2FAE9A349E.title: "&6MekaPancerz"
	quest.5E173B7F25834017.quest_desc: ["Przebudzony szmaragd połączony z pustym fokusem. Trafia do koron, pierścieni i serca nocy."]
	quest.5E1C588E91C5B4A5.quest_desc: ["Magnetyt nasycony przeładowanym diamentem i złotem. Najsilniejszy magnes do cewek New Age."]
	quest.5E3156B584956A90.quest_desc: ["Otwórz go w locie, a łagodnie opadniesz na ziemię. Zrobisz go z zimnych chmur."]
	quest.5E36AC6D17881DC6.quest_desc: ["Kruszy bruk na żwir, żwir na piasek i piasek na glinę. W erze mosiądzu zwykłe budynki rosną do poziomu 3."]
	quest.5E36AC6D17881DC6.title: "Rozdrabniacz"
	quest.5E492879077E6ACF.quest_desc: ["Leży na szczycie świątyni. Na stole kowalskim ulepszysz nim diamentowy sprzęt płytką resonarium."]
	quest.5E492879077E6ACF.title: "Szablon resonarium"
	quest.5E49617147F3AA5A.quest_desc: [
		"Mechaniczna szlifierka zdejmuje zaklęcia z przedmiotów i zamienia je w płynne doświadczenie. Pompuj je rurami jak każdy płyn Create i nalej do wiadra."
		""
		"&7Ponder (W) pokaże, jak działa szlifierka.&r"
	]
	quest.5E49617147F3AA5A.title: "Płynne doświadczenie"
	quest.5E8963EBCE1D33BF.quest_desc: ["Koło sterowe pozwala kierować statkiem z pokładu. Podłączenie pokazuje Ponder (W)."]
	quest.5E8AAD7F4E021B09.quest_desc: ["Polon trafi do MekaPancerza, jego modułów, ramy reaktora syntezy i największych dysków QIO ze strony Magazyny. Zbierz 16 kulek."]
	quest.5E8AAD7F4E021B09.title: "Zapas polonu"
	quest.5EAFE5A707DDE18A.quest_desc: ["Nagroda za próbę Rzeźbiarza. Podnosi głazy, drąży tunele i wznosi kolumny, a ładuje się w ekwipunku."]
	quest.5EAFE5A707DDE18A.quest_subtitle: "Kamień milowy"
	quest.5EAFE5A707DDE18A.title: "&c{item.mowziesmobs.earthrend_gauntlet}"
	quest.5EB8D600E3FC4A2C.quest_desc: ["Drugi pierścień run piętro niżej (razem 24) i cztery słupy w rogach zwieńczone szkłem zabarwionym krwią. Szkło wytopisz z piasku życia."]
	quest.5EB8D600E3FC4A2C.title: "Drugi poziom ołtarza"
	quest.5EC7B7B95A593E93.quest_desc: ["Złóż bryłki po strażniku w sztabkę zapomnianego metalu. Z szablonem kowalskim ulepszysz nią narzędzia z cloggrum."]
	quest.5EDD91AC87AC75E1.quest_desc: ["Końcówka z materiału, np. diamentu albo redstone'u, dodaje narzędziu stałą premię do statystyk. Przytrzymaj Ctrl, żeby je zobaczyć."]
	quest.5EF52EC41E8A9EED.quest_desc: ["Przechowasz w nim własne doświadczenie jako płyn i odbierzesz je, kiedy zechcesz."]
	quest.5F17F7AF7E6422E1.quest_desc: ["Rzadki kryształ z rudy regalium. Trafia się też w skrzyniach katakumb."]
	quest.5F1B2002A402CF9E.quest_desc: ["Kielnia sama zamieni zwykłe bloki z palety na ich warianty z Chipped i Rechiseled. Nie musisz nosić każdego wzoru osobno."]
	quest.5F1E48AF5125A86B.quest_desc: ["Wskaźnik, który przyczepisz kluczem do maszyny. Pokazuje dodatkowe dane, np. temperaturę tygla."]
	quest.5F1EA8FA6531E9CC.quest_desc: ["Chlorowodór podnosi przerób do czterech odłamków z bloku złoża."]
	quest.5F3B675A7597B4AC.quest_desc: ["Klucz Królowej Walkirii. Skrzynia skarbów srebrnego lochu kryje święty miecz, miecz błyskawic, pelerynę niewidzialności albo kamień regeneracji."]
	quest.5F3D657BDA4F6CBE.quest_desc: [
		"&7Ekwipunek: oddychanie pod wodą, broń dystansowa, najlepsza zbroja.&r"
		"Poza wodą jest nietykalny, więc walczysz na jego terenie."
	]
	quest.5F3D657BDA4F6CBE.quest_subtitle: "Boss"
	quest.5F3D657BDA4F6CBE.title: "&c{entity.cataclysm.the_leviathan}"
	quest.5F78F20E1B068EDF.quest_desc: ["Stawia całe ściany i podłogi z wybranego bloku, w wielu kształtach naraz. Działa na prąd: ładujesz go jak każde urządzenie FE."]
	quest.5F871BB9255A6DB1.quest_desc: ["Jedna komórka z własnym terminalem na wierzchu. Wystarczy na mały magazyn bez kontrolera."]
	quest.5F9670FA9D06E8C2.quest_desc: ["Wystarczy jeden z dwóch bossów Lasu Zmierzchu. Jego trofeum to jeden z dwóch bossów potrzebnych do pieczęci."]
	quest.5F9670FA9D06E8C2.quest_subtitle: "Kamień milowy"
	quest.5F9670FA9D06E8C2.title: "&cNaga lub Licz"
	quest.5F9BEC137397BB8A.quest_desc: [
		"&7Era pary i stali. Zalecany ekwipunek: łuk i dobra zbroja.&r"
		"Strażnik mosiężnego lochu z Deep Aether, który wisi wysoko w chmurach. Żeby zaczął walkę, musisz go najpierw trafić."
	]
	quest.5F9BEC137397BB8A.quest_subtitle: "Boss"
	quest.5F9BEC137397BB8A.title: "&c{entity.deep_aether.eots_controller}"
	quest.5F9E25159923F4E4.quest_desc: ["Montaż sekwencyjny na arkuszu złota: aplikatory dokładają koła zębate i samorodek żelaza, a cykl powtarza się kilka razy. Część prób kończy się złomem. Mechanizm trafia do ramion, pociągów i pieczęci."]
	quest.5F9E25159923F4E4.quest_subtitle: "Kamień milowy i składnik pieczęci"
	quest.5F9E25159923F4E4.title: "&6{item.create.precision_mechanism}"
	quest.5FA8A23DA5514B11.quest_desc: [
		"Aktywator trzyma przedmioty w kieszeni innego wymiaru: tysiące sztuk w jednym bloku, z wyszukiwarką i siatką rzemiosła."
		"Złożysz go z dwóch części z rytuałów: podstawy (foliot, piedestał z innego kamienia, miedź i złoto) i kryształowej matrycy (dżin, blok kwarcu, perła Endera)."
		""
		"&7Rytuały i ich pentakle znajdziesz w Słowniku duchów.&r"
	]
	quest.5FA8A23DA5514B11.quest_subtitle: "Kamień milowy"
	quest.5FA8A23DA5514B11.title: "&bMagazyn wymiarowy"
	quest.5FBA1A088DCE0781.quest_desc: [
		"Foliot-sprzątacz zbiera przedmioty leżące w okolicy i odnosi je do wskazanej skrzyni."
		""
		"&7Kolejny tier magazynu wymiarowego pojawi się tutaj, gdy twoja drużyna wejdzie w erę atomu.&r"
	]
	quest.5FBF284F739CDAFA.quest_desc: ["Postaw go na kotle, a zagwiżdże parą, gdy dostanie sygnał redstone. Kolejne gwizdki dołożone na wierzch obniżają ton."]
	quest.5FEDA7CCB2D7149D.quest_desc: ["Najmocniejsza z kos Goety: jej cięcia lecą w powietrzu i dosięgają dalekich celów, osłabiając je. Sama się naprawia energią dusz."]
	quest.5FF0CD42F43D353D.quest_desc: ["W słońcu bombarduje odpady jądrowe neutronami i robi z nich polon. Odpady z reaktora poprowadź do niego gazociągiem."]
	quest.5FFBDADB6BF6B8D5.quest_desc: ["Naucz stolarza przepisu na drzwi w oknie tartaku. Rzemieślnik zrobi tylko to, czego go nauczysz."]
	quest.5FFBDADB6BF6B8D5.title: "Nauka przepisu"
	quest.60132F93531E1A5A.quest_desc: ["Serce głębi, kryształ dusz i kość sculku. Kostur ładuje się i wypuszcza falę dźwięku jak &c{entity.minecraft.warden}&r."]
	quest.601348DB24457802.quest_desc: [
		"Jedna różdżka może mieć kilka szablonów. Przełączasz je klawiszem „{key.constructionstick.change_upgrade}” albo w oknie opcji („{key.constructionstick.open_gui}”)."
		""
		"&7Kolejny tier różdżek pojawi się tutaj, gdy twoja drużyna wejdzie w erę pary i stali.&r"
	]
	quest.601348DB24457802.title: "Kilka szablonów naraz"
	quest.602A6DCEC704669E.quest_desc: ["Przebudowana świątynia pełna pułapek i ukrytych przejść. Patrz pod nogi."]
	quest.602A6DCEC704669E.title: "Świątynia w dżungli"
	quest.6040FC8DCAE63763.quest_desc: ["Nić zasięgu wydłuża o blok na poziom odległość, z której sięgasz po bloki i stworzenia. Wszyjesz ją w szaty na stole zmian."]
	quest.606E30C13378CEFE.quest_desc: ["Materiał z rozbiórki epickich przedmiotów na stole odzysku."]
	quest.608CF799F30A7569.quest_desc: ["Wiatrak dmucha strumieniem powietrza przez blok przed sobą. Przez ogień wędzi i piecze, przez lawę wytapia, a przez wodę płucze przedmioty."]
	quest.60A79A7408663768.quest_desc: ["Wiatrak dmuchający przez ogień dusz nawiedza przedmioty: piasek staje się piaskiem dusz, a dziwny dzwon nawiedzonym dzwonem. Zadzwoń nim, a pokaże miejsca, w których mogą pojawić się potwory."]
	quest.60A79A7408663768.title: "Nawiedzony dzwon"
	quest.60D52ABC1C27D732.quest_desc: ["Pompuje ciepło w jedną stronę rury, zamiast czekać, aż samo się rozejdzie."]
	quest.60E2F0D72741CD17.quest_desc: ["Mapa z soczewką labiryntu rysuje korytarze wokół ciebie, piętro po piętrze. Bez niej łatwo zabłądzić."]
	quest.60E2F0D72741CD17.title: "Mapa labiryntu"
	quest.6114725448FDA60C.quest_desc: ["Lodowa jaskinia w śnieżnym lesie, pełna zwykłych yeti. Alfa yeti czeka w największej komnacie."]
	quest.6114725448FDA60C.title: "Jaskinia yeti"
	quest.61184EB93DBC27D9.quest_desc: [
		"Zaczynasz z pustymi rękami, a drzewa nie ustąpią pięści. Potrzebujesz krzemienia: wykop go ze żwiru, a z odłupków zrób pierwsze narzędzia."
		""
		"Era kończy się bramą. Wymaga ona kamieni milowych z każdej gałęzi tego rozdziału i Pieczęci Ery Andezytu."
	]
	quest.61184EB93DBC27D9.quest_subtitle: "Początek drogi"
	quest.61184EB93DBC27D9.title: "Era Kamienia"
	quest.6124FF820414C41A.quest_desc: ["Zamraża wodę w lód i przerabia inne przedmioty na ich zimne odmiany. Paliwem jest lodokamień z Aetheru."]
	quest.612AF254D469E7B0.quest_desc: ["Mniejszy fokus wzmacnia zaklęcia jednego żywiołu. Nasyć w komorze ametyst esencją wybranego żywiołu, z dodatkiem sztabki złota."]
	quest.612AF254D469E7B0.title: "Mniejszy fokus żywiołu"
	quest.61306AE4484A4FE9.quest_desc: [
		"&7Era mosiądzu · zalecane: diamentowa zbroja&r"
		"Lodowy olbrzym śpi w śnieżnych biomach i budzi się, gdy podejdziesz za blisko."
	]
	quest.61306AE4484A4FE9.quest_subtitle: "Boss"
	quest.61306AE4484A4FE9.title: "&c{entity.mowziesmobs.frostmaw}"
	quest.613561F625D0DBDF.quest_desc: ["Z wieży destylacyjnej wypływa nie tylko olej napędowy. Napełnij wiadra benzyną, naftą, benzyną ciężką i ciężkim olejem, a zbiornik – LPG: każda frakcja zasila inną maszynę."]
	quest.613561F625D0DBDF.title: "Frakcje ropy"
	quest.6145486686129ED1.quest_desc: ["Nasyca metale węglem, redstone'em albo diamentem. Wychodzą z niego stopy i układy sterowania."]
	quest.615774FFD60F9C26.quest_desc: ["Okrąg ({effortlessbuilding.mode.circle}), walec ({effortlessbuilding.mode.cylinder}), kula ({effortlessbuilding.mode.sphere}), kopuła ({effortlessbuilding.mode.dome}), stożek ({effortlessbuilding.mode.cone}) i piramida ({effortlessbuilding.mode.pyramid}). Wieże, kopuły i dachy postawisz bez liczenia bloków."]
	quest.615774FFD60F9C26.title: "Kształty obłe"
	quest.616B0AE26BCC0C3B.quest_desc: ["Pochodnia z utherycznego odłamka i patyka. Odłamki zostawiają zgniłe stwory."]
	quest.616EA4B24C36A853.quest_desc: ["Kontener na płyny. Zbiorniki postawione na sobie i obok siebie łączą się w jeden, a okienko pokaże, ile w nich zostało."]
	quest.6182C7DBEBCAF243.quest_desc: [
		"Zamienia twoją budowlę w symulowaną maszynę z masą i prawdziwą fizyką. Tak powstają statki powietrzne i pojazdy."
		""
		"&7Montaż pokazuje Ponder (W).&r"
	]
	quest.6194A0F65340FEED.quest_desc: ["Głęboko w Undergarden leżą katakumby zapomnianych. W ich tunelach czeka &c{entity.undergarden.forgotten_guardian}&r."]
	quest.6194A0F65340FEED.title: "Katakumby"
	quest.61C4ED7DF630F6CB.quest_desc: ["Netherytowa zbroja ulepszona na stole kowalskim. Szablon zrobisz z szablonu netherytowego, płomiennego proszku i netherowych cegieł, a napierśnik połączysz z elytrami."]
	quest.61C4ED7DF630F6CB.title: "Zbroja z ignitium"
	quest.61DB66478B614ADD.quest_desc: ["Encyklopedia wrzucona do studni wraca jako księga o magii pustki. Opisuje przepisy tego tieru."]
	quest.61F99F5FD10E8135.quest_desc: [
		"Trafia się w skrzyniach budowli Lasu Zmierzchu. Narzędzia i zbroja z niego mają zaklęcia od razu po wykuciu."
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę mosiądzu.&r"
	]
	quest.620282C2039670CC.quest_desc: ["Broń z mroźnej stali spowalnia trafionych wrogów."]
	quest.621F0B31303C0C4C.quest_desc: ["Perła Endu z animą licza i cierniem próżni. Nie znika po rzucie, a po teleportacji daje na chwilę odporność."]
	quest.621FAD3E217119C8.quest_desc: [
		"Tryb niszczenia usuwa rząd bloków zwrócony do ciebie. Zniszczone bloki znikają, ale cofnięcie operacji je przywróci."
		""
		"&7Przepis wymaga diamentowego kilofa, a zakładasz go z blokiem redstone.&r"
	]
	quest.62204C363A986C08.quest_desc: ["Potwory i skrzynie dają przedmioty z afiksami, z nazwą w kolorze rzadkości. Stół odzysku rozbiera je na materiały: pospolite dają tajemniczy złom."]
	quest.6232770CFC6EB3A0.quest_desc: ["Zgniata także przepisy 3×3, np. diamenty i redstone w bloki."]
	quest.624BABDC9CB43903.quest_desc: ["Wieża Goety na wyspach Endu. Na jej szczycie stoi kapliczka pustki, w której przywołasz strażnika."]
	quest.624BABDC9CB43903.title: "Final Terminal"
	quest.6250BAE606DB10A4.quest_desc: ["Fabryka robi to samo co zwykła maszyna, ale na kilku przedmiotach naraz. Zrób dowolną podstawową fabrykę w siatce albo instalatorem poziomów."]
	quest.6250BAE606DB10A4.title: "Fabryka"
	quest.6263C60A24E1DB06.quest_desc: ["Każdy poziom układu to kolejne nasycanie w infuzerze. Fabryki Mekanismu i autocrafting AE2 zrobią tę serię same."]
	quest.6263C60A24E1DB06.quest_subtitle: "Dowód automatyzacji"
	quest.626FE53E021013ED.quest_desc: [
		"Prostopadłościan z jednostek rzemieślniczych, pamięci i koprocesorów prowadzi zamówienia. Pamięć decyduje o wielkości zamówienia, a koprocesory o jego szybkości."
		""
		"&7Zamówienie złożysz w terminalu: kliknij przedmiot kółkiem myszy.&r"
	]
	quest.626FE53E021013ED.quest_subtitle: "Kamień milowy"
	quest.626FE53E021013ED.title: "&bProcesor zamówień"
	quest.62764FCD07CCACFF.quest_desc: ["Zbroję Tajemnego Smoka ulepszysz na czwartym poziomie kuźni wodnymi i złotymi łuskami. Każda część kosztuje tysiące aurealu i krwi, więc przygotuj zapasy esencji."]
	quest.62764FCD07CCACFF.title: "Zbroja z Tyru"
	quest.627BC61F615AA916.quest_desc: ["Przewodnik Malum opisuje duchy, nasycanie i rytuały totemów. Zrobisz go z książki i oczyszczonego kamienia dusz."]
	quest.6282AF35BD8D267D.quest_desc: [
		"Znak mistrzostwa, sztabka netherytu i esencja żywiołu zamieniają szaty Ars w szaty jednej szkoły. Wzmacniają i tanią jej glify oraz chronią przed obrażeniami jej żywiołu."
		""
		"&7Pełny zestaw czterech części jednego żywiołu daje dodatkową premię.&r"
	]
	quest.6282AF35BD8D267D.quest_subtitle: "Kamień milowy"
	quest.6282AF35BD8D267D.title: "&dSzaty żywiołu"
	quest.629BB2EE81044C3B.quest_desc: ["Łupek głębinowy na ołtarzu za 1000 esencji. Tabliczki to podstawa prawie wszystkich wyrobów witamancji."]
	quest.629CAE41FC4ED04D.quest_desc: ["Nadajnik wyświetlacza czyta stan licznika magazynowego i wypisuje go na tablicy. Cała drużyna zobaczy, czego brakuje."]
	quest.629CAE41FC4ED04D.title: "Tablica zapasów"
	quest.62B69F59F1C3FA6C.quest_desc: ["Gaz z włazu na szczycie pieca nie musi uciekać. Spal go w nagrzewnicy zamiast kreozotu, a piec sam ogrzeje sobie powietrze."]
	quest.62B9CC3A9E92DA98.quest_desc: ["Krystalizuje czystą zawiesinę: jedna ruda daje pięć kryształów. Kryształy idą dalej przez komorę wtrysku, oczyszczającą, kruszarkę, komorę wzbogacania i piec."]
	quest.62B9CC3A9E92DA98.quest_subtitle: "Kamień milowy"
	quest.62B9CC3A9E92DA98.title: "&6{block.mekanism.chemical_crystallizer}"
	quest.62BC6EAEFA099E37.quest_desc: ["Nadaje sieć bez kabli w promieniu kilkunastu bloków. Wzmacniacze w środku zwiększą zasięg."]
	quest.62BCBBCE19B250BB.quest_desc: ["Udostępnia sieci zwykłą skrzynię, szufladę albo kontener Create tak, jakby był komórką. Tak podłączysz magazyny z wcześniejszych er."]
	quest.62BE12E98B38F8EA.quest_desc: ["Stół z Illager Invasion, na którym podniesiesz zaklęcie przedmiotu ponad zwykły poziom. Zrobisz go z esencji, bloku miedzi, butelki z doświadczeniem, ciemnego dębu i papieru."]
	quest.62C36D3D3D4729C7.quest_desc: ["Zamawia ustalony towar pod wskazany adres, gdy dostanie sygnał redstone. Uzupełni zapas pieca albo maszyny bez twojej pomocy."]
	quest.62C584E8CB3394CA.quest_desc: ["Dziki len rośnie w Overworldzie. Z jego włókna skręcisz nić na cięciwy i wiązania."]
	quest.62CA3903B2D1D3C4.quest_desc: ["Kadzielnica z tajemnego złota, cyny i srebra spala kadzidła. Postawiona na ołtarzu zwiększa jego pojemność o 2."]
	quest.62F4C6B156850604.quest_desc: ["Generator koralowy zamienia płyn koralowy w FE i oddaje prąd górą i dołem. Płyn koralowy zmieszasz w mikserze z redstone i płomiennym proszkiem, a statek wozi elektrownię ze sobą."]
	quest.62F4C6B156850604.title: "Prąd na pokładzie"
	quest.630E959FA7C90919.quest_desc: ["Rzucone jak oko Endera prowadzi do kuźni dusz w Netherze, gdzie czeka {entity.cataclysm.netherite_monstrosity}."]
	quest.6316E244E366D634.quest_desc: ["Zanit to niebieski klejnot Aetheru, z którego zrobisz narzędzia i ołtarz. Narzędzia z zanitu działają tym szybciej, im bardziej są zużyte."]
	quest.63188B76682FCBA6.quest_desc: ["Pierścień przechowuje chowańca i daje jego premię temu, kto go nosi, nawet gdy chowaniec nie chodzi obok."]
	quest.631C49FEFB70A0CE.quest_desc: ["Pancerz z grzbietu Wardena. Z odłamkiem echa i błoną fantoma da wzmocniony odłamek echa, a z kompasem – starożytny kompas."]
	quest.633026569D92492D.quest_desc: ["Wejdź do własnego świata. Gdy zabierzesz tu wroga, wróci tylko jeden z was."]
	quest.633026569D92492D.quest_subtitle: "Kamień milowy"
	quest.633026569D92492D.title: "&d{block.mahoutsukai.mahoujin_reality_marble}"
	quest.635F6BA6B972F080.quest_desc: [
		"&7Ekwipunek: najlepsza zbroja i broń na nieumarłych.&r"
		"Przeklęty wojownik zamknięty w lodzie. Szybki i bezlitosny."
	]
	quest.635F6BA6B972F080.quest_subtitle: "Boss"
	quest.635F6BA6B972F080.title: "&c{entity.cataclysm.maledictus}"
	quest.63653A576A690914.quest_desc: ["Pozwala na chwilę wzlecieć jak trzmiel. Znajdziesz go, czyszcząc pędzelkiem podejrzane stosy pyłku na zapylonych polach."]
	quest.63653A576A690914.quest_subtitle: "Kamień milowy"
	quest.63653A576A690914.title: "&a{item.the_bumblezone.bumble_bee_chestplate_1}"
	quest.63823D44A544F96B.quest_desc: ["Mieszankę możesz przechowywać w zbiornikach i rozlewać tam, gdzie ma zastygnąć. Kamień Endu z wiatraka z oddechem smoka (strona dodatków Create) oszczędzi ci wypraw do Endu."]
	quest.6394638656ECEE87.quest_desc: ["Silnik parowy stoi na zbiorniku, który grzeją płomienne palniki, a pompa dolewa wody. Większy kocioł i więcej palników to więcej mocy. Jeden silnik pójdzie do pieczęci."]
	quest.6394638656ECEE87.quest_subtitle: "Kamień milowy i składnik pieczęci"
	quest.6394638656ECEE87.title: "&6{block.create.steam_engine}"
	quest.63CA9CBF64812D61.quest_desc: [
		"Obozowisko najeźdźców z Dungeons and Taverns. Przyjdź uzbrojony: łucznicy z kuszami trafiają z daleka."
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę run.&r"
	]
	quest.63CA9CBF64812D61.title: "Obóz illagerów"
	quest.63D82EF448627B80.quest_desc: ["Eliksir zmienia stwory i bloki w coś innego. Użyty na piekielnej dyni przywoła lorda. Znajdziesz go w wozach karawan klaunów, a przepis pokaże JEI."]
	quest.63F07386B1A0BA5E.quest_desc: [
		"Użyj drukarki 1000 razy. Taśma z księgami i stały dopływ płynnego doświadczenia zrobią to bez ciebie."
		""
		"&7Kolejny tier zaklinania pojawi się tutaj, gdy twoja drużyna wejdzie w erę arkanów.&r"
	]
	quest.63F07386B1A0BA5E.quest_subtitle: "Dowód automatyzacji"
	quest.63F07386B1A0BA5E.title: "Wielki wydawca"
	quest.63FC896B18EF8E12.quest_desc: [
		"Obsydian zmielony w kołach kruszących to sproszkowany obsydian. W montażu sekwencyjnym wylewka doleje do niego lawy, a prasa dwa razy go dociśnie: tak powstaje twardy arkusz, materiał na obudowę kolejową."
		""
		"&7Kroki montażu pokaże JEI (R na przedmiocie).&r"
	]
	quest.6402D9D327AC639A.quest_desc: ["Budowniczy stawia i ulepsza wszystkie budynki kolonii. Postaw jego chatę, zleć budowę w jej menu i dostarczaj mu materiały."]
	quest.6402D9D327AC639A.title: "Chata budowniczego"
	quest.64201A5246624F28.quest_desc: ["Ruda demonitu leży tylko w kopalniach Bezkresnego Królestwa. Bez jedwabnego dotyku dostaniesz surowy demonit."]
	quest.642CC75CBF755551.quest_desc: ["Ciągarka wyciąga druty z arkuszy złota i elektrum, a ty nawijasz je na puste szpule. Elektrowy drut wchodzi w akumulator."]
	quest.642CC75CBF755551.title: "Złote i elektrowe szpule"
	quest.643BC132F8F37FA9.quest_desc: ["Plantator uprawia trzcinę, bambus i kakao na polach plantacji. Rośliny z Netheru odblokują badania w erze mosiądzu."]
	quest.645627057BBA2031.quest_desc: ["Na ołtarzu proch staje się popiołem klątwy, węgiel tajemnym węglem, glina kalksem alchemicznym, a zgniłe mięso żywym ciałem. To składniki prawie wszystkich dalszych przepisów Malum."]
	quest.645627057BBA2031.title: "Nasycone materiały"
	quest.6481021B0DDECC1A.quest_desc: ["Rzeźbiony polerowany ciemny kamień na kuźni, 4 tajemne kryształy i 4 sztabki deorum na piedestałach. Rytuał pochłonie 1000 aurealu, 9000 krwi i 50 dusz."]
	quest.6481021B0DDECC1A.title: "Kuźnia: poziom III"
	quest.64A601A45CD3EBD5.quest_desc: ["Przenosi przedmioty w pionie: w dół same spadają, a w górę wypycha je wiatrak ustawiony pod zsypem. Zsyp przyjmie przedmioty z lejka i odda je do pojemnika pod sobą."]
	quest.64CE345DD1893CE6.quest_desc: ["Rozkłada przedmiot z powrotem na składniki z przepisu, za doświadczenie. Zrobisz go ze stołu rzemieślniczego i soczewki labiryntu."]
	quest.64E8D1813DF6EEE5.quest_desc: [
		"&7Era elektryczności · zalecana tarcza, szybka broń i dużo jedzenia&r"
		""
		"Vizier, dostojnik illagerów, zjawia się po użyciu mrocznego zwoju w leśnym dworze i tworzy swoje iluzje."
		"Monstrum z czerwienitu zamyka najazd illagerów: wychodzi, gdy pokonasz resztę napastników."
	]
	quest.64E8D1813DF6EEE5.title: "Dwór illagerów"
	quest.64FC21E8D46ED3CA.quest_desc: ["Koszary ze wszystkimi wieżami na najwyższym poziomie. W erze atomu uniwersytet otwiera też badania 6. tieru."]
	quest.64FC21E8D46ED3CA.title: "Wielki garnizon"
	quest.64FE2EFBA55E6AC1.quest_desc: ["Shulkerowe skrzynie podnosisz tymi samymi ulepszeniami poziomu co zwykłe. Netherytowa nosi w sobie cały magazyn."]
	quest.653DD7C6E4237E8A.quest_desc: [
		"Czasem niebo tego świata sypie meteorami. Przeczekaj taką noc pod gołym niebem."
		""
		"&7Z meteorami spadają kreteory, które zostawiają surowy aethersent.&r"
	]
	quest.653DD7C6E4237E8A.quest_subtitle: "Kamień milowy"
	quest.653DD7C6E4237E8A.title: "&aDeszcz meteorów"
	quest.6546C10FC690E7A4.quest_desc: ["Kilof, siekiera i łopata z klejnotem Spiritus. Aspekty Spiritus zmieniają później ich działanie."]
	quest.6546C10FC690E7A4.title: "Narzędzia świadome"
	quest.654EA61281BF5749.quest_desc: ["Zrobisz je z czterech koralowców, oka Endu, świecącego woreczka z atramentem i przewodnika."]
	quest.655BB5915AE02D37.quest_desc: ["Cytadela z Moog's End Structures. Zajrzyj do każdej komnaty."]
	quest.655BB5915AE02D37.title: "Cytadela fantomów"
	quest.6561C5F43E57CF75.quest_desc: ["Silnik diesla spala paliwo podane rurą i napędza maszyny Create, na oleju napędowym z prędkością 96 obr./min. Zasil go olejem z wieży destylacyjnej. Jeden silnik trafi też do pieczęci."]
	quest.6561C5F43E57CF75.quest_subtitle: "Kamień milowy"
	quest.6561C5F43E57CF75.title: "&6{block.createdieselgenerators.diesel_engine}"
	quest.65A50AE4D9110683.quest_desc: ["Jeszcze większy dysk, z polonu i plutonu. Kilka takich wystarczy na całą bazę."]
	quest.65A6BDAFE7A86DE1.quest_desc: ["Odłupek osadzony na patyku to twój pierwszy nóż. Tnie trawę i przyda się w kolejnych przepisach."]
	quest.65AE6584A801F31F.quest_desc: ["Każdy poziom komponentu zużywa poprzedni, od 1M do 256M. Dwa największe trafią do pieczęci."]
	quest.65AE6584A801F31F.quest_subtitle: "Składnik pieczęci"
	quest.65B024605903E32B.quest_desc: ["Strój inżyniera ulepszony witherytem od Zwiastuna (Harbinger) i kulą many. Trzy odmiany: na siłę, odporność albo szybkość."]
	quest.65B024605903E32B.title: "Pancerz Excelsius"
	quest.65D623FE306B697B.quest_desc: ["Miej naraz 512 sztabek stali. Tyle nie wytopisz bez wielkiego pieca, do którego ruda, topnik i paliwo trafiają same."]
	quest.65D623FE306B697B.quest_subtitle: "Dowód automatyzacji"
	quest.65D623FE306B697B.title: "Stalownia"
	quest.65E3E47CF029F29D.quest_desc: ["Wciąga przedmioty z pojemnika obok i wypycha je do innego, z filtrem. Ustawisz to w oknie ulepszenia."]
	quest.65F36FC939EE202F.quest_desc: ["Żywica z korzenia merammeru spaja prawie każde kadzidło, a pozostałe zioła decydują o jego działaniu. Korzeń dają kwiaty, gałązkę paproć, a kwiat lilia wodna."]
	quest.65F36FC939EE202F.title: "Zioła rytualne"
	quest.6607EAAF1EBB3240.quest_desc: ["Miasto-twierdza z kolumnami, dodane przez Aether Villages. Jedna z największych budowli Aetheru."]
	quest.6607EAAF1EBB3240.title: "Olimpijska cytadela"
	quest.6609435D9865D795.quest_desc: ["Rozbuduj kopalnię, a górnik zejdzie szybem aż do skały macierzystej."]
	quest.6609435D9865D795.title: "Samo dno"
	quest.661D4EBC4DE243B8.quest_desc: ["Trolle gubią magiczną fasolę. Posadź ją na żyznej glebie (&a{block.twilightforest.uberous_soil}&r), a łodyga wyrośnie aż do chmur olbrzymów."]
	quest.661D4EBC4DE243B8.title: "Magiczna fasola"
	quest.661EF6848FAA286A.quest_desc: ["Fokus wzlotu ulepszony oddechem smoka i elytrą. Z nim w różdżce latasz, dopóki trzymasz prawy przycisk myszy; z kosturem wiatru lecisz szybciej."]
	quest.6621100F24C04595.quest_desc: ["Wysiądź z pociągu ponad 5000 bloków od miejsca, w którym wsiadłeś."]
	quest.6621100F24C04595.title: "Daleka podróż"
	quest.663064D989B80AD2.quest_desc: ["Topór Minoszruma. Zadaje dodatkowe obrażenia, gdy uderzasz w biegu."]
	quest.663CAF3B10334B70.quest_desc: ["Rzuć &aenderperłę&r w &a{block.minecraft.bee_nest}&r albo ul, a trafisz do pszczelego wymiaru. To wyprawa poboczna: miód, plastry i pszczela zbroja."]
	quest.663CAF3B10334B70.title: "Bumblezone"
	quest.663E4BBCFF5CBF56.quest_desc: [
		"&7Era elektryczności · zalecana broń z utherium albo netherytu i dobra zbroja&r"
		""
		"W katakumbach Undergarden kamienny strażnik pilnuje szczątków zapomnianych. Jest powolny, ale każdy jego cios boli."
		""
		"&7Kolejny tier bossów świata pojawi się tutaj, gdy twoja drużyna wejdzie w erę atomu.&r"
	]
	quest.663E4BBCFF5CBF56.title: "Strażnik katakumb"
	quest.66472ED1DB8845B3.quest_desc: ["Różowy kwarc zrobisz z kwarcu Netheru i redstone. Wypoleruj go papierem ściernym w ręce albo aplikatorem trzymającym papier: wypolerowany kwarc idzie do lamp elektronowych."]
	quest.66472ED1DB8845B3.title: "Polerowanie"
	quest.666707E6510FC60D.quest_desc: [
		"Trzeci poziom stosów. Przepis wymaga bloku diamentu."
		""
		"&7Kolejny tier plecaków pojawi się tutaj, gdy twoja drużyna wejdzie w erę arkanów.&r"
	]
	quest.6670F04259034690.quest_desc: ["Podziemne lochy z klatkami potworów: zombie, szkieletów i pająków. Oświetl albo zniszcz klatki i zabierz łup."]
	quest.6670F04259034690.title: "Lochy YUNG"
	quest.66807641845B5012.quest_desc: ["Otwiera terminal na odległość; zasięg podaje opis przedmiotu. Kliknij nim terminal, a potem używaj go z ręki."]
	quest.6681ACA2A79FA53A.quest_desc: ["Kopiuje książki, także zaczarowane, za płynne doświadczenie. Zmienia też nazwy przedmiotów i adresy paczek Create."]
	quest.668DD3417C215524.quest_desc: ["Podepnij gadżet do punktu dostępu w menu radialnym („{buildinggadgets2.radialmenu.bind}”). Gadżet weźmie bloki z sieci ME, a brakujące zamówi w autocraftingu."]
	quest.668DD3417C215524.title: "Gadżety w sieci ME"
	quest.66A4D2AE904CE1E3.quest_desc: ["Dwa okruchy netherytu ze stopionym złotem, mieszane w białym żarze, dają stopiony netheryt. Odlejesz go na sztabki bez szukania stołu kowalskiego."]
	quest.66C4A2DAA07CA850.quest_desc: ["Kolczasty żywopłot rani przy dotyku, a w korytarzach czyhają pająki. W środku czekają skrzynie."]
	quest.66C4A2DAA07CA850.title: "Labirynt z żywopłotu"
	quest.670B3BC895AD9183.quest_desc: ["Diamentowy kilof ulepszony płytką resonarium. To kilof na Otherside."]
	quest.670D8623992AA334.quest_desc: ["Na chmurach na szczycie łodygi stoi dom olbrzymów. Z olbrzymiego bruku i pnia zrobisz kilof i miecz w ich rozmiarze."]
	quest.670D8623992AA334.title: "Dom olbrzyma"
	quest.671959A34C149691.quest_desc: [
		"&7Ekwipunek: pełna zbroja, światło i broń dystansowa.&r"
		"Czai się w ciemnościach Otherside. Może z niego wypaść &a{item.deeperdarker.soul_crystal}&r."
	]
	quest.671959A34C149691.quest_subtitle: "Boss"
	quest.671959A34C149691.title: "&c{entity.deeperdarker.stalker}"
	quest.6728C73F77258A9B.quest_desc: ["Kliknij nim postawioną diamentową skrzynię, beczkę albo skrzynię shulkera, a stanie się netherytowa razem z całą zawartością."]
	quest.672CD9B7EA617AD0.quest_desc: [
		"Każdą esencję nasycisz w komorze z klejnotu źródła i przedmiotów jej żywiołu, np. krzesiwa i prochu dla ognia. Esencje to składniki glifów, rytuałów i wyposażenia."
		""
		"&7Przepisy pokaże JEI: najedź na esencję i wciśnij R.&r"
	]
	quest.672CD9B7EA617AD0.title: "Esencje żywiołów"
	quest.673956CBEC639087.quest_desc: [
		"Każdy kolejny żagiel przyspiesza wiatrak, aż osiągnie największą siłę. Ramy żagli liczą się tak samo jak żagle z wełną."
		""
		"&7Zadanie zalicza osiągnięcie Create za wiatrak o największej sile.&r"
	]
	quest.673956CBEC639087.title: "Wiatrak pod pełnymi żaglami"
	quest.673FEF8CACB0E5C8.quest_desc: ["Rubiny, szafiry, topazy i inne kamienie znajdziesz w skrzyniach budowli. Każdy kamień daje biżuterii inną premię."]
	quest.673FEF8CACB0E5C8.title: "Kamień szlachetny"
	quest.6750A521F50633AA.quest_desc: ["Wiertnica do żył płynów: wypompowuje płyn spod ziemi, dopóki ją napędzasz."]
	quest.677502BBACE73971.quest_desc: ["Bells and Whistles dodaje części lokomotyw: reflektor oświetla drogę przed pociągiem, a zgarniacz z przodu dodaje mu charakteru."]
	quest.677502BBACE73971.title: "Reflektor i zgarniacz"
	quest.6789430CA3CC85D1.quest_desc: [
		"Moc kotła rośnie razem z nim: większy zbiornik, więcej płomiennych palników pod spodem i więcej wody to wyższy poziom kotła. Każdy poziom zasila jeden silnik parowy na pełnej mocy."
		""
		"&7Gogle inżyniera na kotle pokażą jego poziom i to, czego mu brakuje.&r"
	]
	quest.6789430CA3CC85D1.title: "Większy kocioł"
	quest.6791A156DA492C69.quest_desc: [
		"Zwiększa pojemność aktywatora. Postaw go niedaleko, zwrócony w stronę aktywatora; kilka stabilizatorów sumuje się."
		""
		"&7Rytuał z foliotem na podstawie stabilizatora, z blokiem miedzi i proszkiem płomieni.&r"
	]
	quest.679EC6A33763BF96.quest_desc: ["Pieczęć zużyje 16 duchów piekielnych, 16 tajemnych i 8 niegodziwych. Piekielne dają płomyki, ghasty i inne stwory Netheru."]
	quest.679EC6A33763BF96.quest_subtitle: "Składnik pieczęci"
	quest.679EC6A33763BF96.title: "Duchy do pieczęci"
	quest.67B2AD661C3E1852.quest_desc: [
		"&7Era mosiądzu · zalecane: diamentowa zbroja, mikstury ognioodporności&r"
		"Wielogłowa hydra pluje ogniem ze swojego leża w ognistym bagnie Lasu Zmierzchu."
	]
	quest.67B2AD661C3E1852.quest_subtitle: "Boss"
	quest.67B2AD661C3E1852.title: "&c{entity.twilightforest.hydra}"
	quest.67B4FEC3F9C6D751.quest_desc: ["Kliknij instalatorem postawioną maszynę, a zmieni się w fabrykę bez rozbierania. Kolejny instalator podnosi fabrykę o poziom i dodaje jej gniazd."]
	quest.67B4FEC3F9C6D751.title: "Instalatory poziomów"
	quest.67C5B95D0E775079.quest_desc: ["Osiem silników parowych na jednym kotle to napęd dla całej fabryki. Rozstaw je po bokach zbiornika i połącz ich wały w jedną sieć."]
	quest.67C5B95D0E775079.title: "Hala silników"
	quest.67E1E57A3F7AEDA5.quest_desc: [
		"Wieżę destylacyjną zbudujesz ze stalowych zbiorników, kontrolera i wylotów; budowę pokazuje Ponder (W). Z 340 mB ropy powstają ciężki olej, olej napędowy, nafta, benzyna ciężka, benzyna i LPG."
		"Napełnij wiadro olejem napędowym."
	]
	quest.67E1E57A3F7AEDA5.quest_subtitle: "Kamień milowy"
	quest.67E1E57A3F7AEDA5.title: "&6Destylacja ropy"
	quest.67E8C5DC68587EDE.quest_desc: ["Żelazny miecz z klejnotem Spiritus. Zbiera Spiritus z zabitych dużo wydajniej niż noże do rzucania."]
	quest.67ED85E29B059067.quest_desc: ["Na stole kowalskim połącz go z mechaniczną kielnią. Kielnia będzie brać bloki prosto z sieci ME."]
	quest.67F8633BD956C906.quest_desc: ["Aethersent spada z nieba Eternal Starlight razem z meteorami. Osiem sztabek trafi do pieczęci."]
	quest.67F8633BD956C906.quest_subtitle: "Składnik pieczęci"
	quest.681B43AE3E0A5C94.quest_desc: ["Stolarz robi z drewna przedmioty, o które proszą inni pracownicy, np. drzwi i schody. Rzemieślnicy pracują tylko na zamówienie."]
	quest.681B43AE3E0A5C94.title: "Tartak"
	quest.6824F3BE0E5F95A8.quest_desc: ["Zbroja ze stali dusz nasycona płytami złośliwego stopu i jedwabiem duszy. Mocniejsza osłona duszy i ochrona przed magią."]
	quest.6824F3BE0E5F95A8.title: "Zbroja ze złośliwego stopu"
	quest.6830D44BCD85AC2A.quest_desc: [
		"Pokazuje porę roku i dzień, który właśnie trwa. Zrobisz go z zegara i papieru."
		""
		"&7Zaplanuj sianie tak, żeby zbiory nie wypadły w zimie.&r"
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę mosiądzu.&r"
	]
	quest.683CA4EED57679E9.quest_desc: ["Mały piec w plecaku. Paliwo i materiał bierze z zawartości plecaka."]
	quest.68437FE9E2D18392.quest_desc: [
		"Zadowoleni mieszkańcy pracują lepiej i chętniej zakładają rodziny. Liczą się dom, urozmaicone jedzenie, zdrowie, bezpieczeństwo i ich prośby."
		"&7Najedź na mieszkańca albo otwórz jego okno, żeby zobaczyć, czego mu brakuje.&r"
	]
	quest.68437FE9E2D18392.title: "Zadowolenie"
	quest.68473797DF560542.quest_desc: ["Klejnoty źródła to podstawa magii Ars Nouveau: pójdą na rdzeń, piedestały, łączniki i blok do pieczęci."]
	quest.68652025D552D06F.quest_desc: ["Kamienny posąg z symbolem patrona to trwalsza ikona niż słomiana kukła."]
	quest.6876B0FE11BE8D1D.quest_desc: ["Zapomniane pola, lasy smogowych pni, poskręcane lasy i mroźne pola. Odwiedź wszystkie cztery."]
	quest.6876B0FE11BE8D1D.title: "Krainy Undergarden"
	quest.68995561F0A8AE93.quest_desc: ["Krowy dają skórę na plecak i pierwszą zbroję, a wołowinę na gulasz."]
	quest.68A579014481680C.quest_desc: ["Powstaje w rytuale animacji: wokół mrocznego ołtarza muszą stać 15 drabin, 15 torów i wydrążona dynia. Rdzeń ożywia fokusy sług i golemy."]
	quest.68AD1DD3F0FAB655.quest_desc: ["Leży w blokach czerwiu i w skrzyniach budowli ula."]
	quest.68B2930A37AE9CEF.quest_desc: ["Na stole kowalskim dodaje różdżce tryb anioła: stawia bloki po drugiej stronie tego, na co patrzysz, także w powietrzu. Przyda się przy budowie statków."]
	quest.68B6A6C9952F9081.quest_desc: ["Świątynia na chmurach pełna walkirii. Za medale zwycięstwa staniesz przed ich królową."]
	quest.68B6A6C9952F9081.title: "Srebrny loch"
	quest.68C1C1E0E38BF419.quest_desc: ["Komnata z piekielnego kamienia w sercu wielkiej wyspy. Duch Słońca ciska kulami ognia, więc zabierz ognioodporność."]
	quest.68C1C1E0E38BF419.title: "Złoty loch"
	quest.68C9ABB319EBE472.quest_desc: [
		"Postaw własny kamień przy bazie albo kopalni. Inni gracze zobaczą go dopiero, gdy sami go aktywują, a zmienić może go tylko właściciel."
		""
		"&7Przepis wymaga obsydianu, więc potrzebujesz diamentowego kilofa.&r"
	]
	quest.68D6896EAD169BAA.quest_desc: ["Steruje prędkością i kierunkiem obrotów silnika. W środku pracuje płytka drukowana, więc to ostatni krok silników TFMG."]
	quest.68D6BC443E61E584.quest_desc: ["Port przestrzenny zamyka wycinek świata, wyznaczony pylonami, w komórce przestrzennej. Wypuścisz go w innym miejscu razem z blokami i mobami."]
	quest.68D6BC443E61E584.title: "Przestrzeń w komórce"
	quest.68E36844E15659CE.quest_desc: ["Kuźnia zwojów tworzy nowe zwoje z tuszu, papieru i fokusu szkoły magii. Płaczący obsydian znajdziesz przy zrujnowanych portalach."]
	quest.69026A5EFF5ECD87.quest_desc: [
		"Uwięziona w nim dusza wskazuje drogę do swojego domu: katakumb, w których śpi Umarły Król. Przepis wymaga latarni dusz."
		""
		"&7Kolejny tier Iron's Spells pojawi się tutaj, gdy twoja drużyna wejdzie w erę okultyzmu.&r"
	]
	quest.690A3EEA188EBC76.quest_desc: ["Złącza New Age łączysz drutem. Kluczem przełączysz złącze w tryb pobierania, żeby ciągnęło energię z bloku, na którym stoi."]
	quest.690A3EEA188EBC76.title: "Przewody New Age"
	quest.691298B561F65994.quest_desc: ["Młot Potworności, który jest też kilofem. Kliknięty w blok rani wszystko wokół."]
	quest.691F25540999137F.quest_desc: ["Złota misa stoi w środku pentaklu i rozpoczyna rytuał, a co najmniej cztery zwykłe misy w promieniu 8 bloków trzymają składniki. Misy zrobisz z kamienia (&d{block.occultism.otherstone}&r), który też zdobędziesz w ogniu duchów."]
	quest.691F25540999137F.title: "Misy rytualne"
	quest.691F2A29902F728E.quest_desc: ["Z desek robisz szablony części. Szablon jest jednorazowy: każda głowica albo płyta zużywa go w siatce."]
	quest.6961698E7E0F1D82.quest_desc: ["Kamień wymaga kilofa. Krzemienny wydobędzie kamień, węgiel i rudę miedzi, ale na żelazo jest za słaby."]
	quest.6961698E7E0F1D82.quest_subtitle: "Kamień milowy"
	quest.6961698E7E0F1D82.title: "&6{item.notreepunchingremastered.flint_pickaxe}"
	quest.696945DF9E1B272B.quest_desc: [
		"Kręci się wolniej niż zwykłe koło wodne, ale daje znacznie więcej mocy. Ustaw je tak, by woda opływała łopatki z jednej strony."
		""
		"&7Ponder (przytrzymaj W nad przedmiotem) pokaże, jak to złożyć.&r"
	]
	quest.69753EC3B1C4561A.quest_desc: ["Powstaje z rozszczepiacza atomowego, polonu i konfiguratora. Moduły dodadzą mu szybkość kopania, Fortunę, jedwabny dotyk i kopanie żył."]
	quest.698E82D7135D42AB.quest_desc: ["W szynie eksportu albo interfejsie sama zamówi brakujący przedmiot. Maszyna nigdy nie zostanie bez składnika."]
	quest.6991CA280495CBD7.quest_desc: ["Nasiona wypadają czasem z trawy ściętej bez nożyc. Zasadź je: owoc daje efekt Third Eye, a rzucony na ziemię i podpalony krzesiwem zamienia się w ogień duchów."]
	quest.6994230275E5D8EC.quest_desc: ["Brama wymaga jednego z dwóch netherowych bossów. Wystarczy jeden, a jego trofeum trafi do pieczęci."]
	quest.6994230275E5D8EC.quest_subtitle: "Kamień milowy"
	quest.6994230275E5D8EC.title: "&c{entity.minecraft.wither} lub {entity.bosses_of_mass_destruction.gauntlet}"
	quest.69A1CACA40F7ED18.quest_desc: ["Następny poziom stosów. Przepis wymaga bloku złota i ulepszenia poprzedniego poziomu."]
	quest.69A516803B51AE35.quest_desc: ["Zatopione ruiny z kamienia w zimnym morzu i z piaskowca w ciepłym. Pilnują ich topielce."]
	quest.69A516803B51AE35.title: "Podwodne ruiny"
	quest.69A9A194EC6D19BC.quest_desc: [
		"&7Era atomu · zalecana najlepsza zbroja, elytry albo perły Endu&r"
		""
		"Rzucone jak oko Endera leci w stronę zrujnowanej cytadeli na wyspach Endu. Zrobisz je z oka Endera, skorupy shulkera i bloków z miast Endu."
	]
	quest.69B1703018DCDE86.quest_desc: ["Na stole kowalskim sprawia, że różdżka Construction Sticks przestaje się zużywać. Zrobisz go z gwiazdy Netheru, płaczącego obsydianu i szkła."]
	quest.69B3A20E64A3D9DD.quest_desc: [
		"Łożysko radaru obraca zbudowaną na nim antenę z odbiornikiem i talerzami, a radar wykrywa stworzenia i maszyny wokół. Napędzasz je jak każde łożysko Create."
		""
		"&7Ponder (przytrzymaj W nad przedmiotem) pokaże cały proces.&r"
	]
	quest.69B3A20E64A3D9DD.title: "Radar"
	quest.69BF57E1F763134F.quest_desc: ["Od ery andezytu żelazny kilof wreszcie działa: wykopiesz nim diamenty, złoto, redstone, szmaragdy i cynk. Dwa diamenty pójdą na stół do zaklinania, a jeden do pieczęci w następnej erze."]
	quest.69BF57E1F763134F.title: "Diamenty"
	quest.69D905AB9B941D26.quest_desc: ["Plecak odrzutowy z płytą z bloku stali i brązu. Chroni jak dobry napierśnik."]
	quest.69E5637FB98A911E.quest_desc: ["Wczytuje większy obszar, a im większy zasięg, tym szybszego obrotu potrzebuje. Na ruchomej maszynie albo przy stacji kolejowej wczytuje okolicę pociągu bez napędu."]
	quest.69E628FF1507E56B.quest_desc: ["Perła z rozbiórki mitycznych przedmiotów. Trafia do stołu wzmacniania i najmocniejszych sygili."]
	quest.69E9BF65AD30C871.quest_desc: ["Podłącz nadajnik wyświetlacza do stacji, a tablica z klapkami pokaże, za ile przyjedzie najbliższy pociąg. Nadajniki i tablice znajdziesz na stronie logistyki Create."]
	quest.69E9BF65AD30C871.title: "Tablica odjazdów"
	quest.69EA802505EAFFA4.quest_desc: ["Skaner powierzchniowy pokazuje na górnej siatce 5×5 okoliczne chunki i podświetla te, pod którymi leży złoże ropy. Napędzaj go od dołu przez wejście maszyny, co najmniej 64 obr./min."]
	quest.69EE60EE7D5065B9.quest_desc: [
		"Wieża z bloków parownika na podstawie 4×4, z kontrolerem i zaworem. Ciepło odparowuje wodę na solankę, a solankę na lit; im wyższa wieża, tym szybciej."
		""
		"&7Separator rozłoży solankę na chlor i sód.&r"
	]
	quest.69EE60EE7D5065B9.title: "Parownik termiczny"
	quest.69EEF9A99661A22B.quest_desc: ["Załóż go na zbiornik płynów wysoki na co najmniej 3 bloki, a stanie się wieżą destylacyjną. Podgrzej ją od dołu i wpompuj ropę: wyjdą benzyna i olej napędowy."]
	quest.69F83ADE7BA96612.quest_desc: ["Jedna z najmocniejszych zbroi Lasu Zmierzchu. Przyda się w Mrocznej Wieży i dalej."]
	quest.69F83ADE7BA96612.title: "Zbroja z rycerskiego metalu"
	quest.6A16A2359DAD868E.quest_desc: ["Ulepszenie łączysz z gotowym narzędziem w siatce. Łyżka pozwoli kilofowi kopać ziemię jak łopata."]
	quest.6A16A2359DAD868E.title: "Ulepszenia"
	quest.6A21DE211219A1D1.quest_desc: [
		"Noszony w ekwipunku raz ratuje cię przed śmiercią i przepada. Trafia się w skrzyniach wieży Licza i wydrążonych wzgórz."
		"&7Przyda się w każdej walce z bossem.&r"
	]
	quest.6A21F6AEDA073785.quest_desc: [
		"Miej naraz 1024 rudy dowolnego metalu. Wiertnice na kilku żyłach, taśma i magazyn zrobią to bez jednego zamachu kilofem."
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę atomu.&r"
	]
	quest.6A21F6AEDA073785.quest_subtitle: "Dowód automatyzacji"
	quest.6A21F6AEDA073785.title: "Kopalnia bez końca"
	quest.6A24B428E6449FAA.quest_desc: ["Dowód automatyzacji: 256 kwiatów. Nasiona zrobisz w aparacie z klejnotu źródła i zwykłych nasion, a żniwiarka Create na ruchomej maszynie zbierze plony sama."]
	quest.6A24B428E6449FAA.title: "Plantacja magicznych kwiatów"
	quest.6A31642FC24395C9.quest_desc: ["Miedziana różdżka stawia więcej bloków naraz niż kamienna."]
	quest.6A4A30BDCB0F8E18.quest_desc: ["Przekazuje obrót w dwóch kierunkach niezależnie od siebie. Dwie osobne linie napędu przetną się w jednym bloku i nie połączą."]
	quest.6A4DF85CE7DAB2FF.quest_desc: ["Przetrwaj kilka nocy i pokonaj dziesięć zombie i dziesięć szkieletów. Liczy się cała drużyna."]
	quest.6A4DF85CE7DAB2FF.quest_subtitle: "Kamień milowy"
	quest.6A4DF85CE7DAB2FF.title: "&aNocna zmiana"
	quest.6A4F166CB8FAA9B4.quest_desc: [
		"Ustaw wiatrak tak, by dmuchał przez wodę, i rzucaj w strumień piasek: każdy blok zmieni się w kulkę gliny. Płukany żwir daje krzemień, a czasem bryłkę żelaza. Zbierz 32 kulki gliny."
		""
		"&7Ta strona idzie dalej niż drzewo ery: płukanie, prasa nad tyglem, płyny, a w erze mosiądzu kruszenie rud.&r"
	]
	quest.6A4F166CB8FAA9B4.title: "Płukanie piasku"
	quest.6A4FB58AC0CB4783.quest_desc: ["Rękawica kopie bloki twarde jak diament i rzuca jedno zaklęcie bez formy, taniej niż księga."]
	quest.6A77909E2CBF9277.quest_desc: ["W sercu mrocznego lasu stoi Mroczna Wieża. Wejdziesz do niej po pokonaniu fantomowych rycerzy."]
	quest.6A77909E2CBF9277.title: "{biome.twilightforest.dark_forest_center}"
	quest.6A84317D6CEE8B17.quest_desc: ["Słój z własnym małym wymiarem: nazwij go, kliknij w kucaniu i wejdź do środka. Bloki zbudowane wewnątrz widać w słoju."]
	quest.6AA609A7C2E49926.quest_desc: ["Las gwiezdnego światła, mroczne bagno, szkarłatny las i las torreyi. Odwiedź wszystkie cztery."]
	quest.6AA609A7C2E49926.title: "Krainy gwiazd"
	quest.6ABA77CE2C2A2AFE.quest_desc: ["Prosta kosa nasycona stalą dusz i popiołem klątwy. Tnie mocniej i wyrywa z ofiar więcej duchów."]
	quest.6AC6911C37465994.quest_desc: [
		"Kolec kwiatu próżni. Trafi do naładowanej perły i włóczni przenikania."
		""
		"&7Kolejny tier bossów zagłady pojawi się tutaj, gdy twoja drużyna wejdzie w erę okultyzmu.&r"
	]
	quest.6AC8C8D0A65424C9.quest_desc: [
		"Overworld składają biomy pięciu modów: Biomes O' Plenty, Oh The Biomes We've Gone, Nature's Spirit, Regions Unexplored i Terralith. Każdy ma własne drzewa, kwiaty i krajobrazy."
		""
		"&7Kompas biomów z ery andezytu wskaże drogę do wybranej krainy.&r"
	]
	quest.6AC8C8D0A65424C9.title: "Nowe krainy"
	quest.6AD4941D7D927187.quest_desc: ["Przeklęty metal, łza ghasta i sculk przetopione w nekrotycznym koksowniku za dużo energii dusz. Mroczny stop sam się naprawia energią dusz i spowalnia trafionych."]
	quest.6AF504E67C1AF9EE.quest_desc: ["Ognisko piecze mięso bez paliwa. Pod garnkiem też daje ciepło."]
	quest.6AFCAA604FAF558C.quest_desc: ["Kosa żniwiarza ulepszona esencją śmierci, klejnotem cienia i czaszką witherowego szkieletu. To najgroźniejsza broń nekromanty w Eidolonie."]
	quest.6AFCAA604FAF558C.quest_subtitle: "Kamień milowy"
	quest.6AFCAA604FAF558C.title: "&d{item.eidolon_repraised.deathbringer_scythe}"
	quest.6B02295457E48065.quest_desc: [
		"Vizier zostawia rubin dusz. Goety używa go w rytuałach kilku fokusów."
		""
		"&7Kolejny tier bossów magii pojawi się tutaj, gdy twoja drużyna wejdzie w erę atomu.&r"
	]
	quest.6B13DD9520E77C56.quest_desc: ["Rytualny sztylet. Paprocie, kwiaty, liście dżungli, grzyby Netheru i lilie wodne ścięte nim dają zioła, z których powstają kadzidła."]
	quest.6B1E1A4C5F600010.quest_desc: ["Uśpioną biblioteczkę z popękanych łupków głębinowych obudzisz nasyceniem w stole. Głębinowe półki podnoszą stół jeszcze wyżej."]
	quest.6B40B0152114AC03.quest_desc: ["Łączy pakowacz z siecią logistyczną Create. Pakowacze z łącznikami w jednej sieci działają jak jeden magazyn, z którego zamawiasz towar."]
	quest.6B42056FA97C1355.quest_desc: ["Rytuał daje pobliskim graczom lot jak w trybie kreatywnym, dopóki kocioł ma źródło. Przepis wymaga skrzydła wildena i diamentu."]
	quest.6B51B68599BDA4BE.quest_desc: [
		"Tu wkładasz moduły do MekaPancerza i Meka-Narzędzia. Do budowy potrzebujesz polonu, więc stacja czeka na reaktor."
		""
		"&7Pełny MekaPancerz jest też kamieniem milowym Ery Transcendencji.&r"
	]
	quest.6B638BA751B92383.quest_desc: ["Spala biomasę, którą kruszarka zrobi z roślin, nasion i jedzenia. Pole uprawne zamieni się w elektrownię."]
	quest.6B638BA751B92383.title: "Biogenerator"
	quest.6B922455932772B7.quest_desc: ["Kuźnia stopów łączy blok lazurowego srebra ze złotem i perłami Endu w trzy sztabki."]
	quest.6B994E8C76B3D416.quest_desc: [
		"&7Era mosiądzu · zalecana diamentowa zbroja i ognioodporność&r"
		""
		"Na łąkach stoją samotne piekielne złowrogie dynie otoczone świecami. Z takiej dyni powstaje Lord Dyniogłowy."
	]
	quest.6B994E8C76B3D416.title: "Piekielna dynia"
	quest.6BA7D86838453BC1.quest_desc: ["Iskra, pożoga, strumień wody, gejzer i inne glify Ars Elemental działają najlepiej w szatach i z fokusem swojego żywiołu. Zrób dowolny z nich na stole skryby."]
	quest.6BA7D86838453BC1.title: "Glif żywiołu"
	quest.6BBC06EE9A8330D8.quest_desc: ["Terminal z siatką rzemiosła. Składniki bierze z sieci, a JEI wypełni siatkę jednym kliknięciem."]
	quest.6BBC4AAA6C6481C3.quest_desc: [
		"Różdżka z tym szablonem przestaje się zużywać. Przepis wymaga gwiazdy Netheru, a zakładasz go z płaczącym obsydianem."
		""
		"&7Kolejny tier różdżek pojawi się tutaj, gdy twoja drużyna wejdzie w erę elektryczności.&r"
	]
	quest.6BCA36B155FEAF5F.quest_desc: ["Strzela kamykami z depthrocku. Zrobisz ją z patyka i skręconej gałązki."]
	quest.6BD5B3722CDB920E.quest_desc: ["Przyłóż ciężką płytę do stalowej obudowy, a dostaniesz ciężką obudowę maszynową. Z niej powstają wieże destylacyjne, pompy żerdziowe i skanery; dwie trafią do pieczęci."]
	quest.6BD5B3722CDB920E.quest_subtitle: "Składnik pieczęci"
	quest.6BE8A9C8F130FD20.quest_desc: [
		"Miodowy klej to wygodniejszy superklej do symulowanych maszyn: kliknij dwa rogi, a zaznaczysz obszar, który złoży montażownik fizyki. Nie skleja przypadkiem bloków obok, co zdarza się superklejowi."
		""
		"&7Ta strona idzie dalej niż drzewo ery pary i stali: liny, czujniki, śmigłowce, pojazdy naziemne i silniki Create Propulsion.&r"
	]
	quest.6BF0FFF37102F281.quest_desc: ["Licznik Geigera pokazuje promieniowanie wokół ciebie, a dozymetr – dawkę, którą już przyjąłeś."]
	quest.6BF0FFF37102F281.title: "Pomiar promieniowania"
	quest.6BF7CC8ED4ABE8B6.quest_desc: ["Echowa półka głębinowa z sculkiem, katalizatorem sculku i wąsem nadzorcy, który wypada z bossa ({entity.minecraft.warden})."]
	quest.6BFC9DCA8E996510.quest_desc: ["Miej naraz 256 ciężkich płyt. Tyle wykuje tylko linia montażu sekwencyjnego, do której stal dociera sama."]
	quest.6BFC9DCA8E996510.quest_subtitle: "Dowód automatyzacji"
	quest.6BFC9DCA8E996510.title: "Walcownia"
	quest.6C049420F9FD2E73.quest_desc: ["Przełącznik kieruje pociągi na wybraną odnogę rozjazdu. Przestawisz go ręcznie albo sygnałem redstone, a komparator odczyta, w którą stronę jest ustawiony."]
	quest.6C049420F9FD2E73.title: "Przełączniki rozjazdów"
	quest.6C0E1C514CE079D5.quest_desc: ["Powstaje w komorze nasycania: {item.ars_nouveau.wilden_tribute} w środku i esencje wszystkich szkół Ars na piedestałach wokół. Jedno nasycenie daje pięć znaków; jeden trafi do pieczęci, pozostałe do fokusów żywiołów."]
	quest.6C0E1C514CE079D5.quest_subtitle: "Kamień milowy"
	quest.6C0E1C514CE079D5.title: "&d{item.ars_elemental.mark_of_mastery}"
	quest.6C1495C40068DD65.quest_desc: ["Lodowy pałac na lodowcu. Na jego szczycie Królowa Śniegu otacza się lodowymi strażnikami."]
	quest.6C1495C40068DD65.title: "Pałac zorzy"
	quest.6C192DD04B42C0A0.quest_desc: ["Rzeźbiony ciemny kamień na kuźni, 4 kawałki gwiezdnolitu i 4 runy na piedestałach. Rytuał pochłonie 2000 aurealu, 12 000 krwi i 100 dusz; od tego poziomu kuźnia przyjmie najtrudniejsze rytuały."]
	quest.6C192DD04B42C0A0.quest_subtitle: "Kamień milowy"
	quest.6C192DD04B42C0A0.title: "&dKuźnia: poziom IV"
	quest.6C20F8E8EB812A70.quest_desc: ["Serce zombie, zgniłe mięso, mączka kostna i węgiel drzewny w tyglu. Serca wypadają z osiłków zombie ({entity.eidolon_repraised.zombie_brute})."]
	quest.6C3A01FD4D195B20.quest_desc: [
		"&7Era okultyzmu · zalecana netherytowa zbroja i mikstury ognioodporności&r"
		""
		"Ogromna rękawica śpi na swojej arenie w Netherze. Strzela laserem z oka i miażdży pięścią, więc ciągle zmieniaj miejsce."
		"Arenę znajdziesz w gałęzi Świata rozdziału ery."
	]
	quest.6C3A01FD4D195B20.title: "Rękawica w Netherze"
	quest.6C4B0347FF95AF62.quest_desc: ["Łapie z łańcucha paczki ze swoim adresem i odkłada je do pojemnika pod sobą. Wysyła też paczki dalej."]
	quest.6C51563494DB93F1.quest_desc: ["Młotem kowalskim uruchamiasz rytuały kuźni Hefajstosa. Głowicę ulepisz z gliny."]
	quest.6C51563494DB93F1.title: "Młot kowalski"
	quest.6C62731D6A5A7821.quest_desc: ["Trzy włókna splecione razem dają sznurek. Zwiąże ostrze z trzonkiem."]
	quest.6C62731D6A5A7821.title: "Sznurek roślinny"
	quest.6C6A65781CF23A39.quest_desc: ["Zwykłe biblioteczki dają najwyżej 15 Eterny, czyli zaklinanie do poziomu 30. Zaczaruj coś na tym poziomie."]
	quest.6C6A65781CF23A39.title: "Zaklinanie na poziomie 30"
	quest.6C7F38A3B39C5C6C.quest_desc: ["Czasowy wybucha po ustawionym czasie od strzału, a zbliżeniowy, gdy pocisk zbliży się do bloku. Zbliżeniowy działa tylko z przodu pocisku."]
	quest.6C7F38A3B39C5C6C.title: "Lepsze zapalniki"
	quest.6CA6B18895167E56.quest_desc: ["Każde stworzenie zabite kosą rozpada się na duchy swojej natury: zwierzęta dają święte, stwory wodne wodne, latające powietrzne, a podziemne ziemne. Zbierz po jednym z każdego."]
	quest.6CA6B18895167E56.title: "Pozostałe duchy"
	quest.6CBED5CB07115FAA.quest_desc: ["Kliknij nim blok prawym przyciskiem, a ten uniesie się w powietrze. Tak przeniesiesz nawet ciężkie bloki."]
	quest.6CC88F8CF746B735.quest_desc: ["Skalne leże w sercu ognistego bagna. Zanim tam pójdziesz, zjedz gulasz po Minoszrumie, bo inaczej żar bagna cię nie wpuści."]
	quest.6CC88F8CF746B735.title: "Leże Hydry"
	quest.6CD2F728EFCF6A84.quest_desc: [
		"Półki z głębin pozwalają zaklinać na poziomie 80. Zaczaruj coś na tym poziomie."
		""
		"&7Kolejny tier zaklinania pojawi się tutaj, gdy twoja drużyna wejdzie w erę atomu.&r"
	]
	quest.6CD2F728EFCF6A84.title: "Zaklinanie na poziomie 80"
	quest.6CE6C71B1CB57FFC.quest_desc: ["Założona na głowę chroni przed chmurami gazu, ale nie przed trwałymi miksturami ani oddechem smoka."]
	quest.6D0DE9C189A8CF2D.quest_desc: ["Zjedzony daje na chwilę regenerację i odporność. Dobry zapas na kolejną walkę."]
	quest.6D11D58E0AE817AA.quest_desc: ["Postaw stopę na Księżycu. Niska grawitacja, brak powietrza i złoża tytanu."]
	quest.6D11D58E0AE817AA.quest_subtitle: "Kosmos, nieobowiązkowy"
	quest.6D11D58E0AE817AA.title: "Księżyc"
	quest.6D1A5A383E5625A5.quest_desc: ["Tłok to serce silników Create Diesel Generators. Zrobisz go ze stopu andezytu, wału i bryłek cynku."]
	quest.6D1FFED7A276D0DC.quest_desc: ["Posadź nasiona ponurej dyni. Rośnie jak zwykła dynia, a wydrążona z pochodnią da latarnię."]
	quest.6D1FFED7A276D0DC.title: "Ponura dynia"
	quest.6D23F24EEA01AF37.quest_desc: ["Ceglane mosty i korytarze kryją płomyki i witherowe szkielety. Tu zdobędziesz płomienne różdżki i żywego płomyka do palnika."]
	quest.6D23F24EEA01AF37.quest_subtitle: "Kamień milowy"
	quest.6D23F24EEA01AF37.title: "&aForteca Netheru"
	quest.6D25845F83D38B09.quest_desc: ["Prosta ikona z pszenicy. Postawiona na ołtarzu daje twoim modlitwom adresata."]
	quest.6D7B78BBF98C9613.quest_desc: [
		"Skrzynia z gniazdami na ulepszenia. Zrobisz ją z desek i dźwigni albo przerobisz zwykłą skrzynię, dokładając dźwignię."
		""
		"&7Ulepszenia wkładasz w gniazda z boku okna skrzyni.&r"
	]
	quest.6DA91091EF65DCA6.quest_desc: ["Leży w skrzyni w piwnicy igloo."]
	quest.6DF063684894D56F.quest_desc: ["Ulepsza netherytową zbroję i broń. Hełm pokaże wrogów za ścianą, a napierśnik raz cię wskrzesi."]
	quest.6DF92387C832E148.quest_desc: ["Skrzynia z gniazdami ulepszeń, która po rozbiciu zabiera zawartość ze sobą. Zrobisz ją ze skrzyni i skorupy shulkera z Endu."]
	quest.6E0545E13434316F.quest_desc: ["Lewiatan zostawia jajo. Wykluje się z niego mały Lewiatan."]
	quest.6E12F539C818303D.quest_desc: ["Wyrzuca przedmioty łukiem w wybrane miejsce. Cel ustawisz, klikając go wyrzutnią przed postawieniem."]
	quest.6E138A18A1B6BB42.quest_desc: ["Zjedz go, a Las Zmierzchu otworzy przed tobą &c{biome.twilightforest.fire_swamp}&r i leże hydry."]
	quest.6E149B0A7A322983.quest_desc: ["Prasy kryje &b{block.ae2.mysterious_cube}&r w sercu meteorytu. Kopię prasy odciśniesz na bloku żelaza w maszynie z następnego zadania."]
	quest.6E149B0A7A322983.title: "Prasy procesorów"
	quest.6E304D1D827F9F64.quest_desc: ["Robotnik Netheru wyprawia się przez portal po surowce z Netheru. Jego chata wymaga obsydianu."]
	quest.6E34413BB3C06079.quest_desc: [
		"Pierwszy filtr przepuszcza wybrane przedmioty, drugi całe grupy według tagów. Włożysz je w lej ekwipunku albo w konfigurator."
		""
		"&7Kolejny tier magazynu pojawi się tutaj, gdy twoja drużyna wejdzie w erę mosiądzu.&r"
	]
	quest.6E34413BB3C06079.title: "Filtry"
	quest.6E6D225C51ACF794.quest_desc: ["Odmiana kodu mistycznego, która zużywa własną trwałość: rzucony zwój nie przepada."]
	quest.6E6D225C51ACF794.quest_subtitle: "Kamień milowy"
	quest.6E6D225C51ACF794.title: "&d{item.mahoutsukai.mystic_code_first_sorcery}"
	quest.6EBA68A59BB4001D.quest_desc: ["Zapisuje skopiowane budowle na szablonach. Przechowasz je albo przekażesz drużynie."]
	quest.6ED921F470B9B153.quest_desc: ["Strażnik ruin zostawia lśniącą tabliczkę i jedną z czterech lśniących broni."]
	quest.6EEDF7F3851CCB41.quest_desc: ["Terminal bezprzewodowy sieci ME i przenośny panel QIO: to, co zgromadziłeś przez dziewięć er, masz zawsze przy sobie."]
	quest.6EEDF7F3851CCB41.quest_subtitle: "Kamień milowy"
	quest.6EEDF7F3851CCB41.title: "&bCały magazyn w kieszeni"
	quest.6F084A4C80C949B3.quest_desc: [
		"&7Ekwipunek: broń z utherium albo netherytu i dobra zbroja.&r"
		"Kamienny strażnik katakumb Undergarden. Po walce zostawia bryłki zapomnianego metalu."
	]
	quest.6F084A4C80C949B3.quest_subtitle: "Boss"
	quest.6F084A4C80C949B3.title: "&c{entity.undergarden.forgotten_guardian}"
	quest.6F0A3C4DB5091466.quest_desc: ["Złoża ołowiu i niklu leżą w Overworldzie, zwykle głębiej niż żelazo. Płytki z obu metali trafiają do stalowego mechanizmu, kadzi chemicznej i akumulatorów."]
	quest.6F0A3C4DB5091466.title: "Ołów i nikiel"
	quest.6F0C404F09202805.quest_desc: ["Kruszy sztabki na pył, a w przerobie ×3 i wyższym zamienia grudki w brudny pył."]
	quest.6F0EAB9871E04E4F.quest_desc: ["Wycina całą budowlę i wkleja ją w nowym miejscu. Przeprowadzka bazy zajmie kilka minut."]
	quest.6F13D8F6ECF2C57A.quest_desc: ["Przyzywa twoje własne dręczyciele, takie jak te przywoływacza. Latają przez ściany i walczą za ciebie."]
	quest.6F30D36E116F0630.quest_desc: [
		"Księga okuta żelazem mieści więcej zaklęć niż miedziana. Zrobisz ją ze skóry, łańcucha i papieru."
		""
		"&7Te zadania rozwijają gałąź magii z rozdziału ery run.&r"
	]
	quest.6F4518C7CB09DE77.quest_desc: ["Szkoła diamentu tworzy z many broń i tarcze: kopie przedmiotów, ostrzał broni, kwiat tarczy Rho Aias."]
	quest.6F4518C7CB09DE77.title: "Zwój projekcji"
	quest.6F4F45B2879824EF.quest_desc: ["Postawiony na taśmie rozdziela przedmioty na sąsiednie taśmy i lejki. Tak rozprowadzisz rudę do kilku pieców."]
	quest.6F69FE43BAEE036B.quest_desc: [
		"Harmonogram kolejowy to lista poleceń dla maszynisty: jedź do stacji, czekaj, jedź dalej. Daj go komuś, kto siedzi przy kontrolerze pociągu – nawet wieśniakowi albo płomykowi – a pociąg pojedzie sam."
		""
		"&7Ta strona idzie dalej niż drzewo ery mosiądzu: rozkłady, sygnały, długie składy i dodatki Steam 'n' Rails.&r"
	]
	quest.6F69FE43BAEE036B.title: "Rozkład jazdy"
	quest.6F768ADA63B6D761.quest_desc: ["Rozpadająca się rama dawnego portalu osnowy. Zwój odkrywcy wrzucony w taką ramę przeniesie cię do nieznanej budowli w okolicy."]
	quest.6F768ADA63B6D761.title: "Zrujnowany portal osnowy"
	quest.6F8D2D54DCC426A5.quest_desc: ["Resztki portalu do Netheru. W skrzyni obok bywa złoto, a w ramie płaczący obsydian."]
	quest.6F8D2D54DCC426A5.title: "Zrujnowany portal"
	quest.6F930312662F34A2.quest_desc: ["&a{item.cataclysm.abyss_eye}&r leci w stronę zatopionego miasta na dnie oceanu. Tam śpi &c{entity.cataclysm.the_leviathan}&r."]
	quest.6F930312662F34A2.title: "Zatopione miasto"
	quest.6FE8EF84C68C687F.quest_desc: ["Daj grabarzowi totem nieśmiertelności. Z odpowiednim badaniem pomoże mu wskrzesić poległego."]
	quest.6FE8EF84C68C687F.title: "Totem grabarza"
	quest.70069CD4972F8AD2.quest_desc: ["To samo dla płynów: sal amoniak z akumulatorów popłynie sam do kotłów skraplających."]
	quest.70069CD4972F8AD2.title: "Płyny w sieci"
	quest.70323C5A34F8FAE4.quest_desc: [
		"Gdy zdobędziesz kamienie milowe tej ery, oddaj &6Pieczęć Ery Atomu&r. Cała twoja drużyna wejdzie w erę atomu, a pieczęć przepadnie."
		""
		"Pieczęć powstaje w montażu sekwencyjnym Create na stalowej obudowie Mekanism: aplikatory dokładają procesor inżynieryjny, elitarny układ sterowania, kondensator i miedziany obwód, prasa je dociska, a potem dochodzą uświęcone złoto i trofea dwóch bossów tej ery."
		""
		"&7Dokładny przepis zobaczysz w JEI: najedź na pieczęć i wciśnij R.&r"
	]
	quest.70323C5A34F8FAE4.quest_subtitle: "Oddaj pieczęć"
	quest.70323C5A34F8FAE4.title: "Brama: Era Atomu"
	quest.703EF1E03C87178B.quest_desc: ["Zasilany zatrzask pamięta stan: sygnał z tyłu go włącza, a sygnał z boku wyłącza. Zatrzask przełączny zmienia stan przy każdym impulsie."]
	quest.703EF1E03C87178B.title: "Zatrzaski"
	quest.70B4FD7338043E75.quest_desc: ["Miej naraz 256 kryształów dowolnego metalu. Tyle da tylko linia ×5, do której rudy, kwas i woda trafiają same."]
	quest.70B4FD7338043E75.quest_subtitle: "Dowód automatyzacji"
	quest.70B4FD7338043E75.title: "Krystalizatornia"
	quest.70BC27A1F58001BB.quest_desc: ["Rury przemysłowe prowadzą ropę ze złoża do pompy żerdziowej i łączą wyjścia wieży destylacyjnej. Wycinasz je ze stali na przecinarce."]
	quest.70C1B9524812668E.quest_desc: [
		"Ustawia dokładną prędkość dużego koła zębatego położonego na nim, niezależnie od źródła napędu. Docelową liczbę obrotów wybierasz na jego panelu."
		""
		"&7Ponder (przytrzymaj W nad przedmiotem) pokaże, jak to złożyć.&r"
	]
	quest.70C1B9524812668E.quest_subtitle: "Kamień milowy"
	quest.70C1B9524812668E.title: "&6{block.create.rotation_speed_controller}"
	quest.70D67FDC3329C861.quest_desc: ["Świetliki siedzą na pniach drzew i zbierzesz je jak blok. Zamknięty w słoju świeci jak lampa."]
	quest.70E7DC4726E742B6.quest_desc: ["Tylu sztabek nie naładujesz ręcznie. Puść żelazo taśmociągiem pod kilka maszyn z poprzedniego zadania i odbieraj wynik lejkiem."]
	quest.70E7DC4726E742B6.quest_subtitle: "Dowód automatyzacji"
	quest.70EDFDD32A3CF2D1.quest_desc: ["Pustą magiczną mapę zrobisz z papieru i soczewki. Użyta pokazuje biomy i główne budowle Lasu Zmierzchu wokół ciebie."]
	quest.70EDFDD32A3CF2D1.quest_subtitle: "Kamień milowy"
	quest.70EDFDD32A3CF2D1.title: "&aMagiczna mapa"
	quest.7106AD48F9A4986F.quest_desc: ["Witherowe szkielety w fortecach rzadko gubią czaszki. Trzy czaszki postawione na piasku dusz przywołają Withera."]
	quest.7123C74FFFEB94F3.quest_desc: ["Przesyła sygnał redstone bez kabli. Dwa przedmioty w gniazdach ustawiają częstotliwość, a każdy nadajnik w trybie odbioru z tą samą parą dostanie sygnał."]
	quest.7146641FF103ED55.quest_desc: ["Andezyt połączony z samorodkami żelaza daje stop, z którego w następnej erze zbudujesz pierwsze maszyny Create."]
	quest.7146641FF103ED55.quest_subtitle: "Składnik pieczęci"
	quest.7159AB04F148D22F.quest_desc: ["Paliwo i odpady jądrowe promieniują. Strój chroni przed napromieniowaniem, a &6{item.mekanism.geiger_counter}&r pokaże, gdzie jest groźnie."]
	quest.7159AB04F148D22F.title: "Strój ochronny"
	quest.715CB081AC5001D7.quest_desc: ["Zbuduj prostokątną ramę z kamienia źródła, postaw obok pełny słoik źródła i wrzuć w ramę zapisany zwój osnowy. Powstanie stały portal w zapamiętane miejsce w tym samym wymiarze."]
	quest.715CB081AC5001D7.title: "Portal osnowy"
	quest.71786F3F8A5631D5.quest_desc: ["Szaty technomanty z Cataclysm: Spellbooks. Szaty maga, tajemna esencja i runa technomancji, której fokusem jest tajemna zębatka albo komparator."]
	quest.71786F3F8A5631D5.title: "Strój inżyniera"
	quest.717AE319414C1592.quest_desc: ["Dowód automatyzacji: 256 torów kolejowych. Tor powstaje w montażu sekwencyjnym, więc postaw linię z aplikatorami i prasą, zanim wytyczysz pierwszą trasę."]
	quest.717AE319414C1592.title: "Tory z linii montażowej"
	quest.71878DD66B276DD9.quest_desc: ["Przedłuża stronę pojemnika, w który jest skierowany. Tak podłączysz piec albo maszynę z drugiej strony ściany."]
	quest.71A5A31E5BF49CEE.quest_desc: ["Tryb {effortlessbuilding.mode.cube} wymaga trzech kliknięć: dwóch narożników podstawy i wysokości. W menu wybierzesz wypełnienie: pełne ({effortlessbuilding.action.full}), puste w środku ({effortlessbuilding.action.hollow}) albo sam szkielet ({effortlessbuilding.action.skeleton})."]
	quest.71A5A31E5BF49CEE.title: "Prostopadłościan"
	quest.71F650FEEF8E9066.quest_desc: ["Wysyła składniki ze wzoru do maszyny obok albo do asemblera i odbiera gotowy produkt."]
	quest.721DD6D33E898DC7.quest_desc: ["Urna zamienia źródło w wodę. Połączona różdżką dominium z kotłem, sama go napełnia."]
	quest.721E79C1649B6E55.quest_desc: [
		"&7Era okultyzmu · zalecane: netherytowa zbroja, ognioodporność&r"
		"Mroczny kapłan Goety. Przywołasz go rytuałem na mrocznym ołtarzu: aktywuje go sztabka netherytu, a resztę składników pokaże JEI."
	]
	quest.721E79C1649B6E55.quest_subtitle: "Boss"
	quest.721E79C1649B6E55.title: "&c{entity.goety.apostle}"
	quest.7226DC15E5450115.quest_desc: ["Zrobisz je z gwiezdnego kwiatu i pereł z endermanów. Pomagają odnaleźć wielkie budowle Eternal Starlight."]
	quest.722DE86AF016F46A.quest_desc: ["Czarodziejska księga z diamentu, skóry hoglina, tajemnej tkaniny i zaklętej książki. Mieści jeszcze więcej zaklęć."]
	quest.722DE86AF016F46A.quest_subtitle: "Kamień milowy"
	quest.722DE86AF016F46A.title: "&d{item.irons_spellbooks.diamond_spell_book}"
	quest.72352E2E402CB838.quest_desc: ["Osiem pierścieni wokół łącza i para splątanych osobliwości łączą dwie sieci ME na dowolną odległość, także między wymiarami."]
	quest.72352E2E402CB838.title: "Most kwantowy"
	quest.727E9B13BCBF1C7D.quest_desc: ["Szaty maga, tajemna esencja i runa nekromancji na stole kowalskim. Wzmacniają przywołania nieumarłych i zaklęcia śmierci."]
	quest.727E9B13BCBF1C7D.title: "Szaty nekromanty"
	quest.72904B22A8464C33.quest_desc: ["Żelazna, diamentowa i netherytowa różdżka szukają coraz dalej. Do najmocniejszej potrzebujesz pręta płomienia i odłamka netherytu."]
	quest.72904B22A8464C33.title: "Lepsze różdżki"
	quest.729ACA147B872878.quest_desc: [
		"Zamienia kamień, cegły i podobne bloki w dziesiątki wzorów, nawet cały stos naraz. Każdy warsztat Chipped obrabia inne materiały."
		""
		"&7Kliknij warsztat, włóż blok i wybierz wzór z listy.&r"
	]
	quest.72B8182AEEAEBA8E.quest_desc: ["Pełna zbroja z cloggrum na pierwsze zejście w głąb Undergarden."]
	quest.72B8182AEEAEBA8E.title: "Zbroja z cloggrum"
	quest.72D0FC9438AAD3AC.quest_desc: ["Zamienia prąd z powrotem w obroty. Postawisz go z dala od generatora i zasilisz linią przesyłową."]
	quest.72DB2B4AE2EEBF27.quest_desc: ["Mały pojazd szynowy, który stawiasz od razu na torze. Kluczem montażowym podniesiesz go z powrotem do ekwipunku."]
	quest.72E1E2BC19C49020.quest_desc: [
		"&7Era mosiądzu · zalecane: diamentowa zbroja&r"
		"Duch kapitan wynurza się z wody, gdy zadmiesz w róg z muszli w Lodowym Labiryncie."
	]
	quest.72E1E2BC19C49020.quest_subtitle: "Boss"
	quest.72E1E2BC19C49020.title: "&c{entity.aquamirae.captain_cornelia}"
	quest.72E99AAA05838BB0.quest_desc: ["Po świecie stoją obozy najeźdźców pełne wojowników i łupów. Zabierz strażników albo drużynę."]
	quest.72E99AAA05838BB0.title: "Obóz barbarzyńców"
	quest.72F0C6F14125A46B.quest_desc: ["Dysk mieszczący wielokrotnie więcej niż podstawowy. Przepis wymaga plutonu."]
	quest.72F25F57F01FFC0D.quest_desc: ["Lawa, ogniste gejzery i leże hydry. Ta kraina otworzy się, gdy zjesz stroganow po minoszrumie."]
	quest.72F25F57F01FFC0D.title: "{biome.twilightforest.fire_swamp}"
	quest.730570161AB2FB9C.quest_desc: [
		"Budynki kolonii otwierają się razem z erami twojej drużyny. Zwykłe rosną w erach techniki, magiczne (biblioteka, szkoła, zaklinacz, miejsce mistyczne, kwiaciarnia, alchemik, cmentarz) w erach magii."
		"W erze andezytu wszystko dochodzi do poziomu 2. Wyższe poziomy pojawią się na tej stronie w kolejnych erach."
	]
	quest.730570161AB2FB9C.title: "Dwa tory budynków"
	quest.730B8E2ACA9F8861.quest_desc: ["Swobodny lot zasilany z pancerza. Wymaga gwiazdy Netheru, antymaterii i ostatecznego dostawcy indukcyjnego."]
	quest.732C5B634279DBAD.quest_desc: [
		"Ratusz zrobisz z narzędzia budowania i desek. Postaw go tym narzędziem: wybierzesz styl i miejsce kolonii."
		"&7Kolonia należy do jednej osoby, ale możesz dopisać do niej resztę drużyny.&r"
	]
	quest.732C5B634279DBAD.title: "Założenie kolonii"
	quest.7342EB62CDB67F4B.quest_desc: ["Ametystowy golem hoduje i zbiera ametyst wokół swojego domu. Amulet da ci rytuał przebudzenia odprawiony przy pączkującym ametyście."]
	quest.734E190F808D8821.quest_desc: [
		"Grafit zrobisz z gliny i węgla. Prasa robi z niego pustą formę, a przecinarka wytnie z formy kształt sztabki, blachy, pręta albo samorodka."
		""
		"&7Misę hutniczą i stół odlewniczy znajdziesz w rozdziale Ery Mosiądzu. Ta strona je rozszerza.&r"
	]
	quest.736943C43B82146E.quest_desc: ["Widzi cały zapas sieci. Posadź obok niego moba na siedzisku, a zostanie magazynierem: kliknij go, wybierz towar, a pakowacze przyślą paczkę."]
	quest.736943C43B82146E.quest_subtitle: "Kamień milowy"
	quest.736943C43B82146E.title: "&b{block.create.stock_ticker}"
	quest.737270BF555FE1CF.quest_desc: ["Miej naraz 256 siarek alchemicznych dowolnego rodzaju. Niech kotły skraplające dostają przedmioty i sal amoniak przez sieć, nie z twojej ręki."]
	quest.737270BF555FE1CF.quest_subtitle: "Dowód automatyzacji"
	quest.737270BF555FE1CF.title: "Siarka hurtem"
	quest.73770CA8D5A19E9C.quest_desc: ["Chodzi tylko wtedy, gdy kręci go napęd. Gdy zapada noc, kukułka przypomni całej okolicy, że czas spać."]
	quest.737E190FA5816D2F.quest_desc: ["Obraca wszystko, co na nim stoi: graczy, zwierzęta i przedmioty. Przyda się na wystawę albo jako karuzela."]
	quest.7387C900174FDCFC.quest_desc: ["Przygasła latarnia potrafi wezwać bossa kultystów do kolejnej walki, choć nie zawsze ktoś odpowiada."]
	quest.7387FAB39513EF18.quest_desc: ["Grzałka kotła działa jak płomienny palnik, ale zamiast paliwa bierze ciepło z rur. Postaw ją pod kotłem silnika parowego Create."]
	quest.73917E75D35BC1AA.quest_desc: ["Nagrzewnica spala kreozot albo gaz piecowy i ogrzewa powietrze z wlotu powietrza. Bez gorącego powietrza wielki piec nie wytopi stali."]
	quest.73917E75D35BC1AA.title: "Gorące powietrze"
	quest.73CB7C34B6D592E3.quest_desc: ["Dowód automatyzacji: 256 arkuszy żelaza. Prasa nad taśmociągiem zgniata sztabki w biegu, a lejek na końcu taśmy zbiera arkusze."]
	quest.73CB7C34B6D592E3.title: "Walcownia"
	quest.73D22E161117F5F1.quest_desc: [
		"&7Era transcendencji · zalecana odporność na magię i dużo leczenia&r"
		""
		"W ukrytym skarbcu katakumb leży zwój zaklęcia wzywającego Umarłego Króla. Rzucone wywoła jego rozwścieczoną wersję: silniejszą, ale z lepszymi łupami."
		"&7Tylko z niego wypada zwój zaklęcia Blackout.&r"
	]
	quest.73D22E161117F5F1.title: "Powrót Umarłego Króla"
	quest.73FC15973C7D49B0.quest_desc: ["Daje sygnał redstone, gdy w magazynie jest więcej albo mniej wybranego przedmiotu niż ustalona liczba."]
	quest.7404AAD62E8C2537.quest_desc: [
		"&7Era okultyzmu · zalecane: netherytowa zbroja, mikstury&r"
		"Trzy czaszki na konstrukcji z piasku dusz budzą niszczyciela. Walcz z dala od bazy, bo jego wybuchy niszczą teren."
	]
	quest.7404AAD62E8C2537.quest_subtitle: "Boss"
	quest.7404AAD62E8C2537.title: "&c{entity.minecraft.wither}"
	quest.7412A95FC4A07D54.quest_desc: ["Każdy powstaje z trzech części: nadruku z prasy, nadrukowanego krzemu i redstone'u."]
	quest.7412A95FC4A07D54.title: "Procesory"
	quest.7428D1C8B604F4CD.quest_desc: ["Duża kolonia ściąga największe najazdy. Trzydziestu strażników w koszarach z pełnym kompletem wież to obrona, która wytrzyma każdą noc."]
	quest.7428D1C8B604F4CD.title: "Armia dużej kolonii"
	quest.742B79BAED417A1A.quest_desc: [
		"Miksturę przemiany uwarzysz w rytuale nekroturgii z krwią Apostoła ({entity.goety.apostle}), ofiarą z wieśniaka i 1000 energii dusz, a wypić ją trzeba przy pełni. Licz nie głodnieje i leczy rany energią dusz."
		""
		"&cBez nakrycia głowy licz płonie w słońcu, a wieśniacy go nienawidzą.&r"
	]
	quest.742B79BAED417A1A.quest_subtitle: "Kamień milowy"
	quest.742B79BAED417A1A.title: "&dPrzemiana w licza"
	quest.744B57DD1079C2D3.quest_desc: [
		"Aktywator ze stabilizatorami piątego poziomu, jasnym i ciemnym, złożony w jeden blok. Pomieści więcej niż cały dawny magazyn ze stabilizatorami dookoła."
		""
		"&7Rytuał wymaga też pyłu echa, skalibrowanego czujnika sculku i ofiary z shulkera.&r"
	]
	quest.744B57DD1079C2D3.quest_subtitle: "Kamień milowy"
	quest.744B57DD1079C2D3.title: "&bStabilny wymiar"
	quest.746E83CAEFA0D10E.quest_desc: ["Po świecie rozrzucone są meteoryty z niebiańskiego kamienia, a wokół nich rośnie kwarc certus. Znajdzie je &b{item.ae2.meteorite_compass}&r."]
	quest.746E83CAEFA0D10E.title: "Meteoryt"
	quest.7476B7D7F698B358.quest_desc: ["Mieści trzy stosy zwojów i przełącza je jednym klawiszem. Rzucasz zaklęcia bez szukania w ekwipunku."]
	quest.747A6AF70FCC8E0A.quest_desc: ["Piracki posterunek na lodzie. Piraci nie lubią gości."]
	quest.747A6AF70FCC8E0A.title: "Posterunek piratów"
	quest.74872B61F75042BA.quest_desc: ["Diamentowa różdżka budowlana stawia naraz więcej bloków niż żelazna. Netherytowa przyjdzie w erze arkanów."]
	quest.748E27A6A6B0C8BC.quest_desc: ["Bloki tajemnego kryształu posypane pyłem Mundabitur stają się obeliskiem. Postawiony przy kuźni sam wytwarza aureal. Popatrz na gotowy obelisk."]
	quest.748E27A6A6B0C8BC.title: "Obelisk tajemnego kryształu"
	quest.749FF4C39EA6DBDF.quest_desc: ["Terminal z siatką 3×3: bierze składniki prosto ze skrzyń w sieci i odkłada do nich wyniki."]
	quest.74A29DF9B4DFE34A.quest_desc: ["Amendments zmienia zwykłe bloki: latarnię powiesisz na ścianie, w kotle zmieszasz barwniki, a doniczkę zawiesisz pod sufitem. Warto sprawdzić, co jeszcze da się postawić inaczej niż w zwykłej grze."]
	quest.74A29DF9B4DFE34A.title: "Amendments"
	quest.74A813B40CC23A56.quest_desc: ["Niesie 32 kanały. Zrobisz go z czterech osłoniętych kabli."]
	quest.74C281A272FD6D6D.quest_desc: [
		"Para i zaklęcia zaprowadziły cię daleko, ale nowe maszyny chcą prądu. Zaprzęgnij Create do generatorów, rudy przepuść przez Mekanism, a zapasy zamknij w sieci ME."
		"Pod twoimi stopami otwierają się dwa światy: Undergarden i Otherside. Ich strażnicy nie wpuszczą cię za darmo."
		""
		"Era kończy się bramą. Wymaga ona kamieni milowych z gałęzi tego rozdziału i Pieczęci Ery Atomu."
	]
	quest.74C281A272FD6D6D.quest_subtitle: "Początek ery"
	quest.74C281A272FD6D6D.title: "Era Elektryczności"
	quest.74D7F15B8ECC3010.quest_desc: ["Pożyczasz moc bogów: rośnie twoja szybkość i siła, a trafione stwory przebijają ściany."]
	quest.74DA58C86CD7C5B1.quest_desc: ["Mała kapliczka Starbuncli z Ars Elemental, ukryta wśród drzew."]
	quest.74DA58C86CD7C5B1.title: "Kapliczka Starbuncli"
	quest.74E3EAED329E6090.quest_desc: ["Rzadka wyspa na oceanie, porośnięta grzybnią. Nie pojawiają się na niej potwory."]
	quest.74E3EAED329E6090.title: "{biome.minecraft.mushroom_fields}"
	quest.74FBE7169DAAD16D.quest_desc: ["Pokazuje wzory wszystkich dostawców w sieci. Zmienisz je bez chodzenia od maszyny do maszyny."]
	quest.75015D413FFE1814.quest_desc: ["Dopiero siekiera ścina drzewa: pnia nie zniszczysz niczym innym. Deski z pnia zrobisz w siatce rzemiosła siekierą albo piłą."]
	quest.75015D413FFE1814.quest_subtitle: "Kamień milowy"
	quest.75015D413FFE1814.title: "&6{item.notreepunchingremastered.flint_axe}"
	quest.7514362CF1E02C11.quest_desc: ["Hydra zostawia fiolki krwi. Z sztabką żelaza da ognistą sztabkę, a z żelaznym mieczem albo kilofem od razu ognisty oręż."]
	quest.752B16869E32B768.quest_desc: ["Każdy kolejny poziom kostki robisz z poprzedniej i lepszego stopu. Mieści wielokrotnie więcej."]
	quest.7539CA90673E8513.quest_desc: [
		"Głęboka twierdza z bibliotekami i więzieniami. W jej sercu stoi rama portalu do Endu."
		""
		"&7Kompas odkrywcy wskaże drogę, skoro oko Endu tego nie zrobi.&r"
	]
	quest.7539CA90673E8513.quest_subtitle: "Kamień milowy"
	quest.7539CA90673E8513.title: "&aTwierdza"
	quest.75505D38F4C1C49E.quest_desc: ["Zrobisz ją z &6wypolerowanego różowego kwarcu&r i arkusza żelaza. Trafi do aplikatora, mechanicznego stołu rzemieślniczego i do pieczęci."]
	quest.75505D38F4C1C49E.quest_subtitle: "Składnik pieczęci"
	quest.756A40FEF8172638.quest_desc: [
		"&7Ekwipunek: tarcza i broń do walki wręcz.&r"
		"Strażnik ruin portalu sprawdza, czy jesteś godny Eternal Starlight. Pokonaj go w pojedynku."
	]
	quest.756A40FEF8172638.quest_subtitle: "Boss"
	quest.756A40FEF8172638.title: "&c{entity.eternal_starlight.the_gatekeeper}"
	quest.756A665E92CC98C4.quest_desc: ["Biomasa z roślin i oleju ubita w prasie. To bardzo mocne paliwo stałe do płomiennych palników i pieców."]
	quest.756C1FAA55994171.quest_desc: [
		"Gears \\& Grimoires to paczka o technice i magii. Przejdziesz przez dziesięć er, od krzemiennego noża po reaktory i najpotężniejsze zaklęcia. Na końcu czeka finałowy boss."
		""
		"Ta księga prowadzi cię przez całą grę. Zakładka &6Ery&r po lewej to główna linia, a pozostałe opisują poszczególne mody. Nowe strony pojawiają się, gdy twoja drużyna wejdzie w kolejną erę."
		""
		"Zadanie z kłódką czeka na wcześniejsze zadania. Przepis na każdy przedmiot zobaczysz w JEI: najedź na niego i wciśnij &6R&r, a &6U&r pokaże, do czego służy."
		""
		"Zacznij od rozdziału &6Era Kamienia&r."
	]
	quest.756C1FAA55994171.quest_subtitle: "Zacznij tutaj"
	quest.756C1FAA55994171.title: "Witaj w Gears \\& Grimoires"
	quest.756DBE5C2167C273.quest_desc: ["Wypełnia przerwy między skrzyniami: łączy je ze złączem, choć sam niczego nie przechowuje."]
	quest.757D25B04B214434.quest_desc: ["Kliknij nim chatę budowniczego, a pokaże listę materiałów do bieżącej budowy. Przyda się przy zakupach w magazynie Create."]
	quest.7584663819EB3E25.quest_desc: ["Jednostki, pamięć i koprocesory MEGA składają się w procesor zamówień jak w AE2, ale pamięć 1M i więcej udźwignie zamówienia na całe maszyny z setek części."]
	quest.7584663819EB3E25.quest_subtitle: "Kamień milowy"
	quest.7584663819EB3E25.title: "&bProcesor MEGA"
	quest.7595BDE341FB0531.quest_desc: ["Powiększa obszar młota i ekskawatora o jeden blok w każdą stronę, z 3×3 na 5×5."]
	quest.75CC9036951AFF0B.quest_desc: ["Zsyp z filtrem: przepuszcza tylko wybrane przedmioty i odmierza, ile ich wyjmie naraz."]
	quest.75E86C4DDDBE6445.quest_desc: [
		"Spala gazy z gazociągu: wodór z separatora albo etylen, który daje dużo więcej energii."
		""
		"&7Etylen zrobi komora reakcji ciśnieniowych z substratu z biomasy.&r"
		""
		"&7Kolejny tier reaktorów pojawi się tutaj, gdy twoja drużyna wejdzie w erę atomu.&r"
	]
	quest.75F1B8C28A6BA6CC.quest_desc: [
		"Upgrade Aquatic dodaje szczupaki i okonie w rzekach oraz skrzydlice w ciepłych morzach. Złów albo upoluj po jednej."
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę andezytu.&r"
	]
	quest.75F1B8C28A6BA6CC.title: "Nowe ryby"
	quest.75FD615300C441C1.quest_desc: [
		"Kamień, który nosisz przy sobie: otwiera listę znanych kamieni teleportacyjnych w dowolnym miejscu. Podróż z niego kosztuje doświadczenie."
		""
		"&7Zrobisz go z ametystu, szmaragdu i perły z endermana.&r"
	]
	quest.760800D6A478D389.quest_desc: ["Utlenia pył siarki w dwutlenek siarki. Z tlenem da trójtlenek, a ten z parą wodną – kwas siarkowy, bez którego nie ruszy przerób ×5."]
	quest.7608ED7CC36DA267.quest_desc: ["Pionowy krewny kontenera z Create: Connected. Rośnie w górę, więc zmieści się w wąskiej wieży."]
	quest.7615F6CC49558580.quest_desc: ["Do kuźni prowadzi potworne oko. Pilnuje jej &c{entity.cataclysm.netherite_monstrosity}&r."]
	quest.7615F6CC49558580.title: "Kuźnia dusz"
	quest.76291927B354F598.quest_desc: [
		"Stal dała ci siłę, teraz czas na wiedzę. Kuźnia Hefajstosa, alchemia rtęci i mistrzostwo żywiołów otwierają magię, o której dotąd tylko czytałeś. W Netherze i na pustyniach budzą się strażnicy Cataclysmu, a kultyści w ukryciu strzegą swojej tajemnicy."
		""
		"Era kończy się bramą. Wymaga ona kamieni milowych z tego rozdziału i Pieczęci Ery Elektryczności."
	]
	quest.76291927B354F598.quest_subtitle: "Wiedza zamiast siły"
	quest.76291927B354F598.title: "Era Arkanów"
	quest.7639FF2B607C85B6.quest_desc: ["Rośnie w fortecach i bastionach. Posadzisz ją tylko na piasku dusz, a bez niej nie uwarzysz prawie żadnej mikstury."]
	quest.765865B802196D5E.quest_desc: ["Przenosi stałą porcję wydolności z jednej sieci do drugiej, ale trzyma je osobno: przeciążenie jednej nie zatrzyma drugiej."]
	quest.7679E37E80D20468.quest_desc: ["Łączy stykające się z nim repozytoria w jeden zbiór, który pulpit traktuje jak jedną skrzynię."]
	quest.76914BC2056BCB0C.quest_desc: ["Pierścień obniża koszt każdego zaklęcia. Powstaje w aparacie z pierścienia potencjału, perły Endu i diamentu."]
	quest.7692E2658ECFA919.quest_desc: ["Włącza sygnał, gdy zapas w pojemniku przekroczy górny próg, i wyłącza go poniżej dolnego. Zatrzyma produkcję, zanim magazyn się przepełni."]
	quest.7698D81895765B5E.quest_desc: ["Szuflada na płyny: trzyma dużo jednego płynu. Napełnisz ją wiadrem albo rurą."]
	quest.769AB37AFF8E9CEF.quest_desc: ["Zbuduj maszynę na wagoniku z aplikatorem, który kładzie przed nią tory. Kolejka sama wytyczy sobie drogę."]
	quest.769AB37AFF8E9CEF.title: "Kolejka, która kładzie tory"
	quest.76AEE6D375514BB2.quest_desc: ["Izolatory na słupach łączysz szpulą drutu i tak prowadzisz prąd na odległość. Urządzenia w jednej grupie dzielą się napięciem, a grupę zmienisz kluczem konfiguracyjnym."]
	quest.76AEE6D375514BB2.title: "Linia przesyłowa"
	quest.76C395675A66797C.quest_desc: ["Wypadają z bloków glacytu w mroźnych krainach. Zrobisz z nich narzędzia i zbroję."]
	quest.76CA1A9E33002137.quest_desc: [
		"Narzędzie na prąd do wszystkiego: kopie, ścina drzewa i walczy. Prędkość kopania przełączysz trybami."
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę atomu.&r"
	]
	quest.76E4098E4BB473C0.quest_desc: ["Niech mechaniczne ramię samo dokłada paliwa do płomiennego palnika. Mosiądz i para nie zatrzymają się, gdy cię nie ma."]
	quest.76E4098E4BB473C0.title: "Palacz"
	quest.76E7AB773DADB442.quest_desc: ["Gąszcz kolców, przez który przebijesz się lampą. Za nim wznosi się płaskowyż."]
	quest.76E7AB773DADB442.title: "{biome.twilightforest.thornlands}"
	quest.77050A57A7BD2041.quest_desc: ["Kilof z części. Poziom wydobycia daje materiał głowicy: z żelazną głowicą wykopiesz diamenty."]
	quest.77050A57A7BD2041.quest_subtitle: "Kamień milowy"
	quest.77050A57A7BD2041.title: "&6{item.silentgear.pickaxe}"
	quest.771A48EDDB73032C.quest_desc: ["Najpojemniejszy dysk QIO. Potrzebuje antymaterii i polonu, więc to nagroda za całą erę."]
	quest.771F3169787D4F46.quest_desc: ["Żelazna różdżka stawia więcej bloków naraz niż miedziana i dłużej wytrzymuje."]
	quest.772875E33A91B129.quest_desc: ["Kontroler, napęd z komórką pamięci i terminal to najmniejsza sieć ME. Wszystko, co do niej trafi, znajdziesz jednym wyszukiwaniem."]
	quest.772875E33A91B129.quest_subtitle: "Kamień milowy"
	quest.772875E33A91B129.title: "&bSieć ME z dyskiem"
	quest.7732A546E5097A08.quest_desc: ["Na kowadle czarów połączysz dwa zwoje tego samego zaklęcia w zwój wyższego poziomu, nałożysz zaklęcie na broń, a kulę ulepszeń na zbroję. Zrobisz je z kowadła, diamentów, bloków ametystu i polerowanego łupka."]
	quest.7732A546E5097A08.quest_subtitle: "Kamień milowy"
	quest.7732A546E5097A08.title: "&d{block.irons_spellbooks.arcane_anvil}"
	quest.7741DF1FA2EFFDD2.quest_desc: ["Piąty, najszerszy pierścień run (razem 172) i słupy z kryształowymi skupiskami. Skupisko na takim ołtarzu da kulę Divinusa, szczyt witamancji."]
	quest.7741DF1FA2EFFDD2.quest_subtitle: "Kamień milowy"
	quest.7741DF1FA2EFFDD2.title: "&d{item.neovitae.blood_orb_transcendent}"
	quest.776868013AA396D2.quest_desc: ["Toksyczna hałda, wulkaniczne delty i popielne pustkowia to najgroźniejsze krainy Netheru. Na pustkowiach stoi zakazany zamek."]
	quest.776868013AA396D2.title: "Dzikie krainy Incendium"
	quest.7779B739FE49A31A.quest_desc: [
		"Magiczny stół roboczy ma siatkę 3×3 i dodatkowe gniazda wokół niej. Powstaje na nim prawie całe wyposażenie Eidolonu."
		""
		"&7Kodeks i JEI (R) pokażą, co gdzie położyć.&r"
	]
	quest.77A646BE63F42A6E.quest_desc: ["Przepuszcza tylko to, co już leży w danej skrzyni. Magazyn sam się posortuje."]
	quest.77A9ACD05722B00C.quest_desc: ["Przenośna komórka 1M z własnym ekranem. Weź na wyprawę cały magazyn surowców."]
	quest.77B4155A554E183A.quest_desc: ["Wolframit leży w Netherze, w netherracku do wysokości 60. Stopiony w misie hutniczej i odlany da sztabki wolframu."]
	quest.77D9833101CB4077.quest_desc: ["Postaw go na słupie nad sygnałem kolejowym, a ramię semafora pokaże stan sygnału z daleka."]
	quest.77DE00273F050959.quest_desc: [
		"Klawisz „{key.constructionstick.change_restriction}” zmienia ograniczenie: poziomo, pionowo, wzdłuż osi albo bez blokady."
		"Przytrzymaj „{key.constructionstick.show_previous}”, a zobaczysz ostatnio postawione bloki; „{key.constructionstick.undo}” cofnie tę operację i odda bloki."
		""
		"&7Blok w drugiej ręce ma pierwszeństwo przed tym, na który patrzysz.&r"
	]
	quest.77DE00273F050959.title: "Sterowanie różdżką"
	quest.77E8995D40487E15.quest_desc: ["Ars Ocultas łączy Ars Nouveau z Occultism. Ołtarz ofiarny powstaje w aparacie zaklinającym ze złotej misy Occultism, słoja przechowawczego i żetonu Drygmy; jak go używać, opisuje rozdział Ars Ocultas w przewodniku Ars Nouveau."]
	quest.77F54D5DA0D7C74F.quest_desc: ["Dragons Plus dodaje wiatrakom nowe przetwarzanie: przez sypki śnieg zamrażają, np. lód w lód zbity, a magmowy krem w kulę szlamu, a przez piasek szlifują jak papier ścierny. Katalizatory z Create: Connected robią to samo bez bloków w świecie."]
	quest.77F54D5DA0D7C74F.title: "Mrożenie i szlifowanie"
	quest.77FCF655CACC5065.quest_desc: [
		"Krążek z wężem opuszcza końcówkę w płyn i wypompowuje go albo napełnia zbiornik od dołu. Bardzo duży zbiornik, np. ocean, uznaje za nieskończony i niczego w nim nie ubywa."
		""
		"&7Ponder (przytrzymaj W nad przedmiotem) pokaże, jak to ustawić.&r"
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę mosiądzu.&r"
	]
	quest.77FCF655CACC5065.title: "Wąż w głębinę"
	quest.781B686B918890DB.quest_desc: ["Odciska wzory pras na krzemie i metalach. Tu powstają wszystkie procesory AE2."]
	quest.781DEC8ECB15EE9A.quest_desc: [
		"Drugi poziom pojemności. Powstaje z miedzianego ulepszenia, bloku złota i szuflady."
		""
		"&7Kolejny tier szuflad pojawi się tutaj, gdy twoja drużyna wejdzie w erę pary i stali.&r"
	]
	quest.78374C2DA182482C.quest_desc: ["Cegły pryzmarynowe, rozdymka, mikstura i biblioteczka. Morskie półki dają Eternę i Arcanę, a nasycone ulepszysz sercem oceanu albo kryształami."]
	quest.7838D0040ACF1957.quest_desc: ["Tyle arkuszy da tylko zamknięta linia komór reakcji ciśnieniowych. Zbuduj ją raz, a plastiku nie zabraknie."]
	quest.7838D0040ACF1957.quest_subtitle: "Dowód automatyzacji"
	quest.783D4E8F72AFEB32.quest_desc: ["Łożysko śmigła kręci przyczepione do niego żagle jak śmigło i pcha symulowaną maszynę. Większe śmigło daje większy ciąg."]
	quest.7841500570B9B0BF.quest_desc: ["Kliknij nim postawioną skrzynię lub beczkę Sophisticated Storage: stanie się żelazna i większa, bez wyjmowania zawartości."]
	quest.784FFE5AA9775311.quest_desc: [
		"Para i stal zmieniają skalę wszystkiego. Wielki piec leje stal, wieża destylacyjna rozkłada ropę na paliwa, a z nich rodzą się silniki, działa i statki, które wzniosą się ponad chmury. Wyżej czeka już tylko Aether i jego strażnicy."
		""
		"Era kończy się bramą. Wymaga ona kamieni milowych z tego rozdziału i Pieczęci Ery Arkanów."
	]
	quest.784FFE5AA9775311.quest_subtitle: "Wielki piec rusza"
	quest.784FFE5AA9775311.title: "Era Pary i Stali"
	quest.786967513C9B04D7.quest_desc: [
		"&7Era atomu · zalecana dobra zbroja i mikstury ognioodporności&r"
		""
		"Na wyspach Endu stoi obsydianowa arena z runicznym ołtarzem. Czeka na niej Obsidilith, żywy monolit z obsydianu."
	]
	quest.786967513C9B04D7.title: "Arena Obsidilitha"
	quest.78771C6E929A4D20.quest_desc: ["Mikser nad rozgrzanym tyglem zrobi płynną czekoladę z kakao, cukru i mleka. Ta sama wylewka musi polać jagody czekoladą, jabłko miodem i chleb mlekiem."]
	quest.78771C6E929A4D20.title: "Słodka wylewka"
	quest.788AA0421DA887F2.quest_desc: [
		"&7Era pary i stali. Zalecany ekwipunek: kilof z zanitu albo lepszy i pełna zbroja.&r"
		"Kamienny strażnik brązowego lochu. Rani go tylko kilof. Loch kryje się we wnętrzu jednej z wysp Aetheru."
	]
	quest.788AA0421DA887F2.quest_subtitle: "Boss"
	quest.788AA0421DA887F2.title: "&c{entity.aether.slider}"
	quest.789CDD2AC65B21C6.quest_desc: ["Przywołuje chowańca. Zamienisz się z nim miejscami, a jego ogród zabrania walki wszystkim w środku."]
	quest.78AA9DDDFCCCE1A6.quest_desc: ["Wyjdź z Bumblezone: spadnij pod dno wymiaru, a wrócisz tam, skąd przyszedłeś."]
	quest.78AA9DDDFCCCE1A6.title: "Powrót z ula"
	quest.78B0E0C2EC7E9730.quest_desc: ["Piec w skrzyni: przetapia wybrane przedmioty, a paliwo bierze z jej zawartości."]
	quest.78B13D12DA89942E.quest_desc: ["Postaw chaty hodowców krów, owiec, świń, kur i królików. Do każdej przyprowadź kilka zwierząt na start."]
	quest.78B13D12DA89942E.title: "Wszyscy hodowcy"
	quest.78B170ABA0F60C53.quest_desc: ["Przenosi źródło między słoikami na odległość. Zrobisz go ze złota i bloku klejnotów źródła."]
	quest.78CAEB6741926428.quest_desc: ["Kilof nasycony w rytuale djinna z głowicy z dostrojonego klejnotu i srebra. Tylko nim wydobędziesz rudy z innego świata, takie jak iesnium."]
	quest.78E0EEECE1B51D69.quest_desc: [
		"Młocarze polują w głębokich, zimnych morzach i wyczuwają ruch w wodzie. Ząb zostawiają po walce."
		""
		"&7Kolejne zadania tej strony pojawią się tutaj, gdy twoja drużyna wejdzie w erę run.&r"
	]
	quest.78E5F261603DF32D.quest_desc: ["Tunel P2P przenosi całą wiązkę kanałów w inne miejsce, zajmując tylko jeden. Wejście i wyjście połączysz kartą pamięci: skopiuj nią wejście i kliknij wyjście."]
	quest.78E5F261603DF32D.title: "Tunele P2P"
	quest.78F2A9F2B1B4CBA3.quest_desc: ["Tabliczka Rasa na ołtarzu pierwszego poziomu za 2000 esencji. Z niej powstają kamienie rytualne i mocniejsze sigile."]
	quest.78FEA7C19FF81FFB.quest_desc: ["Wypada z nekromanty ({entity.eidolon_repraised.necromancer}). Przyzywa uwięzionych w nim nieumarłych, którzy walczą u twojego boku; więcej złapiesz rytuałem pochwycenia."]
	quest.7906347C754516E9.quest_desc: ["Drygmy zbiera łupy ze stworzeń w pobliżu, nie robiąc im krzywdy. Dzikiego Drygmy zjednasz, rzucając obok niego róg wildena; amulet użyty na omszałym bruku zbuduje jego krąg."]
	quest.790A76A2A83ABBC3.quest_desc: ["Półki nasycasz w samym stole: połóż półkę w miejscu przedmiotu i zaklinaj przy statystykach podanych w JEI (zakładka nasycania). Nasycona półka daje więcej Arcany."]
	quest.790BE9B2E7239D83.quest_desc: ["Whirlisprig przyspiesza wzrost roślin wokół siebie i daje z nich plony. Żeton dostaniesz, gdy wyhodujesz drzewo obok dzikiego Whirlispriga w lesie."]
	quest.791A76947B4455A4.quest_desc: ["Tarcza z ignitium. Puszczona podczas skradania szarżuje do przodu, a wróg wbity w ścianę dostaje więcej obrażeń i zostaje ogłuszony."]
	quest.79252FF3E5D61315.quest_desc: ["Stół stolarza obrabia drewno, deski i kłody, a stół tkacki wełnę i dywany."]
	quest.79252FF3E5D61315.title: "Stolarz i tkacz"
	quest.7932AF6110364BFA.quest_desc: [
		"Wykopuje wybrane rudy w promieniu, który ustawisz, i odkłada je do pojemnika obok. Resztę terenu zostawia w spokoju."
		""
		"&7Rdzeń teleportacyjny i stop atomowy zrobisz w metalurgicznym infuzerze.&r"
	]
	quest.7932AF6110364BFA.quest_subtitle: "Kamień milowy"
	quest.7932AF6110364BFA.title: "&6{block.mekanism.digital_miner}"
	quest.795258F1A054C82D.quest_desc: ["Obraca przyklejoną konstrukcję wokół swojej osi. Tak powstają obrotowe drzwi, zwodzone mosty i karuzele."]
	quest.796280A902728961.quest_desc: ["Powstaje z silnika parowego Create i tak jak on łączy się z wałem. Jeden zastąpi kilka mniejszych silników."]
	quest.797A764F7E47FBEB.quest_desc: ["Przejdź przez portal do świata pod wiecznym gwiazdozbiorem. Z tutejszego nieba spadają meteory."]
	quest.797A764F7E47FBEB.quest_subtitle: "Kamień milowy"
	quest.797A764F7E47FBEB.title: "&aEternal Starlight"
	quest.797FA3A5C3DAD91E.quest_desc: ["Karczmy Dungeons and Taverns stoją w wielu biomach, każda w swoim stylu. Odpocznij i przeszukaj skrzynie."]
	quest.797FA3A5C3DAD91E.title: "Karczma"
	quest.798EC37B651641C6.quest_desc: ["Każde gniazdo plecaka mieści więcej przedmiotów niż zwykły stos. Przepis wymaga bloku miedzi."]
	quest.799A2FD189BF1CDB.quest_desc: ["Postawiony na ziemi powoli zamienia się w żyzną glebę. Uprawy rosną na niej szybciej, a grzyby rozrastają się w kolonie."]
	quest.799AE47C73D2A173.quest_desc: ["Drugi element zbroi z łusek, do pary z tuniką z rozdziału ery. Chroni lepiej niż żelazo."]
	quest.79A0D70C3A82A445.quest_desc: [
		"&7Ekwipunek: coś do szybkiego ruchu, bo strażnik przyciąga i wysysa życie.&r"
		"Czeka na szczycie Final Terminal w Endzie. Przyzwie go kapliczka pustki, gdy włożysz do niej cztery odłamki: &c{item.goety.void_shard}&r."
	]
	quest.79A0D70C3A82A445.quest_subtitle: "Boss"
	quest.79A0D70C3A82A445.title: "&c{entity.goety.ender_keeper}"
	quest.79B036A2062959C8.quest_desc: ["Leży w skrzyniach kowali, płatnerzy i zbrojmistrzów w wioskach. Na kuźni obniża o jedną czwartą koszt doświadczenia, a w piecu Clibano pozwala tworzyć nowe stopy."]
	quest.79CCF42D66CA59A7.quest_desc: [
		"×2: komora wzbogacania robi z rudy dwa pyły. ×3: komora oczyszczająca z tlenem – trzy grudki. ×4: komora wtrysku z chlorowodorem – cztery odłamki. ×5: rozpuszczanie, płukanie i krystalizacja – pięć kryształów."
		"Każdy stopień dokłada maszyny przed poprzednim, więc linię rozbudowujesz od końca."
	]
	quest.79CCF42D66CA59A7.title: "Drabina przerobu rud"
	quest.79E3F1B96B9E80DA.quest_desc: [
		"{block.tfmg.coke_oven} zamienia węgiel w koks i kreozot. Koks zmielony w kołach kruszących to paliwo wielkiego pieca, a kreozot grzeje nagrzewnicę i utwardza deski."
		""
		"&7Budowę pieca pokazuje Ponder (W).&r"
	]
	quest.79E3F1B96B9E80DA.title: "Koks"
	quest.7A02EB97A55E6231.quest_desc: ["Netherytowy miecz przekuty z echem pustki i mrocznym stopem. Prawym przyciskiem w biegu doskakujesz do celu, a bez biegu odskakujesz; pełny zamach wypuszcza ostrze wiatru. Echo zostawia {entity.goety.ender_keeper} z drzewa ery atomu."]
	quest.7A02EB97A55E6231.quest_subtitle: "Kamień milowy"
	quest.7A02EB97A55E6231.title: "&d{item.goety.blade_of_ender}"
	quest.7A0EACD29B6D5D9A.quest_desc: ["Napełnij go dowolnym płynem w wylewce i spryskaj wrogów. Z zapalniczką zamieni paliwo w strumień ognia."]
	quest.7A15DC408124E3E3.quest_desc: ["Kredą rysujesz na ziemi runę. Zaklęcie z glifem runy zostaje w niej i uderza w pierwszego stwora, który na nią wejdzie."]
	quest.7A16CA00A46707DE.quest_desc: [
		"Piła wytnie z pni formy w kilku rozmiarach. Każda część działa – komora, lufa, tylec, zamek – ma własną formę, a JEI pokaże, której potrzebujesz (U na formie)."
		""
		"&7Ponder (przytrzymaj W nad przedmiotem) pokaże cały proces.&r"
	]
	quest.7A16CA00A46707DE.title: "Formy odlewnicze"
	quest.7A2B4AEFB55D3CB2.quest_desc: [
		"&7Era atomu · zalecana szybka ucieczka: strażnik przyciąga i wysysa życie&r"
		""
		"Endersenci, olbrzymie endermany Goety, gubią odłamki pustki. Cztery włożone do kapliczki pustki w Endzie przywołają strażnika."
	]
	quest.7A2B4AEFB55D3CB2.title: "Odłamki pustki"
	quest.7A3F681F467348EA.quest_desc: ["Rozlewa zawartość po całym celu. Woda ugasi pożar, a lawa… sam zobaczysz."]
	quest.7A4F61BCD0C385EF.quest_desc: ["Rudę mitrylu wykopiesz głęboko pod ziemią netherytowym kilofem. Piec hutniczy da z niej skrawki, a dziewięć skrawków to sztabka."]
	quest.7A50644B521C28CE.quest_desc: ["Dowód automatyzacji: 256 sztabek stali nieba. Powstają w lawie z naładowanego certusa, żelaza i kamienia nieba. Płaszczyzny formująca i anihilacji nad lawą zrobią to bez ciebie."]
	quest.7A50644B521C28CE.title: "Huta stali nieba"
	quest.7A543BA189EDB4F4.quest_desc: ["Podziemna grota obrośnięta cierniami. Kwiat próżni nie rusza się z miejsca, ale miota ostrymi płatkami i wypuszcza zarodniki, więc nie stój blisko."]
	quest.7A543BA189EDB4F4.title: "Grota kwiatu próżni"
	quest.7A6DDEAE5690238F.quest_desc: ["Cięższe odpowiedniki miedzianych zbiorników i pomp Create. Ze stalowych zbiorników zbudujesz też wieżę destylacyjną i kadź chemiczną."]
	quest.7A6DDEAE5690238F.title: "Stalowe zbiorniki i pompy"
	quest.7A875C04743BEF62.quest_desc: [
		"Za zasłoną świata żyją duchy i demony, które da się przywołać, związać i zaprząc do pracy. Okultyści kreślą pentakle kredą, alchemicy dusz nasycają stal duchami, a nekromanci zbierają dusze poległych. Każda z tych dróg prowadzi w końcu do Netheru."
		""
		"Era kończy się bramą. Wymaga ona kamieni milowych z gałęzi tego rozdziału, dwóch różnych bossów tej ery i Pieczęci Ery Pary i Stali."
	]
	quest.7A875C04743BEF62.quest_subtitle: "Duchy, dusze i rytuały"
	quest.7A875C04743BEF62.title: "Era Okultyzmu"
	quest.7A89A0AD1EC3F0BF.quest_desc: ["W ukrytym skarbcu katakumb Iron's Spellbooks leży zwój zaklęcia „&d{spell.gametechbcs_spellbooks.call_forth_the_dead_king}&r”. Gdy je rzucisz, pojawi się &c{entity.gametechbcs_spellbooks.hard_dead_king}&r."]
	quest.7A89A0AD1EC3F0BF.title: "Katakumby"
	quest.7AAB10F19BF64E12.quest_desc: ["Na stacji złożysz pociąg i wyznaczysz przystanki. Postaw ją przy torze i nadaj jej nazwę w menu."]
	quest.7AAFA8E8BFFF7FBC.quest_desc: ["Gdy budowniczy postawi ratusz na poziomie 1, kolonia rusza naprawdę. W tej erze budynki rosną do poziomu 2."]
	quest.7AAFA8E8BFFF7FBC.quest_subtitle: "Kamień milowy"
	quest.7AAFA8E8BFFF7FBC.title: "&3Ratusz"
	quest.7AC703A20EAA84AE.quest_desc: [
		"Klejnoty wypadają z potworów i leżą w skrzyniach. Osadzony w gnieździe broni albo zbroi daje premię zależną od rodzaju i czystości klejnotu; jak go osadzić, pokaże JEI."
		""
		"&7Kolejny tier zaklinania pojawi się tutaj, gdy twoja drużyna wejdzie w erę run.&r"
	]
	quest.7AC703A20EAA84AE.title: "Pierwszy klejnot"
	quest.7AE185395A600437.quest_desc: ["Kolejna budowla Incendium. Piglinom oddasz złoto w zamian za przedmioty z Netheru."]
	quest.7AE185395A600437.title: "Wioska piglinów"
	quest.7B013EE897E11551.quest_desc: ["Ruiny piglinów pełne złota i skrzyń. W skrzyniach znajdziesz &a{item.minecraft.netherite_upgrade_smithing_template}&r, potrzebny do netherytu w następnej erze."]
	quest.7B013EE897E11551.title: "Pozostałość bastionu"
	quest.7B1C0B8730481FDE.quest_desc: ["Chwytacz kwantowy ulepszony na czwartym poziomie kuźni gwiazdą Netheru i trzema kawałkami gwiezdnolitu. Zamknie w sobie nawet bossa."]
	quest.7B321B4B3A7721CC.quest_desc: [
		"Dowód automatyzacji: 256 kartonów. Pulpę z drewna i papieru zrobisz w mikserze, a karton z niej pod prasą. Pakowacze w erze mosiądzu zużywają karton na każdą paczkę."
		""
		"&7Kolejny tier logistyki pojawi się tutaj, gdy twoja drużyna wejdzie w erę mosiądzu.&r"
	]
	quest.7B321B4B3A7721CC.title: "Zapas kartonu"
	quest.7B3C4B4EE700EF2E.quest_desc: ["Silnik Stirlinga daje obrót z ciepła palnika pod spodem: stały pali przedmioty, a płynny paliwo z rury. Bez ciepła silnik staje."]
	quest.7B3C4B4EE700EF2E.title: "Silnik Stirlinga"
	quest.7B472916B8B3515D.quest_desc: [
		"Krzemień i miedź zaprowadziły cię daleko, ale ręce mają swoje granice. Rzeka i wiatr mogą pracować za ciebie: wystarczy wał, koło i garść stopu andezytu."
		""
		"Era kończy się bramą. Wymaga ona kamieni milowych z gałęzi tego rozdziału i Pieczęci Ery Run."
	]
	quest.7B472916B8B3515D.quest_subtitle: "Pierwsze maszyny"
	quest.7B472916B8B3515D.title: "Era Andezytu"
	quest.7B64099E5629EAAA.quest_desc: ["Opuść linę krążka na ponad 200 bloków w dół. Zaczynasz na powierzchni, a kończysz przy samym dnie świata."]
	quest.7B64099E5629EAAA.title: "Studnia bez dna"
	quest.7B71184C39C5C508.quest_desc: ["Zejdź poniżej poziomu 0, aż trafisz na &a{block.minecraft.deepslate}&r. Tam leżą lazuryt i geody."]
	quest.7B71184C39C5C508.quest_subtitle: "Kamień milowy"
	quest.7B71184C39C5C508.title: "&aW głąb ziemi"
	quest.7B740AD0D7800932.quest_desc: ["Kolejny poziom: więcej bloków naraz i większa trwałość. Od tej różdżki warto zakładać szablony."]
	quest.7B7AF912990B88C4.quest_desc: ["Szkarłatny las, spaczony las, dolina dusz i bazaltowe delty. Odwiedź wszystkie cztery."]
	quest.7B7AF912990B88C4.title: "Cztery krainy"
	quest.7B8330C327817EA8.quest_desc: ["Prawie cała podwójna skrzynia na plecach."]
	quest.7B8AA5496ED950D6.quest_desc: ["Wyrzutnia z witherytu połączona z rdzeniem pustki na kowadle fuzji. Strzela pociskami pustki."]
	quest.7B9F90C111570883.quest_desc: ["Postaw złotą skrzynię albo podnieś poziom istniejącej ulepszeniem i przyjrzyj się jej przez chwilę. Mieści dużo więcej i ma więcej gniazd na ulepszenia."]
	quest.7B9F90C111570883.quest_subtitle: "Kamień milowy"
	quest.7B9F90C111570883.title: "&bZłota skrzynia"
	quest.7BAAA10F1FA5A9A2.quest_desc: ["Zbierz go pustą butelką z fioletowej chmury, którą smok zieje na wyspie. Przyda się w miksturach i rytuałach."]
	quest.7BADFFCFB17142E5.quest_desc: ["Złoże toru leży w Overworldzie. Mikser rozmnoży tor z kamieniem i gliną, a koła kruszące zrobią z niego tor radioaktywny – paliwo reaktora."]
	quest.7BBD147946A9A03F.quest_desc: [
		"Na pentaklu afrita z szarej, limonkowej, pomarańczowej, czerwonej i białej kredy przywołaj go do kruszenia. Afrit jest szybszy i wydajniejszy niż djinni."
		""
		"&7Kolejny tier Occultism pojawi się tutaj, gdy twoja drużyna wejdzie w erę arkanów.&r"
	]
	quest.7BBD147946A9A03F.quest_subtitle: "Kamień milowy"
	quest.7BBD147946A9A03F.title: "&dAfrit kruszący"
	quest.7BC43F3F809F769A.quest_desc: [
		"&7Ekwipunek: tarcza i szybka broń.&r"
		"Dostojnik illagerów z Goety. Przyzwiesz go mrocznym zwojem użytym w leśnej rezydencji."
	]
	quest.7BC43F3F809F769A.quest_subtitle: "Boss"
	quest.7BC43F3F809F769A.title: "&c{entity.goety.vizier}"
	quest.7BCDAACC3077F8E2.quest_desc: ["Ostatni piedestał pieczęci. Diament wykopiesz żelaznym kilofem."]
	quest.7BCDAACC3077F8E2.quest_subtitle: "Składnik pieczęci"
	quest.7BD66FE3C07F928C.quest_desc: ["Rosną na świecących pnączach w kwitnących jaskiniach. Nadają się do jedzenia."]
	quest.7BF870C923925736.quest_desc: [
		"&7Era mosiądzu · zalecane: diamentowa zbroja&r"
		"Ptak słońca rządzi plemieniem Umvuthana. Jego gaj znajdziesz na sawannie, strzeżony przez zamaskowanych wojowników."
	]
	quest.7BF870C923925736.quest_subtitle: "Boss"
	quest.7BF870C923925736.title: "&c{entity.mowziesmobs.umvuthi}"
	quest.7C034B8DAFC220D1.quest_desc: [
		"Ustawia filtr i priorytet złącza kabla. Rudy trafią do jednej skrzyni, a drewno do drugiej."
		""
		"&7Kolejny tier magazynu pojawi się tutaj, gdy twoja drużyna wejdzie w erę arkanów.&r"
	]
	quest.7C0419F3F94DD5BF.quest_desc: ["Mieści tyle co podwójna skrzynia. Nazwij je w kowadle, a pulpit pokaże tę nazwę jako osobną zakładkę."]
	quest.7C0C8BAF017D0344.quest_desc: ["Granice (szkoła żelaza) działają wokół postawionego kręgu i co chwilę pobierają manę: alarm, wysysanie życia, cięższa grawitacja, ściany z ziemi. Włączasz je prawym przyciskiem albo redstonem."]
	quest.7C0C8BAF017D0344.title: "Zwój granic"
	quest.7C297BF0580ADE8F.quest_desc: ["Łączy łącza z kontrolerem i blokuje wybrane gniazda skrzyni na jeden przedmiot."]
	quest.7C665CA0706A00E7.quest_desc: [
		"Pustym ładowaczem chunków (Chunk Loader) z Create: Power Loader kliknij ghasta w Netherze, a zamkniesz go w środku. Napędzany ładowacz utrzymuje wczytany swój chunk, nawet gdy nikogo nie ma w pobliżu, ale za wolny obrót go wyłącza."
		""
		"&7Ponder (przytrzymaj W nad przedmiotem) pokaże, jak to działa.&r"
	]
	quest.7C8B96D5164FDF2A.quest_desc: ["Esencje ochrony, przywoływania i manipulacji też powstają w komorze nasycania. Bez nich nie zrobisz amuletów, przekaźników ani tabliczek rytuałów."]
	quest.7C8B96D5164FDF2A.title: "Esencje szkół"
	quest.7C93095788D8449C.quest_desc: [
		"Głęboko pod ziemią leży Płacząca studnia (Weeping Well), wypełniona pierwotną zupą pustki. Przedmioty wrzucone do zupy pustka zamienia w nowe, a zbyt długa kąpiel w niej szkodzi."
		""
		"&7Co pustka zrobi z danym przedmiotem, pokaże JEI.&r"
	]
	quest.7C93095788D8449C.title: "Płacząca studnia"
	quest.7CB920BAAB3079B9.quest_desc: ["Wixie wytwarza przedmioty i warzy mikstury za źródło. Amulet użyty na kotle przywoła ją do pracy."]
	quest.7CD914D2D3A9716F.quest_desc: ["Świątynia z anielskiego kamienia na chmurach. Walkirie bronią wejścia, a ich królowa stanie do walki, gdy pokażesz jej dziesięć medali zwycięstwa."]
	quest.7CD914D2D3A9716F.title: "Srebrny loch"
	quest.7CDA679033AA642E.quest_desc: ["Pokonaj jednego z władców mórz. Jego trofeum trafi do Pieczęci Finału."]
	quest.7CDA679033AA642E.quest_subtitle: "Kamień milowy"
	quest.7CDA679033AA642E.title: "&c{entity.cataclysm.the_leviathan} lub {entity.cataclysm.scylla}"
	quest.7CF24A714E10B089.quest_desc: ["Wiertło kruszy blok przed sobą, nawet obsydian, którego żelazny kilof nie ruszy. Na ruchomej maszynie z łożyskiem albo tłokiem wydobywa całe ściany."]
	quest.7CFF1792EC24E0D4.quest_desc: [
		"Pręty reaktora, podajnik paliwa i odpowietrznik ciepła w obudowie reaktora. Odpowietrznik oddaje ciepło do rur, a te zasilą grzałki kotłów."
		""
		"&cReaktor promieniuje: zamknij go w obudowie i szkle reaktorowym. Ciepło musi mieć odbiorcę, inaczej reaktor się stopi.&r"
	]
	quest.7CFF1792EC24E0D4.quest_subtitle: "Kamień milowy"
	quest.7CFF1792EC24E0D4.title: "&6Reaktor torowy"
	quest.7D20C0CDDB6F6D9D.quest_desc: ["Kowadło z iesnium, ulepszone w rytuale marida. Zalety wobec zwykłego kowadła opisuje słownik duchów."]
	quest.7D2D00BD3856EE8C.quest_desc: ["Ciężki topór Maledictusa z czarnej stali i cursium."]
	quest.7D3498FA69E02F5D.quest_desc: ["Głęboki zamarznięty ocean pokryty lodowymi ścianami. Tu mieszkają stwory Aquamirae."]
	quest.7D3498FA69E02F5D.title: "Lodowy Labirynt"
	quest.7D443D5346F93ADE.quest_desc: [
		"&7Era mosiądzu · zalecana diamentowa zbroja i ciepłe ubranie&r"
		""
		"Labirynt lodowych ścian pokrywa głęboki zamarznięty ocean, a wśród nich stoją wraki pirackich statków. Tu duch kapitan Kornelii odpowie na róg z muszli."
	]
	quest.7D443D5346F93ADE.title: "Lodowy Labirynt"
	quest.7D5DAB7F8619B6B6.quest_desc: ["Jego strzały same skręcają w stronę najbliższego wroga."]
	quest.7D7DFD8C579728E3.quest_desc: ["Eliksir uniku z perły Endu, dębowej skóry z dębowego pnia albo niewidzialności z kamienia oczyszczenia. Każdy uwarzysz w kotle alchemika."]
	quest.7D7DFD8C579728E3.title: "Eliksir alchemika"
	quest.7DA6E0E2950FE297.quest_desc: [
		"Zbiór plonów, ścinanie drzew i podnoszenie przedmiotów to glify pierwszego poziomu, które zna już księga nowicjusza. Połączone z niszczeniem zastąpią narzędzia."
		""
		"&7Glif poznasz, gdy po zrobieniu go użyjesz go (PPM).&r"
	]
	quest.7DA6E0E2950FE297.title: "Glify do pracy"
	quest.7DC4DB997C462180.quest_desc: [
		"Przytrzymaj lewy Alt („{key.effortlessbuilding.open_radial_menu}”), a pojawi się koło trybów budowania. Wskaż tryb myszą i puść klawisz."
		"W trybie kształtu pierwsze kliknięcie wyznacza początek, a kolejne go domykają. Podgląd pokaże bloki, zanim je postawisz."
		""
		"&7Ile bloków postawisz naraz, zależy od ustawień serwera.&r"
	]
	quest.7DC4DB997C462180.title: "Menu trybów"
	quest.7DC67F351CDCAD4D.quest_desc: ["Napędzana przez Create robi ze sztabek pręty, a z arkuszy druty. Od niej zaczyna się instalacja elektryczna z Crafts \\& Additions."]
	quest.7DEE64F639D186B5.quest_desc: ["Wykonuje przepisy rzemieślnicze ze wzorów, które przyśle mu dostawca. Postaw go tuż przy dostawcy."]
	quest.7E16A6FC1B86D393.quest_desc: ["Pokonaj jeszcze jednego bossa tej ery, innego niż Wither i rękawica. Pasuje każdy z pozostałych czterech, a jego trofeum też trafi do pieczęci."]
	quest.7E16A6FC1B86D393.quest_subtitle: "Kamień milowy"
	quest.7E16A6FC1B86D393.title: "&cDrugi boss ery"
	quest.7E16DA225FB32520.quest_desc: ["Piec alchemika z tabliczką Animata. Potraja wydajność rud, rozbiera kule i runy wzmocnione, a z Tau destyluje słabe odłamki krwi."]
	quest.7E24593CF5742FB5.quest_desc: ["Mączka kostna z tajemnym pyłem. Posyp nią pole uprawne, a stanie się magicznym polem, które podwaja plony."]
	quest.7E24593CF5742FB5.title: "Magiczne pole"
	quest.7E3476D9377E1B4C.quest_desc: [
		"Aether to wyspy zawieszone nad chmurami. Ta strona prowadzi przez jego krainy, surowce i lochy; bossowie są w drzewie ery pary i stali."
		""
		"&7Uważaj na krawędzie wysp: pod nimi są tylko chmury i pustka.&r"
	]
	quest.7E3476D9377E1B4C.title: "Wyspy w chmurach"
	quest.7E4031A8DD63D3DC.quest_desc: ["Dowód automatyzacji: 256 oczyszczonego kamienia dusz. Koła kruszące rozdrobnią rudę, a płukanie wiatrakiem przez wodę da z każdej porcji dwie sztuki."]
	quest.7E4031A8DD63D3DC.title: "Kamień dusz z taśmy"
	quest.7E44769AB8382CDE.quest_desc: ["Cegły Netheru, pręt płomienia, mikstura i biblioteczka. Piekielne półki podnoszą Eternę ponad zwykłe 15 i dodają Quanty: stół zaklnie na poziomie około 45."]
	quest.7E44769AB8382CDE.quest_subtitle: "Kamień milowy"
	quest.7E44769AB8382CDE.title: "&d{block.apothic_enchanting.hellshelf}"
	quest.7E510C892B528E5E.quest_desc: ["Ruda lazurowego srebra leży w Endzie. To podstawa ostatnich stopów Silent Gear."]
	quest.7E58188A86F2022D.quest_desc: [
		"Pierścienie z mitrylu skracają odnawianie, przyspieszają rzucanie, dodają many albo chronią przed żywiołem. Nosisz je w gniazdach na pierścienie."
		""
		"&7Kolejny tier Iron's Spells pojawi się tutaj, gdy twoja drużyna wejdzie w erę atomu.&r"
	]
	quest.7E58188A86F2022D.title: "Pierścień maga"
	quest.7E8E8E6098F09484.quest_desc: ["Broń Scylli z łzy i esencji burzy. Astrape ciska włócznią piorunów, a Ceraunus rzuca kotwicą i podczas skradania wzbudza fale."]
	quest.7E8E8E6098F09484.title: "Broń burzy"
	quest.7E93624FCC714F4B.quest_desc: ["Spójrz na ścianę i kliknij: różdżka dołoży cały rząd bloków po stronie, na którą patrzysz. Bloki bierze z ekwipunku, także z shulkerów i worków."]
	quest.7E94F4BB35D0DFE1.quest_desc: ["Budowniczy prosi o materiały i narzędzia. Otwórz jego prośby i oddaj to, czego brakuje, przyciskiem w oknie próśb."]
	quest.7E94F4BB35D0DFE1.title: "Prośby budowniczego"
	quest.7E98DB729D8F2B36.quest_desc: [
		"Gdy zdobędziesz kamienie milowe tej ery, oddaj &6Pieczęć Ery Run&r. Cała twoja drużyna wejdzie w erę run, a pieczęć przepadnie."
		""
		"Pieczęć zmieszasz w &6mechanicznym mikserze&r nad tyglem, bez podgrzewania: 4 lazuryty, 4 odłamki ametystu, 2 sztabki złota, szmaragd, butelka z doświadczeniem, andezytowa obudowa i 500 mB miodu."
		""
		"&7Dokładny przepis zobaczysz w JEI: najedź na pieczęć i wciśnij R.&r"
	]
	quest.7E98DB729D8F2B36.quest_subtitle: "Oddaj pieczęć"
	quest.7E98DB729D8F2B36.title: "Brama: Era Run"
	quest.7EBB07EE0E2AA50A.quest_desc: [
		"Ta strona to Nether od strony podróżnika: krainy, surowce i budowle. Krajobraz przebudowuje tu Incendium, a budowle dokładają Moog's i Dungeons and Taverns."
		""
		"&cNie śpij w Netherze w łóżku: wybuchnie.&r"
	]
	quest.7EBB07EE0E2AA50A.title: "Po drugiej stronie portalu"
	quest.7EE6274B35D74035.quest_desc: ["Wejdź do Undergarden: ciemnej krainy pod światem, pełnej grzybów i zgnilizny. Weź dużo światła."]
	quest.7EE6274B35D74035.quest_subtitle: "Kamień milowy"
	quest.7EE6274B35D74035.title: "&aUndergarden"
	quest.7F123C501181DCEE.quest_desc: ["Odczynnik z Tabula Vitae jako podstawa i tabliczka jako katalizator. Źródło wody kosztuje 100 esencji, a lawy 1000."]
	quest.7F123C501181DCEE.title: "Sigile wody i lawy"
	quest.7F14F4FE3911EE51.quest_desc: ["Piła to drugie narzędzie do cięcia pni na deski i jeden ze składników pieczęci."]
	quest.7F14F4FE3911EE51.quest_subtitle: "Składnik pieczęci"
	quest.7F180C322BC884E0.quest_desc: ["Biomes O' Plenty dokłada do Netheru gęste poszycie i kryształowe rozpadliny."]
	quest.7F180C322BC884E0.title: "Nether z Biomes O' Plenty"
	quest.7F25DF42B3C355B1.quest_desc: ["Kolonia z dwudziestoma pięcioma mieszkańcami to już mała wioska. Pamiętaj o domach i jedzeniu dla nowych."]
	quest.7F25DF42B3C355B1.title: "Dwudziestu pięciu mieszkańców"
	quest.7F2F64FF607A4878.quest_desc: ["Każdy kolejny komponent zużywa poprzedni i mieści cztery razy więcej. Komórki 16M wystarczą na całą erę."]
	quest.7F2F64FF607A4878.title: "Większe komórki MEGA"
	quest.7F5D428A8D4A9A66.quest_desc: ["Zamek szybkostrzelny ładujesz od tyłu pociskiem i dużym nabojem, bez ładownicy, więc działo strzela znacznie częściej. Duży nabój z łuską zastępuje ładunki prochowe."]
	quest.7F5D428A8D4A9A66.title: "Szybkostrzelne działo"
	quest.7F8003F7657EF927.quest_desc: ["Terminal w kieszeni. Włóż go na chwilę do gniazda punktu dostępowego, a połączy się z siecią. Ładujesz go w ładowarce."]
	quest.7F828C6C83F055B8.quest_desc: [
		"Rytuał wzywa niezwiązanego afrita, który od razu atakuje. Pokonany zostawia esencję."
		"&cAfrit zieje ogniem: przygotuj odporność na ogień.&r"
	]
	quest.7F856B05E89CB906.quest_desc: ["Najmocniejsza z różdżek Building Wands. Ulepsz diamentową różdżkę na stole kowalskim szablonem ulepszenia netherytowego i sztabką netherytu."]
	quest.7FB29C7AEAB6F537.quest_desc: ["Ściany z plastrów, zapylone pola, kwietne łąki i kryształowy kanion. Odwiedź wszystkie cztery."]
	quest.7FB29C7AEAB6F537.title: "Krainy ula"
	quest.7FEFC5EF97EC721E.quest_desc: [
		"&7Era mosiądzu · zalecana diamentowa zbroja i tarcza&r"
		""
		"Inwokator czeka w leśnym dworze. Przyzywa kły spod ziemi i dręczycieli, a gdy robi się gorąco, teleportuje się po komnacie. Tarcza zatrzyma kły."
	]
	quest.7FEFC5EF97EC721E.title: "Pan leśnego dworu"
	reward.0A17EAACB1D9D8C2.title: "Cała drużyna wchodzi w Erę Andezytu"
	reward.22580F9A7AFABBE2.title: "Cała drużyna wchodzi w Erę Run"
	reward.42B657F536D67EDE.title: "Cała drużyna wchodzi w Finał"
