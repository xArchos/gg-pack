	image.794F9752C05522BD.title: "&6Tools and Metals"
	image.795A85F9092E251C.title: "&6Steam and Steel Era · TFMG electricity"
	image.7962519EBA21B162.title: "&6Tier II · Brass Era · pulses and displays"
	image.79DCDE8A4B01DC91.title: "&6Steam and Steel Era · Diesel Generators fuels"
	image.79F8EA3FACF3C89D.title: "&3Tier V · Steam and Steel Era · Level 4"
	image.7A226B41D494B498.title: "&b&lTom's Simple Storage"
	image.7A4722EE1295CEF6.title: "&6Tier I · Steam and Steel Era · Create Propulsion"
	image.7A77B264A9180EFF.title: "&6Brass Era · schedules and signals"
	image.7A9785F8BDCA567E.title: "&b&lDimensional Storage"
	image.7B05EF8845ED5278.title: "&aFood and Bees"
	image.7B2C7C96D8262FE0.title: "&6Tier II · Andesite Era"
	image.7B9269F039407AEE.title: "&dTier II · Arcane Era · Boss Robes"
	image.7BACC1E35E4AFF3A.title: "&d&lIron's Spells"
	image.7C250FF25F96E79D.title: "&6Tech: Blast Furnace and Steel"
	image.7CD361BFD4AC525F.title: "&6Electric Era · First machines"
	image.7CE986D3C2BCFC22.title: "&bTier I · Andesite Era · Chests and Barrels"
	image.7CFAE6C9AD69BB39.title: "&dMagic: Nether Fire"
	image.7D80E0D123276AE6.title: "&eTier I · Electric Era · Gadgets"
	image.7D934857E47C3538.title: "&dOccult Era · Arms and Trinkets"
	image.7E01C969E749679D.title: "&6Steam and Steel Era · breeches and loading"
	image.7E19A76D28FE9993.title: "&eBuilding"
	image.7EE7D5052887DFA5.title: "&bTier I · Andesite Era · Vaults"
	image.7F27C877F5784A1B.title: "&dTier II · Atomic Era · Dragon Armour"
	image.7F7291A21370F5BF.title: "&cTier IV · Atomic Era · Eternal Starlight"
	image.7F8707CDEE08F0C5.title: "&aFood"
	image.7F8B35A0714AC453.title: "&eTier II · Brass Era"
	image.7FBCA549E401E472.title: "&6Tier III · Brass Era"
	quest.00011121B86E78A2.quest_desc: ["Blink, Lightning, Summon Undead, Orbit and the other tier-three glyphs fit only in the archmage's book. Make any one of them."]
	quest.00011121B86E78A2.title: "A Tier-Three Glyph"
	quest.000301E694BCB523.quest_desc: ["Decorative blocks: one projects a magic circle, the other fog of a chosen colour and thickness."]
	quest.000301E694BCB523.title: "Projectors"
	quest.001078D0815AC33C.quest_desc: ["Flak rounds burst in the air and shower the target with shrapnel – handy against hostile airships. A tracer tip shows the path of the burst."]
	quest.001078D0815AC33C.title: "Anti-Air Fire"
	quest.0013E40F43A6973D.quest_desc: [
		"A sample drill checks a vein before you build a drilling machine: place it, put a copper backtank with compressed air on top and start it. The ore vein atlas then records the vein's location and contents."
		""
		"&7The vein finder and the drilling machine are in the Steam and Steel Era tree.&r"
	]
	quest.0013E40F43A6973D.title: "Vein Sample"
	quest.00255CAC3A53A55A.quest_desc: [
		"&7Gear: your best armour, elytra or ender pearls.&r"
		"It guards the ruined citadel on the End islands. A &c{item.cataclysm.void_eye}&r points the way."
	]
	quest.00255CAC3A53A55A.quest_subtitle: "Boss"
	quest.00255CAC3A53A55A.title: "&c{entity.cataclysm.ender_guardian}"
	quest.002672FCF24869B1.quest_desc: ["Held in one hand, it now and then charges the device you hold in the other."]
	quest.002F3E5F190A3061.quest_desc: ["Walkways and huts high in the jungle canopy. Mind the fall."]
	quest.002F3E5F190A3061.title: "A Jungle Tree House"
	quest.00404F7D865B29DD.quest_desc: ["A shield of Scylla's lacrima and gold, a keepsake of the storm queen."]
	quest.0041CE6328881222.quest_desc: ["An underground structure full of tombs, traps and undead. The Dead King sleeps at its heart."]
	quest.0041CE6328881222.title: "Catacombs"
	quest.00446FADDFB6CC06.quest_desc: ["A Tabula Spiritus on a tier four altar for 30,000 essence. It turns almost translucent."]
	quest.0047DA873A39FB9F.quest_desc: ["The altar infuses items with spirits: the main ingredient goes on the altar, extra ones on stands nearby, and the spirits into the altar. The next era's seal is made on it too."]
	quest.0047DA873A39FB9F.quest_subtitle: "Milestone"
	quest.0047DA873A39FB9F.title: "&d{block.malum.spirit_altar}"
	quest.005DB109763721B4.quest_desc: ["Thrown like an eye of ender, it leads to the Burning Arena in the Nether, home of Ignis."]
	quest.0071A72D1437A804.quest_desc: ["Draw the djinni pentacle in white, light gray and lime chalk and put metal dusts in the bowls. The djinni crushes ores faster and more efficiently than a foliot."]
	quest.0071A72D1437A804.quest_subtitle: "Milestone"
	quest.0071A72D1437A804.title: "&dDjinni Crusher"
	quest.00796ED2C1ADD673.quest_desc: [
		"A simpler pump from Diesel Generators: a bearing, an arm with a head, a crank and a hole on a straight pipe down to bedrock. Glue it together and take the oil with a pump."
		""
		"&7Ponder (W) on the bearing shows the build order.&r"
	]
	quest.00796ED2C1ADD673.title: "Diesel Generators Pumpjack"
	quest.007C773A6F5EB8A6.quest_desc: [
		"On the runic workbench you carve a spirit into tainted or twisted rock to make a rune. Runes are worn in rune slots, and each grants a lasting bonus, such as health or dexterity."
		""
		"&7The next Malum tier appears here once your team enters the Steam and Steel Era.&r"
	]
	quest.007C773A6F5EB8A6.title: "First Rune"
	quest.008F894F4B06067D.quest_desc: ["Split flint in your inventory crafting grid: one piece gives you two sharp shards."]
	quest.008F894F4B06067D.title: "Flint Shards"
	quest.0091A7FB3AD51AB4.quest_desc: ["The largest magic bag. The recipe needs a nether star from the Wither."]
	quest.0092EB6702CCBCF8.quest_desc: ["The mode menu sets the replace mode ({effortlessbuilding.action.replace_mode}): a shape fills only air, only existing blocks, both, or only blocks matching the one in your offhand."]
	quest.0092EB6702CCBCF8.title: "Replace Mode"
	quest.00A15B1D6BBDC43C.quest_desc: ["A soul sealed in crystal, the Night Lich's spoil. With a void thorn it makes the charged pearl, and later the table of elevation and the staff of suppression."]
	quest.00BF566FCA7096FF.quest_desc: ["The sourcelink turns potions from nearby jars into source. Stronger potions give more."]
	quest.00C0A5479AEB1949.quest_desc: ["The fifth stabilizer tier needs the End: dragonyst dust from dragon's breath and an end crystal, a block of netherite and an enderman sacrifice."]
	quest.00D95988AEFE1CE4.quest_desc: [
		"A press above a basin squeezes its contents into fewer items: flint with gravel makes andesite, and snow makes ice. Andesite from the press feeds your alloy mixer."
		""
		"&7The quest checks the Create advancement for compacting in a basin.&r"
	]
	quest.00D95988AEFE1CE4.title: "Press over a Basin"
	quest.00E1FDB8BE757FE2.quest_desc: ["A warp scroll remembers the spot where you use it (sneak and right-click), and later takes you back there. A plain scroll is used up after one jump."]
	quest.00EA4A45FDD7B10B.quest_desc: ["Craft it from an undead soul, a ghast tear, a bone, rotten flesh and a phantom membrane. Skeleton horses drop the souls."]
	quest.00F12BA90B13DE6F.quest_desc: ["An abandoned forge in the Nether, guarded by the Netherite Monstrosity. Mind the lava around the anvil."]
	quest.00F12BA90B13DE6F.title: "The Soul Blacksmith"
	quest.0102DB2C8864510D.quest_desc: ["A hoe tills soil for your first crops."]
	quest.01170E5700828F01.quest_desc: [
		"You forge the heavy plate from steel by sequenced assembly, and recipes count it as a steel plate. Heavy casings and steel mechanisms need it."
		""
		"&7Check the assembly steps in JEI (R on the item).&r"
	]
	quest.01393990D47C31C0.quest_desc: ["A shell inscribed by the &c{entity.cataclysm.ender_guardian}&r. Use it to learn void spells for Iron's Spellbooks."]
	quest.01423728EDF5A59C.quest_desc: ["Ethene and substrate in a pressurized reaction chamber make HDPE pellets, and the enrichment chamber presses them into a sheet. The plastic goes into the SPS and the MekaSuit."]
	quest.0165DB31B45B1E71.quest_desc: ["This is where you install modules into the MekaSuit and the &6{item.mekanism.meka_tool}&r."]
	quest.018BB091987EA13D.quest_desc: [
		"The Wither leaves a star. Many strong recipes in the pack need it, from the beacon to wand templates."
		""
		"&7The next world boss tier appears here once your team enters the Electric Era.&r"
	]
	quest.018BB091987EA13D.quest_subtitle: "Milestone"
	quest.018BB091987EA13D.title: "&c{item.minecraft.nether_star}"
	quest.01963B8104853A0C.quest_desc: ["The smallest QIO drive. Make it from an ultimate control circuit, an ender pearl and lead."]
	quest.019C1CDD2E5991C4.quest_desc: ["A stick with a battery uses FE instead of durability. Charge it in a charger, such as Mekanism's or AE2's. Install the template with a block of copper."]
	quest.01A9AE1109CC41BA.quest_desc: ["Set what a cell accepts on it and put upgrade cards into the cell, such as fuzzy or overflow destruction."]
	quest.01E135F90DA67028.quest_desc: ["Ancient metal and koboleton bones from the cursed pyramid make the pharaoh's robes or the amber staff. Amber is smelted from the necklace of the desert."]
	quest.01E135F90DA67028.title: "The Pharaoh's Treasures"
	quest.01EEA33AC67E1C6C.quest_desc: ["Pewter and gold inlays are parts of many workbench recipes. The gold one is made from arcane gold."]
	quest.01EEA33AC67E1C6C.title: "Inlays"
	quest.01FE52E353BF9ED7.quest_desc: ["Each antimatter pellet is long hours of SPS work. Four cover the gravitational module, the teleportation module and transmutation in the nucleosynthesizer."]
	quest.01FE52E353BF9ED7.title: "Antimatter Stock"
	quest.0202106104A1819A.quest_desc: ["Each piece is netherite armour with polonium, HDPE, an ultimate circuit and an induction cell. The suit runs on power, and modules give it everything else."]
	quest.0202106104A1819A.quest_subtitle: "Milestone"
	quest.0202106104A1819A.title: "&6MekaSuit"
	quest.020C11EF4965F285.quest_desc: ["Build a train with at least six carriages. Each carriage needs its own bogey, and a long train hauls the whole output of a distant mine."]
	quest.020C11EF4965F285.quest_subtitle: "Milestone"
	quest.020C11EF4965F285.title: "&6Freight Train"
	quest.022200CA61ECF8A2.quest_desc: [
		"Expand a boiler to the highest level. It needs enough water, heat and tank space at once – the weakest of the three sets the level."
		""
		"&7A blaze cake superheats a burner, and a superheated burner gives the boiler more heat.&r"
	]
	quest.022200CA61ECF8A2.quest_subtitle: "Milestone"
	quest.022200CA61ECF8A2.title: "&6Boiler at Full Power"
	quest.02311BEAB8C12444.quest_desc: ["A navigation table with a map or a compass gives redstone signals pointing towards the target. Together with sensors it steers the ship without a helmsman."]
	quest.0234FF67A49B1FBC.quest_desc: ["A dragon's breath catalyst seals this transformation into one block in front of the fan. Nothing spills, and the line runs forever."]
	quest.023D61F619DF3618.quest_desc: ["A satchel with a bound foliot builds a pentacle for you block by block: click the preview from the dictionary and it places the chalk and bowls."]
	quest.02418C71BA9EEFA3.quest_desc: [
		"Once you have this era's milestones, hand in the &6Seal of the Steam and Steel Era&r. Your whole team enters the Steam and Steel Era and the seal is consumed."
		""
		"The seal is made by spirit infusion on the &d{block.malum.spirit_altar}&r: 4 soul stained steel ingots go on the altar, attuned gems, arcane gold, precision mechanisms, a steam engine and two boss trophies on stands nearby, and 16 infernal, 16 arcane and 8 wicked spirits into the altar."
		""
		"&7See the exact recipe in JEI: hover over the seal and press R.&r"
	]
	quest.02418C71BA9EEFA3.quest_subtitle: "Hand in the seal"
	quest.02418C71BA9EEFA3.title: "Gate: Steam and Steel Era"
	quest.026C7E0C1FE4AE08.quest_desc: ["A cast cannon part leaves the mould solid. The cannon drill bores it out with Create power, and only then can it fire."]
	quest.0271DE904705BB3F.quest_desc: ["Limited barrels have one to four compartments, each for one kind of item. The front shows what is inside."]
	quest.02868A4D0CA93AF6.quest_desc: ["The spout fills bottles and buckets below it, on a depot or a belt. It draws fluid from a tank or pipe above it."]
	quest.02891F86D18A850E.quest_desc: ["Place a diamond chest, or raise a gold one, and look at it for a moment. It is almost two double chests in a single block."]
	quest.02891F86D18A850E.title: "Diamond Chest"
	quest.028A1EC6E69AA3FD.quest_desc: ["The altitude sensor gives a signal based on height, and the gimbal sensor one based on tilt. Wire them to burners and propellers and the ship holds its altitude and level by itself."]
	quest.028A1EC6E69AA3FD.title: "Flight Instruments"
	quest.02A29FD113D8D2B7.quest_desc: ["The linked controller is a remote for redstone links: each button transmits on its own frequency. Use it to drive gates, lifts and machines from afar."]
	quest.02A29FD113D8D2B7.title: "Remote Control"
	quest.02E867FFAF07C0C2.quest_desc: ["Dig a pool of water, e.g. 2×2, ring it with flowers and throw a diamond in. When lightning strikes, the pool becomes a portal to the Twilight Forest."]
	quest.02E867FFAF07C0C2.quest_subtitle: "Milestone"
	quest.02E867FFAF07C0C2.title: "&aThe Twilight Forest"
	quest.0306894F1AD242F7.quest_desc: ["Cornelia leaves the key to the frozen chests that stand in the Ice Maze."]
	quest.0326906705A76C0D.quest_desc: [
		"The upgrade ritual: edelwood planks on the forge, 4 arcane crystals and 4 spawner scraps on the pedestals, plus 500 aureal, 6000 blood and 10 souls. Look at the upgraded forge."
		""
		"&7Start the ritual with the blacksmith gavel; JEI (U on the forge) shows every ritual.&r"
	]
	quest.0326906705A76C0D.title: "Forge: tier II"
	quest.034402F79BBE91EE.quest_desc: ["Holds much more and fits several upgrades at once."]
	quest.0350729D2614C31B.quest_desc: ["A lone monolith from Moog's End Structures rises above the void."]
	quest.0350729D2614C31B.title: "The Monolith"
	quest.035995539D6360EB.quest_desc: ["Mercurial copper wires connect nodes with extractors and inserters. This is how you build a network that feeds the apparatus on its own."]
	quest.035995539D6360EB.title: "Wires and nodes"
	quest.035BC5C429692AA8.quest_desc: ["A train won't move without controls: a driver sits at them, or a &6{item.create.schedule}&r drives the train."]
	quest.036CACEE765E308F.quest_desc: ["A dungeon hidden inside an island, guarded by stone sentries. &c{entity.aether.slider}&r waits at its heart."]
	quest.036CACEE765E308F.title: "The Bronze Dungeon"
	quest.037B27FC641245C2.quest_desc: ["The stablemaster raises horses and prepares them for the colony's cavalry."]
	quest.0382C88FA6EA89A4.quest_desc: ["Cloggrum, froststeel and utherium are mined only in the Undergarden. They make weapons and armour for its creatures."]
	quest.0382C88FA6EA89A4.title: "Metals of the Deep"
	quest.0389E6ED26C49BE6.quest_desc: ["Wound a hostile creature with it, and when it falls it leaves Spiritus, the raw matter of souls. Make it in the Tabula Vitae from iron and string."]
	quest.039117A30BF5DFF7.quest_desc: ["Oh The Biomes We've Gone villages stand in that mod's biomes and are built from its wood."]
	quest.039117A30BF5DFF7.title: "A BWG Village"
	quest.03A1986679AAB85A.quest_desc: ["Powdered emerald and fae essence. The circuit holds mana for its owner standing nearby."]
	quest.03A1986679AAB85A.quest_subtitle: "Seal ingredient"
	quest.03A90135230FAC67.quest_desc: ["Assign the farmer as many fields as his hut allows. A higher farm level handles more fields."]
	quest.03A90135230FAC67.title: "Green Thumbs"
	quest.03B546ADD50FAE98.quest_desc: ["Lets you keep backpacks inside the backpack, and their upgrades work together. The recipe needs a nether star."]
	quest.03D49F116F334AA8.quest_desc: [
		"Numpad plus (“{key.effortlessbuilding.open_modifiers_screen}”) opens the modifier settings. The mirror reflects every placed block across an axis, and the array repeats it every few blocks."
		""
		"&7Modifiers also work with normal placing and together with shape modes.&r"
	]
	quest.03D49F116F334AA8.title: "Mirror and Array"
	quest.03E0508560A59D5E.quest_desc: ["A square enclosed by a stone wall is the Naga's arena. It is the first boss of the Twilight Forest: until you defeat it, the further structures stay locked."]
	quest.03E0508560A59D5E.title: "Naga Courtyard"
	quest.03EC0C922F07CE48.quest_desc: ["Deep underground lie copper chambers full of traps and spawners. Keys won in the chambers open vaults with valuable loot."]
	quest.03EC0C922F07CE48.title: "Trial Chambers"
	quest.03FF31B1E703C976.quest_desc: [
		"The Iron's Spells add-ons bring the aero, necro, abyssal and technomancy schools. Their runes are made like any other: a blank runestone and a school focus, such as a breeze rod for aero or an ectoplasm ball for necro."
		""
		"&7The first rune of a new school is also in the Arcane Era chapter.&r"
	]
	quest.03FF31B1E703C976.title: "New Schools of Magic"
	quest.040975B397B3A13B.quest_desc: ["Find the Mowzie's Mobs monastery. {entity.mowziesmobs.sculptor} lives there, guarded by bluffs that drop the {item.mowziesmobs.bluff_rod}."]
	quest.040975B397B3A13B.title: "The Monastery"
	quest.040C8BC00793DFFF.quest_desc: ["Harvests ripe crops around the brazier and puts them into a chest next to it. Every harvest costs a little source."]
	quest.040E6644D17A97BE.quest_desc: ["Arcane essence turns up in chests of dungeons and magic structures. Two go on the pedestals for the Seal of the Brass Era."]
	quest.040E6644D17A97BE.quest_subtitle: "Seal ingredient"
	quest.04145E4A116003C8.quest_desc: [
		"A foundry lid on a basin over a blaze burner melts cast iron, bronze or steel. Pour the molten metal into a cannon mould sawn from logs; casting also needs casting sand."
		""
		"&7Ponder (W) on the lid shows the whole cast.&r"
	]
	quest.04145E4A116003C8.title: "Cannon Foundry"
	quest.042B57FBDF439B9F.quest_desc: ["Gold ore needs an iron pickaxe. Two ingots go into the Seal of the Rune Era."]
	quest.042B57FBDF439B9F.quest_subtitle: "Seal ingredient"
	quest.042B57FBDF439B9F.title: "Gold"
	quest.04610C7144030208.quest_desc: ["Diamond and emerald veins give raw gems instead of finished ones. JEI shows how to process them (U on the item)."]
	quest.04610C7144030208.title: "Gems from the Deep"
	quest.047BE867076E0079.quest_desc: ["Automation proof: 256 flour. Let a belt or funnel feed wheat into the millstone and the flour go into a container on its own."]
	quest.047BE867076E0079.title: "Mill at Full Speed"
	quest.047E1B3DE2EEDC63.quest_desc: ["The ancient codex of netherite, a blood vial, a bottle o' lightning, arcane cloth and a ruined book from the Citadel shelves. Cook a creature in a cauldron over a campfire for blood."]
	quest.0499EEF40E246643.quest_desc: ["The drive holds ten storage cells and shares their contents with the whole network. Make it from an engineering processor and a fluix cable."]
	quest.04A36EF3F26D6261.quest_desc: ["Roofs in many shapes, of wood, stone and thatch, with gutters to match. Make the stone ones in a stonecutter."]
	quest.04A36EF3F26D6261.title: "Roofs"
	quest.04BAB86ABD1C5247.quest_desc: ["Summons a foliot that carries items from one container to another. Point it at the source and target chests with the book."]
	quest.04C1A2A7B07CEF10.quest_desc: [
		"&7Brass Era · recommended: diamond armor&r"
		"The Night Lich waits at the top of its tower in cold biomes. It fights from range, so don't stand still."
	]
	quest.04C1A2A7B07CEF10.quest_subtitle: "Boss"
	quest.04C1A2A7B07CEF10.title: "&c{entity.bosses_of_mass_destruction.lich}"
	quest.04D7BE861AE65A1C.quest_desc: ["Attach sail frames or sails to a &6{block.create.windmill_bearing}&r and assemble the windmill by right-clicking the bearing. More sails give more power."]
	quest.04D7BE861AE65A1C.title: "Windmill"
	quest.04D971B1C660D665.quest_desc: ["The spell book of GTBC's Spellbooks: netherite, holy and nature runes, arcane cloth and an enchanted book. This add-on also brings the Enraged Dead King of the Transcendent Era chapter."]
	quest.04F8C98FB6AADB8D.quest_desc: ["Dragon's breath infused in the enchanting table. You cannot build an endshelf without it."]
	quest.04FF02A313E6B726.quest_desc: ["A pattern provider with twice the slots. One machine serves more recipes."]
	quest.0500128DE044D272.quest_desc: ["A shimmering building block from the Aurora Palace. It looks great in icy halls."]
	quest.05011C227070A982.quest_desc: ["While they have power, they prevent fall damage and let you step up a block like a stair."]
	quest.0514AD14D33CB401.quest_desc: ["Naga scales make a chestplate and leggings stronger than iron ones."]
	quest.0541B5D150A9FCFE.quest_desc: ["A blue aercloud launches anyone who jumps on it high into the air. Give it a try."]
	quest.0541B5D150A9FCFE.title: "A Cloud Bounce"
	quest.0545D5FDDC0DD286.quest_desc: [
		"&7Atomic Era · good armour, a shield and healing potions recommended&r"
		""
		"The guardian of the portal ruins tests whether you are worthy of Eternal Starlight. Beyond the portal the golem waits in the Golem Forge and the monstrosity in the maze of the Cursed Garden."
	]
	quest.0545D5FDDC0DD286.title: "Guardians of the Stars"
	quest.0555D4F212A06AA4.quest_desc: ["A capacity card adds filter slots to a bus, and an acceleration card speeds up buses and AE2 machines."]
	quest.0555D4F212A06AA4.title: "Upgrade Cards"
	quest.05BEFB774970E12D.quest_desc: ["Throw a pollen puff at a bee. Once pollinated, it flies off to make honey."]
	quest.05BEFB774970E12D.title: "Pollination"
	quest.05E6B437902A2E17.quest_desc: ["Aim it at the master stone and hold use: it places and inscribes the whole pattern for you. Shift and use cycles the ritual."]
	quest.05EA90F4F047DA04.quest_desc: [
		"At a smithing table, with an eldritch soulshard and a broken legend's staff, you reforge it into an even stronger staff."
		""
		"&7The next magic boss tier appears here once your team enters the Electric Era.&r"
	]
	quest.05F564DFBF04D8E2.quest_desc: ["Hold 512 mercury shards at once. A few distillers fed with cobblestone from a generator will do it without you."]
	quest.05F564DFBF04D8E2.quest_subtitle: "Automation proof"
	quest.05F564DFBF04D8E2.title: "Mercury in Bulk"
	quest.05FC20A15925003A.quest_desc: ["Places random blocks from your hotbar or from a saved palette, so walls and roads don't look like a single block. Make it from a block and an ingot of iron."]
	quest.05FC20A15925003A.quest_subtitle: "Milestone"
	quest.05FC20A15925003A.title: "&e{item.mechtrowel.mech_trowel}"
	quest.06014B067F499DAF.quest_desc: ["An energy store: it takes power in from below and slowly gives it out on top. Building it needs sulfuric acid or lithium."]
	quest.0617F97E8241671D.quest_desc: [
		"A pyromancer robe upgraded on a smithing table with ignitium and its template. Ignis from the Arcane Era chapter drops both."
		""
		"&7More quests on this page appear here once your team enters the Transcendent Era.&r"
	]
	quest.062C848C3DEA7A46.quest_desc: ["A brass cage lamp. Create Deco has such lamps in every metal and with several light colours, and each one responds to redstone."]
	quest.062EC956A271670A.quest_desc: [
		"This page leads through the lands, crops and metals of the Undergarden. The gate and the bosses are in the Electric Era tree."
		""
		"&7Without light you will see nothing here. Bring plenty of torches.&r"
	]
	quest.062EC956A271670A.title: "Below the World"
	quest.062F4E5C811A3750.quest_desc: ["A large colony draws large raids. Thirty guards make a real army."]
	quest.062F4E5C811A3750.title: "30 Guards"
	quest.06401B803DFA50EE.quest_desc: ["Right-click the builder's hut and read the guide. It explains how requests, builds and citizens work."]
	quest.06401B803DFA50EE.title: "The Colony Guide"
	quest.065DB739B1ACFB21.quest_desc: [
		"The ritual looks for the nearest structure you name with an augment on the brazier: a source gem means a wilden den, sandstone a desert temple, an emerald an outpost. The result goes into the wayfinder."
		""
		"&7JEI lists the other augments in the ritual tab.&r"
	]
	quest.0678B9632C6A750F.quest_desc: ["The totem collects the souls of creatures you kill. Goety's dark wand, foci and rituals draw on that energy."]
	quest.0683988BF5F919D4.quest_desc: ["Tame one of the crystallized moths of this dimension."]
	quest.0683988BF5F919D4.title: "A Tamed Moth"
	quest.06901FF8E2DADA42.quest_desc: ["Tame a beehemoth, a giant bee of the hive. You can fly on it."]
	quest.06901FF8E2DADA42.title: "A Tamed Beehemoth"
	quest.0692E81AC7B21B70.quest_desc: ["Pours molten metal downward, up to 5 blocks, for example from the foundry basin onto the casting table. A redstone signal opens it at the right moment."]
	quest.06969DC0098E3AE4.quest_desc: [
		"The cannon builder stacks steel layers of different sizes into a built-up cannon, stronger than a plain cast. The cannon welder joins finished cannon parts into one piece."
		""
		"&7Ponder (hold W over the item) shows the whole process.&r"
	]
	quest.06969DC0098E3AE4.title: "Built-Up Cannon"
	quest.06970327D8662686.quest_desc: ["A cheaper mana circuit: iron replaces the fae essence. Four go into the Seal of the Finale."]
	quest.06970327D8662686.quest_subtitle: "Seal ingredient"
	quest.06A3B68A4AA1800B.quest_desc: ["The vibrator sends tremors into the ground, and the reader shows which blocks lie beneath it down to bedrock."]
	quest.06A3B68A4AA1800B.title: "Seismograph"
	quest.06B7CA3EC95E9756.quest_desc: [
		"Once you have this era's milestones, hand in the &6Seal of the Finale&r. Your whole team enters the Finale and the seal is consumed."
		""
		"Assemble the Seal of the Finale on a &6{block.create.mechanical_crafter}&r in a 5×5 grid from the seven tree badges, 2 mana circuits, 4 magitech circuits, 4 attuned diamonds and the trophies of two bosses of this era. &cThe book does not award the badges yet: the last quests of the Technology, Magic, Storage, Building, World, Bosses and Colony trees will give them.&r"
		""
		"&7See the exact recipe in JEI: hover over the seal and press R.&r"
	]
	quest.06B7CA3EC95E9756.quest_subtitle: "Hand in the seal"
	quest.06B7CA3EC95E9756.title: "Gate: Finale"
	quest.06D13C0B3D3DDA13.quest_desc: ["The amulet of concentration, the heavy chain or the conjurer's talisman, all of mithril. Each supports a different style of spellcasting."]
	quest.06D13C0B3D3DDA13.title: "A Mage's Necklace"
	quest.06D2626F6306AB16.quest_desc: ["Familiar rituals call a spirit in an animal's body that follows you and grants a bonus: the beaver fells trees, the greedy familiar picks up items, the otherworld bird lets you glide. Perform any of them."]
	quest.06D2626F6306AB16.title: "An Occultist's Familiar"
	quest.06F79FAB0A10065F.quest_desc: ["An emerald awakened in the cursed infuser or in the grid with a totem. Most of Goety's devices and foci are built on it."]
	quest.070516E1F061620E.quest_desc: ["An alloy of andesite and tungsten. You mix it over a blaze burner superheated with blaze cake."]
	quest.070717EEFDCBB40F.quest_desc: ["Keeps the chunks around it loaded, so machines work while you are away. Set the area in its window."]
	quest.0707AF284AEA0305.quest_desc: ["The first proper pickaxe of the Aether. While mining it sometimes digs up extra ambrosium shards."]
	quest.070D073F455FB1EA.quest_desc: ["A chassis grabs the blocks around it without glue: the linear one in a row, the radial one all around. A sticker grabs or releases the block in front of it on a redstone signal."]
	quest.070D073F455FB1EA.title: "Chassis and Sticker"
	quest.0711C3097BC281FA.quest_desc: ["The deeplands, the echoing forest, the overcast columns and the blooming caverns. Visit all four."]
	quest.0711C3097BC281FA.title: "Otherside Lands"
	quest.07285A05F8E762F4.quest_desc: ["The Dead King's spell book, stronger than the copper one. Equip it in the spell book slot."]
	quest.07508BE812932CED.quest_desc: ["The next bin tier holds several times more. Make it from the previous one, infused alloy and an advanced circuit."]
	quest.07555AA117CB05DF.quest_desc: ["A filter for a package address. In a funnel or on a belt it sends the package the right way."]
	quest.0762E1C6C8BFC49D.quest_desc: [
		"Technology and magic stop being separate paths. Mahou Tsukai teaches the magic of blood and circles, and your machines will give it strength."
		"The deadliest bosses of Cataclysm wait at the end. There is nothing new left to mine: what counts is what you can do."
		""
		"The era ends at the gate. It requires the milestones of the branches in this chapter and the Seal of the Finale."
	]
	quest.0762E1C6C8BFC49D.quest_subtitle: "The era begins"
	quest.0762E1C6C8BFC49D.title: "Transcendent Era"
	quest.0762E20DA0734934.quest_desc: ["Pillagers raid villages from wooden towers. A loot chest stands at the top of the tower."]
	quest.0762E20DA0734934.title: "Pillager Outpost"
	quest.076AA77AF713C8AB.quest_desc: [
		"&7Arcane Era · your best mage armour and healing potions recommended&r"
		""
		"The Apothic cultists worship a being that passed beyond mortality. {entity.discerning_the_eldritch.ascended_one} awaits a challenge deep in their headquarters."
	]
	quest.076AA77AF713C8AB.title: "The Cultist Headquarters"
	quest.077B5B677987E668.quest_desc: ["Holds a large supply of one kind of block, and the wand draws its material from it. Your inventory won't clog up with stone."]
	quest.07913849E4B00331.quest_desc: ["Hold 256 polished rose quartz at once. By hand that would eat a pile of sandpaper, so let deployers holding sandpaper polish the quartz on a belt."]
	quest.07913849E4B00331.quest_subtitle: "Automation proof"
	quest.07913849E4B00331.title: "Polishing Shop"
	quest.07C42C52F7B47591.quest_desc: ["A chemical infuser combines deuterium and tritium into D-T fuel. It fills the hohlraum for ignition and feeds the reactor while it runs."]
	quest.07C5E55BA72E853C.quest_desc: ["In the Electric Era ordinary colony buildings grow to level 5, the last one. Start with the town hall."]
	quest.07C5E55BA72E853C.title: "Town Hall Level 5"
	quest.07C7216FD4FB73BE.quest_desc: [
		"Create: Central Kitchen joins Create with Farmer's Delight. A blaze burner heats the cooking pot and the skillet, a mechanical arm puts ingredients in and takes finished meals out, and a deployer with a knife or a saw cuts on the cutting board."
		""
		"&7Ponder (W) on these blocks shows the details.&r"
		""
		"&7More quests on this page appear here once your team enters the Steam and Steel Era.&r"
	]
	quest.07C7216FD4FB73BE.title: "Kitchen on a Belt"
	quest.07C866FBAFDBC314.quest_desc: ["A djinni runs a machine for you: it orders ingredients from the dimensional storage and brings back the products."]
	quest.07DCFF3ED36E75AF.quest_desc: ["Hold 256 alchemical salts of any kind at once. Let the calcination oven get its items from a hopper or Theurgy logistics, not from your hand."]
	quest.07DCFF3ED36E75AF.quest_subtitle: "Automation proof"
	quest.07DCFF3ED36E75AF.title: "Salt Works"
	quest.0820DDC5B7E8B24E.quest_desc: ["Wild tomatoes, cabbages and onions grow in different biomes. Gather each and plant them at home."]
	quest.0820DDC5B7E8B24E.quest_subtitle: "Milestone"
	quest.0820DDC5B7E8B24E.title: "&aThree Crops"
	quest.0821899B97FB57F0.quest_desc: ["A compass of gold and amethyst that points the way to a structure found by a ritual. Without the ritual it is just a trinket."]
	quest.0822763050A1A8FF.quest_desc: ["The Sun Spirit leaves an altar. Place it in the Aether to set the time of day there."]
	quest.0822763050A1A8FF.quest_subtitle: "Milestone"
	quest.0822763050A1A8FF.title: "&c{block.aether.sun_altar}"
	quest.0825D1D8E1416DF6.quest_desc: ["Click a placed chest or barrel with it to raise its tier without taking anything out."]
	quest.083B9FA2E9C70D1B.quest_desc: ["Iron, copper or gold bound with arcane essence. It goes into upgrade orbs, rings and mage weapons."]
	quest.083E4A9EC23B31B7.quest_desc: ["A &6{block.create.mechanical_press}&r above a depot or a belt flattens ingots into sheets. Iron sheets go into the whisk, the propeller and many other parts."]
	quest.083E4A9EC23B31B7.quest_subtitle: "Milestone"
	quest.083E4A9EC23B31B7.title: "&6Press and Iron Sheets"
	quest.08428227089A4522.quest_desc: ["Find a village. Villagers trade, and their chests often hold useful loot."]
	quest.08428227089A4522.quest_subtitle: "Milestone"
	quest.08428227089A4522.title: "&aA Village"
	quest.0863DB1B7A0CDFE2.quest_desc: [
		"&7Brass Era · recommended: diamond armor&r"
		"The void blossom has taken root in a hidden underground grotto. You will find it while exploring caves."
	]
	quest.0863DB1B7A0CDFE2.quest_subtitle: "Boss"
	quest.0863DB1B7A0CDFE2.title: "&c{entity.bosses_of_mass_destruction.void_blossom}"
	quest.086782BDD34E90EF.quest_desc: ["Thrown like an eye of ender, it leads to the cursed pyramid in the desert."]
	quest.086925E4AF1564FB.quest_desc: [
		"&7Arcane Era. Recommended gear: your best mage armour and healing potions.&r"
		"The fight takes place deep inside the cultist headquarters. In the seal this boss's trophy can stand in for the Ancient Remnant's."
	]
	quest.086925E4AF1564FB.quest_subtitle: "Boss"
	quest.086925E4AF1564FB.title: "&c{entity.discerning_the_eldritch.ascended_one}"
	quest.0872CA492305EA2F.quest_desc: ["A deployer uses an item like a player would: it applies, clicks and assembles. Mechanical crafters arranged in a grid handle recipes too big for a crafting table, and deployers run sequenced assembly."]
	quest.0872CA492305EA2F.quest_subtitle: "Milestone"
	quest.0872CA492305EA2F.title: "&6Deployer and Mechanical Crafter"
	quest.0876B2C3A61440D3.quest_desc: ["Made with anima and a blazing eye. Placed, it grants creative-style flight in a 7×7 column above it, handy for building."]
	quest.08942447C07DF8F5.quest_desc: [
		"The Wroughtnaut's axe and helm never break. Right-click with the axe for a wide arc; while sneaking it slams the ground with a shockwave."
		""
		"&7The next Mowzie's Mobs tier appears here once your team enters the Steam and Steel Era.&r"
	]
	quest.08942447C07DF8F5.title: "Wrought Arms"
	quest.08968C53FDC164EE.quest_desc: [
		"A vial of the Hydra's fiery blood and an iron ingot make fiery metal. It becomes a sword that sets foes alight, and armour."
		""
		"&7More quests on this page appear here once your team enters the Occult Era.&r"
	]
	quest.089B1C8D56671E39.quest_desc: ["The ring deals extra damage based on the target's maximum mana. Dangerous for mages."]
	quest.08AC5F8F4454BC61.quest_desc: ["The enchanter's hut is crafted from an enchanting table. The enchanter turns the citizens' experience into enchanted books."]
	quest.08AC5F8F4454BC61.title: "Enchanter"
	quest.08C5F9DB85521AA8.quest_desc: ["The glassblower makes panes and stained glass the builder asks for."]
	quest.08F341A86235FD17.quest_desc: ["It sifts gravel, sand and dirt through meshes and pulls out ores, seeds and gems. A better mesh gives a better yield."]
	quest.08F341A86235FD17.title: "Sifter"
	quest.0902162146E3CFED.quest_desc: ["Sends energy, fluids, chemicals, items and heat without cables, even across dimensions. All of them on one frequency act as a single block."]
	quest.090454E4FB72E932.quest_desc: ["A tank stores fluids and a pump pushes them through pipes. The pump only works with power, and its arrow shows the direction of flow."]
	quest.090454E4FB72E932.title: "Tank and Pump"
	quest.090580AC7CCC7809.quest_desc: ["Breaks old tools and armour back down into materials. Some material is lost, but the rest goes back to work."]
	quest.090B7F688EB9B972.quest_desc: ["The whole outfit is sewn from arcane cloth. It adds mana by itself, and each piece is the base for school robes."]
	quest.090B7F688EB9B972.title: "Wizard Robes"
	quest.091A7A23E2E0339A.quest_desc: ["This is where you learn new glyphs. Use a spell book on the table, pick a glyph and toss the shown items onto the table; it also costs experience."]
	quest.0920496C458A2339.quest_desc: ["The iron building wand places more blocks at once than the stone and copper ones from the Rune Era. It takes the blocks from your inventory."]
	quest.09291BAAED942687.quest_desc: ["An underwater temple of guardians. Elder guardians curse intruders with mining fatigue, so bring milk and water breathing potions."]
	quest.09291BAAED942687.quest_subtitle: "Milestone"
	quest.09291BAAED942687.title: "&aThe Ocean Monument"
	quest.093F11210845D7F7.quest_desc: [
		"Every Bookwyrm bound to the lectern lets it link more chests. Use the charm on the lectern."
		""
		"&7The Ritual of Awakening with a book and feathers gives you the charm.&r"
	]
	quest.094F84586A4F7278.quest_desc: [
		"Cuts out a whole build with its contents and pastes it somewhere new. Moving your base takes a few minutes."
		""
		"&7The next gadget tier appears here once your team enters the Atomic Era.&r"
	]
	quest.097A6887EC9FF0F6.quest_desc: ["You can tell archwood trees by their coloured leaves: blue, green, purple or red. Their wood makes the scribe's table, jars and the imbuement chamber."]
	quest.097A6887EC9FF0F6.title: "Archwood"
	quest.097BC53951A8ECCA.quest_desc: ["Osmium ore lies underground, much like iron. Osmium is the base of Mekanism: casings, control circuits and machines."]
	quest.098F802EF71CF3A4.quest_desc: ["A book, two diamonds and four obsidian make an enchanting table. Bookshelves placed around it strengthen the enchantments."]
	quest.098F802EF71CF3A4.quest_subtitle: "Milestone"
	quest.098F802EF71CF3A4.title: "&a{block.minecraft.enchanting_table}"
	quest.099868764AE0F13A.quest_desc: ["The advanced versions have more filter slots, a longer magnet range and a faster hopper. The recipes need diamonds and gold."]
	quest.099868764AE0F13A.title: "Advanced Upgrades"
	quest.099D20D0F4E0427F.quest_desc: ["Put a totem holding soul energy inside. The dark altar stands on the cage and draws ritual energy from it."]
	quest.09A95C24675BD99B.quest_desc: ["Steel from the TFMG blast furnace, melted under a foundry lid, cast and bored, gives a barrel and a chamber that take more charges at once. More powder means a longer shot."]
	quest.09A95C24675BD99B.quest_subtitle: "Milestone"
	quest.09A95C24675BD99B.title: "&6Steel Cannon"
	quest.09B4DAB90AEF07D8.quest_desc: ["You get the horn, spike and wing from the three kinds of wilden: hunter, defender and stalker. You meet them in forests and in their dens."]
	quest.09B4DAB90AEF07D8.title: "Wilden Spoils"
	quest.09D2BCF27839DC98.quest_desc: ["Vein mining, Fortune and Silk Touch. Toggle Fortune and Silk Touch in the tool's settings."]
	quest.09D2BCF27839DC98.title: "Meka-Tool Modules"
	quest.09D746883C62750A.quest_desc: [
		"Quest progress and the era belong to your team, not to a single player. Create a team before you start playing: use the team button in your inventory or type &6/ftbteams party create <name>&r."
		""
		"Anyone who joins a team later takes over its progress and era. Anyone who leaves chooses whether to keep the team's progress or return to their own earlier one: &6/ery wybor druzyna&r or &6/ery wybor wlasny&r."
		""
		"Several rival teams can play on one server. Each goes through the eras at its own pace, and every player claims quest rewards individually."
	]
	quest.09D746883C62750A.quest_subtitle: "Before you begin"
	quest.09D746883C62750A.title: "Your Team"
	quest.09DA3E6A9908DC86.quest_desc: ["Hold 256 levitite blocks at once. That is enough to lift a whole base into the air – if the end stone line runs on its own."]
	quest.09DA3E6A9908DC86.quest_subtitle: "Automation proof"
	quest.09DA3E6A9908DC86.title: "Floating Island"
	quest.09DE2B407A78854B.quest_desc: ["The fletcher makes bows and arrows for the colony's archers, along with woollen items."]
	quest.09E2812C6BD3D8BC.quest_desc: ["A block of witherite makes Cataclysm's firearms: a laser gatling and a shoulder launcher."]
	quest.09EAC3BC57B56720.quest_desc: ["The weapon the captain's ghost carried in life. Sometimes it is left after the fight."]
	quest.0A03B6EAD09C9721.quest_desc: [
		"The fourth stack tier. The recipe needs a block of netherite."
		""
		"&7The next backpack tier appears here once your team enters the Atomic Era.&r"
	]
	quest.0A0690740B9A0C18.quest_desc: ["Common ink with copper makes uncommon, that with iron makes rare, and rare with gold makes epic. Better ink lets the scroll forge craft a higher-level spell."]
	quest.0A0690740B9A0C18.title: "Inks"
	quest.0A0B3A4DDDD67A6D.quest_desc: ["A hungry citizen works slower. At first put food in his inventory; the more varied, the better."]
	quest.0A0B3A4DDDD67A6D.title: "The First Meal"
	quest.0A11B89B0FFAC847.quest_desc: [
		"The foundry basin only melts under a closed lid. A glassed lid lets you put a foundry mixer above the basin."
		""
		"&7Ponder (W) on the basin shows the whole foundry.&r"
	]
	quest.0A3060C061F1FD03.quest_desc: [
		"A piece of wizard robes, arcane essence and a rune make the robe of one school: cryomancer, electromancer, priest, shadow-walker, archevoker or plagued. It strengthens the spells of that school."
		""
		"&7Any chest robe counts.&r"
		""
		"&7The next Iron's Spells tier appears here once your team enters the Brass Era.&r"
	]
	quest.0A3060C061F1FD03.quest_subtitle: "Milestone"
	quest.0A3060C061F1FD03.title: "&dSchool Robes"
	quest.0A4B2270F286100B.quest_desc: ["A flame from Nether blazing quartz and glowstone dust. It burns in Malum torches and lanterns in a colour you choose."]
	quest.0A5CE764D2131A76.quest_desc: ["Summons an explosion staff: a long charge and a huge blast. Shift and right-click switch to a burst of smaller blasts or a block-breaking beam."]
	quest.0A6560E2EF3CCF5F.quest_desc: ["A dock for a single cell that attaches to a cable like a bus. It fits where a drive would not."]
	quest.0A671D973519F9EF.quest_desc: ["Use it on the ground to draw an alchemy array that accepts two offerings: a base and a catalyst. Some pairs craft items, others act on the world at once."]
	quest.0A6E40C03CEE6C35.quest_desc: ["Burns the fractions you do not need, so the distillation tower never stalls with full tanks."]
	quest.0AB8199BD822F5E9.quest_desc: ["The arm moves items between many points: it takes from belts and depots and feeds machines and chests. Pick its targets by clicking them with the arm before placing it."]
	quest.0AD1F1DE9C3F9590.quest_desc: ["Enter the Demon Realm. The demons living here (Daemonium) leave tainted flesh and trophies you cannot get anywhere else."]
	quest.0AD1F1DE9C3F9590.title: "The Demon Realm"
	quest.0ADD9870AE35AD42.quest_desc: ["Obelisks power an enchanting table like bookshelves, and the brilliant obelisk more than the runewood one."]
	quest.0ADD9870AE35AD42.title: "An Obelisk"
	quest.0ADF7585D757FA69.quest_desc: ["It grows on the outer islands. Eating it teleports you to a random spot nearby, and popped it makes purpur."]
	quest.0AE845ECD2F24083.quest_desc: ["The foundry mixer combines molten iron with coke into steel, ingot for ingot. Cast it into ingots, rebar or heavy plates right away."]
	quest.0AEAED1C255BB1BC.quest_desc: ["Burns solid fuel and also takes heat from lava around it. Mekanism's first power source of its own."]
	quest.0AF67746EC42729B.quest_desc: [
		"&7Electric Era · netherite armour, healing potions and an escape route recommended&r"
		""
		"The Warden is blind, but it hears every step and smells you. Its sonic boom passes through walls and armour."
		"The Stalker of the Otherside hunts the same way: quietly and out of the dark."
	]
	quest.0AF67746EC42729B.title: "The Deep Dark"
	quest.0AFF48208CAFC601.quest_desc: ["The first pickaxe made from Undergarden metals. It mines froststeel and utherium."]
	quest.0B22DCC034515189.quest_desc: ["The dimensional mineshaft sends a miner spirit into another dimension to bring back ores. Put a &d{item.occultism.miner_foliot_unspecialized}&r into it."]
	quest.0B3B93CE69511A97.quest_desc: ["Get any piece of Valkyrie gear from the silver dungeon's chests: armour, gloves or tools."]
	quest.0B3B93CE69511A97.title: "Valkyrie Gear"
	quest.0B49163061294D22.quest_desc: ["The first upgrade fills a fluid drawer with water on its own. The second, made from it and the dripping upgrade, produces obsidian."]
	quest.0B49163061294D22.title: "Drawer Generators"
	quest.0B85FA71AE3AB7ED.quest_desc: ["The concrete mixer makes concrete powder and concrete for the colony, so builders do not wait for your deliveries."]
	quest.0B87E412DBC8AF79.quest_desc: [
		"The era of the owner's team decides what the colony can build. Ordinary buildings grow in the tech eras: up to level 2 in the Andesite Era, 3 in the Brass Era, 4 in the Steam and Steel Era, 5 in the Electric Era."
		"Magic buildings grow in the magic eras: level 2 in the Rune Era, 4 in the Occult Era, 5 in the Arcane Era. When something is missing, the build tool shows which era you need."
	]
	quest.0B87E412DBC8AF79.title: "The Colony and the Eras"
	quest.0B8C71D798A203BA.quest_desc: ["They grow on vines in the caves below the Twilight Forest and glow in the dark. Skeleton druids drop them too."]
	quest.0B906638E5B9FCA1.quest_desc: [
		"Ars Elemental and Ars Technica extend Ars Nouveau magic in the Arcane Era. The key to both is the mark of mastery from this era's chapter, and technomancy also needs the calibrated mechanism."
		""
		"&7The elemental foci and Ars Elemental rituals are in the era chapter.&r"
	]
	quest.0B906638E5B9FCA1.title: "Elements and Technomancy"
	quest.0BF1CC17B83FCBA0.quest_desc: ["An abandoned mine with shafts and tunnels deep in the rock."]
	quest.0BF1CC17B83FCBA0.title: "The Mining Complex"
	quest.0C16CA01D15F7D39.quest_desc: [
		"&7Occult Era · netherite armour, potions and milk recommended&r"
		""
		"Once summoned, the Wither charges up and explodes, then fires skulls. At half health its armour shields it from arrows: keep fighting in melee."
		"&7Fight underground or far from your base. Milk removes the wither effect.&r"
	]
	quest.0C16CA01D15F7D39.title: "How to Beat the Wither"
	quest.0C2EBF819E476084.quest_desc: ["Terralith reshapes the landscape itself: dry brushland, the colourful springs of Yellowstone and wide highlands. Visit all three."]
	quest.0C2EBF819E476084.title: "Terralith"
	quest.0C34682C23DDE3DE.quest_desc: ["Places whole walls, floors and pillars of the chosen block, in many shapes at once. It runs on power: charge it like any FE device."]
	quest.0C34682C23DDE3DE.quest_subtitle: "Milestone"
	quest.0C34682C23DDE3DE.title: "&e{item.buildinggadgets2.gadget_building}"
	quest.0C41880C1863CD23.quest_desc: [
		"&7Gear: good armour and fire resistance potions.&r"
		"The obsidian monolith of Bosses of Mass Destruction. It waits in its arena on the End islands."
	]
	quest.0C41880C1863CD23.quest_subtitle: "Boss"
	quest.0C41880C1863CD23.title: "&c{entity.bosses_of_mass_destruction.obsidilith}"
	quest.0C753F186A0B384A.quest_desc: ["Adds one slot to a spell book, up to the limit of its kind. Made from hogskin and arcane cloth."]
	quest.0C7F2633426D6354.quest_desc: [
		"An empty orb of mithril, an arcane ingot and cinder essence combined with a rune makes an upgrade orb. On the arcane anvil you put it on a piece of armour: it adds school power, mana, shorter cooldowns or protection."
		""
		"&7The arcane rune is a blank runestone with arcane essence.&r"
	]
	quest.0C7F2633426D6354.quest_subtitle: "Milestone"
	quest.0C7F2633426D6354.title: "&dUpgrade Orb"
	quest.0C9F488BDD7472A7.quest_desc: ["Dropped by hoglins in the crimson forests of the Nether. This leather binds better spell books."]
	quest.0CA81074E41ACF8A.quest_desc: [
		"The Ritual of Containment locks a nearby creature in a containment jar placed next to it. You can carry the jar, and a Drygmy collects drops from it."
		""
		"&7The next Ars Nouveau tier appears here once your team enters the Brass Era.&r"
	]
	quest.0CA81074E41ACF8A.title: "A Creature in a Jar"
	quest.0CB4CCCC9723F3A5.quest_desc: ["The annihilation plane takes blocks and items in front of it into the network, and the formation plane places or drops them."]
	quest.0CB4CCCC9723F3A5.title: "Planes"
	quest.0CC6A8F2D2EEF5CA.quest_desc: ["The lamp holds the spirit of a felsteed. Click a block with it and the steed appears."]
	quest.0CCA2E9F8F18DC90.quest_desc: ["Disengages after a set delay when the network is overstressed. Unlike a shear pin, you do not have to replace it afterwards."]
	quest.0CCD2963566C0E61.quest_desc: ["Pushes chosen items from the network into the container or machine in front of it."]
	quest.0CCDF877683BE679.quest_desc: ["It lies in the Labyrinth's hidden vault. It breaks the mazestone that an ordinary pickaxe barely scratches."]
	quest.0CD23AB5628B3F37.quest_desc: ["Redstone and a Tabula Rasa in the array. The sigil shows the essence in your Anima, and aimed at the altar, in it too."]
	quest.0CDD997DDBA209EE.quest_desc: ["The gatehouse houses two guards and lets you connect your colony to other colonies."]
	quest.0CEC8654540CE3AB.quest_desc: [
		"&7Gear: netherite armour, healing potions and an escape route.&r"
		"The blind guardian of ancient cities hunts by sound. It comes when the shriekers hear you a few times."
	]
	quest.0CEC8654540CE3AB.quest_subtitle: "Boss"
	quest.0CEC8654540CE3AB.title: "&c{entity.minecraft.warden}"
	quest.0CFB231E4EDE8435.quest_desc: ["The ritual summoning a foliot with a job gives a book of calling: the janitor collects dropped items into a chest, the transporter moves items between containers, and the lumberjack and farmer fell trees and harvest crops. The book sets its workplace."]
	quest.0CFB231E4EDE8435.title: "A Foliot at Work"
	quest.0D02A80409E99AA6.quest_desc: ["Seal a chest with it and it keeps all its contents when broken. That is how you move a full storage elsewhere."]
	quest.0D16835F39CF3524.quest_desc: [
		"A blaze burner also takes fuel fed by a pipe. A press squeezes seed oil from seeds, and a mixer makes bioethanol from sugar, cinder flour and biomass; diesel and gasoline burn too."
		""
		"&7Ponder (W) on the burner shows liquid fuel burning.&r"
	]
	quest.0D16835F39CF3524.title: "Liquid Fuel"
	quest.0D1BD2927DCF013C.quest_desc: [
		"Places more blocks at once and lasts longer. Make it from a stick and a copper ingot."
		""
		"&7The next stick tier appears here once your team enters the Andesite Era.&r"
	]
	quest.0D30671E03A6EAC6.quest_desc: ["Lavender fields, maple woods and giant redwoods. Visit all three."]
	quest.0D30671E03A6EAC6.title: "Biomes O' Plenty"
	quest.0D3104FB78E7C018.quest_desc: ["Fuses gems the way the alloy forge fuses metals, such as diamond with emerald. The hybrid gem combines the traits of both."]
	quest.0D7583BE0EA11CB2.quest_desc: ["You finish a research by applying an arcane seal. It is made from magician's wax, brewed in the crucible from tallow, calx of End, redstone and red dye."]
	quest.0D90343C52E65B5F.quest_desc: ["Starbuncles live in forests and love gold nuggets: approach with a nugget in hand and one leaves you a token. The apparatus turns the token and gold into a charm that summons a helper to carry items."]
	quest.0D99AD3F3341985E.quest_desc: ["In the Brass Era the colony gets barracks, an archery and a combat academy. Gather eight guards before the raids grow."]
	quest.0D99AD3F3341985E.title: "Eight Guards"
	quest.0DA410A9FE4FF0E1.quest_desc: [
		"A level 3 smeltery processes ore blocks as if mined with Fortune II. That is the highest level this era."
		""
		"&7The next building tier appears here once your team enters the Occult Era.&r"
	]
	quest.0DA410A9FE4FF0E1.quest_subtitle: "Milestone"
	quest.0DA410A9FE4FF0E1.title: "&3Smeltery Level 3"
	quest.0DB15DB0FB1E6197.quest_desc: ["A chain strung between cogwheels carries packages across your whole base. Connect them by clicking one wheel with another."]
	quest.0DBCD009F6C11515.quest_desc: ["One of the two magic bosses is enough. Its trophy is the second boss the seal needs."]
	quest.0DBCD009F6C11515.quest_subtitle: "Milestone"
	quest.0DBCD009F6C11515.title: "&cChimera or Dead King"
	quest.0DC3DC6E4DE0278D.quest_desc: ["Removes effects from the target and banishes summoned creatures. Cast on a witch near death, it yields a Wixie token."]
	quest.0E13C0020046B09C.quest_desc: ["The pedestals around the enchanting apparatus hold the ingredients of a recipe. Make several, larger recipes take up to eight."]
	quest.0E15935A7DF78162.quest_desc: [
		"The ruins of a great arena. Go in with good armour."
		""
		"&7More quests on this page appear here once your team enters the Occult Era.&r"
	]
	quest.0E15935A7DF78162.title: "The Coliseum"
	quest.0E27D5D4B543A78F.quest_desc: [
		"Frames, ports and reactor glass surround the controller. A laser beam enters through the focus matrix in the wall and ignites the reaction."
		""
		"&7JEI and Mekanism's structure preview show the reactor's shape.&r"
	]
	quest.0E27D5D4B543A78F.title: "Fusion Reactor Frame"
	quest.0E2A921B22008D0B.quest_desc: ["The guide describes parts, materials and their traits. Check it before you decide what to make a tool from."]
	quest.0E3948737B64A96F.quest_desc: ["A primeval curse: the more mana you pour in, the harder it hits. It also cleanses your negative effects."]
	quest.0E404089795B48E8.quest_desc: ["Gives a signal of any strength from 0 to 15. Next to an adjustable chain gearshift it works like a throttle."]
	quest.0E4AA36A37CE3C35.quest_desc: ["The soul trapped inside points the way to the nearest catacombs. Make it from arcane essence, an iron ingot and a soul lantern."]
	quest.0E5E68B17057E04A.quest_desc: ["The amulet either enlarges your mana pool or speeds up its regeneration. Its base is a dull trinket of iron and a source gem."]
	quest.0E5E68B17057E04A.title: "Mana Amulet"
	quest.0E60FAA1F3557AF5.quest_desc: [
		"Place it on a monster spawner: it then siphons magic from it and infuses the items placed on top. An emerald becomes an awakened emerald, stone becomes shade stone and iron becomes cursed metal."
		""
		"&7JEI shows the infusion recipes (U on the infuser).&r"
	]
	quest.0E7971A293912780.quest_desc: ["The florist grows flowers on compost for the colony's decorations and recipes."]
	quest.0E7971A293912780.title: "Florist"
	quest.0E8427AD41F130CD.quest_desc: ["Connects chests that do not touch the controller. Link them with the storage tool."]
	quest.0E9E80A3F1EBFC45.quest_desc: ["A pyramid in the desert with the Ancient Remnant's tomb beneath. Bony kobolds guard it."]
	quest.0E9E80A3F1EBFC45.title: "The Cursed Pyramid"
	quest.0EB1780FEE5B7D51.quest_desc: [
		"A drawer holds many stacks of one item and shows it on the front. Right-click to insert, left-click to take out, with no window to open."
		""
		"&7A double right-click puts every matching item from your inventory into the drawer.&r"
	]
	quest.0EB1780FEE5B7D51.title: "A Drawer"
	quest.0EBBD86E5F5201B1.quest_desc: ["The transmutation table draws essence from your Anima through the orb in its right-hand slot. It makes reagents, scribe tools, oils and throwing daggers; JEI shows the orb tier each recipe needs."]
	quest.0EC3DB7D48237142.quest_desc: ["The Rune Era opens the colony's magic buildings, up to level 2 for now. In the library citizens study and raise their skills."]
	quest.0EC3DB7D48237142.title: "Library"
	quest.0EFA83C85873D316.quest_desc: ["Your first ingots of both metals. They become better tools, the first machines and the seal."]
	quest.0EFA83C85873D316.quest_subtitle: "Milestone"
	quest.0EFA83C85873D316.title: "&6Copper and Iron"
	quest.0EFFCA13B9A4552B.quest_desc: ["A thunderbolt from a shocking focus, a redstone block and a diamond. The storm school leads up to calling down lightning and storms."]
	quest.0F147D3C670434BE.quest_desc: ["A cupcake with fae essence. The Fae are disgusted by whoever ate it and avoid them even when they cast on a leypoint."]
	quest.0F3008D30DAE11A8.quest_desc: ["Made with a void thorn. It carries you a short distance through solid blocks."]
	quest.0F346A4EECEE8263.quest_desc: [
		"A single-use scroll: it opens the list of waystones you know and takes you to the chosen one for free."
		""
		"&7Craft it from paper, an ink sac, a gold nugget and an ender pearl.&r"
	]
	quest.0F6354C74514EA4F.quest_desc: ["A jump straight from a basic chest to diamond. Handy when you expand a whole storage at once."]
	quest.0F70AC236CC3ECBB.quest_desc: ["A netherite battlemage hat upgraded with the horn of the Netherite Monstrosity. A strong helmet for a melee mage."]
	quest.0F8B896403C3E624.quest_desc: ["A pirate ship whose crew died long ago. The hold is still full of loot."]
	quest.0F8B896403C3E624.title: "An Undead Pirate Ship"
	quest.0FACB23C0ACAE7EA.quest_desc: ["A pressurized tube carries gases and other chemicals between machines, and a mechanical pipe carries fluids. Every x3 and higher ore line depends on them."]
	quest.0FACB23C0ACAE7EA.title: "Tubes and Pipes"
	quest.0FADD40FA93C74DC.quest_desc: ["Every slot holds more than a normal stack. The first tier is made from the base and logs."]
	quest.0FAE2EAECC2ABDE3.quest_desc: ["Click a rope winch and a rope connector with a rope coupling to link them with a rope. A powered winch reels the rope in and out – lift cargo below your ship or tow another contraption."]
	quest.0FAE2EAECC2ABDE3.title: "Ropes and Winches"
	quest.0FBFA1911DFABEE5.quest_desc: [
		"A generator coil only makes power. Carbon brushes next to the coils collect it and pass it to the wires, from up to eight coils at once."
		""
		"&7Ponder (W) shows the layout of coils, magnets and brushes.&r"
	]
	quest.0FCFB4BFCDC40A72.quest_desc: ["Paints cables, trims and connectors to look like a chosen block, so the storage blends into your walls."]
	quest.0FDD5DB849F58A40.quest_desc: ["Flowering spreads flowers, Forestation plants trees and Overgrowth fertilises everything around. Handy for farms and builds."]
	quest.0FDD5DB849F58A40.title: "Ritual of Nature"
	quest.0FF473892D3EC29F.quest_desc: ["Click a block with it and it searches a small area behind it for ores. It also works as a pickaxe, and as a hammer in recipes."]
	quest.0FF5C90662F26F97.quest_desc: ["A full set shields you from fire and sets alight those who hit you. Every piece is made of fiery ingots."]
	quest.0FF5C90662F26F97.title: "Fiery Armour"
	quest.0FFE585782E962BE.quest_desc: ["The divination rod points to the nearest block it is attuned to, such as an otherworld ore. Make it from gold, glass and an attuned gem."]
	quest.1034402517DAC224.quest_desc: ["A gauge watches the stock of one item: when it runs low, it requests the ingredients from the logistics network. Linked gauges run a whole factory."]
	quest.103A2997B453759E.quest_desc: [
		"The third stack tier. The recipe needs a block of gold and the tier 2 upgrade."
		""
		"&7The next chest tier appears here once your team enters the Steam and Steel Era.&r"
	]
	quest.105089649D8E3755.quest_desc: ["A stone Explorify tomb. Look inside if you dare."]
	quest.105089649D8E3755.title: "A Mausoleum"
	quest.106859CA3013FCFA.quest_desc: ["Large dishes such as a roast chicken are placed like a block. You serve portions with a bowl, so one dish feeds the whole team."]
	quest.106859CA3013FCFA.title: "A Feast"
	quest.1069724C40E8D4C4.quest_desc: ["The dragonskin spell book of Ender Dragon skin, a ruined book and obsidian. One of the most capacious books of Iron's Spells."]
	quest.10824C64396CD357.quest_desc: ["It lies in the vault of one of the troll caves. It burns away the thorns that bar the way onward."]
	quest.10941E05500FD05D.quest_desc: [
		"Knights train here without risking death before they face a real fight."
		""
		"&7More quests on this page appear here once your team enters the Atomic Era.&r"
	]
	quest.10941E05500FD05D.title: "Combat Academy"
	quest.10E5B8A66A4EC7FF.quest_desc: ["Obsidian with a Tabula Robur. Every ritual has exactly one master stone at its heart and a pattern of plain stones around it."]
	quest.10E5B8A66A4EC7FF.title: "Ritual stones"
	quest.10EC3239A04E4C3F.quest_desc: ["Place the builder's hut with the build tool, hire a builder and order him to build his own hut."]
	quest.10EC3239A04E4C3F.title: "The First Work Order"
	quest.111C5BCA62F9C8DE.quest_desc: ["Tau fruit grows in the Demon Realm. Fully grown, it is the raw material for weak blood shards."]
	quest.1126469E0A49ADCD.quest_desc: ["The Power Consolidation circle spawns a lake. Throw an enchanted sword into the finished lake and it returns as the holy sword: the better its enchantments, the stronger it is, and the undead flee from it."]
	quest.1126469E0A49ADCD.quest_subtitle: "Milestone"
	quest.1126469E0A49ADCD.title: "&d{item.mahoutsukai.caliburn}"
	quest.11281FFDBA69F1AE.quest_desc: ["A grim ruined hospital nobody left healthy. Bring milk and spare food."]
	quest.11281FFDBA69F1AE.title: "The Plague Asylum"
	quest.1131C5BC3F7AFFC2.quest_desc: ["The strongest backpack in the pack: the most space and upgrade slots. It does not burn in lava."]
	quest.1131C5BC3F7AFFC2.quest_subtitle: "Milestone"
	quest.1131C5BC3F7AFFC2.title: "&b{item.sophisticatedbackpacks.netherite_backpack}"
	quest.113A4F48621EAD7A.quest_desc: ["Click the track next to a station with a train casing to place a bogey. Build a train with controls on it and assemble it in the station menu."]
	quest.113A4F48621EAD7A.title: "First Train"
	quest.113F367C40825ACE.quest_desc: ["Chests and barrels are all your storage for now. Better ones arrive in the Andesite Era."]
	quest.1143AC2BB6DB4C59.quest_desc: ["The plain forest, the dense forest, the firefly forest and the mushroom forest are open from the start. Visit all four."]
	quest.1143AC2BB6DB4C59.title: "Lands of the Forest"
	quest.1143EE893CA328E4.quest_desc: ["It enchants with no level requirement and also adds to items that are already enchanted. Each use adds just one level, so a strong enchantment takes many rounds."]
	quest.114616CC6A0B470F.quest_desc: [
		"The Ur-Ghast floats high above the arena of the Dark Tower. Slay the ghastlings around a trap and activate it to drag him down."
		"&7The traps stand in the boss room at the top of the tower.&r"
	]
	quest.114616CC6A0B470F.title: "Ghast Trap"
	quest.1158FDB4929D5DCD.quest_desc: ["The strongest of the building wands. Upgrade the diamond one on a smithing table with a netherite upgrade template and a netherite ingot."]
	quest.1158FDB4929D5DCD.quest_subtitle: "Milestone"
	quest.1158FDB4929D5DCD.title: "&e{item.wands.netherite_wand}"
	quest.11631356DA4AF263.quest_desc: ["Stone infused in the cursed infuser. It makes pedestals: a ritual takes its ingredients from pedestals within 8 blocks of the dark altar."]
	quest.11631356DA4AF263.title: "Shade stone and pedestals"
	quest.116414E1FDCFB1BB.quest_desc: ["Flour and water make &6{item.create.dough}&r. Send the dough through the stream of a fan blowing through fire and it bakes into bread. The quest checks the Create advancement for fan processing."]
	quest.116414E1FDCFB1BB.title: "Bakery in the Wind"
	quest.11844103153559F1.quest_desc: ["A fourth tier forge ritual with the divine pact as the enhancer: three kinds of souls, amethyst and ender pearl fragments around quartz. The soulbound modifier keeps the item with you after death."]
	quest.1189812BC365E23E.quest_desc: [
		"The second stack tier. The recipe needs a block of iron and the previous tier upgrade."
		""
		"&7The next chest tier appears here once your team enters the Brass Era.&r"
	]
	quest.118C67708613B190.quest_desc: ["Get any piece of phoenix armour. It protects you from fire and lava, and in water it cools into obsidian armour."]
	quest.118C67708613B190.title: "Phoenix Armour"
	quest.118D9575214E769E.quest_desc: ["A hatch in the blast furnace wall lets in hot air from the blast stove. A second hatch on top collects furnace gas, and items sent into it drop into the furnace."]
	quest.11E06B20EEA05823.quest_desc: ["A camp of the mysterious denizens of the Undergarden. Their chests hold masks."]
	quest.11E06B20EEA05823.title: "A Denizen Camp"
	quest.11F5FF463FFB7DA8.quest_desc: ["Pink sakura groves, an autumn valley full of pumpkins and a dark witch forest. Visit all three."]
	quest.11F5FF463FFB7DA8.title: "Oh The Biomes We've Gone"
	quest.11FC9196F27DE3E1.quest_desc: ["The goggles show the speed and stress of the machines you look at. You see at once whether your power is enough for the whole line."]
	quest.11FCE4A0C294CB8D.quest_desc: [
		"Two wheels side by side, spinning inwards, crush whatever falls between them. You make them on mechanical crafters."
		""
		"&7Ponder (hold W over the item) shows how to set it up.&r"
	]
	quest.11FCE4A0C294CB8D.quest_subtitle: "Milestone"
	quest.11FCE4A0C294CB8D.title: "&6Crushing Wheels"
	quest.12036D0DFF9246D3.quest_desc: ["Woodland mansions stand in dense dark forests. In this pack they house the &a{entity.illagerinvasion.invoker}&r, the illager boss."]
	quest.12036D0DFF9246D3.title: "Woodland Mansion"
	quest.120F885EFF140229.quest_desc: ["A press over a basin squeezes plant oil out of seeds. Mix it with ethanol to get biodiesel: engine fuel without a drop of oil."]
	quest.120F885EFF140229.title: "Biodiesel"
	quest.122241210B4A87F5.quest_desc: ["Upgrade a diamond pickaxe with a netherite ingot and a bastion template on a smithing table. Only a pickaxe of this tier mines Iron's Spellbooks mithril ore."]
	quest.12272A2C2D55DB5C.quest_desc: ["Swaps the blocks in the selected area for others, without digging. Turn a finished house from stone into brick in a few clicks."]
	quest.122DBFDFFA3403D2.quest_desc: ["A great Dungeons Arise structure high above the End islands. One of the harder dungeons."]
	quest.122DBFDFFA3403D2.title: "The Aviary"
	quest.1240660E819543A1.quest_desc: ["Enchant an item at level 100. Such a table gives enchantments an ordinary enchanter can only dream of."]
	quest.1240660E819543A1.quest_subtitle: "Milestone"
	quest.1240660E819543A1.title: "&dEnchanting at level 100"
	quest.124468F09928C2D4.quest_desc: ["Cut screws from a steel ingot on a stonecutter. The screwdriver is a tool in the assembly of the generator and the electric motor, and in the world it locks pipes in place."]
	quest.124468F09928C2D4.title: "Screws and Screwdriver"
	quest.12582E66D27D5321.quest_desc: ["Oxidise the yellow cake, combine it with hydrofluoric acid in a chemical infuser, and the centrifuge turns it into fissile fuel."]
	quest.126F5D77D0B9C052.quest_desc: ["Left behind by the &c{entity.goety.ender_keeper}&r. Goety rituals turn it into the strongest End foci."]
	quest.12823F43BC8A1A70.quest_desc: ["Blazes drop these rods. One goes into the seal, more into the brewing stand, the Ars apprentice book and the fire rune."]
	quest.12823F43BC8A1A70.quest_subtitle: "Seal ingredient"
	quest.12839D5DA4C084BB.quest_desc: ["Three pedestals: the source holds the sulfur to reform, the target holds the pattern, and the new sulfur appears on the result pedestal."]
	quest.12839D5DA4C084BB.title: "Reformation array"
	quest.12880F0726E1EBA0.quest_desc: [
		"The advanced versions have more filter slots and a longer magnet range. The recipes need diamonds and gold."
		""
		"&7The next backpack tier appears here once your team enters the Steam and Steel Era.&r"
	]
	quest.12880F0726E1EBA0.title: "Advanced pickup"
	quest.128DAD53D949C476.quest_desc: ["The schematic and quill saves a selected build to a file, and the schematic table writes the file onto an empty schematic. A schematicannon will build it once you get one."]
	quest.128DAD53D949C476.title: "Schematics"
	quest.12AD8DE5221F315E.quest_desc: ["Mine zinc ore with an iron pickaxe. Zinc nuggets replace iron in andesite alloy, and in the Brass Era you will combine zinc with copper."]
	quest.12C9DE9623188A7F.quest_desc: ["A cell for fluids. The ME network stores water, lava and fuels in it next to items."]
	quest.12FC7512556643A9.quest_desc: ["The crucible focuses spirits through an item called an impetus, which wears down with each use and gives new things, such as ore nodes or blazing quartz."]
	quest.12FC7512556643A9.quest_subtitle: "Milestone"
	quest.12FC7512556643A9.title: "&d{block.malum.spirit_crucible}"
	quest.1308134184C91F76.quest_desc: ["The Slider leaves the key to its dungeon's treasure chest. Inside waits the Hammer of Kingbdogz, the Valkyrie Lance or the Sentry Boots."]
	quest.130E6F658F659203.quest_desc: [
		"This page leads through the lands of the Twilight Forest, its materials and its maps. The bosses are in the era trees, and each one defeated opens more lands."
		""
		"&7Locked lands harm anyone who enters: with hunger, frost, fire or blindness.&r"
	]
	quest.130E6F658F659203.title: "In the Twilight Forest"
	quest.1314CF959B0CFD5B.quest_desc: [
		"&7Brass Era · diamond armour and fire resistance potions recommended&r"
		""
		"A labyrinth lies below the swamp, with the Minoshroom at its heart. The stew it leaves behind gets you used to the heat of the fire swamp, where the Hydra waits in its lair."
		"The Hydra has several heads and spits fire from afar. Strike the heads when they drop to the ground."
	]
	quest.1314CF959B0CFD5B.title: "The Labyrinth and the Fire Swamp"
	quest.135966E6DE04F1B3.quest_desc: ["A vat with a mixer makes liquid concrete from sand, gravel, limesand and water. Pour it into rebar blocks and it sets into reinforced concrete."]
	quest.135966E6DE04F1B3.title: "Reinforced Concrete"
	quest.1359AE6CB7834A64.quest_desc: ["The drawer emits a redstone signal based on how full it is. Use it to stop a machine once the stock is full."]
	quest.1360D983BCA997AD.quest_desc: ["The Starlight Golem always leaves the energy sword, along with an oxidized alloy furnace."]
	quest.136177C72A318563.quest_desc: ["This foliot trades ordinary stone for otherstone. Cheap material for an occultist's buildings."]
	quest.136177C72A318563.title: "Stone Trader"
	quest.13701853E6C4AC8D.quest_desc: ["A pickaxe, axe, shovel and weapon in one, running on power. Modules add speed and reach."]
	quest.1392C9FC6F4EE4C4.quest_desc: ["The remains of a portal on this side. The chest next to it often holds gold."]
	quest.1392C9FC6F4EE4C4.title: "A Ruined Nether Portal"
	quest.13A3B1CE60BFFB7F.quest_desc: ["The afrit smelts the items you give it like a furnace, only faster and without fuel."]
	quest.13A3B1CE60BFFB7F.title: "Afrit Smelter"
	quest.13CAE7E894DBEA2C.quest_desc: [
		"Shift-click a terminal with it to open that terminal from afar with its own key. A beacon nearby extends the range, up to other dimensions."
		""
		"&7Upgrade the plain wireless terminal on a smithing table with a netherite ingot.&r"
	]
	quest.13D01E9076667682.quest_desc: ["Darkstone pedestals around the forge hold the ritual ingredients. Ponder (W) shows where they go."]
	quest.13D46E7A09D48D09.quest_desc: ["Leather armour with arcane essence. A light, cheap outfit for your first trips with a spell book."]
	quest.13D46E7A09D48D09.title: "Wandering Magician's Outfit"
	quest.13DA3E0A1B71DE03.quest_desc: ["Shulkers lurk in End cities. Two shells and a chest make a portable box."]
	quest.13E1023B98EED92C.quest_desc: ["A framed block takes on the look of any block you click it with: quartz stairs or a slab of leaves. The framed hammer takes the cover off again."]
	quest.13E1023B98EED92C.title: "Framed Blocks"
	quest.13E60D549E3A08F9.quest_desc: ["Mundabitur dust combines arcane crystal dust with redstone, gunpowder, blaze powder, bone meal and a phantom membrane. Sprinkled on the right structure it transforms it: this is how the Hephaestus Forge and the obelisk are made."]
	quest.13EDB8A28E326BE1.quest_desc: ["Goggles with ritual-infused lenses show otherworld blocks without eating &d{item.occultism.datura}&r."]
	quest.140A2E973FDDCE24.quest_desc: [
		"The fourth stack tier. The recipe needs a block of diamond."
		""
		"&7The next chest tier appears here once your team enters the Arcane Era.&r"
	]
	quest.140C6E789E790C5E.quest_desc: [
		"The cape makes your skeletons' arrows pass through allies, and your zombies turn wild zombies into servants. The crown keeps servants from decaying and halves the casting time."
		""
		"&cWearing the crown in daylight weakens you.&r"
	]
	quest.140C6E789E790C5E.title: "Necromancer set"
	quest.14221090700CFA35.quest_desc: ["An extra access point to the storage elsewhere in your base. Click the actuator with it before placing it, and it opens the same storage."]
	quest.142A7534DE345F3C.quest_desc: ["Collect it with an empty bottle from the clouds the dragon leaves behind. It brews lingering potions."]
	quest.1435697270482493.quest_desc: ["Before placing a mechanical arm, mark at least ten output locations with it. One arm then serves a whole row of machines."]
	quest.1435697270482493.title: "Ten-handed Arm"
	quest.143F5440F86462B6.quest_desc: ["The focus of summoning strengthens summoned creatures, and the focus of block shaping lets spells move blocks. Wear it in the focus slot."]
	quest.143F5440F86462B6.title: "An Enchanter's Focus"
	quest.14408C81D0D92F13.quest_desc: [
		"You find moa eggs in silver dungeons. Hatch them in an incubator fuelled with an ambrosium torch."
		""
		"&7A grown moa is a mount that can jump several times in mid-air and glides down slowly.&r"
	]
	quest.14408C81D0D92F13.quest_subtitle: "Milestone"
	quest.14408C81D0D92F13.title: "&aA Moa of Your Own"
	quest.14485AF7CFFDC3D2.quest_desc: ["The helmet and chestplate are left by the knight phantoms, though not after every fight. They carry enchantments you cannot apply the usual way."]
	quest.14485AF7CFFDC3D2.title: "Phantom Armour"
	quest.145C259EF1E9E9DA.quest_desc: ["Takes you into a world of your own, and if you are looking at an enemy, it comes along."]
	quest.146F3AF7E206039C.quest_desc: [
		"After the fight a chest appears in the arena with the gauntlet's eye inside. It is a material for the table of elevation and the blast amplifier."
		""
		"&7The next Mass Destruction tier appears here once your team enters the Atomic Era.&r"
	]
	quest.147282D671C2D01F.quest_desc: ["What is left of a lab in the withered forest. Someone once brewed something very dangerous here."]
	quest.147282D671C2D01F.title: "The Ruined Lab"
	quest.147C96D50B472C44.quest_desc: ["A purpur castle from Dungeons and Taverns. Be ready for shulkers."]
	quest.147C96D50B472C44.title: "An End Castle"
	quest.14B1D245A31476FC.quest_desc: ["The mounted potato cannon fires the same ammo as the handheld one. On deck it keeps phantoms away."]
	quest.14DC02AE20A7EAA2.quest_desc: ["An energy store that grows like a fluid tank: place blocks next to each other and they merge into one. It evens out the gap when your generators stop."]
	quest.14F513B8AA7F697B.quest_desc: ["A sprawling pharaoh's temple: long halls, traps and a treasure chamber. Mining fatigue applies inside, so digging is slow."]
	quest.14F513B8AA7F697B.quest_subtitle: "Milestone"
	quest.14F513B8AA7F697B.title: "A Desert Temple"
	quest.14F6F6F85A662A17.quest_desc: ["A soul shard, redstone, lapis and quartz brewed in the crucible. The lesser soul gem powers wands and trinkets."]
	quest.14FDE6CE1CB0DA47.quest_desc: ["Ferment, for example, iron sulfur. Common metals niter is the starting point for exaltation."]
	quest.14FDE6CE1CB0DA47.title: "Common metals niter"
	quest.1507AA210FFA27CD.quest_desc: ["Three graphite electrodes over a vat of nine fireproof segments (3×3) make an arc furnace. It melts crushed iron ore with flux and coke dust into steel, no blast furnace needed."]
	quest.1507AA210FFA27CD.title: "Arc Furnace"
	quest.150D09B312AC34D8.quest_desc: ["A harvester on a moving contraption gathers ripe crops and leaves the plants in the ground. With a plough and a bearing you get a self-running farm."]
	quest.153601AC543F67BC.quest_desc: ["Gold with blaze powder, combined in the grid. It goes into the material grader and the starlight charger."]
	quest.1578CCAF82A446EC.quest_desc: ["An enhancer from jungle and desert temple chests and underwater ruins. Placed on the forge, it allows elemental rituals: prisms are only made with it."]
	quest.158F6B7EC8782A2C.quest_desc: ["Mine darkstone underground and polish it in the crafting grid. The base of the Hephaestus Forge takes 45 polished darkstone, plus chiseled and gilded blocks."]
	quest.158F6B7EC8782A2C.title: "Darkstone"
	quest.158F9510B87B17F8.quest_desc: ["Iron armour infused with soul stained steel plating and twisted rock. It grants soul ward, which absorbs part of the damage and regenerates on its own."]
	quest.158F9510B87B17F8.title: "Soul Stained Steel Armour"
	quest.15A7A9BF29AE4352.quest_desc: ["Run a track through a Nether portal and ride a train through it. One block in the Nether equals eight in the Overworld, which makes it the shortest way to the far side of the map."]
	quest.15A7A9BF29AE4352.title: "Train to the Nether"
	quest.15AF1C92938E0B2F.quest_desc: ["The ruined houses of forgotten builders. Their pots hold seeds, beans and crystals."]
	quest.15AF1C92938E0B2F.title: "A Forgotten Vestige"
	quest.15AF54CC1E262A56.quest_desc: ["Get launched more than 30 blocks by a weighted ejector. Plan the landing in advance."]
	quest.15AF54CC1E262A56.title: "Ejector Flight"
	quest.15D604CF280ECB60.quest_desc: ["A soul stained steel scythe or axe infused with malignant pewter. The Edge of Deliverance and the Weight of Worlds are Malum's strongest melee weapons."]
	quest.15D604CF280ECB60.title: "A Void Weapon"
	quest.15DD7DCACBA98806.quest_desc: [
		"An iron impetus in the crucible turns spirits into iron nodes, which you smelt into metal. There are impetuses for other ores too, such as gold and copper."
		""
		"&7Repair a cracked impetus in the crucible or on a repair pylon.&r"
	]
	quest.15DD7DCACBA98806.title: "Impetus and Nodes"
	quest.15DD92C6867EC08F.quest_desc: [
		"Rerolls an item's affixes for gem dust and rarity materials. The simple table handles only the lower rarities."
		""
		"&7The next enchanting tier appears here once your team enters the Brass Era.&r"
	]
	quest.15EA3B3D3939ACBE.quest_desc: ["Deorum is gold transformed with arcane crystal dust, mundabitur dust and charcoal. Two ingots go into the seal."]
	quest.15EA3B3D3939ACBE.quest_subtitle: "Seal ingredient"
	quest.15FB67AC04E6B942.quest_desc: [
		"Hold 1024 source gems at once. Several imbuement chambers fed by Create funnels and relays gathering source from the whole base will do it without you."
		""
		"&7The next Ars Nouveau tier appears here once your team enters the Occult Era.&r"
	]
	quest.15FB67AC04E6B942.quest_subtitle: "Automation proof"
	quest.15FB67AC04E6B942.title: "Source in Bulk"
	quest.1604019C96870DA7.quest_desc: [
		"The enchanter turns these tomes and the citizens' experience into enchanted books. Magic buildings grow in the magic eras: here up to level 2."
		""
		"&7The next building tier appears here once your team enters the Brass Era.&r"
	]
	quest.16066D372D3609DB.quest_desc: ["It lies deep in the Nether, near the bottom. It resists explosions, and a diamond pickaxe mines it."]
	quest.160A4589914D44F9.quest_desc: ["The tower at the heart of the dark forest opens once the knight phantoms fall. The &c{entity.twilightforest.ur_ghast}&r waits at its top."]
	quest.160A4589914D44F9.title: "Dark Tower"
	quest.163B279F2C34878A.quest_desc: [
		"&7Gear: a bow or crossbow, building blocks, slow falling potions.&r"
		"The dragon circles the main End island. Destroy the crystals on the obsidian towers first."
	]
	quest.163B279F2C34878A.quest_subtitle: "Boss"
	quest.163B279F2C34878A.title: "&c{entity.minecraft.ender_dragon}"
	quest.163F269AA565798C.quest_desc: ["Breathing underwater, feeding on nutritional paste from a canteen and protection from bad effects. With them the suit looks after you on its own."]
	quest.163F269AA565798C.title: "Survival"
	quest.164E77F58A57B54F.quest_desc: ["The Labyrinth lies underground in the &c{biome.twilightforest.swamp}&r of the Twilight Forest. It only opens once the Lich is beaten; if you chose the Naga in the Rune Era, the Lich still waits in its tower. The Minoshroom sits at the Labyrinth's heart."]
	quest.164E77F58A57B54F.title: "The Labyrinth"
	quest.16592ADF7EA541D2.quest_desc: ["Removes whole volumes of blocks at once. Handy when you dig a cellar or rebuild your base from scratch."]
	quest.165C4F4398AB9EE6.quest_desc: [
		"Seasons change in the Overworld. Each lasts 24 in-game days: spring is followed by summer, autumn and winter."
		"In winter, snow falls in cold lands and water freezes."
		""
		"&7Crops grow fast only in their season and very slowly outside it. A seed's tooltip shows when it grows.&r"
	]
	quest.165C4F4398AB9EE6.title: "Four Seasons"
	quest.165EF28F79677DF6.quest_desc: ["The miner digs a shaft and tunnels and brings stone and ores. The higher the mine level, the deeper he goes."]
	quest.165EF28F79677DF6.title: "Mine"
	quest.166D0D68A4B44E8D.quest_desc: ["The largest QIO drive. It needs antimatter, so it rewards your whole nuclear industry."]
	quest.167D828D9FAD0EB8.quest_desc: ["Holds any amount of a single item. Just right for cobblestone, dirt and other bulk materials."]
	quest.16AC09D118F25541.quest_desc: ["The thread of spell power strengthens spells, the thread of magic capacity enlarges your mana pool. Both are imbued in the apparatus from a blank thread."]
	quest.16AC09D118F25541.title: "First Thread"
	quest.16AFBF8CDD6DE71E.quest_desc: [
		"A list of the foods you have eaten. Every five new, different foods give you two more hearts, up to 25 foods."
		""
		"&7Variety is what counts: the same food eaten twice adds nothing. Craft it from a book and a carrot.&r"
	]
	quest.16AFBF8CDD6DE71E.quest_subtitle: "Milestone"
	quest.16AFBF8CDD6DE71E.title: "&a{item.solcarrot.food_book}"
	quest.16B0277A516BDD2D.quest_desc: ["The wand always fires a fast projectile, and you add one spell made only of effects and augments. Write it at the scribe's table."]
	quest.16DD2E71C524EAC7.quest_desc: ["Takes you to any teleporter on your frequency, from anywhere. Charge it before you set out."]
	quest.16E1F5DBF3F8ECD8.quest_desc: ["At night it charges materials with starlight. A charged material gives parts much better stats."]
	quest.16E45F1D64C85295.quest_desc: ["A stone anvil made from cobblestone and dirt. You work items on it with a tool: a knife splits a log into template boards, and a hammer breaks cobblestone into pebbles."]
	quest.16E6B02C48B651C2.quest_desc: ["A wire from a large connector reaches up to 32 blocks and carries up to 5000 FE per tick, five times the small connector. Build your base's main line on it."]
	quest.16E6DC80E201D8A0.quest_desc: ["It lies in woodland mansion chests. Evokers sometimes drop it too."]
	quest.16E761F3252A1103.quest_desc: [
		"Place a stressometer in the network and look at it through engineer's goggles. You see how much SU the machines use and how much is left."
		""
		"&7You make the stressometer from a speedometer in the crafting grid.&r"
		""
		"&7More quests on this page appear here once your team enters the Brass Era.&r"
	]
	quest.16E761F3252A1103.title: "Exact Readout"
	quest.16E91CEBEC2E6AB6.quest_desc: ["At a smithing table the upgrade template and a reinforced echo shard turn netherite armour into Warden armour."]
	quest.16E91CEBEC2E6AB6.title: "Warden Armour"
	quest.1700AA822C878E2C.quest_desc: ["A full set of Alpha Yeti fur. It slows and freezes those who strike you."]
	quest.1700AA822C878E2C.title: "Yeti Armour"
	quest.170DA1526864E8AA.quest_desc: ["A blaze burner and an enchanting table, joined with a blaze upgrade template on a smithing table. It enchants items with liquid experience instead of your levels."]
	quest.170DA1526864E8AA.quest_subtitle: "Milestone"
	quest.170DA1526864E8AA.title: "&d{block.create_enchantment_industry.blaze_enchanter}"
	quest.17134029AAA21DF8.quest_desc: ["Links drawers to the controller: click the controller, then the drawers, or select a whole area."]
	quest.171820C2A55FBF5D.quest_desc: ["The afrit miner digs deeper in the dimensional mineshaft and brings back deep ores, deepslate ones too. It is made from the djinni miner."]
	quest.171C2103DDB0034D.quest_desc: [
		"The randomizer tool places a random block from those you put into it, in the ratios you set. It also works with shape modes, so a wall of several stones looks natural."
		""
		"&7Find the recipe in JEI.&r"
	]
	quest.171C2103DDB0034D.title: "Randomizer Tool"
	quest.171D851019B79447.quest_desc: ["Netherite scrap and intricate hellforged parts from the Demon Realm double a rune's power."]
	quest.171D851019B79447.title: "Reinforced rune"
	quest.172014DD1BAA5299.quest_desc: [
		"Emits a redstone signal that depends on the season. Handy for farms that switch crops with the season."
		""
		"&7The recipe needs nether quartz.&r"
	]
	quest.1751A8D7234136F6.quest_desc: ["A full cursium set on netherite armour. The helmet makes creatures behind walls glow, and the chestplate revives you with 5 health when you die."]
	quest.1751A8D7234136F6.title: "Cursium Armour"
	quest.176B57B72D915C96.quest_desc: ["Turns power into rotation, up to 128 RPM. A wrench sets the speed while the SU output stays the same; a redstone signal turns it off."]
	quest.177BBFAE4F3977FF.quest_desc: ["It gathers all open citizen requests in one place, so you don't have to walk to every hut."]
	quest.17A40BEFB145F6E0.quest_desc: ["Red chalk is afrit essence, a torchflower and redstone. The afrit book of binding with yellow dye lets you summon it into service."]
	quest.17A40BEFB145F6E0.title: "The Afrit's Name"
	quest.17A4692B5A2D25B5.quest_desc: ["Four precision mechanisms from the Brass Era go into the seal. If your sequenced assembly line still stands, just start it up."]
	quest.17A4692B5A2D25B5.quest_subtitle: "Seal ingredient"
	quest.17C8007220406A94.quest_desc: ["A brass funnel filters and counts items, and a brass tunnel splits them evenly between belts. That is the basis of tidy production lines."]
	quest.17C8007220406A94.title: "Brass Funnels and Tunnels"
	quest.17CAFF9D89754B99.quest_desc: ["The best wand, the construction stick, the mech trowel and two gadgets. With this set you can build anything you imagine."]
	quest.17CAFF9D89754B99.quest_subtitle: "Milestone"
	quest.17CAFF9D89754B99.title: "&eThe Builder's Full Set"
	quest.17CC641258FFA3F2.quest_desc: ["A stronger discount ring. The recipe needs a blaze rod and the ring of lesser discount."]
	quest.17D2173AC4D2401F.quest_desc: ["Carries energy but no channels. Power a separate network without joining it to the main one."]
	quest.17DE1C7674CF6CC4.quest_desc: ["MEGA cells eat accumulation processors at every tier. Let the inscribers work on their own, fed by the ME network."]
	quest.17DE1C7674CF6CC4.quest_subtitle: "Automation proof"
	quest.17F6CE36D1B3D206.quest_desc: ["A diamond thrown into spiritfire becomes an attuned gem. Two go into the seal, more into dimensional storage and rituals."]
	quest.17F6CE36D1B3D206.quest_subtitle: "Seal ingredient"
	quest.180497A1907FEEFC.quest_desc: ["An ancient debris vein only accepts the netherite drill head and needs lava as drilling fluid. Other veins take any drill head."]
	quest.180497A1907FEEFC.title: "Better Drill Heads"
	quest.1804A9B22E120315.quest_desc: ["A bookshelf with end stone bricks, infused dragon's breath and an ender pearl. It is the strongest family of shelves."]
	quest.180B3F3616B373C6.quest_desc: ["An anvil in your backpack: repair and rename items without placing a block."]
	quest.180E2CAB7669186E.quest_desc: [
		"Animals killed with this knife drop tallow, which makes candles for rituals. Iron and a stick are enough."
		""
		"&7These quests extend the Occultism branch of the Occult Era chapter. Dimensional storage has its own page in the Storage tab.&r"
	]
	quest.18119FE31A405578.quest_desc: [
		"Every Twilight Forest boss leaves its own trophy. Collect all eight and display them in your base."
		"&7These are decorations: the era seal counts the pack trophy you receive for the fight.&r"
	]
	quest.18119FE31A405578.title: "Hall of Trophies"
	quest.182AF4F0978F07E2.quest_desc: ["The glacier with the Aurora Palace. It opens once the Alpha Yeti is defeated."]
	quest.182AF4F0978F07E2.title: "{biome.twilightforest.glacier}"
	quest.1833A7F9829D7495.quest_desc: ["Combines two identical gems with gem dust and a rarity material into a gem of higher purity. Gem dust comes from salvaging gems."]
	quest.1837BA9CA203D7BF.quest_desc: [
		"Once you have this era's milestones, hand in the &6Seal of the Andesite Era&r. Your whole team enters the Andesite Era and the seal is consumed."
		""
		"You make the seal on a crafting table from the ingredients marked in this chapter: andesite alloy, a lapis block, a backpack, beef stew, a spyglass and a copper saw."
		""
		"&7See the exact recipe in JEI: hover over the seal and press R.&r"
	]
	quest.1837BA9CA203D7BF.quest_subtitle: "Hand in the seal"
	quest.1837BA9CA203D7BF.title: "Gate: Andesite Era"
	quest.1852CD03BCD1F119.quest_desc: [
		"&7Steam and Steel Era · full netherite armour and a bow recommended&r"
		""
		"In the snowy forest of the Twilight Forest, in the yeti cave, lives the Alpha Yeti. It throws ice bombs and stuns with its charge."
		"Its fur keeps out the cold of the glacier, where the Snow Queen rules from the aurora palace."
	]
	quest.1852CD03BCD1F119.title: "The Frozen North"
	quest.187FE4540ADA5811.quest_desc: [
		"&7Arcane Era. Recommended gear: full netherite armour and fire resistance potions.&r"
		"A huge netherite golem guards the soul blacksmith. Fight away from the lava."
	]
	quest.187FE4540ADA5811.quest_subtitle: "Boss"
	quest.187FE4540ADA5811.title: "&c{entity.cataclysm.netherite_monstrosity}"
	quest.18D49B2910A260D1.quest_desc: ["Valves take in steam and output power, vents release the spent steam, and a saturating condenser recovers water from it for the reactor or boiler."]
	quest.18D49B2910A260D1.title: "A Complete Turbine"
	quest.18D8087B7EC7DF7F.quest_desc: ["A warship from Dungeons Arise: Seven Seas. The crew won't give it up without a fight."]
	quest.18D8087B7EC7DF7F.title: "A Frigate"
	quest.18DB4AF8EC81B3C1.quest_desc: ["A full set of netherite: the strongest common armour, and it does not burn in lava. Upgrade it from diamond at a smithing table."]
	quest.18DB4AF8EC81B3C1.title: "Netherite Armour"
	quest.18EAEF743BF99699.quest_desc: ["A house inside a giant mushroom, now full of uninvited guests. Search it carefully."]
	quest.18EAEF743BF99699.title: "A Mushroom House"
	quest.18F53CEADE99C786.quest_desc: [
		"&7Rune Era · iron armour, a bow and healing potions recommended.&r"
		""
		"The Lich hides behind orbiting shields, casts bolts and conjures shadow copies of itself, then summons minions."
		"It waits at the top of the Lich Tower."
	]
	quest.18F53CEADE99C786.quest_subtitle: "Boss"
	quest.18F53CEADE99C786.title: "&c{entity.twilightforest.lich}"
	quest.1906EB1A7A494052.quest_desc: ["Compresses ingots, nuggets and similar items into blocks. Ore hauls take less space."]
	quest.192206C36D8188F3.quest_desc: ["The dagger cuts white wool into spell cloth. A scroll is made when you draw a circle on cloth laid on the ground."]
	quest.192AB4BC3CDED21B.quest_desc: ["A creature slain with a scythe shatters into spirits you pick up like items. The spirit type depends on the victim: Nether creatures give infernal spirits."]
	quest.1938A2DEA92094BB.quest_desc: [
		"The “{key.wands.wand_menu}” key opens the wand menu, and “{key.wands.wand_mode}” switches the mode: line, row and column, area, grid, circle, fill, copy…"
		"The action (“{key.wands.wand_action}”) picks placing, replacing or destroying. Undo a mistake with “{key.wands.wand_undo}”."
		""
		"&7To destroy blocks the wand needs a tool: put a pickaxe, axe or shovel into its window.&r"
	]
	quest.1938A2DEA92094BB.title: "Wand Modes and Menu"
	quest.193EC08916094BD3.quest_desc: [
		"A chest you carry with you. Wear it on your back or place it on the ground and open it like a chest."
		""
		"&7The &bB&7 key opens the backpack you wear.&r"
	]
	quest.193EC08916094BD3.quest_subtitle: "Milestone"
	quest.193EC08916094BD3.title: "&b{item.sophisticatedbackpacks.backpack}"
	quest.19634E871E4254E7.quest_desc: ["Charges items on a depot or belt below it. It also charges certus quartz crystals for the ME network."]
	quest.197AE2220D5D840F.quest_desc: ["Incendium added new biomes and buildings to the Nether. Find the Forbidden Castle and search its chests."]
	quest.197AE2220D5D840F.title: "Forbidden Castle"
	quest.198CE7DA2F3B8425.quest_desc: ["The Meka-Tool teleports you to where you look. It needs antimatter."]
	quest.1992F1A6A3FB6AF0.quest_desc: ["Explosion breaks blocks and hurts enemies; with Dampen it spares the terrain. The recipe needs a fire charge from the Nether."]
	quest.19AB14EE702096F9.quest_desc: ["Automation proof: 512 soul sand. Send sand through the air stream of an &6{block.create.encased_fan}&r blowing through soul fire."]
	quest.19AB14EE702096F9.title: "Bulk Haunting"
	quest.19C1B88E3715CDEA.quest_desc: [
		"&7Gear: your best armour and blast protection.&r"
		"A doom machine of witherite. It fires lasers and missiles."
	]
	quest.19C1B88E3715CDEA.quest_subtitle: "Boss"
	quest.19C1B88E3715CDEA.title: "&c{entity.cataclysm.the_harbinger}"
	quest.19C7EC0F0264B357.quest_desc: ["On a contraption it switches its tools on and off: drills, saws or harvesters. Its filter picks which ones it controls."]
	quest.19D30CB192B1F221.quest_desc: ["Somewhere in the Nether stands the arena where the &a{entity.bosses_of_mass_destruction.gauntlet}&r waits."]
	quest.19D30CB192B1F221.title: "Gauntlet Arena"
	quest.1A0007DC4CDD40D5.quest_desc: ["The armor-piercing shell punches through blocks and detonates inside fortifications, the shrapnel shell showers the target with balls, and the smoke shell blinds the battlefield."]
	quest.1A0007DC4CDD40D5.title: "Shell Arsenal"
	quest.1A103C43DA85A5C2.quest_desc: [
		"The elevator pulley carries a cabin between floors. An elevator contact on each floor calls the cabin and stops it at the right height."
		""
		"&7Ponder (hold W over the item) shows how to put it together.&r"
	]
	quest.1A103C43DA85A5C2.title: "Elevator"
	quest.1A192796BDC6AB3B.quest_desc: [
		"In the Steam and Steel Era ordinary buildings grow to level 4. Upgrade the builder's hut first, since he only builds up to his own level, then houses and the warehouse."
		""
		"&7The next building tier appears here once your team enters the Electric Era.&r"
	]
	quest.1A192796BDC6AB3B.title: "Bigger Buildings"
	quest.1A1F417FD00AD85D.quest_desc: ["At the alteration table you sew threads into your robes to give them new properties. A blank thread is fibre with a gold nugget."]
	quest.1A1F417FD00AD85D.title: "Alteration Table and Threads"
	quest.1A20DC34157B1976.quest_desc: ["Fires blocks from a container next to it and builds a structure from a saved schematic, block by block. The schematic and quill saves any build from your world."]
	quest.1A3B43D388109BB2.quest_desc: ["The jar keeps spirits of one kind out of your inventory. The &d{item.malum.hallowed_gold_ingot}&r it needs is infused on the altar from gold and quartz."]
	quest.1A48598314F49C49.quest_desc: [
		"&7Brass Era · recommended: diamond armor&r"
		"The mushroom minotaur guards the heart of the Labyrinth. After the fight it leaves &c{item.twilightforest.meef_stroganoff}&r."
	]
	quest.1A48598314F49C49.quest_subtitle: "Boss"
	quest.1A48598314F49C49.title: "&c{entity.twilightforest.minoshroom}"
	quest.1A59304CB028CB07.quest_desc: ["Darkstone and a netherite upgrade template. On a smithing table it applies a modifier to a weapon, tool or armour piece; the modifier is a prism, stella or crystal from a ritual."]
	quest.1A60BE46026AEE7A.quest_desc: ["Two redstone contacts facing each other give a signal. One on a contraption tells it that it has arrived."]
	quest.1A6156F2D0127642.quest_desc: ["The base of every backpack upgrade. Put an upgrade into a slot on the side of the backpack window."]
	quest.1A66C559E26F968D.quest_desc: ["The Deep Aether dungeon high in the clouds. Its guardian only fights once you hit it, so bring a bow."]
	quest.1A66C559E26F968D.title: "The Brass Dungeon"
	quest.1A865097F19FA04C.quest_desc: ["The classic weapon made of parts. The guard takes the look of the second material used in the blade."]
	quest.1A8D52E79F397607.quest_desc: [
		"&7Steam and Steel Era · light armour and plenty of food recommended&r"
		""
		"The bluffs guarding the monastery drop these rods. Give one to the Sculptor to begin his trial: a climb up a rising rock pillar before time runs out."
	]
	quest.1A97E4BC1233B569.quest_desc: [
		"Give a Starbuncle a scroll and it carries only the items written on it, or everything except them."
		""
		"&7The next Ars storage tier appears here once your team enters the Arcane Era.&r"
	]
	quest.1A97E4BC1233B569.title: "Item Scrolls"
	quest.1A9C0A1247E8549E.quest_desc: ["Destroys chosen items or the overflow above full slots. A good bin for cobblestone and dirt from a drill."]
	quest.1AAF0591F053FE48.quest_desc: [
		"&7Arcane Era · full netherite armour and fire resistance potions recommended&r"
		""
		"Cataclysm's great bosses sleep in their strongholds: Ignis in the Burning Arena, the Netherite Monstrosity in the soul blacksmith in the Nether, and the Ancient Remnant in the cursed pyramid in the desert."
		"Each has to be woken: with ashes on an altar, by entering the arena or with a necklace at a tombstone."
	]
	quest.1AAF0591F053FE48.title: "Cataclysm Bestiary"
	quest.1AE7663A683F1C7D.quest_desc: ["A TheSettler_x_Create addition. The colony packager links the colony warehouse to Create logistics packages, like an ordinary packager does for a chest."]
	quest.1B01C36C0DE071C6.quest_desc: ["The alchemist brews potions for guards and citizens. Its hut needs a brewing stand. This era magic buildings grow to level 4."]
	quest.1B077A339179DBA3.quest_desc: ["Wall ({effortlessbuilding.mode.wall}) and floor ({effortlessbuilding.mode.floor}) fill a plane between two corners. The diagonal wall ({effortlessbuilding.mode.diagonal_wall}) and slope floor ({effortlessbuilding.mode.slope_floor}) come in handy for roofs and ramps."]
	quest.1B077A339179DBA3.title: "Wall and Floor"
	quest.1B24A66E1B08939B.quest_desc: ["Place it behind a motor that lacks strength. It raises the motor's stress capacity, and power use rises with it."]
	quest.1B363F4C9D528E5E.quest_desc: [
		"Collects the nuclear waste the activator does not process. Waste in the barrel slowly decays."
		""
		"&cNever dump waste: it contaminates the area for a long time.&r"
	]
	quest.1B3F82D1C7ED9A73.quest_desc: ["Feed it mercury shards and it slowly turns them into mercury flux: pure energy that powers the emitters."]
	quest.1B9566B8971E3AF2.quest_desc: ["Fit the focus into the dark wand (Z key) and cast. A zombie servant attacks anyone who hurts you and follows you like a tamed wolf."]
	quest.1B9566B8971E3AF2.title: "First servant"
	quest.1BBA88CDB891766C.quest_desc: ["The clockwork bearing turns the hands attached to it to match the time of day. Build a clock face on it and assemble it."]
	quest.1BBA88CDB891766C.title: "Tower Clock"
	quest.1BC5B8A6DFDD9BFF.quest_desc: ["Gold, redstone and a soul shard brewed in the crucible give arcane gold. Four ingots go into the seal."]
	quest.1BC5B8A6DFDD9BFF.quest_subtitle: "Milestone and seal ingredient"
	quest.1BC5B8A6DFDD9BFF.title: "&d{item.eidolon_repraised.arcane_gold_ingot}"
	quest.1BFC2919E5E3CC0E.quest_desc: ["A blank rune with a blaze rod makes a fire rune. It becomes a &d{item.irons_spellbooks.fire_upgrade_orb}&r for your mage gear."]
	quest.1C0B751453CFEBA3.quest_desc: ["Glass, osmium and steel: the core of almost every Mekanism machine. The Seal of the Atomic Era is built on one too."]
	quest.1C0B751453CFEBA3.quest_subtitle: "Seal ingredient"
	quest.1C100C85DEF8FA1B.quest_desc: [
		"&7Steam and Steel Era. Recommended gear: full netherite armour.&r"
		"The Alpha Yeti lives in the yeti cave in the snowy forest of the Twilight Forest. Its fur makes yeti armour."
	]
	quest.1C100C85DEF8FA1B.quest_subtitle: "Boss"
	quest.1C100C85DEF8FA1B.title: "&c{entity.twilightforest.alpha_yeti}"
	quest.1C1423FF6D3A1BB4.quest_desc: ["Emits a redstone signal when the network's stock passes a set amount. Use it to stop a farm once storage is full."]
	quest.1C25636B4A8B1989.quest_desc: ["Leather garb infused with soulwoven silk, itself infused from string and wool. A light outfit for scythe and magic fighters."]
	quest.1C25636B4A8B1989.title: "Soulhunter Garb"
	quest.1C281558CAB30D66.quest_desc: ["A catalyzer placed by the crucible burns fuel, such as arcane charcoal, and speeds up its work."]
	quest.1C2C510DD21A7846.quest_desc: ["Display goods on a table cloth next to a stock keeper and set a price. Other players take a shopping list, pay at the keeper and get a package."]
	quest.1C2C510DD21A7846.title: "A Table Cloth Shop"
	quest.1C3C95F6A58407A8.quest_desc: ["A tall tower visible from afar. The magic of the Twilight Forest lets you in only after you defeat the Naga."]
	quest.1C3C95F6A58407A8.title: "Lich Tower"
	quest.1C41719CE434251E.quest_desc: ["Copper wire wound on an empty spool. The spool links insulators into a line, and goes into the generator and the electric motor in assembly."]
	quest.1C54BF93B3DE5D8A.quest_desc: ["The highest stack tier. It is made from the fourth tier upgrade."]
	quest.1C64A411B4412763.quest_desc: ["Assign towers to it and using it calls their guards to you. Handy when a raid strikes from one side."]
	quest.1C781BD56E583C57.quest_desc: ["Large city ruins on the ocean floor, from Hopo's Better Underwater Ruins. Bring water breathing potions."]
	quest.1C781BD56E583C57.title: "An Underwater City"
	quest.1C7C92E32AC85633.quest_desc: ["An amethyst shard in a copper casing. Use the spyglass to spot targets from afar."]
	quest.1C7C92E32AC85633.quest_subtitle: "Seal ingredient"
	quest.1C8331FCF96218E5.quest_desc: ["The Fae roam near leylines and leave essence when they die. Magic cast on leypoints draws them in."]
	quest.1C87DB01BA73E951.quest_desc: ["The higher it stands, the more power it gives. Put it on a hill or a tower."]
	quest.1CB7DE2ECB89213F.quest_desc: [
		"The fifth stack tier. The recipe needs a block of netherite."
		""
		"&7The next chest tier appears here once your team enters the Atomic Era.&r"
	]
	quest.1CBB953C35E264BD.quest_desc: ["Personally defeat every great Cataclysm boss, including those of earlier eras."]
	quest.1CBB953C35E264BD.title: "Cataclysm Slayer"
	quest.1CC15FAF8EE76424.quest_desc: ["Gwiblings are fish from the underground waters of the Undergarden. Catch one in a bucket."]
	quest.1CC15FAF8EE76424.title: "A Gwibling in a Bucket"
	quest.1CD64F1F2177B833.quest_desc: ["Black dye, magic fabric and a totem of undying. Used inside a woodland mansion, the scroll calls the &c{entity.goety.vizier}&r."]
	quest.1CE48EAEF5896F4A.quest_desc: [
		"You build a TFMG engine from blocks in a single row, up to five. Then you insert cylinders and a shaft, and start it with a redstone signal."
		""
		"&7The engine's tooltip shows what is missing. Ponder (W) shows the build.&r"
	]
	quest.1D12C092653159E4.quest_desc: [
		"Attune it to an ore (Shift and right-click the block), then use it: it points the way to the nearest such ore. The glass rod has the shortest reach."
		""
		"&7The Hermetica, Theurgy's guide, covers the details.&r"
	]
	quest.1D160A16409DE198.quest_desc: [
		"Charms work by themselves when needed: they grant night vision, slow your fall, let you breathe underwater or walk on powder snow. Each use spends a charge, which you refill with source in the imbuement chamber."
		""
		"&7More quests on this page appear here once your team enters the Brass Era.&r"
	]
	quest.1D160A16409DE198.title: "First Charm"
	quest.1D1DF7702E33212A.quest_desc: ["The eye of ender school works through your gaze: it binds in place, sparks black flames, shows the future path of mobs or what they carry."]
	quest.1D1DF7702E33212A.title: "Mystic eyes"
	quest.1D28580F167502CD.quest_desc: ["The witch's cauldron brews custom potions with soul energy. It only works with lit soul candlesticks on full cages nearby."]
	quest.1D2ACC757F4E5AD1.quest_desc: [
		"A bulk cell holds one kind of item in practically unlimited amounts. Ideal for cobblestone, sand and other bulk materials."
		""
		"&7A compression card in a bulk cell converts nuggets, ingots and blocks on its own.&r"
	]
	quest.1D2C2401DCA3B407.quest_desc: [
		"A lonely Incendium tower on the quartz flats. Climb to the top."
		""
		"&7More quests on this page appear here once your team enters the Occult Era.&r"
	]
	quest.1D2C2401DCA3B407.title: "The Abandoned Tower"
	quest.1D38FE59DBD690E2.quest_desc: [
		"This page leads across the End islands and their structures. The dragon and the other End bosses are in the Atomic Era tree."
		""
		"&7There is only void below the islands. Bring blocks, ender pearls and something for falling.&r"
	]
	quest.1D38FE59DBD690E2.title: "The End Islands"
	quest.1D4CD8F88B9414AF.quest_desc: ["Runewood trees grow on plains and hills, more rarely in forests. Their planks build the spirit altar and totems."]
	quest.1D505B4780D2BDD8.quest_desc: ["A list of items a funnel lets through or an arm picks up. Put it into the filter slot on a block: click the slot holding the filter."]
	quest.1D69DB228D162A45.quest_desc: [
		"The Chimera leaves its tribute. It goes into the focus of summoning and, in later eras, into the archmage spell book and the mark of mastery."
		""
		"&7The next magic boss tier appears here once your team enters the Occult Era.&r"
	]
	quest.1D6DB12B3502E9ED.quest_desc: ["Crushing wheels turn raw ore into crushed ore and experience nuggets, and whole ore blocks give even more. Wash it with a fan or smelt it: washing gives metal nuggets and sometimes a bonus, such as redstone from iron."]
	quest.1D6DB12B3502E9ED.title: "Crushed Ore"
	quest.1D6F35160BB3C0C7.quest_desc: ["They grow on bushes in the Undergarden. Roasted in a furnace or a smoker they make a decent meal."]
	quest.1D72C292B37A5B00.quest_desc: ["Warm armour made of fur. You can dye it like leather."]
	quest.1D72C292B37A5B00.title: "Arctic Armour"
	quest.1D80099ABD8EE379.quest_desc: [
		"In this pack an eye of ender can be neither thrown nor placed in a portal frame. You fill the ancient portal frame in the stronghold with End Remastered eyes."
		"Each eye comes from a different adventure: from chests in structures, from powerful creatures or from a recipe."
		""
		"&7Collect the eyes as a team before you reach the Atomic Era.&r"
	]
	quest.1D80099ABD8EE379.title: "A Portal Without Eyes of Ender"
	quest.1D93B9C7003F1F15.quest_desc: ["The engineering print is pressed into a diamond. This processor goes into the controller, the ME drive and the seal."]
	quest.1D93B9C7003F1F15.quest_subtitle: "Seal ingredient"
	quest.1D95F5B90CF3879F.quest_desc: ["Mount a steam whistle on a train and sound it while driving. Everyone on the platform will know you are coming."]
	quest.1D95F5B90CF3879F.title: "Locomotive Whistle"
	quest.1DB1DC5013D1F6FB.quest_desc: [
		"Create: Connected adds the gearboxes Create is missing. The parallel one turns shafts around corners in the same direction, and the 6-way one has shafts on every face – the top and bottom ones spin at half speed."
		""
		"&7This page gathers the smaller Create add-ons. Each mod has its own lane.&r"
	]
	quest.1DB1DC5013D1F6FB.title: "More Gearboxes"
	quest.1DB5E1B3659E0D2B.quest_desc: ["Stranghouls live here. Some of them can be bargained with, and defeated ones drop malarite."]
	quest.1DB5E1B3659E0D2B.title: "A Stranghoul Den"
	quest.1DCB210D0E297B67.quest_desc: ["More space and one more upgrade slot. Upgrade a chest in your inventory in the crafting grid with copper."]
	quest.1DF1B89DF4B3D796.quest_desc: ["The witch's hat and robe. The robe holds a brewing stand that you open with a key from the controls."]
	quest.1DF1B89DF4B3D796.title: "Witch set"
	quest.1E0D88CBD29B6927.quest_desc: [
		"Once you have this era's milestones, hand in the &6Seal of the Occult Era&r. Your whole team enters the Occult Era and the seal is consumed."
		""
		"The seal comes from Create sequenced assembly on a &6{block.create.brass_casing}&r: deployers add a precision mechanism, a blaze rod, an electron tube and two boss trophies, a spout pours 500 mB of lava and a press finishes it."
		""
		"&7See the exact recipe in JEI: hover over the seal and press R.&r"
	]
	quest.1E0D88CBD29B6927.quest_subtitle: "Hand in the seal"
	quest.1E0D88CBD29B6927.title: "Gate: Occult Era"
	quest.1E277C8511418E3E.quest_desc: ["Ars Elemental adds new tablets for the {block.ars_nouveau.ritual_brazier}: attraction, repulsion, detection, pollination, squirrels, the Tesla coil and the archwood forest. Make any of them."]
	quest.1E277C8511418E3E.title: "Elemental Ritual"
	quest.1E34913CB52B2916.quest_desc: [
		"Aluminium is smelted in an electrolyser: a heated vat with two electrode holders and copper electrodes, powered from the network. It splits bauxite powder into metal."
		""
		"&7Crushing wheels make bauxite powder; bauxite lies in underground rock layers.&r"
	]
	quest.1E54FAB5C7AAB310.quest_desc: ["Stock up 64 fuel rods. A sequenced assembly line fed with thorium from the mixer keeps the reactor going."]
	quest.1E54FAB5C7AAB310.title: "Fuel Stock"
	quest.1E699B28DAB70780.quest_desc: ["The sequenced pulse generator runs a timed list of instructions when it gets a signal at its back. Its control chip comes from sequenced assembly."]
	quest.1E699B28DAB70780.title: "Programmed Redstone"
	quest.1E71E31719F33621.quest_desc: ["The advanced motor spins at up to 256 RPM, and the reinforced one holds the most energy. Both need overcharged materials from an energiser."]
	quest.1E71E31719F33621.title: "Stronger Motors"
	quest.1E78A0D397FB5C53.quest_desc: ["The altar's twin: instead of essence it spends Spiritus from the gem placed inside. It makes Spiritus gems, sentient tools and explosive charges."]
	quest.1E78A0D397FB5C53.quest_subtitle: "Milestone"
	quest.1E78A0D397FB5C53.title: "&d{block.neovitae.hellfire_forge}"
	quest.1E82BE476F8BB384.quest_desc: ["Create Propulsion builds its engines from platinum. Mine platinum ore deep underground and smelt the crushed ore into ingots; a press turns them into sheets for cables, casings and nozzles."]
	quest.1E980C3800C4710D.quest_desc: ["It lies in the temple's hidden chamber. With a warden carapace it upgrades netherite gear."]
	quest.1E980C3800C4710D.title: "Warden Template"
	quest.1EA8DBA0ED4E4364.quest_desc: ["Without protection from the cold you cannot cross the glacier. The Alpha Yeti's fur makes warm armour."]
	quest.1EA8DBA0ED4E4364.quest_subtitle: "Milestone"
	quest.1EA8DBA0ED4E4364.title: "&c{item.twilightforest.alpha_yeti_fur}"
	quest.1EC310751E5F982D.quest_desc: ["The ammo container feeds rounds into the autocannon breech. Machine gun rounds are cheap and effective against creatures."]
	quest.1EC310751E5F982D.title: "Ammo Container"
	quest.1EC7E29A1A665D4C.quest_desc: ["A pickaxe, axe and shovel in one. It is a bit more durable but digs a little slower."]
	quest.1EF868965F3BF0A9.quest_desc: ["The lowest lands of the Undergarden, full of rotten creatures. Beware of the utheric infection."]
	quest.1EF868965F3BF0A9.title: "The Depths"
	quest.1EF97CA9C4F8F80B.quest_desc: ["A wheel mount holds a tire and lets a simulated contraption drive over land. Tires come in four sizes, from small to monstrous."]
	quest.1EF97CA9C4F8F80B.title: "On Wheels"
	quest.1F32E166ECCE4EC2.quest_desc: ["A gearbox passes rotation out on all four sides, around corners too. The shaft opposite the input spins the other way round."]
	quest.1F32E166ECCE4EC2.title: "Gearboxes"
	quest.1F363D298EFDAC86.quest_desc: [
		"A kinetic battery charges by drawing stress from its front, and when powered by redstone it gives it back as a power source at a fixed speed. Charge one to full – the factory keeps running when the main source stops."
		""
		"&7Ponder (hold W over the item) shows how it works.&r"
	]
	quest.1F363D298EFDAC86.quest_subtitle: "Milestone"
	quest.1F363D298EFDAC86.title: "&6Kinetic Battery"
	quest.1F5DA7C454A4C364.quest_desc: ["Find the headquarters of the Apothic cultists from Discerning the Eldritch. The {entity.discerning_the_eldritch.ascended_one} waits in its depths."]
	quest.1F5DA7C454A4C364.title: "Cultist Headquarters"
	quest.1F663FD265E72969.quest_desc: ["Automation proof: 256 source gems. Set up several imbuement chambers next to jars and feed and empty them with hoppers or Create funnels."]
	quest.1F663FD265E72969.title: "Gems at Scale"
	quest.1F87CDB590D69039.quest_desc: ["Splits water into hydrogen and oxygen. Oxygen feeds the purification chamber, and hydrogen burns in a gas-burning generator or a jetpack."]
	quest.1F9C2D37BBCEE795.quest_desc: [
		"&7Brass Era · recommended: diamond armor, a shield&r"
		"The iron guardian waits in an underground chamber. Armor covers its front, so look for a chance to strike its back."
	]
	quest.1F9C2D37BBCEE795.quest_subtitle: "Boss"
	quest.1F9C2D37BBCEE795.title: "&c{entity.mowziesmobs.ferrous_wroughtnaut}"
	quest.1FB9179434C717E2.quest_desc: ["A djinni book of binding with purple dye, combined with the dictionary, knows its name. The djinni is stronger than a foliot and performs harder rituals."]
	quest.1FD8A8C1E74823F4.quest_desc: ["A shovel digs dirt, sand and gravel faster. You also need it for the &a{block.farmersdelight.cooking_pot}&r."]
	quest.1FE740B5B6940DEE.quest_desc: ["A gold block on a tier two altar. Rituals and sentient armour start with this orb."]
	quest.1FE740B5B6940DEE.quest_subtitle: "Milestone"
	quest.1FE740B5B6940DEE.title: "&d{item.neovitae.blood_orb_magician}"
	quest.2001C65186B84C6B.quest_desc: [
		"&7Steam and Steel Era · a zanite pickaxe or better and full armour recommended&r"
		""
		"A dungeon of carved stone hidden inside an island. The Slider guards it, a stone block that only a pickaxe can hurt. Dodge it when it slides your way."
	]
	quest.2001C65186B84C6B.title: "The Bronze Dungeon"
	quest.20033862BE22BAD3.quest_desc: ["Fly into Earth orbit. From here the rocket goes on to the Moon and other planets."]
	quest.20033862BE22BAD3.quest_subtitle: "Space, optional"
	quest.20033862BE22BAD3.title: "Orbit"
	quest.2022A89AAD55C22E.quest_desc: ["Armour plates are made from a blueprint and a material, like heads. Every material brings different traits, so mix them until you find your set."]
	quest.2022A89AAD55C22E.title: "Armour from Parts"
	quest.202C3A576FEA7DBF.quest_desc: ["Forge rituals consume four essences: aureal, blood, souls and experience. Make an aureal bottle from arcane crystal dust and a potion; the test tube is the vessel for blood."]
	quest.202C3A576FEA7DBF.title: "Forge Essences"
	quest.2033FBA126229000.quest_desc: ["The emerald school is a trade: you turn damage taken into mana, or trade immunity to repeated hits for double damage from new ones."]
	quest.2033FBA126229000.title: "Exchange scroll"
	quest.2034878D79D4F673.quest_desc: ["Fires a sonic boom like the {entity.minecraft.warden}. The ritual needs a ruby of souls, an echo shard and a sculk catalyst."]
	quest.20349EC44D285471.quest_desc: ["Jars, item shelves, notice boards, hourglasses and dozens of other trinkets. A jar holds a fluid or items and sits nicely on a table."]
	quest.20349EC44D285471.title: "Supplementaries Trinkets"
	quest.20438A7266ADE336.quest_desc: ["Loot from the lord of the deep: a grappling hook and a tentacle that hurts enemies."]
	quest.2044F5DE06AC8B25.quest_desc: ["An extra access point for the controller. Place it wherever inserting and extracting is handier."]
	quest.2056E8FDE0091650.quest_desc: ["Jellyfish drift in the seas and sting on contact. Catch one in a bucket and release it wherever you like."]
	quest.206C25125206B59F.quest_desc: ["Drops inserted items in front of itself. Put it above a hopper or a belt and the storage feeds a machine."]
	quest.2070D74B64500FA7.quest_desc: ["The dyer makes dyes and colours wool, concrete and other blocks for builds."]
	quest.207303221A0D0E34.quest_desc: ["A fireball made from a blaze rod and an ignite focus. Fire foci are the simplest attack school: it grows from igniting to a meteor shower."]
	quest.2077B7B0F2C1E13A.quest_desc: ["The next era's seal consumes two precision mechanisms. Your assembly line from the Brass Era makes them with ease."]
	quest.2077B7B0F2C1E13A.quest_subtitle: "Seal ingredient"
	quest.207B8C89C503B967.quest_desc: ["A brass sheet on andesite alloy. The hand is the heart of the deployer."]
	quest.20A43CD1F5CF7C0F.quest_desc: ["A temple choked with cobwebs and crawling with vermin. Bring torches and shears."]
	quest.20A43CD1F5CF7C0F.title: "The Infested Temple"
	quest.20BF312F78CBF5EE.quest_desc: ["Dye mixed with water in a mixer makes liquid dye. A fan blowing through it dyes items in bulk, and liquid dye meeting lava sets into concrete of its colour."]
	quest.20BF312F78CBF5EE.title: "Liquid Dye"
	quest.20D3BB5546F198EA.quest_desc: ["A small four-line display. Text from a display link also goes to the screen of a player sitting in front of it – in a train cab or a ship's bridge."]
	quest.20E01B8154E80B61.quest_desc: ["The geomancer staff conjures three stones that fly where you look after a moment. Bluff rods repair it and the rest of the outfit."]
	quest.20E0ABBC1B47B114.quest_desc: ["A great galleon from Dungeons Arise: Seven Seas. Search every deck."]
	quest.20E0ABBC1B47B114.title: "A Galleon"
	quest.20F497E931F9EA35.quest_desc: ["Fibre from the magebloom is the material for mage robes, threads and parchment."]
	quest.20FED8168C36C2C4.quest_desc: ["The telescope and the astronomy table start the Northstar space programme. Space is extra: the era gate does not require it."]
	quest.20FED8168C36C2C4.quest_subtitle: "Space, optional"
	quest.210A8375EF210CE7.quest_desc: ["Obsidian and raw iron fired in the Clibano with the artisan relic. Obsidiansteel makes the dark nether star, skulls and dragon armour."]
	quest.210B0032A4FAF64B.quest_desc: ["A hot air burner under a closed balloon envelope lifts the ship. Make the envelope from wool and sticks; Ponder (W) shows how to build the balloon."]
	quest.210B0032A4FAF64B.title: "Balloon"
	quest.210C88907C0457FE.quest_desc: ["Chain drives placed side by side carry rotation along the whole row, in the same direction. The adjustable gearshift changes the speed depending on the redstone signal strength."]
	quest.210C88907C0457FE.title: "Chain Drives"
	quest.2112AA2F8AF7BFFE.quest_desc: ["The ritual stops monsters from spawning within 32 blocks as long as it has source. A safe base without torches everywhere."]
	quest.2117DD9A2804106D.quest_desc: ["You know both from the Stone Era: lapis lies deep and amethyst grows in geodes. Four of each go into the seal."]
	quest.2117DD9A2804106D.quest_subtitle: "Seal ingredient"
	quest.2117DD9A2804106D.title: "Lapis and Amethyst"
	quest.2158674B4C7C444D.quest_desc: [
		"&7Steam and Steel Era. Recommended gear: your best armour and fire resistance.&r"
		"The sun spirit guards the gold dungeon inside a large island. It shoots fireballs, so fight away from flammable blocks."
	]
	quest.2158674B4C7C444D.quest_subtitle: "Boss"
	quest.2158674B4C7C444D.title: "&c{entity.aether.sun_spirit}"
	quest.215A96B07E9B2DCE.quest_desc: ["White chalk draws pentacles. First make impure chalk, then spiritfire purifies it."]
	quest.2160E78D87327A77.quest_desc: ["Light an obsidian frame with flint and steel to open a portal. The Nether is open from this era: blazes, quartz and gold await."]
	quest.2160E78D87327A77.quest_subtitle: "Milestone"
	quest.2160E78D87327A77.title: "&aInto the Nether"
	quest.216543B04D6E3261.quest_desc: ["Only a line that processes ore on its own makes this many: an enrichment chamber, a smelter and logistical transporters."]
	quest.216543B04D6E3261.quest_subtitle: "Automation proof"
	quest.2168EF0291E7FADD.quest_desc: ["A diversion transporter lets items through depending on a redstone signal. Items take a restrictive transporter only as their last choice of route."]
	quest.2168EF0291E7FADD.title: "Junctions"
	quest.2177ADD7300AA308.quest_desc: ["An enchanted turret imbued with an elemental focus takes on part of its power: its spells trigger the focus effects. It is made in the imbuement chamber."]
	quest.2177ADD7300AA308.title: "An Elemental Turret"
	quest.217C9A5896C2FE1D.quest_desc: ["A fourth ring of runes (100 in total) with hellforged blocks at the corners. A hellforged block on such an altar gives the Dominus orb."]
	quest.217C9A5896C2FE1D.quest_subtitle: "Milestone"
	quest.217C9A5896C2FE1D.title: "&d{item.neovitae.blood_orb_archmage}"
	quest.218D28B612B42DB0.quest_desc: ["The djinni miner works the dimensional mineshaft faster than a foliot and brings back more ore. It is made in a ritual from the foliot miner and an iesnium pickaxe."]
	quest.21910EC2977D2053.quest_desc: ["Turns alchemical sulfur into niter, which can move between kinds of matter, such as from metals to gems. Shift-right-click with an empty hand to close or open the vat."]
	quest.219687B3511CC879.quest_desc: ["Phylactery shards turn up in the catacombs, and a shard with a soul lantern makes the whole phylactery. Used on the Dead King's soul, it raises him for another fight."]
	quest.219E7F099DD7D563.quest_desc: ["An endshelf upgraded with a dragon head. You need several of them for the table's full power."]
	quest.21A8F17D18AFF16D.quest_desc: [
		"Goblin knights and helmet crabs in the Knight Stronghold drop armour shards. A few make a cluster that you smelt into knightmetal."
		"&7Occult Era · netherite armour helps before the stronghold.&r"
	]
	quest.21DA0E50BE31704E.quest_desc: ["A fabric infused with ectoplasm. Ectoplasm is left by the {entity.goety.wraith} and necromancers, and dungeon chests hold some."]
	quest.21DFA1F1BDCD2BAD.quest_desc: ["A snowy forest with yeti caves. Winter wolves roam here too."]
	quest.21DFA1F1BDCD2BAD.title: "{biome.twilightforest.snowy_forest}"
	quest.21EE8EDBCFE599FA.quest_desc: ["Citadel ruins on the End islands. Ender golems guard them, and the Ender Guardian waits inside."]
	quest.21EE8EDBCFE599FA.title: "The Ruined Citadel"
	quest.220BF34E81594BBB.quest_desc: ["Upgrades for the diesel engine. The turbocharger speeds it up and the silencer quiets it. Use them on a placed engine."]
	quest.220BF34E81594BBB.title: "Turbo and Silencer"
	quest.220D99ADA2A46ECE.quest_desc: ["The Mark glyph stores a target in the reliquary, and the Recall glyph casts a spell on it even from afar. That is how you enchant an animal or a friend without aiming."]
	quest.220D99ADA2A46ECE.title: "Reliquary and Marks"
	quest.223D3450225DF280.quest_desc: ["Villagers pay emeralds for goods, and in the mountains you can mine them with an iron pickaxe. One goes into the seal."]
	quest.223D3450225DF280.quest_subtitle: "Seal ingredient"
	quest.22437698C9D290F1.quest_desc: ["The solar neutron activator turns lithium from thermal evaporation into tritium. It works only in sunlight."]
	quest.226066D076DB72F9.quest_desc: ["The large engine burns less refined fuels such as heavy oil. A cheaper version from cast iron and a precision mechanism runs weaker."]
	quest.226B5E9871BD4B07.quest_desc: ["Windows that join into larger panes, shutters and curtains, plus barn doors, Japanese doors and many more."]
	quest.226B5E9871BD4B07.title: "Windows and Doors"
	quest.226B92AA16E960DD.quest_desc: [
		"A third tier forge ritual: a diamond, three xpetrified orbs and a stellarite piece. Applied with the template, the stella gives the eternal modifier: the item never wears out."
		""
		"&7More quests on this page appear here once your team enters the Atomic Era.&r"
	]
	quest.226B92AA16E960DD.quest_subtitle: "Milestone"
	quest.226B92AA16E960DD.title: "&d{item.forbidden_arcanus.eternal_stella}"
	quest.226D53B73B909667.quest_desc: ["The monitor shows radar contacts, and the network controller ties radars, monitors and cannons together. Data links connect them."]
	quest.226D53B73B909667.title: "Command Post"
	quest.2291593A958925D8.quest_desc: ["The treasury gauntlet hurls weapons and tools from your inventory at the target. It is one of the strongest Mahou Tsukai spells."]
	quest.22A14F87C3A390C4.quest_desc: ["Shows how much oil the chunk you stand in holds. Deposits vary by biome."]
	quest.22A3C26E3E0D39FE.quest_desc: ["Mine it from ore in stone and ice. With string it makes a matchbox."]
	quest.22AD74328667EB0E.quest_desc: [
		"&7Steam and Steel Era. Recommended gear: light armour and plenty of food.&r"
		"The Sculptor does not fight head-on; he sets a timed trial. Give him a bluff rod and the trial begins."
	]
	quest.22AD74328667EB0E.quest_subtitle: "Boss"
	quest.22AD74328667EB0E.title: "&c{entity.mowziesmobs.sculptor}"
	quest.22BF57F69C5046CC.quest_desc: ["Who the final boss is and where to find them will be revealed in a later version of the pack."]
	quest.22BF57F69C5046CC.quest_subtitle: "Coming soon"
	quest.22BF57F69C5046CC.title: "The Final Boss"
	quest.22EEE101E48BF0D3.quest_desc: ["A great foundry full of furnaces and guards. One of the hardest Dungeons Arise dungeons."]
	quest.22EEE101E48BF0D3.quest_subtitle: "Milestone"
	quest.22EEE101E48BF0D3.title: "&aThe Foundry"
	quest.23266B3F8753E129.quest_desc: [
		"The “{key.buildinggadgets2.settings_menu}” key opens the gadget menu: shape, range and options. Pick the building block by sneak-clicking it with the gadget."
		"“{key.buildinggadgets2.undo}” undoes the last operation and returns the blocks, and “{key.buildinggadgets2.anchor}” pins the preview in place."
	]
	quest.23266B3F8753E129.title: "Gadget Controls"
	quest.232A7048AAB962B3.quest_desc: ["A forest so dense that it is night inside even at noon. The goblin knights' stronghold stands beneath it."]
	quest.232A7048AAB962B3.title: "{biome.twilightforest.dark_forest}"
	quest.233928C48BE0A92F.quest_desc: [
		"Malignant lead from the well, null slate, iron and netherite scrap infused on the altar. This alloy is the material of Malum's strongest weapons and armour."
		""
		"&7The well makes malignant lead from cthonic gold.&r"
	]
	quest.233928C48BE0A92F.quest_subtitle: "Milestone"
	quest.233928C48BE0A92F.title: "&d{item.malum.malignant_pewter_ingot}"
	quest.233AD6DD519D24F7.quest_desc: ["A gilded ring infused on the altar with alchemical calx gains a power of its own. The encyclopedia describes what each ring does."]
	quest.233AD6DD519D24F7.title: "An Infused Ring"
	quest.233B8B05A1B1325C.quest_desc: [
		"With legendary ink the {block.irons_spellbooks.scroll_forge} forges a spell at its highest level. Brew it in the alchemist cauldron from epic ink and amethyst."
		"Add a rune of one of this era's new schools: eldritch, aero, necro, abyssal or technomancy. The rune makes that school's upgrade orb and robes."
	]
	quest.233B8B05A1B1325C.quest_subtitle: "Milestone"
	quest.233B8B05A1B1325C.title: "&dHigher Iron's Magic"
	quest.233EA7A2BDBBC6FE.quest_desc: ["Fire the fireclay balls in a furnace and assemble the bricks into blocks. The blast furnace and the blast stove are built from them."]
	quest.2346A65B464D6FC8.quest_desc: ["It drops from the Ender golems in the citadel. Used, it summons void runes, and in the Transcendent Era you can fuse it with a weapon on the fusion anvil."]
	quest.235048A9649248B7.quest_desc: ["Charges certus quartz crystals with power. A Tesla coil does the same."]
	quest.235E8E9DF9330392.quest_desc: [
		"Once you have this era's milestones, hand in the &6Seal of the Arcane Era&r. Your whole team enters the Arcane Era and the seal is consumed."
		""
		"You make the seal on Create mechanical crafters arranged in a 5×5 grid: 8 steel ingots, 4 steel casings, 4 precision mechanisms, 2 heavy machinery casings, a diesel engine and the trophies of an Aether boss and a second boss of this era."
		""
		"&7See the exact recipe in JEI: hover over the seal and press R.&r"
	]
	quest.235E8E9DF9330392.quest_subtitle: "Hand in the seal"
	quest.235E8E9DF9330392.title: "Gate: Arcane Era"
	quest.236EA965089911A1.quest_desc: [
		"The simple reforging table upgraded with netherite, nether bricks and arcane sands. It also rerolls items of higher rarities."
		""
		"&7The next enchanting tier appears here once your team enters the Steam and Steel Era.&r"
	]
	quest.23750D7C810A77A0.quest_desc: ["Cross into the Otherside, the dark mirror of the depths. Any sound can give you away here."]
	quest.23750D7C810A77A0.quest_subtitle: "Milestone"
	quest.23750D7C810A77A0.title: "&aThe Otherside"
	quest.23836E97A240F2B6.quest_desc: ["A steam vent fills a balloon with steam from a boiler instead of hot air. On a redstone signal the balloon above slowly fills, and the higher you fly, the weaker the lift."]
	quest.2387B9D72ABC5D39.quest_desc: ["Deep Aether adds new biomes and resources to the Aether, this gem among them. It makes tools and the {block.deep_aether.combiner}."]
	quest.23A48EAF4BEDC309.quest_desc: ["Combines two gases into a third: hydrogen and chlorine into hydrogen chloride for the injection chamber, and sulfur oxides with water vapour into sulfuric acid."]
	quest.23A5D59414CC6E6C.quest_desc: ["A Tabula Robur on a tier two altar for 5000 essence. It goes into the Athanor, keys and stronger sigils."]
	quest.23B5A7698BD6D44E.quest_desc: [
		"Face two deployers towards each other and run them together. Even machines can say hello."
		""
		"&7This is a hidden Create advancement.&r"
	]
	quest.23B5A7698BD6D44E.title: "Fist Bump"
	quest.23E0C8406D19EB10.quest_desc: ["Chairs, tables, cupboards, benches and couches from every wood. You can sit on chairs and couches."]
	quest.23E0C8406D19EB10.title: "Handcrafted Furniture"
	quest.23E3AC5DF323924B.quest_desc: ["Attach it to a packager and the container behind it joins a stock network. Links on the same frequency form one storage."]
	quest.23FB35A36A8E92AB.quest_desc: ["A cloggrum battleaxe upgraded with a forgotten ingot and a smithing template. It deals extra damage to Undergarden creatures."]
	quest.240DC665B9267FC1.quest_desc: ["Yetis and winter wolves drop it."]
	quest.24332F4F1D307691.quest_desc: ["The true sight staff lets you see and use otherworld blocks without the Third Eye. It joins netherite, an iesnium pickaxe, the goggles and the divination rod."]
	quest.243E658F0728D5F0.quest_desc: ["There is no air beyond Earth. Fill the suit with oxygen in an &a{block.northstar.oxygen_filler}&r."]
	quest.243E658F0728D5F0.quest_subtitle: "Space, optional"
	quest.243E658F0728D5F0.title: "A Space Suit"
	quest.244A168AD0A54CC0.quest_desc: ["Place the alchemist cauldron over a fire and fill it with water. You brew inks and elixirs in it, and dissolve scrolls into ink of their rarity. The recipe needs cinder essence from the Citadel."]
	quest.244A168AD0A54CC0.quest_subtitle: "Milestone"
	quest.244A168AD0A54CC0.title: "&d{block.irons_spellbooks.alchemist_cauldron}"
	quest.2456FAEA2D8430DE.quest_desc: ["The stratus ingot combines gravitite, zanite, ambrosium, skyjade and a chromatic aercloud. With a smithing template it upgrades gravitite tools."]
	quest.246B854E14E11E69.quest_desc: ["The heart of the storage: it joins all touching chests, barrels and drawers into one. The recipe needs a diamond and an ender pearl."]
	quest.2496D0A0AD764DEF.quest_desc: ["Raises an iron chest or barrel to gold without taking anything out."]
	quest.24BF3CEF77D3E18F.quest_desc: ["Smelted demonite. Hellforged blocks stand at the corners of the fourth altar tier."]
	quest.24E8693D28F639B3.quest_desc: ["A compact thruster that burns items fed from the back. Redstone only switches it on and off, and a wrench opens the hatch so it pulls fuel from a container behind it."]
	quest.2531F54FBEAF72E7.quest_desc: ["Netherrack in an iron-sheet cage. The empty burner awaits its tenant: a blaze from a Nether fortress."]
	quest.2536E4E3E70DC00D.quest_desc: ["The diamond pickaxe is this era's pickaxe. It mines obsidian, and &a{block.minecraft.ancient_debris}&r in the Nether, though netherite is only useful from the Occult Era."]
	quest.2537778683EE14B8.quest_desc: ["The rocket station assembles a rocket from the blocks around it. The thrusters must lift its weight, and the fuel must last for takeoff and landing."]
	quest.2537778683EE14B8.quest_subtitle: "Space, optional"
	quest.2537778683EE14B8.title: "A Rocket"
	quest.253C930EB219FE08.quest_desc: ["Skyroot meadows, groves and forests cover most of the islands. Visit all four."]
	quest.253C930EB219FE08.title: "Heavenly Lands"
	quest.2550DEF59C35F62D.quest_desc: ["Converts TFMG power into FE, and a wrench reverses the direction. It comes in handy in the Electric Era, when other mods' machines start asking for FE."]
	quest.255A7CF38560FEC5.quest_desc: [
		"The Queen accepts gifts and repays them with her treasures. Hand her an item she desires and make your first trade."
		""
		"&7Her wishes lead along a whole path of tasks. The game itself shows you the next ones.&r"
	]
	quest.255A7CF38560FEC5.title: "Trading with the Queen"
	quest.255E891A81367224.quest_desc: ["An advanced circuit infused with diamond, or crafted with reinforced alloy. Elite machines and the seal need it."]
	quest.255E891A81367224.quest_subtitle: "Milestone · seal ingredient"
	quest.255E891A81367224.title: "&6{item.mekanism.elite_control_circuit}"
	quest.256AD9DDA355EE72.quest_desc: ["Deep Aether adds glowing forests, root-filled swamps and golden groves. Visit all three."]
	quest.256AD9DDA355EE72.title: "Deep Aether Lands"
	quest.25766DCD8399424B.quest_desc: ["Red and blue crystals grow in clusters. Crystallized moths drop them too."]
	quest.25766DCD8399424B.title: "Starlight Crystals"
	quest.25867B0BB2EE1A4A.quest_desc: ["A nether star set in obsidiansteel. Two go into the ritual for the forge's final tier."]
	quest.25AE29D7257C1471.quest_desc: ["The ember charm lets you walk through fire and swim in lava, and the golden charm keeps piglins calm, even the brutes of bastions. The recipes need Nether materials."]
	quest.25AE29D7257C1471.title: "A Nether Charm"
	quest.25B68A79B76C1A6E.quest_desc: ["Wear the ring and the pendant in the Aether accessory slots. They speed up mining but wear out over time."]
	quest.25B68A79B76C1A6E.title: "Zanite Accessories"
	quest.25C9537871EC57AD.quest_desc: ["An abandoned mages' library full of shelves and chests. The locate ritual points to it when you add a mage's spell book as the augment."]
	quest.25C9537871EC57AD.title: "Arcane Library"
	quest.25DCE51A4AB9A318.quest_desc: ["A pumpjack placed over a deposit pumps up crude oil as long as you drive its crank. Ponder (W) shows how the parts fit together."]
	quest.25DCE51A4AB9A318.title: "Pumpjack"
	quest.25F4A771BFBB0972.quest_desc: ["Build the altar in any shape and put an icon on top. Candles, undead skulls and potted herbs raise its power and capacity."]
	quest.25F4A771BFBB0972.quest_subtitle: "Milestone"
	quest.25F4A771BFBB0972.title: "&d{block.eidolon_repraised.wooden_altar}"
	quest.2609C52866399126.quest_desc: ["A cabinet for items that don't stack: armour, tools and books. It holds hundreds of them in one block."]
	quest.260B570DCA9E5020.quest_desc: [
		"A pair for working at chests. The first one unloads the backpack into a chest, the second one refills the backpack from it."
		""
		"&7Click a chest with the backpack in hand while it holds one of these upgrades.&r"
		""
		"&7The next backpack tier appears here once your team enters the Brass Era.&r"
	]
	quest.260B570DCA9E5020.title: "Deposit and restock"
	quest.260EF6790AB0DD46.quest_desc: ["A master-level cleric sells them for emeralds. The enchanting table can also infuse a honey bottle (Apothic Enchanting, JEI shows the requirements)."]
	quest.260EF6790AB0DD46.quest_subtitle: "Seal ingredient"
	quest.261335FB971DA14D.quest_desc: ["Ctrl+Z (“{key.effortlessbuilding.undo.desc}”) undoes the last operation and returns the blocks, and Ctrl+Y (“{key.effortlessbuilding.redo.desc}”) brings it back."]
	quest.261335FB971DA14D.title: "Undo and Redo"
	quest.261539431DEB222E.quest_desc: ["A relay infused with an elemental essence holds more source and moves it faster. The air warp relay loses no source over long distances."]
	quest.261539431DEB222E.title: "An Elemental Relay"
	quest.2623D024969E7385.quest_desc: ["The Aether portal is a glowstone frame built like a Nether portal. Instead of lighting it, pour a bucket of water inside."]
	quest.2623D024969E7385.title: "Portal Frame"
	quest.262E98621F8A1CE1.quest_desc: ["The Ice Maze covers the deep frozen ocean. You will find the horn on frozen pirate ships; blown near water in the Maze, it summons the ghost of Captain Cornelia."]
	quest.262FFF670ED3B561.quest_desc: ["Dig gravel: every now and then flint drops instead. You will find gravel on beaches, in rivers and in caves."]
	quest.262FFF670ED3B561.title: "Flint"
	quest.26412E182F0C2985.quest_desc: ["The cauldron on a brazier dissolves items in sal ammoniac and extracts alchemical sulfur. Each item gives its own kind of sulfur."]
	quest.26463696FC5F0A44.quest_desc: ["A borehead bearing with rock cutting wheels breaks the blocks around it, and the spoil goes into a container on the machine. The more blocks it cuts at once, the slower it works – several bearings help."]
	quest.26463696FC5F0A44.title: "Tunnel Borer"
	quest.264D9A9FF745734F.quest_desc: [
		"A fortified Dungeons and Taverns keep. Get your netherite armour ready."
		""
		"&7More quests on this page appear here once your team enters the Arcane Era.&r"
	]
	quest.264D9A9FF745734F.title: "The Nether Keep"
	quest.2659E6310DEA48BF.quest_desc: ["It smelts mined ores into ingots on the spot. Make it from fiery ingots and blaze rods."]
	quest.2685C26F4B824914.quest_desc: [
		"Sharestones of the same colour form their own network. Anyone standing at one can travel to the others."
		""
		"&7The dye in the recipe sets the colour. The example in this quest is red.&r"
	]
	quest.2685C26F4B824914.title: "A Sharestone"
	quest.269935BB659540D5.quest_desc: ["Gives a redstone signal when a train passes over it. Handy for opening gates, turning on lights and counting trains."]
	quest.269B4A0F6D104CD5.quest_desc: [
		"Holds eight kinds of items, several stacks each. While it stands nearby, take a tool from it with the toolbox key, without walking over."
		""
		"&7Find the key in the controls settings, in the Create category.&r"
	]
	quest.269B4A0F6D104CD5.title: "A Toolbox"
	quest.26A12B7B06B01A8B.quest_desc: ["Links FE-compatible blocks with wire from a spool. Click one connector with the spool, then another, and a wire up to 16 blocks long hangs between them."]
	quest.26BBD5B2344AE9DD.quest_desc: [
		"An autocannon fires bursts of small rounds. You assemble the barrel, breech and recoil spring on a mount like a big cannon, and the longer the barrel, the farther it reaches."
		""
		"&7Ponder (hold W over the item) shows the whole process.&r"
	]
	quest.26BBD5B2344AE9DD.quest_subtitle: "Milestone"
	quest.26BBD5B2344AE9DD.title: "&6Autocannon"
	quest.26FCFAC9F50EB8B8.quest_desc: ["Hold 256 plastic sheets at once. Naphtha from the tower must reach the vat on its own, and the molten plastic the casting basins."]
	quest.26FCFAC9F50EB8B8.quest_subtitle: "Automation proof"
	quest.26FCFAC9F50EB8B8.title: "Plastics Plant"
	quest.2727899B40E6FCB5.quest_desc: [
		"An anvil of witherite, a redstone block and an anvil. It fuses Cataclysm weapons with boss spoils into stronger versions."
		"&7JEI shows the fusion recipes.&r"
	]
	quest.2727899B40E6FCB5.quest_subtitle: "Milestone"
	quest.2727899B40E6FCB5.title: "&c{block.cataclysm.mechanical_fusion_anvil}"
	quest.27825E14F5EFD331.quest_desc: ["Platinum cables and relays carry FE from the generator to the thrusters across the whole ship."]
	quest.27825E14F5EFD331.title: "Ship Cables"
	quest.278324518B998706.quest_desc: ["The sugar water floor, the howling constructs and the bumbling beepartments. Visit all three."]
	quest.278324518B998706.title: "Farther Lands of the Hive"
	quest.2793B906977DEB56.quest_desc: ["The distiller on a brazier breaks items down into mercury shards: stone, wood, food, ores. Ores and gems give the most."]
	quest.27A1799DC6990398.quest_desc: ["The ender pearl school is teleportation: deflecting projectiles, leaving your body to scout, leaving an enemy lost in space."]
	quest.27A1799DC6990398.title: "Displacement scroll"
	quest.27E16132574AA37D.quest_desc: [
		"&7Atomic Era · a bow or crossbow, blocks and slow falling potions recommended&r"
		""
		"The portal to the End lies in a stronghold underground. A plain eye of ender won't open it: the frame takes the End Remastered eyes scattered across the world."
	]
	quest.27E16132574AA37D.title: "The Stronghold"
	quest.27E650F71B02D6DE.quest_desc: ["Every defeated &c{entity.minecraft.warden}&r leaves one behind. Use it on the frame in the centre of an ancient city to open the way to the Otherside."]
	quest.27F81222D3A6025A.quest_desc: [
		"Runs a programmed list of moves: turn by an angle, wait or change direction. A redstone signal starts the sequence, so this is how you drive a gate or a lift that must stop at an exact spot."
		""
		"&7More quests on this page appear here once your team enters the Occult Era.&r"
	]
	quest.280585C62F8445F8.quest_desc: [
		"Andesite taught you to turn shafts; brass will teach your machines to think. Deployers, arms and precision mechanisms will do what your hands did so far. The heat brass needs lies in the Nether: you will lock a living blaze inside a blaze burner."
		""
		"The era ends at the gate. It requires the milestones of this chapter's branches, two different bosses of this era and the Seal of the Occult Era."
	]
	quest.280585C62F8445F8.quest_subtitle: "Precision and Nether fire"
	quest.280585C62F8445F8.title: "Brass Era"
	quest.281BEC79A64C38D4.quest_desc: ["The tavern shelters your first citizens and draws travellers to the colony."]
	quest.281BEC79A64C38D4.title: "Tavern"
	quest.28252955AB6B8194.quest_desc: ["The enchanted turret casts spells for half the source a basic one uses. Upgrade it in the apparatus from a basic turret and a blaze rod."]
	quest.2852B3A9FFBC1CBC.quest_desc: ["A desert palace of domes and courtyards. The vault lies deep inside."]
	quest.2852B3A9FFBC1CBC.title: "The Shiraz Palace"
	quest.2855F0FE224BA179.quest_desc: ["The splitter divides source among several targets, the collector pulls it from nearby jars and the depositor pushes it into them. Together they bring source from the whole base to where it is missing."]
	quest.2855F0FE224BA179.title: "A Relay Network"
	quest.2868536622BA4FFD.quest_desc: ["The wand places a whole row of blocks at once, extending the wall you are looking at. It takes the blocks from your inventory."]
	quest.287BFFDA5AC66887.quest_desc: [
		"Wooden towers joined by walkways. Bandits shoot from above, so go up under cover."
		""
		"&7More quests on this page appear here once your team enters the Brass Era.&r"
	]
	quest.287BFFDA5AC66887.title: "Bandit Towers"
	quest.28B27DF06E429109.quest_desc: [
		"Craft it from a raven feather, torchberries and glowstone dust. Death tomes in the Lich Tower drop it too."
		""
		"&7Witches drop glowstone dust before the Nether opens.&r"
	]
	quest.28E3C603D54E2B74.quest_desc: ["Mine it from ore in mud and stone. Stranghouls drop it too."]
	quest.28E41894AEB979A9.quest_desc: ["On the board a knife cuts ingredients and gets more out of them."]
	quest.28E71E107FD72750.quest_desc: [
		"An Occultism spirit locked in an Ars containment jar keeps working and does not weaken over time. A foliot crusher in a jar picks up ores in a 7×7 area by itself, and a janitor puts collected items into the container next to it."
		""
		"&7Ars Ocultas also adds turning silver into gold in the imbuement chamber and a second recipe for the spirit attuned gem.&r"
		""
		"&7More quests on this page appear here once your team enters the Arcane Era.&r"
	]
	quest.28E71E107FD72750.title: "A Spirit in a Jar"
	quest.28F01DF08603843D.quest_desc: [
		"A cogwheel passes rotation to the cogwheels touching it, and each next one spins the other way. Mesh a large cogwheel with a small one at a right angle: the small one spins twice as fast."
		""
		"&7The quest checks the Create advancement for changing the gear ratio.&r"
	]
	quest.28F01DF08603843D.title: "Shifting Gears"
	quest.290774B0AEFAB021.quest_desc: ["The school teaches the colony's children before they grow up and start working."]
	quest.290DB10E94EF7B78.quest_desc: [
		"The replacement mode swaps blocks for the one in your offhand. Handy when you change the material of a finished wall."
		""
		"&7The recipe needs sculk, and you install it with an ender pearl.&r"
	]
	quest.29155B47A363AFE4.quest_desc: [
		"A colony begins with a supply camp or a supply ship. Craft one and place it with right-click: the camp on land, the ship on water. Its chest holds supplies for the start."
		"&7You can found a colony from the Andesite Era. Each team has one colony.&r"
	]
	quest.29155B47A363AFE4.title: "Supply Camp"
	quest.291AED15AEC1A1DF.quest_desc: ["Runes of sacrifice, self-sacrifice, speed, capacity and more replace blank runes. Each strengthens the altar in its own way."]
	quest.291AED15AEC1A1DF.title: "Upgrade rune"
	quest.2921C903D0EDCF42.quest_desc: [
		"&7Arcane Era. Recommended gear: full netherite armour and room to dodge.&r"
		"The ancient ruler sleeps in the pyramid's tomb. Wake him with the necklace of the desert used on the cursed tombstone."
	]
	quest.2921C903D0EDCF42.quest_subtitle: "Boss"
	quest.2921C903D0EDCF42.title: "&c{entity.cataclysm.ancient_remnant}"
	quest.2947E65344724C83.quest_desc: [
		"When you lose all your health you do not die at once: you lie bleeding out for a minute. Monsters leave you alone meanwhile."
		"Another player can pick you up: they walk up, right-click you and stay with you for a few seconds. If nobody makes it in time, you die."
	]
	quest.2947E65344724C83.title: "Bleeding Out"
	quest.295CE1D4F14CC6C6.quest_desc: ["A light staff of gold, amethyst and crimson wood. It boosts spells more than the graybeard staff."]
	quest.2964AB534BFA8134.quest_desc: ["Raids grow with the colony. Barracks with their towers keep a standing garrison of guards."]
	quest.2964AB534BFA8134.title: "Barracks"
	quest.296BB3AFEB41DF5B.quest_desc: ["Emits a redstone signal when QIO holds more of a chosen item than a set amount."]
	quest.296CDA49675D2D41.quest_desc: ["Bind a gadget to an access point from the gadget menu (“{buildinggadgets2.radialmenu.bind}”). The gadget then takes blocks from the ME network instead of your inventory."]
	quest.296CDA49675D2D41.title: "Gadgets on the ME Network"
	quest.296D75B8F62CEBBF.quest_desc: ["The burner heats a basin like a blaze burner but burns liquid fuel. A valve sets how fast it burns."]
	quest.296DD18BE37142AB.quest_desc: [
		"The stonemason crafts stone items that the builder and other workers ask for."
		""
		"&7The next building tier appears here once your team enters the Rune Era.&r"
	]
	quest.296DD18BE37142AB.title: "Stonemason"
	quest.29731F660D3DA782.quest_desc: ["A key from the Ice Maze. It opens frozen chests."]
	quest.297949C483DAFAE8.quest_desc: ["Dig &a{item.twilightforest.liveroot}&r out of the roots under the Twilight Forest. With raw iron and a gold nugget it makes &a{item.twilightforest.raw_ironwood}&r, which you smelt in a furnace."]
	quest.299C53C73D07D349.quest_desc: ["Upgraded hell and sea shelves allow enchanting at level 60. Enchant something at that level."]
	quest.299C53C73D07D349.title: "Enchanting at level 60"
	quest.299D1E3EB5420A9A.quest_desc: [
		"&7Occult Era · recommended: netherite armor&r"
		"The giant gauntlet guards its arena in the Nether."
	]
	quest.299D1E3EB5420A9A.quest_subtitle: "Boss"
	quest.299D1E3EB5420A9A.title: "&c{entity.bosses_of_mass_destruction.gauntlet}"
	quest.29A1B4F506EED9AC.quest_desc: ["Break it and whatever set inside falls out: soul dust or sculk bones."]
	quest.29A5035F491CB927.quest_desc: ["Build the stone brick and skull pile mould from Goety's Black Book, then click the centre skull pile with an animation core. The golem smashes the ground and shoots haunted skulls."]
	quest.29A5035F491CB927.title: "Grave golem"
	quest.29A8547E8CD8E816.quest_desc: ["In the Arcane Era the colony's magic buildings go up to level 5. Upgrade the mystical site to the top level."]
	quest.29A8547E8CD8E816.title: "Mystical Site at Level 5"
	quest.29DF56775F64B9B7.quest_desc: ["Inserts items into the block it hangs on, or takes them out. It works with belts, depots and any container."]
	quest.29E3E195EC322300.quest_desc: [
		"When you die, your inventory stays in your corpse where you fell. Click it to take everything back. Corpses never despawn and do not burn in lava."
		""
		"&7If you die in the void, the corpse is moved to the last solid ground you stood on, and the chat tells you where it lies.&r"
	]
	quest.29E3E195EC322300.title: "Your Corpse"
	quest.29FA9B52AECFE9B0.quest_desc: ["The denizens' mask. The denizens themselves drop it too."]
	quest.2A1448693DAA1057.quest_desc: [
		"A solar heating plate makes heat by day, heat pipes spread it, and a Stirling engine turns it into slow rotation."
		""
		"&cAn overheated block turns into lava.&r"
	]
	quest.2A1448693DAA1057.title: "Heat"
	quest.2A31EA82944F11B9.quest_desc: ["A window onto the whole QIO storage with a crafting grid. Place it anywhere in your base, on the same frequency."]
	quest.2A4BADAE1174CE6C.quest_desc: ["A Wixie in a cauldron crafts the chosen item from ingredients in nearby chests, paying with source. Get the shards by casting Dispel on a weakened witch."]
	quest.2AA19AFB961ECB40.quest_desc: ["Refined soulstone thrown into the well becomes null slate, hex ash becomes void salts and brilliance a mnemonic fragment. All void magic is built from them."]
	quest.2AA19AFB961ECB40.title: "Gifts of the Void"
	quest.2AAE7CE5C05336FE.quest_desc: ["Grinds catalysts into powder, twice as efficiently as a hammer."]
	quest.2AB33C998F600675.quest_desc: ["Place the notes on the table and complete every step the research asks for. A completed research unlocks new knowledge in the codex."]
	quest.2AC141506FCAD20B.quest_desc: ["Build a frame of &a{block.minecraft.stone_bricks}&r like a Nether portal and use the catalyst on it. The gate opens to the Undergarden."]
	quest.2ACD88810219671D.quest_desc: ["Steam 'n' Rails adds narrow, wide and monorail tracks, each with its own bogeys. They come from sequenced assembly, just like regular tracks."]
	quest.2ACD88810219671D.title: "Other Gauges"
	quest.2AD8211BB7320D0C.quest_desc: ["The portable engine burns fuel and gives rotation right on deck, in either direction you choose. Propellers and winches no longer need a shaft from the ground."]
	quest.2AEDE412A25C4EB7.quest_desc: ["Mine lapis with a copper pickaxe. Nine pieces make a block."]
	quest.2AEDE412A25C4EB7.quest_subtitle: "Seal ingredient"
	quest.2B02ECB0F12D0560.quest_desc: ["Holds one stack under a press, spout or arm. Items from a belt stop on it for processing."]
	quest.2B08D966141A354F.quest_desc: ["Sleep through the night away from home without moving your respawn point. Craft it from leather and white wool."]
	quest.2B1F5F8C52550DC4.quest_desc: ["Emits a redstone signal when a chosen item shows up in the container or on the belt in front of it."]
	quest.2B368425699A9796.quest_desc: ["Valkyries in the silver dungeon drop victory medals. The {entity.aether.valkyrie_queen} only fights once you show her ten."]
	quest.2BAE9BE5A39B15E4.quest_desc: ["Right-click a blaze with the empty burner to trap it inside. The burner heats a basin from below: without it the mixer cannot make brass. It burns anything a furnace burns."]
	quest.2BAE9BE5A39B15E4.quest_subtitle: "Milestone"
	quest.2BAE9BE5A39B15E4.title: "&6{block.create.blaze_burner}"
	quest.2BC065FB42C81822.quest_desc: ["A Slice and Dice sprinkler placed below a pipe sprays fluid over a field. Water moistens the soil, and liquid fertilizer from a mixer speeds up crop growth."]
	quest.2BC065FB42C81822.title: "Sprinkler"
	quest.2BC8BAE4708F569F.quest_desc: [
		"Joins the chests touching it, and the chests touching those, into one network. A terminal placed next to it shows all of their contents."
		""
		"&7Cables that reach chests further away come in the Brass Era.&r"
	]
	quest.2BD62E4216762D28.quest_desc: ["Enchanted gravitite is the material for the best tools and armour you can make in the Aether."]
	quest.2BD989936ADA12DA.quest_desc: ["Seventy-five citizens make a town. The colony feeds, defends and expands itself."]
	quest.2BD989936ADA12DA.quest_subtitle: "Milestone"
	quest.2BD989936ADA12DA.title: "&375 Citizens"
	quest.2BE836079DA8F338.quest_desc: ["The throttle lever sets the signal strength with a drag. The linked typewriter assigns redstone link frequencies to its keys, so you steer the ship from the keyboard."]
	quest.2BE836079DA8F338.title: "Captain's Bridge"
	quest.2BF04F18AE1496EB.quest_desc: ["An emerald attuned like the diamond: it stores mana, and spells draw on it by themselves. Right-click with the gem in hand to fill it."]
	quest.2BF8F92CB6FDBD34.quest_desc: ["A mould of diamond mould blocks and stone bricks; click the centre redstone block with an animation core. The golem beats an iron golem, and redstone dust repairs it."]
	quest.2BF8F92CB6FDBD34.title: "Redstone golem"
	quest.2BFB307063CD3DFE.quest_desc: ["The same capacity as the chest, but as a full block. Barrels stack on top of each other and each one still opens."]
	quest.2C00291F2DF8854E.quest_desc: ["An illager warship on the open sea. Sail up in a boat and board it."]
	quest.2C00291F2DF8854E.title: "An Illager Corsair"
	quest.2C0927F294DFDB57.quest_desc: [
		"As the colony grows, raiders start coming at night: barbarians, pirates, mummies, norsemen or amazons, depending on the surroundings. The more citizens, the bigger the raid, up to 40 attackers."
		"&7Guards defend the colony on their own, but they need towers, weapons and armour.&r"
	]
	quest.2C0927F294DFDB57.title: "Raids"
	quest.2C15790615B51709.quest_desc: ["A MEGA fluid cell in a sky bronze housing. It holds the fuel and coolant of a whole reactor."]
	quest.2C1CBA8FBE594500.quest_desc: ["A full drawer destroys the overflow instead of refusing it. A production line won't jam on one overflowing item."]
	quest.2C24ECBBD2B0EA93.quest_desc: ["A strange Incendium structure in the deltas and on the toxic heap. Mind what you switch on."]
	quest.2C24ECBBD2B0EA93.title: "The Nether Reactor"
	quest.2C259674F3EC76FD.quest_desc: ["Your first mage staff. Held in hand it adds spell power and mana, and you cast the spells from your book with it."]
	quest.2C3B730B14D0B5F4.quest_desc: ["Powered by redstone, it creates immense stress and halts the whole network. An emergency stop for a line without a clutch."]
	quest.2C5D76D2F03E010A.quest_desc: ["Gray chalk is coloured with gray paste from a djinni ritual, orange chalk with cursed honey from a possessed bee, glow berries and blaze dust. With lime and white they draw the unbound afrit circle."]
	quest.2C5D76D2F03E010A.title: "Unbound Afrit Chalks"
	quest.2C68A602930B48B0.quest_desc: ["Kodoku worms consume the essence of creatures that killed a lot. Burned near a leyline they charge mana circuits, and under a scrying circle they fuel sympathetic magic."]
	quest.2C73C77BEC4833AF.quest_desc: ["Dropped by the &a{entity.deeperdarker.sludge}&r of the Otherside. A resonarium plate upgrades diamond gear at the smithing table."]
	quest.2C7D10F28D9801A9.quest_desc: ["Ravens sit on the forest floor and fly off when you come close. They drop feathers."]
	quest.2C8D0FB62F8121E4.quest_desc: ["You find raw amaramber by the campfires in torreya forests. With deepslate it makes ingots."]
	quest.2C8D0FB62F8121E4.title: "Amaramber"
	quest.2C9AC13E2C8830DD.quest_desc: [
		"&7Steam and Steel Era. Recommended gear: full netherite armour and a bow.&r"
		"The Snow Queen rules the aurora palace on the Twilight Forest glacier. Defeating the Alpha Yeti opens the way to the glacier."
	]
	quest.2C9AC13E2C8830DD.quest_subtitle: "Boss"
	quest.2C9AC13E2C8830DD.title: "&c{entity.twilightforest.snow_queen}"
	quest.2CBA2AB760AB478A.quest_desc: ["Same as the andesite one, only with a copper ingot on stripped wood. It is the casing of fluid machines."]
	quest.2CBA9CA8E088530B.quest_desc: ["The mark of technomancy from the enchanting apparatus upgrades Ars mage robes into technomancer robes, with netherite and brass added."]
	quest.2CD4C3892F51E589.quest_desc: [
		"Raises the grade of materials, and a better-graded material makes stronger parts. Glowing dust is the catalyst; stronger catalysts push the grade higher."
		""
		"&7The next gear tier appears here once your team enters the Atomic Era.&r"
	]
	quest.2CD4C3892F51E589.title: "Material Grader"
	quest.2CDB41D811879C85.quest_desc: ["Turns an ore block into two dusts, so a vein yields twice the metal a furnace gives. It is the first stage of Mekanism ore processing."]
	quest.2CDB41D811879C85.quest_subtitle: "Milestone"
	quest.2CDB41D811879C85.title: "&6{block.mekanism.enrichment_chamber}"
	quest.2CE6E79CED2CF719.quest_desc: ["The ritual wounds creatures around it and pours their blood into a nearby altar. A mob farm under the well fills the altar without your veins."]
	quest.2CE6E79CED2CF719.title: "Well of Suffering"
	quest.2CE70B2D032B5BC9.quest_desc: ["A forge in Eternal Starlight guarded by the Starlight Golem. It fires a laser and charges."]
	quest.2CE70B2D032B5BC9.title: "The Golem Forge"
	quest.2CEC560B19A80EEB.quest_desc: ["The block makes a current in water or lava that lifts creatures upwards; sneaking lets you descend. Several stacked blocks make a lift."]
	quest.2CEC560B19A80EEB.title: "An Upstream Current"
	quest.2CFF63705ACC187A.quest_desc: ["An access port extends a container: a funnel at the port reaches the chest as if it stood right next to it. A bridge joins two containers into one for the machines attached to it, and its filters decide what goes to which side."]
	quest.2CFF63705ACC187A.title: "Inventory Ports and Bridges"
	quest.2D0756D3B8F8F255.quest_desc: [
		"The simplest source of rotation: you turn it yourself, and turning costs hunger. A shaft carries rotation in a straight line, and a cogwheel passes it to the wheels next to it."
		""
		"&7Tip: hold W over a machine and Ponder shows how it works.&r"
	]
	quest.2D093665DFE1A607.quest_desc: [
		"Grinds whatever lies on it: it polishes like sandpaper and strips the patina from copper blocks. The sandpaper belt is made from sandpaper."
		""
		"&cIt also hurts anyone who stands on it.&r"
	]
	quest.2D16A038D380644A.quest_desc: ["Fill a jar to the brim, 10,000 source, and look at it for a moment. The Seal of the Brass Era uses half of that."]
	quest.2D16A038D380644A.quest_subtitle: "Milestone"
	quest.2D16A038D380644A.title: "&dA Full Source Jar"
	quest.2D39FB7DFBE2104D.quest_desc: ["A possession ritual on a yellow chalk pentacle lures an endermite and a spirit takes it over. The possessed endermite drops end stone, needed for purple chalk, with no trip to the End."]
	quest.2D39FB7DFBE2104D.title: "Possessed Endermite"
	quest.2D3D52F2B87F2530.quest_desc: ["Place a netherite chest, or raise a diamond one, and look at it for a moment. The most space and slots of all chests."]
	quest.2D3D52F2B87F2530.quest_subtitle: "Milestone"
	quest.2D3D52F2B87F2530.title: "&bNetherite Chest"
	quest.2D43CAFA371E62C2.quest_desc: ["Found in pillager outpost chests. On the forge it halves the souls a ritual needs."]
	quest.2D5DB1A8CB01B63C.quest_desc: [
		"Joins drawers into one storage: clicking the controller puts an item into the drawer that already holds it. Pipes and hoppers on the controller see every drawer."
		""
		"&7The recipe needs a block of quartz from the Nether.&r"
	]
	quest.2D5DB1A8CB01B63C.quest_subtitle: "Milestone"
	quest.2D5DB1A8CB01B63C.title: "&bDrawer Controller"
	quest.2D740FB6E14D841B.quest_desc: ["A chant turns an inlay into a symbol: the gold one into a holy symbol, the pewter one into an unholy one. The symbol marks your path and goes into ritual weapons."]
	quest.2D740FB6E14D841B.title: "Patron symbol"
	quest.2D78605463F7CB95.quest_desc: [
		"Crafts \\& Additions and New Age turn Create rotation into FE energy and back. Both speak the same language, so an alternator can feed a New Age motor and a generator coil can fill a Crafts \\& Additions accumulator."
		""
		"&7First power and the main line are in the Electric Era chapter. This page extends it.&r"
	]
	quest.2D78605463F7CB95.title: "Two Mods, One Current"
	quest.2D80529BDE326269.quest_desc: ["Throw effect ingredients and modifiers into the boiling cauldron, then fill a bottle. Every brew raises your skill, and one batch fills more bottles."]
	quest.2D8918AB6C3B8F6E.quest_desc: ["A rocket needs titanium. JEI shows the recipe on Earth, and its ores lie on the Moon and Mars."]
	quest.2D8918AB6C3B8F6E.quest_subtitle: "Space, optional"
	quest.2D913E0C9EA47821.quest_desc: ["The isotopic centrifuge turns waste into plutonium, and the pressurized reaction chamber seals it into a pellet. Plutonium goes into the SPS casing."]
	quest.2DB6774A487237CC.quest_desc: ["A display link reads data from a block, such as a chest's contents or a shaft's speed, and shows it on nixie tubes, a board or a sign. Click the source with it first, then place it next to the display."]
	quest.2DB6774A487237CC.quest_subtitle: "Milestone"
	quest.2DB6774A487237CC.title: "&6Displays"
	quest.2DBDE26CE7155469.quest_desc: ["It lies in the pyramid's suspicious sand: dig it out with a brush. Use the necklace on the cursed tombstone in the tomb to wake the Remnant."]
	quest.2DC73F37C0DDE250.quest_desc: ["A soulwood base performs corrupted versions of the rites, which work differently from the ordinary ones."]
	quest.2DCBC72C3F944226.quest_desc: ["Cut tall grass with your flint knife to get fiber."]
	quest.2DCBC72C3F944226.title: "Plant Fiber"
	quest.2DE9D74BD0C6DF02.quest_desc: ["Made with the lich's anima. Placed, it stops monsters from spawning within 64 blocks."]
	quest.2DEC390F8A2D2C67.quest_desc: ["In the encoding terminal you write a recipe onto a blank pattern: a crafting one for the assembler or a processing one for any machine."]
	quest.2DEC390F8A2D2C67.title: "Patterns"
	quest.2E0363E27CEE1AD6.quest_desc: ["Produce more than 1000 train tracks with the same mechanical press. Such an assembly line is enough for a network joining your whole team's bases."]
	quest.2E0363E27CEE1AD6.quest_subtitle: "Automation proof"
	quest.2E0363E27CEE1AD6.title: "Track Factory"
	quest.2E080B8EFB7EC2D8.quest_desc: ["It lies in the treasure room of a bastion remnant in the Nether."]
	quest.2E1E016F9CBF0947.quest_desc: ["A blaze burner with an anvil. It merges two identical items, applies enchanting templates and strips enchantments off items."]
	quest.2E1E702E3BD75038.quest_desc: ["An electric motor in a bearing: it turns attached blocks by a set angle and stops. Handy for gates and moving bridges."]
	quest.2E263735BD640A91.quest_desc: ["Ignited berserkers drop dying embers, and an ember makes the ashes. Place them on the altar of fire to wake Ignis."]
	quest.2E3B395333FA06C5.quest_desc: ["Use them on something interesting to start a research and get notes. The parchment and magic ink they need are brewed in the crucible."]
	quest.2E3DD95B3CF7A241.quest_desc: ["Load the kit with material, then combine it with a damaged tool in the grid. Silent Gear tools never vanish: a broken one waits to be repaired."]
	quest.2E42D46E6C4A2EB5.quest_desc: ["A saw facing upwards cuts items from a belt or a depot: logs into planks and stone into stairs and slabs, like a stonecutter. Pick the pattern with the filter on the saw."]
	quest.2E42D46E6C4A2EB5.title: "Sawmill"
	quest.2E4D9B3AC027BCB9.quest_desc: ["The highest capacity tier. Upgrade the diamond one on a smithing table with a netherite upgrade template and a netherite ingot."]
	quest.2E59B8AC37A168E2.quest_desc: [
		"&7Occult Era · recommended: netherite armor, fire resistance&r"
		"The echo of the first flamebearer still haunts the Citadel. A &c{item.irons_spellbooks.cinderous_soulcaller}&r used in the Citadel calls it forth."
	]
	quest.2E59B8AC37A168E2.quest_subtitle: "Boss"
	quest.2E59B8AC37A168E2.title: "&c{entity.irons_spellbooks.fire_boss}"
	quest.2E74B463A57CBAE6.quest_desc: ["A ritual with a lodestone, wax, clay, slime and iron. The magnetized modifier pulls mined drops towards you."]
	quest.2E982F6A17705DB1.quest_desc: ["It combines three ingredients into one item. That's how you make moa fodder, which gives your moa new abilities, and antidotes."]
	quest.2EC87D5062CBEECD.quest_desc: ["Water washes the dirty slurry clean. Feed it with a mechanical pipe or an electric pump."]
	quest.2ED9B7D942B426FB.quest_desc: ["New citizens arrive when they have somewhere to live. Five is your first real crew."]
	quest.2ED9B7D942B426FB.title: "Five Citizens"
	quest.2EE263B74754DEEF.quest_desc: ["The belt lifts you above the ground: sneak in the air after a jump or while falling. It also reduces fall damage a little."]
	quest.2EE9355E7B276F19.quest_desc: ["Collect it from piles of pollen. Thrown, it pollinates whatever it hits."]
	quest.2F10A5DFDAA42B80.quest_desc: ["Gilded trinkets of hallowed gold and ornate ones of soul stained steel are the bases of stronger rings and necklaces. Craft them in the grid with leather or string."]
	quest.2F10A5DFDAA42B80.title: "First Trinket"
	quest.2F1140F53A5D0918.quest_desc: ["The second Ars Nouveau book holds more spells and tier-two glyphs. The recipe needs the Nether: a blaze rod and a quartz block."]
	quest.2F1B32CB8BC23435.quest_desc: ["Use it on a placed gold chest, barrel or shulker box and it becomes diamond, contents included."]
	quest.2F55A92371BC96A8.quest_desc: [
		"Jeweller tools make a ring shank and a gem setting. You wear the ring in a jewellery slot, and its traits depend on the materials."
		""
		"&7The next gear tier appears here once your team enters the Brass Era.&r"
	]
	quest.2F55A92371BC96A8.title: "Jewellery"
	quest.2F5E2B7C6B0B7CF7.quest_desc: [
		"A blank runestone and a school focus make a rune. Ice is a frozen bone from strays, lightning a bottle o' lightning, holy a divine pearl, ender an ender pearl, evocation an emerald and nature a poisonous potato."
		""
		"&7Blank runestones turn up in structure chests. Catch lightning with an empty bottle from a charged creeper.&r"
	]
	quest.2F5E2B7C6B0B7CF7.title: "A School Rune"
	quest.2F68DCBD341A3C9C.quest_desc: ["A belt is made from dried kelp. Click one shaft with it, then another: the belt connects them and carries items between machines."]
	quest.2F68DCBD341A3C9C.quest_subtitle: "Milestone"
	quest.2F68DCBD341A3C9C.title: "&6Mechanical Belt"
	quest.2F8AD5BA90EE9B0E.quest_desc: ["Saves copied builds to templates. You can store them or hand them to your team."]
	quest.2F8B0B83AB769D57.quest_desc: ["Golden oak logs drop it when you chop or strip them. It goes into golden darts and moa fodder."]
	quest.2FD92BE711652DD7.quest_desc: ["The calcination oven on a brazier burns items down into alchemical salts. Salt is the second pillar of alchemy."]
	quest.30120A4BCEB66FA2.quest_desc: [
		"Lay a diamond on the empty altar: it draws blood from anyone nearby and makes the orb for 2000 essence. The orb binds you to your Anima, an invisible reservoir of essence."
		""
		"&7Right-click with the orb to give one heart for 200 essence.&r"
	]
	quest.304588F29DCA0962.quest_desc: ["Shows the contents of linked chests in one window: take anything out and craft from the grid. Link a chest with the dominion wand: click the chest, then the lectern."]
	quest.304588F29DCA0962.quest_subtitle: "Milestone"
	quest.304588F29DCA0962.title: "&b{block.ars_nouveau.storage_lectern}"
	quest.30460420DB4243CE.quest_desc: ["A mana bank for the whole base. The &d{item.mahoutsukai.hammer}&r stays in the grid after crushing a gem, so an AE2 pattern grinds the emeralds for you."]
	quest.30460420DB4243CE.quest_subtitle: "Automation proof"
	quest.3046CAD370B59977.quest_desc: [
		"The vat is a machine with attachments. An industrial mixer with a mixer blade turns it into a mixer, and electrodes into an electrolyser or an arc furnace. Some recipes need heat from below."
		""
		"&7Ponder (W) shows how to build the vat.&r"
	]
	quest.3046CAD370B59977.quest_subtitle: "Milestone"
	quest.3046CAD370B59977.title: "&6Chemical Vat"
	quest.305D66011DB67B70.quest_desc: ["Ancient cities lie in the Deep Dark, below the deepslate. Sneak: if the shriekers hear you too often, the &c{entity.minecraft.warden}&r emerges from the ground."]
	quest.305D66011DB67B70.title: "An Ancient City"
	quest.3078D963AD1D07CD.quest_desc: ["The base of almost every chest upgrade. Make it from planks and an iron ingot."]
	quest.30A0FA9A0678057E.quest_desc: ["Eidolon's book covers rituals, chants and crucible alchemy. Make it from a book and rotten flesh."]
	quest.30D627B6B005B82A.quest_desc: ["A weak blood shard on a tier three altar. The Magus orb opens the strongest reagents and anointments."]
	quest.30D627B6B005B82A.quest_subtitle: "Milestone"
	quest.30D627B6B005B82A.title: "&d{item.neovitae.blood_orb_master}"
	quest.30E37DD3E140A94C.quest_desc: ["Mine them from holystone. They heal when eaten and fuel the altar."]
	quest.30F4963AED57C58E.quest_desc: [
		"Points to the nearest biome you pick from a list. Craft it from a compass, a sapling and a log."
		""
		"&7Right-click with it, pick a biome and follow the needle.&r"
	]
	quest.30F4963AED57C58E.quest_subtitle: "Milestone"
	quest.30F4963AED57C58E.title: "&a{item.naturescompass.naturescompass}"
	quest.30F889B304D23008.quest_desc: ["Citizens need a roof over their heads. Every level of a house holds one more citizen, and children are only born when there is a free bed."]
	quest.30F889B304D23008.title: "The First House"
	quest.3111889E8390FD7D.quest_desc: [
		"Amplify, AOE and Extend Time change the glyph placed before them. AOE and Extend Time are tier-two glyphs, so you need the mage's book."
		""
		"&7Amplify needs a diamond pickaxe.&r"
	]
	quest.3111889E8390FD7D.title: "Spell Augments"
	quest.3113D482E74AC6EC.quest_desc: ["The hammer from the bronze dungeon's vault. Right-click to hurl a bolt that knocks enemies back."]
	quest.3136AD1EC33B9618.quest_desc: [
		"Sequenced assembly: a shaft, a capacitor, a steel plate, a spool, a magnet, a steel mechanism and a screwdriver. Spun by Create, it gives the TFMG network voltage and power."
		""
		"&7Ponder (W) explains how voltage and current work.&r"
	]
	quest.3136AD1EC33B9618.quest_subtitle: "Milestone"
	quest.3136AD1EC33B9618.title: "&6{block.tfmg.generator}"
	quest.3156C0BC641154A4.quest_desc: ["Put a mold on the casting table: it decides whether the metal comes out as an ingot, a sheet or a rod. Cast sheets replace the press."]
	quest.3156C0BC641154A4.title: "Graphite Molds"
	quest.315AD5E939A06474.quest_desc: ["Even bigger stacks in every slot. The recipe needs a block of iron."]
	quest.3173281FC6A4AD7F.quest_desc: [
		"A large foundry basin and a store for several molten metals at once. A 5×5 base with a burner under every block gives the highest heat."
		""
		"&7Ponder (W) shows how to build the crucible.&r"
		""
		"&7More quests on this page appear here once your team enters the Steam and Steel Era.&r"
	]
	quest.3173281FC6A4AD7F.quest_subtitle: "Milestone"
	quest.3173281FC6A4AD7F.title: "&6{block.createmetallurgy.industrial_crucible}"
	quest.31747A769E116492.quest_desc: ["Sulfuric acid dissolves ore into a dirty slurry. Make the ultimate circuit it needs from refined obsidian."]
	quest.319B11EE740F7AD2.quest_desc: ["A neglected Structory manor. Search its rooms."]
	quest.319B11EE740F7AD2.title: "An Old Manor"
	quest.31B2CAF0EAD49E39.quest_desc: ["Step through the portal. The Aether is a world of floating islands above the clouds, with its own resources, monsters and the dungeons of four guardians."]
	quest.31B2CAF0EAD49E39.quest_subtitle: "Milestone"
	quest.31B2CAF0EAD49E39.title: "&aInto the Aether"
	quest.31BDCD49649F2389.quest_desc: ["Placed on rails and powered by redstone, it turns the structure above it into a contraption riding a minecart. Drills at the front make it a mining cart."]
	quest.31C108BF7BA13140.quest_desc: ["In the Electric Era every building reaches level 5. In the Atomic Era a level 5 university also opens the capstones of the research branches."]
	quest.31C108BF7BA13140.title: "Level 5"
	quest.31E3AD5655575851.quest_desc: [
		"Coloured chalks are made from impure white chalk and dusts, then purified in spiritfire. Yellow is gold and glowstone dust, light gray silver, iron and calcite, lime emerald dust, research dust and slime."
		""
		"&7Foliot rituals and the crusher give you research dust and ore dusts.&r"
	]
	quest.31E3AD5655575851.title: "Djinni Chalks"
	quest.31E77171081491E5.quest_desc: ["The divine gold of the Hephaestus forge, known from the Arcane Era. Four ingots go into the seal."]
	quest.31E77171081491E5.quest_subtitle: "Seal ingredient"
	quest.31F15E096337E0DC.quest_desc: ["A sourcelink that gathers source from plants growing around it. Place it by a field and a jar next to it fills up on its own."]
	quest.31FB1A7057262F64.quest_desc: ["The sunbird's mask never breaks. Wear it and right-click with another Umvuthana mask in hand to summon a minion."]
	quest.31FC89970B1DD5FD.quest_desc: ["The seal needs 500 mB of honey in the basin. Pour honey bottles into a drain or pump honey straight from a hive through a pipe, then fill a bucket."]
	quest.31FC89970B1DD5FD.quest_subtitle: "Seal ingredient"
	quest.32069A099BF772B3.quest_desc: ["The undertaker of the graveyard can bring a fallen citizen back. A totem of undying helps him with that."]
	quest.32069A099BF772B3.title: "Resurrection"
	quest.323837979728408A.quest_desc: ["Use a wrench to set the rotation direction of each of its four sides separately."]
	quest.324C68335146A18D.quest_desc: ["Lapis-laced string combined with gold, a fermented spider eye or amethyst. Fabrics are sewn into wands, robes and bags."]
	quest.324C68335146A18D.title: "Magical fabrics"
	quest.3258FD13D5F35E82.quest_desc: [
		"The ritual brazier performs the rituals written on tablets. {item.ars_nouveau.ritual_wilden_summon} without augments calls ordinary wildens; with a wilden spike, horn and wing it calls the Chimera."
		"&cWhen summoning the Chimera, the ritual destroys blocks around the brazier.&r"
	]
	quest.3258FD13D5F35E82.title: "Summoning Ritual"
	quest.326A1530E5FB63B5.quest_desc: ["Pre-attuned to budding amethyst. It leads straight to geodes."]
	quest.328C755D0FA95CA1.quest_desc: ["Build a conductor from an andesite casing and a conductor's cap; Ponder (W) shows how. It sits at the controls like a driver, and a conductor whistle calls its train."]
	quest.328C755D0FA95CA1.title: "Conductor"
	quest.329BC48DABA6EB3C.quest_desc: ["Attach a linked transmitter to a button or a lever and it starts transmitting without wires. A wildcard in a frequency slot matches any item."]
	quest.329BC48DABA6EB3C.title: "Linked Buttons"
	quest.32B181A53695DD84.quest_desc: ["Locks a drawer to one item, even when empty, and toggles what the front shows."]
	quest.32CEF1D222B81BC6.quest_desc: ["The largest AE2 cell. A few of them in a drive hold everything you mine until the end of the era."]
	quest.32CEF1D222B81BC6.quest_subtitle: "Milestone"
	quest.32CEF1D222B81BC6.title: "&b{item.ae2.item_storage_cell_256k}"
	quest.32D259A034E9AF5A.quest_desc: ["Crimson iron ore lies in the Nether, in blackstone too. It is the first Silent Gear metal from beyond the Overworld and the base of crimson steel."]
	quest.32DA6AE7A0588DA9.quest_desc: ["Stone infused with spirits becomes twisted or tainted rock. They build the crucible, the catalyzer, pylons and runes."]
	quest.32DA6AE7A0588DA9.title: "Spirit Rocks"
	quest.32E7139ACB7C6856.quest_desc: ["Activate any ritual. A redstone signal on the master stone switches a ritual off before it drains your Anima dry."]
	quest.32E7139ACB7C6856.title: "First ritual"
	quest.32E7321D0E4FCFAE.quest_desc: ["The Ritual of Sentient Evolution raises your armour's upgrade point cap from 100 to 300."]
	quest.32E7321D0E4FCFAE.title: "Sentient evolution"
	quest.32EB4381EE5DADC2.quest_desc: ["The misty swamp opens once the Lich is beaten. The Minoshroom's Labyrinth lies beneath it."]
	quest.32EB4381EE5DADC2.title: "{biome.twilightforest.swamp}"
	quest.330947959EE74AA2.quest_desc: ["Holds one stack of items under a press, a spout or a fan. A funnel next to the depot fills and empties it on its own."]
	quest.33153CDCEDA8E71A.quest_desc: [
		"&7Brass Era · diamond armour and a bow recommended&r"
		""
		"The tower stands in cold biomes. The Night Lich waits at its top and fights from range with bolts and comets, so don't stand still."
	]
	quest.33153CDCEDA8E71A.title: "The Night Lich's Tower"
	quest.3315DA0BECE7D6BF.quest_desc: ["Lets you point out a target by hand to the cannons linked to your network controller."]
	quest.3316BFDBD54152BA.quest_desc: ["The contraption diagram shows the mass and details of a simulated contraption, and a nameplate declares your ship's name."]
	quest.3316BFDBD54152BA.title: "Ship's Papers"
	quest.33185A0BE53A3282.quest_desc: ["A millstone grinds crushed ore into dirty dust, and a fan with water washes it. Clean dust melts without slag, while dirty dust and ore leave some in the basin."]
	quest.33185A0BE53A3282.title: "Dust Instead of Ore"
	quest.332569B85AF86340.quest_desc: ["Click the target block with them, then connect them with a wire. The extractor takes items from a container and the inserter puts them into, say, a distiller."]
	quest.332569B85AF86340.title: "Extractor and inserter"
	quest.333DFBCB08CA734E.quest_desc: ["Ars Technica joins Create and Ars Nouveau. The calibrated mechanism is made in the enchanting apparatus from a precision mechanism, a source gem and amethyst."]
	quest.334453E019970875.quest_desc: ["Carve spirits into runewood logs above the totem base and start the rite with the totemic staff. Depending on the spirits, the rite heals, hastens or fertilises the area."]
	quest.334453E019970875.title: "Totem Rite"
	quest.3355EAD0EB36560D.quest_desc: ["A knife and a hammer made from cobblestone and crude tool parts of cobblestone, dirt and sticks. They are the first tools for anvil work."]
	quest.3355EAD0EB36560D.title: "Crude Tools"
	quest.3363F06A6DFBCF5E.quest_desc: [
		"Places more blocks at once than the stone one and lasts longer."
		""
		"&7The next wand tier appears here once your team enters the Brass Era.&r"
	]
	quest.336D851AB837B72B.quest_desc: ["Leaves, water and milk mixed in a heated basin and poured into a bottle by a spout. The tea gives you energy for a long shift of building."]
	quest.337FE639F840EA54.quest_desc: [
		"The Breaching the Edge of Demon Realm ritual tears the veil and grants limited passage to the other side."
		""
		"&cGo in full armour: the realm does not forgive the unprepared.&r"
	]
	quest.337FE639F840EA54.title: "Breaching the edge"
	quest.338ADE6AAA626A01.quest_desc: ["When thrown, it freezes nearby water and lava and hurts creatures with frost."]
	quest.33A0091499FC8F36.quest_desc: ["Starfire birds nest in aviaries. Put seeds into a nest and see what happens."]
	quest.33A0091499FC8F36.title: "A Starfire Bird Nest"
	quest.33A07B00927692C1.quest_desc: ["Antimatter transmutes one element into another here. It is the most expensive machine in Mekanism."]
	quest.33A627D675FE6251.quest_desc: ["The goblin knights in the stronghold below the Dark Forest drop them."]
	quest.33B90DF516E5C18A.quest_desc: ["A framed drawer takes on the look of chosen blocks, so your storage matches the walls of your base."]
	quest.33C970C359D7003C.quest_desc: ["A brass casing on a shaft or a cogwheel works like the andesite one. It matches the machines of this era."]
	quest.33C970C359D7003C.title: "Brass Encasing"
	quest.33E23E32CF675B67.quest_desc: ["This tool places huts and buildings: pick a style and a building, move and rotate the preview, then confirm the spot."]
	quest.33E5CF4E857A563A.quest_desc: ["Reach 50 citizens in your colony. In this era regular buildings go up to level 4, so houses hold more people."]
	quest.33E5CF4E857A563A.title: "Fifty Citizens"
	quest.33F85A892ECD3628.quest_desc: ["Osmium infused with redstone makes a basic circuit. Another redstone infusion raises it a tier."]
	quest.33F85A892ECD3628.title: "Control Circuits"
	quest.33FEC4DE0C0A63E9.quest_desc: ["The Chipped mason table inside the chest: change the pattern of a whole stack of stone without taking it out."]
	quest.3403B299F3A18DDE.quest_desc: ["It catches packages from a chain conveyor and drops them into the block below. A package with an address finds the frogport with that address."]
	quest.340FA0F3FA52DF21.quest_desc: [
		"&7Transcendent Era · your best armour, water breathing and healing recommended&r"
		""
		"Each eye flies like an eye of ender to a different lair: the abyss eye to the Leviathan's sunken city, the storm eye to Scylla's acropolis, the mech eye to the Harbinger's factory and the cursed eye to Maledictus's frosted prison."
	]
	quest.340FA0F3FA52DF21.title: "Four Eyes"
	quest.3410C89A9D4ECE16.quest_desc: ["Dropped by a monster spawner broken without Silk Touch. You need it for the forge's second tier and the quantum catcher."]
	quest.343AE35599EB3B9F.quest_desc: ["Mine a monster spawner with Silk Touch. Clicked with a modifier item it changes: faster spawns, more mobs, or no player needed nearby; JEI lists the modifiers."]
	quest.343AE35599EB3B9F.title: "A spawner to order"
	quest.343DECE264FF7969.quest_desc: ["In a grove of the enchanted forest stands a ram that collects wool of every colour. Bring it all of them and it pays you well."]
	quest.343DECE264FF7969.title: "The Questing Ram"
	quest.344182A6E8AC0FC2.quest_desc: ["The colony gauge works like a Create factory gauge, but watches the stock in the colony warehouse."]
	quest.3444696FE5AB66F7.quest_desc: ["The laser gatling reloads with redstone from your inventory, and the shoulder launcher fires Wither missiles."]
	quest.3444696FE5AB66F7.title: "Witherite Firearms"
	quest.3466C6850CF3CB85.quest_desc: ["Smelt copper ore into ingots and make a pickaxe from them. This one can mine iron and lapis."]
	quest.34720DBA5808E08F.quest_desc: ["Geodes are spheres of amethyst hidden deep underground. Break a few crystals."]
	quest.3473E1E598D45E1B.quest_desc: [
		"A press over a heated basin makes cast iron from iron and coal, and a mixer makes bronze from copper and tin. Your first cannons are cast iron, and bronze withstands more powder charges."
		""
		"&7This page goes further than the Steam and Steel Era tree: materials, loading, shells, autocannons and radars.&r"
	]
	quest.3473E1E598D45E1B.title: "Cast Iron and Bronze"
	quest.347DEDC7446DE92B.quest_desc: [
		"&7Gear: good armour and healing potions.&r"
		"It hides in the maze of the Cursed Garden in Eternal Starlight. It bites and breathes on you."
	]
	quest.347DEDC7446DE92B.quest_subtitle: "Boss"
	quest.347DEDC7446DE92B.title: "&c{entity.eternal_starlight.lunar_monstrosity}"
	quest.348394C3775B7011.quest_desc: ["The sludges of the Otherside drop resonarium. With a scute it makes a plate that upgrades diamond gear."]
	quest.34E295E7E33234F0.quest_desc: ["A &6{block.create.mechanical_mixer}&r above a &6{block.create.basin}&r combines ingredients into one product. This era it works without heat, which is exactly how you mix the Seal of the Rune Era."]
	quest.34E295E7E33234F0.quest_subtitle: "Milestone"
	quest.34E295E7E33234F0.title: "&6Mixer and Basin"
	quest.34FCF10413455693.quest_desc: [
		"Once you have this era's milestones, hand in the &6Seal of the Brass Era&r. Your whole team enters the Brass Era and the seal is consumed."
		""
		"The seal is made in the &d{block.ars_nouveau.enchanting_apparatus}&r for 5000 source. An andesite casing goes in the middle, and on the pedestals: a Naga or Lich trophy, a Chimera or Dead King trophy, 2 arcane essences, a source gem block, a press, a water wheel and a diamond."
		""
		"&7See the exact recipe in JEI: hover over the seal and press R.&r"
	]
	quest.34FCF10413455693.quest_subtitle: "Hand in the seal"
	quest.34FCF10413455693.title: "Gate: Brass Era"
	quest.35309C9C31AF6733.quest_desc: ["An elite circuit infused with refined obsidian, or crafted with atomic alloy. Four go into the seal, more into reactors and QIO."]
	quest.35309C9C31AF6733.quest_subtitle: "Seal ingredient"
	quest.353C2D82DCE53DB0.quest_desc: ["A satchel with a bound spirit inside holds far more than a plain backpack. Make it with a ritual using the foliot book."]
	quest.353F03168ACA145D.quest_desc: ["A ship trapped in the ice of the Maze. Shell horns lie on ships like this."]
	quest.353F03168ACA145D.title: "A Frozen Pirate Ship"
	quest.3556EF8DB6928840.quest_desc: ["Wizard robes upgraded on a smithing table with a netherite ingot and a template. They protect like netherite and still add mana."]
	quest.3556EF8DB6928840.title: "Netherite Battlemage Robes"
	quest.35637111DF6F0546.quest_desc: ["Defeat one of the three bosses of Eternal Starlight. The trophy completes the seal."]
	quest.35637111DF6F0546.quest_subtitle: "Milestone"
	quest.35637111DF6F0546.title: "&cA Boss of Eternal Starlight"
	quest.358740A581AB8CF6.quest_desc: ["Source gems pressed into a block. The block goes on a pedestal for the Seal of the Brass Era and is also needed for the ritual brazier."]
	quest.358740A581AB8CF6.quest_subtitle: "Seal ingredient"
	quest.3591035E480F9F81.quest_desc: ["The Highlands open once the Hydra, the Ur-Ghast and the Snow Queen are defeated. Trolls live in their caves."]
	quest.3591035E480F9F81.title: "{biome.twilightforest.highlands}"
	quest.35CD7E283B845D4D.quest_desc: ["A 256M component in a MEGA housing. One such cell holds more than your whole old network."]
	quest.35CD7E283B845D4D.quest_subtitle: "Milestone"
	quest.35CD7E283B845D4D.title: "&b{item.megacells.item_storage_cell_256m}"
	quest.35D86A31BD39AA70.quest_desc: ["A Terralith village behind a stone wall. Ordinary villagers live and trade inside."]
	quest.35D86A31BD39AA70.title: "A Fortified Village"
	quest.35E3E299110837C8.quest_desc: ["Nether skeletons pitch camps in every land. Bring a shield: they shoot straight."]
	quest.35E3E299110837C8.title: "A Skeleton Camp"
	quest.35E5DC242535A7DC.quest_desc: ["A placed backtank fills with compressed air from rotation. Worn with the helmet, it lets you breathe underwater."]
	quest.35E5DC242535A7DC.title: "Diving Gear"
	quest.35EDFF3F0B54D7A7.quest_desc: ["A stone altar from the workbench. It needs a pewter inlay and a soul shard."]
	quest.360452A7B13077A2.quest_desc: ["Made with the gauntlet's blazing eye. It strengthens explosions within 64 blocks by 30%, your machines' ones too."]
	quest.36115C5C4E728E80.quest_desc: ["Copper wire wound on an empty spool. Use it to link connectors into a power grid; the alternator needs one too."]
	quest.361D545118FBE10F.quest_desc: ["A starter from saplings, flowers, logs or planks with sugar. With it, fermentation uses fewer crops."]
	quest.3627C3E79D31B0F5.quest_desc: ["An Incendium altar on the infernal dunes. Approach with care."]
	quest.3627C3E79D31B0F5.title: "The Infernal Altar"
	quest.364475FBFDF50FEF.quest_desc: [
		"The keeper leaves an echo of the void. It goes into the Blade of Ender and several Goety foci."
		""
		"&7The next magic boss tier appears here once your team enters the Transcendent Era.&r"
	]
	quest.368D674C17AF7000.quest_desc: ["Defeat one of the four guardians of the Aether. Its trophy goes into the seal."]
	quest.368D674C17AF7000.quest_subtitle: "Milestone"
	quest.368D674C17AF7000.title: "&cAn Aether Boss"
	quest.36A84F0047BD1221.quest_desc: [
		"The “{key.mechtrowel.open_palette}” key opens the palette manager: pick blocks and their ratios, then save the palette under a name. “{key.mechtrowel.cycle_palette}” switches between saved palettes."
		""
		"&7The trowel turns stairs and slabs on its own; open the rotation settings with “{key.mechtrowel.open_rotation}”.&r"
	]
	quest.36A84F0047BD1221.title: "Palettes"
	quest.36C2E688D613E70B.quest_desc: [
		"Ars Nouveau robes raise your mana and its regeneration. They are made in the apparatus from fibre and an ordinary chestplate: gold gives the light set, iron the medium and diamond the heavy one."
		""
		"&7One piece of any set is enough.&r"
	]
	quest.36C2E688D613E70B.quest_subtitle: "Milestone"
	quest.36C2E688D613E70B.title: "&dMage Robes"
	quest.36D904598742BDBA.quest_desc: [
		"First make black iron armour: iron armour with cursed metal. Then upgrade each piece in a ritual with dark alloy and spirit fabric."
		""
		"&7The next Goety tier appears here once your team enters the Electric Era.&r"
	]
	quest.36D904598742BDBA.quest_subtitle: "Milestone"
	quest.36D904598742BDBA.title: "&dDark armour"
	quest.36E6453ABC7C316F.quest_desc: ["This page leads through the lands and materials of Eternal Starlight. The portal and the bosses are in the Atomic Era tree."]
	quest.36E6453ABC7C316F.title: "Under the Eternal Stars"
	quest.370545ACED798316.quest_desc: ["More space and more upgrade slots. You upgrade the backpack in the crafting grid without losing its contents."]
	quest.3718EA2B8781F518.quest_desc: ["The Dead King leaves this staff or his spell book. The staff strengthens blood school spells."]
	quest.3743B83291F95F8B.quest_desc: ["A high explosive shell only detonates with a fuze. The impact fuze fires on a hit, though not always – Ponder (W) shows how to fit it to the shell."]
	quest.3743B83291F95F8B.title: "High Explosive Shell"
	quest.3760C9F3F8F4AF5B.quest_desc: ["A pouch for magical trinkets: rings, amulets and charms no longer clutter your inventory. Make it from magebloom fibre and a chest."]
	quest.37691B9E4F8EC2E3.quest_desc: [
		"Build the blast furnace from fireproof bricks around the blast furnace output; Ponder (W) shows the layout. Feed it iron ore, raw or crushed, with limesand as flux and coke dust as fuel."
		"Molten steel, slag and furnace gas flow out. Collect 64 steel ingots."
		""
		"&7Crush limestone on crushing wheels to get limesand.&r"
	]
	quest.37691B9E4F8EC2E3.quest_subtitle: "Milestone"
	quest.37691B9E4F8EC2E3.title: "&6Blast Furnace and 64 Steel"
	quest.376CA5305332149B.quest_desc: [
		"Sew the Vizier's garments in rituals with a ruby of souls. When you take damage in the turban, a loyal irk may appear to defend you, and the robe halves incoming damage while you cast."
		""
		"&7The next Goety tier appears here once your team enters the Atomic Era.&r"
	]
	quest.376CA5305332149B.title: "Grand set"
	quest.3777F8DAD393B87E.quest_desc: [
		"Using osmium, the osmium compressor packs dust into refined obsidian or refined glowstone ingots. Refined obsidian goes into ultimate circuits and the x5 machines."
		""
		"&7Obsidian dust infused with diamond in the infuser gives refined obsidian dust.&r"
	]
	quest.3777F8DAD393B87E.title: "Refined Obsidian"
	quest.37846D9D616D6CE4.quest_desc: ["Sequenced assembly from radioactive thorium and an iron sheet. It goes into the reactor through the fuel acceptor."]
	quest.378CA5E0E68216AF.quest_desc: ["Merges an order split across several packages back into one before it reaches the recipient."]
	quest.37909A3A3E2BC83D.quest_desc: ["The Invoker leaves primal essence. It is the key ingredient of the imbuing table."]
	quest.379963716C197A80.quest_desc: [
		"Places even more blocks at once. You will turn it into the netherite one in the Arcane Era."
		""
		"&7The next wand tier appears here once your team enters the Arcane Era.&r"
	]
	quest.37E3EC3906AFB685.quest_desc: ["Converts nuggets, ingots and blocks of one metal on its own. Put in ingots and take out blocks or nuggets."]
	quest.380AC8234042D349.quest_desc: ["Swaps the tool in your hand for the right one for the block you mine. The recipe needs flint tools."]
	quest.3849C43A8E8023EB.quest_desc: ["Make blank parchment from paper and fibre. At the scribe's table you write a spell from your book onto it, and the parchment carries it into turrets and enchanted weapons."]
	quest.38735B84596714C7.quest_desc: ["Place it next to a train station and scheduled trains pick up and deliver packages to other stations."]
	quest.38735B84596714C7.title: "A Postbox"
	quest.3874EF9893EB534D.quest_desc: ["A big cannon fires a projectile pushed by powder charges. Make a charge from packed gunpowder (a press over a basin) and an empty powder charge, and a solid shot from iron and wooden slabs."]
	quest.3874EF9893EB534D.title: "Powder and Shot"
	quest.387CCCD933B895A7.quest_desc: ["Create Ore Excavation hides ore veins beneath chunks. The vein finder shows which vein lies under you."]
	quest.38847639E343984A.quest_desc: ["Stores energy from lasers and fires it all at once into the focus matrix. Only a pulse that strong ignites the fusion reactor."]
	quest.388985B149DFB381.quest_desc: [
		"Places more blocks at once than the copper one. Make it from a stick and an iron ingot."
		""
		"&7The next wand tier appears here once your team enters the Occult Era.&r"
	]
	quest.388BBC84224C1CDD.quest_desc: ["A fortified illager base with walls and towers. Bring a shield."]
	quest.388BBC84224C1CDD.title: "An Illager Fort"
	quest.388E573F8FCCD375.quest_desc: ["The Incendium pipeline runs across the dunes and the deltas. Sentries guard it, and treasure lies at its end."]
	quest.388E573F8FCCD375.title: "The Pipeline"
	quest.389613A30B1FEAEF.quest_desc: ["Line mode ({effortlessbuilding.mode.line}): click the start, move your view and click the end to get a straight line of blocks. The diagonal line ({effortlessbuilding.mode.diagonal_line}) goes at any angle."]
	quest.389613A30B1FEAEF.title: "Line"
	quest.389DDDCC2EE1706F.quest_desc: ["When the network runs out of blocks for a paste, autocrafting can make more. The gadget menu's “{buildinggadgets2.radialmenu.materiallist}” shows which blocks are needed."]
	quest.389DDDCC2EE1706F.title: "Missing Blocks"
	quest.38AC145887B1D1CE.quest_desc: ["A powered polarizer turns a magnetic alloy ingot into a magnet. Before you have power, only a lightning strike on the ingot will do."]
	quest.38C76F24F12C66FA.quest_desc: ["Holds twice as much per block as a copper fluid tank, so your fuel takes less room on deck."]
	quest.38C7D9C19571B0D3.quest_desc: [
		"Opens the storage from afar. First click the actuator with it to link them."
		""
		"&7Awaken the inert accessor with a djinni ritual, an ender pearl and quartz.&r"
	]
	quest.38C84D7F662C57E1.quest_desc: ["Heats an apparatus from a distance. Shift-right-click a machine to target it, then place the emitter on a catalyst; the brazier under the machine is no longer needed."]
	quest.38D51382CFDC27AE.quest_desc: ["Dining chairs, tables, park benches, shutters, curtains and standing lamps. You can sit on chairs and benches."]
	quest.38D51382CFDC27AE.title: "Another Furniture"
	quest.38EA9BA21F0E366C.quest_desc: [
		"The machines turn on their own now, but the world has a second layer. Trees steeped in source grow in the forests, old mages sleep underground, and the Twilight Forest waits beyond a pool ringed with flowers."
		""
		"The era ends at the gate. It requires the milestones of this chapter's branches and the Seal of the Brass Era, which takes trophies of two bosses of this era."
	]
	quest.38EA9BA21F0E366C.quest_subtitle: "Source and Runes"
	quest.38EA9BA21F0E366C.title: "Rune Era"
	quest.38EC208F50A0BAD9.quest_desc: [
		"A foundry mixer above a basin with a glassed lid combines molten metals into alloys. A lit blaze burner must burn under the basin, and the mixer stresses the network more than a regular one."
		""
		"&7The sturdy whisk is made from andesite alloy and an obsidian plate.&r"
	]
	quest.38EC208F50A0BAD9.quest_subtitle: "Milestone"
	quest.38EC208F50A0BAD9.title: "&6Foundry Mixer"
	quest.38FB930EB156032B.quest_desc: ["Soulstone ore lies underground all over the Overworld. Smelted, it gives &d{item.malum.refined_soulstone}&r, the base of everything in Malum."]
	quest.38FD1B3434F75CD4.quest_desc: ["Tungsten wire on a spool is the bulb's filament. The bulb glows brighter the stronger its redstone signal, and comes in every colour."]
	quest.38FD1B3434F75CD4.title: "Light Bulbs"
	quest.38FF3A4D9052C426.quest_desc: ["An Incendium kitchen on the quartz flats. Somewhere inside, the cooks have hidden their treasure."]
	quest.38FF3A4D9052C426.title: "The Quartz Kitchen"
	quest.391678E4D6AFD55A.quest_desc: [
		"The Echo always leaves this shard. It upgrades Iron's Spells robes, such as the priest's robe into paladin armour."
		""
		"&7The next magic boss tier appears here once your team enters the Arcane Era.&r"
	]
	quest.391A056FD94B64A8.quest_desc: ["The Sun Spirit's key opens the gold dungeon's vault with pieces of phoenix armour and a life shard."]
	quest.39238FC1BE69AD2D.quest_desc: [
		"The volcanic sourcelink burns fuel dropped into it and sends source to jars nearby; archwood logs give more."
		"&cIts heat turns nearby stone into magma and then lava.&r"
	]
	quest.39259A7487173A83.quest_desc: ["Puts items into the storage or takes them out. Click it with an item to set a filter."]
	quest.39285D0B4C57342B.quest_desc: ["It summons two sandstorms that circle around you. In the Transcendent Era you can fuse it with a weapon on the fusion anvil."]
	quest.392A5988468C14B9.quest_desc: ["&c{entity.cataclysm.the_harbinger}&r sleeps in this factory of war machines. Find it with an &a{item.cataclysm.mech_eye}&r."]
	quest.392A5988468C14B9.title: "The Ancient Factory"
	quest.392D41496E27C540.quest_desc: ["Click a shaft or a cogwheel with andesite casing to hide it inside a block. The casing does not stop the rotation, and the machine looks tidier."]
	quest.392D41496E27C540.title: "Encased Shafts"
	quest.393B78840727C9FA.quest_desc: [
		"Picked-up items go straight into the backpack. Set a filter in the upgrade window."
		""
		"&7The next backpack tier appears here once your team enters the Andesite Era.&r"
	]
	quest.39402E57007B2EF1.quest_desc: ["Heats the Theurgy machines standing on top of it. It burns ordinary fuel such as coal."]
	quest.39405BD6F08DB507.quest_desc: ["The wand casts spells from foci, paid with soul energy from the totem. Make an &d{item.goety.empty_focus}&r from amethyst and a totem."]
	quest.394E885DF08E66D6.quest_desc: ["Point it at the three pedestals in turn and place it on a catalyst. The array turns a sulfur into another sulfur of the same type, duplicating rare materials."]
	quest.394E885DF08E66D6.quest_subtitle: "Milestone"
	quest.394E885DF08E66D6.title: "&d{block.theurgy.sulfuric_flux_emitter}"
	quest.39701793C6136A1E.quest_desc: [
		"The Ur-Ghast's tears work like the Hydra's fiery blood: with iron they make fiery metal."
		""
		"&7The next Twilight Forest tier appears here once your team enters the Steam and Steel Era.&r"
	]
	quest.39734C68F06A6EAF.quest_desc: ["Throw a &d{item.occultism.datura}&r on the ground and light it with flint and steel. Spiritfire does not burn, it transforms: a book into a taboo book, black dye into purified ink and a feather into an awakened feather."]
	quest.39734C68F06A6EAF.title: "Spiritfire"
	quest.3979A9602B7C68CD.quest_desc: ["Place the pot above a campfire. It cooks meals that keep you fed much longer than raw food."]
	quest.3979A9602B7C68CD.quest_subtitle: "Milestone"
	quest.3979A9602B7C68CD.title: "&a{block.farmersdelight.cooking_pot}"
	quest.397F3CF7D688F608.quest_desc: ["A window onto the whole network: search, take out and put in everything stored in the cells. The search bar also takes mod names after an @."]
	quest.397F3CF7D688F608.quest_subtitle: "Milestone"
	quest.397F3CF7D688F608.title: "&b{item.ae2.terminal}"
	quest.39816569D0AA0B76.quest_desc: [
		"The Lich leaves one of four scepters: twilight (bolts), life draining, zombie (summons zombies) and fortification (shields). Collect all four."
		"&7You recharge a scepter in the crafting grid with the right ingredient; JEI shows which.&r"
	]
	quest.39816569D0AA0B76.title: "Four Scepters"
	quest.39886858DDF3F013.quest_desc: ["Melds the potions of two jars into one with the effects of both. The result goes into a third jar."]
	quest.39A0F4A2446C34AB.quest_desc: ["Cinder essence, an echo shard and netherite scrap. In the Citadel it calls forth the echo of its old master."]
	quest.39D873825657C283.quest_desc: ["Bronze from copper and tin, constantan from copper and nickel, electrum from gold and silver. Cast each on the table in an ingot mold."]
	quest.39D873825657C283.title: "Foundry Alloys"
	quest.39DAC81CDF25F2E4.quest_desc: ["Copies part of a build and pastes it elsewhere. It takes blocks from your inventory or from a bound container."]
	quest.39FC2939A12B04D0.quest_desc: ["Place a &6{block.create.water_wheel}&r in flowing water, e.g. under a small waterfall, and attach a shaft. The quest checks the Create advancement for torque from a water wheel."]
	quest.39FC2939A12B04D0.title: "A Wheel in the Stream"
	quest.3A31BE7E9767010E.quest_desc: ["An empty upgrade orb with a rune of a new school. Applied on the arcane anvil, it strengthens that school's spells."]
	quest.3A31BE7E9767010E.title: "An Orb of a New School"
	quest.3A3B94F8253BF669.quest_desc: ["Andesite alloy comes from andesite and iron nuggets. Use it on a stripped log or stripped wood to get a casing: the body of most machines this era and a seal ingredient."]
	quest.3A3B94F8253BF669.quest_subtitle: "Seal ingredient"
	quest.3A45BE25E27884E8.quest_desc: ["The permafrost forest and the crystallized desert lie farther from the portal. Dress warmly."]
	quest.3A45BE25E27884E8.title: "Frost and Crystals"
	quest.3A4709D64DBBCA86.quest_desc: ["The bones of an ancient dragon lie on the Nullscape islands. Someone has fought here before."]
	quest.3A4709D64DBBCA86.title: "A Dragon Skeleton"
	quest.3A679909B4245D84.quest_desc: ["The gate needs one of this era's Twilight Forest bosses. One is enough, and its trophy goes into the seal."]
	quest.3A679909B4245D84.quest_subtitle: "Milestone"
	quest.3A679909B4245D84.title: "&c{entity.twilightforest.minoshroom} or {entity.twilightforest.hydra}"
	quest.3A6D23379D9C3EE1.quest_desc: ["A wooden lookout tower from Dungeons and Taverns. From the top you can see the whole area."]
	quest.3A6D23379D9C3EE1.title: "A Firewatch Tower"
	quest.3A82F37C4AAF3AED.quest_desc: ["Shows the chosen block, such as an ore, through walls for a while. Add the block to the brazier before you start."]
	quest.3A9C1595C2AC719A.quest_desc: ["Feeds the wand blocks from its own slots, in order or at random. Walls and roads come out less uniform. Change the palette mode with “{key.wands.wand_palette_mode}”."]
	quest.3AA45D765F279AB9.quest_desc: ["A Tabula Animata on a tier three altar for 15,000 essence. Dark veins run through it like frozen lightning."]
	quest.3AB8C371B574C5A3.quest_desc: [
		"A cake of cinder flour, egg and sugar, filled with lava by a spout. A blaze burner fed with it is superheated for a while, and some recipes in JEI need exactly that."
		""
		"&7Crushing wheels turn netherrack into cinder flour.&r"
	]
	quest.3AC1EE154F27EB59.quest_desc: ["A module base is made from HDPE, tin and bronze. The energy unit enlarges the battery, the shielding protects from radiation, and escalation speeds up mining."]
	quest.3AC1EE154F27EB59.title: "First Modules"
	quest.3AD37031A147C8D0.quest_desc: ["A {block.create.spout} pours creosote onto planks to make hardened planks. Apply a steel ingot to them to get a steel casing. Four go into the seal."]
	quest.3AD37031A147C8D0.quest_subtitle: "Seal ingredient"
	quest.3ADA57DAA3F7BDBC.quest_desc: ["A mixer over a superheated burner combines netherite scrap with four steel ingots into eight nethersteel ingots. It is the material for the strongest barrels."]
	quest.3ADA57DAA3F7BDBC.title: "Nethersteel"
	quest.3ADA5B79D2C7D9FA.quest_desc: ["The necklace is worn next to your rings. Amulet patterns give bonuses a ring does not have, such as protection."]
	quest.3AE2BD660E927C20.quest_desc: ["Defeat the Sculptor, the Alpha Yeti or the Snow Queen. The seal needs a trophy of one of them next to the Aether trophy."]
	quest.3AE2BD660E927C20.quest_subtitle: "Milestone"
	quest.3AE2BD660E927C20.title: "&cSecond Boss of the Era"
	quest.3AEE36E47EFE6486.quest_desc: ["The glassblower has glass patterns, the botanist's workbench plants and leaves, and the tinkering table lamps and redstone blocks."]
	quest.3AEE36E47EFE6486.title: "Other Chipped Workshops"
	quest.3AEF793B8A37733E.quest_desc: ["Exposes the container behind it to funnels and pipes as if it were right next to them. From Create: Connected."]
	quest.3B08AA83EFC7BBF8.quest_desc: ["Villages look different in every climate. Visit a desert, a snowy and a taiga village."]
	quest.3B08AA83EFC7BBF8.title: "Villages of the World"
	quest.3B1E0112EC768F9D.quest_desc: ["An interface with twice the slots: it keeps a stock of more items for the fast machines of the Atomic Era."]
	quest.3B2D06241FA8FEF1.quest_desc: ["They load a cannon by hand without a loader, but every block you push into the barrel costs you hunger."]
	quest.3B2D06241FA8FEF1.title: "Ram Rod and Worm"
	quest.3B579F9CC4F9F2C1.quest_desc: ["A hidden pirate shelter in the Ice Maze. See what they left behind."]
	quest.3B579F9CC4F9F2C1.title: "A Pirate Shelter"
	quest.3B78789C071DDD6B.quest_desc: ["Removes whole volumes of blocks at once. Handy when you rebuild your base from scratch."]
	quest.3B8C2C4B236D38E1.quest_desc: ["A first tier forge ritual: a quantum core and 4 spawner scraps. The catcher traps a creature inside and releases it wherever you like."]
	quest.3B8E9C25136466D3.quest_desc: ["A reinforced redstone block from a dark altar ritual. It is the heart of the mould that becomes a redstone monstrosity."]
	quest.3B9748A00E787A69.quest_desc: ["Higher-tier cables carry much more FE per tick. You can swap them without tearing the network down."]
	quest.3B9748A00E787A69.title: "Thicker Cables"
	quest.3BB1C234B16D2345.quest_desc: [
		"Ruins buried in dirt and gravel. Clean the suspicious gravel with a brush to find sherds and other finds."
		""
		"&7More quests on this page appear here once your team enters the Andesite Era.&r"
	]
	quest.3BB1C234B16D2345.title: "Trail Ruins"
	quest.3BD7E7B21E74BFB5.quest_desc: ["Defeat &c{entity.cataclysm.the_harbinger}&r, &c{entity.cataclysm.maledictus}&r or the &c{entity.gametechbcs_spellbooks.hard_dead_king}&r. The trophy completes the seal."]
	quest.3BD7E7B21E74BFB5.quest_subtitle: "Milestone"
	quest.3BD7E7B21E74BFB5.title: "&cA Second Boss of the Era"
	quest.3BF1845223597B1C.quest_desc: ["A Tesla coil above a gold ingot turns it into electrum. Electrum makes wire, a spool and the accumulator."]
	quest.3C0347221EB791E2.quest_desc: ["Adds a gem socket to an item. Make it from gem-fused slate, gem dust, amethyst and gunpowder."]
	quest.3C0A920447D551DA.quest_desc: ["Limits which items pass through an extractor or an inserter."]
	quest.3C26A3DB6E5D2937.quest_desc: ["Raw Spiritus from monsters hit by a dagger. Essence is the currency of blood, Spiritus the currency of the soul."]
	quest.3C3EFEFFE1B0C98D.quest_desc: ["Used, it permanently adds a heart of health. It turns up in the gold dungeon's vault."]
	quest.3C5A977308DB2BE9.quest_desc: ["Fuse slams items together and takes fluids from nearby tanks, like a mechanical mixer. With Superheat it makes recipes that need a cake-fed blaze burner in Create."]
	quest.3C5A977308DB2BE9.title: "Mixing by Spell"
	quest.3C6369A72CFC8FCE.quest_desc: ["A wrecked Explorify ship on an End island. Search the hold."]
	quest.3C6369A72CFC8FCE.title: "An End Shipwreck"
	quest.3C7222C219600DE7.quest_desc: ["The Create Propulsion thruster gives thrust in one direction while it gets a redstone signal. It burns turpentine fed by a pipe."]
	quest.3C772A82C1A69EA2.quest_desc: ["The top bin tiers, from reinforced and atomic alloy. The ultimate one holds the output of a whole mine."]
	quest.3C772A82C1A69EA2.title: "Elite and Ultimate Bins"
	quest.3C7CC5DA03AF6EE4.quest_desc: ["The soul gem stores a living creature and releases it wherever you like, as often as you like. The fragile gem from a foliot ritual breaks after one use."]
	quest.3C87EEACE70CE966.quest_desc: [
		"The blast furnace will not run without reinforcements, and each extra one around it speeds up smelting."
		""
		"&7Ponder (W) on the furnace output shows where they go.&r"
	]
	quest.3C9C9347CB08A8A3.quest_desc: ["Heals the target, or you when combined with the Self form. A tier-two glyph made from a golden apple and a glistering melon slice."]
	quest.3CBC4F85CFB29456.quest_desc: [
		"On a smithing table, with an ender pearl, it adds a wand mode to the trowel: it places whole rows and planes of random blocks at once. Switch the mode with “{key.mechtrowel.toggle_build_mode}”."
		""
		"&7The next trowel tier appears here once your team enters the Arcane Era.&r"
	]
	quest.3CC3998DD1166A4D.quest_desc: ["&d{item.minecraft.nether_wart}&r is the base of most potions, and &d{item.minecraft.magma_cream}&r gives fire resistance, handy in the Nether."]
	quest.3CD23F9C3416BC34.quest_desc: ["Docking connectors pair up into a rigid joint. One on the ship, one on a mooring tower – and the ship stays put in port."]
	quest.3CE3CCC7E269A86B.quest_desc: ["A jetpack built into the bodyarmor, high jumps in the boots and faster running in the pants. Each of these modules needs polonium."]
	quest.3CE3CCC7E269A86B.title: "Movement"
	quest.3D05593C7CC33A02.quest_desc: ["The composter turns saplings, leaves and scraps into compost that fertilises the farmer's and florist's fields."]
	quest.3D05593C7CC33A02.title: "Composter"
	quest.3D066A987EFE623D.quest_desc: ["The candlestick lights the altar and raises its power. A creature slain over the goblet fills it with blood for rites, and the goblet itself raises the altar's capacity by 2."]
	quest.3D066A987EFE623D.title: "Altar paraphernalia"
	quest.3D077F9A0E102180.quest_desc: ["Each catalyst is a different school: iron – boundaries, gold – mystic, diamond – projection, emerald – exchange. Three powders in a circle make a spell."]
	quest.3D077F9A0E102180.title: "Powdered Catalysts"
	quest.3D09B9FC100C2825.quest_desc: [
		"Ender pearl is the school of displacement, eye of ender the mystic eyes, and quartz intelligence. Grind them with a hammer or mortar like the others."
		""
		"&7Three powders in a blood circle on cloth make a scroll; JEI shows the recipes.&r"
	]
	quest.3D09B9FC100C2825.title: "The other catalysts"
	quest.3D0B9BE5D4B15F6E.quest_desc: [
		"Paving, paths and cobbles from every stone, plus fences, pickets and decorative walls. Make the paths in a stonecutter."
		""
		"&7The next decoration tier appears here once your team enters the Andesite Era.&r"
	]
	quest.3D0B9BE5D4B15F6E.title: "Paths and Fences"
	quest.3D2110748D7E9189.quest_desc: ["Leaves and bushes sometimes drop sticks. Gather a few for tool handles."]
	quest.3D2110748D7E9189.title: "Sticks"
	quest.3D28557669BC7FE0.quest_desc: ["Mekanism storage without cables: every QIO block on the same frequency sees the same drives."]
	quest.3D28557669BC7FE0.title: "A QIO Network"
	quest.3D3A14CCB9432BE5.quest_desc: [
		"The first upgrade pulls items from a neighbouring container, the second pushes the drawer's contents out. Pick the side in the drawer window."
		""
		"&7The next drawer tier appears here once your team enters the Brass Era.&r"
	]
	quest.3D3A14CCB9432BE5.title: "Pulling and Pushing"
	quest.3D595F13538C18AA.quest_desc: ["Compresses ingots, nuggets and similar items into blocks. Your ore storage takes less space."]
	quest.3D8072BD295FA626.quest_desc: [
		"Upgrade your mage robes in the enchanting apparatus: put them in the middle and blaze rods on the pedestals. Second-tier robes have larger thread slots."
		""
		"&7The third tier needs materials from the End.&r"
	]
	quest.3D8072BD295FA626.title: "Stronger Robes"
	quest.3D82324A7CE81778.quest_desc: ["Shows the contents of every chest linked to the connector in one window, with a search bar. Place it on the inventory connector or a chest next to it."]
	quest.3D82324A7CE81778.quest_subtitle: "Milestone"
	quest.3D82324A7CE81778.title: "&b{block.toms_storage.storage_terminal}"
	quest.3D8AD0AC7FA6631E.quest_desc: ["Couples and uncouples carriages on the move, without disassembling the train at a station. Use a wrench to pick the mode and the gap between the pads."]
	quest.3D954E7B62F20C8C.quest_desc: ["The mechanic makes redstone items, rails and other mechanisms for the colony. This era colony buildings grow to level 3."]
	quest.3DA31FDEE4F7074E.quest_desc: [
		"&7Brass Era · diamond armour and a shield recommended&r"
		""
		"Frostmaw sleeps in snowy biomes and wakes when you come near. Umvuthi rules the Umvuthana tribe from a grove in the savanna. The Ferrous Wroughtnaut waits in an underground chamber."
		"&7Armour covers the Wroughtnaut's front: dodge its swing and strike its back.&r"
	]
	quest.3DA31FDEE4F7074E.title: "Three Legends"
	quest.3DA37BF540645C19.quest_desc: ["Cuts a log into six planks and drops sawdust on the side."]
	quest.3DA85C536586522F.quest_desc: ["The pylon repairs items on nearby stands for spirits and the material they were made of."]
	quest.3DAFED48E313520A.quest_desc: ["A Dungeons Arise forest pub, now full of unwelcome guests."]
	quest.3DAFED48E313520A.title: "The Greenwood Pub"
	quest.3DB1F2573EB7B506.quest_desc: ["The courier delivers supplies from the colony warehouse and fulfils workers' requests without your help. A larger colony needs several."]
	quest.3DB1F2573EB7B506.title: "Courier"
	quest.3DE8D8C5006D1A67.quest_desc: ["A catalyst in front of a fan replaces water or lava: the fan washes or smelts items while nothing spills or burns in your base. Fill an empty catalyst with a bucket."]
	quest.3DE8D8C5006D1A67.title: "Fan Catalysts"
	quest.3DF428EBF85FFFFA.quest_desc: ["Places the most blocks at once of all construction sticks and lasts the longest. Make it from a netherite ingot and a stick."]
	quest.3DF428EBF85FFFFA.quest_subtitle: "Milestone"
	quest.3DF428EBF85FFFFA.title: "&e{item.constructionstick.netherite_stick}"
	quest.3DFBCE899F41064E.quest_desc: ["Train doors and trapdoors open on their own when the train stops at a station and close before it departs."]
	quest.3DFBCE899F41064E.title: "Train Doors"
	quest.3DFEE7818FF6CCA9.quest_desc: ["The Lost Citadel hides in the Nether behind a magic barrier. Ancient Knights guard it and drop &a{item.irons_spellbooks.cinder_essence}&r."]
	quest.3DFEE7818FF6CCA9.title: "The Citadel"
	quest.3E18E22D4538637F.quest_desc: ["The Atomic Era brings the last world tier, Pinnacle. The rarest loot and the toughest monsters stay with you to the end."]
	quest.3E18E22D4538637F.title: "World tier: Pinnacle"
	quest.3E1E581B815C8B3E.quest_desc: [
		"Feed it enchanted books and it collects their enchantments, then hands them out on new books at a chosen level, up to its limit. Make it from an ender chest, infused shelves and an enchanting table."
		""
		"&7The next enchanting tier appears here once your team enters the Occult Era.&r"
	]
	quest.3E5FD840601E8701.quest_desc: ["Place the crucible over a fire, fill it with water and wait for it to boil. Ingredients go in step by step; the book gives the order and the stirring."]
	quest.3E63AC5C1099D9D5.quest_desc: ["Elytra hang on the ships beside End cities. With fireworks you can fly over the whole world."]
	quest.3E6647243FAAC6EE.quest_desc: ["The blacksmith makes tools and armor for your citizens, and the smelter smelts ores from the colony's warehouse. Miners and guards no longer wait on you."]
	quest.3E6647243FAAC6EE.title: "Blacksmith and Smeltery"
	quest.3E7C3FCAAA5EA089.quest_desc: ["Bumblezone bees drop stingers. They also turn up in the hive's chests."]
	quest.3E7F308039DE6345.quest_desc: ["A jewelcrafting station of copper and planks. Following a pattern, you assemble rings and necklaces from metal and gems on it."]
	quest.3E899BBEACE9736D.quest_desc: [
		"&7Occult Era · recommended: netherite armor, a bow&r"
		"The great ghast weeps fiery tears and shoots fire from the top of the tower."
	]
	quest.3E899BBEACE9736D.quest_subtitle: "Boss"
	quest.3E899BBEACE9736D.title: "&c{entity.twilightforest.ur_ghast}"
	quest.3EAB7CF20CCA6468.quest_desc: ["Holds a lot of one item, like a drawer. Right-click to insert, left-click to take a stack, and hoppers and transporters pull from below."]
	quest.3EC453AB636328FF.quest_desc: ["Compact a blank board in a basin from stone, redstone, iron and quartz, and a deployer lays New Age copper wire on it. The circuit goes into the seal."]
	quest.3EC453AB636328FF.quest_subtitle: "Seal ingredient"
	quest.3ECB2A06092357F7.quest_desc: [
		"The gyroscopic propeller bearing tilts its propeller upwards on its own and stabilises the craft, so a helicopter will not flip over. The gyroscopic mechanism comes from sequenced assembly."
		""
		"&7Ponder (hold W over the item) shows how to put it together.&r"
		""
		"&7More quests on this page appear here once your team enters the Electric Era.&r"
	]
	quest.3ECB2A06092357F7.quest_subtitle: "Milestone"
	quest.3ECB2A06092357F7.title: "&6Helicopter"
	quest.3ED83B409D9C3F8A.quest_desc: ["The accumulator placed on the tank turns water into liquid sal ammoniac. With a sal ammoniac crystal inside it yields ten times more."]
	quest.3ED83B409D9C3F8A.title: "Sal Ammoniac"
	quest.3EE79D8D927E2C20.quest_desc: ["A terminal with a crafting grid. It takes ingredients straight from storage, and JEI fills the grid with one click."]
	quest.3F1104AB789A0848.quest_desc: ["Eight blank runes in a ring around the altar raise it to tier one. Later you can swap the side runes for upgrade runes."]
	quest.3F1104AB789A0848.title: "Altar tier one"
	quest.3F231F29B59523E6.quest_desc: ["Summons zombie servants. It is made in a necroturgy ritual held at night: 16 non-wooden slabs, 16 sculk or grave soil blocks and 8 potted plants around the altar."]
	quest.3F7281A440F05E75.quest_desc: [
		"Vaults placed side by side merge into one large storage, up to 3 blocks wide and any length. Funnels and belts insert and extract through any face."
		""
		"&7Hover over a vault and press &bW&7 to see in Ponder how to expand it.&r"
	]
	quest.3F7281A440F05E75.quest_subtitle: "Milestone"
	quest.3F7281A440F05E75.title: "&b{block.create.item_vault}"
	quest.3F7BB169259FAD98.quest_desc: ["Planks make a table, and with it a 3×3 grid for better tools."]
	quest.3F8C6BD063CBDF84.quest_desc: ["It lies in buried treasure, more rarely in shipwreck treasure."]
	quest.3F8D3EB406CC3903.quest_desc: ["&c{entity.cataclysm.maledictus}&r is held in the ice prison. An &a{item.cataclysm.cursed_eye}&r shows the way."]
	quest.3F8D3EB406CC3903.title: "The Frosted Prison"
	quest.3FCC56C1A42554E7.quest_desc: [
		"Stores FE and outputs it from the sides you set with a configurator. Its slots also charge devices."
		""
		"&7Mekanism machines and ore processing are on the neighbouring page.&r"
	]
	quest.3FD6C1E37EADC441.quest_desc: ["A huge Dungeons Arise structure for the boldest explorers. Go with your team."]
	quest.3FD6C1E37EADC441.title: "The Typhon"
	quest.3FE8CE8AD6A9F43F.quest_desc: ["A component in a housing makes a cell. Bigger components are made from smaller ones, and you can take an empty cell apart again by using it while sneaking."]
	quest.3FE8CE8AD6A9F43F.title: "Bigger Cells"
	quest.3FF538620BFCFA50.quest_desc: ["The baker bakes bread and cakes from the farmer's grain. Citizens need grain in their diet."]
	quest.3FF538620BFCFA50.title: "Bakery"
	quest.3FFA0CC0B07167EE.quest_desc: ["Shows the biomes and structures of the Twilight Forest, the Naga Courtyard and the Lich Tower among them. JEI shows the recipe for the map focus; with paper it makes a blank map that you fill in the Forest."]
	quest.401584863A47007E.quest_desc: [
		"&7Gear: good armour and a way to dodge quickly.&r"
		"It guards the Golem Forge in Eternal Starlight. It fires a laser and charges."
	]
	quest.401584863A47007E.quest_subtitle: "Boss"
	quest.401584863A47007E.title: "&c{entity.eternal_starlight.starlight_golem}"
	quest.403CEF635859CB24.quest_desc: ["Mine deepsilver ore from the stones of this dimension and smelt it in a furnace. It is the basic metal of Eternal Starlight."]
	quest.403CEF635859CB24.quest_subtitle: "Milestone"
	quest.403CEF635859CB24.title: "&a{item.eternal_starlight.deepsilver_ingot}"
	quest.4040269B927DA1D4.quest_desc: ["Casts the spell written on a parchment when it gets a redstone signal, like a dispenser. It takes source from nearby jars, so it suits quarries and farms."]
	quest.4048FC365A78209B.quest_desc: ["The sword of Ignis, made from a netherite sword, ignitium and a blaze rod."]
	quest.405807BF5A8FA85C.quest_desc: ["A rare land with rainbow leaves. Take a rainbow oak sapling home with you."]
	quest.405807BF5A8FA85C.title: "{biome.twilightforest.enchanted_forest}"
	quest.407F52EA79FA5CB4.quest_desc: ["A Goety ritual with an echo of the void turns a bombardment focus into a stellar focus."]
	quest.408B2E5B80998568.quest_desc: ["You draw circles in blood: right after taking damage, press the circle key. The dagger lets you wound yourself at any time."]
	quest.408F2BDCC4644279.quest_desc: ["Make the MEGA housing from sky steel. With a 1M component it holds as much as four AE2 256k cells, and it fits an ordinary drive."]
	quest.408F2BDCC4644279.title: "A 1M Cell"
	quest.4093464697116D46.quest_desc: ["The copper wand places more blocks at once and lasts longer."]
	quest.409D70C16EB92062.quest_desc: ["The shattered, creatures of bone and sculk, drop it. It also lies in the temple."]
	quest.40AD22F31ABBD481.quest_desc: ["Collect it by breaking the glowing blocks under the Nether ceiling. Four of them combine back into a block."]
	quest.40BF1A6B2C32A39E.quest_desc: ["The elder guardian of an ocean monument drops it."]
	quest.40C6BDAEC3DDCF37.quest_desc: [
		"&7Rune Era · iron armour and healing potions recommended.&r"
		""
		"The undead ruler fights in melee and casts spells, and calls the undead to his side."
		"He sleeps at the heart of the Catacombs."
	]
	quest.40C6BDAEC3DDCF37.quest_subtitle: "Boss"
	quest.40C6BDAEC3DDCF37.title: "&c{entity.irons_spellbooks.dead_king}"
	quest.40E4C3CA84687C95.quest_desc: ["Fuel for thrusters. Crushing wheels squeeze resin out of spruce logs, and a mixer turns it into turpentine."]
	quest.40F37D6A49FCCB26.quest_desc: [
		"The cannon loader is a piston that pushes the shot and charges into the barrel with a ram head and pulls them back out with a worm head. Add funnels and the cannon loads itself."
		""
		"&7Ponder (hold W over the item) shows the whole process.&r"
	]
	quest.40F37D6A49FCCB26.title: "Cannon Loader"
	quest.40FE70033980B7D2.quest_desc: ["A contraption carries the blocks you glue together with super glue. Mark an area corner to corner and everything inside moves along with the piston, bearing or gantry."]
	quest.40FE70033980B7D2.title: "Gluing"
	quest.410407F8C89BB288.quest_desc: ["A portable storage interface on a contraption trades items with a second interface when the contraption stops next to it. That is how you unload a mining cart or a train without taking it apart."]
	quest.410407F8C89BB288.title: "Loading on the Move"
	quest.4104ADCA0F8CA4D3.quest_desc: ["A huge nest on an island, added by Explore Ruins Aether. See what is left in it."]
	quest.4104ADCA0F8CA4D3.title: "A Moa Nest"
	quest.41056068F0BF7358.quest_desc: ["The Stalker may leave a soul crystal. It goes into the sonorous staff and the soul elytra."]
	quest.4112A643EB83D893.quest_desc: ["A flask from the altar. In the Tabula Vitae you add potion effects to it and lengthen them."]
	quest.411E0DEDA4971DCA.quest_desc: ["Create Deco adds windows, catwalks, bars, doors and supports in andesite alloy. Make most of them in a stonecutter straight from the alloy."]
	quest.411E0DEDA4971DCA.title: "Andesite Decor"
	quest.41235A8483B6D528.quest_desc: ["Collect 32 mercury shards. Mercury is one of the three pillars of Theurgy alchemy, next to salt and sulfur; two shards go into the seal."]
	quest.41235A8483B6D528.quest_subtitle: "Milestone"
	quest.41235A8483B6D528.title: "&dMercury Alchemy"
	quest.412CF0E07D1C721F.quest_desc: ["Combines dust or gems with stone into ore blocks. Handy when you want to mine the ore again with Fortune."]
	quest.413F385ECBC36322.quest_desc: ["Incendium adds lands of its own: the quartz flats, the withered forest and the infernal dunes. Each has its own structures."]
	quest.413F385ECBC36322.title: "Incendium Lands"
	quest.4156E4ACAA1C7F57.quest_desc: ["Combine a dragon scale with iron and arcane crystal dust for a silver one, or with prismarine and arcane crystal dust for an aquatic one. Scales drop from the dragon and lie in End city treasure."]
	quest.4156E4ACAA1C7F57.title: "Dragon scales"
	quest.4171FEAB75ADBDFA.quest_desc: [
		"Runewood pedestals and stands around the spirit altar hold the extra ingredients of an infusion. Bigger recipes need several of them."
		""
		"&7These quests extend the Malum branch of the Occult Era chapter.&r"
	]
	quest.4171FEAB75ADBDFA.title: "Altar Stands"
	quest.41A9C912CD4AF3D1.quest_desc: [
		"Works like a totem of undying but does not vanish: after a fatal blow you only recharge it. The recharge costs a lot of source."
		""
		"&7More quests on this page appear here once your team enters the Occult Era.&r"
	]
	quest.41AB6CCEE0C1499C.quest_desc: ["A wind core from a sky ritual. Wind foci are built on it: blasts, updrafts and cyclones."]
	quest.41B1CE2F5BC0B782.quest_desc: ["Shows a device's resistance, voltage, current and power, and the balance of the whole network. Without it, troubleshooting is guesswork."]
	quest.41B3352DC4D66AB9.quest_desc: [
		"Once you have this era's milestones, hand in the &6Seal of the Electric Era&r. Your whole team enters the Electric Era and the seal is consumed."
		""
		"You make the seal in the Ars Nouveau enchanting apparatus for 10,000 source: an arcane crystal as the reagent and, on the pedestals, 2 deorum ingots, 2 mercury shards, a mark of mastery, a steel casing and the trophies of Ignis or the Netherite Monstrosity and a second boss of this era."
		""
		"&7See the exact recipe in JEI: hover over the seal and press R.&r"
	]
	quest.41B3352DC4D66AB9.quest_subtitle: "Hand in the seal"
	quest.41B3352DC4D66AB9.title: "Gate: Electric Era"
	quest.41BCFE74B5FC717C.quest_desc: ["Make an alternator or a generator coil: either turns Create rotation into power. From now on your base has electricity."]
	quest.41BCFE74B5FC717C.quest_subtitle: "Milestone"
	quest.41BCFE74B5FC717C.title: "&6First Power"
	quest.41CAF448D8DCF4A4.quest_desc: [
		"Attach twelve whistles of different pitches to a single fluid tank. The boiler will play like a cathedral organ."
		""
		"&7This is a hidden Create advancement.&r"
	]
	quest.41CAF448D8DCF4A4.title: "Steam Organ"
	quest.41D42D1E815ED5DF.quest_desc: ["A great pillar at the heart of the dimension where the Bee Queen lives. A honey compass points the way."]
	quest.41D42D1E815ED5DF.quest_subtitle: "Milestone"
	quest.41D42D1E815ED5DF.title: "&aThe Queen's Throne"
	quest.41DA6E3A4F2F2021.quest_desc: ["Hold 256 electrum ingots at once. Let gold ride a belt under Tesla coils on its own and the finished ingots go into storage."]
	quest.41DA6E3A4F2F2021.quest_subtitle: "Automation proof"
	quest.41DA6E3A4F2F2021.title: "Electrum Works"
	quest.41F4B86B2EF0FA10.quest_desc: ["A blend of lead and iron smelted in a furnace. This magically inert alloy is the base of Eidolon's worktable, crucible and brazier."]
	quest.41FDCDC8504478CE.quest_desc: ["The incubator combines mercury, salt and sulfur from its three vessels into a new item. Gold sulfur, a mercury shard and mineral salt give a gold ingot: this is how you multiply metals and gems."]
	quest.41FDCDC8504478CE.title: "Incubator"
	quest.41FE901FE9A53C5A.quest_desc: [
		"Build the polished darkstone base, place a smithing table in the middle and sprinkle mundabitur dust on it to turn it into the forge. Look at the finished forge."
		""
		"&7Ponder (W) on the Hephaestus Forge shows the block layout.&r"
	]
	quest.41FE901FE9A53C5A.quest_subtitle: "Milestone"
	quest.41FE901FE9A53C5A.title: "&dHephaestus Forge and Deorum"
	quest.4206200054461625.quest_desc: ["Smelt an arcane crystal in a furnace to get the dust. It is the base of mundabitur dust, deorum and aureal bottles."]
	quest.4237ECDAFAA60356.quest_desc: [
		"&7Gear: your best armour and healing potions.&r"
		"The storm queen atop the acropolis. She hurls her spear and calls down the storm."
	]
	quest.4237ECDAFAA60356.quest_subtitle: "Boss"
	quest.4237ECDAFAA60356.title: "&c{entity.cataclysm.scylla}"
	quest.42406B5E2D1EEA61.quest_desc: [
		"The angel mode places a block on the far side of what you look at. With a block in your offhand, click empty air to place it in mid-air."
		""
		"&7Install the template on a smithing table: the stick, the template and a feather.&r"
		""
		"&7The next stick tier appears here once your team enters the Brass Era.&r"
	]
	quest.4244585361BB6131.quest_desc: ["The eye of flame leads to the arena deep in the Nether. &c{entity.cataclysm.ignis}&r waits there."]
	quest.4244585361BB6131.title: "The Burning Arena"
	quest.424508F6826A8BFF.quest_desc: ["Turns FE from generators into AE energy. Place it next to a network cable and feed it power."]
	quest.424FB675EA5DBCDF.quest_desc: ["Polonium, fluorite dust and water in a &6{block.mekanism.pressurized_reaction_chamber}&r make a polonium pellet. Four go into the seal."]
	quest.424FB675EA5DBCDF.quest_subtitle: "Milestone · seal ingredient"
	quest.424FB675EA5DBCDF.title: "&6{item.mekanism.pellet_polonium}"
	quest.425E6A82339427D2.quest_desc: ["Sunrise sets the day, Moonfall the night and Cloudshaping changes the weather. Put the tablet on the ritual brazier and click it with an empty hand."]
	quest.425E6A82339427D2.title: "Ritual of the Sky"
	quest.42628AB33DAC6311.quest_desc: ["A stellarite block on the forge, with 4 sculk catalysts, 2 dark nether stars and 2 dragon scales on the pedestals. The ritual consumes 5000 aureal, 20,000 blood and 500 souls."]
	quest.42628AB33DAC6311.quest_subtitle: "Milestone"
	quest.42628AB33DAC6311.title: "&dForge: tier V"
	quest.426755395D657D20.quest_desc: ["Undead slain with this scythe crystallize into soul shards, so you no longer wait for the crystallization ritual. The tattered cloth it needs drops from {entity.eidolon_repraised.wraith}s."]
	quest.426C357A7A6AF606.quest_desc: ["Shows the network's channels and energy use, and keeps upgrade cards at hand inside."]
	quest.4272245B725F5412.quest_desc: ["With oxygen it turns an ore block into three clumps. An electrolytic separator gets oxygen from water."]
	quest.42727D580844C4DB.quest_desc: ["A Structory chapel abandoned long ago. Take a look inside."]
	quest.42727D580844C4DB.title: "An Abandoned Chapel"
	quest.4285DDCBAFB1B4AD.quest_desc: ["Copies part of a build and pastes it elsewhere. It takes the blocks from your inventory or from a bound container."]
	quest.42B61F704E7B5787.quest_desc: ["Wool with arcane essence. This cloth makes mage robes and binds better spell books."]
	quest.42D486F4378BAE36.quest_desc: ["Beads, a belt, a robe and sandals from the monastery chests and the Sculptor. Each piece gives its own bonus; the beads, for one, strengthen punches and the earthrend gauntlet."]
	quest.42D486F4378BAE36.title: "Geomancer Outfit"
	quest.42D4D5EB7D55CCAB.quest_desc: ["Combine it with the trowel and a wireless receiver on a smithing table. The trowel then takes blocks straight from the ME network, within range of an access point."]
	quest.42D6417EB7297FCF.quest_desc: [
		"Raises the number of blocks the wand mode places with one click. Install it on a trowel that already has the wand mode."
		""
		"&7The next trowel tier appears here once your team enters the Electric Era.&r"
	]
	quest.42E8FDA937B7D4F6.quest_desc: ["Watches the stock of one item and orders its ingredients from the network. Linked gauges run a whole factory."]
	quest.42FBFD3FBFFA1090.quest_desc: ["The apprentice's spell book: gold, arcane essence and hogskin. More spell slots and a mana bonus."]
	quest.4305ADA504007534.quest_desc: ["A piglin stronghold full of gold. Put on something golden before you go in."]
	quest.4305ADA504007534.title: "The Piglin Donjon"
	quest.430851F998CBAD5F.quest_desc: ["The saw fells trees and cuts logs into planks. Facing up, it processes items from a belt like a stonecutter."]
	quest.430F68B6F75A455E.quest_desc: ["Crimson iron with a blaze rod and magma cream. This steel builds the alloy forge."]
	quest.43274603A9F19AD3.quest_desc: ["Collects nearby experience and stores it in the chest. The recipe needs an eye of ender and a bottle o' enchanting."]
	quest.4342B25F5E9890EA.quest_desc: [
		"&7Rune Era · iron armour, a bow and plenty of open space recommended.&r"
		""
		"The deadliest of the wildens. In battle it goes into a rage and wrecks its surroundings."
		"Summon it with the ritual in a ritual brazier, using a wilden spike, horn and wing."
	]
	quest.4342B25F5E9890EA.quest_subtitle: "Boss"
	quest.4342B25F5E9890EA.title: "&c{entity.ars_nouveau.wilden_boss}"
	quest.4349B5F91B73092B.quest_desc: [
		"Only the owner, or their team if you set it in security, can open them. The chest also opens straight from your inventory."
		""
		"&7The next Mekanism storage tier appears here once your team enters the Atomic Era.&r"
	]
	quest.4349B5F91B73092B.title: "Personal Storage"
	quest.43639424B8FFBD44.quest_desc: ["The builder only builds and upgrades up to his own hut's level. Upgrade it before you raise other buildings to level 2."]
	quest.43639424B8FFBD44.quest_subtitle: "Milestone"
	quest.43639424B8FFBD44.title: "&3Builder Level 2"
	quest.4369A96D0CC1C2C6.quest_desc: ["Each energiser tier is made from the previous one. It energises items on a depot or belt below while it has power and rotation."]
	quest.4369A96D0CC1C2C6.title: "Better Energisers"
	quest.43715FC0EC59A07B.quest_desc: ["The Netherite Monstrosity's horn. At a smithing table it turns a netherite helmet into the monstrous helm."]
	quest.437274230ED5B359.quest_desc: ["Defeat one of the four bosses of the End. Its trophy is the first boss part of the seal."]
	quest.437274230ED5B359.quest_subtitle: "Milestone"
	quest.437274230ED5B359.title: "&cA Boss of the End"
	quest.438252F33363AE09.quest_desc: ["A mark of technomancy or mastery, netherite and brass turn Ars robes into technomancer gear: the light artificer set, the medium technomancer set or the heavy machinaguard set. The heavy helmet needs engineer's goggles."]
	quest.438252F33363AE09.title: "Technomancer's Gear"
	quest.43CBC1B274368298.quest_desc: [
		"The controller joins touching chests and barrels into one storage with a single window. Inserted items go where the same items already are."
		""
		"&7The storage grows as long as more chests touch the controller or each other.&r"
	]
	quest.43CBC1B274368298.quest_subtitle: "Milestone"
	quest.43CBC1B274368298.title: "&bOne Storage"
	quest.43E27B5107E91049.quest_desc: ["Hundreds of pieces of furniture from every wood: chairs, tables, desks, cabinets and whole kitchens. Any furniture of this mod counts."]
	quest.43E27B5107E91049.title: "Macaw's Furniture"
	quest.43E29DE0758CF5F9.quest_desc: [
		"&7Occult Era · netherite armour and fire resistance recommended&r"
		""
		"Goety's Apostle answers a ritual on the dark altar and fights with fire and summoned servants."
		"The Echo of Tyros, the first flamebearer, answers the soulcaller used in the lost citadel in the Nether."
	]
	quest.43E29DE0758CF5F9.title: "Fire and Darkness"
	quest.43EBD79D73F990D2.quest_desc: ["The acropolis rises from the sea. &c{entity.cataclysm.scylla}&r waits at the top, and an &a{item.cataclysm.storm_eye}&r shows the way."]
	quest.43EBD79D73F990D2.title: "The Acropolis"
	quest.43EBF74E9E35C90B.quest_desc: ["Cursium from Maledictus and its template upgrade the cryomancer robe, the frostbranded book or the ice staff. Make any one of them."]
	quest.43EBF74E9E35C90B.title: "The Cursed Mage"
	quest.440B0B30344FC12F.quest_desc: ["The decoration table changes the wood and colours of chests and barrels, and the paintbrush repaints placed ones."]
	quest.440B0B30344FC12F.title: "Chest Looks"
	quest.441826DDC76B1386.quest_desc: ["A valkyrie library from Explore Ruins Aether. Valkyries dislike anyone rummaging through their books."]
	quest.441826DDC76B1386.title: "The Valkyrie Library"
	quest.441A36E1B4E491FF.quest_desc: ["Blue chalk of marid essence, lapis and tube coral completes its pentacle. The marid crushes ores the fastest and most efficiently of all spirits."]
	quest.441A36E1B4E491FF.quest_subtitle: "Milestone"
	quest.441A36E1B4E491FF.title: "&dMarid Crusher"
	quest.441C0667FA9A60B9.quest_desc: ["A maze in Eternal Starlight. The Lunar Monstrosity hides at its heart; it bites and breathes on you."]
	quest.441C0667FA9A60B9.title: "The Cursed Garden"
	quest.4429C383792243AC.quest_desc: ["The Echo leaves this scythe or the betrayer's signet. You can restore the decrepit scythe later at a smithing table."]
	quest.4436ECBC0A7AF774.quest_desc: ["At a smithing table it coats a finished tool or armour piece with another material, such as netherite. Copy the template with a diamond and netherrack."]
	quest.44374E3108D9D22F.quest_desc: [
		"The &d{block.ars_nouveau.enchanting_apparatus}&r only works with an &d{block.ars_nouveau.arcane_core}&r at its base. Place pedestals with items within 3 blocks and use the main item on the apparatus."
		"This is where the Seal of the Brass Era will be made."
	]
	quest.44374E3108D9D22F.quest_subtitle: "Milestone"
	quest.44374E3108D9D22F.title: "&dApparatus and Core"
	quest.444D14F45501B109.quest_desc: ["At the inscription table you write scrolls into an Iron's Spells spell book. The first scrolls are easiest to find in chests of dungeons, pyramids, mineshafts and outposts."]
	quest.444D14F45501B109.quest_subtitle: "Milestone"
	quest.444D14F45501B109.title: "&dInscription Table and First Scroll"
	quest.444EE09EBF742773.quest_desc: ["The Create: New Age generator. A coil spun by Create makes power when magnets surround it, for example the &6{block.create_new_age.redstone_magnet}&r."]
	quest.445B60FF112A6CC3.quest_desc: ["A pair of interfaces moves goods between a moving contraption, such as a train, and a station's storage when they face each other."]
	quest.4461F5E545991680.quest_desc: ["On a pyramid of metal or gem blocks it gives your team lasting effects such as speed and strength."]
	quest.4477AAE405E4923C.quest_desc: [
		"Pushes and pulls the structure attached to it while it is driven. Add piston extension poles at the back to extend its reach."
		""
		"&7Ponder (hold W over the item) shows how to put it together.&r"
	]
	quest.447B55DBED65E5BE.quest_desc: ["Knightmetal for a sword, a pickaxe, a shield and armour that guards better against melee blows. Useful before the phantom fight."]
	quest.447C3401F98593FC.quest_desc: ["The {entity.goety.vizier}, a boss of this era, leaves the ruby of souls behind. It goes into Goety's strongest foci and garments."]
	quest.448E851CC7A01D07.quest_desc: ["A block of experience pressed into a template. The blaze enchanter writes chosen enchantments onto it, and the blaze forger applies them to an item."]
	quest.44928AA0937E885E.quest_desc: ["Ars Technica glyphs run Create recipes on items lying on the ground: pressing, polishing and whirling. A whirl combined with water, flare or smelting replaces fan processing."]
	quest.44928AA0937E885E.title: "Machine Glyphs"
	quest.4499662AA767FC48.quest_desc: ["Pulls nearby items and stores them in the backpack. It is made from the pickup upgrade."]
	quest.449CBC79E6ACFC9A.quest_desc: ["A savanna with baobabs, a desert with Joshua trees and a bamboo forest. Visit all three."]
	quest.449CBC79E6ACFC9A.title: "Regions Unexplored"
	quest.449DA98CFF972901.quest_desc: ["Once the dragon falls, gateways open to the outer islands. End cities with shulkers and ships stand there."]
	quest.449DA98CFF972901.title: "An End City"
	quest.44B13C087B9CA492.quest_desc: ["The next tier: even more space and slots. Make it from a copper chest or straight from a basic one."]
	quest.44BD8C99C83F4C48.quest_desc: ["Goety's bosses leave a pouch of random treasure. Open it with right-click."]
	quest.44FF6A6CC350D197.quest_desc: [
		"&7Rune Era · iron armour, a bow and healing potions recommended&r"
		""
		"You summon the Wilden Chimera with a ritual in the ritual brazier. The Dead King sleeps at the heart of the underground catacombs."
		"The fights count for the boss quests in the era chapter. Here you find the preparations and the spoils."
	]
	quest.44FF6A6CC350D197.title: "Bestiary of Mages"
	quest.4506CCF19C17C0ED.quest_desc: ["A frame with the teleporter around a free 1×2 space sends you to another teleporter on the same frequency, even in another dimension. Every jump costs power."]
	quest.4506CCF19C17C0ED.title: "Teleporter"
	quest.4521E581E8AA67A6.quest_desc: ["It fires stone, bricks and glass for the colony's other crafters."]
	quest.4521E581E8AA67A6.title: "Brick Yard"
	quest.453424F4984DF7EB.quest_desc: ["A fiery temple deep inside a great island. &c{entity.aether.sun_spirit}&r lives there."]
	quest.453424F4984DF7EB.title: "The Gold Dungeon"
	quest.45460B4B39B0BE16.quest_desc: ["Defeat Ignis or the Netherite Monstrosity. The next era's seal needs a trophy of one of them."]
	quest.45460B4B39B0BE16.quest_subtitle: "Milestone"
	quest.45460B4B39B0BE16.title: "&c{entity.cataclysm.ignis} or {entity.cataclysm.netherite_monstrosity}"
	quest.455B02D3CF032484.quest_desc: ["Gives thrust from FE energy instead of fuel while it gets a redstone signal. Power from this era's generators drives a ship that never refuels."]
	quest.455B02D3CF032484.quest_subtitle: "Milestone"
	quest.455B02D3CF032484.title: "&6{block.createpropulsion.ion_thruster}"
	quest.457BCBC5CAE00563.quest_desc: ["A key from the Hellfire Forge: a Tabula Animata, an echo shard, a diamond and a simple key from the dungeons. It opens the way to the Mines of the Endless Realm."]
	quest.45833DDD46DF9B12.quest_desc: ["The forester cuts trees in a marked area and replants them. Without wood the builder soon stalls."]
	quest.45833DDD46DF9B12.title: "Forester"
	quest.45925D443A5BCC6F.quest_desc: [
		"A ritual with a conduit, prismarine and a ghast tear calls an unbound marid. Defeated, it leaves its essence."
		"&cThe marid is deadlier than the afrit: come in your best armour.&r"
	]
	quest.45ABA8C627F4D586.quest_desc: ["Maledictus's axe fused with ignitium on the fusion anvil. The curse gains the fire of Ignis."]
	quest.45BC0F6B69535059.quest_desc: [
		"Combine nine armour shards into a cluster and smelt it in a furnace. Knightmetal makes heavy armour and weapons."
		""
		"&7More quests on this page appear here once your team enters the Steam and Steel Era.&r"
	]
	quest.45BC0F6B69535059.quest_subtitle: "Milestone"
	quest.45BC0F6B69535059.title: "&a{item.twilightforest.knightmetal_ingot}"
	quest.45C00041CEFA627B.quest_desc: ["Pipe the molten steel from the blast furnace into a casting basin and it sets into ingots."]
	quest.45C8C2E1843B20EE.quest_desc: ["A level 5 smeltery processes ore blocks as if they were mined with Fortune IV."]
	quest.45C8C2E1843B20EE.title: "Smeltery Level 5"
	quest.45D3D9F02632AC6E.quest_desc: ["The tribe's village in the savanna. Masked warriors defend it before Umvuthi descends to fight."]
	quest.45D3D9F02632AC6E.title: "The Umvuthana Grove"
	quest.45F78B2342A4D844.quest_desc: ["Smelt orichalcum from its ore, soak silver in the alchemist cauldron for deathsilver, and craft rose gold and white gold in the grid. They go into weapons and empowered robes."]
	quest.45F78B2342A4D844.title: "A Monsters and Spellbooks Metal"
	quest.46186F3DCA5BCF1E.quest_desc: ["The Apostle's blood. Goety needs it for its strongest rituals, among them the philosopher's stone and the death scythe."]
	quest.4625B78165C91AAF.quest_desc: ["Fill the portal frame with End Remastered eyes and jump in. Reshaped by Nullscape, the End islands are taller and stranger than usual."]
	quest.4625B78165C91AAF.quest_subtitle: "Milestone"
	quest.4625B78165C91AAF.title: "&aThe End"
	quest.4634716F0CB03CED.quest_desc: ["A faster chute that moves up to 64 items at a time. Handy for crushers and large storage."]
	quest.46811C915B911C1B.quest_desc: ["The underground stronghold lies in the &c{biome.twilightforest.dark_forest}&r of the Twilight Forest. Open it by placing a boss trophy on the &c{block.twilightforest.trophy_pedestal}&r."]
	quest.46811C915B911C1B.title: "Knight Stronghold"
	quest.468EABC5C4D55100.quest_desc: ["Smelts everything that enters the chest without opening its window. Ore from a drill arrives as ingots."]
	quest.469A32D61ED9194B.quest_desc: [
		"Mekanism machines run on FE. A universal cable brings it from an alternator or a New Age generator, and higher cable tiers carry more."
		""
		"&7The main Mekanism line is in the Electric Era chapter. This page extends it.&r"
	]
	quest.46B8196FC2AACC1D.quest_desc: ["Flings items – and players – to a chosen spot, even across a river. Pick the target by clicking it with the ejector before you place it."]
	quest.46DB9505C212992A.quest_desc: ["Forbidden pieces are dropped by necromancers and lie in crypts. Combine them into a fragment, then a scroll, and read it: it reveals how necromancers are made and how to become a lich."]
	quest.46DB9505C212992A.title: "Forbidden knowledge"
	quest.46DF25873D74E915.quest_desc: ["Connect a pumped pipe to a beehive or a bee nest to pull the honey out without bottles or smoke."]
	quest.46DF25873D74E915.title: "Honey on Tap"
	quest.46F970F018AE978F.quest_desc: ["An &d{item.mahoutsukai.attuner}&r of gold and lapis attunes a diamond. The gem stores mana, and spells draw on it by themselves."]
	quest.46F970F018AE978F.quest_subtitle: "Seal ingredient"
	quest.4714D5F083E309BE.quest_desc: ["Ignite, Freeze and Snare add damage and crowd control to your spells. All three are tier-one glyphs."]
	quest.4714D5F083E309BE.title: "Glyphs for Combat"
	quest.471B4E4C82E7B021.quest_desc: ["The blast furnace melts quartz too. Pour the liquid silicon into a casting basin and collect the ingots: silicon goes into magnetic alloy and semiconductors."]
	quest.471E49F802C04360.quest_desc: ["The chamber imbues lapis or amethyst into source gems. It slowly gathers source by itself or draws it from jars up to 2 blocks away."]
	quest.472ABD9014318EDC.quest_desc: ["Place it on a filled cage. It passes soul energy to devices within about 8 blocks; the more candlesticks and full cages, the faster they work."]
	quest.47311843F2781185.quest_desc: ["The orb of prophecy opens the portal to Eternal Starlight. You earn it by passing the trial of the ruins' guardian."]
	quest.474DB46D480C706A.quest_desc: ["After the fight a chest remains with the monolith's heart. With the other bosses' spoils it makes the mod's three strongest items."]
	quest.474DB46D480C706A.quest_subtitle: "Milestone"
	quest.474DB46D480C706A.title: "&c{item.bosses_of_mass_destruction.obsidian_heart}"
	quest.475362B010B0186F.quest_desc: ["The Occult Era raised the world to the Ascent tier. Epic items turn up more often, and monsters hit harder too."]
	quest.475362B010B0186F.title: "World tier: Ascent"
	quest.4761BC76B44A7603.quest_desc: ["The crystal from Frostmaw's chest. Hold right-click to channel an icy whirlwind; the crystal recharges by itself in your inventory."]
	quest.4762391CC1A8D060.quest_desc: ["A bag linked to a chosen container. Click an item with it, or it with an item, and the item goes into that container."]
	quest.4764DDC7E9F4E32C.quest_desc: ["With the Rune Era your team's world moved to the Frontier tier: monsters are stronger and loot is rarer and better. The world tier rises with the era and cannot be changed by hand."]
	quest.4764DDC7E9F4E32C.title: "World tier: Frontier"
	quest.477B8E03060F5522.quest_desc: ["A fragile tank breaks on impact and spills its contents around, and the fluid affects everything in reach."]
	quest.477FF4557FF38C2C.quest_desc: ["A furnace on power: it smelts faster than a regular one and needs no fuel. It is the last step of every ore line."]
	quest.4790F1D3E0523768.quest_desc: ["Pulls items from the container or machine it faces into the network."]
	quest.47987C4573FAE888.quest_desc: ["Swaps the blocks in the selected area for others, without digging."]
	quest.479969A980C83F6F.quest_desc: ["The first Spiritus gem soaks up loose Spiritus from your inventory and powers the forge. The forge upgrades it to ever larger gems."]
	quest.479F2F884B9F5589.quest_desc: ["A deep cave under the Highlands, full of trolls. The lamp lies in its vault, and the trolls drop magic beans."]
	quest.479F2F884B9F5589.title: "A Troll Cave"
	quest.47AA1E5F0349A889.quest_desc: [
		"An andesite funnel pulls items out of a container onto a belt, or drops items from a belt into a container. An andesite tunnel joins a belt to the belts beside it and splits items between them."
		""
		"&7This page goes further than the era tree: transport, contraptions and Create redstone. Packaging and the stock network are on the Create storage page.&r"
	]
	quest.47AA1E5F0349A889.title: "Funnels and Tunnels"
	quest.47C175CF5CE4EAB9.quest_desc: ["The strongest stabilizer of this era: a marid ritual with a beacon and a block of iesnium. The Wither gives you the star for the beacon."]
	quest.47C175CF5CE4EAB9.quest_subtitle: "Milestone"
	quest.47C175CF5CE4EAB9.title: "&bThe Fourth Circle"
	quest.47C4B6051DAD3963.quest_desc: ["The cult boss's spell book. Equip it in the Iron's Spells spell book slot."]
	quest.47D49A7F40125D41.quest_desc: ["Light a campfire below a beehive or bee nest so the smoke calms the bees. When the hive is full, use an empty bottle on it. Collect four bottles of honey."]
	quest.47D49A7F40125D41.quest_subtitle: "Milestone"
	quest.47D49A7F40125D41.title: "&aHoney from the Hive"
	quest.47DA4B1A501E44AE.quest_desc: ["Eight repositories make a real library. Each named one gets its own tab in the lectern."]
	quest.47DA4B1A501E44AE.title: "A Library"
	quest.47DC0AC141CBD1D0.quest_desc: ["Copper and zinc in a basin above a lit burner: the &6{block.create.mechanical_mixer}&r turns them into two brass ingots at a time. Stock up 64, since brass goes into almost everything this era."]
	quest.47DC0AC141CBD1D0.quest_subtitle: "Milestone"
	quest.47DC0AC141CBD1D0.title: "&6{item.create.brass_ingot}"
	quest.47FE4871B261C131.quest_desc: ["Write a recipe onto a formula and put it in the assemblicator. It keeps making that item as long as it has ingredients and power."]
	quest.47FE4871B261C131.title: "Automatic Crafting"
	quest.480493B3C65ABE63.quest_desc: ["Stand on it and it charges the devices in your inventory and your armour."]
	quest.48052DCC9310D768.quest_desc: ["Turns a gas into a fluid and back, such as water into water vapour for sulfuric acid. Switch the direction in its window."]
	quest.4809D25D42EE7E86.quest_desc: ["The altar, fuelled by ambrosium shards, enchants Aether items. It turns gravitite ore into enchanted gravitite."]
	quest.4817397C64364879.quest_desc: ["Removes parts from a finished tool. That way you swap a worn head without making the whole tool again."]
	quest.481C508DD5F0E61C.quest_desc: ["A pair of these interfaces, one on a moving contraption and one in the world, passes power when they meet. That is how you charge a train at a station."]
	quest.482018338FB73459.quest_desc: ["Defeat one of them. Its trophy is the first boss part of the seal."]
	quest.482018338FB73459.quest_subtitle: "Milestone"
	quest.482018338FB73459.title: "&c{entity.undergarden.forgotten_guardian} or {entity.minecraft.warden}"
	quest.48285B5CC9CA3230.quest_desc: ["Moves a cell's contents into the network or from the network into a cell. Handy when moving to bigger cells."]
	quest.482E495996D1D398.quest_desc: ["Mine it from ore in the netherrack. It goes into redstone devices and bright, smooth buildings."]
	quest.483F0CC95D6BF23B.quest_desc: ["The Create Shop ties the colony to the logistics network: builders take materials straight from your Create storage."]
	quest.48429439A976071E.quest_desc: ["A honeycomb maze full of bee treasure and traps. Bring torches to find your way back."]
	quest.48429439A976071E.title: "The Cell Maze"
	quest.484D8D933357FC2C.quest_desc: ["Six sanctums in six colours hold trials and bee armour. Each one is different."]
	quest.484D8D933357FC2C.title: "A Sempiternal Sanctum"
	quest.4880FE68B2CCC6E5.quest_desc: ["Umvuthana warriors and the chests in their grove give masks. This one grants strength when worn, and each of the six masks gives a different bonus."]
	quest.488F66BE93D02E80.quest_desc: ["The beekeeper keeps bees in hives by the apiary and collects honey and combs."]
	quest.4890F88AA38D7683.quest_desc: ["The hammer mines stone and ores in a 3×3 area, and the excavator does the same with soil and sand. The hammer only takes ores when you aim at an ore."]
	quest.4890F88AA38D7683.title: "Area Mining"
	quest.48AD12DB989B5C16.quest_desc: [
		"The road leads through ten eras and a finale:"
		"&60&r Stone Era – survival and first tools"
		"&61&r Andesite Era – Create and the first machines"
		"&62&r Rune Era – first magic and the Twilight Forest"
		"&63&r Brass Era – automation, trains and the Nether"
		"&64&r Occult Era – demons, souls and rituals"
		"&65&r Steam and Steel Era – steel, oil, airships and the Aether"
		"&66&r Arcane Era – high magic and the Cataclysm bosses"
		"&67&r Electric Era – power, Mekanism and AE2"
		"&68&r Atomic Era – reactors, the End and the stars"
		"&69&r Transcendent Era – technology and magic combined"
		"&6F&r Finale – the final boss"
		""
		"Every era ends with a &6gate&r. It requires the milestones from the chapter's branches (diamonds) and the seal of the next era. Once you hand it in, your whole team moves on. A seal for a magic era needs technology and vice versa; from the Brass Era on, it also takes trophies of two different bosses."
		""
		"You cannot use or place items from future eras. The tooltip shows which era an item belongs to."
	]
	quest.48AD12DB989B5C16.quest_subtitle: "The road ahead"
	quest.48AD12DB989B5C16.title: "The Eras"
	quest.48B8AB59B58DE069.quest_desc: ["Combine an eye of ender with a witch pupil. Witches drop the pupils."]
	quest.48EC084FA6167EF1.quest_desc: ["Researchers discover colony upgrades here. A research tier cannot exceed the university's level, so research also follows the eras."]
	quest.48EF32E9240E06EA.quest_desc: ["A robot companion: it follows you, picks up dropped items and carries a chest, a crafting table and a furnace. It recharges on its own at its station."]
	quest.48F871BBFDFF6C7A.quest_desc: ["It fires three arrows at once for the price of one. The Snow Queen leaves this bow or the seeker bow."]
	quest.490421CD4368201E.quest_desc: ["Hearty meals from the cooking pot give the Nourishment effect: for a long while your hunger bar does not drop. Eat one."]
	quest.490421CD4368201E.title: "A Nourishing Meal"
	quest.491077D1F54DE545.quest_desc: [
		"Click a copycat block with any block and it takes on that look. Copycats+ adds full blocks, stairs, fences and other zinc shapes to Create's panels and steps."
		""
		"&7The next decoration tier appears here once your team enters the Brass Era.&r"
	]
	quest.491077D1F54DE545.title: "Copycat Blocks"
	quest.4912FEAAB6B229F8.quest_desc: [
		"&7Steam and Steel Era. Recommended gear: gravitite armour and a zanite weapon.&r"
		"The queen of the valkyries waits in the silver dungeon on the clouds. Start the fight by talking to her with ten medals on you."
	]
	quest.4912FEAAB6B229F8.quest_subtitle: "Boss"
	quest.4912FEAAB6B229F8.title: "&c{entity.aether.valkyrie_queen}"
	quest.491623F08799E87C.quest_desc: ["Every swing fires a bright bolt of energy. Recharge the wand with a ritual at the brazier once it runs dry."]
	quest.49186F5EB0E72BA7.quest_desc: ["A copper sheet and a zinc sheet with a redstone torch. The capacitor goes into better electric machines and into the seal."]
	quest.49186F5EB0E72BA7.quest_subtitle: "Seal ingredient"
	quest.491E574EABA5BBA0.quest_desc: ["Turns Create rotation into FE energy. Build it on a &6{block.create.mechanical_crafter}&r."]
	quest.4923E04330605183.quest_desc: ["A water wheel with a Starbuncle inside turns without water or wind. Craft it from a Starbuncle charm and a water wheel."]
	quest.4931415A1D336B9F.quest_desc: ["Place the fisher's hut close to water. Fish are cheap and reliable food for the colony."]
	quest.4931415A1D336B9F.title: "Fisher"
	quest.49472A325F39AA35.quest_desc: [
		"Crimson steel, azure electrum, a crushed shulker shell and a netherite scrap, combined in the alloy forge. The strongest Silent Gear metal."
		""
		"&7Crush a shulker shell with a hammer on the stone anvil.&r"
	]
	quest.49472A325F39AA35.quest_subtitle: "Milestone"
	quest.49472A325F39AA35.title: "&6{item.silentgear.tyrian_steel_ingot}"
	quest.4966648FF35CF1BC.quest_desc: ["A lonely Structory: Towers tower on the outer islands."]
	quest.4966648FF35CF1BC.title: "An End Tower"
	quest.497276E913CE7B0E.quest_desc: ["A windmill taken over by illagers. A small Dungeons Arise dungeon, just right to start with."]
	quest.497276E913CE7B0E.title: "An Illager Windmill"
	quest.497813C8FE2FC820.quest_desc: ["Citizens practise archery here and come out as better archers."]
	quest.497813C8FE2FC820.title: "Archery"
	quest.49A3DD1E6A520D4A.quest_desc: ["The identification filter excludes chosen players and ships from targeting, and a transponder marks your ship as friendly. The cannons will not fire at allies."]
	quest.49A3DD1E6A520D4A.title: "Friend or Foe"
	quest.49AB70FE5018B65E.quest_desc: ["The source motor turns source from a nearby jar into rotation for Create machines. Set the speed and the SU-to-RPM ratio on the motor itself; more power costs more source."]
	quest.49B037170BF0C4EC.quest_desc: ["An ice spike from a frost breath focus and blue ice. Frost spells slow and freeze their targets."]
	quest.49C18231A95AFC82.quest_desc: ["Upgraded elytra made with a soul crystal, a sculk bone and soul dust."]
	quest.49D45418C8713BE5.quest_desc: ["Rope and stone bridges, loft stairs and balconies, street lamps and chandeliers, and trapdoors in many styles."]
	quest.49D45418C8713BE5.title: "Bridges, Stairs and Lamps"
	quest.49DA6C971F3AAA52.quest_desc: [
		"An eye of ender will not show the way here. Find the stronghold with the End portal using an explorer's compass."
		""
		"&7The portal frame only accepts End Remastered eyes, each from a different source. You will find the list on the &aEnd&7 page in the World tab.&r"
	]
	quest.49DA6C971F3AAA52.title: "A Stronghold"
	quest.49E08EB34B573131.quest_desc: ["Four netherite scraps and four gold ingots make an ingot. In this era netherite finally pays off."]
	quest.49EC6CAA2E462A88.quest_desc: ["A scry crystal placed anywhere shows the view from its spot, and the oculus lets you switch between crystals. Watch your farms without walking over."]
	quest.49EC6CAA2E462A88.title: "The Scryer's Eye"
	quest.4A0A7C6B9E905708.quest_desc: ["Fireclay sits in underground rock layers together with bauxite and galena. Each fireclay block drops a ball, and the balls fire into fireproof bricks."]
	quest.4A11C5CB82918175.quest_desc: [
		"Dragon's breath in a bucket from Create: Dragons Plus. A fan blowing through it, or through a dragon head, transforms items like the End: cobblestone into end stone and leather into phantom membrane."
		""
		"&7End stone from the fan is useful for levitite on the airships page.&r"
	]
	quest.4A1AC1CB88A29AD1.quest_desc: ["The netherite stick places the most blocks at once of all Construction Sticks and lasts the longest. Make it from a netherite ingot and sticks."]
	quest.4A2489DE4332C5A2.quest_desc: ["A wing is a light sail for contraptions: it builds a large propeller that weighs little. Fire a wing in a furnace to get a tempered wing."]
	quest.4A2489DE4332C5A2.title: "Tempered Wings"
	quest.4A294ABBB64858EE.quest_desc: ["Casts whole blocks of metal. Molten brass poured onto a stripped log gives a brass casing straight away, and copper gives a copper casing."]
	quest.4A4346823B3DBF20.quest_desc: ["The master miner marid brings back the rarest ores from the dimensional mineshaft. It is made from the afrit miner and a netherite pickaxe."]
	quest.4A45B4B47D6D04FD.quest_desc: ["Carries fluids and keeps them when picked up. Handy for refuelling engines out in the field."]
	quest.4A46CB961A0D8CC5.quest_desc: ["Magma cubes drop it. A potion brewed with it protects you from fire and lava."]
	quest.4A5690414BCAAD82.quest_desc: ["The bases of amulets, rings and belts. On the workbench they become trinkets with effects that you wear in the accessory slots."]
	quest.4A5690414BCAAD82.title: "Basic trinkets"
	quest.4A5E316C6DB55078.quest_desc: ["Metal from the heart of Ignis. It upgrades netherite gear and makes weapons that set things alight."]
	quest.4A5E316C6DB55078.quest_subtitle: "Milestone"
	quest.4A5E316C6DB55078.title: "&c{item.cataclysm.ignitium_ingot}"
	quest.4A7C47B6ED7DC4D7.quest_desc: ["Cobblestone makes a furnace. Smelt ores in it and fire clay into bricks."]
	quest.4AB3C16CDB159F19.quest_desc: ["The steel mechanism is built by sequenced assembly from steel, nickel and lead plates, steel cogwheels and screws. TFMG oil machines need it."]
	quest.4ACA18D1D53973BF.quest_desc: ["On the seal's assembly line a &6{block.create.spout}&r pours 500 mB of lava into it. Pipe lava to the spout with a pump."]
	quest.4ACA18D1D53973BF.quest_subtitle: "Seal ingredient"
	quest.4AD2D93CABC3E791.quest_desc: ["Draw the recipe's pentacle in chalk, put the ingredients in the bowls and click the golden bowl with the bound book. A foliot crusher appears and grinds ores into dusts."]
	quest.4AD2D93CABC3E791.quest_subtitle: "Milestone"
	quest.4AD2D93CABC3E791.title: "&dFirst Summoning"
	quest.4ADCB450861E59F8.quest_desc: [
		"A tall lighthouse on the coast. From its top you can see the sea to the horizon."
		""
		"&7More quests on this page appear here once your team enters the Brass Era.&r"
	]
	quest.4ADCB450861E59F8.title: "A Lighthouse"
	quest.4AE292726D3A215E.quest_desc: ["A team that did not fight the first dragon has to summon it again: four end crystals on the edges of the exit portal."]
	quest.4AE42FD665D3B94C.quest_desc: ["On an anvil it breaks down an enchanted item and returns some of its enchantments in a book. The item itself is lost."]
	quest.4AF27956B3713CDE.quest_desc: ["Instead of cylinders you insert turbine blades. Its casing needs aluminium pipes."]
	quest.4AF27956B3713CDE.title: "Turbine Engine"
	quest.4B207ED26FA0DD3B.quest_desc: ["Stellarite pieces are mined from Stella Arcanum ore, and runes are smelted from runic stone. Both rocks lie deep underground all over the Overworld."]
	quest.4B207ED26FA0DD3B.title: "Stellarite and runes"
	quest.4B252403C7BA10B4.quest_desc: ["An electric pump with a filter upgrade pumps heavy water instead of plain water. The separator splits it into deuterium."]
	quest.4B3505E8A8A16522.quest_desc: [
		"An upgrade rune and a rare metal turn a school robe into a hero's armour: the cryomancer becomes a death knight, the pyromancer a forge master and the cultist a sanguinite hero."
		""
		"&7Upgrade runes turn up in chests; you copy more with mithril and an arcane ingot.&r"
	]
	quest.4B3505E8A8A16522.quest_subtitle: "Milestone"
	quest.4B3505E8A8A16522.title: "&dEmpowered Robes"
	quest.4B4EA220D33EE56F.quest_desc: ["Dropped by the &c{entity.minecraft.ender_dragon}&r. With deorum it becomes a golden dragon scale."]
	quest.4B5732B859E520E9.quest_desc: [
		"Holds QIO drives and shares them on a chosen frequency. Every QIO block on the same frequency sees the same drives, with no cables at all."
		""
		"&7Set the frequency in the array window; it can be private or shared with your team.&r"
	]
	quest.4B5732B859E520E9.quest_subtitle: "Milestone"
	quest.4B5732B859E520E9.title: "&b{block.mekanism.qio_drive_array}"
	quest.4B8D07BE131E3100.quest_desc: ["A powered bow: it never loses durability, and in fire mode it sets arrows alight."]
	quest.4B9591E814238633.quest_desc: ["A pipe carries fluid wherever a pump pushes it. A valve on the pipe opens and closes when you turn it with rotation, so a clutch controls the flow."]
	quest.4B9591E814238633.title: "Pipes and a Valve"
	quest.4BC3B87B91BE3A3E.quest_desc: [
		"Once you have this era's milestones, hand in the &6Seal of the Transcendent Era&r. Your whole team enters the Transcendent Era and the seal is consumed."
		""
		"Assemble the seal on a &6{block.create.mechanical_crafter}&r in a 5×5 grid: 8 aethersent ingots, 4 polonium pellets, 4 ultimate control circuits, 4 deorum ingots, 2 256M components, an antimatter pellet and the trophies of two bosses: one from the End and one from Eternal Starlight."
		""
		"&7See the exact recipe in JEI: hover over the seal and press R.&r"
	]
	quest.4BC3B87B91BE3A3E.quest_subtitle: "Hand in the seal"
	quest.4BC3B87B91BE3A3E.title: "Gate: Transcendent Era"
	quest.4BC6C8F645B17314.quest_desc: ["Gives a redstone signal when the linked cannon is on target. Wire it to the firing mechanism and the cannon shoots the target by itself."]
	quest.4BCC3E9D04407149.quest_desc: ["Red sand from the badlands washed by a fan gives gold nuggets and sometimes a dead bush. Collect 36 nuggets, which makes four ingots."]
	quest.4BCC3E9D04407149.title: "Panning for Gold"
	quest.4BE3D6ECBC1B2E9B.quest_desc: ["A brass casing clad with a &6{item.create.sturdy_sheet}&r. Stations, signals and train controls are made from it."]
	quest.4BEA6E358D12C2B8.quest_desc: ["Giant bones stick out of the sand in the soul sand valley. Break them into bone meal."]
	quest.4BEA6E358D12C2B8.title: "Fossils"
	quest.4BFEF6F2B21E2C32.quest_desc: ["A Goety ritual from a netherite sword, an echo of the void, dragon's breath and a wind core. JEI shows the ingredients."]
	quest.4BFFF141BD9308FE.quest_desc: [
		"In the Occult Era magic buildings grow to level 4, while ordinary ones stay at 3. The alchemist, the graveyard and the Nether worker arrive."
		""
		"&7The next building tier appears here once your team enters the Steam and Steel Era.&r"
	]
	quest.4BFFF141BD9308FE.title: "The Occult in the Colony"
	quest.4C164F51C9723F62.quest_desc: ["A bag with a bound spirit holds more than its size suggests. You carry it like a backpack."]
	quest.4C2461DA7B140AC8.quest_desc: ["They connect every device of the network. Make the glass cable from quartz fiber and fluix, the covered one from it and wool. Cables can be dyed, and different colours don't connect."]
	quest.4C2461DA7B140AC8.title: "Fluix Cables"
	quest.4C39831400CCE792.quest_desc: ["Sulfur dust and heavy oil in a heated vat make a rubber sheet. A press turns it into synthetic leather, and rubber also goes into the engine controller and cables."]
	quest.4C39831400CCE792.title: "Rubber"
	quest.4C49643C2BFD5B95.quest_desc: ["A drilling machine with a drill head extracts ore from the vein below as long as it is powered. Place it once and carry the output away on a belt."]
	quest.4C49643C2BFD5B95.title: "Drilling Machine"
	quest.4C4EB8EFBC2E7784.quest_desc: ["A list filter lets through only the items listed in it, and an attribute filter items with a chosen trait, such as edible or enchanted. Put them into the slots of brass funnels, chutes, arms and deployers."]
	quest.4C4EB8EFBC2E7784.title: "Filters"
	quest.4C5A653D62847D42.quest_desc: ["Offered on the &c{block.cataclysm.altar_of_abyss}&r in the sunken city, it wakes the lord of the deep."]
	quest.4C6F056625C328BE.quest_desc: [
		"An enchanting table with a godforged pearl and a nether star. It changes and improves single affixes instead of rerolling them all."
		""
		"&7The next enchanting tier appears here once your team enters the Electric Era.&r"
	]
	quest.4C72DFEFF29BF8F2.quest_desc: ["The diamond construction stick extends walls by more blocks at once than the iron one and lasts longer. Templates on a smithing table add new modes."]
	quest.4C8243848545732B.quest_desc: ["The waiter cooks meat and fish and hands out food to the citizens. From now on you don't have to feed them yourself."]
	quest.4C8243848545732B.title: "Dining Hall"
	quest.4C8681CA861CB331.quest_desc: ["Each tower houses one guard: a knight, an archer or a druid. Place them by the entrances and the fields."]
	quest.4C8681CA861CB331.title: "Guard Tower"
	quest.4C997D332FE09E9F.quest_desc: ["Ghasts drop it, often straight into lava, so fight them over solid ground. A potion brewed with it restores health."]
	quest.4CA02FD6430D677E.quest_desc: ["Deorum and a dragon scale. A golden scale and the dragon egg make an arcane dragon egg."]
	quest.4CBC95DBD2FF46F8.quest_desc: ["With lacrima and the essence of the storm you forge Astrape or Ceraunus, Scylla's own weapons."]
	quest.4CDBB8A0075E9ED2.quest_desc: ["Alchemical sulfur in the recipe pre-attunes the rod to a whole group of ores: abundant, common, precious or rare."]
	quest.4CDBB8A0075E9ED2.title: "Sulfur-attuned rod"
	quest.4CE206D5F54AC011.quest_desc: ["The fortress of Ignis in the Nether. Ignited berserkers guard it, and Ignis himself waits on the altar of fire at its heart."]
	quest.4CE206D5F54AC011.title: "The Burning Arena"
	quest.4CED3967C4092533.quest_desc: ["Make a foliot book of binding from a taboo book, purified ink, an awakened feather and blue dye. Combine it with the dictionary in the crafting grid to write the spirit's name into it."]
	quest.4D3E410F452CF5F1.quest_desc: ["In activation mode it starts and stops the reactor on a redstone signal; in other modes it gives a signal itself when the heat rises, waste builds up or the casing takes damage. Two adapters wired together shut the reactor down before it blows."]
	quest.4D4D1166E9351E04.quest_desc: ["The palette feeds the wand blocks from its own slots, in order or at random. Walls come out less uniform."]
	quest.4D57767128C41D59.quest_desc: ["Heated by a blaze burner, the &6{block.createmetallurgy.foundry_basin}&r melts metals. On the &6{block.createmetallurgy.casting_table}&r you cast them into ingots, sheets and other shapes in graphite molds."]
	quest.4D57767128C41D59.title: "Foundry"
	quest.4D61EB706C24398C.quest_desc: ["Made from netherite scrap, dragon's breath and a ghast tear. Used, it resets nearby boss structures so you can fight again."]
	quest.4D788DFE12C766B3.quest_desc: ["Pumps power into items. It turns an iron ingot into &6{item.create_new_age.overcharged_iron}&r, the material for better magnets."]
	quest.4D7FD02F4BAFBF87.quest_desc: ["They drop from honey crystals in the hive walls. They are edible, and recipes use them to improve honey gear."]
	quest.4D8F3F8B706F92A5.quest_desc: ["Four smaller compartments in one block. Good for odds and ends you keep a little of."]
	quest.4D959560C1084634.quest_desc: ["Utherium weapons deal extra damage to rotten creatures. You will need it in the depths and the catacombs."]
	quest.4D959560C1084634.quest_subtitle: "Milestone"
	quest.4D959560C1084634.title: "&a{item.undergarden.utherium_sword}"
	quest.4DC788C79A2E098A.quest_desc: ["Black chalk is coloured with witherite dust from an afrit ritual: netherite dust, a wither skeleton skull, blackstone dust and a wither rose."]
	quest.4DCCC363F74FD2CF.quest_desc: ["Iron infused on the altar with refined soulstone and spirits. Four ingots go into the seal, more into a scythe and armor."]
	quest.4DCCC363F74FD2CF.quest_subtitle: "Milestone and seal ingredient"
	quest.4DCCC363F74FD2CF.title: "&d{item.malum.soul_stained_steel_ingot}"
	quest.4DE645DF911A19C7.quest_desc: ["A decorative building with a diamond in its recipe. Its level raises the citizens' happiness."]
	quest.4DE645DF911A19C7.title: "Mystical Site"
	quest.4E099DD64BBB3C5D.quest_desc: ["A superdense energy cell. It evens out demand spikes when crafting CPUs run at full speed."]
	quest.4E0C12E59C027BAA.quest_desc: ["A huge tank of casings, structural glass and valves. It holds a vast amount of a single fluid or chemical."]
	quest.4E0C12E59C027BAA.title: "Dynamic Tank"
	quest.4E0C7A9BD0A8E44B.quest_desc: ["Trade anything with a villager. With emeralds you can buy things you cannot make yet."]
	quest.4E0C7A9BD0A8E44B.quest_subtitle: "Milestone"
	quest.4E0C7A9BD0A8E44B.title: "&aFirst Trade"
	quest.4E2CA6181D1E5D00.quest_desc: ["Connected to a storage with a controller, they act as one huge chest. Hoppers, pipes and belts insert and extract through them from the whole storage."]
	quest.4E2CA6181D1E5D00.title: "Storage Inputs and Outputs"
	quest.4E307DC1657ACB96.quest_desc: ["Draugr in the frosted prison and its chests give black steel. With cursium it makes Maledictus's weapons."]
	quest.4E39A543ADC10385.quest_desc: ["The ruins of an old portal stand in the Overworld. The &c{entity.eternal_starlight.the_gatekeeper}&r guards them."]
	quest.4E39A543ADC10385.title: "Portal Ruins"
	quest.4E615301D937B518.quest_desc: ["A redstone block on a tier one altar. The bigger orb holds more essence and opens up new sigils."]
	quest.4E6950B66E93C8DE.quest_desc: ["Sand and clay mixed in a mixer, or mortar balls combined in the grid. Refractory mortar makes the foundry basin and the industrial crucible."]
	quest.4E72AB01B83217F5.quest_desc: [
		"This page leads through the lands and materials of the Otherside and its ancient temple. The portal and the bosses are in the Electric Era tree."
		""
		"&7Sneak: the sculk senses every loud step.&r"
	]
	quest.4E72AB01B83217F5.title: "Into the Otherside"
	quest.4E8186C07F8624B5.quest_desc: ["The firebox heats the machine above it like a blaze burner while you pump fuel into it, such as LPG or diesel. It heats the chemical vat."]
	quest.4E8AA1EDFE6CB7C9.quest_desc: ["Charged certus, redstone and nether quartz dropped into water fuse into fluix. A mechanical mixer does it faster."]
	quest.4E8E8D7B7C8512D8.quest_desc: [
		"The first MEGA component. It is made from an AE2 256k component, accumulation processors, sky stone dust and vibrant quartz glass."
		""
		"&7Imprint the accumulation press in an inscriber from the calculation and engineering presses and a singularity.&r"
	]
	quest.4E8E8D7B7C8512D8.quest_subtitle: "Milestone"
	quest.4E8E8D7B7C8512D8.title: "&b{item.megacells.cell_component_1m}"
	quest.4E8E9A5A48D1B3F7.quest_desc: ["The Rechiseled chisel: put a stack of blocks into its window and pick a pattern. Many patterns connect with neighbouring blocks into larger panels and frames."]
	quest.4E90EA74BC90D0EC.quest_desc: [
		"First make a head from a template or blueprint and a material, then join it with a rod in the grid. In the Stone Era, flint or bone make a good head."
		""
		"&7A template shows how much material a part needs. Hover over it in JEI.&r"
		""
		"&7The next gear tier appears here once your team enters the Andesite Era.&r"
	]
	quest.4E98BA31FBC78B91.quest_desc: ["The undertaker buries fallen citizens in the graveyard. With the right research the colony can even bring them back."]
	quest.4E98DBA87F17CDD7.quest_desc: ["The maze map draws the corridors around you. Its focus drops from the minotaurs in the Labyrinth and turns up in its chests."]
	quest.4EA467760A2B41E6.quest_desc: [
		"A gold-plated plastic board etched with acid in the vat, then sequenced assembly with a capacitor, a resistor and a transistor. Transistors need silicon semiconductors."
		""
		"&7Check each step in JEI (R on the item).&r"
	]
	quest.4EA467760A2B41E6.quest_subtitle: "Milestone"
	quest.4EA467760A2B41E6.title: "&6{item.tfmg.circuit_board}"
	quest.4EAD98D884F75372.quest_desc: ["Both are controlled by redstone: the clutch disconnects the drive and the gearshift reverses the rotation. A lever next to a clutch is the simplest off switch for a production line."]
	quest.4EAD98D884F75372.title: "Clutch and Gearshift"
	quest.4EB95D5F7313E3C9.quest_desc: ["Diseases are on in this pack: a sick citizen stops working. The healer in the hospital cures him with the items he needs."]
	quest.4F0C04500AC4AB41.quest_desc: ["A keepsake from the fight. Keep it: a trophy placed on the pedestal in the dark forest opens the Knight Stronghold in the Occult Era."]
	quest.4F0CE6D6B4EBAA64.quest_desc: ["A gantry carriage rides along a spinning gantry shaft and carries the attached contraption. A gantry mounted on another gantry's carriage reaches along two axes."]
	quest.4F0CE6D6B4EBAA64.title: "Gantry"
	quest.4F1E16630FE094DD.quest_desc: ["The full focus is made in the enchanting apparatus from a lesser focus and a mark of mastery. Wear it in the focus slot and the spells of your element grow stronger still."]
	quest.4F1E16630FE094DD.title: "Elemental Focus"
	quest.4F2963CEBC70FC54.quest_desc: ["A stronger stabilizer from a djinni ritual: a block of silver and a ghast tear on the previous tier stabilizer."]
	quest.4F2D7F2DEBE79B75.quest_desc: ["Defeat the &c{entity.deeperdarker.stalker}&r, the &c{entity.goety.vizier}&r or the &c{entity.goety.hostile_redstone_monstrosity}&r. The trophy completes the seal."]
	quest.4F2D7F2DEBE79B75.quest_subtitle: "Milestone"
	quest.4F2D7F2DEBE79B75.title: "&cA Second Boss of the Era"
	quest.4F3358E0232752E9.quest_desc: [
		"Craft the novice spell book from a book and iron tools. You know the basic glyphs, such as {ars_nouveau.glyph_name.glyph_projectile}, {ars_nouveau.glyph_name.glyph_touch} and {ars_nouveau.glyph_name.glyph_harm}, from the start."
		"Make your first new glyph, {ars_nouveau.glyph_name.glyph_light}, at the scribe's table from a lantern and a torch. Pick it up, then use it (right-click) to learn it."
	]
	quest.4F3358E0232752E9.quest_subtitle: "Milestone"
	quest.4F3358E0232752E9.title: "&dSpell Book and First Glyph"
	quest.4F48B1C0D086D183.quest_desc: ["A lava crystal transmuted on the altar. Bind it to yourself (use it in hand) and click the master stone with it to awaken a finished circle."]
	quest.4F731EC8BC0F93D3.quest_desc: ["The inside of the hill hides ores and chests, guarded by goblins in red caps. The chests hold steeleaf and ore magnets."]
	quest.4F731EC8BC0F93D3.title: "A Hollow Hill"
	quest.4F9C7BC8ED02F39A.quest_desc: ["The only egg on the server appears on the portal after the first fight. Whoever takes it holds a trophy no one else can match."]
	quest.4FB3328007FC9406.quest_desc: ["An underground chamber where the Wroughtnaut stands still until you step inside."]
	quest.4FB3328007FC9406.title: "The Wrought Chamber"
	quest.4FB612026B40E5E6.quest_desc: ["The importer pulls items from a container or machine into QIO, and the exporter pushes chosen items out. Set the filters in their windows."]
	quest.4FB612026B40E5E6.title: "Importer and Exporter"
	quest.4FC2E16D06DF68AC.quest_desc: ["A treasure map leads to a chest buried on a beach. Dig where the red cross points."]
	quest.4FC2E16D06DF68AC.title: "Buried Treasure"
	quest.4FC90757CEF764F8.quest_desc: ["Placed on a tank, it lets you fill and empty it with a bucket or a bottle in one click. It is the first of the Create: Dragons Plus blocks, a mod that also adds new kinds of fan processing."]
	quest.4FCF92A7D1FDE972.quest_desc: [
		"End stone powder from crushing wheels, zinc nuggets and water mixed in a mixer make levitite blend, which crystallises into levitite when heated. Enough levitite on a contraption keeps it afloat without balloons or propellers."
		""
		"&7Ponder (hold W over the item) shows how to put it together.&r"
	]
	quest.4FCF92A7D1FDE972.quest_subtitle: "Milestone"
	quest.4FCF92A7D1FDE972.title: "&6Levitite"
	quest.4FD99E2AF448654D.quest_desc: ["Mines under giant mushrooms: minecarts, shafts and the miners' chests."]
	quest.4FD99E2AF448654D.title: "The Mushroom Mines"
	quest.5003C3B4B511E07B.quest_desc: ["Fuses any materials into a super alloy. Building it needs a block of tyrian steel and a beacon."]
	quest.5006AF1457F1861C.quest_desc: ["The brazier starts rituals: place an item on it and light it with flint and steel, with the components on receptacles around it."]
	quest.5012967720B78C97.quest_desc: ["Forests of Japanese sugi cedars, carnation fields and meadows with cypresses. Visit all three."]
	quest.5012967720B78C97.title: "Nature's Spirit"
	quest.5012B9756887FF5E.quest_desc: ["Summons skeleton servants: quicker and smarter than zombies, and they shoot bows. It also comes from a necroturgy ritual."]
	quest.5023D3D6CD8C30CE.quest_desc: ["The highest stack tier: a slot holds an almost unlimited number of items. It is made from the tier 5 upgrade."]
	quest.504233A9D5A41735.quest_desc: ["An afrit ritual with a totem of undying and a block of gold. Get afrit essence from a summoned unbound afrit."]
	quest.504746BF3ED61422.quest_desc: ["Flies on hydrogen from the electrolytic separator. Switch modes with a key; hover mode keeps you in the air."]
	quest.505B234254A9140A.quest_desc: ["A bow that adds the spell from your book to every arrow. It works with the projectile form."]
	quest.506CE8DB5AEDA87C.quest_desc: ["A sodium-cooled reactor passes superheated sodium to the boiler, and the boiler turns water into steam for the turbine. Superheating elements can also heat it with power."]
	quest.506CE8DB5AEDA87C.title: "Thermoelectric Boiler"
	quest.507507B59617EF3A.quest_desc: ["Connect the &6{block.create.millstone}&r to power and drop wheat into it. Flour mixed with water makes dough."]
	quest.507507B59617EF3A.quest_subtitle: "Milestone"
	quest.507507B59617EF3A.title: "&6Millstone and Flour"
	quest.5078BA0E7807155B.quest_desc: ["The Arcane Era took the world to the Summit tier. Mythic items appear, and Apotheosis invaders are more dangerous than ever."]
	quest.5078BA0E7807155B.title: "World tier: Summit"
	quest.507BD077A63219A4.quest_desc: ["Hold 256 brass casings at once. Let logs and molten brass reach the casting basins on their own and the finished casings go into storage."]
	quest.507BD077A63219A4.quest_subtitle: "Automation proof"
	quest.507BD077A63219A4.title: "Casing Foundry"
	quest.50890A13904C4FD2.quest_desc: ["Rare metals niter from the digestion vat. The reformation array turns it into the sulfur of a chosen rare metal, and the incubator into ingots."]
	quest.50890A13904C4FD2.quest_subtitle: "Milestone"
	quest.50890A13904C4FD2.title: "&dExaltation"
	quest.50A0B849F5BE4EF6.quest_desc: ["Seeds and a book make the occultist's dictionary: it describes rituals, pentacles and spirits. Check it before every new ritual."]
	quest.50A395C90433A6C1.quest_desc: [
		"Chests in structures have separate contents for every player, so nobody can take your loot."
		""
		"Claim your land on the FTB Chunks map. Claimed chunks are protected from players outside your team."
		""
		"PvP is switched on and off by the administrator."
		""
		"When you die, your inventory stays in your corpse at the place of death."
	]
	quest.50A395C90433A6C1.title: "Server Rules"
	quest.50AD8FFC78D7010E.quest_desc: ["Destroys chosen items before they fill the backpack, such as cobblestone and dirt while mining."]
	quest.50AE221D4F023BB7.quest_desc: ["Hold 512 crushed ore of any metal at once. You only get that much when ore reaches the wheels and the output reaches storage on its own."]
	quest.50AE221D4F023BB7.quest_subtitle: "Automation proof"
	quest.50AE221D4F023BB7.title: "Ore Crusher"
	quest.50BC623AA6269B8B.quest_desc: ["An enchantment library infused in the table. It holds more and hands out books of higher levels than the plain one."]
	quest.50C487255D37AE5B.quest_desc: ["Iron infused in the cursed infuser. Cursed metal goes into cages, soul candlesticks, the witch's cauldron and staves."]
	quest.50CDEEAE12DF8214.quest_desc: [
		"Packs the contents of the neighbouring container into packages and unpacks packages that reach it. Make it from a block of cardboard, an iron ingot and redstone."
		""
		"&7Write an address on a sign next to the packager and packages get it for the road.&r"
	]
	quest.50CDEEAE12DF8214.quest_subtitle: "Milestone"
	quest.50CDEEAE12DF8214.title: "&b{block.create.packager}"
	quest.50CE5F33B31D01C4.quest_desc: ["A stabilized warp scroll is not used up and also works across dimensions. Used on a block, it opens a temporary portal to the remembered spot. The recipe needs blaze powder."]
	quest.50D505A3C7A29009.quest_desc: ["A breech closes the back of the barrel and opens for loading, so you never take the cannon apart. Cast the sliding one from cast iron, bronze or steel and the screw one from steel or nethersteel; Ponder (W) shows how to operate them."]
	quest.50D505A3C7A29009.title: "Breeches"
	quest.50DBAC95CF4E9B94.quest_desc: ["A totemic staff with a mnemonic fragment and soul stained steel fires hex bolts. With void salts and malignant pewter it becomes the erosion scepter."]
	quest.50E20D7DA134239B.quest_desc: ["Powers the network and hands out channels: each face of the controller gives 32. Several controllers side by side merge into one larger block."]
	quest.50EB3015AB3CBC40.quest_desc: [
		"&7Brass Era · recommended: diamond armor&r"
		"The pumpkin lord of Born in Chaos. He rises when you use a &c{item.born_in_chaos_v1.transmuting_elixir}&r on an &c{block.born_in_chaos_v1.infernal_evil_pumpkin}&r."
	]
	quest.50EB3015AB3CBC40.quest_subtitle: "Boss"
	quest.50EB3015AB3CBC40.title: "&cLord Pumpkinhead"
	quest.50F40BC98964D915.quest_desc: ["Lowers and raises a structure on a rope. It makes a simple lift or a crane over a mine shaft."]
	quest.51009F35FA1A7EA6.quest_desc: ["The Apostle's blood, dragon's breath, crying obsidian and an eye of ender with an empty focus. Combined with raw gold in the grid it doubles the gold; it loses durability but repairs itself with soul energy."]
	quest.512520FF526566D3.quest_desc: ["A gun carriage on wheels that you can roll elsewhere. Unlike the cannon mount, it cannot be automated."]
	quest.5136857AB9394112.quest_desc: ["Pulls items out of a container and sends them down a logistical transporter by filter. Each filter can give the items a route colour."]
	quest.513CD380495A2428.quest_desc: ["Presses metals into sheet metal – a separate Silent Gear material with its own traits."]
	quest.513D91C74C54CD80.quest_desc: ["Signals split the network into sections and keep a train out of a section another train occupies. At passing loops and junctions they prevent crashes."]
	quest.5145B3F784329175.quest_desc: ["A Dungeons Arise monastery: several floors and a courtyard. Search every cell."]
	quest.5145B3F784329175.title: "A Monastery"
	quest.5148704D08860304.quest_desc: [
		"The ion vector thruster swivels its nozzle like the liquid one but runs on power. With a gimbal sensor it keeps the ship balanced on its own."
		""
		"&7More quests on this page appear here once your team enters the Atomic Era.&r"
	]
	quest.514CBCE88CFFA3A2.quest_desc: [
		"&7Rune Era · iron armour and a shield recommended.&r"
		""
		"A giant serpent guards a courtyard in the Twilight Forest. It charges across the whole arena, so step aside and strike from the flank."
		"You find it in the Naga Courtyard."
	]
	quest.514CBCE88CFFA3A2.quest_subtitle: "Boss"
	quest.514CBCE88CFFA3A2.title: "&c{entity.twilightforest.naga}"
	quest.51720D57B1E30245.quest_desc: ["Shipwrecks lie on the sea floor and on beaches. The captain's chest often holds a treasure map."]
	quest.51720D57B1E30245.title: "A Shipwreck"
	quest.5189E09E4D1AFF55.quest_desc: [
		"Put a cannon together from a chamber, a barrel and a breech, then assemble it on the cannon mount. Cast the chamber from cast iron, bronze or steel."
		""
		"&7Ponder (W) on the mount shows assembly, loading and firing.&r"
	]
	quest.5189E09E4D1AFF55.quest_subtitle: "Milestone"
	quest.5189E09E4D1AFF55.title: "&6A Cannon"
	quest.5196434BFBBB736E.quest_desc: ["The Lunar Monstrosity always leaves a bow, the crescent spear and a wand of teleportation."]
	quest.5196434BFBBB736E.title: "Spoils of the Monstrosity"
	quest.51B66B2FC54FA7E6.quest_desc: ["A water-cooled reactor makes steam, and the steam spins the turbine. It is the main power source of the Atomic Era."]
	quest.51B66B2FC54FA7E6.title: "Industrial Turbine"
	quest.51BB1CC6031829D4.quest_desc: ["Mine the Forbidden \\& Arcanus arcane crystal underground with an iron pickaxe. One goes into the seal as the reagent; smelt the rest into dust."]
	quest.51BB1CC6031829D4.quest_subtitle: "Seal ingredient"
	quest.51BE14859D8ECCCC.quest_desc: ["With a pattern provider, a molecular assembler and a crafting CPU the network makes whatever you request in the terminal."]
	quest.51BE14859D8ECCCC.title: "Crafting on Demand"
	quest.51BF256E2BE70BE5.quest_desc: ["The Wither drops it after the fight."]
	quest.51E31692C16DB5D7.quest_desc: ["Automation proof: 512 andesite alloy. The mixer makes it from andesite and iron or zinc nuggets if you deliver them by belt or funnel."]
	quest.51E31692C16DB5D7.title: "Alloy at Scale"
	quest.5205A6722A1B0524.quest_desc: ["Incense is brewed in the crucible or crafted from herbs and resin. Once lit it affects everything nearby: some heal the living, others the undead, or keep zombies and skeletons away."]
	quest.5205A6722A1B0524.title: "First incense"
	quest.520964CC45735879.quest_desc: ["An in-between stack tier made with a block of copper. You can skip it and go straight to tier 2."]
	quest.521F248FA24C4736.quest_desc: ["The enrichment chamber makes it from uranium ingots. It is the first step towards nuclear fuel."]
	quest.52374DCF1C7DC049.quest_desc: ["The slicer with a knife inside does the cutting board's work by itself: put the ingredients on a depot or a belt below it."]
	quest.5241A8A7FEE99752.quest_desc: [
		"The third capacity tier, from a block of diamond and the gold upgrade. One drawer holds the stock of a whole production line."
		""
		"&7The next drawer tier appears here once your team enters the Arcane Era.&r"
	]
	quest.52555AE7A28D0B48.quest_desc: ["These mystic eyes reveal leylines and the Fae, which the naked eye cannot see."]
	quest.525D6ECD35551B84.quest_desc: ["A large structure of &6{block.mekanism.sps_casing}&r turns polonium into antimatter. It devours huge amounts of power doing so."]
	quest.525D6ECD35551B84.title: "The SPS"
	quest.526418D7DEB3AC24.quest_desc: [
		"You see iesnium ore in the Nether only with the Third Eye or otherworld goggles. Smelted, it gives ingots for the pickaxe, the anvil and Occultism machines."
		""
		"&7The next Occultism tier appears here once your team enters the Steam and Steel Era.&r"
	]
	quest.526418D7DEB3AC24.quest_subtitle: "Milestone"
	quest.526418D7DEB3AC24.title: "&d{item.occultism.iesnium_ingot}"
	quest.5267AE4FBA1B66E7.quest_desc: ["A backpack with this upgrade never disappears: lava, explosions and the void cannot destroy it. The recipe needs an end crystal."]
	quest.5267D0A3D3F9363E.quest_desc: [
		"Every device on the network takes one channel. A normal cable carries 8 channels, a dense one 32. Without a controller the network handles at most 8 devices."
		""
		"&7When channels run out, the devices at the end of the cable stop working. Run dense cables from the controller and normal ones only to groups of devices.&r"
	]
	quest.5267D0A3D3F9363E.title: "Channels"
	quest.5294DE711B59AFEB.quest_desc: ["A locometal boiler, a smokestack and a track buffer do not change how a train runs, but with them it looks like a real steam engine. Smokestacks puff while the train moves."]
	quest.5294DE711B59AFEB.title: "Locomotive Looks"
	quest.52BC8CE33F05D4E4.quest_desc: [
		"Apothic Enchanting changes the enchanting table: the shelves around it give three stats. Eterna raises the maximum enchanting level, Quanta widens the spread of enchantment power, and Arcana raises the chance of more and rarer enchantments."
		""
		"&7The table window shows its stats; shelves from later eras raise them further.&r"
	]
	quest.52BC8CE33F05D4E4.title: "Eterna, Quanta, Arcana"
	quest.52C1030ED76BE8F9.quest_desc: ["It gleams like a diamond, yet swallows light. Brew it from coal, a ghast tear, essence of death, a soul shard and a diamond; Eidolon's strongest gear is built on it."]
	quest.52C1030ED76BE8F9.quest_subtitle: "Milestone"
	quest.52C1030ED76BE8F9.title: "&d{item.eidolon_repraised.shadow_gem}"
	quest.52C43052B583CAE2.quest_desc: ["Links one block to many targets at once and remembers the linking order. You build a relay network without hundreds of clicks."]
	quest.52CADEADF5F81F94.quest_desc: ["Turns the same metal from different mods into one version, such as lead ingots, so they do not clog your storage."]
	quest.52D69A3C6B95485C.quest_desc: ["Places a row, a column or a whole plane of blocks with one click. It takes the blocks from your inventory."]
	quest.52E2147A3049BCC7.quest_desc: [
		"Points to the nearest structure you pick. Craft it from a compass, a cobweb and cracked stone bricks."
		""
		"&7It searches step by step, so a distant structure may take a while to show up. Start with the nearby ones.&r"
	]
	quest.52EC26F6E5126BC5.quest_desc: ["Built into the crafting CPU, it shows what is being made right now."]
	quest.52EE08756643708D.quest_desc: ["It lies in buried treasure. With nautilus shells it becomes a conduit that lets you breathe underwater."]
	quest.52FE099BC94CFBB9.quest_desc: ["Defeat one more boss of this era, other than the Minoshroom and the Hydra. Any of the other eight counts, and its trophy also goes into the seal."]
	quest.52FE099BC94CFBB9.quest_subtitle: "Milestone"
	quest.52FE099BC94CFBB9.title: "&cA Second Boss of the Era"
	quest.53053FC2149ED08B.quest_desc: ["Logistical transporters carry items between machines and containers. A route colour tells them where to go."]
	quest.5320796741B160F7.quest_desc: ["An icy curse like a wraith's claws: a struck target stops regenerating health. The wraith heart it needs drops from wraiths."]
	quest.5329A128BFA66887.quest_desc: ["The drain empties containers dropped onto it: honey bottles give up their honey, buckets their contents."]
	quest.532D893E23412D94.quest_desc: ["Attach it to a vault or chest and click it: it moves your inventory, except the hotbar, inside."]
	quest.534CA2E2649BB2FF.quest_desc: [
		"&7Rune Era · iron armour and a shield recommended&r"
		""
		"The Twilight Forest bosses guard its deeper reaches. A magic barrier lets you into the next structure only after you defeat the previous guardian: first the Naga, then the Lich."
		"The fights count for the boss quests in the era chapter. Here you find the preparations and the spoils."
	]
	quest.534CA2E2649BB2FF.title: "Twilight Forest Bestiary"
	quest.53585A49C7906B53.quest_desc: [
		"Fiery metal mends itself in sunlight and sets enemies alight. It makes armour and tools."
		""
		"&7The next Twilight Forest tier appears here once your team enters the Occult Era.&r"
	]
	quest.53585A49C7906B53.quest_subtitle: "Milestone"
	quest.53585A49C7906B53.title: "&c{item.twilightforest.fiery_ingot}"
	quest.5368F7476CC4F6FD.quest_desc: ["Fill a bucket with oil from the pumpjack. Crude oil alone is of little use until distillation splits it into fuels."]
	quest.5368F7476CC4F6FD.title: "Crude Oil"
	quest.5371385A1787DDD8.quest_desc: ["The centrifugal clutch only engages once the speed passes a set threshold. The freewheel clutch only engages when the input spins the right way."]
	quest.5371385A1787DDD8.title: "Smart Clutches"
	quest.53716E06C4EAD701.quest_desc: ["The key of the brass dungeon's guardian. Its vault holds an aercloud necklace, a cloud cape or gloves of reach."]
	quest.53A32F809B45CAFE.quest_desc: [
		"Power flows, and you reach for the very core of matter. Split uranium gives polonium and plutonium, and from them comes antimatter."
		"The End and the world of Eternal Starlight open up. If you wish, you can also fly a rocket to the Moon."
		""
		"The era ends at the gate. It requires the milestones of the branches in this chapter and the Seal of the Transcendent Era."
	]
	quest.53A32F809B45CAFE.quest_subtitle: "The era begins"
	quest.53A32F809B45CAFE.title: "Atomic Era"
	quest.53A450898DC781C4.quest_desc: ["A temple deep in the Otherside. Its chests hold smithing templates, sculk bones and soul dust, and one chamber is hidden."]
	quest.53A450898DC781C4.quest_subtitle: "Milestone"
	quest.53A450898DC781C4.title: "&aThe Ancient Temple"
	quest.53C358870CB0DDE2.quest_desc: ["Fill a source jar to the brim, 10,000 source, and look at it. That is what the enchanting apparatus consumes for the next era's seal, so keep a few full jars."]
	quest.53C358870CB0DDE2.quest_subtitle: "Milestone"
	quest.53C358870CB0DDE2.title: "&d10,000 Source"
	quest.53C4716BE3EA5FC2.quest_desc: [
		"Summons a Starbuncle that carries items between chests and picks up the ones lying nearby."
		""
		"&7Approach a wild Starbuncle in a forest holding a gold nugget. It takes it, vanishes and leaves shards for the charm.&r"
	]
	quest.53D6730BD8E97A6C.quest_desc: ["Sculk, a Tabula Aetherea, a weak blood shard and a nether star in the Hellfire Forge. Four clusters crown the pillars of the fifth altar tier."]
	quest.53D6730BD8E97A6C.title: "Crystal clusters"
	quest.53DF6FCDEC7DAA7C.quest_desc: [
		"Every power source has a capacity in &6stress units&r (SU), and every machine uses some of it – the faster it spins, the more. Speed is measured in revolutions per minute (RPM)."
		"When the machines need more SU than the sources provide, the whole network stops. Add a power source or slow the machines down."
		""
		"&7This page goes further than the era tree: gearing, measurement, rotation control and steam. Engineer's goggles show both values when you look at a Create block.&r"
	]
	quest.53DF6FCDEC7DAA7C.title: "Stress and Speed"
	quest.53E6DDB7F5E10E60.quest_desc: ["When you fall below half health, the helm knocks back nearby enemies and raises your defence, knockback resistance and regeneration."]
	quest.53F04FE3A9B7373A.quest_desc: ["The dark wand upgraded with cursed metal, ectoplasm and spirit fabric. It empowers necroturgy: one cast summons several servants."]
	quest.53F04FE3A9B7373A.quest_subtitle: "Milestone"
	quest.53F04FE3A9B7373A.title: "&d{item.goety.necro_staff}"
	quest.53F44E98C4BA341D.quest_desc: ["An artisan scroll teaches the station a new jewellery design. Patterns turn up in chests, and some can be bought from the jeweller villager."]
	quest.5402D8D9BA230AA9.quest_desc: ["Solar generators give power by day, with no fuel or care. The advanced one is large and far more efficient."]
	quest.5402D8D9BA230AA9.title: "Sunlight"
	quest.54356F890014B79D.quest_desc: ["It is sewn from wicked weave: wool with a shadow gem and an unholy symbol. The hat raises magic damage by half, the cloak halves the magic damage you take, and the boots protect against slowness."]
	quest.54356F890014B79D.title: "Warlock's attire"
	quest.54369DCCBC9BEEAA.quest_desc: ["The next step: even more space and upgrade slots."]
	quest.54369DCCBC9BEEAA.quest_subtitle: "Milestone"
	quest.54369DCCBC9BEEAA.title: "&b{item.sophisticatedbackpacks.iron_backpack}"
	quest.5436C5ED05292EC8.quest_desc: [
		"Take the scepter from the guard tower window and mark patrol points or the spot the guard should hold."
		""
		"&7More quests on this page appear here once your team enters the Brass Era.&r"
	]
	quest.543B64F6A5C22D46.quest_desc: ["Give a Siren a sea pickle and a Flashjack a flashpine; both leave tokens for a charm. The Flarecannon is made in the apparatus from fire essence and netherite scrap."]
	quest.543B64F6A5C22D46.title: "An Elemental Helper"
	quest.54838E9A3EBAEB40.quest_desc: ["The book describes spells, catalysts and magic circles. JEI also shows the scroll recipes."]
	quest.548B8A2E2BB1A0E5.quest_desc: ["A crafting table in the chest window. It takes ingredients straight from the chest."]
	quest.54905A4E4F0B095C.quest_desc: ["Weapon parts of mithril and an arcane ingot are the base of mage swords: the spellbreaker, the amethyst rapier, the boreal blade and the twilight gale. Each carries its own spell."]
	quest.54905A4E4F0B095C.title: "A Spellblade"
	quest.54A27D72882687A4.quest_desc: ["The digestion vat moves niter between tiers of matter, for example from common to rare metals, like iron to gold."]
	quest.54A46C967804D8FC.quest_desc: ["A ritual tablet that awakens what surrounds it. With a book and feathers in the ritual brazier it wakes a Bookwyrm."]
	quest.54B1EA40C7E0A425.quest_desc: ["A &6{block.mekanism.chemical_crystallizer}&r locks the antimatter from the SPS into a pellet. One is enough for the seal."]
	quest.54B1EA40C7E0A425.quest_subtitle: "Milestone · seal ingredient"
	quest.54B1EA40C7E0A425.title: "&6{item.mekanism.pellet_antimatter}"
	quest.54B4156207419686.quest_desc: ["Craft the copper spell book from copper, string and paper. Equip it in the spell book slot: spells inscribed from scrolls are cast from it without using up scrolls."]
	quest.54B4156207419686.title: "A Spell Book of Your Own"
	quest.54B9C357C38E5CD5.quest_desc: ["Put on engineer's goggles and take the wrench from the era's starter pack in hand. The wrench rotates Create blocks, and a sneak-click puts them back into your inventory."]
	quest.54B9C357C38E5CD5.title: "Engineer's Outfit"
	quest.54BBFB206E231A81.quest_desc: ["A crafting table inside the backpack. It takes ingredients straight from the backpack's contents."]
	quest.54C0B70CE68A00D0.quest_desc: [
		"Build the mould from Goety's Black Book and click the centre reinforced block with an animation core. It is the strongest of your servants; repair it with redstone blocks."
		""
		"&7When it falls it drops its head, which revives it more cheaply.&r"
	]
	quest.54C0B70CE68A00D0.quest_subtitle: "Milestone"
	quest.54C0B70CE68A00D0.title: "&dThe ultimate war machine"
	quest.54D7930D16D15C75.quest_desc: ["Each sigil is a different reagent in the array, and stronger ones need a better slate. Many of them toggle on with Shift and right-click."]
	quest.54D7930D16D15C75.title: "Utility sigil"
	quest.54ECD456BF8A2629.quest_desc: [
		"A huge energy store built from casings, structural glass and ports. The cells inside set the capacity, and the providers how much FE flows per tick."
		""
		"&7Switch a port between input and output with a configurator.&r"
	]
	quest.54ECD456BF8A2629.quest_subtitle: "Milestone"
	quest.54ECD456BF8A2629.title: "&6Induction Matrix"
	quest.55023C299CB945E0.quest_desc: ["A chute with a filter: it lets only chosen items through and can count them."]
	quest.5504FC56D0824B9B.quest_desc: ["The highest Ars Nouveau book holds the most spells and tier-three glyphs. The recipe needs a nether star, a totem of undying and a wilden tribute from the Chimera."]
	quest.5504FC56D0824B9B.quest_subtitle: "Milestone"
	quest.5504FC56D0824B9B.title: "&d{item.ars_nouveau.archmage_spell_book}"
	quest.55514DCA32B43CDF.quest_desc: ["Stone from hot springs, smelted in a furnace. These ingots make tools and armour."]
	quest.555CCD4FDF89891B.quest_desc: [
		"The Guardian's gauntlet. Held in your main hand, it pulls creatures in when you use it."
		""
		"&7The next Cataclysm tier appears here once your team enters the Transcendent Era.&r"
	]
	quest.5569EC8FA544F7F6.quest_desc: ["A heated vat splits naphtha into ethylene and propylene, then turns them into molten plastic. Cast it into sheets in a casting basin."]
	quest.556E877D9ABA7554.quest_desc: ["A casing of lead and steel, fuel assemblies inside and control rods above them. Watch the cooling: an overheated reactor can explode."]
	quest.556E877D9ABA7554.quest_subtitle: "Milestone"
	quest.556E877D9ABA7554.title: "&6Fission Reactor"
	quest.558A6E927FC04705.quest_desc: ["Apply a brass ingot to a stripped log or wood. It is the base of the seal and of half the machines of this era."]
	quest.558A6E927FC04705.quest_subtitle: "Seal ingredient"
	quest.5591FD6E615737D8.quest_desc: ["Spiritfire provides &d{block.occultism.otherstone}&r. Its bricks and pillars suit an occultist's tower."]
	quest.5591FD6E615737D8.title: "Otherworld Stone"
	quest.5593A86BF8D66E60.quest_desc: ["Frostmaw sleeps out in the open in a snowy biome. Approach with care: once awake, it breathes ice."]
	quest.5593A86BF8D66E60.title: "Frostmaw's Den"
	quest.55AEB1E9462B828E.quest_desc: ["You turn them by hand like a crank, and the other way while sneaking. They mesh with cogwheels next to them, so they need no separate shaft."]
	quest.55AEB1E9462B828E.title: "Crank Wheels"
	quest.55B51E8ECCA9C9AD.quest_desc: ["An arcane cog of metal, arcane essence and redstone. The technomancy focus and a part of many Cataclysm: Spellbooks recipes."]
	quest.55C41E33E355B051.quest_desc: ["A shorter cousin of the regular engine: a radial block with cylinders around the shaft."]
	quest.55F4BBFDB3CEBA21.quest_desc: ["Copycat blocks cut from a zinc ingot take on the look of the block you click them with. Copycats+ adds slopes, layers, doors and dozens of other shapes."]
	quest.55F4BBFDB3CEBA21.title: "Copycat Blocks"
	quest.55F620412DD9285B.quest_desc: ["A bigger magic bag. The recipe needs an eye of ender."]
	quest.5635F21BAE39B284.quest_desc: [
		"&7Arcane Era. Recommended gear: full netherite armour and fire resistance potions.&r"
		"The burning knight guards the arena. Place burning ashes on the altar of fire and he awakens."
	]
	quest.5635F21BAE39B284.quest_subtitle: "Boss"
	quest.5635F21BAE39B284.title: "&c{entity.cataclysm.ignis}"
	quest.5652ECC6C043512A.quest_desc: ["The jar stores source from nearby sourcelinks and feeds it to devices around it. The source stays inside when you break and move the jar."]
	quest.567A945675A4668C.quest_desc: ["Two nickel ingots, silicon and two steel ingots mixed in a heated basin. This alloy makes magnets and transformer cores."]
	quest.567F9E3A92CFDD01.quest_desc: ["A Building Wands wand places a row or a whole plane of blocks with one click and has several modes. The stone one is the simplest."]
	quest.56AF5294911FC1A2.quest_desc: ["The pulse repeater turns a signal into a short pulse after a set delay, the extender lengthens a pulse, and the timer sends pulses on its own at a set interval."]
	quest.56AF5294911FC1A2.title: "Pulses"
	quest.56C8A918170C2319.quest_desc: ["ME cables eat fluix quickly. Automate certus charging and fluix mixing before the network grows."]
	quest.56C8A918170C2319.quest_subtitle: "Automation proof"
	quest.56D0A53AFC644F79.quest_desc: ["Armchairs, sofas and chairs made from Create seats. You can sit on them in a moving contraption or train too."]
	quest.56D0A53AFC644F79.title: "Create: Interiors"
	quest.56E30E2228D03001.quest_desc: ["Sets which side of a machine takes in and outputs items, fluids, chemicals and energy. Switch modes with Shift and right-click."]
	quest.56E5620FC5621E83.quest_desc: ["Minotaurs in the Labyrinth drop it, and it turns up in the Labyrinth's chests."]
	quest.56FCFB3D4482DC11.quest_desc: ["Beef, potato and carrot cooked in the pot. The stew also goes into the seal."]
	quest.56FCFB3D4482DC11.quest_subtitle: "Seal ingredient"
	quest.56FDC002E0BF6894.quest_desc: ["The dark altar runs Goety's rituals: the activation item goes on the altar, the ingredients on pedestals around it, and the ritual spends souls from the totem."]
	quest.5701D26C1D823E9E.quest_desc: ["Obsidian forms when water flows over a lava source. It ignores an iron pickaxe, but a &6{block.create.mechanical_drill}&r mines it."]
	quest.5701D26C1D823E9E.title: "Obsidian from the Drill"
	quest.572CA3255019880B.quest_desc: [
		"&7Gear: magic resistance and plenty of healing.&r"
		"The enraged Dead King casts more and stronger spells than the ordinary one. A better reward awaits the victor."
	]
	quest.572CA3255019880B.quest_subtitle: "Boss"
	quest.572CA3255019880B.title: "&c{entity.gametechbcs_spellbooks.hard_dead_king}"
	quest.57762B864DAACBEF.quest_desc: ["Extends the block placement reach. The recipe uses a netherite upgrade template from a bastion."]
	quest.579AFDF7D65CDAAF.quest_desc: [
		"Drills, saws, harvesters and ploughs work while the contraption moves. A piston with a row of drills bores a tunnel, and a bearing with saws fells a whole tree."
		""
		"&7The quest checks the Create advancement for a contraption with tools on board.&r"
		""
		"&7More quests on this page appear here once your team enters the Brass Era.&r"
	]
	quest.579AFDF7D65CDAAF.title: "Contraption at Work"
	quest.57A13FC9DC28BBCD.quest_desc: ["A horizontal fluid tank that fits where an upright one will not. As a steam boiler it is less efficient than a regular tank."]
	quest.57A1EFB450BD18EB.quest_desc: ["The heart of the Clibano furnace, made from darkstone and a blast furnace. Clibano smelts ores and crystals more efficiently than a plain furnace, and with the artisan relic it also makes alloys."]
	quest.57B6AA92B34C083E.quest_desc: [
		"An iron chestplate and a binding reagent in the array. Sentient armour learns from what you go through and gains upgrades by training."
		""
		"&7The next Neo Vitae tier appears here once your team enters the Steam and Steel Era.&r"
	]
	quest.57E34B4F51618983.quest_desc: ["Reforge each piece of netherite armour in a second tier forge ritual with dragon scales and obsidiansteel."]
	quest.57E34B4F51618983.quest_subtitle: "Milestone"
	quest.57E34B4F51618983.title: "&dDraco Arcanus armour"
	quest.57E42A8BD4EE01DC.quest_desc: ["Made from an ordinary diesel engine. You line modular engines up on a shared shaft, and their power grows with each one."]
	quest.57F78BDAB42DC922.quest_desc: ["The swivel bearing turns the structure glued to it, and rotation from a shaft passes straight through it. A redstone signal unlocks it so it spins freely."]
	quest.5813C75ACD86D402.quest_desc: [
		"The Ritual of Binding performed by a Starbuncle, Drygmy or other creature turns it into a bound script. From the script you learn a familiar that follows you and strengthens your spells."
		""
		"&7Summon the familiar from the Ars Nouveau familiar menu; check its key in the controls settings.&r"
	]
	quest.5813C75ACD86D402.quest_subtitle: "Milestone"
	quest.5813C75ACD86D402.title: "&dFirst Familiar"
	quest.58237CA7E7D596F1.quest_desc: ["A speed upgrade makes a machine faster, and an energy upgrade cuts its power use. Put them in the upgrade panel on the side of the machine window."]
	quest.58237CA7E7D596F1.title: "Machine Upgrades"
	quest.5827F3131DDD5272.quest_desc: ["Strong Tau processed in the Athanor; JEI shows which tool it needs. The shard is the key to the third altar tier."]
	quest.5846243BDD48D309.quest_desc: ["The compacting drawer turns nuggets into ingots and ingots into blocks on its own. One drawer holds your whole stock of a metal."]
	quest.58524679C8F4EE70.quest_desc: [
		"The Tenebrae diviner knows the advanced rites: automatic essence, flight within your sanctum and a meteor laden with treasure."
		""
		"&7The next Neo Vitae tier appears here once your team enters the Arcane Era.&r"
	]
	quest.5857AAD82B30CC8F.quest_desc: [
		"&7Occult Era · recommended: netherite armor&r"
		"The knight phantoms guard the heart of the stronghold and fight together. Once they all fall, the way to the Dark Tower opens."
	]
	quest.5857AAD82B30CC8F.quest_subtitle: "Boss"
	quest.5857AAD82B30CC8F.title: "&c{entity.twilightforest.knight_phantom}"
	quest.58654D9FC8257D1D.quest_desc: ["The Seal of the Brass Era joins magic and machines: the andesite casing goes in the middle of the apparatus, the press and the water wheel on pedestals."]
	quest.58654D9FC8257D1D.quest_subtitle: "Seal ingredient"
	quest.58654D9FC8257D1D.title: "Create Parts for the Seal"
	quest.586CEB4A4C9DC7F4.quest_desc: ["A chemical tank holds gases and a fluid tank holds fluids. They keep their contents when picked up."]
	quest.586CEB4A4C9DC7F4.title: "Tanks"
	quest.58A474BF45942BE4.quest_desc: ["The whole QIO storage in your pocket, on the same frequency. The recipe needs polonium from a reactor."]
	quest.58BA3EA7072BA248.quest_desc: ["Links relays to jars and to each other: click the source first, then the target. It also sets the home of your helpers."]
	quest.58BF072F912D136C.quest_desc: ["Place a bed and look at it for a moment. It lets you sleep through the night and respawn next to it."]
	quest.58BF072F912D136C.quest_subtitle: "Milestone"
	quest.58BF072F912D136C.title: "&aA Bed of Your Own"
	quest.58C750F8A589135A.quest_desc: ["Create Deco offers brass catwalks, windows, bars and lamps. Make them on a crafting table or in a stonecutter from brass ingots and sheets."]
	quest.58C750F8A589135A.title: "Brass Decor"
	quest.58CBE64255700D53.quest_desc: ["The press is made from two AE2 presses and a &b{item.ae2.singularity}&r, the processor itself from a print on sky steel, fluix dust and silicon."]
	quest.58D17712DACB5B30.quest_desc: ["A lid on a basin or a bulk fermenter turns sugar and bone meal into ethanol. The bulk fermenter makes twice as much."]
	quest.58D17712DACB5B30.title: "Fermentation"
	quest.58D1CC10E40C8004.quest_desc: [
		"The guide to Ars Nouveau: glyphs, rituals, familiars and devices. Craft it from a book and lapis."
		""
		"&7These quests extend the magic branch of the Rune Era chapter.&r"
	]
	quest.58EA7307AD2C3346.quest_desc: ["A tall tower of the warp mages from Ars Additions. Search its floors and chests."]
	quest.58EA7307AD2C3346.title: "Nexus Tower"
	quest.58FFC06DD90D9804.quest_desc: [
		"Your first ring made at the jewelcrafting station. The metal decides its strength, the gem its bonus."
		""
		"&7More quests on this page appear here once your team enters the Arcane Era.&r"
	]
	quest.59078FB8638076D6.quest_desc: ["Ender drawers on the same frequency share their contents, even across dimensions. The recipe needs an ender chest."]
	quest.590F3990007A92D8.quest_desc: [
		"A press over a basin compacts an iron ingot with coal into cast iron. Cast iron makes pipes, tanks and valves, and the blast furnace hatch as well."
		""
		"&7The main steel line is in the Steam and Steel Era chapter. This page extends it.&r"
	]
	quest.591789DB17E2977D.quest_desc: ["A liquid-fuelled thruster that swivels its nozzle up, down and sideways. It steers the ship with thrust alone, without rudders or propellers."]
	quest.593C8AAB8243A271.quest_desc: ["An oxygen tank and a mask let you breathe underwater. Fill the tank with oxygen from the separator."]
	quest.593C8AAB8243A271.title: "Scuba Gear"
	quest.594B63B2E2FD2FD0.quest_desc: ["Glowing stripes on the cable show how many channels run through it. It makes bottlenecks easy to find."]
	quest.595A475F2748C272.quest_desc: ["Magnetite blocks lie in the Overworld like any ore. Magnetite is the core of the basic motor and of the strongest magnets."]
	quest.5965A70AABD940AE.quest_desc: [
		"The Bumblezone is a dimension inside a giant beehive. It is a side trip: it does not affect the era gates."
		""
		"&cDo not hurt the bees or take honey in front of the swarm, or the whole hive turns on you.&r"
	]
	quest.5965A70AABD940AE.title: "Inside the Hive"
	quest.597017FC777F73A0.quest_desc: ["The focus strengthens summoning spells. It is made in the enchanting apparatus from the tribute and a wilden horn, spike and wing."]
	quest.5975AA6F64285BD0.quest_desc: [
		"Yaw and pitch controllers next to a cannon mount aim the cannon at a radar contact by themselves once a targeting filter in the network controller enables targeting."
		""
		"&7Ponder (hold W over the item) shows the whole process.&r"
	]
	quest.5975AA6F64285BD0.quest_subtitle: "Milestone"
	quest.5975AA6F64285BD0.title: "&6Automatic Aiming"
	quest.599A5336E22779AA.quest_desc: [
		"The Altar of Life, made from a furnace, gold and stone. It turns blood into Essentia Vitae and spends it to transmute the item laid in its basin."
		""
		"&7The mod's guide is the Scriptura Vitae (a book and redstone).&r"
	]
	quest.59B7032A9B64E5CE.quest_desc: ["Create: Interiors chairs anchor a player to a contraption just like Create seats, but they look like furniture. Put them in a passenger carriage."]
	quest.59B7032A9B64E5CE.title: "Passenger Seat"
	quest.59CCD46F81334CAE.quest_desc: ["Spin a pair of crushing wheels up to the maximum speed of 256 RPM. The faster they turn, the faster they grind."]
	quest.59CCD46F81334CAE.title: "Crusher at Full Speed"
	quest.59FE85A5E327CDB2.quest_desc: ["A rare ore in the stones and ice of this dimension. A diamond and sticks make a pickaxe."]
	quest.59FE85A5E327CDB2.title: "A Starlit Diamond"
	quest.5A0A86DAFB4D5400.quest_desc: ["Prisms are made in rituals with the elementarium on the forge. The smelter prism gives the fiery modifier (mined ores come out smelted), the terrastomp prism the demolishing one and the sea prism the aquatic one."]
	quest.5A0A86DAFB4D5400.title: "Elemental prism"
	quest.5A1911850C984603.quest_desc: [
		"Carries rotation like a shaft but snaps when the network is overstressed. A piece of shaft cut with a saw protects the other machines from stalling."
		""
		"&7More quests on this page appear here once your team enters the Brass Era.&r"
	]
	quest.5A1A0A99C8D00D22.quest_desc: ["Shows how fast the shaft running through it spins. A comparator signal grows with the speed."]
	quest.5A3EEEF104791B0F.quest_desc: ["The jar holds up to 100 doses of one potion, and the flask takes eight sips from it at once. The flask recipe needs a block of gold."]
	quest.5A3EEEF104791B0F.title: "Potion Jar and Flask"
	quest.5A416D9BE26B1DF0.quest_desc: ["The diamond stick extends walls by even more blocks at once and rarely wears out."]
	quest.5A494CCAE6913D20.quest_desc: ["Collects items lying in front of the drawer. Place it under a farm and the harvest goes straight in."]
	quest.5A71C5EA9533AA40.quest_desc: [
		"&7Gear: your best armour and plenty of food.&r"
		"The Goety illagers' war machine, stronger than any golem. It appears at the end of an illager raid once the other raiders are down."
	]
	quest.5A71C5EA9533AA40.quest_subtitle: "Boss"
	quest.5A71C5EA9533AA40.title: "&c{entity.goety.hostile_redstone_monstrosity}"
	quest.5A725536D35042F2.quest_desc: ["Paper with blue dye. A blueprint made from it is permanent: it stays in the grid after every part you make with it."]
	quest.5A92BED52C415431.quest_desc: ["Collects and pours fluids straight from the backpack. It works with buckets and with fluid blocks in the world."]
	quest.5A9B278AE2E15BB8.quest_desc: [
		"Waystones stand in villages and in the wild. Click one to activate it: from any active waystone you can travel to any other you already know."
		""
		"&7Travel costs experience levels: the farther, the more, up to 27. A jump to another dimension costs the same.&r"
		""
		"&7More quests on this page appear here once your team enters the Andesite Era.&r"
	]
	quest.5A9B278AE2E15BB8.quest_subtitle: "Milestone"
	quest.5A9B278AE2E15BB8.title: "&aA Waystone"
	quest.5AAA7DA6CEEDCB73.quest_desc: ["Shows a Starbuncle the way: click the Starbuncle with it, then the chest to deliver to. The reverse order sets the chest to take from."]
	quest.5AAF1AE8953BA6F9.quest_desc: ["A laser hits a &6{item.mekanismgenerators.hohlraum}&r filled with deuterium and tritium, and the reaction sustains itself. It yields huge amounts of power."]
	quest.5AAF1AE8953BA6F9.title: "Fusion Reactor"
	quest.5ABAFD835E5F9B4B.quest_desc: ["Towers go inside the barracks. They share the barracks' level and hold more guards with every level."]
	quest.5ABAFD835E5F9B4B.title: "Barracks Tower"
	quest.5ADC09F6FFCFB7EA.quest_desc: ["Wind a resistor in the winding machine with a constantan wire spool; constantan is an alloy of copper and nickel. It goes into circuit boards and the polarizer."]
	quest.5ADFE8A241A4DE13.quest_desc: ["The colony grows: ten citizens make a small settlement."]
	quest.5ADFE8A241A4DE13.title: "Ten Citizens"
	quest.5B05263D23BC656C.quest_desc: ["It lies in the chests of pillager outposts."]
	quest.5B1F1DC0044D9AD3.quest_desc: ["Every tree in this book leads here. The final boss waits on its own arena, and defeating it completes the pack."]
	quest.5B1F1DC0044D9AD3.quest_subtitle: "The last trial"
	quest.5B1F1DC0044D9AD3.title: "Finale"
	quest.5B3DCC5D47CB5A13.quest_desc: ["A smooth stone platform and metro panels are enough for an underground station. Add a departures board and you are done."]
	quest.5B3DCC5D47CB5A13.title: "Metro Station"
	quest.5B52EC7338B66FC8.quest_desc: ["Sculk leeches and sculk snappers drop it. It also turns up in the temple chests."]
	quest.5B5EE04A4468E020.quest_desc: ["Nullscape reshapes the outer islands: crystal peaks, shadowlands and barren voids. Visit all three."]
	quest.5B5EE04A4468E020.title: "Nullscape Lands"
	quest.5B6A03BBC90BB2C8.quest_desc: ["On the arcane anvil it removes an imbued spell or upgrade from an item, and in the crafting grid it wipes a rune back to a blank runestone."]
	quest.5B71FE2C6A8F492B.quest_desc: ["The marid book of binding with green dye, combined with the dictionary. The marid is the mightiest spirit you can bind."]
	quest.5B9DFFC1AFEC0403.quest_desc: ["The crystallization ritual at the brazier destroys nearby undead and leaves soul shards behind. The recipe is in the book."]
	quest.5BAAF6D7A7F0DB08.quest_desc: ["Moves items down between floors. With a fan below or above it, it pushes them upwards too."]
	quest.5BC232B70C3C6E44.quest_desc: ["The chef cooks complex dishes, Farmer's Delight meals included in this pack. A varied diet raises happiness."]
	quest.5BD1B40623293600.quest_desc: [
		"&7Brass Era · recommended: diamond armor, a shield&r"
		"This illager conjures fangs and vexes and teleports during the fight. It waits in a woodland mansion."
	]
	quest.5BD1B40623293600.quest_subtitle: "Boss"
	quest.5BD1B40623293600.title: "&c{entity.illagerinvasion.invoker}"
	quest.5BD6936A8792636B.quest_desc: ["The reverse of the alternator: it takes FE and turns a shaft at up to 256 RPM. Set the speed on the motor itself; slower means less power used."]
	quest.5BEA2E6701541E25.quest_desc: ["The plateau at the top ends the road through the Twilight Forest. A castle stands here, but its master has not yet arrived."]
	quest.5BEA2E6701541E25.quest_subtitle: "Milestone"
	quest.5BEA2E6701541E25.title: "&a{biome.twilightforest.final_plateau}"
	quest.5BF342198B2E3854.quest_desc: [
		"The Remnant leaves a block of ancient metal, and the block gives nine ingots. They make the ancient spear, which hurls a sandstorm."
		""
		"&7The next Cataclysm tier appears here once your team enters the Atomic Era.&r"
	]
	quest.5BFA132FF84F20DC.quest_desc: ["A full set for your first trips deep into the forest. You make the ingots from liveroot, raw iron and a gold nugget."]
	quest.5BFA132FF84F20DC.title: "Ironwood Armour"
	quest.5C0A8F22D7CE6368.quest_desc: ["A smart observer gives a signal when a chosen item shows up in a container or on a belt. A threshold switch reacts when a container fills above or empties below a threshold."]
	quest.5C0A8F22D7CE6368.title: "Content Sensors"
	quest.5C2E2D24EC32DB10.quest_desc: ["Blossoming woods and pine barrens from the Environmental mod."]
	quest.5C2E2D24EC32DB10.title: "Environmental"
	quest.5C3B0BD665832263.quest_desc: ["The vitalic sourcelink draws source from animals born or dying nearby, the mycelial one from food you drop into it. One of them is enough."]
	quest.5C3B0BD665832263.title: "Other Sourcelinks"
	quest.5C42ABC32D1D9FB6.quest_desc: ["A winding tower of blackstone, made by Explorify."]
	quest.5C42ABC32D1D9FB6.title: "The Black Spiral"
	quest.5C54CDF789A5A4E8.quest_desc: ["The magic of the Arcane Era still needs steel: a steel casing from the Steam and Steel Era goes onto a pedestal of the seal."]
	quest.5C54CDF789A5A4E8.quest_subtitle: "Seal ingredient"
	quest.5C57E2D5F683D4F9.quest_desc: ["Filters by traits instead of names, such as “can be smelted” or “is an ore”."]
	quest.5C580E692F630F64.quest_desc: ["A great Incendium structure on the quartz flats. Its vault hides deep inside."]
	quest.5C580E692F630F64.quest_subtitle: "Milestone"
	quest.5C580E692F630F64.title: "&aThe Sanctum"
	quest.5C627B1FE2DB7973.quest_desc: ["Automation proof: 256 logic processors. Encode processing patterns for the inscribers and the network orders the prints and assembles the processors itself."]
	quest.5C627B1FE2DB7973.title: "Processor Line"
	quest.5C71D86C98FA0D26.quest_desc: ["Makes Silent Gear alloys in bulk: a block of crimson iron gives three crimson steel ingots, and iron with coal gives high carbon steel."]
	quest.5C71D86C98FA0D26.quest_subtitle: "Milestone"
	quest.5C71D86C98FA0D26.title: "&6{block.silentgear.alloy_forge}"
	quest.5C82D5FBE1E61D6C.quest_desc: ["A Deep Aether dungeon of nimbus stone. A storm rages at its end."]
	quest.5C82D5FBE1E61D6C.title: "The Brass Dungeon"
	quest.5CA544501A83065F.quest_desc: ["The simplest cylinder is made from an iron sheet and flint and steel. A diesel cylinder needs aluminium, and with a spark plug it becomes a gasoline cylinder."]
	quest.5CA544501A83065F.title: "Cylinders"
	quest.5CC2444299911699.quest_desc: ["The warehouse gathers the colony's supplies and couriers deliver them to workers. The builder no longer has to wait for you."]
	quest.5CC2444299911699.title: "Colony Warehouse"
	quest.5CC59E24E374B2DC.quest_desc: [
		"The Naga drops scales. With a scale you can pass the barrier around the Lich Tower, and a few of them make scale armour."
		""
		"&7The next Twilight Forest tier appears here once your team enters the Brass Era.&r"
	]
	quest.5CC59E24E374B2DC.quest_subtitle: "Milestone"
	quest.5CC59E24E374B2DC.title: "&c{item.twilightforest.naga_scale}"
	quest.5CDCF57E0219A241.quest_desc: ["A third ring of runes (52 in total) and four-block pillars capped with bloodstone bricks. A brick is made from a blood shard and stone."]
	quest.5CDCF57E0219A241.title: "Altar tier three"
	quest.5CF4CB83D0301EDB.quest_desc: ["Multiplies a drawer's capacity. Put it into an upgrade slot in the drawer window; higher tiers come in later eras."]
	quest.5CF702CF9744BF2F.quest_desc: ["A flap display shows text from a display link on a large surface. It suits a station or a storage status board."]
	quest.5D0F39D8E7E5AAD3.quest_desc: ["The undertaker buries a fallen citizen in the graveyard before the grave fades away."]
	quest.5D0F39D8E7E5AAD3.title: "A Burial"
	quest.5D1324ACED9A8423.quest_desc: ["The trowel places random blocks from a palette you set up, so walls and roads don't look like one block. A wand template on a smithing table adds a wand mode."]
	quest.5D1B7F9FE4054D42.quest_desc: [
		"Inventory cables join chests in different rooms, and a cable connector hooks any container up to them. The network needs one inventory connector."
		""
		"&7The cable connector recipe needs quartz from the Nether.&r"
	]
	quest.5D1B7F9FE4054D42.quest_subtitle: "Milestone"
	quest.5D1B7F9FE4054D42.title: "&bA Cable Network"
	quest.5D21E1D7BE156889.quest_desc: ["Connect the pulling end of a pumped pipe to water. From a large body of water the pump draws endlessly, which is what spouts, washing fans and later steam boilers need."]
	quest.5D21E1D7BE156889.title: "Your Own Water Supply"
	quest.5D25B687E0D447EB.quest_desc: [
		"The stronger the magnets around a coil, the larger the share of rotation that turns into power. The coil then uses more SU, though."
		""
		"&7An energiser makes overcharged gold and diamond.&r"
	]
	quest.5D25B687E0D447EB.title: "Stronger Magnets"
	quest.5D3EAF0D8F911EF4.quest_desc: ["Hold 256 packed gunpowder at once. Let gunpowder from a farm or a TFMG mixer reach the press without your help."]
	quest.5D3EAF0D8F911EF4.quest_subtitle: "Automation proof"
	quest.5D3EAF0D8F911EF4.title: "Powder Works"
	quest.5D46B11490562A75.quest_desc: ["Passes power from its input connector to its output connector only while it gets a redstone signal. One lever cuts off a whole branch of the grid."]
	quest.5D4815B56228BA21.quest_desc: ["The farmer works the fields marked next to his hut and feeds the colony."]
	quest.5D4815B56228BA21.title: "Farmer"
	quest.5D62B4CE8C8C46BE.quest_desc: ["Holds several foci, so you switch the wand's spell without digging through your inventory."]
	quest.5D71B2B7D3F25109.quest_desc: ["The jeweller's guide: it describes patterns, metals and gems and what each combination grants."]
	quest.5D7589E3D990F630.quest_desc: ["Hold 256 flint at once. A millstone grinds cobblestone into gravel and gravel into flint: put a drill next to a cobblestone generator and link it all with a belt."]
	quest.5D7589E3D990F630.quest_subtitle: "Automation proof"
	quest.5D7589E3D990F630.title: "Flint in Bulk"
	quest.5D7A3A9975D51154.quest_desc: [
		"The lord's hat strengthens pumpkin weapons, protects you from fire and sets your attackers alight."
		""
		"&7The next world boss tier appears here once your team enters the Occult Era.&r"
	]
	quest.5D9D6B88DE62D6D0.quest_desc: ["Automation proof: 512 brass ingots. You won't do that by hand – let copper and zinc flow into the basin on their own, and the ingots into storage."]
	quest.5D9D6B88DE62D6D0.title: "Brass Works"
	quest.5DAEA20EFA6C8D5F.quest_desc: [
		"Three sulfur dusts, nitrate and water in a vat with a mixer. The acid goes into accumulators and etches circuit boards."
		""
		"&7Crush dirt on crushing wheels to get nitrate.&r"
	]
	quest.5DB93BA6770DC163.quest_desc: ["The postbox lets you order goods from the warehouse, and the stash takes things for the courier to collect."]
	quest.5DB93BA6770DC163.title: "Postbox and Stash"
	quest.5DC9FEF87A8C87FB.quest_desc: ["Keeps a stock of chosen items for machines and accepts into the network everything put into it."]
	quest.5DE5FDF54351C05C.quest_desc: ["Pulls nearby items on the ground into the chest. Handy next to mob and crop farms."]
	quest.5DF46CB065481F2A.quest_desc: ["One of the two is enough: a water wheel or a windmill driving a machine."]
	quest.5DF46CB065481F2A.quest_subtitle: "Milestone"
	quest.5DF46CB065481F2A.title: "&6First Power"
	quest.5E06FAA2FCFC47C6.quest_desc: ["Gold and quartz infused with spirits on the Malum spirit altar. It is the only magical ingredient of the Seal of the Atomic Era."]
	quest.5E06FAA2FCFC47C6.quest_subtitle: "Seal ingredient"
	quest.5E123B2FAE9A349E.quest_desc: ["Every piece needs polonium, HDPE and an ultimate control circuit. With modules it becomes your armour for the rest of the game."]
	quest.5E123B2FAE9A349E.quest_subtitle: "Milestone"
	quest.5E123B2FAE9A349E.title: "&6MekaSuit"
	quest.5E173B7F25834017.quest_desc: ["An awakened emerald combined with an empty focus. It goes into crowns, rings and the heart of the night."]
	quest.5E1C588E91C5B4A5.quest_desc: ["Magnetite infused with overcharged diamond and gold. The strongest magnet for New Age coils."]
	quest.5E3156B584956A90.quest_desc: ["Open it in mid-air to float gently to the ground. Craft it from cold aerclouds."]
	quest.5E36AC6D17881DC6.quest_desc: ["It crushes cobblestone into gravel, gravel into sand and sand into clay. In the Brass Era ordinary buildings go up to level 3."]
	quest.5E36AC6D17881DC6.title: "Crusher"
	quest.5E492879077E6ACF.quest_desc: ["It lies at the top of the temple. At a smithing table it upgrades diamond gear with a resonarium plate."]
	quest.5E492879077E6ACF.title: "Resonarium Template"
	quest.5E49617147F3AA5A.quest_desc: [
		"The mechanical grindstone strips enchantments from items and turns them into liquid experience. Pipe it like any Create fluid and fill a bucket."
		""
		"&7Ponder (W) shows how the grindstone works.&r"
	]
	quest.5E49617147F3AA5A.title: "Liquid experience"
	quest.5E8963EBCE1D33BF.quest_desc: ["The steering wheel lets you steer the ship from the deck. Ponder (W) shows how to connect it."]
	quest.5E8AAD7F4E021B09.quest_desc: ["Polonium goes into the MekaSuit, its modules, the fusion reactor frame and the largest QIO drives from the Storage page. Collect 16 pellets."]
	quest.5E8AAD7F4E021B09.title: "Polonium Stock"
	quest.5EAFE5A707DDE18A.quest_desc: ["The reward for the Sculptor's trial. It lifts boulders, digs tunnels and raises pillars, and recharges in your inventory."]
	quest.5EAFE5A707DDE18A.quest_subtitle: "Milestone"
	quest.5EAFE5A707DDE18A.title: "&c{item.mowziesmobs.earthrend_gauntlet}"
	quest.5EB8D600E3FC4A2C.quest_desc: ["A second ring of runes one level down (24 in total) and four corner pillars capped with blood stained glass. Smelt the glass from sands of vitae."]
	quest.5EB8D600E3FC4A2C.title: "Altar tier two"
	quest.5EC7B7B95A593E93.quest_desc: ["Combine the guardian's nuggets into an ingot of forgotten metal. With a smithing template it upgrades cloggrum tools."]
	quest.5EDD91AC87AC75E1.quest_desc: ["A tip made of a material such as diamond or redstone adds a fixed bonus to a tool's stats. Hold Ctrl to see them."]
	quest.5EF52EC41E8A9EED.quest_desc: ["Store your own experience in it as fluid and take it back whenever you like."]
	quest.5F17F7AF7E6422E1.quest_desc: ["A rare crystal from regalium ore. It also turns up in the catacomb chests."]
	quest.5F1B2002A402CF9E.quest_desc: ["The trowel converts plain palette blocks into their Chipped and Rechiseled variants on its own. No need to carry every pattern separately."]
	quest.5F1E48AF5125A86B.quest_desc: ["A gauge you attach to a machine with a wrench. It shows extra information, such as the crucible's heat."]
	quest.5F1EA8FA6531E9CC.quest_desc: ["Hydrogen chloride raises processing to four shards per ore block."]
	quest.5F3B675A7597B4AC.quest_desc: ["The Valkyrie Queen's key. The silver dungeon's treasure chest holds a holy sword, a lightning sword, an invisibility cloak or a regeneration stone."]
	quest.5F3D657BDA4F6CBE.quest_desc: [
		"&7Gear: water breathing, a ranged weapon, your best armour.&r"
		"It is invincible outside the water, so you fight on its ground."
	]
	quest.5F3D657BDA4F6CBE.quest_subtitle: "Boss"
	quest.5F3D657BDA4F6CBE.title: "&c{entity.cataclysm.the_leviathan}"
	quest.5F78F20E1B068EDF.quest_desc: ["Places whole walls and floors of the chosen block, in many shapes at once. It runs on power: charge it like any FE device."]
	quest.5F871BB9255A6DB1.quest_desc: ["A single cell with its own terminal on top. Enough for a small storage without a controller."]
	quest.5F9670FA9D06E8C2.quest_desc: ["One of the two Twilight Forest bosses is enough. Its trophy is one of the two boss trophies the seal needs."]
	quest.5F9670FA9D06E8C2.quest_subtitle: "Milestone"
	quest.5F9670FA9D06E8C2.title: "&cNaga or Lich"
	quest.5F9BEC137397BB8A.quest_desc: [
		"&7Steam and Steel Era. Recommended gear: a bow and good armour.&r"
		"The guardian of the Deep Aether brass dungeon, which hangs high up in the clouds. You have to hit it first to start the fight."
	]
	quest.5F9BEC137397BB8A.quest_subtitle: "Boss"
	quest.5F9BEC137397BB8A.title: "&c{entity.deep_aether.eots_controller}"
	quest.5F9E25159923F4E4.quest_desc: ["Sequenced assembly on a golden sheet: deployers add cogwheels and an iron nugget, and the cycle repeats several times. Some attempts end as scrap. The mechanism goes into arms, trains and the seal."]
	quest.5F9E25159923F4E4.quest_subtitle: "Milestone and seal ingredient"
	quest.5F9E25159923F4E4.title: "&6{item.create.precision_mechanism}"
	quest.5FA8A23DA5514B11.quest_desc: [
		"The actuator keeps items in a pocket of another dimension: thousands of them in one block, with a search bar and a crafting grid."
		"You assemble it from two ritual parts: the base (a foliot, an otherstone pedestal, copper and gold) and the crystal matrix (a djinni, a block of quartz, an ender pearl)."
		""
		"&7The rituals and their pentacles are in the Dictionary of Spirits.&r"
	]
	quest.5FA8A23DA5514B11.quest_subtitle: "Milestone"
	quest.5FA8A23DA5514B11.title: "&bDimensional Storage"
	quest.5FBA1A088DCE0781.quest_desc: [
		"A foliot janitor picks up items lying around and takes them to a chosen chest."
		""
		"&7The next dimensional storage tier appears here once your team enters the Atomic Era.&r"
	]
	quest.5FBF284F739CDAFA.quest_desc: ["Place it on a boiler and it whistles with steam when it gets a redstone signal. More whistles stacked on top lower the pitch."]
	quest.5FEDA7CCB2D7149D.quest_desc: ["The strongest of Goety's scythes: its slashes fly through the air, hit distant targets and leave them vulnerable. It repairs itself with soul energy."]
	quest.5FF0CD42F43D353D.quest_desc: ["In sunlight it bombards nuclear waste with neutrons and turns it into polonium. Pipe the reactor's waste into it."]
	quest.5FFBDADB6BF6B8D5.quest_desc: ["Teach the carpenter the door recipe in the sawmill window. A crafter only makes what you have taught him."]
	quest.5FFBDADB6BF6B8D5.title: "Teaching a Recipe"
	quest.60132F93531E1A5A.quest_desc: ["A heart of the deep, a soul crystal and a sculk bone. The staff charges up and releases a sound wave like the &c{entity.minecraft.warden}&r."]
	quest.601348DB24457802.quest_desc: [
		"One stick can carry several templates. Switch between them with “{key.constructionstick.change_upgrade}” or in the options window (“{key.constructionstick.open_gui}”)."
		""
		"&7The next stick tier appears here once your team enters the Steam and Steel Era.&r"
	]
	quest.601348DB24457802.title: "Several Templates at Once"
	quest.602A6DCEC704669E.quest_desc: ["A rebuilt temple full of traps and hidden passages. Watch your step."]
	quest.602A6DCEC704669E.title: "A Jungle Temple"
	quest.6040FC8DCAE63763.quest_desc: ["The thread of reach extends your block and entity reach by one block per level. Sew it into your robes at the alteration table."]
	quest.606E30C13378CEFE.quest_desc: ["The material you get by salvaging epic items."]
	quest.608CF799F30A7569.quest_desc: ["The fan blows a stream of air through the block in front of it. Through fire it smokes and bakes, through lava it smelts, through water it washes items."]
	quest.60A79A7408663768.quest_desc: ["A fan blowing through soul fire haunts items: sand turns into soul sand, and a peculiar bell into a haunted bell. Ring it and it shows the spots where monsters can spawn."]
	quest.60A79A7408663768.title: "Haunted Bell"
	quest.60D52ABC1C27D732.quest_desc: ["Pumps heat one way along the pipe instead of waiting for it to spread."]
	quest.60E2F0D72741CD17.quest_desc: ["A map made with the maze focus draws the corridors around you, floor by floor. Without it, getting lost is easy."]
	quest.60E2F0D72741CD17.title: "The Maze Map"
	quest.6114725448FDA60C.quest_desc: ["An icy cave in the snowy forest, full of ordinary yetis. The Alpha Yeti waits in the largest chamber."]
	quest.6114725448FDA60C.title: "The Yeti Cave"
	quest.61184EB93DBC27D9.quest_desc: [
		"You start empty-handed, and trees will not yield to your fists. You need flint: dig it out of gravel and turn the shards into your first tools."
		""
		"The era ends at the gate. It requires the milestones of every branch in this chapter and the Seal of the Andesite Era."
	]
	quest.61184EB93DBC27D9.quest_subtitle: "Where it all begins"
	quest.61184EB93DBC27D9.title: "Stone Era"
	quest.6124FF820414C41A.quest_desc: ["It freezes water into ice and turns other items into their cold versions. Aether icestone is its fuel."]
	quest.612AF254D469E7B0.quest_desc: ["A lesser focus strengthens the spells of one element. Imbue an amethyst shard with the essence of your element, with a gold ingot added."]
	quest.612AF254D469E7B0.title: "Lesser Elemental Focus"
	quest.61306AE4484A4FE9.quest_desc: [
		"&7Brass Era · recommended: diamond armor&r"
		"The ice giant sleeps in snowy biomes and wakes up when you come too close."
	]
	quest.61306AE4484A4FE9.quest_subtitle: "Boss"
	quest.61306AE4484A4FE9.title: "&c{entity.mowziesmobs.frostmaw}"
	quest.613561F625D0DBDF.quest_desc: ["Diesel is not the only thing the distillation tower makes. Fill buckets with gasoline, kerosene, naphtha and heavy oil, and a tank with LPG: each fraction feeds a different machine."]
	quest.613561F625D0DBDF.title: "Oil Fractions"
	quest.6145486686129ED1.quest_desc: ["Infuses metals with carbon, redstone or diamond. Alloys and control circuits come out of it."]
	quest.615774FFD60F9C26.quest_desc: ["Circle ({effortlessbuilding.mode.circle}), cylinder ({effortlessbuilding.mode.cylinder}), sphere ({effortlessbuilding.mode.sphere}), dome ({effortlessbuilding.mode.dome}), cone ({effortlessbuilding.mode.cone}) and pyramid ({effortlessbuilding.mode.pyramid}). Build towers, domes and roofs without counting blocks."]
	quest.615774FFD60F9C26.title: "Round Shapes"
	quest.616B0AE26BCC0C3B.quest_desc: ["A torch made from a utheric shard and a stick. Rotten creatures drop the shards."]
	quest.616EA4B24C36A853.quest_desc: ["A vault for fluids. Tanks stacked on and next to each other merge into one, and a window shows how much is left."]
	quest.6182C7DBEBCAF243.quest_desc: [
		"Turns your build into a simulated contraption with mass and real physics. This is how airships and vehicles are made."
		""
		"&7Ponder (W) shows the assembly.&r"
	]
	quest.6194A0F65340FEED.quest_desc: ["Deep in the Undergarden lie the catacombs of the forgotten. The &c{entity.undergarden.forgotten_guardian}&r waits in their tunnels."]
	quest.6194A0F65340FEED.title: "The Catacombs"
	quest.61C4ED7DF630F6CB.quest_desc: ["Netherite armour upgraded at a smithing table. Make the template from a netherite template, blaze powder and nether bricks; the chestplate can be combined with elytra."]
	quest.61C4ED7DF630F6CB.title: "Ignitium Armour"
	quest.61DB66478B614ADD.quest_desc: ["The encyclopedia thrown into the well comes back as a book of void magic. It describes the recipes of this tier."]
	quest.61F99F5FD10E8135.quest_desc: [
		"It turns up in the chests of Twilight Forest structures. Tools and armour made from it come already enchanted."
		""
		"&7More quests on this page appear here once your team enters the Brass Era.&r"
	]
	quest.620282C2039670CC.quest_desc: ["Froststeel weapons slow down the foes they hit."]
	quest.621F0B31303C0C4C.quest_desc: ["An ender pearl with the lich's anima and a void thorn. It is not used up when thrown and grants brief resistance after a teleport."]
	quest.621FAD3E217119C8.quest_desc: [
		"The destruction mode removes the row of blocks facing you. Destroyed blocks vanish, but undoing the operation restores them."
		""
		"&7The recipe needs a diamond pickaxe, and you install it with a block of redstone.&r"
	]
	quest.62204C363A986C08.quest_desc: ["Monsters and chests drop affix gear, named in the colour of its rarity. The salvaging table breaks it down into materials: common items give mysterious scrap metal."]
	quest.6232770CFC6EB3A0.quest_desc: ["Also compresses 3×3 recipes, such as diamonds and redstone into blocks."]
	quest.624BABDC9CB43903.quest_desc: ["Goety's tower on the End islands. The void shrine stands at its top, where you summon the keeper."]
	quest.624BABDC9CB43903.title: "The Final Terminal"
	quest.6250BAE606DB10A4.quest_desc: ["A factory does the job of a plain machine on several items at once. Make any basic factory in the grid or with a tier installer."]
	quest.6250BAE606DB10A4.title: "Factory"
	quest.6263C60A24E1DB06.quest_desc: ["Every circuit tier is another infusion. Mekanism factories and AE2 autocrafting will make this batch on their own."]
	quest.6263C60A24E1DB06.quest_subtitle: "Automation proof"
	quest.626FE53E021013ED.quest_desc: [
		"A cuboid of crafting units, storage and co-processors runs your orders. Storage sets how big an order can be, co-processors how fast it goes."
		""
		"&7Place an order in the terminal: middle-click an item.&r"
	]
	quest.626FE53E021013ED.quest_subtitle: "Milestone"
	quest.626FE53E021013ED.title: "&bCrafting CPU"
	quest.62764FCD07CCACFF.quest_desc: ["Upgrade the Draco Arcanus armour on the fourth forge tier with aquatic and golden scales. Each piece costs thousands of aureal and blood, so stock up on essences."]
	quest.62764FCD07CCACFF.title: "Tyr armour"
	quest.627BC61F615AA916.quest_desc: ["Malum's guide covers spirits, infusion and totem rites. Make it from a book and refined soulstone."]
	quest.6282AF35BD8D267D.quest_desc: [
		"A mark of mastery, a netherite ingot and an elemental essence turn Ars robes into robes of one school. They amplify its glyphs, make them cheaper and protect you from damage of its element."
		""
		"&7A full set of four pieces of one element grants an extra bonus.&r"
	]
	quest.6282AF35BD8D267D.quest_subtitle: "Milestone"
	quest.6282AF35BD8D267D.title: "&dElemental Robes"
	quest.629BB2EE81044C3B.quest_desc: ["Deepslate on the altar for 1000 essence. Slates are the base of almost everything in vitaemancy."]
	quest.629CAE41FC4ED04D.quest_desc: ["A display link reads the stock ticker and writes it on a display board. Your whole team sees what is running low."]
	quest.629CAE41FC4ED04D.title: "Stock Board"
	quest.62B69F59F1C3FA6C.quest_desc: ["The gas from the top hatch need not go to waste. Burn it in the blast stove instead of creosote and the furnace heats its own air."]
	quest.62B9CC3A9E92DA98.quest_desc: ["Crystallises the clean slurry: one ore gives five crystals. The crystals continue through the injection chamber, purification chamber, crusher, enrichment chamber and smelter."]
	quest.62B9CC3A9E92DA98.quest_subtitle: "Milestone"
	quest.62B9CC3A9E92DA98.title: "&6{block.mekanism.chemical_crystallizer}"
	quest.62BC6EAEFA099E37.quest_desc: ["Broadcasts the network wirelessly within a dozen or so blocks. Boosters inside extend the range."]
	quest.62BCBBCE19B250BB.quest_desc: ["Shares a plain chest, a drawer or a Create vault with the network as if it were a cell. That is how you hook up storage from earlier eras."]
	quest.62BE12E98B38F8EA.quest_desc: ["The Illager Invasion table that raises an item's enchantment above its usual level. Make it from the essence, a block of copper, a bottle o' enchanting, dark oak and paper."]
	quest.62C36D3D3D4729C7.quest_desc: ["Orders set goods to a given address when it gets a redstone signal. It refills a furnace or a machine without your help."]
	quest.62C584E8CB3394CA.quest_desc: ["Wild flax grows in the Overworld. Its fibre twists into string for bowstrings and bindings."]
	quest.62CA3903B2D1D3C4.quest_desc: ["A censer of arcane gold, pewter and silver burns incense. Placed on an altar, it raises its capacity by 2."]
	quest.62F4C6B156850604.quest_desc: ["The coral generator turns coral fluid into FE and outputs power from its top and bottom. Mix coral fluid from redstone and blaze powder, so the ship carries its own power plant."]
	quest.62F4C6B156850604.title: "Power on Board"
	quest.630E959FA7C90919.quest_desc: ["Thrown like an eye of ender, it leads to the soul blacksmith in the Nether, where the {entity.cataclysm.netherite_monstrosity} waits."]
	quest.6316E244E366D634.quest_desc: ["Zanite is the blue gem of the Aether; it makes tools and the altar. Zanite tools work faster the more worn they are."]
	quest.63188B76682FCBA6.quest_desc: ["The ring stores a familiar and gives its bonus to the wearer, even when the familiar is not walking next to you."]
	quest.631C49FEFB70A0CE.quest_desc: ["Plating from the Warden's back. With an echo shard and a phantom membrane it makes a reinforced echo shard, and with a compass an ancient compass."]
	quest.633026569D92492D.quest_desc: ["Enter your own world. If you bring an enemy along, only one of you returns."]
	quest.633026569D92492D.quest_subtitle: "Milestone"
	quest.633026569D92492D.title: "&d{block.mahoutsukai.mahoujin_reality_marble}"
	quest.635F6BA6B972F080.quest_desc: [
		"&7Gear: your best armour and a weapon against the undead.&r"
		"A cursed warrior locked in ice. Fast and merciless."
	]
	quest.635F6BA6B972F080.quest_subtitle: "Boss"
	quest.635F6BA6B972F080.title: "&c{entity.cataclysm.maledictus}"
	quest.63653A576A690914.quest_desc: ["It lets you fly for a moment like a bumblebee. You find it by brushing suspicious pollen piles in the pollinated fields."]
	quest.63653A576A690914.quest_subtitle: "Milestone"
	quest.63653A576A690914.title: "&a{item.the_bumblezone.bumble_bee_chestplate_1}"
	quest.63823D44A544F96B.quest_desc: ["You can store the blend in tanks and pour it where it should set. End stone from a dragon's breath fan (Create add-ons page) saves you trips to the End."]
	quest.6394638656ECEE87.quest_desc: ["The steam engine sits on a fluid tank heated by blaze burners while a pump adds water. A bigger boiler and more burners mean more power. One engine goes into the seal."]
	quest.6394638656ECEE87.quest_subtitle: "Milestone and seal ingredient"
	quest.6394638656ECEE87.title: "&6{block.create.steam_engine}"
	quest.63CA9CBF64812D61.quest_desc: [
		"A raiders' camp from Dungeons and Taverns. Come armed: the crossbowmen hit from afar."
		""
		"&7More quests on this page appear here once your team enters the Rune Era.&r"
	]
	quest.63CA9CBF64812D61.title: "An Illager Camp"
	quest.63D82EF448627B80.quest_desc: ["The elixir turns creatures and blocks into something else. Used on an infernal pumpkin, it summons the lord. You find it in clown caravan wagons, and JEI shows the recipe."]
	quest.63F07386B1A0BA5E.quest_desc: [
		"Use a printer 1000 times. A belt of books and a steady supply of liquid experience will do it without you."
		""
		"&7The next enchanting tier appears here once your team enters the Arcane Era.&r"
	]
	quest.63F07386B1A0BA5E.quest_subtitle: "Automation proof"
	quest.63F07386B1A0BA5E.title: "Great publisher"
	quest.63FC896B18EF8E12.quest_desc: [
		"Obsidian ground in crushing wheels becomes powdered obsidian. In sequenced assembly a spout adds lava and a press presses it twice: that makes a sturdy sheet, the material for train casings."
		""
		"&7JEI shows the assembly steps (R on the item).&r"
	]
	quest.6402D9D327AC639A.quest_desc: ["The builder constructs and upgrades every building of the colony. Place his hut, order the build in its menu and bring him materials."]
	quest.6402D9D327AC639A.title: "Builder's Hut"
	quest.64201A5246624F28.quest_desc: ["Demonite ore exists only in the Mines of the Endless Realm. Without Silk Touch you get raw demonite."]
	quest.642CC75CBF755551.quest_desc: ["The rolling mill draws wire from gold and electrum sheets, and you wind it onto empty spools. Electrum wire goes into the accumulator."]
	quest.642CC75CBF755551.title: "Gold and Electrum Spools"
	quest.643BC132F8F37FA9.quest_desc: ["The planter grows sugar cane, bamboo and cocoa on plantation fields. Nether plants unlock through research in the Brass Era."]
	quest.645627057BBA2031.quest_desc: ["On the altar gunpowder becomes hex ash, coal arcane charcoal, clay alchemical calx and rotten flesh living flesh. They go into almost every later Malum recipe."]
	quest.645627057BBA2031.title: "Infused Materials"
	quest.6481021B0DDECC1A.quest_desc: ["Chiseled polished darkstone on the forge, 4 arcane crystals and 4 deorum ingots on the pedestals. The ritual consumes 1000 aureal, 9000 blood and 50 souls."]
	quest.6481021B0DDECC1A.title: "Forge: tier III"
	quest.64A601A45CD3EBD5.quest_desc: ["Moves items vertically: they fall down on their own, and a fan below the chute pushes them up. A chute takes items from a funnel and hands them to the container below it."]
	quest.64CE345DD1893CE6.quest_desc: ["It takes an item apart into its recipe ingredients, for experience. Craft it from a crafting table and a maze map focus."]
	quest.64E8D1813DF6EEE5.quest_desc: [
		"&7Electric Era · a shield, a fast weapon and plenty of food recommended&r"
		""
		"The Vizier, an illager dignitary, appears when you use a dark scroll in a woodland mansion and conjures illusions of himself."
		"The Redstone Monstrosity closes an illager raid: it comes out once you defeat the other raiders."
	]
	quest.64E8D1813DF6EEE5.title: "The Illager Court"
	quest.64FC21E8D46ED3CA.quest_desc: ["Barracks with all towers at the highest level. In the Atomic Era the university also opens tier 6 research."]
	quest.64FC21E8D46ED3CA.title: "Grand Garrison"
	quest.64FE2EFBA55E6AC1.quest_desc: ["Shulker boxes take the same tier upgrades as chests. A netherite one carries a whole storage."]
	quest.653DD7C6E4237E8A.quest_desc: [
		"Sometimes the sky of this world rains meteors. Wait out such a night under the open sky."
		""
		"&7Creteors fall with the meteors and drop raw aethersent.&r"
	]
	quest.653DD7C6E4237E8A.quest_subtitle: "Milestone"
	quest.653DD7C6E4237E8A.title: "&aA Meteor Shower"
	quest.6546C10FC690E7A4.quest_desc: ["A pickaxe, axe and shovel with a Spiritus gem. Spiritus aspects later change how they behave."]
	quest.6546C10FC690E7A4.title: "Sentient tools"
	quest.654EA61281BF5749.quest_desc: ["Craft it from four corals, an eye of ender, a glow ink sac and a conduit."]
	quest.655BB5915AE02D37.quest_desc: ["A citadel from Moog's End Structures. Check every chamber."]
	quest.655BB5915AE02D37.title: "The Phantom Citadel"
	quest.6561C5F43E57CF75.quest_desc: ["The diesel engine burns fuel fed by a pipe and drives Create machines, at 96 RPM on diesel. Run it on diesel from the distillation tower. One engine also goes into the seal."]
	quest.6561C5F43E57CF75.quest_subtitle: "Milestone"
	quest.6561C5F43E57CF75.title: "&6{block.createdieselgenerators.diesel_engine}"
	quest.65A50AE4D9110683.quest_desc: ["An even bigger drive, from polonium and plutonium. A few of them are enough for a whole base."]
	quest.65A6BDAFE7A86DE1.quest_desc: ["A shard mounted on a stick is your first knife. It cuts grass and is needed in later recipes."]
	quest.65AE6584A801F31F.quest_desc: ["Each component tier consumes the previous one, from 1M up to 256M. Two of the largest go into the seal."]
	quest.65AE6584A801F31F.quest_subtitle: "Seal ingredient"
	quest.65B024605903E32B.quest_desc: ["The engineer's suit upgraded with witherite from the Harbinger and a mana orb. Three variants: power, resistance or speed."]
	quest.65B024605903E32B.title: "Excelsius Armour"
	quest.65D623FE306B697B.quest_desc: ["Hold 512 steel ingots at once. That much needs a blast furnace that gets its ore, flux and fuel on its own."]
	quest.65D623FE306B697B.quest_subtitle: "Automation proof"
	quest.65D623FE306B697B.title: "Steelworks"
	quest.65E3E47CF029F29D.quest_desc: ["Pulls items from a neighbouring container and pushes them into another, with a filter. Set it up in the upgrade window."]
	quest.65F36FC939EE202F.quest_desc: ["Merammer resin binds almost every incense, and the other herbs decide what it does. Flowers give the root, ferns the sprig and lily pads the bloom."]
	quest.65F36FC939EE202F.title: "Ritual herbs"
	quest.6607EAAF1EBB3240.quest_desc: ["A columned fortress-town added by Aether Villages. One of the largest structures of the Aether."]
	quest.6607EAAF1EBB3240.title: "The Olympic Citadel"
	quest.6609435D9865D795.quest_desc: ["Upgrade the mine and the miner sinks his shaft all the way down to bedrock."]
	quest.6609435D9865D795.title: "Rock Bottom"
	quest.661D4EBC4DE243B8.quest_desc: ["Trolls drop magic beans. Plant one on &a{block.twilightforest.uberous_soil}&r and the stalk grows up to the giants' clouds."]
	quest.661D4EBC4DE243B8.title: "Magic Beans"
	quest.661EF6848FAA286A.quest_desc: ["The launching focus refined with dragon's breath and an elytra. Fitted in the wand, it lets you fly while you hold the right mouse button; with the wind staff you fly faster."]
	quest.6621100F24C04595.quest_desc: ["Leave a train seat more than 5000 blocks away from where you boarded."]
	quest.6621100F24C04595.title: "Long Journey"
	quest.663064D989B80AD2.quest_desc: ["The Minoshroom's axe. It deals extra damage when you strike while sprinting."]
	quest.663CAF3B10334B70.quest_desc: ["Throw an &a{item.minecraft.ender_pearl}&r at a &a{block.minecraft.bee_nest}&r or a beehive to reach the bee dimension. It is a side trip: honey, combs and bee armor."]
	quest.663CAF3B10334B70.title: "Bumblezone"
	quest.663E4BBCFF5CBF56.quest_desc: [
		"&7Electric Era · a utherium or netherite weapon and good armour recommended&r"
		""
		"In the catacombs of the Undergarden a stone guardian watches over the remains of the forgotten. It is slow, but every blow hurts."
		""
		"&7The next world boss tier appears here once your team enters the Atomic Era.&r"
	]
	quest.663E4BBCFF5CBF56.title: "Guardian of the Catacombs"
	quest.66472ED1DB8845B3.quest_desc: ["Make rose quartz from nether quartz and redstone. Polish it with sandpaper in hand or with a deployer holding sandpaper: polished quartz goes into electron tubes."]
	quest.66472ED1DB8845B3.title: "Polishing"
	quest.666707E6510FC60D.quest_desc: [
		"The third stack tier. The recipe needs a block of diamond."
		""
		"&7The next backpack tier appears here once your team enters the Arcane Era.&r"
	]
	quest.6670F04259034690.quest_desc: ["Underground dungeons with monster spawners: zombies, skeletons and spiders. Light up or break the spawners and take the loot."]
	quest.6670F04259034690.title: "YUNG's Dungeons"
	quest.66807641845B5012.quest_desc: ["Opens a terminal from a distance; the item tooltip shows the range. Click a terminal with it, then use it from your hand."]
	quest.6681ACA2A79FA53A.quest_desc: ["Copies books, enchanted ones included, for liquid experience. It also renames items and readdresses Create packages."]
	quest.668DD3417C215524.quest_desc: ["Bind a gadget to the access point from the radial menu (“{buildinggadgets2.radialmenu.bind}”). The gadget takes blocks from the ME network and orders missing ones through autocrafting."]
	quest.668DD3417C215524.title: "Gadgets on the ME Network"
	quest.66A4D2AE904CE1E3.quest_desc: ["Two netherite scraps with molten gold, mixed at superheat, give molten netherite. Cast it into ingots without a trip to the smithing table."]
	quest.66C4A2DAA07CA850.quest_desc: ["The thorny hedge hurts to touch, and spiders lurk in the corridors. Chests wait at its centre."]
	quest.66C4A2DAA07CA850.title: "The Hedge Maze"
	quest.670B3BC895AD9183.quest_desc: ["A diamond pickaxe upgraded with a resonarium plate. This is the pickaxe for the Otherside."]
	quest.670D8623992AA334.quest_desc: ["The giants' house stands on the clouds at the top of the stalk. Giant cobblestone and a giant log make a pickaxe and a sword of their size."]
	quest.670D8623992AA334.title: "The Giant's House"
	quest.671959A34C149691.quest_desc: [
		"&7Gear: full armour, light and a ranged weapon.&r"
		"It lurks in the darkness of the Otherside. It may drop a &a{item.deeperdarker.soul_crystal}&r."
	]
	quest.671959A34C149691.quest_subtitle: "Boss"
	quest.671959A34C149691.title: "&c{entity.deeperdarker.stalker}"
	quest.6728C73F77258A9B.quest_desc: ["Use it on a placed diamond chest, barrel or shulker box and it becomes netherite, contents included."]
	quest.672CD9B7EA617AD0.quest_desc: [
		"Each essence is imbued in the chamber from a source gem and items of its element, such as flint and steel and gunpowder for fire. Essences go into glyphs, rituals and gear."
		""
		"&7JEI shows the recipes: hover over an essence and press R.&r"
	]
	quest.672CD9B7EA617AD0.title: "Elemental Essences"
	quest.673956CBEC639087.quest_desc: [
		"Every extra sail speeds the windmill up until it reaches its maximum strength. Sail frames count the same as sails with wool."
		""
		"&7The quest checks the Create advancement for a windmill of maximum strength.&r"
	]
	quest.673956CBEC639087.title: "Windmill under Full Sail"
	quest.673FEF8CACB0E5C8.quest_desc: ["Rubies, sapphires, topazes and other gems turn up in structure chests. Each gem gives jewellery a different bonus."]
	quest.673FEF8CACB0E5C8.title: "A Gemstone"
	quest.6750A521F50633AA.quest_desc: ["A drilling machine for fluid veins: it pumps the fluid from below ground for as long as you power it."]
	quest.677502BBACE73971.quest_desc: ["Bells and Whistles adds locomotive parts: a headlight lights the way ahead of the train, and a pilot at the front gives it character."]
	quest.677502BBACE73971.title: "Headlight and Pilot"
	quest.6789430CA3CC85D1.quest_desc: [
		"A boiler's power grows with it: a bigger tank, more blaze burners underneath and more water mean a higher boiler level. Every level runs one steam engine at full power."
		""
		"&7Engineer's goggles on the boiler show its level and what it is missing.&r"
	]
	quest.6789430CA3CC85D1.title: "A Bigger Boiler"
	quest.6791A156DA492C69.quest_desc: [
		"Increases the actuator's capacity. Place it nearby, facing the actuator; several stabilizers add up."
		""
		"&7A foliot ritual on a stabilizer base, with a block of copper and blaze powder.&r"
	]
	quest.679EC6A33763BF96.quest_desc: ["The seal consumes 16 infernal, 16 arcane and 8 wicked spirits. Infernal ones come from blazes, ghasts and other Nether creatures."]
	quest.679EC6A33763BF96.quest_subtitle: "Seal ingredient"
	quest.679EC6A33763BF96.title: "Spirits for the Seal"
	quest.67B2AD661C3E1852.quest_desc: [
		"&7Brass Era · recommended: diamond armor, fire resistance potions&r"
		"The many-headed Hydra spits fire from its lair in the Twilight Forest's fire swamp."
	]
	quest.67B2AD661C3E1852.quest_subtitle: "Boss"
	quest.67B2AD661C3E1852.title: "&c{entity.twilightforest.hydra}"
	quest.67B4FEC3F9C6D751.quest_desc: ["Click a placed machine with an installer and it becomes a factory without being taken apart. The next installer raises the factory a tier and adds slots."]
	quest.67B4FEC3F9C6D751.title: "Tier Installers"
	quest.67C5B95D0E775079.quest_desc: ["Eight steam engines on one boiler can drive a whole factory. Spread them around the sides of the tank and join their shafts into one network."]
	quest.67C5B95D0E775079.title: "Engine Hall"
	quest.67E1E57A3F7AEDA5.quest_desc: [
		"Build the distillation tower from steel fluid tanks, a controller and outputs; Ponder (W) shows how. 340 mB of crude oil yield heavy oil, diesel, kerosene, naphtha, gasoline and LPG."
		"Fill a bucket with diesel."
	]
	quest.67E1E57A3F7AEDA5.quest_subtitle: "Milestone"
	quest.67E1E57A3F7AEDA5.title: "&6Oil Distillation"
	quest.67E8C5DC68587EDE.quest_desc: ["An iron sword with a Spiritus gem. It harvests Spiritus from the slain far better than throwing daggers."]
	quest.67ED85E29B059067.quest_desc: ["Combine it with the mech trowel at a smithing table. The trowel will take blocks straight from the ME network."]
	quest.67F8633BD956C906.quest_desc: ["Aethersent falls from the sky of Eternal Starlight with the meteors. Eight ingots go into the seal."]
	quest.67F8633BD956C906.quest_subtitle: "Seal ingredient"
	quest.681B43AE3E0A5C94.quest_desc: ["The carpenter crafts wooden items other workers ask for, such as doors and stairs. Crafters only work to order."]
	quest.681B43AE3E0A5C94.title: "Sawmill"
	quest.6824F3BE0E5F95A8.quest_desc: ["Soul stained steel armour infused with malignant pewter plating and soulwoven silk. A stronger soul ward and protection against magic."]
	quest.6824F3BE0E5F95A8.title: "Malignant Stronghold Armour"
	quest.6830D44BCD85AC2A.quest_desc: [
		"Shows the current season and day. Craft it from a clock and paper."
		""
		"&7Plan your sowing so the harvest doesn't fall in winter.&r"
		""
		"&7More quests on this page appear here once your team enters the Brass Era.&r"
	]
	quest.683CA4EED57679E9.quest_desc: ["A small furnace in the backpack. It takes fuel and material from the backpack's contents."]
	quest.68437FE9E2D18392.quest_desc: [
		"Happy citizens work better and are keener to start families. Housing, varied food, health, safety and their requests all count."
		"&7Hover over a citizen or open his window to see what he lacks.&r"
	]
	quest.68437FE9E2D18392.title: "Happiness"
	quest.68473797DF560542.quest_desc: ["Source gems are the base of Ars Nouveau magic: they go into the core, the pedestals, sourcelinks and the block for the seal."]
	quest.68652025D552D06F.quest_desc: ["A stone statue bearing your patron symbol, a sturdier icon than the straw effigy."]
	quest.6876B0FE11BE8D1D.quest_desc: ["Forgotten fields, smogstem forests, twisted wigglewood forests and frostfields. Visit all four."]
	quest.6876B0FE11BE8D1D.title: "Undergarden Lands"
	quest.68995561F0A8AE93.quest_desc: ["Cows give leather for a backpack and your first armor, and beef for stew."]
	quest.68A579014481680C.quest_desc: ["Made in an animation ritual: 15 ladders, 15 rails and a carved pumpkin must stand around the dark altar. The core brings servant foci and golems to life."]
	quest.68AD1DD3F0FAB655.quest_desc: ["It lies in brood blocks and in the chests of hive structures."]
	quest.68B2930A37AE9CEF.quest_desc: ["On a smithing table it adds the angel mode to the stick: it places blocks on the far side of what you look at, even in mid-air. Handy for building ships."]
	quest.68B6A6C9952F9081.quest_desc: ["A temple on the clouds full of valkyries. Their victory medals let you face their queen."]
	quest.68B6A6C9952F9081.title: "The Silver Dungeon"
	quest.68C1C1E0E38BF419.quest_desc: ["A hellfire-stone chamber at the heart of a large island. The Sun Spirit hurls fireballs, so bring fire resistance."]
	quest.68C1C1E0E38BF419.title: "The Gold Dungeon"
	quest.68C9ABB319EBE472.quest_desc: [
		"Place your own waystone by your base or your mine. Other players only see it once they activate it themselves, and only the owner can edit it."
		""
		"&7The recipe needs obsidian, so you need a diamond pickaxe.&r"
	]
	quest.68D6896EAD169BAA.quest_desc: ["Controls the speed and direction of an engine's rotation. A circuit board works inside, so it is the last step of TFMG engines."]
	quest.68D6BC443E61E584.quest_desc: ["The spatial IO port stores a piece of the world, marked out by pylons, in a spatial cell. Release it elsewhere with its blocks and mobs."]
	quest.68D6BC443E61E584.title: "Space in a Cell"
	quest.68E36844E15659CE.quest_desc: ["The scroll forge creates new scrolls from ink, paper and a school focus. You find crying obsidian at ruined portals."]
	quest.69026A5EFF5ECD87.quest_desc: [
		"The soul trapped inside points the way home: to the catacombs where the Dead King sleeps. The recipe needs a soul lantern."
		""
		"&7The next Iron's Spells tier appears here once your team enters the Occult Era.&r"
	]
	quest.690A3EEA188EBC76.quest_desc: ["New Age connectors are linked with wire. A wrench switches a connector to pull mode so it draws energy from the block it stands on."]
	quest.690A3EEA188EBC76.title: "New Age Wiring"
	quest.691298B561F65994.quest_desc: ["The Monstrosity's hammer, which is also a pickaxe. Right-clicked on a block, it hurts everything around."]
	quest.691F25540999137F.quest_desc: ["The golden bowl stands in the middle of the pentacle and starts the ritual, while at least four plain bowls within 8 blocks hold the ingredients. Bowls are made from &d{block.occultism.otherstone}&r, which you also get from spiritfire."]
	quest.691F25540999137F.title: "Ritual Bowls"
	quest.691F2A29902F728E.quest_desc: ["Template boards make part templates. A template is single-use: every head or plate uses one up in the grid."]
	quest.6961698E7E0F1D82.quest_desc: ["Stone needs a pickaxe. A flint one mines stone, coal and copper ore, but it is too weak for iron."]
	quest.6961698E7E0F1D82.quest_subtitle: "Milestone"
	quest.6961698E7E0F1D82.title: "&6{item.notreepunchingremastered.flint_pickaxe}"
	quest.696945DF9E1B272B.quest_desc: [
		"It turns slower than a regular water wheel but gives much more power. Place it so the water flows past the paddles on one side."
		""
		"&7Ponder (hold W over the item) shows how to put it together.&r"
	]
	quest.69753EC3B1C4561A.quest_desc: ["Made from an atomic disassembler, polonium and a configurator. Modules add mining speed, Fortune, Silk Touch and vein mining."]
	quest.698E82D7135D42AB.quest_desc: ["In an export bus or an interface it orders a missing item on its own. A machine never runs out of an ingredient."]
	quest.6991CA280495CBD7.quest_desc: ["Seeds sometimes drop from grass broken without shears. Plant them: the fruit grants the Third Eye effect, and thrown on the ground and lit with flint and steel it turns into spiritfire."]
	quest.6994230275E5D8EC.quest_desc: ["The gate needs one of the two Nether bosses. One is enough, and its trophy goes into the seal."]
	quest.6994230275E5D8EC.quest_subtitle: "Milestone"
	quest.6994230275E5D8EC.title: "&c{entity.minecraft.wither} or {entity.bosses_of_mass_destruction.gauntlet}"
	quest.69A1CACA40F7ED18.quest_desc: ["The next stack tier. The recipe needs a block of gold and the previous tier upgrade."]
	quest.69A516803B51AE35.quest_desc: ["Sunken ruins of stone in cold seas and of sandstone in warm ones. Drowned guard them."]
	quest.69A516803B51AE35.title: "Ocean Ruins"
	quest.69A9A194EC6D19BC.quest_desc: [
		"&7Atomic Era · your best armour, elytra or ender pearls recommended&r"
		""
		"Thrown like an eye of ender, it flies towards the ruined citadel on the End islands. Make it from an eye of ender, a shulker shell and blocks from End cities."
	]
	quest.69B1703018DCDE86.quest_desc: ["On a smithing table it makes a Construction Stick stop wearing out. Make it from a nether star, crying obsidian and glass."]
	quest.69B3A20E64A3D9DD.quest_desc: [
		"The radar bearing spins an antenna built on it from a receiver and dishes, and the radar detects creatures and contraptions around. You drive it like any Create bearing."
		""
		"&7Ponder (hold W over the item) shows the whole process.&r"
	]
	quest.69B3A20E64A3D9DD.title: "Radar"
	quest.69BF57E1F763134F.quest_desc: ["From the Andesite Era on, the iron pickaxe finally works: it mines diamonds, gold, redstone, emeralds and zinc. Two diamonds go into the enchanting table and one into the seal next era."]
	quest.69BF57E1F763134F.title: "Diamonds"
	quest.69D905AB9B941D26.quest_desc: ["A jetpack with plating from a steel block and bronze. It protects like a good chestplate."]
	quest.69E5637FB98A911E.quest_desc: ["Loads a larger area, and the larger the range, the faster it must spin. On a contraption or next to a train station it loads the area around the train without power."]
	quest.69E628FF1507E56B.quest_desc: ["A pearl from salvaging mythic items. It goes into the augmenting table and the strongest sigils."]
	quest.69E9BF65AD30C871.quest_desc: ["Link a display link to a station and a flap display shows when the next train arrives. Display links and boards are on the Create logistics page."]
	quest.69E9BF65AD30C871.title: "Departures Board"
	quest.69EA802505EAFFA4.quest_desc: ["The surface scanner shows the nearby chunks on its top 5×5 grid and lights up those with an oil deposit underneath. Power it from below through a machine input, at least 64 RPM."]
	quest.69EE60EE7D5065B9.quest_desc: [
		"A tower of evaporation blocks on a 4×4 base, with a controller and a valve. Heat evaporates water into brine and brine into lithium; the taller the tower, the faster."
		""
		"&7The separator splits brine into chlorine and sodium.&r"
	]
	quest.69EE60EE7D5065B9.title: "Thermal Evaporation"
	quest.69EEF9A99661A22B.quest_desc: ["Apply it to a fluid tank at least 3 blocks tall and it becomes a distillation tower. Heat it from below and pump in oil: gasoline and diesel come out."]
	quest.69F83ADE7BA96612.quest_desc: ["One of the strongest armours of the Twilight Forest. It will serve you in the Dark Tower and beyond."]
	quest.69F83ADE7BA96612.title: "Knightmetal Armour"
	quest.6A16A2359DAD868E.quest_desc: ["Combine an upgrade with a finished tool in the grid. The spoon lets a pickaxe dig dirt like a shovel."]
	quest.6A16A2359DAD868E.title: "Upgrades"
	quest.6A21DE211219A1D1.quest_desc: [
		"Carried in your inventory, it saves you from death once and is used up. It turns up in chests of the Lich Tower and the hollow hills."
		"&7Handy in any boss fight.&r"
	]
	quest.6A21F6AEDA073785.quest_desc: [
		"Hold 1024 raw ores of any metal at once. Drilling machines on a few veins, a belt and storage do it without a single swing of a pickaxe."
		""
		"&7More quests on this page appear here once your team enters the Atomic Era.&r"
	]
	quest.6A21F6AEDA073785.quest_subtitle: "Automation proof"
	quest.6A21F6AEDA073785.title: "Endless Mine"
	quest.6A24B428E6449FAA.quest_desc: ["Automation proof: 256 mageblooms. Make the seeds in the apparatus from a source gem and ordinary seeds, and a Create harvester on a moving contraption gathers the crop for you."]
	quest.6A24B428E6449FAA.title: "Magebloom Plantation"
	quest.6A31642FC24395C9.quest_desc: ["The copper wand places more blocks at once than the stone one."]
	quest.6A4A30BDCB0F8E18.quest_desc: ["Relays rotation in two directions independently. Two separate drive lines cross in one block without joining."]
	quest.6A4DF85CE7DAB2FF.quest_desc: ["Survive a few nights and defeat ten zombies and ten skeletons. The whole team counts."]
	quest.6A4DF85CE7DAB2FF.quest_subtitle: "Milestone"
	quest.6A4DF85CE7DAB2FF.title: "&aNight Shift"
	quest.6A4F166CB8FAA9B4.quest_desc: [
		"Set a fan to blow through water and throw sand into the stream: every block turns into a clay ball. Washed gravel gives flint and sometimes an iron nugget. Collect 32 clay balls."
		""
		"&7This page goes further than the era tree: washing, pressing over a basin, fluids, and ore crushing in the Brass Era.&r"
	]
	quest.6A4F166CB8FAA9B4.title: "Washing Sand"
	quest.6A4FB58AC0CB4783.quest_desc: ["The gauntlet mines blocks as hard as diamond and casts one form-less spell, cheaper than the book."]
	quest.6A77909E2CBF9277.quest_desc: ["The Dark Tower stands in the heart of the Dark Forest. You can enter it once the Knight Phantoms fall."]
	quest.6A77909E2CBF9277.title: "{biome.twilightforest.dark_forest_center}"
	quest.6A84317D6CEE8B17.quest_desc: ["A jar with a small dimension of its own: name it, click it while sneaking and step inside. Blocks you build inside show in the jar."]
	quest.6AA609A7C2E49926.quest_desc: ["The starlight forest, the dark swamp, the scarlet forest and the torreya forest. Visit all four."]
	quest.6AA609A7C2E49926.title: "Starlit Lands"
	quest.6ABA77CE2C2A2AFE.quest_desc: ["The crude scythe infused with soul stained steel and hex ash. It cuts harder and tears more spirits from its victims."]
	quest.6AC6911C37465994.quest_desc: [
		"A spike of the Void Blossom. It goes into the charged pearl and the earthdive spear."
		""
		"&7The next Mass Destruction tier appears here once your team enters the Occult Era.&r"
	]
	quest.6AC8C8D0A65424C9.quest_desc: [
		"The Overworld is made of the biomes of five mods: Biomes O' Plenty, Oh The Biomes We've Gone, Nature's Spirit, Regions Unexplored and Terralith. Each has its own trees, flowers and landscapes."
		""
		"&7The Nature's Compass from the Andesite Era points the way to the land you pick.&r"
	]
	quest.6AC8C8D0A65424C9.title: "New Lands"
	quest.6AD4941D7D927187.quest_desc: ["Cursed metal, a ghast tear and sculk melted in the necrotic brazier for plenty of soul energy. The dark alloy repairs itself with soul energy and slows whatever it hits."]
	quest.6AF504E67C1AF9EE.quest_desc: ["A campfire cooks meat without fuel. It also heats a cooking pot placed above it."]
	quest.6AFCAA604FAF558C.quest_desc: ["The reaper's scythe upgraded with essence of death, a shadow gem and a wither skeleton skull. It is the deadliest necromancer's weapon in Eidolon."]
	quest.6AFCAA604FAF558C.quest_subtitle: "Milestone"
	quest.6AFCAA604FAF558C.title: "&d{item.eidolon_repraised.deathbringer_scythe}"
	quest.6B02295457E48065.quest_desc: [
		"The Vizier leaves a ruby of souls. Goety uses it in the rituals of several foci."
		""
		"&7The next magic boss tier appears here once your team enters the Atomic Era.&r"
	]
	quest.6B13DD9520E77C56.quest_desc: ["A ritual dagger. Ferns, flowers, jungle leaves, Nether fungi and lily pads cut with it give the herbs that incense is made from."]
	quest.6B1E1A4C5F600010.quest_desc: ["Awaken a dormant deepshelf of cracked deepslate tiles by infusing it in the table. Deepshelves lift the table higher still."]
	quest.6B40B0152114AC03.quest_desc: ["Connects a packager to a Create logistics network. Packagers linked to one network act as a single store you can order from."]
	quest.6B42056FA97C1355.quest_desc: ["The ritual grants nearby players creative-style flight as long as the brazier has source. The recipe needs a wilden wing and a diamond."]
	quest.6B51B68599BDA4BE.quest_desc: [
		"This is where you install modules into the MekaSuit and the Meka-Tool. Building it needs polonium, so the station waits for the reactor."
		""
		"&7The full MekaSuit is also a milestone of the Transcendent Era.&r"
	]
	quest.6B638BA751B92383.quest_desc: ["Burns biofuel that the crusher makes from plants, seeds and food. A crop field becomes a power plant."]
	quest.6B638BA751B92383.title: "Bio-Generator"
	quest.6B922455932772B7.quest_desc: ["The alloy forge combines a block of azure silver with gold and ender pearls into three ingots."]
	quest.6B994E8C76B3D416.quest_desc: [
		"&7Brass Era · diamond armour and fire resistance recommended&r"
		""
		"Lone infernal evil pumpkins ringed with candles stand in the meadows. Lord Pumpkinhead rises from one of them."
	]
	quest.6B994E8C76B3D416.title: "The Infernal Pumpkin"
	quest.6BA7D86838453BC1.quest_desc: ["Spark, Conflagrate, Water Jet, Geyser and the other Ars Elemental glyphs work best with the robes and focus of their element. Make any one of them at the scribe's table."]
	quest.6BA7D86838453BC1.title: "An Elemental Glyph"
	quest.6BBC06EE9A8330D8.quest_desc: ["A terminal with a crafting grid. It takes ingredients from the network, and JEI fills the grid with one click."]
	quest.6BBC4AAA6C6481C3.quest_desc: [
		"A stick with this template stops wearing out. The recipe needs a nether star, and you install it with crying obsidian."
		""
		"&7The next stick tier appears here once your team enters the Electric Era.&r"
	]
	quest.6BCA36B155FEAF5F.quest_desc: ["It shoots depthrock pebbles. Craft it from a stick and a twistytwig."]
	quest.6BD5B3722CDB920E.quest_desc: ["Apply a heavy plate to a steel casing to get a heavy machinery casing. Distillation towers, pumpjacks and scanners are built on it; two go into the seal."]
	quest.6BD5B3722CDB920E.quest_subtitle: "Seal ingredient"
	quest.6BE8A9C8F130FD20.quest_desc: [
		"Honey glue is a handier super glue for simulated contraptions: click two corners to mark the area the physics assembler will assemble. Unlike super glue, it does not accidentally join the blocks next to it."
		""
		"&7This page goes further than the Steam and Steel Era tree: ropes, sensors, helicopters, ground vehicles and Create Propulsion engines.&r"
	]
	quest.6BF0FFF37102F281.quest_desc: ["The Geiger counter shows the radiation around you, and the dosimeter the dose you have already taken."]
	quest.6BF0FFF37102F281.title: "Measuring Radiation"
	quest.6BF7CC8ED4ABE8B6.quest_desc: ["An echoing deepshelf with sculk, a sculk catalyst and a warden tendril, dropped by the {entity.minecraft.warden}."]
	quest.6BFC9DCA8E996510.quest_desc: ["Hold 256 heavy plates at once. Only a sequenced assembly line fed with steel on its own can forge that many."]
	quest.6BFC9DCA8E996510.quest_subtitle: "Automation proof"
	quest.6BFC9DCA8E996510.title: "Plate Mill"
	quest.6C049420F9FD2E73.quest_desc: ["A switch sends trains onto the chosen branch of a junction. Flip it by hand or with a redstone signal, and a comparator reads which way it points."]
	quest.6C049420F9FD2E73.title: "Track Switches"
	quest.6C0E1C514CE079D5.quest_desc: ["Made in the imbuement chamber: a {item.ars_nouveau.wilden_tribute} inside and the essences of all Ars schools on the pedestals around. One imbuing gives five marks; one goes into the seal, the rest into elemental foci."]
	quest.6C0E1C514CE079D5.quest_subtitle: "Milestone"
	quest.6C0E1C514CE079D5.title: "&d{item.ars_elemental.mark_of_mastery}"
	quest.6C1495C40068DD65.quest_desc: ["An ice palace on the glacier. At its top the Snow Queen surrounds herself with ice guardians."]
	quest.6C1495C40068DD65.title: "The Aurora Palace"
	quest.6C192DD04B42C0A0.quest_desc: ["Chiseled darkstone on the forge, 4 stellarite pieces and 4 runes on the pedestals. The ritual consumes 2000 aureal, 12,000 blood and 100 souls; from this tier on the forge accepts the hardest rituals."]
	quest.6C192DD04B42C0A0.quest_subtitle: "Milestone"
	quest.6C192DD04B42C0A0.title: "&dForge: tier IV"
	quest.6C20F8E8EB812A70.quest_desc: ["A zombie heart, rotten flesh, bone meal and charcoal in the crucible. Hearts drop from {entity.eidolon_repraised.zombie_brute}s."]
	quest.6C3A01FD4D195B20.quest_desc: [
		"&7Occult Era · netherite armour and fire resistance potions recommended&r"
		""
		"The giant gauntlet sleeps in its arena in the Nether. It fires a laser from its eye and crushes with its fist, so keep moving."
		"You find the arena in the World branch of the era chapter."
	]
	quest.6C3A01FD4D195B20.title: "The Gauntlet in the Nether"
	quest.6C4B0347FF95AF62.quest_desc: ["Catches packages with its address from the chain and drops them into the container below. It also sends packages on."]
	quest.6C51563494DB93F1.quest_desc: ["The blacksmith gavel starts the rituals of the Hephaestus Forge. Its head is shaped from clay."]
	quest.6C51563494DB93F1.title: "Blacksmith Gavel"
	quest.6C62731D6A5A7821.quest_desc: ["Three fibers twisted together make a string. It binds a blade to a handle."]
	quest.6C62731D6A5A7821.title: "Plant String"
	quest.6C6A65781CF23A39.quest_desc: ["Plain bookshelves give at most 15 Eterna, which means enchanting up to level 30. Enchant something at that level."]
	quest.6C6A65781CF23A39.title: "Enchanting at level 30"
	quest.6C7F38A3B39C5C6C.quest_desc: ["The timed fuze detonates a set time after launch, the proximity fuze when the shell nears a block. The proximity fuze only works on the front of a shell."]
	quest.6C7F38A3B39C5C6C.title: "Better Fuzes"
	quest.6CA6B18895167E56.quest_desc: ["Every creature slain with a scythe shatters into spirits of its nature: animals give sacred, water creatures aqueous, flyers aerial and underground creatures earthen. Collect one of each."]
	quest.6CA6B18895167E56.title: "The Other Spirits"
	quest.6CBED5CB07115FAA.quest_desc: ["Right-click a block with it and the block floats up into the air. That's how you move even heavy blocks."]
	quest.6CC88F8CF746B735.quest_desc: ["A rocky lair at the heart of the fire swamp. Eat the Minoshroom's stew before you go, or the heat of the swamp will keep you out."]
	quest.6CC88F8CF746B735.title: "The Hydra's Lair"
	quest.6CD2F728EFCF6A84.quest_desc: [
		"Shelves from the depths allow enchanting at level 80. Enchant something at that level."
		""
		"&7The next enchanting tier appears here once your team enters the Atomic Era.&r"
	]
	quest.6CD2F728EFCF6A84.title: "Enchanting at level 80"
	quest.6CE6C71B1CB57FFC.quest_desc: ["Worn on the head, it protects against gas clouds, but not against lingering potions or dragon's breath."]
	quest.6D0DE9C189A8CF2D.quest_desc: ["Eaten, it grants brief regeneration and resistance. A good supply for the next fight."]
	quest.6D11D58E0AE817AA.quest_desc: ["Set foot on the Moon. Low gravity, no air and titanium ores."]
	quest.6D11D58E0AE817AA.quest_subtitle: "Space, optional"
	quest.6D11D58E0AE817AA.title: "The Moon"
	quest.6D1A5A383E5625A5.quest_desc: ["The piston is the heart of Create Diesel Generators engines. Make it from andesite alloy, a shaft and zinc nuggets."]
	quest.6D1FFED7A276D0DC.quest_desc: ["Plant gloomgourd seeds. It grows like an ordinary pumpkin, and a carved one with a torch makes a lantern."]
	quest.6D1FFED7A276D0DC.title: "A Gloomgourd"
	quest.6D23F24EEA01AF37.quest_desc: ["Brick bridges and halls hide blazes and wither skeletons. Here you get blaze rods and a living blaze for your burner."]
	quest.6D23F24EEA01AF37.quest_subtitle: "Milestone"
	quest.6D23F24EEA01AF37.title: "&aNether Fortress"
	quest.6D25845F83D38B09.quest_desc: ["A simple icon made of wheat. Placed on an altar, it gives your prayers someone to reach."]
	quest.6D7B78BBF98C9613.quest_desc: [
		"A chest with upgrade slots. Make it from planks and a lever, or convert a plain chest by adding a lever."
		""
		"&7Upgrades go into the slots on the side of the chest window.&r"
	]
	quest.6DA91091EF65DCA6.quest_desc: ["It lies in the chest in an igloo's basement."]
	quest.6DF063684894D56F.quest_desc: ["Upgrades netherite armour and weapons. The helmet shows enemies behind walls, and the chestplate revives you once."]
	quest.6DF92387C832E148.quest_desc: ["A chest with upgrade slots that keeps its contents when broken. Make it from a chest and a shulker shell from the End."]
	quest.6E0545E13434316F.quest_desc: ["The Leviathan leaves an egg. A baby Leviathan hatches from it."]
	quest.6E12F539C818303D.quest_desc: ["Throws items in an arc to a chosen spot. Set the target by clicking it with the ejector before placing."]
	quest.6E138A18A1B6BB42.quest_desc: ["Eat it and the Twilight Forest opens the &c{biome.twilightforest.fire_swamp}&r and the Hydra's lair to you."]
	quest.6E149B0A7A322983.quest_desc: ["The &b{block.ae2.mysterious_cube}&r at the heart of a meteorite holds the presses. Copy a press onto an iron block in the machine from the next quest."]
	quest.6E149B0A7A322983.title: "Processor Presses"
	quest.6E304D1D827F9F64.quest_desc: ["The Nether worker travels through a portal for Nether resources. Its hut needs obsidian."]
	quest.6E34413BB3C06079.quest_desc: [
		"The first filter lets chosen items through, the second whole groups by tag. Put them into an inventory hopper or the configurator."
		""
		"&7The next storage tier appears here once your team enters the Brass Era.&r"
	]
	quest.6E34413BB3C06079.title: "Filters"
	quest.6E6D225C51ACF794.quest_desc: ["A variant of the mystic code that wears down its own durability instead: a cast scroll is not used up."]
	quest.6E6D225C51ACF794.quest_subtitle: "Milestone"
	quest.6E6D225C51ACF794.title: "&d{item.mahoutsukai.mystic_code_first_sorcery}"
	quest.6EBA68A59BB4001D.quest_desc: ["Saves copied builds to templates. Store them or hand them to your team."]
	quest.6ED921F470B9B153.quest_desc: ["The guardian of the ruins leaves a glimmering tablet and one of four glistering weapons."]
	quest.6EEDF7F3851CCB41.quest_desc: ["A wireless ME terminal and a portable QIO dashboard: everything you gathered over nine eras is always with you."]
	quest.6EEDF7F3851CCB41.quest_subtitle: "Milestone"
	quest.6EEDF7F3851CCB41.title: "&bYour Whole Storage in Your Pocket"
	quest.6F084A4C80C949B3.quest_desc: [
		"&7Gear: a utherium or netherite weapon and good armour.&r"
		"The stone guardian of the Undergarden catacombs. It leaves nuggets of forgotten metal behind."
	]
	quest.6F084A4C80C949B3.quest_subtitle: "Boss"
	quest.6F084A4C80C949B3.title: "&c{entity.undergarden.forgotten_guardian}"
	quest.6F0A3C4DB5091466.quest_desc: ["Lead and nickel ores lie in the Overworld, usually deeper than iron. Plates of both metals go into the steel mechanism, the chemical vat and accumulators."]
	quest.6F0A3C4DB5091466.title: "Lead and Nickel"
	quest.6F0C404F09202805.quest_desc: ["Crushes ingots into dust, and in x3 processing and above it turns clumps into dirty dust."]
	quest.6F0EAB9871E04E4F.quest_desc: ["Cuts out a whole build and pastes it somewhere new. Moving your base takes a few minutes."]
	quest.6F13D8F6ECF2C57A.quest_desc: ["Summons your own vexes, like the evoker's. They fly through walls and fight for you."]
	quest.6F30D36E116F0630.quest_desc: [
		"The ironbound tome holds more spells than the copper journal. Craft it from leather, a chain and paper."
		""
		"&7These quests extend the magic branch of the Rune Era chapter.&r"
	]
	quest.6F4518C7CB09DE77.quest_desc: ["The diamond school forges weapons and shields from mana: copies of items, a volley of weapons, the Rho Aias shield."]
	quest.6F4518C7CB09DE77.title: "Projection scroll"
	quest.6F4F45B2879824EF.quest_desc: ["Placed on a belt, it splits items onto neighbouring belts and funnels. That is how you feed ore to several furnaces."]
	quest.6F69FE43BAEE036B.quest_desc: [
		"A train schedule is a list of orders for the driver: go to a station, wait, go on. Give it to whoever sits at the train controls – even a villager or a blaze – and the train runs by itself."
		""
		"&7This page goes further than the Brass Era tree: schedules, signals, long trains and Steam 'n' Rails additions.&r"
	]
	quest.6F69FE43BAEE036B.title: "Timetable"
	quest.6F768ADA63B6D761.quest_desc: ["The crumbling frame of an old warp portal. An explorer's warp scroll thrown into such a frame takes you to an unknown structure nearby."]
	quest.6F768ADA63B6D761.title: "Ruined Warp Portal"
	quest.6F8D2D54DCC426A5.quest_desc: ["The remains of a Nether portal. The chest next to it often holds gold, and the frame has crying obsidian."]
	quest.6F8D2D54DCC426A5.title: "A Ruined Portal"
	quest.6F930312662F34A2.quest_desc: ["An &a{item.cataclysm.abyss_eye}&r flies towards the sunken city on the ocean floor. That is where you wake &c{entity.cataclysm.the_leviathan}&r."]
	quest.6F930312662F34A2.title: "The Sunken City"
	quest.6FE8EF84C68C687F.quest_desc: ["Give the undertaker a totem of undying. With the right research it helps him resurrect the fallen."]
	quest.6FE8EF84C68C687F.title: "The Undertaker's Totem"
	quest.70069CD4972F8AD2.quest_desc: ["The same for fluids: sal ammoniac from the accumulators flows to the liquefaction cauldrons on its own."]
	quest.70069CD4972F8AD2.title: "Fluids on the network"
	quest.70323C5A34F8FAE4.quest_desc: [
		"Once you have this era's milestones, hand in the &6Seal of the Atomic Era&r. Your whole team enters the Atomic Era and the seal is consumed."
		""
		"The seal is made by Create sequenced assembly on a &6{block.mekanism.steel_casing}&r: deployers add an engineering processor, an elite control circuit, a capacitor and a copper circuit, a press seals them, then hallowed gold and the trophies of two bosses of this era follow."
		""
		"&7See the exact recipe in JEI: hover over the seal and press R.&r"
	]
	quest.70323C5A34F8FAE4.quest_subtitle: "Hand in the seal"
	quest.70323C5A34F8FAE4.title: "Gate: Atomic Era"
	quest.703EF1E03C87178B.quest_desc: ["A powered latch remembers its state: a signal at the back switches it on, a signal at the side switches it off. A toggle latch flips its state with every pulse."]
	quest.703EF1E03C87178B.title: "Latches"
	quest.70B4FD7338043E75.quest_desc: ["Hold 256 crystals of any metal at once. Only an x5 line that gets its ore, acid and water on its own makes that many."]
	quest.70B4FD7338043E75.quest_subtitle: "Automation proof"
	quest.70B4FD7338043E75.title: "Crystal Works"
	quest.70BC27A1F58001BB.quest_desc: ["Industrial pipes carry oil from the deposit up to the pumpjack and link the outputs of the distillation tower. Cut them from steel on a stonecutter."]
	quest.70C1B9524812668E.quest_desc: [
		"Sets an exact speed for the large cogwheel placed on top of it, whatever the power source. Pick the target RPM on its panel."
		""
		"&7Ponder (hold W over the item) shows how to put it together.&r"
	]
	quest.70C1B9524812668E.quest_subtitle: "Milestone"
	quest.70C1B9524812668E.title: "&6{block.create.rotation_speed_controller}"
	quest.70D67FDC3329C861.quest_desc: ["Fireflies sit on tree trunks and you pick them up like a block. Sealed in a jar, one glows like a lamp."]
	quest.70E7DC4726E742B6.quest_desc: ["You will not charge this many ingots by hand. Run iron on a belt under several machines from the previous quest and collect the output with a funnel."]
	quest.70E7DC4726E742B6.quest_subtitle: "Automation proof"
	quest.70EDFDD32A3CF2D1.quest_desc: ["Craft a blank magic map from paper and the focus. Once used, it shows the biomes and main structures of the Twilight Forest around you."]
	quest.70EDFDD32A3CF2D1.quest_subtitle: "Milestone"
	quest.70EDFDD32A3CF2D1.title: "&aThe Magic Map"
	quest.7106AD48F9A4986F.quest_desc: ["Wither skeletons in fortresses rarely drop their skulls. Three skulls placed on soul sand summon the Wither."]
	quest.7123C74FFFEB94F3.quest_desc: ["Sends a redstone signal without wires. Two items in its slots set the frequency, and every link in receive mode with the same pair gets the signal."]
	quest.7146641FF103ED55.quest_desc: ["Andesite combined with iron nuggets gives the alloy from which you will build your first Create machines next era."]
	quest.7146641FF103ED55.quest_subtitle: "Seal ingredient"
	quest.7159AB04F148D22F.quest_desc: ["Nuclear fuel and waste are radioactive. The suit protects you from radiation, and a &6{item.mekanism.geiger_counter}&r shows where it is dangerous."]
	quest.7159AB04F148D22F.title: "Hazmat Suit"
	quest.715CB081AC5001D7.quest_desc: ["Build a rectangular frame of sourcestone, place a full source jar nearby and throw an inscribed warp scroll into the frame. A permanent portal to the remembered spot in the same dimension appears."]
	quest.715CB081AC5001D7.title: "Warp Portal"
	quest.71786F3F8A5631D5.quest_desc: ["The technomancer robes of Cataclysm: Spellbooks. Wizard robes, arcane essence and a technomancy rune, whose focus is an arcane cog or a comparator."]
	quest.71786F3F8A5631D5.title: "Engineer's Outfit"
	quest.717AE319414C1592.quest_desc: ["Automation proof: 256 train tracks. Tracks come from sequenced assembly, so set up a line with deployers and a press before you lay out your first route."]
	quest.717AE319414C1592.title: "Tracks off the Assembly Line"
	quest.71878DD66B276DD9.quest_desc: ["Extends the side of the container it points at. That is how you link a furnace or a machine through a wall."]
	quest.71A5A31E5BF49CEE.quest_desc: ["The {effortlessbuilding.mode.cube} mode takes three clicks: two corners of the base and the height. In the menu pick the filling: full ({effortlessbuilding.action.full}), hollow ({effortlessbuilding.action.hollow}) or just the skeleton ({effortlessbuilding.action.skeleton})."]
	quest.71A5A31E5BF49CEE.title: "Cube"
	quest.71F650FEEF8E9066.quest_desc: ["Sends a pattern's ingredients to the machine next to it or to an assembler, and takes back the product."]
	quest.721DD6D33E898DC7.quest_desc: ["The urn turns source into water. Linked to a cauldron with the dominion wand, it keeps it filled."]
	quest.721E79C1649B6E55.quest_desc: [
		"&7Occult Era · recommended: netherite armor, fire resistance&r"
		"Goety's dark priest. Summon him with a ritual on the dark altar: a netherite ingot activates it, and JEI shows the other ingredients."
	]
	quest.721E79C1649B6E55.quest_subtitle: "Boss"
	quest.721E79C1649B6E55.title: "&c{entity.goety.apostle}"
	quest.7226DC15E5450115.quest_desc: ["Craft them from a starlight flower and ender pearls. They help you find the great structures of Eternal Starlight."]
	quest.722DE86AF016F46A.quest_desc: ["The enchanted spell book of diamond, hogskin, arcane cloth and an enchanted book. It holds even more spells."]
	quest.722DE86AF016F46A.quest_subtitle: "Milestone"
	quest.722DE86AF016F46A.title: "&d{item.irons_spellbooks.diamond_spell_book}"
	quest.72352E2E402CB838.quest_desc: ["Eight rings around a link and a pair of entangled singularities connect two ME networks at any distance, even across dimensions."]
	quest.72352E2E402CB838.title: "Quantum Bridge"
	quest.727E9B13BCBF1C7D.quest_desc: ["Wizard robes, arcane essence and a necro rune on a smithing table. They strengthen undead summons and death spells."]
	quest.727E9B13BCBF1C7D.title: "Necromancer Robes"
	quest.72904B22A8464C33.quest_desc: ["The iron, diamond and netherite rods search ever further. The strongest one needs a blaze rod and netherite scrap."]
	quest.72904B22A8464C33.title: "Better rods"
	quest.729ACA147B872878.quest_desc: [
		"Turns stone, bricks and similar blocks into dozens of patterns, even a whole stack at once. Each Chipped workshop handles different materials."
		""
		"&7Click the workshop, put in a block and pick a pattern from the list.&r"
	]
	quest.72B8182AEEAEBA8E.quest_desc: ["A full cloggrum set for your first descent into the Undergarden."]
	quest.72B8182AEEAEBA8E.title: "Cloggrum Armour"
	quest.72D0FC9438AAD3AC.quest_desc: ["Turns power back into rotation. Place it far from the generator and feed it through a power line."]
	quest.72DB2B4AE2EEBF27.quest_desc: ["A small rail vehicle you place straight onto a track. Pick it back up into your inventory with a wrench."]
	quest.72E1E2BC19C49020.quest_desc: [
		"&7Brass Era · recommended: diamond armor&r"
		"The captain's ghost rises from the water when you blow the shell horn in the Ice Maze."
	]
	quest.72E1E2BC19C49020.quest_subtitle: "Boss"
	quest.72E1E2BC19C49020.title: "&c{entity.aquamirae.captain_cornelia}"
	quest.72E99AAA05838BB0.quest_desc: ["Raider camps stand around the world, full of warriors and loot. Bring guards or your team."]
	quest.72E99AAA05838BB0.title: "Barbarian Camp"
	quest.72F0C6F14125A46B.quest_desc: ["A drive holding many times more than the basic one. The recipe needs plutonium."]
	quest.72F25F57F01FFC0D.quest_desc: ["Lava, fire geysers and the Hydra's lair. This land opens once you eat the stroganoff the Minoshroom leaves behind."]
	quest.72F25F57F01FFC0D.title: "{biome.twilightforest.fire_swamp}"
	quest.730570161AB2FB9C.quest_desc: [
		"Colony buildings open together with your team's eras. Ordinary ones grow in the tech eras, magic ones (library, school, enchanter, mystical site, florist, alchemist, graveyard) in the magic eras."
		"In the Andesite Era everything goes up to level 2. Higher levels appear on this page in later eras."
	]
	quest.730570161AB2FB9C.title: "Two Building Tracks"
	quest.730B8E2ACA9F8861.quest_desc: ["Free flight powered by the suit. It needs a nether star, antimatter and an ultimate induction provider."]
	quest.732C5B634279DBAD.quest_desc: [
		"Craft the town hall from the build tool and planks. Place it with that tool: you choose the style and location of the colony."
		"&7A colony belongs to one player, but you can add the rest of your team to it.&r"
	]
	quest.732C5B634279DBAD.title: "Founding a Colony"
	quest.7342EB62CDB67F4B.quest_desc: ["The amethyst golem grows and harvests amethyst around its home. The Ritual of Awakening performed by budding amethyst gives you the charm."]
	quest.734E190F808D8821.quest_desc: [
		"Make graphite from clay and coal. A press turns it into a blank mold, and a stonecutter cuts the blank into an ingot, sheet, rod or nugget shape."
		""
		"&7The foundry basin and casting table are in the Brass Era chapter. This page extends them.&r"
	]
	quest.736943C43B82146E.quest_desc: ["Sees the whole stock of the network. Seat a mob next to it and it becomes a stock keeper: click it, pick the goods, and the packagers send a package."]
	quest.736943C43B82146E.quest_subtitle: "Milestone"
	quest.736943C43B82146E.title: "&b{block.create.stock_ticker}"
	quest.737270BF555FE1CF.quest_desc: ["Hold 256 alchemical sulfurs of any kind at once. Let the liquefaction cauldrons get their items and sal ammoniac through the network, not from your hand."]
	quest.737270BF555FE1CF.quest_subtitle: "Automation proof"
	quest.737270BF555FE1CF.title: "Sulfur in bulk"
	quest.73770CA8D5A19E9C.quest_desc: ["It only ticks while something drives it. When night falls, the cuckoo reminds everyone around that it is time for bed."]
	quest.737E190FA5816D2F.quest_desc: ["Spins whatever stands on top of it: players, animals and items. Handy for a display or as a carousel."]
	quest.7387C900174FDCFC.quest_desc: ["The faded lantern can call the cult boss to another fight, though not every call is answered."]
	quest.7387FAB39513EF18.quest_desc: ["The boiler heater works like a blaze burner, but it takes heat from pipes instead of fuel. Place it under a Create steam engine boiler."]
	quest.73917E75D35BC1AA.quest_desc: ["The blast stove burns creosote or furnace gas and heats the air from an air intake. Without hot air the blast furnace will not smelt steel."]
	quest.73917E75D35BC1AA.title: "Hot Air"
	quest.73CB7C34B6D592E3.quest_desc: ["Automation proof: 256 iron sheets. A press above a belt flattens ingots as they pass, and a funnel at the end of the belt collects the sheets."]
	quest.73CB7C34B6D592E3.title: "Rolling Mill"
	quest.73D22E161117F5F1.quest_desc: [
		"&7Transcendent Era · magic resistance and plenty of healing recommended&r"
		""
		"The hidden vault of the catacombs holds a scroll of the spell that calls forth the Dead King. Casting it summons his enraged form: stronger, but with better loot."
		"&7Only he drops the scroll of the Blackout spell.&r"
	]
	quest.73D22E161117F5F1.title: "The Dead King Returns"
	quest.73FC15973C7D49B0.quest_desc: ["Emits a redstone signal when the storage holds more or less of a chosen item than a set amount."]
	quest.7404AAD62E8C2537.quest_desc: [
		"&7Occult Era · recommended: netherite armor, potions&r"
		"Three skulls on a soul sand frame wake the destroyer. Fight far from your base, since its explosions wreck the terrain."
	]
	quest.7404AAD62E8C2537.quest_subtitle: "Boss"
	quest.7404AAD62E8C2537.title: "&c{entity.minecraft.wither}"
	quest.7412A95FC4A07D54.quest_desc: ["Each is made of three parts: a print from a press, printed silicon and redstone."]
	quest.7412A95FC4A07D54.title: "Processors"
	quest.7428D1C8B604F4CD.quest_desc: ["A large colony draws the biggest raids. Thirty guards in barracks with a full set of towers make a defence that holds through any night."]
	quest.7428D1C8B604F4CD.title: "The Army of a Large Colony"
	quest.742B79BAED417A1A.quest_desc: [
		"Brew the potion of transformation in a necroturgy ritual with the {entity.goety.apostle}'s blood, a villager sacrifice and 1000 soul energy, then drink it at full moon. A lich never hungers and heals with soul energy."
		""
		"&cWithout headgear a lich burns in sunlight, and villagers hate it.&r"
	]
	quest.742B79BAED417A1A.quest_subtitle: "Milestone"
	quest.742B79BAED417A1A.title: "&dAscension to lichdom"
	quest.744B57DD1079C2D3.quest_desc: [
		"An actuator with both tier 5 stabilizers, light and dark, fused into one block. It holds more than the whole old storage ringed with stabilizers."
		""
		"&7The ritual also needs echo dust, a calibrated sculk sensor and a shulker sacrifice.&r"
	]
	quest.744B57DD1079C2D3.quest_subtitle: "Milestone"
	quest.744B57DD1079C2D3.title: "&bA Stable Dimension"
	quest.746E83CAEFA0D10E.quest_desc: ["Meteorites of sky stone are scattered around the world, with certus quartz growing around them. A &b{item.ae2.meteorite_compass}&r finds them."]
	quest.746E83CAEFA0D10E.title: "A Meteorite"
	quest.7476B7D7F698B358.quest_desc: ["Holds three stacks of scrolls and switches between them with one key. You cast spells without digging through your inventory."]
	quest.747A6AF70FCC8E0A.quest_desc: ["A pirate outpost on the ice. The pirates don't like visitors."]
	quest.747A6AF70FCC8E0A.title: "A Pirate Outpost"
	quest.74872B61F75042BA.quest_desc: ["The diamond building wand places more blocks at once than the iron one. The netherite one comes in the Arcane Era."]
	quest.748E27A6A6B0C8BC.quest_desc: ["Arcane crystal blocks sprinkled with mundabitur dust become an obelisk. Placed by the forge it generates aureal on its own. Look at the finished obelisk."]
	quest.748E27A6A6B0C8BC.title: "Arcane Crystal Obelisk"
	quest.749FF4C39EA6DBDF.quest_desc: ["A terminal with a 3×3 grid: it takes ingredients straight from the chests in the network and puts results back."]
	quest.74A29DF9B4DFE34A.quest_desc: ["Amendments changes ordinary blocks: hang a lantern on a wall, mix dyes in a cauldron and hang a flower pot from the ceiling. It pays to check what else can be placed differently than in the plain game."]
	quest.74A29DF9B4DFE34A.title: "Amendments"
	quest.74A813B40CC23A56.quest_desc: ["Carries 32 channels. Make it from four covered cables."]
	quest.74C281A272FD6D6D.quest_desc: [
		"Steam and spells have carried you far, but the new machines want electricity. Harness Create to generators, run your ores through Mekanism and lock your stock inside an ME network."
		"Two worlds open beneath your feet: the Undergarden and the Otherside. Their guardians will not let you in for free."
		""
		"The era ends at the gate. It requires the milestones of the branches in this chapter and the Seal of the Atomic Era."
	]
	quest.74C281A272FD6D6D.quest_subtitle: "The era begins"
	quest.74C281A272FD6D6D.title: "Electric Era"
	quest.74D7F15B8ECC3010.quest_desc: ["You borrow the gods' authority: your speed and strength grow, and mobs you hit break through walls."]
	quest.74DA58C86CD7C5B1.quest_desc: ["A small Starbuncle shrine from Ars Elemental, hidden among the trees."]
	quest.74DA58C86CD7C5B1.title: "Starbuncle Shrine"
	quest.74E3EAED329E6090.quest_desc: ["A rare island out at sea, covered in mycelium. No monsters spawn there."]
	quest.74E3EAED329E6090.title: "{biome.minecraft.mushroom_fields}"
	quest.74FBE7169DAAD16D.quest_desc: ["Shows the patterns of every provider on the network. Change them without walking from machine to machine."]
	quest.75015D413FFE1814.quest_desc: ["Only an axe fells trees: nothing else can break a log. Make planks from logs in the crafting grid with an axe or a saw."]
	quest.75015D413FFE1814.quest_subtitle: "Milestone"
	quest.75015D413FFE1814.title: "&6{item.notreepunchingremastered.flint_axe}"
	quest.7514362CF1E02C11.quest_desc: ["The Hydra leaves vials of blood. With an iron ingot it makes a fiery ingot, and with an iron sword or pickaxe a fiery weapon or tool."]
	quest.752B16869E32B768.quest_desc: ["Each cube tier is made from the previous cube and a better alloy. It holds many times more."]
	quest.7539CA90673E8513.quest_desc: [
		"A deep stronghold with libraries and prisons. The End portal frame stands at its heart."
		""
		"&7An explorer's compass shows the way, since an eye of ender will not.&r"
	]
	quest.7539CA90673E8513.quest_subtitle: "Milestone"
	quest.7539CA90673E8513.title: "&aThe Stronghold"
	quest.75505D38F4C1C49E.quest_desc: ["Made from &6{item.create.polished_rose_quartz}&r and an iron sheet. It goes into the deployer, the mechanical crafter and the seal."]
	quest.75505D38F4C1C49E.quest_subtitle: "Seal ingredient"
	quest.756A40FEF8172638.quest_desc: [
		"&7Gear: a shield and a melee weapon.&r"
		"The guardian of the portal ruins tests whether you are worthy of Eternal Starlight. Beat him in a duel."
	]
	quest.756A40FEF8172638.quest_subtitle: "Boss"
	quest.756A40FEF8172638.title: "&c{entity.eternal_starlight.the_gatekeeper}"
	quest.756A665E92CC98C4.quest_desc: ["Biomass from plants and oil, compacted in a press. A very strong solid fuel for blaze burners and furnaces."]
	quest.756C1FAA55994171.quest_desc: [
		"Gears \\& Grimoires is a pack about technology and magic. You will go through ten eras, from a flint knife to reactors and the mightiest spells. A final boss awaits at the end."
		""
		"This book guides you through the whole game. The &6Eras&r tab on the left is the main line, and the others cover individual mods. New pages appear when your team enters the next era."
		""
		"A quest with a padlock waits for earlier quests. To see how to make an item, hover over it in JEI and press &6R&r; &6U&r shows what it is used for."
		""
		"Start with the &6Stone Era&r chapter."
	]
	quest.756C1FAA55994171.quest_subtitle: "Start here"
	quest.756C1FAA55994171.title: "Welcome to Gears \\& Grimoires"
	quest.756DBE5C2167C273.quest_desc: ["Fills the gaps between chests: it links them to the connector while storing nothing itself."]
	quest.757D25B04B214434.quest_desc: ["Click the builder's hut with it and it lists the materials for the current build. Handy when you fetch them from your Create storage."]
	quest.7584663819EB3E25.quest_desc: ["MEGA units, storage and co-processors build a crafting CPU just like in AE2, but 1M storage and up handles orders for whole machines made of hundreds of parts."]
	quest.7584663819EB3E25.quest_subtitle: "Milestone"
	quest.7584663819EB3E25.title: "&bMEGA Crafting CPU"
	quest.7595BDE341FB0531.quest_desc: ["Grows the area of the hammer and the excavator by one block each way, from 3×3 to 5×5."]
	quest.75CC9036951AFF0B.quest_desc: ["A chute with a filter: it lets through only the chosen items and sets how many it takes at once."]
	quest.75E86C4DDDBE6445.quest_desc: [
		"Burns gases from a tube: hydrogen from the separator, or ethylene, which gives much more energy."
		""
		"&7A pressurized reaction chamber makes ethylene from biofuel substrate.&r"
		""
		"&7The next reactor tier appears here once your team enters the Atomic Era.&r"
	]
	quest.75F1B8C28A6BA6CC.quest_desc: [
		"Upgrade Aquatic adds pike and perch in rivers and lionfish in warm seas. Catch or hunt one of each."
		""
		"&7More quests on this page appear here once your team enters the Andesite Era.&r"
	]
	quest.75F1B8C28A6BA6CC.title: "New Fish"
	quest.75FD615300C441C1.quest_desc: [
		"A stone you carry with you: it opens the list of known waystones anywhere. Travelling with it costs experience."
		""
		"&7Craft it from amethyst, an emerald and an ender pearl.&r"
	]
	quest.760800D6A478D389.quest_desc: ["Oxidises sulfur dust into sulfur dioxide. With oxygen it becomes sulfur trioxide, and that with water vapour becomes sulfuric acid, which x5 processing cannot run without."]
	quest.7608ED7CC36DA267.quest_desc: ["A vertical relative of the vault from Create: Connected. It grows upwards, so it fits a narrow tower."]
	quest.7615F6CC49558580.quest_desc: ["The monstrous eye leads to the forge. &c{entity.cataclysm.netherite_monstrosity}&r guards it."]
	quest.7615F6CC49558580.title: "The Soul Blacksmith"
	quest.76291927B354F598.quest_desc: [
		"Steel gave you strength; now it is time for knowledge. The Hephaestus Forge, mercury alchemy and elemental mastery open up magic you have only read about. In the Nether and the deserts the guardians of Cataclysm awaken, and cultists guard their secret in hiding."
		""
		"The era ends at the gate. It requires the milestones of this chapter and the Seal of the Electric Era."
	]
	quest.76291927B354F598.quest_subtitle: "Knowledge over strength"
	quest.76291927B354F598.title: "Arcane Era"
	quest.7639FF2B607C85B6.quest_desc: ["It grows in fortresses and bastions. You can only plant it on soul sand, and without it you can brew almost no potions."]
	quest.765865B802196D5E.quest_desc: ["Transfers a fixed amount of stress capacity from one network to another but keeps them apart: overstressing one does not stop the other."]
	quest.7679E37E80D20468.quest_desc: ["Joins the repositories touching it into one collection that the lectern treats as a single chest."]
	quest.76914BC2056BCB0C.quest_desc: ["The ring lowers the cost of every spell. It is made in the apparatus from a ring of potential, an ender pearl and a diamond."]
	quest.7692E2658ECFA919.quest_desc: ["Turns its signal on when a container's stock passes the upper threshold and off below the lower one. It stops production before the storage overflows."]
	quest.7698D81895765B5E.quest_desc: ["A drawer for fluids: it holds a lot of one fluid. Fill it with a bucket or a pipe."]
	quest.769AB37AFF8E9CEF.quest_desc: ["Build a minecart contraption with a deployer that places rails in front of it. The cart lays out its own way."]
	quest.769AB37AFF8E9CEF.title: "Cart that Lays Its Own Track"
	quest.76AEE6D375514BB2.quest_desc: ["Link insulators on posts with a wire spool to carry power over distance. Devices in one group share the voltage; change the group with the configuration wrench."]
	quest.76AEE6D375514BB2.title: "Power Line"
	quest.76C395675A66797C.quest_desc: ["They drop from glacite blocks in the frozen lands. They make tools and armour."]
	quest.76CA1A9E33002137.quest_desc: [
		"A powered tool for everything: it mines, chops trees and fights. Switch the mining speed with its modes."
		""
		"&7More quests on this page appear here once your team enters the Atomic Era.&r"
	]
	quest.76E4098E4BB473C0.quest_desc: ["Let a mechanical arm feed fuel to a blaze burner on its own. Brass and steam keep going while you are away."]
	quest.76E4098E4BB473C0.title: "Stoker"
	quest.76E7AB773DADB442.quest_desc: ["A thicket of spikes you cut through with the lamp. The plateau rises beyond it."]
	quest.76E7AB773DADB442.title: "{biome.twilightforest.thornlands}"
	quest.77050A57A7BD2041.quest_desc: ["A pickaxe made of parts. The head material sets its mining level: an iron head mines diamonds."]
	quest.77050A57A7BD2041.quest_subtitle: "Milestone"
	quest.77050A57A7BD2041.title: "&6{item.silentgear.pickaxe}"
	quest.771A48EDDB73032C.quest_desc: ["The largest QIO drive. It needs antimatter and polonium, so it rewards the whole era."]
	quest.771F3169787D4F46.quest_desc: ["The iron wand places more blocks at once than the copper one and lasts longer."]
	quest.772875E33A91B129.quest_desc: ["A controller, a drive with a storage cell and a terminal make the smallest ME network. Everything you put in is one search away."]
	quest.772875E33A91B129.quest_subtitle: "Milestone"
	quest.772875E33A91B129.title: "&bAn ME Network with a Drive"
	quest.7732A546E5097A08.quest_desc: ["On the arcane anvil you merge two scrolls of the same spell into a higher-level scroll, imbue a spell into a weapon and put an upgrade orb on armour. Craft it from an anvil, diamonds, amethyst blocks and polished deepslate."]
	quest.7732A546E5097A08.quest_subtitle: "Milestone"
	quest.7732A546E5097A08.title: "&d{block.irons_spellbooks.arcane_anvil}"
	quest.7741DF1FA2EFFDD2.quest_desc: ["The fifth and widest ring of runes (172 in total) and pillars crowned with crystal clusters. A cluster on such an altar gives the Divinus orb, the peak of vitaemancy."]
	quest.7741DF1FA2EFFDD2.quest_subtitle: "Milestone"
	quest.7741DF1FA2EFFDD2.title: "&d{item.neovitae.blood_orb_transcendent}"
	quest.776868013AA396D2.quest_desc: ["The toxic heap, the volcanic deltas and the ash barrens are the most dangerous lands of the Nether. The forbidden castle stands in the barrens."]
	quest.776868013AA396D2.title: "Wild Incendium Lands"
	quest.7779B739FE49A31A.quest_desc: [
		"The magic workbench has a 3×3 grid and extra slots around it. Almost all of Eidolon's equipment is made on it."
		""
		"&7The codex and JEI (R) show what goes where.&r"
	]
	quest.77A646BE63F42A6E.quest_desc: ["Lets through only what the chest already holds. The storage sorts itself."]
	quest.77A9ACD05722B00C.quest_desc: ["A portable 1M cell with its own screen. Take a whole materials store on an expedition."]
	quest.77B4155A554E183A.quest_desc: ["Wolframite lies in the Nether, in netherrack up to height 60. Melted in the foundry basin and cast, it gives tungsten ingots."]
	quest.77D9833101CB4077.quest_desc: ["Place it on a pole above a train signal, and the semaphore arm shows the signal's state from afar."]
	quest.77DE00273F050959.quest_desc: [
		"The “{key.constructionstick.change_restriction}” key changes the restriction: horizontal, vertical, along an axis or none."
		"Hold “{key.constructionstick.show_previous}” to see the blocks you placed last; “{key.constructionstick.undo}” undoes that operation and returns the blocks."
		""
		"&7A block in your offhand takes priority over the one you look at.&r"
	]
	quest.77DE00273F050959.title: "Stick Controls"
	quest.77E8995D40487E15.quest_desc: ["Ars Ocultas joins Ars Nouveau and Occultism. The sacrificial altar is made in the enchanting apparatus from an Occultism golden bowl, a containment jar and a Drygmy token; the Ars Ocultas chapter of the Ars Nouveau guide explains how to use it."]
	quest.77F54D5DA0D7C74F.quest_desc: ["Dragons Plus gives fans new processing: through powder snow they freeze, turning ice into packed ice and magma cream into a slime ball, and through sand they polish like sandpaper. Create: Connected catalysts do the same without blocks in the world."]
	quest.77F54D5DA0D7C74F.title: "Freezing and Sanding"
	quest.77FCF655CACC5065.quest_desc: [
		"The hose pulley lowers its end into a fluid and drains it or fills the body from below. A very large body such as an ocean counts as infinite and never shrinks."
		""
		"&7Ponder (hold W over the item) shows how to set it up.&r"
		""
		"&7More quests on this page appear here once your team enters the Brass Era.&r"
	]
	quest.77FCF655CACC5065.title: "Hose into the Deep"
	quest.781B686B918890DB.quest_desc: ["Presses patterns onto silicon and metals. Every AE2 processor is made here."]
	quest.781DEC8ECB15EE9A.quest_desc: [
		"The second capacity tier. It is made from the copper upgrade, a block of gold and a drawer."
		""
		"&7The next drawer tier appears here once your team enters the Steam and Steel Era.&r"
	]
	quest.78374C2DA182482C.quest_desc: ["Prismarine bricks, a pufferfish, a potion and a bookshelf. Seashelves give Eterna and Arcana, and infused ones upgrade with a heart of the sea or crystals."]
	quest.7838D0040ACF1957.quest_desc: ["Only a closed line of pressurized reaction chambers makes this many sheets. Build it once and you will never run out of plastic."]
	quest.7838D0040ACF1957.quest_subtitle: "Automation proof"
	quest.783D4E8F72AFEB32.quest_desc: ["The propeller bearing spins the sails attached to it like a propeller and pushes the simulated contraption. A bigger propeller gives more thrust."]
	quest.7841500570B9B0BF.quest_desc: ["Use it on a placed Sophisticated Storage chest or barrel: it becomes an iron one with more room, without emptying it."]
	quest.784FFE5AA9775311.quest_desc: [
		"Steam and steel change the scale of everything. The blast furnace pours steel, the distillation tower splits oil into fuels, and from them come engines, cannons and ships that rise above the clouds. Higher still waits only the Aether and its guardians."
		""
		"The era ends at the gate. It requires the milestones of this chapter and the Seal of the Arcane Era."
	]
	quest.784FFE5AA9775311.quest_subtitle: "The blast furnace fires up"
	quest.784FFE5AA9775311.title: "Steam and Steel Era"
	quest.786967513C9B04D7.quest_desc: [
		"&7Atomic Era · good armour and fire resistance potions recommended&r"
		""
		"On the End islands stands an obsidian arena with a runic altar. Obsidilith, a living obsidian monolith, waits there."
	]
	quest.786967513C9B04D7.title: "The Obsidilith Arena"
	quest.78771C6E929A4D20.quest_desc: ["A mixer above a heated basin makes liquid chocolate from cocoa, sugar and milk. The same spout must coat berries in chocolate, an apple in honey and bread in milk."]
	quest.78771C6E929A4D20.title: "Sweet Spout"
	quest.788AA0421DA887F2.quest_desc: [
		"&7Steam and Steel Era. Recommended gear: a zanite pickaxe or better and full armour.&r"
		"The stone guardian of the bronze dungeon. Only a pickaxe can hurt it. The dungeon hides inside one of the Aether islands."
	]
	quest.788AA0421DA887F2.quest_subtitle: "Boss"
	quest.788AA0421DA887F2.title: "&c{entity.aether.slider}"
	quest.789CDD2AC65B21C6.quest_desc: ["Summons a familiar. You can swap places with it, and its garden forbids fighting to everyone inside."]
	quest.78AA9DDDFCCCE1A6.quest_desc: ["Leave the Bumblezone: fall below the bottom of the dimension and you return where you came from."]
	quest.78AA9DDDFCCCE1A6.title: "Back from the Hive"
	quest.78B0E0C2EC7E9730.quest_desc: ["A furnace inside the chest: it smelts chosen items and takes fuel from the chest's contents."]
	quest.78B13D12DA89942E.quest_desc: ["Build the cow, sheep, pig, chicken and rabbit herders' huts. Bring a few animals to each to start."]
	quest.78B13D12DA89942E.title: "Every Herder"
	quest.78B170ABA0F60C53.quest_desc: ["Moves source between jars over a distance. Craft it from gold and a source gem block."]
	quest.78CAEB6741926428.quest_desc: ["A pickaxe infused in a djinni ritual from an attuned gem head and silver. Only it can collect otherworld ores such as iesnium."]
	quest.78E0EEECE1B51D69.quest_desc: [
		"Thrashers hunt in deep cold seas and sense movement in the water. They drop a tooth after the fight."
		""
		"&7More quests on this page appear here once your team enters the Rune Era.&r"
	]
	quest.78E5F261603DF32D.quest_desc: ["A P2P tunnel carries a whole bundle of channels elsewhere while taking only one. Link input and output with a memory card: copy the input and click the output."]
	quest.78E5F261603DF32D.title: "P2P Tunnels"
	quest.78F2A9F2B1B4CBA3.quest_desc: ["A Tabula Rasa on a tier one altar for 2000 essence. It makes ritual stones and stronger sigils."]
	quest.78FEA7C19FF81FFB.quest_desc: ["Dropped by the {entity.eidolon_repraised.necromancer}. It summons the undead stored inside to fight at your side; a capturing ritual stores more."]
	quest.7906347C754516E9.quest_desc: ["A Drygmy collects drops from nearby creatures without harming them. Befriend a wild Drygmy by throwing a wilden horn near it; the charm used on mossy cobblestone builds its henge."]
	quest.790A76A2A83ABBC3.quest_desc: ["Shelves are infused in the table itself: put the shelf in the item slot and enchant at the stats JEI lists (infusion tab). The infused shelf gives more Arcana."]
	quest.790BE9B2E7239D83.quest_desc: ["A Whirlisprig speeds up the plants around it and produces crops from them. You get its token by growing a tree next to a wild Whirlisprig in a forest."]
	quest.791A76947B4455A4.quest_desc: ["An ignitium shield. Released while sneaking, it charges forward, and an enemy slammed into a wall takes extra damage and is stunned."]
	quest.79252FF3E5D61315.quest_desc: ["The carpenter's table works wood, planks and logs, and the loom table works wool and carpets."]
	quest.79252FF3E5D61315.title: "Carpenter and Weaver"
	quest.7932AF6110364BFA.quest_desc: [
		"Mines the ores you choose within a radius you set and puts them in a container next to it. It leaves the rest of the terrain alone."
		""
		"&7Make the teleportation core and atomic alloy in the metallurgic infuser.&r"
	]
	quest.7932AF6110364BFA.quest_subtitle: "Milestone"
	quest.7932AF6110364BFA.title: "&6{block.mekanism.digital_miner}"
	quest.795258F1A054C82D.quest_desc: ["Rotates the structure attached to it around its axis. That is how you build revolving doors, drawbridges and carousels."]
	quest.796280A902728961.quest_desc: ["Made from a Create steam engine, and like it, it connects to a shaft. One replaces several smaller engines."]
	quest.797A764F7E47FBEB.quest_desc: ["Step through the portal into a world under eternal stars. Meteors fall from its sky."]
	quest.797A764F7E47FBEB.quest_subtitle: "Milestone"
	quest.797A764F7E47FBEB.title: "&aEternal Starlight"
	quest.797FA3A5C3DAD91E.quest_desc: ["Dungeons and Taverns taverns stand in many biomes, each in its own style. Rest and search the chests."]
	quest.797FA3A5C3DAD91E.title: "A Tavern"
	quest.798EC37B651641C6.quest_desc: ["Every backpack slot holds more than a normal stack. The recipe needs a block of copper."]
	quest.799A2FD189BF1CDB.quest_desc: ["Placed in the world, it slowly turns into rich soil. Crops grow faster on it, and mushrooms spread into colonies."]
	quest.799AE47C73D2A173.quest_desc: ["The second piece of scale armour, a pair for the tunic from the era chapter. It protects better than iron."]
	quest.79A0D70C3A82A445.quest_desc: [
		"&7Gear: a way to move fast, because the keeper pulls you in and drains life.&r"
		"It waits atop the Final Terminal in the End. Summon it with four &c{item.goety.void_shard}&r at the void shrine."
	]
	quest.79A0D70C3A82A445.quest_subtitle: "Boss"
	quest.79A0D70C3A82A445.title: "&c{entity.goety.ender_keeper}"
	quest.79B036A2062959C8.quest_desc: ["Found in village armorer, toolsmith and weaponsmith chests. On the forge it cuts the experience cost by a quarter, and in the Clibano furnace it allows new alloys."]
	quest.79CCF42D66CA59A7.quest_desc: [
		"x2: the enrichment chamber turns ore into two dusts. x3: the purification chamber with oxygen makes three clumps. x4: the injection chamber with hydrogen chloride makes four shards. x5: dissolving, washing and crystallising make five crystals."
		"Each step adds machines in front of the previous one, so you grow the line from its end."
	]
	quest.79CCF42D66CA59A7.title: "The Ore Processing Ladder"
	quest.79E3F1B96B9E80DA.quest_desc: [
		"The {block.tfmg.coke_oven} turns coal into coke and creosote. Coke ground on crushing wheels fuels the blast furnace, and creosote heats the blast stove and hardens planks."
		""
		"&7Ponder (W) shows how to build the oven.&r"
	]
	quest.79E3F1B96B9E80DA.title: "Coke"
	quest.7A02EB97A55E6231.quest_desc: ["A netherite sword reforged with an echo of the void and dark alloy. Right-click while sprinting to dash forward, or without sprinting to step back; a full swing releases a razor wind. The echo is left by the {entity.goety.ender_keeper} from the Atomic Era tree."]
	quest.7A02EB97A55E6231.quest_subtitle: "Milestone"
	quest.7A02EB97A55E6231.title: "&d{item.goety.blade_of_ender}"
	quest.7A0EACD29B6D5D9A.quest_desc: ["Fill it with any fluid at a spout and spray your enemies. With a lighter it turns fuel into a jet of flame."]
	quest.7A15DC408124E3E3.quest_desc: ["The chalk draws a rune on the ground. A spell with the Rune glyph stays in it and strikes the first creature that steps on it."]
	quest.7A16CA00A46707DE.quest_desc: [
		"A saw cuts moulds of several sizes from logs. Every cannon part – chamber, barrel, end, breech – has its own mould, and JEI shows which one you need (U on the mould)."
		""
		"&7Ponder (hold W over the item) shows the whole process.&r"
	]
	quest.7A16CA00A46707DE.title: "Cast Moulds"
	quest.7A2B4AEFB55D3CB2.quest_desc: [
		"&7Atomic Era · a way to move fast recommended: the keeper pulls you in and drains life&r"
		""
		"Endersents, Goety's giant endermen, drop void shards. Four placed in the void shrine in the End summon the keeper."
	]
	quest.7A2B4AEFB55D3CB2.title: "Void Shards"
	quest.7A3F681F467348EA.quest_desc: ["Spreads its contents all over the target. Water puts out fires, and lava… you will see."]
	quest.7A4F61BCD0C385EF.quest_desc: ["Mine mithril ore deep underground with a netherite pickaxe. A blast furnace turns it into scraps, and nine scraps make an ingot."]
	quest.7A50644B521C28CE.quest_desc: ["Automation proof: 256 sky steel ingots. They form in lava from charged certus, iron and sky stone. Formation and annihilation planes over the lava do it without you."]
	quest.7A50644B521C28CE.title: "Sky Steel Works"
	quest.7A543BA189EDB4F4.quest_desc: ["An underground grotto overgrown with thorns. The Void Blossom does not move, but it hurls sharp petals and releases spores, so keep your distance."]
	quest.7A543BA189EDB4F4.title: "The Void Blossom's Grotto"
	quest.7A6DDEAE5690238F.quest_desc: ["Heavier counterparts of the Create copper tanks and pumps. Steel tanks also build the distillation tower and the chemical vat."]
	quest.7A6DDEAE5690238F.title: "Steel Tanks and Pumps"
	quest.7A875C04743BEF62.quest_desc: [
		"Beyond the veil of the world live spirits and demons that can be summoned, bound and put to work. Occultists draw pentacles in chalk, soul alchemists infuse steel with spirits, and necromancers gather the souls of the fallen. Every one of these paths leads to the Nether in the end."
		""
		"The era ends at the gate. It requires the milestones of this chapter's branches, two different bosses of this era and the Seal of the Steam and Steel Era."
	]
	quest.7A875C04743BEF62.quest_subtitle: "Spirits, souls and rituals"
	quest.7A875C04743BEF62.title: "Occult Era"
	quest.7A89A0AD1EC3F0BF.quest_desc: ["The hidden vault of the Iron's Spellbooks catacombs holds a scroll of &d{spell.gametechbcs_spellbooks.call_forth_the_dead_king}&r. Cast it to challenge the &c{entity.gametechbcs_spellbooks.hard_dead_king}&r."]
	quest.7A89A0AD1EC3F0BF.title: "The Catacombs"
	quest.7AAB10F19BF64E12.quest_desc: ["At a station you assemble trains and set stops. Place it next to a track and name it in its menu."]
	quest.7AAFA8E8BFFF7FBC.quest_desc: ["Once the builder finishes the town hall at level 1, the colony really starts. This era buildings go up to level 2."]
	quest.7AAFA8E8BFFF7FBC.quest_subtitle: "Milestone"
	quest.7AAFA8E8BFFF7FBC.title: "&3Town Hall"
	quest.7AC703A20EAA84AE.quest_desc: [
		"Gems drop from monsters and lie in chests. Socketed into a weapon or armour piece, a gem gives a bonus that depends on its type and purity; JEI shows how to socket it."
		""
		"&7The next enchanting tier appears here once your team enters the Rune Era.&r"
	]
	quest.7AC703A20EAA84AE.title: "First gem"
	quest.7AE185395A600437.quest_desc: ["Another Incendium build. Piglins trade Nether goods for your gold."]
	quest.7AE185395A600437.title: "Piglin Village"
	quest.7B013EE897E11551.quest_desc: ["Piglin ruins full of gold and chests. The chests hold the &a{item.minecraft.netherite_upgrade_smithing_template}&r you need for netherite next era."]
	quest.7B013EE897E11551.title: "Bastion Remnant"
	quest.7B1C0B8730481FDE.quest_desc: ["A quantum catcher upgraded on the fourth forge tier with a nether star and three stellarite pieces. It can trap even a boss."]
	quest.7B321B4B3A7721CC.quest_desc: [
		"Automation proof: 256 cardboard. Make pulp from wood and paper in a mixer, then press it into cardboard. Packagers in the Brass Era use cardboard for every package."
		""
		"&7The next logistics tier appears here once your team enters the Brass Era.&r"
	]
	quest.7B321B4B3A7721CC.title: "Cardboard Stockpile"
	quest.7B3C4B4EE700EF2E.quest_desc: ["The Stirling engine makes rotation from the heat of a burner below it: the solid burner burns items, the liquid one fuel from a pipe. Without heat the engine stops."]
	quest.7B3C4B4EE700EF2E.title: "Stirling Engine"
	quest.7B472916B8B3515D.quest_desc: [
		"Flint and copper took you far, but hands have their limits. A river and the wind can work for you: all it takes is a shaft, a wheel and a handful of andesite alloy."
		""
		"The era ends at the gate. It requires the milestones of this chapter's branches and the Seal of the Rune Era."
	]
	quest.7B472916B8B3515D.quest_subtitle: "The first machines"
	quest.7B472916B8B3515D.title: "Andesite Era"
	quest.7B64099E5629EAAA.quest_desc: ["Lower a rope pulley more than 200 blocks down. You start at the surface and finish at the very bottom of the world."]
	quest.7B64099E5629EAAA.title: "Bottomless Well"
	quest.7B71184C39C5C508.quest_desc: ["Go below level 0 until you hit &a{block.minecraft.deepslate}&r. Lapis and geodes lie down there."]
	quest.7B71184C39C5C508.quest_subtitle: "Milestone"
	quest.7B71184C39C5C508.title: "&aInto the Depths"
	quest.7B740AD0D7800932.quest_desc: ["The next tier: more blocks at once and more durability. From this stick on, templates are worth installing."]
	quest.7B7AF912990B88C4.quest_desc: ["The crimson forest, the warped forest, the soul sand valley and the basalt deltas. Visit all four."]
	quest.7B7AF912990B88C4.title: "Four Lands"
	quest.7B8330C327817EA8.quest_desc: ["Almost a whole double chest on your back."]
	quest.7B8AA5496ED950D6.quest_desc: ["The witherite launcher fused with a void core on the fusion anvil. It fires void howitzers."]
	quest.7B9F90C111570883.quest_desc: ["Place a gold chest, or raise an existing one with a tier upgrade, and look at it for a moment. It holds much more and has more upgrade slots."]
	quest.7B9F90C111570883.quest_subtitle: "Milestone"
	quest.7B9F90C111570883.title: "&bGold Chest"
	quest.7BAAA10F1FA5A9A2.quest_desc: ["Collect it with an empty bottle from the purple cloud the dragon breathes on the island. Handy in potions and rituals."]
	quest.7BADFFCFB17142E5.quest_desc: ["Thorium ore lies in the Overworld. A mixer multiplies thorium with stone and clay, and crushing wheels make radioactive thorium from it – the reactor's fuel."]
	quest.7BBD147946A9A03F.quest_desc: [
		"On the afrit pentacle of gray, lime, orange, red and white chalk, summon it to crush ores. The afrit is faster and more efficient than the djinni."
		""
		"&7The next Occultism tier appears here once your team enters the Arcane Era.&r"
	]
	quest.7BBD147946A9A03F.quest_subtitle: "Milestone"
	quest.7BBD147946A9A03F.title: "&dAfrit Crusher"
	quest.7BC43F3F809F769A.quest_desc: [
		"&7Gear: a shield and a fast weapon.&r"
		"A high official of the Goety illagers. Summon him with a dark scroll used inside a woodland mansion."
	]
	quest.7BC43F3F809F769A.quest_subtitle: "Boss"
	quest.7BC43F3F809F769A.title: "&c{entity.goety.vizier}"
	quest.7BCDAACC3077F8E2.quest_desc: ["The last pedestal of the seal. Mine a diamond with an iron pickaxe."]
	quest.7BCDAACC3077F8E2.quest_subtitle: "Seal ingredient"
	quest.7BD66FE3C07F928C.quest_desc: ["They grow on glowing vines in the blooming caverns. They are edible."]
	quest.7BF870C923925736.quest_desc: [
		"&7Brass Era · recommended: diamond armor&r"
		"The sunbird rules the Umvuthana tribe. You will find its grove in a savanna, guarded by masked warriors."
	]
	quest.7BF870C923925736.quest_subtitle: "Boss"
	quest.7BF870C923925736.title: "&c{entity.mowziesmobs.umvuthi}"
	quest.7C034B8DAFC220D1.quest_desc: [
		"Sets the filter and priority of a cable connector. Ores go to one chest and wood to another."
		""
		"&7The next storage tier appears here once your team enters the Arcane Era.&r"
	]
	quest.7C0419F3F94DD5BF.quest_desc: ["Holds as much as a double chest. Name it on an anvil and the lectern shows that name as a separate tab."]
	quest.7C0C8BAF017D0344.quest_desc: ["Boundaries (the iron school) act around a placed circle and drain mana at intervals: an alarm, life drain, heavier gravity, walls of earth. Toggle them with right-click or redstone."]
	quest.7C0C8BAF017D0344.title: "Boundary scroll"
	quest.7C297BF0580ADE8F.quest_desc: ["Links storage links to a controller and locks chosen chest slots to one item."]
	quest.7C665CA0706A00E7.quest_desc: [
		"Click a ghast in the Nether with an empty Create: Power Loader chunk loader to trap it inside. A powered loader keeps its chunk loaded even with nobody nearby, but too slow a rotation switches it off."
		""
		"&7Ponder (hold W over the item) shows how it works.&r"
	]
	quest.7C8B96D5164FDF2A.quest_desc: ["Abjuration, conjuration and manipulation essences are also made in the imbuement chamber. Without them you cannot make charms, relays or ritual tablets."]
	quest.7C8B96D5164FDF2A.title: "School Essences"
	quest.7C93095788D8449C.quest_desc: [
		"Deep underground lies the Weeping Well, filled with the primordial soup of the void. The void turns items thrown into the soup into new ones, and a long bath in it does you harm."
		""
		"&7JEI shows what the void makes of each item.&r"
	]
	quest.7C93095788D8449C.title: "The Weeping Well"
	quest.7CB920BAAB3079B9.quest_desc: ["A Wixie crafts items and brews potions for source. The charm used on a cauldron summons her to work."]
	quest.7CD914D2D3A9716F.quest_desc: ["A temple of angelic stone on the clouds. Valkyries guard the way in, and their queen fights once you show her ten victory medals."]
	quest.7CD914D2D3A9716F.title: "The Silver Dungeon"
	quest.7CDA679033AA642E.quest_desc: ["Defeat one of the rulers of the sea. Its trophy goes into the Seal of the Finale."]
	quest.7CDA679033AA642E.quest_subtitle: "Milestone"
	quest.7CDA679033AA642E.title: "&c{entity.cataclysm.the_leviathan} or {entity.cataclysm.scylla}"
	quest.7CF24A714E10B089.quest_desc: ["The drill breaks the block in front of it, even obsidian that an iron pickaxe cannot touch. On a moving contraption with a bearing or a piston it mines whole walls."]
	quest.7CFF1792EC24E0D4.quest_desc: [
		"Reactor rods, a fuel acceptor and a heat vent in a reactor casing. The vent passes heat to pipes, and they feed boiler heaters."
		""
		"&cThe reactor emits radiation: enclose it in reactor casing and glass. Its heat must go somewhere, or it melts down.&r"
	]
	quest.7CFF1792EC24E0D4.quest_subtitle: "Milestone"
	quest.7CFF1792EC24E0D4.title: "&6Thorium Reactor"
	quest.7D20C0CDDB6F6D9D.quest_desc: ["An iesnium anvil improved in a marid ritual. The dictionary of spirits lists its advantages over an ordinary anvil."]
	quest.7D2D00BD3856EE8C.quest_desc: ["Maledictus's heavy axe of black steel and cursium."]
	quest.7D3498FA69E02F5D.quest_desc: ["A deep frozen ocean covered in walls of ice. The creatures of Aquamirae live here."]
	quest.7D3498FA69E02F5D.title: "The Ice Maze"
	quest.7D443D5346F93ADE.quest_desc: [
		"&7Brass Era · diamond armour and warm clothing recommended&r"
		""
		"A maze of ice walls covers the deep frozen ocean, with wrecked pirate ships among them. Here the ghost of Captain Cornelia answers the shell horn."
	]
	quest.7D443D5346F93ADE.title: "The Ice Maze"
	quest.7D5DAB7F8619B6B6.quest_desc: ["Its arrows curve towards the nearest enemy on their own."]
	quest.7D7DFD8C579728E3.quest_desc: ["The evasion elixir from an ender pearl, oakskin from an oak log or invisibility from a shriving stone. Brew any of them in the alchemist cauldron."]
	quest.7D7DFD8C579728E3.title: "An Alchemist's Elixir"
	quest.7DA6E0E2950FE297.quest_desc: [
		"Harvest, Fell and Pickup are tier-one glyphs that the novice book can already hold. Combined with Break they replace your tools."
		""
		"&7You learn a glyph by using it (right-click) once it is made.&r"
	]
	quest.7DA6E0E2950FE297.title: "Glyphs for Work"
	quest.7DC4DB997C462180.quest_desc: [
		"Hold Left Alt (“{key.effortlessbuilding.open_radial_menu}”) and a wheel of build modes appears. Point at a mode and release the key."
		"In a shape mode the first click sets the start and the next ones close the shape. A preview shows the blocks before you place them."
		""
		"&7How many blocks you place at once depends on the server settings.&r"
	]
	quest.7DC4DB997C462180.title: "The Mode Menu"
	quest.7DC67F351CDCAD4D.quest_desc: ["Driven by Create, it rolls ingots into rods and sheets into wires. Every Crafts \\& Additions installation starts here."]
	quest.7DEE64F639D186B5.quest_desc: ["Crafts the recipes from the patterns its provider sends. Place it right next to the provider."]
	quest.7E16A6FC1B86D393.quest_desc: ["Defeat one more boss of this era, other than the Wither and the Gauntlet. Any of the other four counts, and its trophy also goes into the seal."]
	quest.7E16A6FC1B86D393.quest_subtitle: "Milestone"
	quest.7E16A6FC1B86D393.title: "&cA Second Boss of the Era"
	quest.7E16DA225FB32520.quest_desc: ["The alchemist's furnace, made with a Tabula Animata. It triples ore yields, unmakes orbs and reinforced runes, and distils weak blood shards from Tau."]
	quest.7E24593CF5742FB5.quest_desc: ["Bone meal with arcane crystal dust. Use it on farmland to turn it into magical farmland, which doubles the harvest."]
	quest.7E24593CF5742FB5.title: "Magical farmland"
	quest.7E3476D9377E1B4C.quest_desc: [
		"The Aether is a world of islands floating above the clouds. This page leads through its lands, materials and dungeons; the bosses are in the Steam and Steel Era tree."
		""
		"&7Mind the edges of the islands: below them there is nothing but clouds and void.&r"
	]
	quest.7E3476D9377E1B4C.title: "Islands in the Clouds"
	quest.7E4031A8DD63D3DC.quest_desc: ["Automation proof: 256 refined soulstone. Crushing wheels grind the ore, and fan washing through water turns each crushed piece into two."]
	quest.7E4031A8DD63D3DC.title: "Soulstone off the Belt"
	quest.7E44769AB8382CDE.quest_desc: ["Nether bricks, a blaze rod, a potion and a bookshelf. Hellshelves push Eterna past the plain 15 and add Quanta: the table enchants at about level 45."]
	quest.7E44769AB8382CDE.quest_subtitle: "Milestone"
	quest.7E44769AB8382CDE.title: "&d{block.apothic_enchanting.hellshelf}"
	quest.7E510C892B528E5E.quest_desc: ["Azure silver ore lies in the End. It is the base of the last Silent Gear alloys."]
	quest.7E58188A86F2022D.quest_desc: [
		"Mithril rings shorten cooldowns, speed up casting, add mana or protect from an element. Wear them in the ring slots."
		""
		"&7The next Iron's Spells tier appears here once your team enters the Atomic Era.&r"
	]
	quest.7E58188A86F2022D.title: "A Mage's Ring"
	quest.7E8E8E6098F09484.quest_desc: ["Scylla's weapons, made from lacrima and the essence of the storm. Astrape hurls a lightning spear, and Ceraunus throws its anchor and raises waves while you sneak."]
	quest.7E8E8E6098F09484.title: "Weapons of the Storm"
	quest.7E93624FCC714F4B.quest_desc: ["Look at a wall and click: the stick adds a whole row of blocks on the side you face. It takes the blocks from your inventory, shulker boxes and bundles included."]
	quest.7E94F4BB35D0DFE1.quest_desc: ["The builder asks for materials and tools. Open his requests and hand over what is missing with the button in the request window."]
	quest.7E94F4BB35D0DFE1.title: "The Builder's Requests"
	quest.7E98DB729D8F2B36.quest_desc: [
		"Once you have this era's milestones, hand in the &6Seal of the Rune Era&r. Your whole team enters the Rune Era and the seal is consumed."
		""
		"Mix the seal in a &6{block.create.mechanical_mixer}&r above a basin, without heat: 4 lapis lazuli, 4 amethyst shards, 2 gold ingots, an emerald, a bottle o' enchanting, an andesite casing and 500 mB of honey."
		""
		"&7See the exact recipe in JEI: hover over the seal and press R.&r"
	]
	quest.7E98DB729D8F2B36.quest_subtitle: "Hand in the seal"
	quest.7E98DB729D8F2B36.title: "Gate: Rune Era"
	quest.7EBB07EE0E2AA50A.quest_desc: [
		"This page is the Nether from a traveller's side: lands, materials and structures. Incendium reshapes the landscape, and Moog's and Dungeons and Taverns add structures."
		""
		"&cDo not sleep in a bed in the Nether: it explodes.&r"
	]
	quest.7EBB07EE0E2AA50A.title: "Through the Portal"
	quest.7EE6274B35D74035.quest_desc: ["Enter the Undergarden: a dark land below the world, full of fungi and rot. Bring plenty of light."]
	quest.7EE6274B35D74035.quest_subtitle: "Milestone"
	quest.7EE6274B35D74035.title: "&aThe Undergarden"
	quest.7F123C501181DCEE.quest_desc: ["A reagent from the Tabula Vitae as the base and a slate as the catalyst. A water source costs 100 essence, a lava source 1000."]
	quest.7F123C501181DCEE.title: "Water and lava sigils"
	quest.7F14F4FE3911EE51.quest_desc: ["The saw is the second tool for cutting logs into planks and one of the seal's ingredients."]
	quest.7F14F4FE3911EE51.quest_subtitle: "Seal ingredient"
	quest.7F180C322BC884E0.quest_desc: ["Biomes O' Plenty adds a dense undergrowth and crystalline chasms to the Nether."]
	quest.7F180C322BC884E0.title: "The Biomes O' Plenty Nether"
	quest.7F25DF42B3C355B1.quest_desc: ["A colony of twenty-five citizens is already a small village. Remember houses and food for the newcomers."]
	quest.7F25DF42B3C355B1.title: "Twenty-Five Citizens"
	quest.7F2F64FF607A4878.quest_desc: ["Each next component consumes the previous one and holds four times more. 16M cells last a whole era."]
	quest.7F2F64FF607A4878.title: "Bigger MEGA Cells"
	quest.7F5D428A8D4A9A66.quest_desc: ["A quick-firing breech is loaded from the back with a projectile and a big cartridge, no loader needed, so the cannon fires much more often. The cased big cartridge replaces powder charges."]
	quest.7F5D428A8D4A9A66.title: "Quick-Firing Cannon"
	quest.7F8003F7657EF927.quest_desc: ["A terminal in your pocket. Put it into the access point's slot for a moment to link it to the network. Charge it in a charger."]
	quest.7F828C6C83F055B8.quest_desc: [
		"The ritual calls an unbound afrit that attacks at once. Defeated, it leaves its essence."
		"&cThe afrit breathes fire: bring fire resistance.&r"
	]
	quest.7F856B05E89CB906.quest_desc: ["The strongest of the Building Wands. Upgrade a diamond wand on a smithing table with a netherite upgrade template and a netherite ingot."]
	quest.7FB29C7AEAB6F537.quest_desc: ["Honeycomb walls, pollinated fields, flower meadows and the crystal canyon. Visit all four."]
	quest.7FB29C7AEAB6F537.title: "Lands of the Hive"
	quest.7FEFC5EF97EC721E.quest_desc: [
		"&7Brass Era · diamond armour and a shield recommended&r"
		""
		"The Invoker waits in a woodland mansion. He conjures fangs from the ground and vexes, and when things heat up he teleports around the room. A shield stops the fangs."
	]
	quest.7FEFC5EF97EC721E.title: "Master of the Mansion"
